module
public import CFSG.Quasithin.ChapterK.Section01To04.Linear.Recognition.BinaryCubicSieve.FiveDisplacement.Inner.EndNode.Levi.Coordinates
public import Theory.Representation.SL5TenDimensionalFirstCohomology.Classification.SeedExtraction.HeckeAction.FixedSpace

/-!
# Actual unipotent subgroups for the binary end-parabolic argument

The upper group is generated by the positive root transvections. Inverse
transpose defines its opposite, and the intersection of an end parabolic
with its opposite is the actual block-diagonal Levi subgroup. The two-core
is mapped from the parabolic to the ambient matrix group, retaining its
relative normality convention.

The fixed-line and orbit-spanning statement below is precisely the binary
Curtis input for Timmesfeld's proof, not an assumption of absolute
irreducibility or of fixed-space irreducibility.

Source: GLS, Volume 3, Theorems 2.8.9 and 2.8.11,
`refs/KGroup/GLS3/chapter2.tex`, pp.94–96.
-/

@[expose] public noncomputable section
namespace CFSG.Quasithin.ChapterK.Linear.Recognition.BinaryCubicSieve.FiveDisplacement.Inner.EndNode.Levi.Irreducibility
open Representation
open BinaryLinear.OuterCyclic
open SL5TenDimensional.Classification.HeckeAction

abbrev upper : Subgroup SL5TenDimensional.Group := upperRootSubgroup

def lower : Subgroup SL5TenDimensional.Group := upper.map (graphSL 5).toMonoidHom

def radicalImage (e : Fin 2) : Subgroup SL5TenDimensional.Group :=
  (radical e).map (parabolic e).subtype

def oppositeParabolic (e : Fin 2) : Subgroup SL5TenDimensional.Group :=
  (parabolic e).map (graphSL 5).toMonoidHom

def oppositeRadical (e : Fin 2) : Subgroup SL5TenDimensional.Group :=
  (radicalImage e).map (graphSL 5).toMonoidHom

/-- The common block-diagonal subgroup of the two opposite parabolics. -/
def leviSubgroup (e : Fin 2) : Subgroup SL5TenDimensional.Group :=
  parabolic e ⊓ oppositeParabolic e

/-- The literal quotient map on the common Levi subgroup. -/
def leviToQuotient (e : Fin 2) : leviSubgroup e →* (parabolic e ⧸ radical e) :=
  (QuotientGroup.mk' (radical e)).comp (Subgroup.inclusion inf_le_left)

theorem upper_isPGroup : IsPGroup 2 upper := upperRootSubgroup_isPGroup

theorem lower_isPGroup : IsPGroup 2 lower := upper_isPGroup.map (graphSL 5).toMonoidHom

theorem radicalImage_isPGroup (e : Fin 2) : IsPGroup 2 (radicalImage e) :=
  pCore_isPGroup.map (parabolic e).subtype

theorem parabolic_normalizes_radicalImage (e : Fin 2) :
    parabolic e ≤ Subgroup.normalizer (radicalImage e : Set SL5TenDimensional.Group) := by
  simpa only [radicalImage, Subgroup.normalizer_eq_top, ← MonoidHom.range_eq_map,
    Subgroup.range_subtype] using (radical e).le_normalizer_map (parabolic e).subtype

theorem levi_normalizes_radicalImage (e : Fin 2) :
    leviSubgroup e ≤ Subgroup.normalizer (radicalImage e : Set SL5TenDimensional.Group) :=
  inf_le_left.trans (parabolic_normalizes_radicalImage e)

theorem levi_normalizes_oppositeRadical (e : Fin 2) :
    leviSubgroup e ≤ Subgroup.normalizer (oppositeRadical e : Set SL5TenDimensional.Group) := by
  apply inf_le_right.trans
  have h := Subgroup.map_mono (f := (graphSL 5).toMonoidHom)
    (parabolic_normalizes_radicalImage e)
  rw [Subgroup.map_equiv_normalizer_eq] at h
  exact h

/-- The ambient and relative radical fixed spaces are identical. -/
theorem invariants_radicalImage {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]
    (σ : Representation (ZMod 2) SL5TenDimensional.Group V) (e : Fin 2) :
    invariants (σ.comp (radicalImage e).subtype) =
      invariants ((σ.comp (parabolic e).subtype).comp (radical e).subtype) := by
  ext v
  constructor
  · intro hv r
    exact hv ⟨r.val.val, Subgroup.mem_map_of_mem (parabolic e).subtype r.property⟩
  · intro hv r
    obtain ⟨a, ha, he⟩ := r.property
    change σ r.val v = v
    rw [← he]
    exact hv ⟨a, ha⟩

/-- Curtis's unique opposite fixed line and positive-unipotent cyclicity,
stated over the original binary field and on the literal subgroups. -/
def CurtisInput {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]
    (σ : Representation (ZMod 2) SL5TenDimensional.Group V) : Prop :=
  ∃ z : V, z ≠ 0 ∧ z ∈ invariants (σ.comp lower.subtype) ∧
    invariants (σ.comp lower.subtype) ≤ Submodule.span (ZMod 2) {z} ∧
    Submodule.span (ZMod 2) (Set.range fun u : upper => σ u z) = ⊤

end CFSG.Quasithin.ChapterK.Linear.Recognition.BinaryCubicSieve.FiveDisplacement.Inner.EndNode.Levi.Irreducibility
