module

public import CFSG.Quasithin.ChapterK.Section01To04.Linear.Recognition.BinaryCubicSieve.FiveDisplacement.Inner.EndNode.Setup
public import Theory.Representation.SL5TenDimensionalFirstCohomology.Classification.SeedExtraction.Support.Multiple.Separated.Extraction

/-!+# Explicit root groups for the binary SL₅ end radicals

The four upper transvections in the first row, or in the last column, generate
the respective geometric end radical. Their identification with the intrinsic
two-core remains an explicit geometric obligation below. Keeping these concrete
generators separate allows root-translate codimension calculations to proceed
independently of that identification.

The source radical step is reduced to two inputs: the geometric radical is a
minimal normal elementary subgroup of rank four in its parabolic, and its
common fixed space has codimension at least nine under the multiple-support
hypothesis. Neither input is asserted merely by defining it.

Source: Guralnick–Malle, *Classification of 2F-modules, II*, Proposition 4.7,
step 1, manuscript p.25; Aschbacher–Smith K.3.2, printed pp.454–455.
-/

@[expose] public section
namespace CFSG.Quasithin.ChapterK.Linear.Recognition.BinaryCubicSieve.FiveDisplacement.Inner.EndNode
open Representation Representation.BinaryOffender
open SL5TenDimensional.Classification.Separated

/-- The four actual upper root elements at the selected end node. -/
def radicalRoot (e : Fin 2) (i : Fin 4) : SL5TenDimensional.Group :=
  if e = 0 then rootElement 0 i.succ else rootElement i.castSucc 4

/-- The subgroup generated by the four marked end-root elements. -/
def radicalRootGroup (e : Fin 2) : Subgroup SL5TenDimensional.Group :=
  Subgroup.closure (Set.range (radicalRoot e))

/-- Each marked generator lies in the literal parabolic. -/
theorem radicalRoot_mem_parabolic (e : Fin 2) (i : Fin 4) :
    radicalRoot e i ∈ parabolic e := by
  rw [mem_parabolic_iff]
  intro a b hab hba
  revert hab hba
  fin_cases e <;> fin_cases i <;> fin_cases a <;> fin_cases b <;> decide +kernel

/-- The generated root group is contained in the same marked parabolic. -/
theorem radicalRootGroup_le_parabolic (e : Fin 2) :
    radicalRootGroup e ≤ parabolic e := by
  apply (Subgroup.closure_le _).mpr
  rintro _ ⟨i, rfl⟩
  exact radicalRoot_mem_parabolic e i

/-- Geometric facts required of the actual relative two-core. In particular
the last equality retains its literal inclusion into SL₅. -/
def RadicalGeometry : Prop :=
  ∀ e : Fin 2, IsElementaryTwo (radical e) ∧ rank (radical e) = 4 ∧
    (∀ K : Subgroup (parabolic e), K.Normal → K ≤ radical e →
      K = ⊥ ∨ K = radical e) ∧
    (radical e).map (parabolic e).subtype = radicalRootGroup e

variable {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]
  (σ : Representation (ZMod 2) SL5TenDimensional.Group V)

/-- The remaining representation calculation, on explicitly generated root
groups. It involves no actor conjugacy, quotient, or field-of-definition premise. -/
def RootCodimensionEstimate : Prop :=
  ∀ (e : Fin 2) (J : Finset (Fin 4)) (v : V), v ≠ 0 →
    SL5TenDimensional.Classification.LocalHighestVector σ J v →
    2 ≤ (J.erase (node e)).card →
    9 ≤ fixedCodim σ (radicalRootGroup e)

end CFSG.Quasithin.ChapterK.Linear.Recognition.BinaryCubicSieve.FiveDisplacement.Inner.EndNode
