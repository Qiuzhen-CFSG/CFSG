module

public import CFSG.Quasithin.ChapterK.Section01To04.Linear.Recognition.BinaryCubicSieve.FiveDisplacement.Graph.Contracts
public import CFSG.Quasithin.ChapterK.Section01To04.Linear.Recognition.BinaryCubicSieve.FiveDisplacement.Graph.Endpoint.RootCertificate
public import Theory.Representation.BinaryOffender.CommutatorRank

/-!
# Standard graph displacement for endpoint support in binary SL₅

Inverse transpose takes each binary transvection to the transvection with
reversed indices. The literal normalizer-conjugation equation consequently
intertwines these two root differences on the original representation.
`Endpoint.RootCertificate` then constructs nine independent vectors in the
range of the graph displacement. Rank-nullity identifies this dimension
with the fixed codimension of the cyclic subgroup generated by the actor.

This proves the precise `EndpointDisplacement` contract, with no additional
premise. The proof works without faithfulness, irreducibility, or an inner
actor estimate, and makes no adjoint-module identification.

Source: Guralnick–Malle, *Classification of 2F-modules, II*, author manuscript
Proposition 4.8(3A), p.27; Aschbacher–Smith K.3.2, printed pp.454–455
(PDF pp.465–466). The parent graph estimate combines this bound with the
outer-actor rank bound and the independent higher-support branch.
-/

public section
open Representation Representation.BinaryOffender
open Representation.SL5TenDimensional.Classification
open Representation.SL5TenDimensional.Classification.Separated
open BinaryLinear.OuterCyclic

namespace CFSG.Quasithin.ChapterK.Linear.Recognition.BinaryCubicSieve.FiveDisplacement.Graph
variable {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]
variable {σ : Representation (ZMod 2) SL5TenDimensional.Group V}

private theorem graph_root (a b : Fin 5) :
    graphSL 5 (rootElement a b) = rootElement b a := by
  by_cases hab : a = b
  · subst b
    simp [rootElement]
  have hba : b ≠ a := Ne.symm hab
  change (rootElement a b).transpose⁻¹ = rootElement b a
  have he : (rootElement a b).transpose = rootElement b a := by
    apply Subtype.ext
    simp [rootElement, hab, hba, Matrix.SpecialLinearGroup.transvection_coe]
  rw [he]
  simp only [rootElement, dif_pos hba, Matrix.SpecialLinearGroup.transvection_inv]
  rw [show -(1 : ZMod 2) = 1 by decide]

private theorem graph_intertwine (t : linearNormalizer σ) (ht : IsStandardGraph σ t)
    (g : SL5TenDimensional.Group) (x : V) :
    t.val.val (σ g x) = σ (graphSL 5 g) (t.val.val x) := by
  have he := congrArg (fun u : (Module.End (ZMod 2) V)ˣ => (u * t.val).val) (ht.2 g)
  have hlin : t.val.val * σ g = σ (graphSL 5 g) * t.val.val := by
    simpa only [mul_assoc, inv_mul_cancel, mul_one, Units.val_mul,
      Representation.asGroupHom_apply] using he
  exact congrArg (fun f : Module.End (ZMod 2) V => f x) hlin

private theorem difference_graph (t : linearNormalizer σ) (ht : IsStandardGraph σ t)
    (a b : Fin 5) (x : V) :
    difference σ (rootElement a b) (t.val.val x) =
      t.val.val (difference σ (rootElement b a) x) := by
  have he := graph_intertwine t ht (rootElement b a) x
  rw [graph_root] at he
  change σ (rootElement a b) (t.val.val x) - t.val.val x =
    t.val.val (σ (rootElement b a) x - x)
  rw [map_sub, he]

/-- A standard graph operator displaces at least nine dimensions in the endpoint branch. -/
theorem endpoint_displacement
    (σ : Representation (ZMod 2) SL5TenDimensional.Group V)
    [FiniteDimensional (ZMod 2) V] : EndpointDisplacement σ := by
  intro v hv h t ht
  rw [fixedCodim_zpowers_eq_displacement_rank]
  exact Endpoint.nine_le_displacement_rank h hv t.val.val
    (LinearMap.GeneralLinearGroup.generalLinearEquiv (ZMod 2) V t.val).injective
    (difference_graph t ht)

end CFSG.Quasithin.ChapterK.Linear.Recognition.BinaryCubicSieve.FiveDisplacement.Graph
