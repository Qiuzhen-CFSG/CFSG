module

public import CFSG.Quasithin.ChapterK.Section01To04.Linear.Recognition.BinaryCubicSieve.FiveDisplacement.Graph.Higher.DimensionContracts
public import CFSG.Quasithin.ChapterK.Section01To04.Linear.Recognition.BinaryCubicSieve.FiveDisplacement.Graph.Higher.Generation
public import CFSG.Quasithin.ChapterK.Section01To04.Linear.Recognition.BinaryCubicSieve.FiveDisplacement.Graph.Higher.AdjacentDimension
public import CFSG.Quasithin.ChapterK.Section01To04.Linear.Recognition.BinaryCubicSieve.FiveDisplacement.Graph.Higher.SeparatedDimension
public import Theory.Representation.BinaryOffender.NormalizerConjugateDimension

/-!
# Higher-support graph displacement from local dimension estimates

The marked SL₅ image is contained in the group generated by three conjugates
of a standard graph operator. Faithful irreducibility makes its common fixed
space zero. The quotient-by-fixed-spaces injection therefore bounds the module
by three times the graph operator's fixed codimension. Dimension at least 25
implies at least nine moved dimensions on the original binary module.

The support split separates adjacent roots from the pairs `{0,2}` and `{1,3}`.
The proved local dimension certificates cover all these cases, including supports
with additional active roots. Their assembly proves `higher_displacement` under
faithfulness and irreducibility alone, discharging the higher-support premise of
`Graph.graph_estimate_of_endpoint_and_higher`. No diagram invariance, absolute
irreducibility, degree cutoff or inner-displacement estimate is assumed.

Source application: Guralnick–Malle, *Classification of 2F-modules II*,
Proposition 4.8(3B), author manuscript pp.27–28; Aschbacher–Smith K.3.2,
printed pp.454–455. The explicit conjugate-generation calculation replaces
the source's parabolic step for this sufficient cyclic estimate.
-/

public section
open Subgroup Representation Representation.BinaryOffender
open Representation.SL5TenDimensional.Classification

namespace CFSG.Quasithin.ChapterK.Linear.Recognition.BinaryCubicSieve.FiveDisplacement.Graph

variable {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]
  (σ : Representation (ZMod 2) SL5TenDimensional.Group V)
variable [FiniteDimensional (ZMod 2) V]

/-- Three graph conjugates bound the whole module by three moved spaces. -/
theorem finrank_le_three_mul_graph_fixedCodim (hf : Function.Injective σ)
    (hi : IsIrreducible σ) (t : linearNormalizer σ) (ht : IsStandardGraph σ t) :
    Module.finrank (ZMod 2) V ≤
      3 * fixedCodim (normalizerRepresentation σ) (zpowers t) := by
  let τ : Representation (ZMod 2) (Module.End (ZMod 2) V)ˣ V := Units.coeHom _
  let : Nontrivial SL5TenDimensional.Group :=
    ⟨⟨simpleUpper 0, 1, by decide +kernel⟩⟩
  have hfix : fixedSpace τ (actionImage σ) = ⊥ := by
    have he : fixedSpace τ (actionImage σ) = σ.invariants := by
      ext v
      constructor
      · intro h g
        exact h ⟨σ.asGroupHom g, ⟨g, rfl⟩⟩
      · rintro h ⟨_, g, rfl⟩
        exact h g
    rw [he, invariants_eq_bot_of_faithful_irreducible σ hf hi]
  obtain ⟨c, hc⟩ := exists_three_graph_conjugates σ t ht
  have hd := finrank_le_mul_fixedCodim_of_conjugates τ (actionImage σ) hfix t.val c hc
  have he : fixedCodim τ (zpowers t.val) =
      fixedCodim (normalizerRepresentation σ) (zpowers t) := by
    rw [fixedCodim_zpowers_eq_displacement_rank, fixedCodim_zpowers_eq_displacement_rank]
    rfl
  rwa [he] at hd

/-- A dimension bound of 25 suffices for the literal cyclic graph estimate. -/
theorem graph_fixedCodim_ge_nine_of_finrank (hf : Function.Injective σ)
    (hi : IsIrreducible σ) (hd : 25 ≤ Module.finrank (ZMod 2) V)
    (t : linearNormalizer σ) (ht : IsStandardGraph σ t) :
    9 ≤ fixedCodim (normalizerRepresentation σ) (zpowers t) := by
  have h := finrank_le_three_mul_graph_fixedCodim σ hf hi t ht
  omega

/-- Convert a local higher-support dimension estimate to graph displacement. -/
theorem higher_displacement_of_finrank_bound (hf : Function.Injective σ)
    (hi : IsIrreducible σ)
    (hd : ∀ (J : Finset (Fin 4)) (v : V), v ≠ 0 →
      SL5TenDimensional.Classification.LocalHighestVector σ J v →
      2 ≤ J.card → J ≠ {0, 3} → 25 ≤ Module.finrank (ZMod 2) V) :
    HigherDisplacement σ := by
  intro J v hv hJ hcard hne t ht
  exact graph_fixedCodim_ge_nine_of_finrank σ hf hi (hd J v hv hJ hcard hne) t ht

/-- The two independent local dimension estimates cover the entire higher branch. -/
theorem higher_displacement_of_dimension_estimates (hf : Function.Injective σ)
    (hi : IsIrreducible σ) (ha : AdjacentDimensionBound σ)
    (hs : SeparatedDimensionBound σ) : HigherDisplacement σ := by
  apply higher_displacement_of_finrank_bound σ hf hi
  intro J v hv hJ hcard hne
  rcases higher_support_cases J hcard hne with ⟨i, hi, j, hj, hij⟩ | hsep
  · exact ha J v hv hJ i hi j hj hij
  · exact hs J v hv hJ hsep

/-- Every non-endpoint multiple support forces at least nine moved dimensions
for each literal standard graph operator on the faithful irreducible module. -/
theorem higher_displacement (hf : Function.Injective σ)
    (hi : IsIrreducible σ) : HigherDisplacement σ := by
  exact higher_displacement_of_dimension_estimates σ hf hi
    (adjacent_dimension_bound σ hf hi) (separated_dimension_bound σ hf hi)

end CFSG.Quasithin.ChapterK.Linear.Recognition.BinaryCubicSieve.FiveDisplacement.Graph
