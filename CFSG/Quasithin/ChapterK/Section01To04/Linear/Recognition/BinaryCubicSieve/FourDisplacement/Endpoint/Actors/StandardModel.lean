module

public import CFSG.Quasithin.ChapterK.Section01To04.Linear.Recognition.BinaryCubicSieve.FourDisplacement.Endpoint.Model
public import Theory.Representation.BinaryOffender.NormalizerExtension
public import Theory.SpecificGroups.BinaryLinear.OuterCyclic.Model

/-!
# Concrete inner and graph actors on the binary adjoint quotient

Transpose preserves the trace kernel and fixes its scalar line, so it descends
to the literal quotient `sl₄(F₂)/⟨Id⟩`. Its conjugation formula realizes the
inverse-transpose automorphism of SL₄(2) in the full linear normalizer.
Composing it with coordinate reversal gives the reversing graph involution
used with the standard upper unitriangular subgroup.

The final definition `standardActors` is the subgroup generated by those
upper unitriangular inner actors and that reversing graph involution. The
action formulas identify its generators on actual quotient representatives.
Sylow coverage of arbitrary normalizer actors and their common fixed-space
bounds are separate mathematical obligations; neither is asserted here.

Source: Guralnick–Malle, Classification of 2F-modules II, author manuscript,
Lemma 4.5 step 2 and Proposition 4.8 step 3A; Aschbacher–Smith K.3.2,
printed pp.454–455.
-/

set_option backward.isDefEq.respectTransparency false
@[expose] public noncomputable section
open Representation Representation.BinaryOffender
namespace CFSG.Quasithin.ChapterK.Linear.Recognition.BinaryCubicSieve.FourDisplacement.Endpoint

abbrev ActorMatrix := Matrix (Fin 4) (Fin 4) (ZMod 2)

/-- Transpose in the standard basis of the natural four-space. -/
def endTranspose : Module.End (ZMod 2) Natural ≃ₗ[ZMod 2] Module.End (ZMod 2) Natural :=
  LinearMap.toMatrix' |>.trans (Matrix.transposeLinearEquiv (Fin 4) (Fin 4) (ZMod 2) (ZMod 2))
    |>.trans Matrix.toLin'

@[simp] theorem endTranspose_matrix (f : Module.End (ZMod 2) Natural) :
    LinearMap.toMatrix' (endTranspose f) = (LinearMap.toMatrix' f).transpose := by
  exact LinearMap.toMatrix'_toLin' _

@[simp] theorem endTranspose_involutive (f : Module.End (ZMod 2) Natural) :
    endTranspose (endTranspose f) = f := by
  apply LinearMap.toMatrix'.injective
  simp

@[simp] theorem endTranspose_id : endTranspose LinearMap.id = LinearMap.id := by
  apply LinearMap.toMatrix'.injective
  simp

theorem endTranspose_trace (f : Module.End (ZMod 2) Natural) :
    LinearMap.trace (ZMod 2) Natural (endTranspose f) = LinearMap.trace (ZMod 2) Natural f := by
  rw [LinearMap.trace_eq_matrix_trace (ZMod 2) (Pi.basisFun (ZMod 2) (Fin 4)),
    LinearMap.trace_eq_matrix_trace (ZMod 2) (Pi.basisFun (ZMod 2) (Fin 4)),
    LinearMap.toMatrix_eq_toMatrix', endTranspose_matrix, Matrix.trace_transpose]

/-- Transpose restricted to the literal trace kernel. -/
def traceTranspose : TraceZero →ₗ[ZMod 2] TraceZero :=
  (endTranspose.toLinearMap.comp (LinearMap.ker (LinearMap.trace (ZMod 2) Natural)).subtype).codRestrict
    _ (fun f => by
      change LinearMap.trace (ZMod 2) Natural (endTranspose f.val) = 0
      rw [endTranspose_trace]
      exact f.property)

@[simp] theorem traceTranspose_val (f : TraceZero) :
    (traceTranspose f).val = endTranspose f.val := rfl

@[simp] theorem traceTranspose_involutive (f : TraceZero) :
    traceTranspose (traceTranspose f) = f := by
  apply Subtype.ext
  exact endTranspose_involutive _

@[simp] theorem traceTranspose_scalarVector : traceTranspose scalarVector = scalarVector := by
  apply Subtype.ext
  exact endTranspose_id

/-- Transpose induced on the quotient by scalar endomorphisms. -/
def quotientTranspose : Adjoint →ₗ[ZMod 2] Adjoint :=
  scalarLine.toSubmodule.mapQ scalarLine.toSubmodule traceTranspose (by
    intro f hf
    obtain ⟨c, rfl⟩ := Submodule.mem_span_singleton.mp hf
    change traceTranspose (c • scalarVector) ∈ Submodule.span (ZMod 2) {scalarVector}
    rw [map_smul, traceTranspose_scalarVector]
    exact Submodule.smul_mem _ _ (Submodule.subset_span (Set.mem_singleton _)))

@[simp] theorem quotientTranspose_mk (f : TraceZero) :
    quotientTranspose (mkAdjoint f) = mkAdjoint (traceTranspose f) := rfl

@[simp] theorem quotientTranspose_involutive (v : Adjoint) :
    quotientTranspose (quotientTranspose v) = v := by
  obtain ⟨f, rfl⟩ := mkAdjoint_surjective v
  simp

/-- The invertible quotient operator realizing the graph automorphism. -/
def graphUnit : (Module.End (ZMod 2) Adjoint)ˣ where
  val := quotientTranspose
  inv := quotientTranspose
  val_inv := by apply LinearMap.ext; intro v; exact quotientTranspose_involutive v
  inv_val := by apply LinearMap.ext; intro v; exact quotientTranspose_involutive v

@[simp] theorem graphUnit_inv : graphUnit⁻¹ = graphUnit := by
  apply Units.ext
  rfl

@[simp] theorem natural_matrix (g : Group) : LinearMap.toMatrix' (natural g) = g.val :=
  LinearMap.toMatrix'_toLin' _

@[simp] theorem graphSL_matrix (g : Group) :
    (BinaryLinear.OuterCyclic.graphSL 4 g).val = (g⁻¹).val.transpose := by
  have h : Matrix.SpecialLinearGroup.transpose g⁻¹ =
      (Matrix.SpecialLinearGroup.transpose g)⁻¹ := by
    apply eq_inv_of_mul_eq_one_left
    apply Subtype.ext
    change (g⁻¹).val.transpose * g.val.transpose = (1 : ActorMatrix)
    rw [← Matrix.transpose_mul, ← Matrix.SpecialLinearGroup.coe_mul, mul_inv_cancel]
    exact Matrix.transpose_one
  change ((Matrix.SpecialLinearGroup.transpose g)⁻¹).val = (g⁻¹).val.transpose
  have hv := congrArg (fun x : Group => x.val) h.symm
  simpa only [Matrix.SpecialLinearGroup.coe_transpose] using hv

theorem traceTranspose_action (g : Group) (f : TraceZero) :
    traceTranspose (traceAction g f) =
      traceAction (BinaryLinear.OuterCyclic.graphSL 4 g) (traceTranspose f) := by
  apply Subtype.ext
  apply LinearMap.toMatrix'.injective
  simp only [traceTranspose_val, traceAction_apply, endTranspose_matrix,
    LinearMap.toMatrix'_comp, natural_matrix, Matrix.transpose_mul,
    graphSL_matrix, ← map_inv, inv_inv]
  exact Matrix.mul_assoc _ _ _

theorem quotientTranspose_action (g : Group) (v : Adjoint) :
    quotientTranspose (adjoint g v) =
      adjoint (BinaryLinear.OuterCyclic.graphSL 4 g) (quotientTranspose v) := by
  obtain ⟨f, rfl⟩ := mkAdjoint_surjective v
  simp [traceTranspose_action]

theorem graphUnit_conj (g : Group) :
    graphUnit * adjoint.asGroupHom g * graphUnit⁻¹ =
      adjoint.asGroupHom (BinaryLinear.OuterCyclic.graphSL 4 g) := by
  apply Units.ext
  apply LinearMap.ext
  intro v
  change quotientTranspose (adjoint g (quotientTranspose v)) = _
  rw [quotientTranspose_action, quotientTranspose_involutive]
  rfl

theorem graphUnit_mem_normalizer : graphUnit ∈ linearNormalizer adjoint := by
  change graphUnit ∈ Subgroup.normalizer (actionImage adjoint : Set _)
  rw [Subgroup.mem_normalizer_iff]
  intro u
  constructor
  · rintro ⟨g, rfl⟩
    rw [graphUnit_conj]
    exact ⟨_, rfl⟩
  · rintro ⟨g, hg⟩
    refine ⟨BinaryLinear.OuterCyclic.graphSL 4 g, ?_⟩
    apply (MulAut.conj graphUnit).injective
    change graphUnit * adjoint.asGroupHom (BinaryLinear.OuterCyclic.graphSL 4 g) * graphUnit⁻¹ = _
    rw [graphUnit_conj]
    have hs := congrArg (fun a : MulAut Group => a g) (BinaryLinear.OuterCyclic.graphSL_sq 4)
    have htw : BinaryLinear.OuterCyclic.graphSL 4 (BinaryLinear.OuterCyclic.graphSL 4 g) = g := by
      simpa only [pow_two, MulAut.mul_apply, MulAut.one_apply] using hs
    rw [htw]
    exact hg

/-- Coordinate reversal, with ones on the anti-diagonal. -/
def reverseMatrix : ActorMatrix := fun i j => if i.val + j.val = 3 then 1 else 0

theorem reverseMatrix_det : reverseMatrix.det = 1 := by decide

/-- Coordinate reversal as an actual special linear matrix. -/
def reverseElement : Group := ⟨reverseMatrix, reverseMatrix_det⟩

theorem reverseElement_sq : reverseElement ^ 2 = 1 := by
  rw [pow_two]
  apply Subtype.ext
  change reverseMatrix * reverseMatrix = (1 : ActorMatrix)
  decide

theorem reverseElement_transpose : Matrix.SpecialLinearGroup.transpose reverseElement =
    reverseElement := by
  apply Subtype.ext
  change reverseMatrix.transpose = reverseMatrix
  decide

theorem reverseElement_inv : reverseElement⁻¹ = reverseElement := by
  exact inv_eq_of_mul_eq_one_right (by simpa only [pow_two] using reverseElement_sq)

theorem graphSL_reverseElement : BinaryLinear.OuterCyclic.graphSL 4 reverseElement =
    reverseElement := by
  change (Matrix.SpecialLinearGroup.transpose reverseElement)⁻¹ = reverseElement
  rw [reverseElement_transpose, reverseElement_inv]

/-- Map the given group action into its full normalizer. -/
def innerActor : Group →* linearNormalizer adjoint :=
  adjoint.asGroupHom.codRestrict _ (fun g => Subgroup.le_normalizer ⟨g, rfl⟩)

/-- Transpose viewed in the full linear normalizer. -/
def graphActor : linearNormalizer adjoint := ⟨graphUnit, graphUnit_mem_normalizer⟩

/-- The operator sending the class of X to the class of R Xᵀ R. -/
def reversingGraphActor : linearNormalizer adjoint := innerActor reverseElement * graphActor

@[simp] theorem graphActor_inv : graphActor⁻¹ = graphActor :=
  Subtype.ext graphUnit_inv

theorem graphActor_sq : graphActor ^ 2 = 1 := by
  calc
    graphActor ^ 2 = graphActor * graphActor⁻¹ := by rw [graphActor_inv, pow_two]
    _ = 1 := mul_inv_cancel _

theorem graphActor_conj (g : Group) :
    graphActor * innerActor g * graphActor⁻¹ =
      innerActor (BinaryLinear.OuterCyclic.graphSL 4 g) :=
  Subtype.ext (graphUnit_conj g)

private theorem product_square_one {H : Type*} [_root_.Group H] (x y : H)
    (hx : x ^ 2 = 1) (hy : y ^ 2 = 1) (hc : y * x * y⁻¹ = x) :
    (x * y) ^ 2 = 1 := by
  have hcomm : Commute y x := mul_inv_eq_iff_eq_mul.mp hc
  rw [hcomm.symm.mul_pow, hx, hy, mul_one]

theorem innerActor_reverse_sq : innerActor reverseElement ^ 2 = 1 :=
  (map_pow innerActor reverseElement 2).symm.trans
    ((congrArg innerActor reverseElement_sq).trans (map_one innerActor))

theorem reversingGraphActor_sq : reversingGraphActor ^ 2 = 1 :=
  product_square_one (innerActor reverseElement) graphActor innerActor_reverse_sq graphActor_sq
    ((graphActor_conj reverseElement).trans (congrArg innerActor graphSL_reverseElement))

@[simp] theorem innerActor_mk (g : Group) (f : TraceZero) :
    normalizerRepresentation adjoint (innerActor g) (mkAdjoint f) =
      mkAdjoint (traceAction g f) := rfl

@[simp] theorem graphActor_mk (f : TraceZero) :
    normalizerRepresentation adjoint graphActor (mkAdjoint f) =
      mkAdjoint (traceTranspose f) := rfl

@[simp] theorem reversingGraphActor_mk (f : TraceZero) :
    normalizerRepresentation adjoint reversingGraphActor (mkAdjoint f) =
      mkAdjoint (traceAction reverseElement (traceTranspose f)) := rfl

/-- A literal binary upper unitriangular matrix. -/
def IsUpperUnitriangular (g : Group) : Prop :=
  (∀ i, g.val i i = 1) ∧ ∀ i j, j < i → g.val i j = 0

/-- The subgroup generated by upper unitriangular conjugation and reversal transpose.
Its Sylow coverage and common-fixed-space bounds are separate obligations. -/
def standardActors : Subgroup (linearNormalizer adjoint) :=
  Subgroup.closure (innerActor '' {g | IsUpperUnitriangular g} ∪ {reversingGraphActor})

theorem innerActor_mem_standardActors (g : Group) (hg : IsUpperUnitriangular g) :
    innerActor g ∈ standardActors :=
  Subgroup.subset_closure (Or.inl ⟨g, hg, rfl⟩)

theorem reversingGraphActor_mem_standardActors : reversingGraphActor ∈ standardActors :=
  Subgroup.subset_closure (Or.inr rfl)

end CFSG.Quasithin.ChapterK.Linear.Recognition.BinaryCubicSieve.FourDisplacement.Endpoint
