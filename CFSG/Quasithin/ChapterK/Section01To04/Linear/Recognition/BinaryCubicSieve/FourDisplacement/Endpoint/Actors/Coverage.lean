module

public import CFSG.Quasithin.ChapterK.Section01To04.Linear.Recognition.BinaryCubicSieve.FourDisplacement.Endpoint.Actors.StandardModel
public import Theory.SpecificGroups.BinaryLinear.OuterCyclic
public import Theory.SpecificGroups.LinearSylowNormalizers.Triangular
public import Theory.Representation.Quotient
public import Theory.GroupTheory.NormalizedSupConsequences
public import Theory.GroupTheory.CoprimeIndexMarking
public import Theory.Representation.BinaryIrreducibleCentralizer

/-!
# Conjugacy coverage by the standard adjoint actors

For the faithful irreducible adjoint quotient, Schur's lemma excludes
involutions in the kernel of normalizer conjugation, and Cauchy's theorem
makes that kernel odd. Inner/graph automorphism coverage lifts through the
literal inner and transpose actors from `StandardModel`.

Let H be generated by the inner actors and `standardActors`. The conjugation
kernel supplements H, so H has odd index in the full normalizer. The inner
actors are normal, and the subgroup-index diamond identifies the index of
`standardActors` in H with its relative index in the inner actors. This index
divides the index of the existing upper unitriangular Sylow subgroup. Thus
`standardActors` has odd index, and Sylow conjugacy places every elementary
two-subgroup inside it. This supplies the coverage premise in
`adjoint_actor_gap_of_standardActors` with the actual linear operators retained.

Source: Guralnick–Malle, Classification of 2F-modules II, author manuscript,
Lemma 4.5 and Proposition 4.8 step 3A; Aschbacher–Smith K.3.2,
printed pp.451,454–455. The inner/graph automorphism theorem is the binary
specialization of GLS3, Theorem 2.5.12, supplied by `BinaryLinear.OuterCyclic`.
-/

set_option backward.isDefEq.respectTransparency false
noncomputable section
open Representation Representation.BinaryOffender Subgroup
namespace CFSG.Quasithin.ChapterK.Linear.Recognition.BinaryCubicSieve.FourDisplacement.Endpoint

private def faithfulImage (hf : Function.Injective adjoint) : Group ≃* actionImage adjoint :=
  MonoidHom.ofInjective (fun _ _ h => hf (congrArg Units.val h))

private def actorConjugation (hf : Function.Injective adjoint) :
    linearNormalizer adjoint →* MulAut Group :=
  (MulAut.congr (faithfulImage hf).symm).toMonoidHom.comp
    (actionImage adjoint).normalizerMonoidHom

private theorem actorConjugation_inner (hf : Function.Injective adjoint) (g : Group) :
    actorConjugation hf (innerActor g) = MulAut.conj g := by
  apply MulEquiv.ext
  intro x
  change (faithfulImage hf).symm
    ((actionImage adjoint).normalizerMonoidHom (innerActor g) (faithfulImage hf x)) = _
  apply (faithfulImage hf).symm_apply_eq.mpr
  apply Subtype.ext
  change adjoint.asGroupHom g * adjoint.asGroupHom x * (adjoint.asGroupHom g)⁻¹ =
    adjoint.asGroupHom (g * x * g⁻¹)
  simp only [map_mul, map_inv]

private theorem actorConjugation_graph (hf : Function.Injective adjoint) :
    actorConjugation hf graphActor = BinaryLinear.OuterCyclic.graphSL 4 := by
  apply MulEquiv.ext
  intro x
  change (faithfulImage hf).symm
    ((actionImage adjoint).normalizerMonoidHom graphActor (faithfulImage hf x)) = _
  apply (faithfulImage hf).symm_apply_eq.mpr
  apply Subtype.ext
  exact graphUnit_conj x

private theorem sl_inner_graph (a : MulAut Group) :
    ∃ g : Group, a = MulAut.conj g ∨
      a = BinaryLinear.OuterCyclic.graphSL 4 * MulAut.conj g := by
  let e := BinaryLinear.OuterCyclic.slEquivLinear 4
  obtain ⟨g, hg⟩ := BinaryLinear.OuterCyclic.inner_graph (Or.inl rfl)
    (MulAut.congr e a)
  refine ⟨e.symm g, ?_⟩
  rcases hg with hg | hg
  · left
    apply (MulAut.congr e).injective
    rw [MulAut.congr_conj, e.apply_symm_apply]
    exact hg
  · right
    apply (MulAut.congr e).injective
    rw [map_mul, MulAut.congr_conj, e.apply_symm_apply]
    exact hg

private theorem innerActor_range_normal : innerActor.range.Normal := by
  have he : innerActor.range =
      (actionImage adjoint).subgroupOf (linearNormalizer adjoint) := by
    ext x
    constructor
    · rintro ⟨g, rfl⟩
      exact ⟨g, rfl⟩
    · rintro ⟨g, hg⟩
      exact ⟨g, Subtype.ext hg⟩
  rw [he]
  exact Subgroup.normal_in_normalizer

private theorem actorConjugation_kernel_odd (hf : Function.Injective adjoint)
    (hi : IsIrreducible adjoint) [Finite (linearNormalizer adjoint)] :
    ¬ 2 ∣ Nat.card (actorConjugation hf).ker := by
  intro hdiv
  obtain ⟨x, hx⟩ := exists_prime_orderOf_dvd_card' (G := (actorConjugation hf).ker) 2 hdiv
  have hx2 : x ^ 2 = 1 := by simpa only [hx] using pow_orderOf_eq_one x
  have hxker : (x.val : linearNormalizer adjoint) ∈
      (actionImage adjoint).normalizerMonoidHom.ker := by
    apply (MulAut.congr (faithfulImage hf).symm).injective
    exact x.property.trans (map_one _).symm
  rw [Subgroup.normalizerMonoidHom_ker] at hxker
  let τ : Representation (ZMod 2) (Module.End (ZMod 2) Adjoint)ˣ Adjoint := Units.coeHom _
  let : IsIrreducible (τ.comp (actionImage adjoint).subtype) :=
    (irreducible_comp_surjective_iff (actionHom adjoint)
      adjoint.asGroupHom.rangeRestrict_surjective (imageRepresentation adjoint)).mp hi
  have he : x.val.val = 1 :=
    BinaryIrreducibleCentralizer.centralizing_square_one_eq_one τ (actionImage adjoint)
      (fun _ _ h => Units.ext h)
      (congrArg (fun a : (actorConjugation hf).ker => a.val.val) hx2) hxker
  have hx1 : x = 1 := Subtype.ext (Subtype.ext he)
  simp [hx1] at hx

private theorem actorConjugation_kernel_supplement (hf : Function.Injective adjoint) :
    (actorConjugation hf).ker ⊔ (innerActor.range ⊔ standardActors) = ⊤ := by
  apply top_unique
  intro x _
  obtain ⟨g, hg⟩ := sl_inner_graph (actorConjugation hf x)
  have hgmem : graphActor ∈ innerActor.range ⊔ standardActors := by
    have hr : innerActor reverseElement ∈ innerActor.range ⊔ standardActors :=
      (le_sup_left : innerActor.range ≤ innerActor.range ⊔ standardActors) ⟨_, rfl⟩
    have hs : reversingGraphActor ∈ innerActor.range ⊔ standardActors :=
      (le_sup_right : standardActors ≤ innerActor.range ⊔ standardActors)
        reversingGraphActor_mem_standardActors
    have hh := (innerActor.range ⊔ standardActors).mul_mem
      ((innerActor.range ⊔ standardActors).inv_mem hr) hs
    simpa only [reversingGraphActor, inv_mul_cancel_left] using hh
  have hrep : ∃ y ∈ innerActor.range ⊔ standardActors,
      actorConjugation hf x = actorConjugation hf y := by
    rcases hg with hg | hg
    · exact ⟨innerActor g, (le_sup_left : innerActor.range ≤ innerActor.range ⊔ standardActors) ⟨g, rfl⟩,
        hg.trans (actorConjugation_inner hf g).symm⟩
    · refine ⟨graphActor * innerActor g,
        (innerActor.range ⊔ standardActors).mul_mem hgmem ((le_sup_left : innerActor.range ≤ innerActor.range ⊔ standardActors) ⟨g, rfl⟩), ?_⟩
      exact hg.trans ((map_mul (actorConjugation hf) graphActor (innerActor g)).trans
        (congrArg₂ (fun a b : MulAut Group => a * b)
          (actorConjugation_graph hf) (actorConjugation_inner hf g))).symm
  obtain ⟨y, hy, hxy⟩ := hrep
  have hk : y⁻¹ * x ∈ (actorConjugation hf).ker :=
    (MonoidHom.eq_iff (actorConjugation hf)).mp hxy
  simpa only [mul_inv_cancel_left] using
    ((actorConjugation hf).ker ⊔ (innerActor.range ⊔ standardActors)).mul_mem
      ((le_sup_right : innerActor.range ⊔ standardActors ≤
        (actorConjugation hf).ker ⊔ (innerActor.range ⊔ standardActors)) hy)
      ((le_sup_left : (actorConjugation hf).ker ≤
        (actorConjugation hf).ker ⊔ (innerActor.range ⊔ standardActors)) hk)

private theorem standardActors_inner_index_odd : ¬ 2 ∣ standardActors.relIndex innerActor.range := by
  rw [← Subgroup.index_comap]
  let U := Theory.SpecificGroups.LinearSylowNormalizers.standardSylow 4 (ZMod 2) (by decide)
  have hU : (U : Subgroup Group) ≤ standardActors.comap innerActor := by
    intro g hg
    change g ∈ (U : Subgroup Group) at hg
    rw [show (U : Subgroup Group) =
      Theory.SpecificGroups.LinearSylowNormalizers.unipotent 4 (ZMod 2) from
        Theory.SpecificGroups.LinearSylowNormalizers.coe_standardSylow 4 (ZMod 2) (by decide)] at hg
    obtain ⟨hu, hd⟩ :=
      (Theory.SpecificGroups.LinearSylowNormalizers.mem_unipotent 4 (ZMod 2) g).mp hg
    exact innerActor_mem_standardActors g ⟨hd, fun i j hji =>
      ((Theory.SpecificGroups.LinearSylowNormalizers.mem_borel 4 (ZMod 2) g).mp hu) hji⟩
  intro hdiv
  exact U.not_dvd_index (hdiv.trans (Subgroup.index_dvd_of_le hU))

private theorem standardActors_index_odd (hf : Function.Injective adjoint)
    (hi : IsIrreducible adjoint) [Finite (linearNormalizer adjoint)] :
    ¬ 2 ∣ standardActors.index := by
  let H := innerActor.range ⊔ standardActors
  let K := (actorConjugation hf).ker
  have hH : ¬ 2 ∣ H.index := by
    have he := Subgroup.relIndex_sup_of_normalizes K H Subgroup.le_normalizer_of_normal
    rw [actorConjugation_kernel_supplement hf, Subgroup.relIndex_top_right] at he
    rw [he]
    exact fun h => actorConjugation_kernel_odd hf hi
      (h.trans (Subgroup.relIndex_dvd_card H K))
  have hS : ¬ 2 ∣ standardActors.relIndex H := by
    let := innerActor_range_normal
    rw [Subgroup.relIndex_sup_of_normalizes innerActor.range standardActors
      Subgroup.le_normalizer_of_normal]
    exact standardActors_inner_index_odd
  rw [← Subgroup.relIndex_mul_index (show standardActors ≤ H from le_sup_right)]
  exact Nat.prime_two.not_dvd_mul hS hH

private theorem cover_of_odd_index {G : Type*} [_root_.Group G] [Finite G]
    (S A : Subgroup G) (hS : ¬ 2 ∣ S.index) (hA : IsPGroup 2 A) :
    ∃ g : G, A.map (MulAut.conj g).toMonoidHom ≤ S := by
  let P : Sylow 2 S := Sylow.nonempty.some
  let R := P.mapSubtypeOfIndexPrimeTo hS
  obtain ⟨T, hAT⟩ := hA.exists_le_sylow
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq G T R
  refine ⟨g, le_trans ?_ (Subgroup.map_subtype_le (P : Subgroup S))⟩
  change A.map (MulAut.conj g).toMonoidHom ≤ (R : Subgroup G)
  rw [← hg]
  exact Subgroup.map_mono hAT

/-- Every elementary two-subgroup of the full adjoint normalizer has a conjugate
in the concrete standard actor subgroup. -/
public theorem standardActors_cover (hf : Function.Injective adjoint)
    (hi : IsIrreducible adjoint) (A : Subgroup (linearNormalizer adjoint))
    (hA : IsElementaryTwo A) :
    ∃ g : linearNormalizer adjoint,
      A.map (MulAut.conj g).toMonoidHom ≤ standardActors := by
  let : Finite Adjoint := Module.finite_of_finite (ZMod 2)
  let : Finite (Module.End (ZMod 2) Adjoint) := Finite.of_injective
    (fun f : Module.End (ZMod 2) Adjoint => (f : Adjoint → Adjoint)) DFunLike.coe_injective
  let : IsElementaryAbelian 2 A := hA.2
  exact cover_of_odd_index standardActors A (standardActors_index_odd hf hi)
    (IsElementaryAbelian.isPGroup 2 A)

end CFSG.Quasithin.ChapterK.Linear.Recognition.BinaryCubicSieve.FourDisplacement.Endpoint
