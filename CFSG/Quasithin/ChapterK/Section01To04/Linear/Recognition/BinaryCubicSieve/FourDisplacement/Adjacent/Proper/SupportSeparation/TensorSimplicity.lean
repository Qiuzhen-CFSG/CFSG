module
public import CFSG.Quasithin.ChapterK.Section01To04.Linear.Recognition.BinaryCubicSieve.FourDisplacement.Adjacent.Proper.SupportSeparation.Presentation
public import CFSG.Quasithin.ChapterG.Section09.DefiningCharacteristic.BinaryLinearRecognition.FourSmallModules.HeckeAction.FixedSpace

/-!
# Simplicity of the proper adjacent mixed-tensor orbit

The literal cyclic subrepresentation generated by `e₀ ⊗ (e₀ ∧ e₁)` is
irreducible over F₂. Ordinary exterior multiplication into four coordinates
annihilates every translate of the seed, by `a ∧ a ∧ b = 0`. The upper-root
fixedness equations leave only the seed and
`e₀ ⊗ e₁₂ + e₁ ⊗ e₀₂ + e₂ ⊗ e₀₁`; the latter has nonzero 012 wedge
coordinate. Thus the upper-fixed space inside the cyclic orbit is the seed
line. Every nonzero invariant subspace contains a nonzero upper-fixed vector
by the binary two-group fixed-vector theorem, hence contains the seed and
its whole cyclic orbit.

The final application discharges the simplicity premise of the presentation
comparison. Universal kernel-displacement containment remains explicit and
independent; no dimension certificate or absolute irreducibility is assumed.

Source application: Aschbacher–Smith, K.3.2, printed pp.451,454–455;
Guralnick–Malle, Classification of 2F-modules II, author manuscript,
Proposition 4.8(3), pp.27–28. This concrete finite-group argument supplies the
proper adjacent comparison used in the graph-support separation argument.
-/

@[expose] public section
open Representation
open Atlas.Order20160A8.Bivectors
open scoped Kronecker MatrixGroups
namespace CFSG.Quasithin.ChapterK.Linear.Recognition.BinaryCubicSieve.FourDisplacement.SupportSeparation
open ChapterG.Section09.DefiningCharacteristic.BinaryLinearRecognition.FourSmallModules

/-- Exterior multiplication, with coordinates 012, 013, 023, 123. -/
def tensorWedge : Space →ₗ[ZMod 2] (Fin 4 → ZMod 2) where
  toFun x := ![x (0,3) + x (1,1) + x (2,0),
    x (0,4) + x (1,2) + x (3,0),
    x (0,5) + x (2,2) + x (3,1),
    x (1,5) + x (2,4) + x (3,3)]
  map_add' x y := by ext i; fin_cases i <;> simp <;> abel
  map_smul' a x := by ext i; fin_cases i <;> simp [mul_add]

/-- Exterior multiplication kills every actual translate of the tensor seed. -/
theorem tensorWedge_act_tensorSeed (g : Group) : tensorWedge (mixedTensor g tensorSeed) = 0 := by
  rw [act_tensorSeed]
  change tensorWedge (fun p => (g.val ⊗ₖ compound g.val) p (0, 0)) = 0
  generalize g.val = A
  ext i
  fin_cases i <;>
    simp [tensorWedge, Matrix.kroneckerMap, compound, first, second,
      CharTwo.sub_eq_add] <;> ring_nf <;> simp only [CharTwo.two_eq_zero, mul_zero, add_zero]

/-- The entire cyclic image lies in the ordinary exterior-multiplication kernel. -/
theorem tensorOrbit_le_tensorWedge_ker : tensorOrbit.toSubmodule ≤ tensorWedge.ker := by
  rintro _ ⟨x, rfl⟩
  change tensorWedge (tensorOrbitMap x) = 0
  induction x using MonoidAlgebra.induction_linear with
  | zero => simp
  | add a b ha hb => simp [ha, hb]
  | single g a => simp [tensorOrbitMap, tensorWedge_act_tensorSeed]

/-- The upper-fixed space in the literal tensor orbit is exactly the seed line. -/
theorem tensorOrbit_upperFixed_eq_smul_seed (x : Space)
    (hx : x ∈ tensorOrbit) (h : UpperFixed mixedTensor x) : x = x (0, 0) • tensorSeed := by
  have u0 := h 0 1 (by decide)
  have u1 := h 1 2 (by decide)
  have u2 := h 2 3 (by decide)
  have h0 := congrFun u0 (0,0)
  have h1 := congrFun u0 (0,1)
  have h2 := congrFun u0 (0,2)
  have h3 := congrFun u0 (0,3)
  have h4 := congrFun u0 (0,4)
  have h5 := congrFun u0 (0,5)
  have h6 := congrFun u0 (2,1)
  have h7 := congrFun u0 (2,2)
  have h8 := congrFun u0 (3,1)
  have h9 := congrFun u0 (3,2)
  have h10 := congrFun u1 (0,0)
  have h11 := congrFun u1 (0,4)
  have h12 := congrFun u1 (1,0)
  have h13 := congrFun u1 (1,1)
  have h14 := congrFun u1 (1,2)
  have h15 := congrFun u1 (1,4)
  have h16 := congrFun u1 (3,0)
  have h17 := congrFun u1 (3,4)
  have h18 := congrFun u2 (0,1)
  have h19 := congrFun u2 (0,3)
  have h20 := congrFun u2 (2,0)
  have h21 := congrFun u2 (2,1)
  simp [mixedTensor, tensorMatrix, Matrix.toLin'_apply, Matrix.mulVec,
    dotProduct, Fintype.sum_prod_type, Fin.sum_univ_succ, Matrix.kroneckerMap,
    compound, first, second,
    Matrix.SpecialLinearGroup.transvection_coe, Matrix.one_apply, Matrix.single] at h0 h1 h2 h3 h4 h5 h6 h7 h8 h9 h10 h11 h12 h13 h14 h15 h16 h17 h18 h19 h20 h21
  have he11 : x (1,1) = x (0,3) := by
    have hh : x (0,3) + x (1,1) = 0 := by simpa [h10, h3] using h1
    exact (CharTwo.add_eq_zero.mp hh).symm
  have he20 : x (2,0) = x (0,3) := by
    have hh : x (0,3) + x (2,0) = 0 := by simpa [h0, h13, he11] using h12
    exact (CharTwo.add_eq_zero.mp hh).symm
  have hw := congrFun (tensorOrbit_le_tensorWedge_ker hx) 0
  have hx03 : x (0,3) = 0 := by
    simpa [tensorWedge, he11, he20, CharTwo.add_self_eq_zero] using hw
  have hx11 : x (1,1) = 0 := by simpa [h10, hx03, h3] using h1
  have hx12 : x (1,2) = 0 := by simpa [h18, h19, h4] using h2
  have hx20 : x (2,0) = 0 := by simpa [h0, hx11, h13] using h12
  have hx25 : x (2,5) = 0 := by simpa [h4, h5, h7] using h15
  have hx32 : x (3,2) = 0 := by simpa [h13, h14, h16] using h21
  ext ⟨i,j⟩
  fin_cases i <;> fin_cases j <;>
    simp [tensorSeed, h0, h10, h18, hx03, h19, h11, hx11, hx12,
      h3, h4, h5, hx20, h13, h14, h6, h7, hx25, h20, h16, hx32, h8, h9, h17]


-- Keep the action abstract when forming the two successive restrictions.
private theorem orbit_isIrreducible (ρ : Representation (ZMod 2) Group Space)
    (R : Subrepresentation ρ)
    (hmem : tensorSeed ∈ R)
    (hcyc : ∀ S : Subrepresentation ρ, tensorSeed ∈ S → R ≤ S)
    (hfixed : ∀ x : Space, x ∈ R → UpperFixed ρ x →
      x = x (0, 0) • tensorSeed) : IsIrreducible R.toRepresentation := by
  let w : R.toSubmodule := ⟨tensorSeed, hmem⟩
  have hw : w ≠ 0 := fun h => tensorSeed_ne_zero (congrArg Subtype.val h)
  refine { exists_pair_ne := ⟨⊥, ⊤, ?_⟩, eq_bot_or_eq_top := ?_ }
  · intro h
    have hm : w ∈ (⊥ : Subrepresentation R.toRepresentation) := by
      rw [h]
      trivial
    exact hw hm
  · intro S
    by_cases hS : S = ⊥
    · exact Or.inl hS
    right
    have hs : S.toSubmodule ≠ ⊥ := fun h =>
      hS (Subrepresentation.toSubmodule_injective h)
    let : Nontrivial S.toSubmodule := Submodule.nontrivial_iff_ne_bot.mpr hs
    obtain ⟨z, hz, hfix⟩ :=
      HeckeAction.exists_nonzero_upperFixed (V := S.toSubmodule) S.toRepresentation
    have hfix' : UpperFixed ρ z.val.val := by
      intro i j hij
      exact congrArg (fun t : S.toSubmodule => t.val.val) (hfix i j hij)
    have hz' : z.val.val ≠ 0 := by
      intro h
      apply hz
      exact Subtype.ext (Subtype.ext h)
    have he := hfixed z.val.val z.val.property hfix'
    have hc : z.val.val (0, 0) ≠ 0 := by
      intro h
      exact hz' (by simpa [h] using he)
    have hc1 : z.val.val (0, 0) = 1 := by
      have h : ∀ a : ZMod 2, a ≠ 0 → a = 1 := by decide
      exact h _ hc
    have hseed : z.val.val = tensorSeed := by simpa [hc1] using he
    let incl : IntertwiningMap S.toRepresentation ρ :=
      ⟨R.toSubmodule.subtype.comp S.toSubmodule.subtype, fun _ => rfl⟩
    have hR : R ≤ incl.range := hcyc incl.range ⟨z, hseed⟩
    apply le_antisymm le_top
    intro v _
    obtain ⟨t, ht⟩ := hR v.property
    have heq : t.val = v := Subtype.ext ht
    exact heq ▸ t.property

/-- The cyclic tensor orbit is an irreducible binary SL₄ module. -/
theorem tensorOrbit_isIrreducible : IsIrreducible tensorOrbit.toRepresentation :=
  orbit_isIrreducible mixedTensor tensorOrbit tensorSeed_mem_tensorOrbit
    tensorOrbit_le_of_seed_mem tensorOrbit_upperFixed_eq_smul_seed

variable {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]
/-- The concrete simplicity premise is discharged; only universal kernel control remains. -/
theorem mixedTensor_comparison_of_kernel_control
    (hkernel : ∀ x : Free, tensorOrbitMap x = 0 →
      ∀ g : Group, regular g x - x ∈ relations)
    (σ : Representation (ZMod 2) Group V) (hi : IsIrreducible σ)
    {v : V} (hv : v ≠ 0) (h : LocalHighestVector σ {0, 1} v) :
    ∃ f : IntertwiningMap σ mixedTensor, f ≠ 0 :=
  mixedTensor_comparison_of_kernel_displacements hkernel tensorOrbit_isIrreducible σ hi hv h

end CFSG.Quasithin.ChapterK.Linear.Recognition.BinaryCubicSieve.FourDisplacement.SupportSeparation
