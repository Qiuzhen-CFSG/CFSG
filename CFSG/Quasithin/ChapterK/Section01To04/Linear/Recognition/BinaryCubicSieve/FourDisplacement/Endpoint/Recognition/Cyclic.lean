module

public import CFSG.Quasithin.ChapterK.Section01To04.Linear.Recognition.BinaryCubicSieve.FourDisplacement.Endpoint.Recognition.Seed
public import CFSG.Quasithin.ChapterK.Section01To04.Linear.Recognition.BinaryCubicSieve.FourDisplacement.Endpoint.Recognition.Cyclic.Spanning
public import CFSG.Quasithin.ChapterK.Section01To04.Linear.Recognition.BinaryCubicSieve.FourDisplacement.Endpoint.Recognition.Cyclic.FlagRelations
public import CFSG.Quasithin.ChapterK.Section01To04.Linear.Recognition.BinaryCubicSieve.FourDisplacement.Endpoint.Recognition.Cyclic.OrbitValues
public import Mathlib.LinearAlgebra.Isomorphisms

/-!
# The cyclic trace-zero intertwiner for an endpoint highest vector

The realization of incident flags is onto the literal trace kernel, and its
kernel is generated by the elementary additive relations. The endpoint
highest-vector relations construct additive, equivariant flag values, which
therefore descend to an intertwiner for the original SL₄ action. The flag
(e₀,e₃*) ensures the exact normalization at `highestRoot`.

The conditional descent API is retained, and `exists_traceMap_of_endpoint`
discharges both of its mathematical inputs. Only the local highest-vector
relations are needed: the construction does not require finite dimension,
faithfulness, irreducibility, or a nonzero highest vector. This supplies the
cyclic-map premise of endpoint recognition; adjoint simplicity and the actor
estimate are independent of this construction.

Source: Aschbacher–Smith, K.3.2, printed pp.451,454–455;
Guralnick–Malle, Classification of 2F-modules II, author manuscript,
Lemma 4.5 step 2 and Proposition 4.8 step 3A.
-/

set_option backward.isDefEq.respectTransparency false
@[expose] public noncomputable section
open Representation
namespace CFSG.Quasithin.ChapterK.Linear.Recognition.BinaryCubicSieve.FourDisplacement.Endpoint.Cyclic

variable {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]
variable {σ : Representation (ZMod 2) Group V} {v : V}

/-- Additive flag values annihilate the span of the elementary relations. -/
theorem relations_le_ker_values (b : Flag → V)
    (hb : ∀ a b' c, AdditiveTriple a b' c → b a + b b' = b c) :
    relations ≤ LinearMap.ker (Finsupp.linearCombination (ZMod 2) b) := by
  apply Submodule.span_le.mpr
  rintro r ⟨a, b', c, h, rfl⟩
  change Finsupp.linearCombination (ZMod 2) b (relation a b' c) = 0
  simp only [relation, map_sub, map_add, Finsupp.linearCombination_single, one_smul,
    hb a b' c h, sub_self]

/-- The flag presentation constructs the actual trace-zero intertwiner from
completeness of the elementary relations and additive equivariant values on
the highest-root orbit. -/
theorem exists_traceMap_of_flag_values
    (hker : LinearMap.ker realization ≤ relations)
    (b : Flag → V)
    (hb : ∀ a b' c, AdditiveTriple a b' c → b a + b b' = b c)
    (he : ∀ g a, b (translate g a) = σ g (b a))
    (hs : b seed = v) :
    ∃ f : IntertwiningMap traceAction σ, f highestRoot = v := by
  let ev := Finsupp.linearCombination (ZMod 2) b
  have hvan : LinearMap.ker realization ≤ LinearMap.ker ev :=
    hker.trans (relations_le_ker_values b hb)
  let q := realization.quotKerEquivOfSurjective realization_surjective
  let F : TraceZero →ₗ[ZMod 2] V :=
    ((LinearMap.ker realization).liftQ ev hvan).comp q.symm.toLinearMap
  have hF (z : FreeFlags) : F (realization z) = ev z := by
    simp [F, q, LinearMap.quotKerEquivOfSurjective_symm_apply]
  have hev (g : Group) (z : FreeFlags) : ev (freeTranslate g z) = σ g (ev z) := by
    exact LinearMap.congr_fun (Finsupp.lmapDomain_linearCombination (ZMod 2)
      (translate g) (σ g) (fun a => (he g a).symm)) z
  let f : IntertwiningMap traceAction σ :=
    { toLinearMap := F
      isIntertwining' := by
        intro g
        apply LinearMap.ext
        intro x
        obtain ⟨z, rfl⟩ := realization_surjective x
        change F (traceAction g (realization z)) = σ g (F (realization z))
        rw [← realization_translate, hF, hF, hev] }
  refine ⟨f, ?_⟩
  change F highestRoot = v
  rw [← rankOne_seed, ← realization_single seed, hF]
  simpa only [ev, Finsupp.linearCombination_single, one_smul] using hs

end CFSG.Quasithin.ChapterK.Linear.Recognition.BinaryCubicSieve.FourDisplacement.Endpoint.Cyclic

namespace CFSG.Quasithin.ChapterK.Linear.Recognition.BinaryCubicSieve.FourDisplacement.Endpoint

open CFSG.Quasithin.ChapterG.Section09.DefiningCharacteristic.BinaryLinearRecognition.FourSmallModules

variable {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]
variable {σ : Representation (ZMod 2) Group V} {v : V}

/-- The local endpoint highest-vector relations give a trace-zero intertwiner
for the original SL₄ marking, taking the literal E₀₃ to the supplied vector.
This discharges the cyclic-map premise of endpoint recognition without any
dimension, faithfulness, irreducibility, or nonzero assumption. -/
theorem exists_traceMap_of_endpoint (h : LocalHighestVector σ {0, 2} v) :
    ∃ f : IntertwiningMap traceAction σ, f highestRoot = v := by
  obtain ⟨b, hb, he, hs⟩ := Cyclic.exists_flag_values_of_localHighest h
  exact Cyclic.exists_traceMap_of_flag_values Cyclic.ker_realization_le_relations b hb he hs

end CFSG.Quasithin.ChapterK.Linear.Recognition.BinaryCubicSieve.FourDisplacement.Endpoint
