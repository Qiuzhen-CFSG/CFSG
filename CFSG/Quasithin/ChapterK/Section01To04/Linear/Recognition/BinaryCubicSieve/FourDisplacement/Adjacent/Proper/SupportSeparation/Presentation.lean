module

public import CFSG.Quasithin.ChapterK.Section01To04.Linear.Recognition.BinaryCubicSieve.FourDisplacement.Adjacent.Proper.SupportSeparation.TensorModel
public import Theory.Representation.CyclicComparison

/-!
# The proper adjacent universal relations and tensor comparison

The free module is the regular module of the actual binary SL₄ matrix group.
Its relation space is generated by all translates of the six upper-root
fixedness equations, the inactive root-2 exchange and the two active
three-term relations. Evaluation at any {0,1}-highest vector kills this space.
The tensor seed `e₀ ⊗ (e₀ ∧ e₁)` satisfies precisely those relations, giving
a canonical map to its cyclic subrepresentation of the mixed tensor.

If every displacement of a vector in that map's kernel is a relation, its
image in any nontrivial simple target is fixed and therefore zero. The
resulting map from the tensor orbit to the target is an isomorphism once
the tensor orbit is simple. Its inverse gives the required comparison in
the correct direction, from the target into the tensor. An active root
supplies nontriviality, so this reduction does not even need faithfulness.

Kernel control and simplicity of the concrete orbit remain explicit. In
particular, this module does not equate the universal quotient with the
20-dimensional tensor orbit: the 105-flag experiment gives dimension 21.
No dimension from that experiment is used as a Lean theorem here.

Source application: Aschbacher–Smith K.3.2, printed pp.451,454–455;
Guralnick–Malle, Classification of 2F-modules II, author manuscript,
Proposition 4.8(3), pp.27–28. The source uses absolute highest weights;
this finite-group comparison is designed for arbitrary binary irreducibles.
-/

@[expose] public section

open Representation
open CFSG.Quasithin.ChapterG.Section09.DefiningCharacteristic.BinaryLinearRecognition.FourSmallModules
namespace CFSG.Quasithin.ChapterK.Linear.Recognition.BinaryCubicSieve.FourDisplacement.SupportSeparation
/-- The free binary module on the actual matrix group. -/
abbrev Free := MonoidAlgebra (ZMod 2) Group
/-- The literal left regular action, used to translate the seed relations. -/
noncomputable abbrev regular : Representation (ZMod 2) Group Free :=
  Representation.leftRegular (ZMod 2) Group

/-- Six upper fixedness relations, the inactive exchange, and two active relations. -/
def seedRelations : Set Free :=
  {r | (∃ (i j : Fin 4) (hij : i < j),
      r = MonoidAlgebra.single (Matrix.SpecialLinearGroup.transvection (ne_of_lt hij) 1) 1 -
        MonoidAlgebra.single 1 1) ∨
    r = MonoidAlgebra.single (simpleSwap 2) 1 - MonoidAlgebra.single 1 1 ∨
    ∃ i ∈ ({0, 1} : Finset (Fin 3)),
      r = MonoidAlgebra.single 1 1 + MonoidAlgebra.single (simpleSwap i) 1 +
        MonoidAlgebra.single (simpleLower i) 1}

/-- All translates of the proper adjacent highest-vector relations. -/
noncomputable def relations : Submodule (ZMod 2) Free :=
  Submodule.span (ZMod 2) {x | ∃ (g : Group) (r : Free), r ∈ seedRelations ∧ x = regular g r}

/-- Translating a defining relation again stays in the same relation space. -/
theorem relations_stable (g : Group) : relations ≤ relations.comap (regular g) := by
  rw [relations, Submodule.span_le]
  rintro _ ⟨a, r, hr, rfl⟩
  change regular g (regular a r) ∈ relations
  have he : regular g (regular a r) = regular (g * a) r := by rw [map_mul]; rfl
  rw [he]
  exact Submodule.subset_span ⟨g * a, r, hr, rfl⟩

variable {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]
/-- Every actual highest vector annihilates the entire translated relation space. -/
theorem relations_le_ker (σ : Representation (ZMod 2) Group V)
    {v : V} (h : LocalHighestVector σ {0, 1} v) :
    relations ≤ (Representation.cyclicOrbitMap σ v).toLinearMap.ker := by
  rw [relations, Submodule.span_le]
  rintro x ⟨g, r, hr, rfl⟩
  change Representation.cyclicOrbitMap σ v (regular g r) = 0
  rw [(Representation.cyclicOrbitMap σ v).isIntertwining]
  suffices hs : Representation.cyclicOrbitMap σ v r = 0 by rw [hs, map_zero]
  rcases hr with ⟨i, j, hij, rfl⟩ | rfl | ⟨i, hi, rfl⟩
  · simp [h.upper_fixed i j hij]
  · simp [h.inactive_fixed 2 (by decide)]
  · simpa using h.active_relation i hi

/-- The literal tensor `e₀ ⊗ (e₀ ∧ e₁)`. -/
def tensorSeed : Space := Pi.single (0, 0) 1

/-- The marked tensor has a nonzero first coordinate. -/
theorem tensorSeed_ne_zero : tensorSeed ≠ 0 := by
  intro h
  have hh := congrFun h (0, 0)
  norm_num [tensorSeed] at hh

/-- The tensor seed picks out the marked column of the Kronecker matrix. -/
theorem act_tensorSeed (g : Group) :
    mixedTensor g tensorSeed = fun p => tensorMatrix g p (0, 0) := by
  change (tensorMatrix g).mulVec (Pi.single (0, 0) 1) = _
  rw [Matrix.mulVec_single_one]
  rfl

/-- The literal tensor seed satisfies all the proper adjacent root relations. -/
theorem tensorSeed_highest : LocalHighestVector mixedTensor {0, 1} tensorSeed := by
  constructor
  · intro i j hij
    rw [act_tensorSeed]
    revert i j
    decide
  · intro i hi
    rw [act_tensorSeed]
    revert i
    decide
  · intro i hi
    rw [act_tensorSeed, act_tensorSeed]
    revert i
    decide

/-- Evaluate the regular module on the marked tensor orbit. -/
noncomputable def tensorOrbitMap : IntertwiningMap regular mixedTensor :=
  Representation.cyclicOrbitMap mixedTensor tensorSeed

/-- The concrete tensor orbit receives the universal relation quotient. -/
theorem relations_le_tensorOrbitMap_ker : relations ≤ tensorOrbitMap.toLinearMap.ker :=
  relations_le_ker mixedTensor tensorSeed_highest

/-- The cyclic subrepresentation generated by the literal tensor seed. -/
noncomputable def tensorOrbit : Subrepresentation mixedTensor := tensorOrbitMap.range

/-- The marked seed belongs to the concrete cyclic subrepresentation. -/
theorem tensorSeed_mem_tensorOrbit : tensorSeed ∈ tensorOrbit := by
  refine ⟨MonoidAlgebra.single 1 1, ?_⟩
  simp [tensorOrbitMap]

/-- A subrepresentation containing the seed contains the literal tensor orbit. -/
theorem tensorOrbit_le_of_seed_mem (S : Subrepresentation mixedTensor)
    (h : tensorSeed ∈ S) : tensorOrbit ≤ S :=
  Representation.cyclicOrbitMap_range_le mixedTensor S h

/-- The universal kernel may be nonzero: it suffices that its displacements
are relations and the actual tensor orbit is simple. These are concrete model
premises, independent of the arbitrary irreducible target. -/
theorem mixedTensor_comparison_of_kernel_displacements
    (hkernel : ∀ x : Free, tensorOrbitMap x = 0 →
      ∀ g : Group, regular g x - x ∈ relations)
    (hsimple : IsIrreducible tensorOrbit.toRepresentation)
    (σ : Representation (ZMod 2) Group V) (hi : IsIrreducible σ)
    {v : V} (hv : v ≠ 0) (h : LocalHighestVector σ {0, 1} v) :
    ∃ f : IntertwiningMap σ mixedTensor, f ≠ 0 := by
  let : IsIrreducible σ := hi
  apply IntertwiningMap.exists_nonzero_reverse_of_kernel_displacements
    tensorOrbitMap (Representation.cyclicOrbitMap σ v) _ hsimple
    ⟨simpleSwap 0, v, h.swap_ne_self hv (by decide)⟩
    relations (relations_le_ker σ h) hkernel
  intro hz
  have hh := DFunLike.congr_fun hz (MonoidAlgebra.single 1 1)
  exact hv (by simpa using hh)

end CFSG.Quasithin.ChapterK.Linear.Recognition.BinaryCubicSieve.FourDisplacement.SupportSeparation
