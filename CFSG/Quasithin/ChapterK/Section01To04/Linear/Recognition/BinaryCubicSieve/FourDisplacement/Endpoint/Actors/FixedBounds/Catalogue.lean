/-- The actual subgroup of the normalizer generated by a catalogue row. -/
noncomputable def catalogueSubgroup (i : Fin 60) : Subgroup (linearNormalizer adjoint) :=
  Subgroup.closure (codeActor '' {c | c ∈ catalogueGenerators i})

def certificateSize (i : Fin 60) : ℕ := 2 * (catalogueGenerators i).length + 1

