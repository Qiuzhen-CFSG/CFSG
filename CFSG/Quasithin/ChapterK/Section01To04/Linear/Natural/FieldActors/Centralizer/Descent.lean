module

public import CFSG.Quasithin.ChapterK.Section01To04.Linear.Natural.FieldActors.Coefficients
public import CFSG.Quasithin.ChapterK.Section01To04.Linear.Natural.FieldActors.FixedSpaces
public import Theory.Representation.FiniteFieldSemilinearDisplacement.Descent

/-!
# Fixed coordinates for a natural outer field involution

Restrict the genuine coefficient action to the order-two subgroup generated by
an outer involution. It is faithful, so semilinear descent constructs three
fixed basis vectors. Artin's fixed-field theorem gives a coefficient field of
order 2^s. In the resulting coordinates, a linear endomorphism commutes with
the original actor exactly when its matrix entries belong to that field.

These are the coordinate and field inputs to the two independent centralizer
calculations: bounding elementary linear actors and constructing a fixed root
plane. No basis, fixed-field cardinality, or model identification is assumed.

Source: Aschbacher–Smith, K.3.2.1, printed pp.454–455, manuscript of 1 March 2004.
-/

public section

open Representation Representation.BinaryOffender Module
open CFSG.Quasithin.ChapterB.QuasisimpleSource
namespace CFSG.Quasithin.ChapterK.Linear.Natural.FieldActors.Centralizer

variable (F : BinaryField)

private def binaryAut : (F.Carrier ≃+* F.Carrier) →* (F.Carrier ≃ₐ[ZMod 2] F.Carrier) where
  toFun σ := AlgEquiv.ofRingEquiv (f := σ) (fun x => by
    exact DFunLike.congr_fun (RingHom.ext_zmod
      (σ.toRingHom.comp (algebraMap (ZMod 2) F.Carrier))
      (algebraMap (ZMod 2) F.Carrier)) x)
  map_one' := by ext x; rfl
  map_mul' σ τ := by ext x; rfl

private lemma binaryAut_injective : Function.Injective (binaryAut F) := by
  intro σ τ h
  ext x
  exact congrArg (fun f : F.Carrier ≃ₐ[ZMod 2] F.Carrier => f x) h

/-- The actual coefficient field fixed by the cyclic group generated by the automorphism. -/
def fixedField (σ : F.Carrier ≃+* F.Carrier) : IntermediateField (ZMod 2) F.Carrier :=
  IntermediateField.fixedField (Subgroup.zpowers (binaryAut F σ))

/-- Membership is the literal fixed-scalar equation, with no chosen field isomorphism. -/
lemma mem_fixedField (σ : F.Carrier ≃+* F.Carrier) (x : F.Carrier) :
    x ∈ fixedField F σ ↔ σ x = x := by
  rw [fixedField, IntermediateField.mem_fixedField_iff]
  constructor
  · intro h
    exact h _ (Subgroup.mem_zpowers _)
  · intro h τ hτ
    obtain ⟨n, rfl⟩ := mem_powers_iff_mem_zpowers.mpr hτ
    clear hτ
    change ((binaryAut F σ) ^ n) x = x
    induction n with
    | zero => rfl
    | succ n ih =>
      rw [pow_succ', AlgEquiv.mul_apply, ih]
      exact h

/-- Artin's fixed-field theorem gives half the original binary degree. -/
theorem fixedField_finrank (σ : F.Carrier ≃+* F.Carrier) (hσ : orderOf σ = 2)
    (s : ℕ) (hdegree : F.degree = 2 * s) :
    finrank (ZMod 2) (fixedField F σ) = s := by
  have he : finrank (fixedField F σ) F.Carrier = 2 := by
    rw [fixedField, IntermediateField.finrank_fixedField_eq_card, Nat.card_zpowers,
      orderOf_injective (binaryAut F) (binaryAut_injective F), hσ]
  have ht := Module.finrank_mul_finrank (ZMod 2) (fixedField F σ) F.Carrier
  rw [he, field_finrank, hdegree] at ht
  omega

/-- The coefficient involution fixes exactly a field of order 2^s. -/
theorem fixedField_card (σ : F.Carrier ≃+* F.Carrier) (hσ : orderOf σ = 2)
    (s : ℕ) (hdegree : F.degree = 2 * s) : Nat.card (fixedField F σ) = 2 ^ s := by
  rw [Module.natCard_eq_pow_finrank (K := ZMod 2), Nat.card_zmod,
    fixedField_finrank F σ hσ s hdegree]

/-- An F-linear map commutes with coefficientwise action precisely when its matrix entries are fixed. -/
theorem matrix_mem_fixedField_iff (σ : F.Carrier ≃+* F.Carrier)
    (t : Module.End F.Carrier (Fin 3 → F.Carrier)) :
    (∀ i j, LinearMap.toMatrix' t i j ∈ fixedField F σ) ↔
      ∀ v, t (fun i => σ (v i)) = fun i => σ (t v i) := by
  constructor
  · intro ht v
    ext i
    rw [← LinearMap.toMatrix'_mulVec t, ← LinearMap.toMatrix'_mulVec t v]
    simp only [Matrix.mulVec, dotProduct, map_sum, map_mul]
    apply Finset.sum_congr rfl
    intro j _
    rw [(mem_fixedField F σ _).mp (ht i j)]
  · intro ht i j
    apply (mem_fixedField F σ _).mpr
    have hs : (fun k => σ ((Pi.single j (1 : F.Carrier) : Fin 3 → F.Carrier) k)) = Pi.single j 1 := by
      ext k
      by_cases hk : k = j <;> simp [hk]
    have he := congrFun (ht (Pi.single j 1)) i
    rw [hs] at he
    exact he.symm

variable {G V : Type*} [Group G] [Finite G] [AddCommGroup V] [Module (ZMod 2) V]
  (ρ : Representation (ZMod 2) G V) (L : Subgroup G)
  (e : ActionEquiv (ρ.comp L.subtype) (linearNatural F 3))

/-- The actual outer involution admits three fixed basis vectors over the original coefficient field. -/
theorem exists_fixed_basis (hf : Function.Injective ρ)
    (hs : IsSemilinearExtension ρ L F 3 e) (a : G) (ha : orderOf a = 2) (haL : a ∉ L) :
    ∃ b : Basis (Fin 3) F.Carrier (Fin 3 → F.Carrier),
      ∀ i, coordinateAction ρ L F e a (b i) = b i := by
  classical
  let H := Subgroup.zpowers a
  let φ := (coefficientAction ρ L F e hs).comp H.subtype
  let : Fintype H := Fintype.ofFinite H
  have hcard : Nat.card H = 2 := (Nat.card_zpowers a).trans ha
  let : Fact (Nat.card H).Prime := ⟨hcard ▸ Nat.prime_two⟩
  have hφ : Function.Injective φ := by
    apply φ.ker_eq_bot_iff.mp
    rcases φ.ker.eq_bot_or_eq_top_of_prime_card with h | h
    · exact h
    · exfalso
      have hm : (⟨a, Subgroup.mem_zpowers a⟩ : H) ∈ φ.ker := by rw [h]; trivial
      exact outer_coefficient_ne_one ρ L F e hf hs a (ha ▸ pow_orderOf_eq_one a) haL hm
  obtain ⟨t, b, hb⟩ := FiniteFieldSemilinearDisplacement.Descent.exists_fixed_basis
    ((coordinateAction ρ L F e).comp H.subtype) φ hφ
    (fun g c v => coefficientAction_smul ρ L F e hs g c v)
  let : Finite t := Module.Finite.finite_basis b
  let : Fintype t := Fintype.ofFinite t
  have ht : Fintype.card t = 3 := by
    rw [← Module.finrank_eq_card_basis b, Module.finrank_pi, Fintype.card_fin]
  refine ⟨b.reindex (Fintype.equivFinOfCardEq ht), ?_⟩
  intro i
  rw [Basis.reindex_apply]
  exact hb _ (⟨a, Subgroup.mem_zpowers a⟩ : H)

/-- A constructed F-linear coordinate change makes the given actor coefficientwise semilinear. -/
theorem exists_fixed_coordinates (hf : Function.Injective ρ)
    (hs : IsSemilinearExtension ρ L F 3 e) (a : G) (ha : orderOf a = 2) (haL : a ∉ L) :
    ∃ c : (Fin 3 → F.Carrier) ≃ₗ[F.Carrier] (Fin 3 → F.Carrier),
      ∀ v i, c (coordinateAction ρ L F e a v) i = coefficientAction ρ L F e hs a (c v i) := by
  obtain ⟨b, hb⟩ := exists_fixed_basis F ρ L e hf hs a ha haL
  refine ⟨b.equivFun, ?_⟩
  have hact (v : Fin 3 → F.Carrier) :
      coordinateAction ρ L F e a (b.equivFun.symm v) =
        b.equivFun.symm (fun i => coefficientAction ρ L F e hs a (v i)) := by
    simp only [b.equivFun_symm_apply, map_sum, coefficientAction_smul ρ L F e hs, hb]
  intro v i
  have h := congrArg (fun w => b.equivFun w i) (hact (b.equivFun v))
  simpa only [LinearEquiv.symm_apply_apply, LinearEquiv.apply_symm_apply] using h

omit [Finite G] in
/-- In the constructed coordinates, commuting with the actual actor is exactly entrywise descent. -/
theorem matrix_mem_fixedField_iff_commutes
    (hs : IsSemilinearExtension ρ L F 3 e) (a : G)
    (c : (Fin 3 → F.Carrier) ≃ₗ[F.Carrier] (Fin 3 → F.Carrier))
    (hc : ∀ v i, c (coordinateAction ρ L F e a v) i = coefficientAction ρ L F e hs a (c v i))
    (t : Module.End F.Carrier (Fin 3 → F.Carrier)) :
    (∀ i j, LinearMap.toMatrix' (c.conjRingEquiv t) i j ∈
      fixedField F (coefficientAction ρ L F e hs a)) ↔
      ∀ v, t (coordinateAction ρ L F e a v) = coordinateAction ρ L F e a (t v) := by
  let σ := coefficientAction ρ L F e hs a
  have hc' (v) : c (coordinateAction ρ L F e a v) = fun i => σ (c v i) := funext (hc v)
  have hcs (v) : c.symm (fun i => σ (v i)) = coordinateAction ρ L F e a (c.symm v) := by
    apply c.injective
    rw [c.apply_symm_apply, hc', c.apply_symm_apply]
  rw [matrix_mem_fixedField_iff]
  constructor
  · intro ht v
    apply c.injective
    have h := ht (c v)
    change c (t (c.symm (fun i => σ (c v i)))) = fun i => σ (c (t (c.symm (c v))) i) at h
    rw [hcs, c.symm_apply_apply, ← hc'] at h
    exact h
  · intro ht v
    change c (t (c.symm (fun i => σ (v i)))) = fun i => σ (c (t (c.symm v)) i)
    rw [hcs, ht, hc']

/-- Application to the literal natural source input: both the fixed field and the coordinate change are derived. -/
theorem source_outer_fixed_coordinates {K : GroupClass}
    (h : SourceInput ρ L F 3 K) (a : G) (ha : orderOf a = 2) (haL : a ∉ L)
    (s : ℕ) (hdegree : F.degree = 2 * s) :
    Nat.card (fixedField F (coefficientAction ρ L F h.natural h.semilinear a)) = 2 ^ s ∧
      ∃ c : (Fin 3 → F.Carrier) ≃ₗ[F.Carrier] (Fin 3 → F.Carrier),
        ∀ v i, c (coordinateAction ρ L F h.natural a v) i =
          coefficientAction ρ L F h.natural h.semilinear a (c v i) := by
  exact ⟨fixedField_card F _
      (outer_coefficient_orderOf ρ L F h.natural h.faithful h.semilinear a ha haL) s hdegree,
    exists_fixed_coordinates F ρ L h.natural h.faithful h.semilinear a ha haL⟩

end CFSG.Quasithin.ChapterK.Linear.Natural.FieldActors.Centralizer
