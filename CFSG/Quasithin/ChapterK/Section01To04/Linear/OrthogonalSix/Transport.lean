module

public import CFSG.Quasithin.ChapterK.Section01To04.Linear.OrthogonalSix.Comparison
public import CFSG.Quasithin.ChapterK.Section01To04.Linear.OrthogonalSix.Permutation
public import CFSG.Quasithin.ChapterK.Section01To04.Alternating.ActionTransport

/-!
# Transport of the six-dimensional orthogonal offender conclusions

An intertwining equivalence transports the entire subgroup lattice and its
weights, hence the subgroup generated by best offenders. The existing Chapter K
ratio transport gives the exact ratios. We apply these facts to both A₈ and S₈,
and instantiate the A₈ result on the actual exterior-square representation.
The no-strong-offender bound needs only an injective actor map, which is useful
for the literal subspace action image in the ten-dimensional branch.

Source: Aschbacher–Smith, K.3.2.2–3 and B.4.2(10), printed pp.455 and 86.
The ambient normalizer step remains separate from these model identifications.
-/

public section

open Representation Representation.BinaryOffender BinaryPermutation
open CFSG.Quasithin.ChapterB.QuasisimpleSource
namespace CFSG.Quasithin.ChapterK.Linear.OrthogonalSix

variable {G H V W : Type*} [Group G] [Group H]
  [AddCommGroup V] [Module (ZMod 2) V] [AddCommGroup W] [Module (ZMod 2) W]
  {ρ : Representation (ZMod 2) G V} {σ : Representation (ZMod 2) H W}

private theorem strong_map (f : G →* H) (hf : Function.Injective f)
    (E : V ≃ₗ[ZMod 2] W) (hE : ∀ g v, E (ρ g v) = σ (f g) (E v))
    {A : Subgroup G} (hA : IsStrongOffender ρ A) : IsStrongOffender σ (A.map f) := by
  have he := (show IsOffender ρ A from ⟨hA.1, hA.2.le⟩).map_equivariant ρ σ f hf E hE
  refine ⟨he.1, ?_⟩
  rw [← fixedCodim_map_equivariant ρ σ f E hE, rank_map_injective f hf]
  exact hA.2

/-- Any faithful embedding of actors intertwined with the actual A₈ action
transports the absence of strong offenders. -/
theorem not_strong_of_alternating_embedding
    (f : G →* alternatingGroup (Fin 8)) (hf : Function.Injective f)
    (E : V ≃ₗ[ZMod 2] natural (Fin 8))
    (hE : ∀ g v, E (ρ g v) = alternatingNaturalRepresentation (Fin 8) (f g) (E v)) :
    ¬ IsStrongFFModule ρ := by
  rintro ⟨A, hA⟩
  exact alternating_not_strong ⟨A.map f, strong_map f hf E hE hA⟩

private def reverseAction (e : ActionEquiv ρ σ) : ActionEquiv σ ρ where
  groupEquiv := e.groupEquiv.symm
  linearEquiv := e.linearEquiv.symm
  intertwines g v := by
    apply e.linearEquiv.injective
    rw [e.linearEquiv.apply_symm_apply, e.intertwines,
      e.groupEquiv.apply_symm_apply, e.linearEquiv.apply_symm_apply]

private theorem weight_map (e : ActionEquiv ρ σ) (A : Subgroup G) :
    weight ρ A = weight σ (A.map e.groupEquiv.toMonoidHom) := by
  unfold weight
  rw [rank_map_injective _ e.groupEquiv.injective]
  have h := e.linearEquiv.finrank_map_eq (fixedSpace ρ A)
  rw [fixedSpace_map_equivariant ρ σ e.groupEquiv.toMonoidHom e.linearEquiv e.intertwines] at h
  rw [h]

private theorem best_map [FiniteDimensional (ZMod 2) V]
    (e : ActionEquiv ρ σ) {A : Subgroup G} (hA : IsBestOffender ρ A) :
    IsBestOffender σ (A.map e.groupEquiv.toMonoidHom) := by
  have hoff := (hA.isOffender ρ).map_equivariant ρ σ e.groupEquiv.toMonoidHom e.groupEquiv.injective
    e.linearEquiv e.intertwines
  refine ⟨hoff.1, ?_⟩
  intro B hB
  let S := e.groupEquiv.mapSubgroup
  have hle : S.symm B ≤ A := S.symm_apply_le.mpr hB
  have he : (S.symm B).map e.groupEquiv.toMonoidHom = B := S.apply_symm_apply B
  rw [← weight_map e A, ← he, ← weight_map e (S.symm B)]
  exact hA.2 _ hle

private theorem generated_map [FiniteDimensional (ZMod 2) V]
    [FiniteDimensional (ZMod 2) W] (e : ActionEquiv ρ σ) :
    (offenderSubgroup ρ).map e.groupEquiv.toMonoidHom = offenderSubgroup σ := by
  unfold offenderSubgroup generatedBy
  simp only [Subgroup.map_iSup]
  apply le_antisymm
  · refine iSup_le fun A => iSup_le fun hA => ?_
    exact le_iSup_of_le _ (le_iSup_of_le ⟨best_map e hA.1, le_top⟩ le_rfl)
  · refine iSup_le fun B => iSup_le fun hB => ?_
    refine le_iSup_of_le (B.map e.groupEquiv.symm.toMonoidHom)
      (le_iSup_of_le ⟨best_map (reverseAction e) hB.1, le_top⟩ ?_)
    simp [Subgroup.map_map]

private theorem generated_top [FiniteDimensional (ZMod 2) V]
    [FiniteDimensional (ZMod 2) W] (e : ActionEquiv ρ σ)
    (h : offenderSubgroup σ = ⊤) : offenderSubgroup ρ = ⊤ := by
  apply Subgroup.map_injective (f := e.groupEquiv.toMonoidHom) e.groupEquiv.injective
  rw [generated_map e, h, Subgroup.map_top_of_surjective _ e.groupEquiv.surjective]

/-- All A₈ clauses of B.4.2(10)(i) transported along a genuine action equivalence. -/
theorem alternating_conclusions [FiniteDimensional (ZMod 2) V]
    (e : ActionEquiv ρ (alternatingNaturalRepresentation (Fin 8))) :
    offenderSubgroup ρ = ⊤ ∧ quadraticRatio ρ = 1 ∧
      (∀ A, IsBestOffender ρ A → rank A = 3) ∧ ¬ IsStrongFFModule ρ := by
  refine ⟨generated_top e alternating_offenderSubgroup,
    (Alternating.quadraticRatio_eq e).trans alternating_quadraticRatio, ?_,
    not_strong_of_alternating_embedding e.groupEquiv.toMonoidHom e.groupEquiv.injective
      e.linearEquiv e.intertwines⟩
  intro A hA
  rw [← rank_map_injective e.groupEquiv.toMonoidHom e.groupEquiv.injective]
  exact alternating_best_rank (best_map e hA)

/-- The S₈ clauses of B.4.2(10)(ii), with the full actor and module transported together. -/
theorem symmetric_conclusions [FiniteDimensional (ZMod 2) V]
    (e : ActionEquiv ρ (naturalRepresentation (Fin 8))) :
    offenderSubgroup ρ = ⊤ ∧ quadraticRatio ρ = 3 / 4 :=
  ⟨generated_top e symmetric_offenderSubgroup,
    (Alternating.quadraticRatio_eq e).trans ChapterB.Offenders.Eight.quadraticRatio_natural⟩

open Atlas.Order20160A8

/-- The actual six-dimensional exterior-square representation. -/
noncomputable def exteriorRepresentation :
    Representation (ZMod 2) (Matrix.SpecialLinearGroup (Fin 4) (ZMod 2))
      (Bivectors.Six (ZMod 2)) where
  toFun g := Bivectors.exteriorMap g.val
  map_one' := Bivectors.exteriorMap_one
  map_mul' g h := Bivectors.exteriorMap_mul g.val h.val

/-- The explicit intertwiner as the source's action-equivalence interface. -/
noncomputable def exteriorActionEquiv :
    ActionEquiv exteriorRepresentation (alternatingNaturalRepresentation (Fin 8)) where
  groupEquiv := sl4EquivAlternating
  linearEquiv := exteriorEquivNatural
  intertwines := exteriorEquivNatural_intertwines

/-- The complete offender conclusions on the actual exterior-square model. -/
theorem exterior_conclusions :
    offenderSubgroup exteriorRepresentation = ⊤ ∧ quadraticRatio exteriorRepresentation = 1 ∧
      (∀ A, IsBestOffender exteriorRepresentation A → rank A = 3) ∧
      ¬ IsStrongFFModule exteriorRepresentation :=
  alternating_conclusions exteriorActionEquiv

end CFSG.Quasithin.ChapterK.Linear.OrthogonalSix
