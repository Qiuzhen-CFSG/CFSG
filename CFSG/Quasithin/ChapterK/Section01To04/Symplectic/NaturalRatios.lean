module
public import CFSG.Quasithin.ChapterK.Section01To04.Symplectic.NaturalRatios.Ambient
public import Theory.Representation.SymplecticConjugatePair.ElementaryGeometry.NaturalRatioBounds

/-!
# The natural-model conclusions of K.3.4.1

For the genuine Chapter K source hypotheses and an actual natural-module
identification over a field of order 2^r, r > 1, the quadratic ratio is 2/3
and the subgroup generated by all best offenders is the original component L.

The native root and parabolic bounds give the lower ratio inequality. The
plane radical supplies the matching quadratic offender. Every ambient
offender lies in L by the literal normalizer calculation; the offender-generated
subgroup is nontrivial and normal, so simplicity of L identifies it with L.
Ambient conjugation is also proved faithful and diagram-preserving, with its
actual inner-times-field normal form. Actors of ratio below one are placed in
a conjugate of the plane radical using the original component and model maps.

Recognition of the natural identification is the separate input allowed here.
No conclusion of B.4.2 or K.3.4 is used in these proofs.
Source: Aschbacher–Smith, K.3.4.1, printed p.456 (PDF p.467), and the
natural alternative B.4.2(3), printed p.86 (PDF p.97).
-/

public section
open scoped ENNReal
open Subgroup Representation Representation.BinaryOffender Theory.GroupTheory
open Theory.SpecificGroups.SymplecticFour
open Theory.SpecificGroups.SymplecticFour.DiagramAutomorphisms
open SymplecticConjugatePair
namespace CFSG.Quasithin.ChapterK.Symplectic
variable {F G V : Type*} [Field F] [Finite F] [CharP F 2] [Algebra (ZMod 2) F]
  [Group G] [AddCommGroup V] [Module (ZMod 2) V]
  {ρ : Representation (ZMod 2) G V} {L : Subgroup G} {K : GroupClass}

/-- The source small-ratio placement, with the original actor and literal
component and model maps retained. -/
theorem natural_small_ratio_placement (hs : SourceHypothesis K ρ L)
    {r : ℕ} (hF : Nat.card F = 2 ^ r) (hr : 1 < r)
    (h : NaturalIdentification (F := F) (ρ.comp L.subtype))
    {A : Subgroup G} (hA : IsElementaryTwo A) (hlt : actionRatio ρ A < 1) :
    A ≤ L ∧ ∃ g : Sp F,
      ((A.subgroupOf L).map h.groupEquiv.toMonoidHom).map
        (MulAut.conj g).toMonoidHom ≤ planeRadical := by
  let := hs.finite_group
  let := hs.component_normal
  have hO : IsOffender ρ A := ⟨hA, (actionRatio_le_one_iff ρ hA).mp hlt.le⟩
  have hAL := h.offender_le hF hr hs.faithful hO
  have hB := (hO.subgroupOf ρ hAL).map_equivariant (ρ.comp L.subtype)
    binaryNatural h.groupEquiv.toMonoidHom h.groupEquiv.injective
    h.linearEquiv h.intertwines
  refine ⟨hAL, NaturalBounds.elementary_small_ratio_conjugate_plane hF (by omega) hB.1 ?_⟩
  have hc := fixedCodim_map_equivariant (ρ.comp L.subtype) binaryNatural
    h.groupEquiv.toMonoidHom h.linearEquiv h.intertwines (A.subgroupOf L)
  simpa only [actionRatio, rank_map_injective h.groupEquiv.toMonoidHom h.groupEquiv.injective,
    rank_subgroupOf hAL, ← hc, fixedCodim_subgroupOf ρ hAL] using hlt

/-- Every elementary actor has ratio at least 2/3 in the original ambient action. -/
theorem natural_actionRatio_lower (hs : SourceHypothesis K ρ L)
    {r : ℕ} (hF : Nat.card F = 2 ^ r) (hr : 1 < r)
    (h : NaturalIdentification (F := F) (ρ.comp L.subtype))
    {A : Subgroup G} (hA : IsElementaryTwo A) :
    (2 : ℝ≥0∞) / 3 ≤ actionRatio ρ A := by
  let := hs.finite_group
  let := hs.finite_module
  let := hs.component_normal
  by_cases ho : actionRatio ρ A ≤ 1
  · have hO : IsOffender ρ A := ⟨hA, (actionRatio_le_one_iff ρ hA).mp ho⟩
    have hAL := h.offender_le hF hr hs.faithful hO
    have hB := (hO.subgroupOf ρ hAL).map_equivariant (ρ.comp L.subtype)
      binaryNatural h.groupEquiv.toMonoidHom h.groupEquiv.injective
      h.linearEquiv h.intertwines
    have hb := NaturalBounds.elementary_natural_ratio_lower hF (by omega) hB.1
    have hc := fixedCodim_map_equivariant (ρ.comp L.subtype) binaryNatural
      h.groupEquiv.toMonoidHom h.linearEquiv h.intertwines (A.subgroupOf L)
    unfold actionRatio at hb ⊢
    rw [rank_map_injective h.groupEquiv.toMonoidHom h.groupEquiv.injective, rank_subgroupOf hAL,
      ← hc, fixedCodim_subgroupOf ρ hAL] at hb
    exact hb
  · have htwo : (2 : ℝ≥0∞) / 3 ≤ 1 := by
      rw [ENNReal.div_le_iff (by norm_num) (by simp), one_mul]
      norm_num
    exact htwo.trans (le_of_not_ge ho)

/-- K.3.4.1's exact quadratic ratio, using the actual natural recognition maps. -/
theorem natural_quadraticRatio_eq (hs : SourceHypothesis K ρ L)
    {r : ℕ} (hF : Nat.card F = 2 ^ r) (hr : 1 < r)
    (h : NaturalIdentification (F := F) (ρ.comp L.subtype)) :
    quadraticRatio ρ = (2 : ℝ≥0∞) / 3 := by
  apply le_antisymm (natural_quadraticRatio_le ρ L hF (by omega) h)
  exact le_iInf fun A => le_iInf fun hA => natural_actionRatio_lower hs hF hr h hA.1

/-- B.4.2(3): all best offenders generate exactly the original component. -/
theorem natural_offenderSubgroup_eq (hs : SourceHypothesis K ρ L)
    {r : ℕ} (hF : Nat.card F = 2 ^ r) (hr : 1 < r)
    (h : NaturalIdentification (F := F) (ρ.comp L.subtype)) :
    offenderSubgroup ρ = L := by
  let := hs.finite_group
  let := hs.finite_module
  let := hs.component_normal
  let := h.component_simple hs
  have hle : offenderSubgroup ρ ≤ L := by
    apply iSup_le
    intro A
    apply iSup_le
    rintro ⟨hA,_⟩
    exact h.offender_le hF hr hs.faithful (hA.isOffender ρ)
  have hne : offenderSubgroup ρ ≠ ⊥ := by
    obtain ⟨A,_,_,_,_,_,_,hA⟩ := natural_actor ρ L hF (by omega) h
    exact offenderSubgroup_ne_bot_of_ff ρ ⟨A,hA.1,hA.2.le⟩
  let := offenderSubgroup_normal ρ
  rcases (inferInstance : ((offenderSubgroup ρ).subgroupOf L).Normal).eq_bot_or_eq_top with hb | ht
  · have hm := congrArg (fun A : Subgroup L => A.map L.subtype) hb
    rw [map_subgroupOf_eq_of_le hle, Subgroup.map_bot] at hm
    exact (hne hm).elim
  · have hm := congrArg (fun A : Subgroup L => A.map L.subtype) ht
    simpa only [map_subgroupOf_eq_of_le hle, ← MonoidHom.range_eq_map, Subgroup.range_subtype] using hm

/-- The ambient conjugation action is faithful and preserves both parabolic
classes. Every induced automorphism is an inner automorphism times a field automorphism. -/
theorem natural_ambient_automorphisms (hs : SourceHypothesis K ρ L)
    {r : ℕ} (hF : Nat.card F = 2 ^ r) (hr : 1 < r)
    (h : NaturalIdentification (F := F) (ρ.comp L.subtype)) :
    let : L.Normal := hs.component_normal
    Function.Injective (extensionAction L h.groupEquiv.symm) ∧
      (∀ g : G, PreservesDiagram (extensionAction L h.groupEquiv.symm g)) ∧
      ∀ g : G, ∃ (x : Sp F) (σ : F ≃+* F),
        extensionAction L h.groupEquiv.symm g = MulAut.conj x * fieldAutomorphism σ := by
  let : L.Normal := hs.component_normal
  have hcard : 2 < Nat.card F := by
    rw [hF]
    exact (by norm_num : 2 = 2 ^ 1) ▸ Nat.pow_lt_pow_right (by decide) hr
  exact ⟨extensionAction_injective L h.groupEquiv.symm (h.component_centralizer hs),
    h.preservesDiagram hcard, h.semilinear_conjugation hcard⟩

/-- The natural alternative of K.3.4.1 supplies all numerical and offender-group
conclusions of B.4.2(3), with an actual isomorphism of its generated subgroup. -/
theorem natural_conclusions (hs : SourceHypothesis K ρ L)
    {r : ℕ} (hF : Nat.card F = 2 ^ r) (hr : 1 < r)
    (h : NaturalIdentification (F := F) (ρ.comp L.subtype)) :
    quadraticRatio ρ = (2 : ℝ≥0∞) / 3 ∧ offenderSubgroup ρ = L ∧
      Nonempty (offenderSubgroup ρ ≃* Sp F) := by
  have he := natural_offenderSubgroup_eq hs hF hr h
  exact ⟨natural_quadraticRatio_eq hs hF hr h, he,
    ⟨(MulEquiv.subgroupCongr he).trans h.groupEquiv⟩⟩

end CFSG.Quasithin.ChapterK.Symplectic
