module

public import CFSG.Quasithin.Chapter7.Section01To05.FixedSpaceSpan

/-!
# The source index-two fixed-space span

For an elementary abelian actor `A` normalizing an elementary abelian group
`V`, the nonidentity elements of `Aut_A(V)` have order two. Their cyclic
subgroups lift to the subgroups `B` between `C_A(V)` and `A` with
`|B : C_A(V)| = 2`. The fixed-space span in the induced representation is
therefore exactly the ambient subgroup generated by the source centralizers
`C_V(B)`. The lifts are full inverse images, so they retain the required
containment of the entire action kernel.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004, Lemma 7.5.3,
printed p.700, with the fixed-space construction of H.10.1.
-/

@[expose] public section
namespace CFSG.Quasithin.Chapter7
open Subgroup Representation.BinaryOffender ChapterE
open scoped IsMulCommutative
variable {G : Type*} [Group G]

/-- The subgroup generated by the source centralizers in 7.5.3. The acting
subgroups contain the action kernel and have order two modulo that kernel. -/
noncomputable def sourceFixedSpan (V A : Subgroup G) : Subgroup G :=
  ⨆ (B : Subgroup G) (_ : B ≤ A) (_ : A ⊓ centralizer (V : Set G) ≤ B)
    (_ : (A ⊓ centralizer (V : Set G)).relIndex B = 2),
    V ⊓ centralizer (B : Set G)

private theorem card_inducedAutomizer (V B : Subgroup G)
    (hB : B ≤ normalizer (V : Set G)) :
    Nat.card (inducedAutomizer V B) =
      (B ⊓ centralizer (V : Set G)).relIndex B := by
  unfold inducedAutomizer
  rw [← Subgroup.relIndex_ker, MonoidHom.ker_rangeRestrict,
    Subgroup.normalizerMonoidHom_ker, Subgroup.relIndex_subgroupOf hB,
    Subgroup.inf_relIndex_left]

private theorem lift_induced_subgroup_with_kernel {V A : Subgroup G}
    (hA : A ≤ normalizer (V : Set G))
    (D : Subgroup (Automizer V)) (hD : D ≤ inducedAutomizer V A) :
    ∃ B ≤ A, A ⊓ centralizer (V : Set G) ≤ B ∧ inducedAutomizer V B = D := by
  let N := normalizer (V : Set G)
  let f := V.normalizerMonoidHom.rangeRestrict
  let C := A.subgroupOf N
  let L := C ⊓ D.comap f
  let B := L.map N.subtype
  have hBA : B ≤ A := by
    rintro _ ⟨x, hx, rfl⟩
    exact hx.1
  have hBN : B.subgroupOf N = L :=
    Subgroup.comap_map_eq_self_of_injective N.subtype_injective L
  have hmap : L.map f = D := by
    apply le_antisymm
    · rintro _ ⟨x, hx, rfl⟩
      exact hx.2
    · intro d hd
      obtain ⟨x, hx, he⟩ := hD hd
      exact ⟨x, ⟨hx, (show f x ∈ D from he.symm ▸ hd)⟩, he⟩
  refine ⟨B, hBA, ?_, ?_⟩
  · intro c hc
    have hf : f ⟨c, hA hc.1⟩ = 1 := by
      change (⟨c, hA hc.1⟩ : N) ∈ f.ker
      rw [MonoidHom.ker_rangeRestrict, Subgroup.normalizerMonoidHom_ker]
      exact hc.2
    refine ⟨⟨c, hA hc.1⟩, ⟨hc.1, ?_⟩, rfl⟩
    change f ⟨c, hA hc.1⟩ ∈ D
    rw [hf]
    exact D.one_mem
  · change (B.subgroupOf N).map f = D
    rw [hBN, hmap]

/-- The fixed-space span of the actual induced action equals the source's
span over subgroups of order two modulo the full action kernel. -/
theorem ambientSubmodule_fixedSpaceSpan_eq_sourceFixedSpan [Finite G]
    (V A : Subgroup G) [IsElementaryAbelian 2 V] [IsElementaryAbelian 2 A]
    (hA : A ≤ normalizer (V : Set G)) :
    ambientSubmodule V (fixedSpaceSpan (automizerRepresentation V)
      (inducedAutomizer V A)) = sourceFixedSpan V A := by
  let := inducedAutomizer_elementary V A hA
  apply le_antisymm
  · simp only [fixedSpaceSpan, ambientSubmodule_iSup]
    refine iSup_le fun a => iSup_le fun ha => iSup_le fun ha1 => ?_
    have ha2 : a ^ 2 = 1 := elemPow_eq_one_of_isElementaryAbelian a ha
    have hcard : Nat.card (zpowers a) = 2 := by
      rw [Nat.card_zpowers, orderOf_eq_prime ha2 ha1]
    obtain ⟨B, hBA, hCB, hBI⟩ := lift_induced_subgroup_with_kernel hA
      (zpowers a) (zpowers_le.mpr ha)
    have hBC : B ⊓ centralizer (V : Set G) = A ⊓ centralizer (V : Set G) :=
      le_antisymm (inf_le_inf hBA le_rfl) (le_inf hCB inf_le_right)
    have hindex : (A ⊓ centralizer (V : Set G)).relIndex B = 2 := by
      rw [← hBC, ← card_inducedAutomizer V B (hBA.trans hA), hBI]
      exact hcard
    rw [← hBI, ambientSubmodule_fixedSpace V B (hBA.trans hA)]
    exact le_iSup_of_le B (le_iSup_of_le hBA
      (le_iSup_of_le hCB (le_iSup_of_le hindex le_rfl)))
  · refine iSup_le fun B => iSup_le fun hBA => iSup_le fun hCB =>
      iSup_le fun hindex => ?_
    have hBC : B ⊓ centralizer (V : Set G) = A ⊓ centralizer (V : Set G) :=
      le_antisymm (inf_le_inf hBA le_rfl) (le_inf hCB inf_le_right)
    have hcard : Nat.card (inducedAutomizer V B) = 2 := by
      rw [card_inducedAutomizer V B (hBA.trans hA), hBC]
      exact hindex
    let : Nontrivial (inducedAutomizer V B) := Finite.one_lt_card_iff_nontrivial.mp
      (by rw [hcard]; decide)
    obtain ⟨a, ha⟩ := exists_ne (1 : inducedAutomizer V B)
    have hne : (a : Automizer V) ≠ 1 := fun he => ha (Subtype.ext he)
    have haA : (a : Automizer V) ∈ inducedAutomizer V A :=
      (Subgroup.map_mono (Subgroup.comap_mono hBA)) a.property
    rw [← ambientSubmodule_fixedSpace V B (hBA.trans hA)]
    apply Subgroup.map_mono
    apply (moduleSubgroup V).monotone
    exact (fixedSpace_antitone (automizerRepresentation V) (zpowers_le.mpr a.property)).trans
      (fixedSpace_le_fixedSpaceSpan (automizerRepresentation V) haA hne)

end CFSG.Quasithin.Chapter7
