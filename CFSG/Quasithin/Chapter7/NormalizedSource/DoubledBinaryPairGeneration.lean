/-!
# Quadratic binary offenders and pair generation

Commuting involutions act quadratically on the natural SL₃(2) module and
its literal dual. A small matrix certificate handles a normalized involution;
conjugation and the original automizer marking transport the calculation.
Quadraticity then bounds literal group commutators, assuming only relative
normalization of the module group.

For a symmetric pair, these bounds put the product of the normalizer
hyperplanes in a two-step central series. Every odd subgroup of the pair
fixes that product by coprime action. Controlled hyperplane centralizers
then make it fix both generating module groups. Sylow theory finishes:
a finite group generated by two-subgroups with all odd subgroups central
is a two-group.

The original chosen-orbit application is in
`NonFFSourceDoubledBinaryPairGeneration`. Source: Aschbacher–Smith H.4.3(2)
and the pair-generation paragraph of 7.6.1, printed pp.380,702,
refs/quasithin.pdf. The final Sylow argument avoids choosing a Hall
complement in the intermediate dihedral quotient.
-/

public noncomputable section
open Subgroup Representation Representation.BinaryOffender
open scoped IsMulCommutative Matrix

namespace CFSG.Quasithin.Chapter7.NormalizedSource.DoubledBinaryPairGeneration
open BinaryLinearThree
open BinaryLinearThree.FourGroupGeometry.FixedSpaces

private theorem normalized_pair : ∀ a : BinaryLinearThree.Group, a * a = 1 →
    a * involution = involution * a → ∀ v : BinaryLinearThree.Vector,
      a.val *ᵥ (involution.val *ᵥ v - v) = involution.val *ᵥ v - v := by
  decide +kernel

private theorem representation_conjugate
    {J U : Type*} [_root_.Group J] [AddCommGroup U] [Module (ZMod 2) U]
    (ρ : Representation (ZMod 2) J U) (k g : J) (x : U) :
    ρ k (ρ g x) = ρ (MulAut.conj k g) (ρ k x) := by
  have heq : k * g = MulAut.conj k g * k := by
    simp only [MulAut.conj_apply, mul_assoc, inv_mul_cancel, mul_one]
  rw [← Module.End.mul_apply, ← map_mul, heq, map_mul, Module.End.mul_apply]

private theorem natural_pair (a b : BinaryLinearThree.Group) (ha : a ^ 2 = 1) (hb : b ^ 2 = 1)
    (hab : a * b = b * a) (v : BinaryLinearThree.Vector) : W a (W b v - v) = W b v - v := by
  by_cases hb1 : b = 1
  · simp only [hb1, map_one, Module.End.one_apply, sub_self, map_zero]
  obtain ⟨k,hk⟩ := exists_involution_conjugator b hb1 (by simpa [pow_two] using hb)
  let e := MulAut.conj k⁻¹
  have heb : e b = involution := by
    change k⁻¹ * b * (k⁻¹)⁻¹ = involution
    rw [inv_inv,mul_assoc,hk,inv_mul_cancel_left]
  have hea : e a * e a = 1 := by rw [←map_mul,←pow_two,ha,map_one]
  have hec : e a * involution = involution * e a := by
    rw [←heb,←map_mul,←map_mul,hab]
  have he (g : BinaryLinearThree.Group) (x : BinaryLinearThree.Vector) : W k⁻¹ (W g x) = W (e g) (W k⁻¹ x) :=
    representation_conjugate W k⁻¹ g x
  have hinj : Function.Injective (W k⁻¹) := (W.apply_bijective k⁻¹).injective
  apply hinj
  simp only [he, map_sub, heb]
  rw [← map_sub]
  exact normalized_pair (e a) hea hec (W k⁻¹ v)

private theorem natural_quadratic (A : Subgroup BinaryLinearThree.Group) [IsElementaryAbelian 2 A] :
    IsQuadratic W A := by
  intro a ha b hb v
  exact natural_pair a b (elemPow_eq_one_of_isElementaryAbelian _ ha)
    (elemPow_eq_one_of_isElementaryAbelian _ hb) (setLike_mul_comm ha hb) v

private theorem naturalDual_quadratic (A : Subgroup BinaryLinearThree.Group) [IsElementaryAbelian 2 A] :
    IsQuadratic NaturalDual.action A := by
  exact (quadratic_prod_iff W W.dual A).mpr
    ⟨natural_quadratic A,(isQuadratic_dual_iff W A).mpr (natural_quadratic A)⟩

end CFSG.Quasithin.Chapter7.NormalizedSource.DoubledBinaryPairGeneration

namespace CFSG.Quasithin.Chapter7.NormalizedSource
open BinaryLinearThree

/-- Quadraticity transported through the unchanged component and full automizer marking. -/
theorem doubledBinary_inner_quadratic
    {H J U : Type*} [_root_.Group H] [_root_.Group J]
    [AddCommGroup U] [Module (ZMod 2) U]
    (ρ : Representation (ZMod 2) H U) (i : J →* H)
    (q : J →* BinaryLinearThree.Group) (hq : Function.Surjective q)
    (E : U ≃ₗ[ZMod 2] NaturalDual.Space)
    (hE : ∀ j v, E (ρ (i j) v) = NaturalDual.action (q j) (E v))
    (f : H ≃* MulAut BinaryLinearThree.Group) (hf : ∀ j, f (i j) = MulAut.conj (q j))
    (A : Subgroup H) [IsElementaryAbelian 2 A]
    (hAI : ∀ a ∈ A, f a ∈ MulAut.innerSubgroup BinaryLinearThree.Group) : IsQuadratic ρ A := by
  let B := A.map f.toMonoidHom
  let C := B.comap (MulAut.conj : BinaryLinearThree.Group →* MulAut BinaryLinearThree.Group)
  let : IsElementaryAbelian 2 B := IsElementaryAbelian.map _
  let : IsElementaryAbelian 2 C := IsElementaryAbelian.comap_of_injective _
    (MulAut.conj_injective_of_center_eq_bot Matrix.PSL3Two.center_eq_bot) B
  have hact (g : BinaryLinearThree.Group) (v : U) :
      E (ρ (f.symm (MulAut.conj g)) v) = NaturalDual.action g (E v) := by
    obtain ⟨j,rfl⟩ := hq g
    rw [← hf j, f.symm_apply_apply]
    exact hE j v
  intro a ha b hb v
  obtain ⟨a₀,ha₀⟩ := hAI a ha
  obtain ⟨b₀,hb₀⟩ := hAI b hb
  have haC : a₀ ∈ C := by
    change MulAut.conj a₀ ∈ B
    rw [ha₀]
    exact mem_map_of_mem f.toMonoidHom ha
  have hbC : b₀ ∈ C := by
    change MulAut.conj b₀ ∈ B
    rw [hb₀]
    exact mem_map_of_mem f.toMonoidHom hb
  have hqa := DoubledBinaryPairGeneration.naturalDual_quadratic C a₀ haC b₀ hbC (E v)
  have hea (v : U) : E (ρ a v) = NaturalDual.action a₀ (E v) := by
    simpa only [ha₀, f.symm_apply_apply] using hact a₀ v
  have heb (v : U) : E (ρ b v) = NaturalDual.action b₀ (E v) := by
    simpa only [hb₀, f.symm_apply_apply] using hact b₀ v
  apply E.injective
  simpa only [hea, heb, map_sub] using hqa

end CFSG.Quasithin.Chapter7.NormalizedSource

namespace CFSG.Quasithin.Chapter7.NormalizedSource.DoubledBinaryPairGeneration
open ChapterE
open scoped commutatorElement

/-- Quadraticity of the literal induced action places the commutator in its relative centralizer. -/
theorem commutator_le_fixed_of_quadratic
    {G : Type*} [_root_.Group G] (W A : Subgroup G) [IsElementaryAbelian 2 W]
    (hAN : A ≤ normalizer (W : Set G))
    (hq : IsQuadratic (automizerRepresentation W) (inducedAutomizer W A)) :
    ⁅W,A⁆ ≤ W ⊓ centralizer (A : Set G) := by
  rw [commutator_comm]
  apply commutator_le.mpr
  intro a ha w hw
  let v : Additive W := Additive.ofMul ⟨w,hw⟩
  let b : Automizer W := W.normalizerMonoidHom.rangeRestrict ⟨a,hAN ha⟩
  have hb : b ∈ inducedAutomizer W A := ⟨⟨a,hAN ha⟩,ha,rfl⟩
  let d := automizerRepresentation W b v - v
  have hd : d ∈ fixedSpace (automizerRepresentation W) (inducedAutomizer W A) :=
    fun c => hq c c.property b hb v
  have he : (d.toMul : G) = ⁅a,w⁆ := by
    change (a * w * a⁻¹) / w = _
    rw [div_eq_mul_inv, commutatorElement_def]
  rw [←he]
  exact ⟨d.toMul.property, (mem_fixedSpace_inducedAutomizer W A hAN d).mp hd⟩

end CFSG.Quasithin.Chapter7.NormalizedSource.DoubledBinaryPairGeneration

namespace CFSG.Quasithin.Chapter7.NormalizedSource.DoubledBinaryPairGeneration
open ChapterE

/-- The two normalizer hyperplanes form a normal two-subgroup with two central layers. -/
theorem pair_series
    {G : Type*} [_root_.Group G] (W Wg : Subgroup G)
    [IsElementaryAbelian 2 W] [IsElementaryAbelian 2 Wg]
    (hf : ⁅W,Wg ⊓ normalizer (W : Set G)⁆ ≤ W ⊓ centralizer (Wg : Set G))
    (hr : ⁅Wg,W ⊓ normalizer (Wg : Set G)⁆ ≤ Wg ⊓ centralizer (W : Set G)) :
    let A := Wg ⊓ normalizer (W : Set G)
    let B := W ⊓ normalizer (Wg : Set G)
    let Z := (W ⊓ centralizer (Wg : Set G)) ⊔ (Wg ⊓ centralizer (W : Set G))
    let X := W ⊔ Wg
    IsPGroup 2 (A ⊔ B : Subgroup G) ∧
      ((A ⊔ B).subgroupOf X).Normal ∧
      X ≤ centralizer (Z : Set G) ∧ ⁅X,A ⊔ B⁆ ≤ Z := by
  dsimp only
  let A := Wg ⊓ normalizer (W : Set G)
  let B := W ⊓ normalizer (Wg : Set G)
  let U := W ⊓ centralizer (Wg : Set G)
  let U₁ := Wg ⊓ centralizer (W : Set G)
  let Z := U ⊔ U₁
  let X := W ⊔ Wg
  have hUB : U ≤ B := inf_le_inf_left W (Subgroup.centralizer_le_normalizer _)
  have hUA : U₁ ≤ A := inf_le_inf_left Wg (Subgroup.centralizer_le_normalizer _)
  have hZN : Z ≤ A ⊔ B := sup_le (hUB.trans le_sup_right) (hUA.trans le_sup_left)
  have hAX : A ≤ X := inf_le_left.trans le_sup_right
  have hBX : B ≤ X := inf_le_left.trans le_sup_left
  have hNX : A ⊔ B ≤ X := sup_le hAX hBX
  have hWW : W ≤ centralizer (W : Set G) := le_centralizer_iff_isMulCommutative.mpr inferInstance
  have hgg : Wg ≤ centralizer (Wg : Set G) := le_centralizer_iff_isMulCommutative.mpr inferInstance
  have hXU : X ≤ centralizer (U : Set G) := sup_le
    (hWW.trans (centralizer_le inf_le_left)) (le_centralizer_iff.mpr inf_le_right)
  have hXU₁ : X ≤ centralizer (U₁ : Set G) := sup_le
    (le_centralizer_iff.mpr inf_le_right) (hgg.trans (centralizer_le inf_le_left))
  have hXZ : X ≤ centralizer (Z : Set G) := le_centralizer_iff.mpr
    (sup_le (le_centralizer_iff.mp hXU) (le_centralizer_iff.mp hXU₁))
  have hnZ := hXZ.trans (Subgroup.centralizer_le_normalizer _)
  have hXA : ⁅X,A⁆ ≤ Z :=
    commutator_sup_le_of_relative_normal X W Wg A Z hnZ le_sup_left le_sup_right
      (hf.trans le_sup_left)
      ((commutator_mono le_rfl inf_le_left).trans
        ((commutator_self_eq_bot_iff.mpr (inferInstance : IsMulCommutative Wg)).le.trans bot_le))
  have hXB : ⁅X,B⁆ ≤ Z :=
    commutator_sup_le_of_relative_normal X W Wg B Z hnZ le_sup_left le_sup_right
      ((commutator_mono le_rfl inf_le_left).trans
        ((commutator_self_eq_bot_iff.mpr (inferInstance : IsMulCommutative W)).le.trans bot_le))
      (hr.trans le_sup_right)
  have hXN : ⁅X,A ⊔ B⁆ ≤ Z := by
    rw [commutator_comm]
    apply commutator_sup_le_of_relative_normal X A B X Z hnZ hAX hBX
    · rwa [commutator_comm]
    · rwa [commutator_comm]
  have hn : ((A ⊔ B).subgroupOf X).Normal :=
    (normal_subgroupOf_iff_le_normalizer hNX).mpr
      (le_normalizer_iff_commutator_le_right.mpr (hXN.trans hZN))
  have hAB : A ≤ normalizer (B : Set G) :=
    le_normalizer_iff_commutator_le_left.mpr
      ((commutator_mono inf_le_left le_rfl).trans (hf.trans hUB))
  have hAp : IsPGroup 2 A := (IsElementaryAbelian.isPGroup 2 Wg).of_injective (inclusion inf_le_left) (inclusion_injective _)
  have hBp : IsPGroup 2 B := (IsElementaryAbelian.isPGroup 2 W).of_injective (inclusion inf_le_left) (inclusion_injective _)
  exact ⟨hAp.to_sup_of_normal_right' hBp hAB, hn, hXZ, hXN⟩

end CFSG.Quasithin.Chapter7.NormalizedSource.DoubledBinaryPairGeneration

namespace CFSG.Quasithin.Chapter7.NormalizedSource.DoubledBinaryPairGeneration
open scoped commutatorElement

private theorem odd_fixes_hyperplane
    {G : Type*} [_root_.Group G] (W B Y : Subgroup G) [IsElementaryAbelian 2 W]
    (hBW : B ≤ W) (hi : B.relIndex W = 2)
    (hYW : Y ≤ normalizer (W : Set G)) (hYB : Y ≤ centralizer (B : Set G))
    (ho : Odd (Nat.card Y)) : Y ≤ centralizer (W : Set G) := by
  have hnB := hYB.trans (Subgroup.centralizer_le_normalizer _)
  have hcomm : ⁅W,Y⁆ ≤ B := by
    rw [commutator_comm]
    apply commutator_le.mpr
    intro y hy w hw
    let w' : W := W.normalizerMonoidHom ⟨y,hYW hy⟩ ⟨w,hw⟩
    have hm : w' * (⟨w,hw⟩ : W)⁻¹ ∈ B.subgroupOf W := by
      apply (B.subgroupOf W).mul_mem_iff_of_index_two hi |>.mpr
      change y * w * y⁻¹ ∈ B ↔ w⁻¹ ∈ B
      rw [inv_mem_iff]
      exact (mem_normalizer_iff.mp (hnB hy) w).symm
    exact hm
  exact le_centralizer_of_fixed_coprime_prime_layer Y W B
    ((IsElementaryAbelian.isPGroup 2 W).to_le hBW) ho.coprime_two_left hYB hcomm

/-- An odd subgroup of a pair centralizing the two-step series fixes the
whole pair once both hyperplane centralizers normalize their parent groups. -/
theorem odd_pair_centralizes
    {G : Type*} [_root_.Group G] (W Wg A B Z Y : Subgroup G)
    [IsElementaryAbelian 2 W] [IsElementaryAbelian 2 Wg]
    (hAW : A ≤ Wg) (hBW : B ≤ W) (hiA : A.relIndex Wg = 2) (hiB : B.relIndex W = 2)
    (hCZ : W ⊔ Wg ≤ centralizer (Z : Set G))
    (hstep : ⁅W ⊔ Wg,A ⊔ B⁆ ≤ Z) (hZN : Z ≤ A ⊔ B)
    (hpN : IsPGroup 2 (A ⊔ B : Subgroup G))
    (hCB : centralizer (B : Set G) ≤ normalizer (W : Set G))
    (hCA : centralizer (A : Set G) ≤ normalizer (Wg : Set G))
    (hYX : Y ≤ W ⊔ Wg) (ho : Odd (Nat.card Y)) :
    Y ≤ centralizer ((W ⊔ Wg : Subgroup G) : Set G) := by
  have hcomm : ⁅A ⊔ B,Y⁆ ≤ Z := by
    rw [commutator_comm]
    exact (commutator_mono hYX le_rfl).trans hstep
  have hYN := le_centralizer_of_fixed_coprime_prime_layer Y (A ⊔ B) Z
    (hpN.to_le hZN) ho.coprime_two_left (hYX.trans hCZ) hcomm
  have hYA := hYN.trans (centralizer_le (show A ≤ A ⊔ B from le_sup_left))
  have hYB := hYN.trans (centralizer_le (show B ≤ A ⊔ B from le_sup_right))
  have hYW := odd_fixes_hyperplane W B Y hBW hiB (hYB.trans hCB) hYB ho
  have hYg := odd_fixes_hyperplane Wg A Y hAW hiA (hYA.trans hCA) hYA ho
  exact le_centralizer_iff.mpr (sup_le (le_centralizer_iff.mp hYW) (le_centralizer_iff.mp hYg))

end CFSG.Quasithin.Chapter7.NormalizedSource.DoubledBinaryPairGeneration

namespace CFSG.Quasithin.Chapter7.NormalizedSource.DoubledBinaryPairGeneration

private theorem isPGroup_of_odd_subgroups_central
    {G : Type*} [_root_.Group G] [Finite G] (W V : Subgroup G)
    (hW : IsPGroup 2 W) (hV : IsPGroup 2 V) (hgen : W ⊔ V = ⊤)
    (hodd : ∀ Y : Subgroup G, Odd (Nat.card Y) → Y ≤ center G) : IsPGroup 2 G := by
  let S : Sylow 2 G := Classical.choice inferInstance
  have hi : (normalizer (S : Set G)).index = 1 := by
    by_contra hn
    obtain ⟨p,hp,hpd⟩ := Nat.exists_prime_and_dvd hn
    let : Fact p.Prime := ⟨hp⟩
    by_cases hp2 : p = 2
    · subst p
      exact S.not_dvd_index (hpd.trans (index_dvd_of_le S.toSubgroup.le_normalizer))
    let P : Sylow p G := Classical.choice inferInstance
    obtain ⟨n,hn⟩ := P.isPGroup'.exists_card_eq
    have ho : Odd (Nat.card P) := by
      rw [hn]
      exact (hp.odd_of_ne_two hp2).pow
    have hPN : (P : Subgroup G) ≤ normalizer (S : Set G) :=
      (hodd P ho).trans ((center_le_centralizer _).trans (Subgroup.centralizer_le_normalizer _))
    exact P.not_dvd_index (hpd.trans (index_dvd_of_le hPN))
  have hSN : S.Normal := normalizer_eq_top_iff.mp (index_eq_one.mp hi)
  let : Unique (Sylow 2 G) := S.unique_of_normal hSN
  obtain ⟨P,hWP⟩ := hW.exists_le_sylow
  obtain ⟨Q,hVQ⟩ := hV.exists_le_sylow
  have htop : (S : Subgroup G) = ⊤ := by
    apply top_unique
    rw [←hgen]
    exact sup_le ((Subsingleton.elim P S) ▸ hWP) ((Subsingleton.elim Q S) ▸ hVQ)
  exact (htop ▸ S.isPGroup').of_equiv topEquiv

/-- A finite group generated by two-subgroups is a two-group if every odd
subgroup centralizes it. This is the final pair-generation deduction of 7.6.1. -/
theorem pair_isPGroup_of_odd_centralizes
    {G : Type*} [_root_.Group G] [Finite G] (W V : Subgroup G)
    (hW : IsPGroup 2 W) (hV : IsPGroup 2 V)
    (hodd : ∀ Y : Subgroup G, Y ≤ W ⊔ V → Odd (Nat.card Y) →
      Y ≤ centralizer ((W ⊔ V : Subgroup G) : Set G)) :
    IsPGroup 2 (W ⊔ V : Subgroup G) := by
  let X := W ⊔ V
  apply isPGroup_of_odd_subgroups_central (W.subgroupOf X) (V.subgroupOf X)
    hW.comap_subtype hV.comap_subtype
  · rw [←subgroupOf_sup le_sup_left le_sup_right,subgroupOf_self]
  intro Y hY
  have ho : Odd (Nat.card (Y.map X.subtype)) := by
    rwa [card_map_of_injective X.subtype_injective]
  have hc := hodd (Y.map X.subtype) (map_subtype_le _) ho
  intro y hy
  rw [mem_center_iff]
  intro x
  apply Subtype.ext
  exact hc (mem_map_of_mem X.subtype hy) x x.property

end CFSG.Quasithin.Chapter7.NormalizedSource.DoubledBinaryPairGeneration
