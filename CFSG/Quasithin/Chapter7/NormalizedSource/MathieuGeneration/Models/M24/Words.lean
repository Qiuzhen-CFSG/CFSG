    (twentyonePrime i = 3 ∧ twentyoneWord i ^ 3 = 1 ∧ (twentyoneWord i).supportᶜ.card = 6) ∨
    (twentyonePrime i ≠ 3 ∧ (twentyoneWord i (twentyonePoint i) ≠ twentyonePoint i ∧ (twentyoneWord i ^ twentyonePrime i) (twentyonePoint i) = twentyonePoint i)) := by
  decide +kernel

/-- The order-7168 case leaves only the identity double coset. -/
