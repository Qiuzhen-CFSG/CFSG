    ∃ (w : List (Fin 5)) (p : ℕ) (x : Fin 24),
      (p = 3 ∨ p = 5 ∨ p = 11 ∨ p = 23) ∧
      localWord i w x ≠ x ∧ (localWord i w ^ p) x = x := by
  rcases seven_checks i with h | h
  · exact Or.inl h
  · exact Or.inr ⟨sevenWords i, sevenPrime i, sevenPoint i, seven_prime_cases i, h⟩

/-- For order 15360, the remaining obstruction is a fixed-point-free cubic. -/
