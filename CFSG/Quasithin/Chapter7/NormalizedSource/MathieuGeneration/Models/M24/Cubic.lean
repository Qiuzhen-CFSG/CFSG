module
public import Theory.Representation.Mathieu.M24DegreeSpectrum.ElevenTrace.MixedCoverage
public import Mathlib.GroupTheory.Perm.Cycle.Type

/-!
# Cubic fixed-point types in M₂₄ Cartan overgroups

In a subgroup whose order has only one factor of three, Sylow conjugacy
places every cubic in the cyclic group generated by any chosen cubic.
Native mixed-order fusion shows that an element of order fifteen forces
cubics with fixed points, whereas order twenty-one forces fixed-point-free
cubics. These are exactly the two exclusions used by the Cartan word proof.

Source: Aschbacher--Smith, Definition E.3.37 and Table 7.3.4,
printed pp.239 and 699. The native fusion inputs are independently proved.
-/

public section
open Subgroup Sporadic.Mathieu
namespace CFSG.Quasithin.Chapter7.NormalizedSource.MathieuGeneration.Models.M24Cartan

private theorem fixed_card_of_isConj {g h : Equiv.Perm (Fin 24)} (hc : IsConj g h) :
    g.supportᶜ.card = h.supportᶜ.card := by
  have he := Equiv.Perm.isConj_iff_cycleType_eq.mp hc
  rw [Finset.card_compl, Finset.card_compl, ← Equiv.Perm.sum_cycleType,
    ← Equiv.Perm.sum_cycleType, he]

private theorem order15_fixed_nonempty (g : M24) (hg : orderOf g = 15) :
    g.val.supportᶜ.Nonempty := by
  obtain ⟨i, n, hc⟩ := M24OddCyclic.mixedOrderCyclicCoverage g (Or.inl hg)
  have he : orderOf g = orderOf
      (M24OddCyclic.representative (i.castLE (by decide)) ^ n) := by
    obtain ⟨a, ha⟩ := isConj_iff.mp hc
    exact ((MulAut.conj a).orderOf_eq g).symm.trans (congrArg orderOf ha)
  have hd : 15 ∣ orderOf (M24OddCyclic.representative (i.castLE (by decide))) := by
    rw [← hg, he]
    exact orderOf_pow_dvd _
  have hi : i = 0 := by
    fin_cases i
    · rfl
    · rw [M24OddCyclic.representative_order] at hd
      change 15 ∣ 21 at hd
      norm_num at hd
  subst i
  apply Finset.card_pos.mp
  have hf := fixed_card_of_isConj (M24.subtype.map_isConj hc)
  change g.val.supportᶜ.card = _ at hf
  rw [hf]
  apply Finset.card_pos.mpr
  refine ⟨23, ?_⟩
  rw [Finset.mem_compl, Equiv.Perm.mem_support]
  push Not
  change ((M24OddCyclic.representativePerm 0) ^ n) 23 = 23
  have hf : M24OddCyclic.representativePerm 0 23 = 23 := by decide +kernel
  exact Function.IsFixedPt.perm_pow hf n

/-- With only one factor of three, an order-fifteen element forces every cubic
into the native class with fixed points. -/
theorem cubic_fixed_nonempty (H : Subgroup M24) (h9 : ¬ 9 ∣ Nat.card H)
    (g : H) (hg : orderOf g = 15) (x : H) (hx : orderOf x = 3) :
    x.val.val.supportᶜ.Nonempty := by
  let y : H := g ^ 5
  have hy : orderOf y = 3 := by
    change orderOf (g ^ 5) = 3
    rw [orderOf_pow_of_dvd (by decide : 5 ≠ 0) (hg ▸ by decide), hg]
  let : Fact (Nat.Prime 3) := ⟨by decide⟩
  obtain ⟨n, hn⟩ := IsConj.of_order_eq_prime_power_generator hy hx h9
  apply Finset.card_pos.mp
  have hf := fixed_card_of_isConj (M24.subtype.map_isConj (H.subtype.map_isConj hn))
  change x.val.val.supportᶜ.card = _ at hf
  rw [hf]
  apply Finset.card_pos.mpr
  obtain ⟨a, ha⟩ := order15_fixed_nonempty g.val ((Subgroup.orderOf_coe g).trans hg)
  refine ⟨a, ?_⟩
  rw [Finset.mem_compl, Equiv.Perm.mem_support] at ha ⊢
  push Not at ha ⊢
  change (((g.val.val ^ 5) ^ n) a) = a
  exact Function.IsFixedPt.perm_pow (Function.IsFixedPt.perm_pow ha 5) n

private theorem support_pow_same_order {g : Equiv.Perm (Fin 24)} {n : ℕ}
    (hg : orderOf g = 21) (hn : orderOf (g ^ n) = 21) :
    ((g ^ n) ^ 7).support = (g ^ 7).support := by
  have hd : Nat.gcd 21 n ∣ 21 := Nat.gcd_dvd_left _ _
  have hp : 0 < Nat.gcd 21 n := Nat.gcd_pos_of_pos_left _ (by decide)
  rw [orderOf_pow, hg] at hn
  have he := (Nat.div_eq_iff_eq_mul_left hp hd).mp hn
  have hcop : Nat.Coprime n 21 := Nat.coprime_iff_gcd_eq_one.mpr (by
    rw [Nat.gcd_comm]
    omega)
  rw [← pow_mul, Nat.mul_comm, pow_mul]
  exact Equiv.Perm.support_pow_coprime (hcop.of_dvd_right (hg ▸ orderOf_pow_dvd 7))

private theorem order21_fusion (g : M24) (hg : orderOf g = 21) :
    ∃ n : ℕ, IsConj g (M24OddCyclic.representative 1 ^ n) := by
  obtain ⟨i, n, hc⟩ := M24OddCyclic.mixedOrderCyclicCoverage g (Or.inr hg)
  have he : orderOf g = orderOf
      (M24OddCyclic.representative (i.castLE (by decide)) ^ n) := by
    obtain ⟨a, ha⟩ := isConj_iff.mp hc
    exact ((MulAut.conj a).orderOf_eq g).symm.trans (congrArg orderOf ha)
  have hd : 21 ∣ orderOf (M24OddCyclic.representative (i.castLE (by decide))) := by
    rw [← hg, he]
    exact orderOf_pow_dvd _
  have hi : i = 1 := by
    fin_cases i
    · rw [M24OddCyclic.representative_order] at hd
      change 21 ∣ 15 at hd
      norm_num at hd
    · rfl
  subst i
  exact ⟨n, hc⟩

private theorem fixed_cube_conjugacy {g h : Equiv.Perm (Fin 24)} {n : ℕ}
    (hg : orderOf g = 21) (hh : orderOf h = 21)
    (hc : IsConj g (h ^ n)) (hf : (h ^ 7).supportᶜ.card = 0) :
    (g ^ 7).supportᶜ.card = 0 := by
  have hn : orderOf (h ^ n) = 21 := by
    obtain ⟨a, ha⟩ := isConj_iff.mp hc
    exact (congrArg orderOf ha).symm.trans (((MulAut.conj a).orderOf_eq g).trans hg)
  rw [fixed_card_of_isConj (hc.pow 7), support_pow_same_order hh hn, hf]

private theorem representative_one_order : orderOf (M24OddCyclic.representativePerm 1) = 21 :=
  (Subgroup.orderOf_coe (M24OddCyclic.representative 1)).trans
    (M24OddCyclic.representative_order 1)

private theorem representative_one_cubic_fixed :
    (M24OddCyclic.representativePerm 1 ^ 7).supportᶜ.card = 0 := by decide +kernel

private theorem order21_cubic_fixed_card (g : M24) (hg : orderOf g = 21) :
    (g ^ 7).val.supportᶜ.card = 0 := by
  obtain ⟨n, hn⟩ := order21_fusion g hg
  have hc : IsConj g.val (M24OddCyclic.representativePerm 1 ^ n) :=
    M24.subtype.map_isConj hn
  exact fixed_cube_conjugacy ((Subgroup.orderOf_coe g).trans hg)
    representative_one_order hc representative_one_cubic_fixed

/-- With only one factor of three, an order-twenty-one element forces every
cubic into the native fixed-point-free class. -/
theorem cubic_fixed_card_zero (H : Subgroup M24) (h9 : ¬ 9 ∣ Nat.card H)
    (g : H) (hg : orderOf g = 21) (x : H) (hx : orderOf x = 3) :
    x.val.val.supportᶜ.card = 0 := by
  let y : H := g ^ 7
  have hy : orderOf y = 3 := by
    change orderOf (g ^ 7) = 3
    rw [orderOf_pow_of_dvd (by decide : 7 ≠ 0) (hg ▸ by decide), hg]
  let : Fact (Nat.Prime 3) := ⟨by decide⟩
  obtain ⟨n, hn⟩ := IsConj.of_order_eq_prime_power_generator hy hx h9
  have hyn : orderOf (y ^ n) = 3 := by
    obtain ⟨a, ha⟩ := isConj_iff.mp hn
    exact (congrArg orderOf ha).symm.trans (((MulAut.conj a).orderOf_eq x).trans hx)
  have hcop : Nat.Coprime n (orderOf y.val.val) := by
    rw [Subgroup.orderOf_coe, Subgroup.orderOf_coe, hy]
    rw [orderOf_pow, hy] at hyn
    have hgcd : Nat.gcd 3 n = 1 := by
      rcases (Nat.dvd_prime (by decide : Nat.Prime 3)).mp (Nat.gcd_dvd_left 3 n) with h | h
      · exact h
      · rw [h] at hyn
        norm_num at hyn
    exact (Nat.coprime_iff_gcd_eq_one.mpr hgcd).symm
  have hf := fixed_card_of_isConj (M24.subtype.map_isConj (H.subtype.map_isConj hn))
  change x.val.val.supportᶜ.card = _ at hf
  rw [hf]
  change (y.val.val ^ n).supportᶜ.card = 0
  rw [Equiv.Perm.support_pow_coprime hcop]
  exact order21_cubic_fixed_card g.val ((Subgroup.orderOf_coe g).trans hg)

end CFSG.Quasithin.Chapter7.NormalizedSource.MathieuGeneration.Models.M24Cartan
