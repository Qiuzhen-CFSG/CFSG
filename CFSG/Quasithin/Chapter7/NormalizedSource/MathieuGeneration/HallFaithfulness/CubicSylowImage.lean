/-!
# The original Sylow image in the exceptional cubic comparison

Use innerness of the native J₄ automorphisms to mark the actual action of
C_G(z) on the simple section of the containing component. On that component
the resulting map is exactly its existing projection followed by the chosen
model isomorphism. It is therefore surjective, and the original Sylow T maps
to a full native Sylow S. The original cubic actor maps to the cyclic group
generated by the marked central cubic of the full fixed seed.

The source permutation relation AT = TA survives these literal maps. Its
native product has Sylow index three. The three-coset action gives index at
most two for its two-core inside S; the native Sylow center has order two.
The Hall application retains all prior witnesses and uses the same model
marking as the constructed replacement.

This supplies the original Sylow and actor product for the remaining
normalization comparison. It does not yet identify the replacement's selected
involution with a point fixed by S. That comparison, the remaining M₁₂/M₂₂
pushing-up cases, the M₂₄ fixed line, seed generation and the separate
odd-normalizer branch remain necessary for SourceMathieuHallFaithfulAt.

Source: Aschbacher--Smith, combined manuscript (1 March 2004), 4.4.3,
printed p.623, applied in 4.4.14, pp.624--625. The native J₄ Sylow calculations
retain the source attribution and licenses of their imported certificates.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
open scoped Pointwise IsMulCommutative
namespace CFSG.Quasithin.Chapter7.NormalizedSource.MathieuGeneration
open Chapter4.Section04.OddLocalMathieu
attribute [local irreducible] Janko4.modelGroup Janko4.matrixA Janko4.matrixB

/-- The native inner marking of the actual containing component action. -/
def cubicNativeAction {C : Type*} [Group C] (Q : Subgroup C) [Q.Normal]
    (e : SimpleSection Q ≃* Janko4.Model) : C →* Janko4.Model :=
  (MulEquiv.ofBijective MulAut.conj
    ⟨MulAut.conj_injective_of_center_eq_bot Janko4.model_center_eq_bot,
      Janko4.AdequateLocal.conj_surjective⟩).symm.toMonoidHom.comp
    ((MulAut.congr e).toMonoidHom.comp (simpleAction Q))

/-- The native action realizes the original quotient automorphism by conjugation. -/
theorem cubicNativeAction_conj {C : Type*} [Group C] (Q : Subgroup C) [Q.Normal]
    (e : SimpleSection Q ≃* Janko4.Model) (c : C) :
    MulAut.conj (cubicNativeAction Q e c) = MulAut.congr e (simpleAction Q c) :=
  (MulEquiv.ofBijective MulAut.conj
    ⟨MulAut.conj_injective_of_center_eq_bot Janko4.model_center_eq_bot,
      Janko4.AdequateLocal.conj_surjective⟩).apply_symm_apply _

/-- Restriction to the full containing component is its literal simple-section projection. -/
theorem cubicNativeAction_component {C : Type*} [Group C] (Q : Subgroup C) [Q.Normal]
    (e : SimpleSection Q ≃* Janko4.Model) :
    (cubicNativeAction Q e).comp Q.subtype = e.toMonoidHom.comp (projection Q) := by
  ext u
  apply MulAut.conj_injective_of_center_eq_bot Janko4.model_center_eq_bot
  rw [MonoidHom.comp_apply,cubicNativeAction_conj]
  change MulAut.congr e (simpleAction Q (u : C)) = MulAut.conj (e (projection Q u))
  rw [←MulAut.congr_conj]
  congr 1
  ext v
  obtain ⟨w,rfl⟩ := projection_surjective Q v
  rw [simpleAction_projection]
  change projection Q (u*w*u⁻¹) = projection Q u * projection Q w * (projection Q u)⁻¹
  simp only [map_mul,map_inv]

/-- Surjectivity follows from the original component projection. -/
theorem cubicNativeAction_surjective {C : Type*} [Group C] (Q : Subgroup C) [Q.Normal]
    (e : SimpleSection Q ≃* Janko4.Model) : Function.Surjective (cubicNativeAction Q e) := by
  have hh : Function.Surjective ((cubicNativeAction Q e).comp Q.subtype) := by
    rw [cubicNativeAction_component]
    exact e.surjective.comp (projection_surjective Q)
  exact Function.Surjective.of_comp hh

private theorem permutes_subgroupOf {G : Type*} [Group G] (C A B : Subgroup G)
    (hA : A ≤ C) (hB : B ≤ C)
    (hp : (A : Set G)*(B : Set G) = (B : Set G)*(A : Set G)) :
    (A.subgroupOf C : Set C)*(B.subgroupOf C : Set C) =
      (B.subgroupOf C : Set C)*(A.subgroupOf C : Set C) := by
  apply Set.image_injective.mpr C.subtype_injective
  simp only [Set.image_mul,←coe_map,map_subgroupOf_eq_of_le hA,map_subgroupOf_eq_of_le hB]
  exact hp

private theorem permutes_map {C S : Type*} [Group C] [Group S] (q : C →* S)
    (A B : Subgroup C)
    (hp : (A : Set C)*(B : Set C) = (B : Set C)*(A : Set C)) :
    (A.map q : Set S)*(B.map q : Set S) = (B.map q : Set S)*(A.map q : Set S) := by
  simpa only [Set.image_mul,←coe_map] using congrArg (Set.image q) hp

private theorem cubic_product_core_index {S : Type*} [Group S] [Finite S]
    (P : Sylow 2 S) (A : Subgroup S) (hA : Nat.card A = 3)
    (hp : (A : Set S)*(P : Set S) = (P : Set S)*(A : Set S)) :
    (P : Subgroup S).relIndex (A ⊔ (P : Subgroup S)) = 3 ∧
      ((A ⊔ (P : Subgroup S)).pCoreIn 2).relIndex (P : Subgroup S) ≤ 2 := by
  let M := A ⊔ (P : Subgroup S)
  have hd : Disjoint A (P : Subgroup S) := by
    apply disjoint_of_coprime_natCard
    obtain ⟨n,hn⟩ := P.isPGroup'.exists_card_eq
    rw [hA,hn]
    exact (by decide : Nat.Coprime 3 2).pow_right n
  have hm : Nat.card M = 3 * Nat.card P := by
    rw [show M = A ⊔ (P : Subgroup S) from rfl,
      card_sup_eq_mul_of_permutes_of_disjoint _ _ hp hd,hA]
  let R := P.subtype (show (P : Subgroup S) ≤ M from le_sup_right)
  have hRcard : Nat.card R = Nat.card P :=
    Nat.card_congr (subgroupOfEquivOfLe (show (P : Subgroup S) ≤ M from le_sup_right)).toEquiv
  have hi : (R : Subgroup M).index = 3 := by
    have hh := (R : Subgroup M).index_mul_card
    rw [hRcard,hm] at hh
    exact Nat.eq_of_mul_eq_mul_right Nat.card_pos hh
  refine ⟨hi,?_⟩
  have hk : pCore 2 M ≤ (R : Subgroup M) := pCore_isPGroup.le_sylow_of_normal R
  have hb : (pCore 2 M).relIndex (R : Subgroup M) ≤ 2 := by
    by_cases he : pCore 2 M = (R : Subgroup M)
    · rw [he,relIndex_self]; decide
    obtain ⟨e⟩ := sylow_index_three_core_quotient R hi (lt_of_le_of_ne hk he)
    have hq : (pCore 2 M).index = 6 := by
      change Nat.card (M ⧸ pCore 2 M) = 6
      rw [Nat.card_congr e.toEquiv, Nat.card_eq_fintype_card, Fintype.card_perm]
      decide
    have hh := relIndex_mul_index hk
    rw [hi,hq] at hh
    omega
  rw [←relIndex_subgroupOf (L := M) (show (P : Subgroup S) ≤ M from le_sup_right)]
  change (((pCore 2 M).map M.subtype).comap M.subtype).relIndex (R : Subgroup M) ≤ 2
  rw [comap_map_eq_self_of_injective M.subtype_injective]
  exact hb

/-- The original Sylow maps onto a full native Sylow, and the literal cubic
actor gives an index-three product with core of Sylow index at most two. -/
theorem cubic_original_sylow_image
    {G : Type*} [Group G] [Finite G] (T : Sylow 2 G)
    (C A : Subgroup G) (hT : (T : Subgroup G) ≤ C) (hA : A ≤ C)
    (Q : Subgroup C) [Q.Normal] (e : SimpleSection Q ≃* Janko4.Model)
    (y : SimpleSection Q) (hy : orderOf y = 3)
    (hb : ((simpleAction Q).comp (inclusion hA)).range =
      (zpowers y).map MulAut.conj)
    (hp : (A : Set G)*(T : Set G) = (T : Set G)*(A : Set G)) :
    ∃ S : Sylow 2 Janko4.Model,
      (S : Subgroup Janko4.Model) = ((T : Subgroup G).subgroupOf C).map (cubicNativeAction Q e) ∧
      (A.subgroupOf C).map (cubicNativeAction Q e) = zpowers (e y) ∧
      (zpowers (e y) : Set Janko4.Model)*(S : Set Janko4.Model) =
        (S : Set Janko4.Model)*(zpowers (e y) : Set Janko4.Model) ∧
      (S : Subgroup Janko4.Model).relIndex (zpowers (e y) ⊔ (S : Subgroup Janko4.Model)) = 3 ∧
      ((zpowers (e y) ⊔ (S : Subgroup Janko4.Model)).pCoreIn 2).relIndex
        (S : Subgroup Janko4.Model) ≤ 2 ∧
      Nat.card (center S) = 2 := by
  let q := cubicNativeAction Q e
  let S := (T.subtype hT).mapSurjective (cubicNativeAction_surjective Q e)
  have hb' : ((simpleAction Q).comp (A.subgroupOf C).subtype).range =
      ((simpleAction Q).comp (inclusion hA)).range := by
    ext u
    constructor
    · rintro ⟨b,rfl⟩
      exact ⟨⟨b,b.property⟩,rfl⟩
    · rintro ⟨b,rfl⟩
      exact ⟨⟨⟨b,hA b.property⟩,b.property⟩,rfl⟩
  have hqa : (A.subgroupOf C).map q = zpowers (e y) := by
    apply (map_injective (f := MulAut.conj)
      (MulAut.conj_injective_of_center_eq_bot Janko4.model_center_eq_bot))
    have hcomp : MulAut.conj.comp q = (MulAut.congr e).toMonoidHom.comp (simpleAction Q) := by
      apply MonoidHom.ext
      intro c
      exact cubicNativeAction_conj Q e c
    have hr : (A.subgroupOf C).map (simpleAction Q) =
        ((simpleAction Q).comp (A.subgroupOf C).subtype).range := by
      rw [MonoidHom.range_comp,range_subtype]
    rw [map_map,hcomp,←map_map,hr,hb',hb,map_map]
    simp only [MonoidHom.map_zpowers,MonoidHom.comp_apply,
      MulEquiv.coe_toMonoidHom,MulAut.congr_conj]
  have hperm := permutes_map q (A.subgroupOf C) ((T : Subgroup G).subgroupOf C)
    (permutes_subgroupOf C A T hA hT hp)
  change ((A.subgroupOf C).map q : Set Janko4.Model)*(S : Set Janko4.Model) =
    (S : Set Janko4.Model)*((A.subgroupOf C).map q : Set Janko4.Model) at hperm
  rw [hqa] at hperm
  have hcard : Nat.card (zpowers (e y)) = 3 := by rw [Nat.card_zpowers,e.orderOf_eq,hy]
  have hind := cubic_product_core_index S (zpowers (e y)) hcard hperm
  exact ⟨S,rfl,hqa,hperm,hind.1,hind.2,Janko4.sylow_center_card_two S⟩
end CFSG.Quasithin.Chapter7.NormalizedSource.MathieuGeneration

namespace CFSG.Quasithin.Chapter7.NormalizedSource.MathieuGeneration
open Chapter4.Section04.OddLocalMathieu
/-- The full original Sylow image and the literal actor product under the
same native marking of the containing component. -/
@[expose] def CubicSylowImageAt {G : Type*} [Group G]
    (T C A : Subgroup G) (Q : Subgroup C) [Q.Normal]
    (e : SimpleSection Q ≃* Janko4.Model) : Prop :=
  ∃ S : Sylow 2 Janko4.Model,
    (S : Subgroup Janko4.Model) = (T.subgroupOf C).map (cubicNativeAction Q e) ∧
    let B := (A.subgroupOf C).map (cubicNativeAction Q e)
    Nat.card B = 3 ∧
    (B : Set Janko4.Model)*(S : Set Janko4.Model) =
      (S : Set Janko4.Model)*(B : Set Janko4.Model) ∧
    (S : Subgroup Janko4.Model).relIndex (B ⊔ (S : Subgroup Janko4.Model)) = 3 ∧
    ((B ⊔ (S : Subgroup Janko4.Model)).pCoreIn 2).relIndex (S : Subgroup Janko4.Model) ≤ 2 ∧
    Nat.card (center S) = 2
end CFSG.Quasithin.Chapter7.NormalizedSource.MathieuGeneration

namespace CFSG.Quasithin.Chapter7.NormalizedSource.MathieuGeneration
open Chapter4 Chapter4.Section04 Sporadic.Mathieu
/-- The full original cubic witnesses, including the native image of the original
Sylow under the same containing-component marking used by the replacement. -/
@[expose] def MathieuJankoCubicSylowCase {G : Type*} [Group G]
    (T L V A : Subgroup G) : Prop :=
  ∃ K : Subgroup (normalizer (A : Set G)),
    IsComponent (normalizer (A : Set G)) K ∧ K.Normal ∧
    ¬ K.map (normalizer (A : Set G)).subtype ≤ normalizer (L : Set G) ∧
    V ≤ K.map (normalizer (A : Set G)).subtype ∧
    oddActorResidual L A ≤ K.map (normalizer (A : Set G)).subtype ∧
    ∃ a : JankoNormalizerAction K,
      a.ResidualSeedFamily ∧ center K = ⊥ ∧
      ∃ z : K, ((z : normalizer (A : Set G)) : G) ∈ V ∧ orderOf z = 2 ∧
        Nonempty ((centralizer ({z} : Set K) ⧸
          pPrimeCore 2 (centralizer ({z} : Set K))) ≃*
            Janko4.InvolutionCentralizers.First.centralizer) ∧
        T ≤ centralizer ({((z : normalizer (A : Set G)) : G)} : Set G) ∧
        ∃ P : Subgroup (centralizer ({((z : normalizer (A : Set G)) : G)} : Set G) ⊓
            centralizer (A : Set G) : Subgroup G),
          P.IsCComponent ∧ P.Normal ∧ Nonempty ((P ⧸ solvableRadical P) ≃* M22) ∧
          P.map (centralizer ({((z : normalizer (A : Set G)) : G)} : Set G) ⊓
            centralizer (A : Set G)).subtype =
              ((solvableResidual (centralizer ({z} : Set K))).map
                (centralizer ({z} : Set K)).subtype).map
                  ((normalizer (A : Set G)).subtype.comp K.subtype) ∧
          ∃ Q : Subgroup (centralizer ({((z : normalizer (A : Set G)) : G)} : Set G)),
            Q.IsCComponent ∧ ∃ hPQ : P.map (inclusion inf_le_left) ≤ Q,
              ∃ hn : Q.Normal, letI := hn
              IsQuasisimple (Q ⧸ pCore 2 Q) ∧
              Nonempty (OddLocalMathieu.SimpleSection Q ≃* Janko4.Model) ∧
              ∃ hAz : A ≤ centralizer ({((z : normalizer (A : Set G)) : G)} : Set G),
                ∃ x : A, orderOf (OddLocalMathieu.simpleAction Q ⟨x,hAz x.property⟩) = 3 ∧
                  Nat.card ((OddLocalMathieu.simpleAction Q).comp (inclusion hAz)).range = 3 ∧
                  (let f := (OddLocalMathieu.projection Q).comp
                      (OddLocalMathieu.seedInclusion inf_le_left hPQ)
                   let b := (OddLocalMathieu.simpleAction Q).comp (inclusion hAz)
                   f.range = (solvableResidual (b x).fixedSubgroup).map
                     (b x).fixedSubgroup.subtype ∧
                   ∃ y : center f.range, orderOf y = 3 ∧
                     MulAut.conj ((y : f.range) : OddLocalMathieu.SimpleSection Q) = b x ∧
                     b.range = (zpowers ((y : f.range) : OddLocalMathieu.SimpleSection Q)).map
                       MulAut.conj) ∧
                  ((pCore 2 P).map (OddLocalMathieu.seedInclusion inf_le_left hPQ) ≤
                      pCore 2 Q) ∧
                  ∃ I : Subgroup G,
                    ∃ hPI : P.map (centralizer ({((z : normalizer (A : Set G)) : G)} : Set G) ⊓
                      centralizer (A : Set G)).subtype ≤ I,
                    ((I : Set G) =
                      (((solvableResidual (centralizer ({z} : Set K))).map
                        (centralizer ({z} : Set K)).subtype).map
                          ((normalizer (A : Set G)).subtype.comp K.subtype) : Set G) *
                        (I.pCoreIn 2 : Set G)) ∧
                    (∃ e : (P ⧸ pCore 2 P) ≃* (I ⧸ pCore 2 I),
                      ∀ p : P, e (QuotientGroup.mk' (pCore 2 P) p) =
                        QuotientGroup.mk' (pCore 2 I)
                          ⟨(p.val : G),hPI (mem_map_of_mem _ p.property)⟩) ∧
                    I ≤ Q.map (centralizer ({((z : normalizer (A : Set G)) : G)} : Set G)).subtype ∧
                    A ≤ sectionCentralizer I ∧ Group.IsPerfect I ∧
                    IsQuasisimple (I ⧸ pCore 2 I) ∧
                    Nonempty ((I ⧸ solvableRadical I) ≃* M22) ∧
                    ∃ R : Subgroup (centralizer ({((z : normalizer (A : Set G)) : G)} : Set G)),
                      I = R.map (centralizer ({((z : normalizer (A : Set G)) : G)} : Set G)).subtype ∧
                      R ≤ Q ∧ ∃ (e : OddLocalMathieu.SimpleSection Q ≃* Janko4.Model)
                        (t : Janko4.Model),
                        CubicSylowImageAt T
                          (centralizer ({((z : normalizer (A : Set G)) : G)} : Set G))
                          A Q e ∧ orderOf t = 2 ∧
                        (∀ c : centralizer ({((z : normalizer (A : Set G)) : G)} : Set G),
                          MulAut.congr e (OddLocalMathieu.simpleAction Q c) t = t →
                            (c : G) ∈ normalizer (I : Set G)) ∧
                        (R.subgroupOf Q).map (e.toMonoidHom.comp (OddLocalMathieu.projection Q)) =
                          (solvableResidual (centralizer ({t} : Set Janko4.Model))).map
                            (centralizer ({t} : Set Janko4.Model)).subtype

end CFSG.Quasithin.Chapter7.NormalizedSource.MathieuGeneration

namespace CFSG.Quasithin.Chapter12.Section02.ChosenModule
open Chapter7.NormalizedSource Chapter7.NormalizedSource.MathieuGeneration
open Chapter4 Chapter4.Section04 OddLocalMathieu
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L V A : Subgroup G}

/-- Map the original T and its permuting actor through the containing
component's actual action, retaining both components and the full seed. -/
theorem mathieu_janko_cubic_sylow
    (hc : MathieuJankoCubicFirstRowCase (T : Subgroup G) L V A)
    (hp : (A : Set G)*(T : Set G) = (T : Set G)*(A : Set G)) :
    MathieuJankoCubicSylowCase (T : Subgroup G) L V A := by
  obtain ⟨K,hK,hn,hout,hV,hF,a,hseed,hZ,z,hzV,hz,hfirst,hTz,
    P,hP,hPn,eP,hPm,Q,hQ,hPQ,hnQ,hqs,hmodel,hAz,x,hx,hcard,hdata,hcore,
    I,hPI,hfull,heI,hIQ,hAI,hperf,hqI,eI,R,hIR,hRQ,e,t,ht,hnorm,himage⟩ := hc
  let := hnQ
  let C := centralizer ({((z : normalizer (A : Set G)) : G)} : Set G)
  let f := (projection Q).comp (seedInclusion inf_le_left hPQ)
  obtain ⟨hU,y,hy,he,hb⟩ := hdata
  have hy' : orderOf ((y : f.range) : SimpleSection Q) = 3 :=
    (orderOf_coe y.val).trans ((orderOf_coe y).trans hy)
  obtain ⟨S,hS,hAmap,hperm,hindex,hcindex,hcenter⟩ :=
    cubic_original_sylow_image T C A hTz hAz Q e y.val.val hy' hb hp
  have hSylow : CubicSylowImageAt (T : Subgroup G) C A Q e := by
    refine ⟨S,hS,?_,?_,?_,?_,hcenter⟩
    · rw [hAmap,Nat.card_zpowers,e.orderOf_eq,hy']
    · rwa [hAmap]
    · rwa [hAmap]
    · rwa [hAmap]
  exact ⟨K,hK,hn,hout,hV,hF,a,hseed,hZ,z,hzV,hz,hfirst,hTz,
    P,hP,hPn,eP,hPm,Q,hQ,hPQ,hnQ,hqs,hmodel,hAz,x,hx,hcard,
    ⟨hU,y,hy,he,hb⟩,hcore,I,hPI,hfull,heI,hIQ,hAI,hperf,hqI,eI,
    R,hIR,hRQ,e,t,hSylow,ht,hnorm,himage⟩
end CFSG.Quasithin.Chapter12.Section02.ChosenModule

namespace CFSG.Quasithin.Chapter12.Section02.ChosenModule
open Chapter7.NormalizedSource Chapter7.NormalizedSource.MathieuGeneration
open Chapter4 Chapter4.Section04
open ChapterE ChapterE.Section06.FixedPointBounds.ParabolicCartan
open Representation.BinaryOffender
universe u
variable {G : Type u} [instG : Group G] [finG : Finite G] {T : Sylow 2 G} {L V : Subgroup G}
  (D : ChosenModule T L V)

/-- The literal Hall obstruction supplies the full original Sylow image,
its cubic product and its core index, with the original replacement marking. -/
theorem sourceOrbit_mathieu_hall_cubic_sylow
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hV : V = D.sourceOrbit)
    (hm : HasMathieuCentralQuotient D.orbitComponent)
    (hnon : ¬ IsFFModule D.sourceOrbitNormalizerRepresentation)
    {H : Subgroup G} (hH : H ∈ Chapter3.HStar (T : Subgroup G)
      (normalizer (L : Set G))) (hlarge : 1 < ChapterE.generationParameter H)
    (B : Subgroup H) (hBN : B ≤ (normalizer (L : Set G)).subgroupOf H)
    (hHall : IsHallSubgroup oddPrimes
      (B.subgroupOf ((normalizer (L : Set G)).subgroupOf H)))
    (hker : B.map H.subtype ⊓ sectionCentralizer L ≠ ⊥) :
    ∃ (p : ℕ) (A : Subgroup G), p.Prime ∧ Odd p ∧ A ≠ ⊥ ∧
      IsElementaryAbelian p A ∧ A ≤ H ∧ A ≤ sectionCentralizer L ∧
      A ≤ centralizer (V : Set G) ∧
      (A : Set G) * (T : Set G) = (T : Set G) * (A : Set G) ∧
      ¬ normalizer (A : Set G) ≤ normalizer (L : Set G) ∧
      (let X := conjugateSpanBy A (T : Subgroup G)
       IsPPerfect 2 X ∧ X.pCoreIn 2 ≠ ⊥ ∧
         L ⊔ (T : Subgroup G) ≤ normalizer (X : Set G) ∧
         normalizer (X : Set G) ≤ normalizer (L : Set G)) ∧
      (∀ Q : Subgroup G, (T : Subgroup G) ≤ normalizer (Q : Set G) →
        A ≤ sectionCentralizer Q → Q ≤ normalizer (L : Set G)) ∧
      (((Nonempty ((D.orbitComponent ⧸ center D.orbitComponent) ≃* Sporadic.Mathieu.M12) ∨
          Nonempty ((D.orbitComponent ⧸ center D.orbitComponent) ≃* Sporadic.Mathieu.M22)) ∧
          MathieuPushingUpFactoredCase T L V A ∧ MathieuPushingUpFactorGap T L V A) ∨
        (UniqueMaximalOvergroup (oddActorResidual L A) (normalizer (L : Set G)) ∧
          MathieuJankoSeedResidualCase (T : Subgroup G) L V A
            (D.orbitComponent ⧸ center D.orbitComponent) ∧
          (MathieuJankoComparedResidualCase (T : Subgroup G) L V A ∨
            (p = 3 ∧ MathieuJankoCubicSylowCase (T : Subgroup G) L V A)))) := by
  have hsource :=
    @sourceOrbit_mathieu_hall_cubic_first_row G instG finG T L V D
      h hmany hV hm hnon H hH hlarge B hBN hHall hker
  refine hsource.imp fun p hpA => hpA.imp fun A hA => ?_
  obtain ⟨hp,ho,hne,he,hAH,hAL,hAV,hAT,hN,hX,hcontrol,hcases⟩ := hA
  refine ⟨hp,ho,hne,he,hAH,hAL,hAV,hAT,hN,hX,hcontrol,?_⟩
  apply Or.imp id _ hcases
  intro hc
  exact ⟨hc.1,hc.2.1,hc.2.2.imp id (fun ht =>
    ⟨ht.1,mathieu_janko_cubic_sylow ht.2 hAT⟩)⟩
end CFSG.Quasithin.Chapter12.Section02.ChosenModule
