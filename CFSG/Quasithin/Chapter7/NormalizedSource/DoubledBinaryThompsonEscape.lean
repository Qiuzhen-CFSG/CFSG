private theorem lift_component {D : Type*} [Group D] (N : Subgroup D)
    (hN : N.IsSubnormal) {L : Subgroup N} (hL : IsComponent N L) :
    IsComponent D (L.map N.subtype) := by
  let := hL.2
  exact ⟨hL.1.trans' hN,
    IsQuasisimple.of_mulEquiv (L.equivMapOfInjective N.subtype N.subtype_injective)⟩

private theorem simple_perfect_quasisimple {D : Type*} [Group D]
    [IsSimpleGroup D] [Group.IsPerfect D] : IsQuasisimple D := by
  have hz : center D = ⊥ :=
    (IsSimpleGroup.eq_bot_or_eq_top_of_normal (center D) inferInstance).resolve_right
      (fun he => Group.IsPerfect.not_isMulCommutative D (center_eq_top_iff.mp he))
  exact { toIsPerfect := inferInstance
          simple := ((QuotientGroup.quotientMulEquivOfEq hz).trans
            QuotientGroup.quotientBot).isSimpleGroup }

private theorem alternating_five_component :
    IsComponent (Equiv.Perm (Fin 5)) (alternatingGroup (Fin 5)) := by
  let : IsSimpleGroup (alternatingGroup (Fin 5)) := alternatingGroup.isSimpleGroup (by simp)
  let : Group.IsPerfect (alternatingGroup (Fin 5)) :=
    ⟨commutator_alternatingGroup_eq_top (by simp)⟩
  exact ⟨(inferInstance : (alternatingGroup (Fin 5)).Normal).isSubnormal,
    simple_perfect_quasisimple⟩

/-- For each actual factor model, containing all ordinary components and
its symmetric-three cubic suffices to contain its embedded two-residual. -/
theorem model_residual_contained
    {D : Type*} [Group D] [Finite D] (A M : Subgroup D) [A.Normal]
    (hm : Nonempty (A ≃* Equiv.Perm (Fin 3)) ∨
      Nonempty (A ≃* Equiv.Perm (Fin 5)) ∨ (IsSimpleGroup A ∧ Group.IsPerfect A))
    (hK : ∀ K : Subgroup D, IsComponent D K → K ≤ M)
    (hS : Nonempty (A ≃* Equiv.Perm (Fin 3)) → (pResidual 2 A).map A.subtype ≤ M) :
    (pResidual 2 A).map A.subtype ≤ M := by
  rcases hm with he | he | ⟨hs,hp⟩
  · exact hS he
  · obtain ⟨e⟩ := he
    let C := (alternatingGroup (Fin 5)).map e.symm.toMonoidHom
    have hC : IsComponent A C := alternating_five_component.map_equiv e.symm
    have hc : pResidual 2 A ≤ C := by
      have hh : pResidual 2 (Equiv.Perm (Fin 5)) ≤ alternatingGroup (Fin 5) := by
        apply sInf_le
        refine ⟨inferInstance,IsPGroup.of_card (n := 1) ?_⟩
        change (alternatingGroup (Fin 5)).index = 2 ^ 1
        simp
      have hh' := map_mono (f := e.symm.toMonoidHom) hh
      rwa [map_pResidual] at hh'
    exact (map_mono hc).trans (hK _
      (lift_component A (inferInstance : A.Normal).isSubnormal hC))
  · let := hs
    let := hp
    exact (map_subtype_le _).trans (hK _
      ⟨(inferInstance : A.Normal).isSubnormal,simple_perfect_quasisimple⟩)


private theorem model_residual_le
    {D : Type*} [Group D] [Finite D] (A : Subgroup D) [A.Normal]
    (hm : Nonempty (A ≃* Equiv.Perm (Fin 3)) ∨
      Nonempty (A ≃* Equiv.Perm (Fin 5)) ∨ (IsSimpleGroup A ∧ Group.IsPerfect A)) :
    (pResidual 2 A).map A.subtype ≤ componentLayer D ⊔ pCore 3 D := by
  apply model_residual_contained A (componentLayer D ⊔ pCore 3 D) hm
  · intro K hK
    exact (show K ≤ componentLayer D from le_sSup hK).trans le_sup_left
  · intro he
    obtain ⟨e⟩ := he
    have hc : Nat.card (pResidual 2 A) = 3 := by
      rw [← card_map_of_injective (K := pResidual 2 A) (f := e.toMonoidHom) e.injective,map_pResidual]
      exact Theory.SpecificGroups.SymmetricThree.CubicSelection.residual_card
    have h3 : IsPGroup 3 (pResidual 2 A) := IsPGroup.of_card (n := 1) (by simpa using hc)
    have hn : ((pResidual 2 A).map A.subtype).Normal :=
      ConjAct.normal_of_characteristic_of_normal
    exact (show (pResidual 2 A).map A.subtype ≤ pCore 3 D from
      le_sSup ⟨hn,h3.map _⟩).trans le_sup_right

private theorem linear_two_models (F : BinaryField)
    {D : Type*} [Group D] (e : D ≃* SL(2,F.Carrier)) :
    Nonempty (D ≃* Equiv.Perm (Fin 3)) ∨
      Nonempty (D ≃* Equiv.Perm (Fin 5)) ∨ (IsSimpleGroup D ∧ Group.IsPerfect D) := by
  by_cases hd : F.degree = 1
  · exact Or.inl ⟨e.trans
      ((ExtensionConsequences.degreeOneNaturalEquiv F hd 2).groupEquiv.trans
        ((BinaryLinear.OuterCyclic.slEquivLinear 2).trans
          BinaryLinear.SmallParabolicLevi.linearTwoEquivSymmetricThree))⟩
  · have hl : 3 < Nat.card F.Carrier := by
      rw [F.card_eq]
      have hd' : 2 ≤ F.degree := by have := F.degree_pos; omega
      have hp := Nat.pow_le_pow_right (by decide : 0 < 2) hd'
      norm_num at hp
      omega
    let : IsSimpleGroup PSL(2,F.Carrier) := Matrix.ProjectiveSpecialLinearGroup.rank_two_simple (by omega)
    let : Group.IsPerfect SL(2,F.Carrier) := GorensteinWalter.sl2_isPerfect_of_card_gt_three F.Carrier hl
    exact Or.inr (Or.inr ⟨(e.trans (Atlas.RankOneFieldAutomorphisms.slEquivPSL)).isSimpleGroup,
      Group.IsPerfect.ofSurjective (f := e.symm.toMonoidHom) e.symm.surjective⟩)

private theorem binary_three_models {D : Type*} [Group D]
    (e : D ≃* SL(3,ZMod 2)) :
    Nonempty (D ≃* Equiv.Perm (Fin 3)) ∨
      Nonempty (D ≃* Equiv.Perm (Fin 5)) ∨ (IsSimpleGroup D ∧ Group.IsPerfect D) := by
  let : IsSimpleGroup PSL(3,ZMod 2) := Atlas.psl_simple_high_rank 3 (by decide)
  let : Group.IsPerfect SL(3,ZMod 2) := Atlas.sl_perfect 3 (by decide)
  exact Or.inr (Or.inr ⟨(e.trans
    (Matrix.PSL3.OddDegreeProjectiveComparison.specialProjectiveEquiv
      BinaryField.two.card_eq (by decide))).isSimpleGroup,
    Group.IsPerfect.ofSurjective (f := e.symm.toMonoidHom) e.symm.surjective⟩)

private theorem abelian_offender_image_two
    {D X Q : Type*} [Group D] [Group Q] [IsMulCommutative Q]
    [AddCommGroup X] [Module (ZMod 2) X]
    (ρ : Representation (ZMod 2) D X) (hg : offenderSubgroup ρ = ⊤)
    (q : D →* Q) (hq : Function.Surjective q) : IsPGroup 2 Q := by
  have he : (⨆ A, ⨆ (_ : IsBestOffender ρ A), A.map q) = ⊤ := by
    have hh := congrArg (Subgroup.map q) hg
    simpa only [offenderSubgroup,generatedBy,Subgroup.map_iSup,
      map_top_of_surjective q hq, le_top, and_true, Set.mem_ofPred_eq] using hh
  have hp : IsPGroup 2 (⨆ A, ⨆ (_ : IsBestOffender ρ A), A.map q : Subgroup Q) := by
    apply Sylow.biSup_of_normal
    · intro A hA
      let := hA.1.2
      exact (IsElementaryAbelian.isPGroup 2 A).map q
    · intros
      infer_instance
  exact (he ▸ hp).of_equiv Subgroup.topEquiv

private theorem outer_residual_le
    {D X : Type*} [Group D] [Finite D] [AddCommGroup X] [Module (ZMod 2) X]
    (ρ : Representation (ZMod 2) D X) (hg : offenderSubgroup ρ = ⊤)
    (c : ChapterB.OuterSixThreeShape D) :
    pResidual 2 D ≤ componentLayer D ⊔ pCore 3 D := by
  let N := componentLayer D ⊔ pCore 3 D
  let q := QuotientGroup.mk' N
  have hq := QuotientGroup.mk'_surjective N
  have hfirst : c.first ≤ N := (show c.first ≤ componentLayer D from le_sSup c.first_isComponent).trans le_sup_left
  let := c.second_normal
  have hp : IsPGroup 3 c.second := IsPGroup.of_card (n := 1) (by
    rw [Nat.card_congr c.secondEquiv.toEquiv]
    simp)
  have hsecond : c.second ≤ N :=
    (show c.second ≤ pCore 3 D from le_sSup ⟨inferInstance,hp⟩).trans le_sup_right
  have hfirstq : c.first.map q = ⊥ := (Subgroup.map_eq_bot_iff _).mpr (by
    simpa only [q,QuotientGroup.ker_mk'] using hfirst)
  have hsecondq : c.second.map q = ⊥ := (Subgroup.map_eq_bot_iff _).mpr (by
    simpa only [q,QuotientGroup.ker_mk'] using hsecond)
  have hgen : (zpowers c.element).map q = ⊤ := by
    have hh := congrArg (Subgroup.map q) c.generates
    simpa only [Subgroup.map_sup,hfirstq,hsecondq,bot_sup_eq,
      map_top_of_surjective q hq] using hh
  let : IsCyclic (D ⧸ N) :=
    isCyclic_of_surjective
      (q.comp (zpowers c.element).subtype)
      (MonoidHom.range_eq_top.mp (by simpa only [MonoidHom.range_comp,range_subtype] using hgen))
  exact sInf_le ⟨inferInstance,abelian_offender_image_two ρ hg q hq⟩

/-- The literal two-residual in every adequate source alternative lies in
the layer times the full three-core. In the outer alternative, offender
generation controls the cyclic quotient; no order is imposed on its generator. -/
theorem adequate_residual_le_layer_threeCore
    {D X : Type*} [Group D] [Finite D] [AddCommGroup X] [Module (ZMod 2) X]
    (ρ : Representation (ZMod 2) D X) (hg : offenderSubgroup ρ = ⊤)
    (h : NontrivialAdequateAlternative ρ) :
    pResidual 2 D ≤ componentLayer D ⊔ pCore 3 D := by
  cases h with
  | quasisimple hc c =>
    have hF : generalizedFitting D ≤ componentLayer D :=
      le_sSup ⟨(inferInstance : (generalizedFitting D).Normal).isSubnormal,hc⟩
    have hres : pResidual 2 D ≤ generalizedFitting D := by
      have hgen : ∀ S : Sylow 2 D, generalizedFitting D ⊔ (S : Subgroup D) = ⊤ := by
        cases c.clause_one with
        | irreducible _ _ _ _ he =>
          rcases he with he | he
          · intro S; rw [he,top_sup_eq]
          · exact he.1
        | doubleThree _ he _ _ _ => intro S; rw [he,top_sup_eq]
        | naturalDual _ _ he _ => intro S; rw [he,top_sup_eq]
        | repeatedNatural _ _ _ _ _ he _ => intro S; rw [he,top_sup_eq]
      let S : Sylow 2 D := Classical.choice inferInstance
      exact sInf_le ⟨inferInstance,isPGroup_quotient_of_sup_eq_top _ _ S.isPGroup' (hgen S)⟩
    exact hres.trans (hF.trans le_sup_left)
  | symmetricThree c =>
    have h3 : IsPGroup 3 (pResidual 2 D) := by
      apply IsPGroup.of_card (n := 1)
      rw [← card_map_of_injective (K := pResidual 2 D) (f := c.equiv.toMonoidHom) c.equiv.injective,map_pResidual]
      exact Theory.SpecificGroups.SymmetricThree.CubicSelection.residual_card
    exact (show pResidual 2 D ≤ pCore 3 D from le_sSup ⟨inferInstance,h3⟩).trans le_sup_right
  | twoFactors c =>
    let := c.product.second_normal
    let := c.product.swap.second_normal
    rw [← embedded_pResidual_sup_eq_of_normal_sup_top 2 c.first c.second c.product.sup_eq_top]
    exact sup_le (model_residual_le _ c.firstCase.group_models)
      (model_residual_le _ c.secondCase.group_models)
  | outerSixThree c => exact outer_residual_le ρ hg c
  | hyperplane c =>
    let := c.product.second_normal
    let := c.product.swap.second_normal
    rw [← embedded_pResidual_sup_eq_of_normal_sup_top 2 c.first c.second c.product.sup_eq_top]
    refine sup_le (model_residual_le _ (binary_three_models c.firstEquiv)) ?_
    apply model_residual_le
    cases c.secondCase with
    | linearThree r _ h => exact h.elim fun e => binary_three_models e.groupEquiv
    | linearTwo F h => exact h.elim fun e => linear_two_models F e.groupEquiv


/-- A proper Sylow overgroup must miss the full three-core or an actual
ordinary component. This applies uniformly to all five adequate alternatives. -/
theorem adequate_oddCore_or_component_escape
    {D X : Type*} [Group D] [Finite D] [AddCommGroup X] [Module (ZMod 2) X]
    (ρ : Representation (ZMod 2) D X) (hg : offenderSubgroup ρ = ⊤)
    (h : NontrivialAdequateAlternative ρ) (S : Sylow 2 D) (M : Subgroup D)
    (hSM : (S : Subgroup D) ≤ M) (hM : M ≠ ⊤) :
    ¬ pCore 3 D ≤ M ∨ ∃ K : Subgroup D, IsComponent D K ∧ ¬ K ≤ M := by
  by_contra! hn
  have hE : componentLayer D ≤ M := sSup_le fun K hK => hn.2 K hK
  have hR : pResidual 2 D ≤ M :=
    (adequate_residual_le_layer_threeCore ρ hg h).trans (sup_le hE hn.1)
  exact hM (top_unique ((pResidual_sup_sylow_eq_top S).symm ▸ sup_le hR hSM))

open Stellmacher ChapterB.InternalThompsonAction DoubledBinaryThompson

/-- The source dichotomy in the literal Thompson image. Both branches use
the full inverse image under the original centralizer quotient map; the
component is also an ordinary component of that ambient quotient. -/
theorem thompson_oddCore_or_component_escape
    {H : Type*} [Group H] [Finite H]
    (Y : Subgroup H) [Y.Normal] [IsElementaryAbelian 2 Y]
    (S : Sylow 2 H) (M : Subgroup H)
    (hH : IsSQTK KnownSimple.IsKnownSimple H)
    (hcore : pCore 2 (ActionQuotient Y) = ⊥)
    (hSM : (S : Subgroup H) ≤ M)
    (hker : centralizer (Y : Set H) ≤ M)
    (hnot : ¬ elementaryAbelianMaxJ (⊤ : Subgroup H) ≤ M) :
    ¬ ((pCore 3 (thompsonImage Y)).map (thompsonImage Y).subtype).comap (actionMk Y) ≤ M ∨
      ∃ K : Subgroup (thompsonImage Y), IsComponent (thompsonImage Y) K ∧
        IsComponent (ActionQuotient Y) (K.map (thompsonImage Y).subtype) ∧
        ¬ (K.map (thompsonImage Y).subtype).comap (actionMk Y) ≤ M := by
  let J := thompsonImage Y
  let q := actionMk Y
  have hq : Function.Surjective q := QuotientGroup.mk'_surjective _
  let : (elementaryAbelianMaxJ (⊤ : Subgroup H)).Characteristic := elementaryAbelianMaxJ_top_characteristic
  let : J.Normal := (inferInstance : (elementaryAbelianMaxJ (⊤ : Subgroup H)).Normal).map q hq
  let M' := (M.map q).subgroupOf J
  have hM : M' ≠ ⊤ := by
    intro he
    have hJM : J ≤ M.map q := subgroupOf_eq_top.mp he
    have hh := map_le_iff_le_comap.mp hJM
    rw [comap_map_eq] at hh
    have hk : q.ker ≤ M := by simpa only [q,actionMk,QuotientGroup.ker_mk'] using hker
    exact hnot (hh.trans (sup_le le_rfl hk))
  obtain ⟨P,hP⟩ := (S.mapSurjective hq).exists_subgroupOf_eq_of_normal J
  have hPM : (P : Subgroup J) ≤ M' := by
    rw [hP]
    exact subgroupOf_mono J (map_mono hSM)
  have hclass := thompson_adequate Y hH hcore (fun he => hnot (he.trans hker))
  have hh := adequate_oddCore_or_component_escape (thompsonAction Y)
    (thompson_hypothesis Y hH hcore).generated hclass P M' hPM hM
  have step (A : Subgroup J) (hn : ¬ A ≤ M') : ¬ (A.map J.subtype).comap q ≤ M := by
    intro ha
    apply hn
    have hm := map_mono (f := q) ha
    rw [map_comap_eq_self_of_surjective hq] at hm
    exact map_le_iff_le_comap.mp hm
  rcases hh with h3 | ⟨K,hK,hKM⟩
  · exact Or.inl (step _ h3)
  · exact Or.inr ⟨K,hK,lift_component J (inferInstance : J.Normal).isSubnormal hK,step K hKM⟩

