module
public import CFSG.Quasithin.Chapter7.NormalizedSource.MathieuNearOffenders.Coordinates

/-!
# A checked clique and fixed-vector certificate

A near-offender has at least sixteen elements, and the product of its order
and its fixed-space order is at least 1024. The branching certificate keeps
both sets: a positive branch intersects the commuting vertices and fixed-vector
mask, while a negative branch deletes the actor. A leaf violates one of these
cardinality conditions or lies in the original octad kernel's vertex mask.

The soundness proof treats arbitrary finite subsets, so the resulting theorem
applies to every elementary subgroup of the actual native Sylow group.
Source: Aschbacher--Smith H.15.2(1), pp.398--399. The Python search supplies only
data; the proof uses kernel reduction of the independently proved checker.
-/

@[expose] public section
namespace CFSG.Quasithin.Chapter7.NormalizedSource.MathieuNearOffenderCertificate
open Sporadic.Mathieu.M24ChapterHStabilizers.ElementaryFusion.SylowCoverage
inductive Tree where
  | small : Tree
  | covered : Tree
  | branch : Fin 192 → Tree → Tree → Tree

def check : Tree → List (Fin 192) → List (Fin 2048) → Bool
  | .small,u,f => decide (u.length < 16 ∨ u.length * f.length < 1024)
  | .covered,u,_ => u.all (fun v => decide (v ∈ allowed))
  | .branch v l r,u,f =>
    check l (u.filter (fun w => w != v)) f &&
    check r (u.filter (compatible v))
      (f.filter (fixedTest v))

theorem check_sound (t : Tree) (u : List (Fin 192)) (f : List (Fin 2048))
    (ht : check t u f = true)
    (s : Finset (Fin 192)) (F : Finset (Fin 2048))
    (hs : ∀ v ∈ s, v ∈ u) (hF : ∀ x ∈ F, x ∈ f)
    (hcard : 16 ≤ s.card) (hprod : 1024 ≤ s.card * F.card)
    (hc : ∀ v ∈ s, ∀ w ∈ s, compatible v w = true)
    (hfix : ∀ v ∈ s, ∀ x ∈ F, fixedTest v x = true) :
    ∀ v ∈ s, v ∈ allowed := by
  induction t generalizing u f with
  | small =>
    have hsmall : u.length < 16 ∨ u.length * f.length < 1024 := of_decide_eq_true ht
    have hsu : s.card ≤ u.length :=
      (Finset.card_le_card (fun v hv => List.mem_toFinset.mpr (hs v hv))).trans
        (List.toFinset_card_le u)
    have hFf : F.card ≤ f.length :=
      (Finset.card_le_card (fun x hx => List.mem_toFinset.mpr (hF x hx))).trans
        (List.toFinset_card_le f)
    have hp := Nat.mul_le_mul hsu hFf
    omega
  | covered =>
    intro v hv
    exact of_decide_eq_true (List.all_eq_true.mp ht v (hs v hv))
  | branch v l r ihl ihr =>
    have ⟨hl,hr⟩ : check l (u.filter (fun w => w != v)) f = true ∧
      check r (u.filter (compatible v))
        (f.filter (fixedTest v)) = true := by
      simpa only [check,Bool.and_eq_true] using ht
    by_cases hv : v ∈ s
    · apply ihr _ _ hr
      · intro w hw
        exact List.mem_filter.mpr ⟨hs w hw,hc v hv w hw⟩
      · intro x hx
        exact List.mem_filter.mpr ⟨hF x hx,by simpa using hfix v hv x hx⟩
    · apply ihl _ _ hl _ hF
      intro w hw
      exact List.mem_filter.mpr ⟨hs w hw,by
        simpa only [bne_iff_ne] using (show w ≠ v by rintro rfl; exact hv hw)⟩




