/-!
# Checked fixed-vector coordinates for the M24 cocode

The literal native Sylow vertices act on the eleven coordinates of the cocode.
For each nonidentity vertex, Gaussian elimination supplies a small matrix
identity reconstructing its kernel from seven (possibly padded) free coordinates.
The 128 resulting words lie in a checked fixed-vector mask. The identity vertex
fixes every word. No native evaluation or unchecked rank computation is used.

These data support the near-offender uniqueness argument of Aschbacher--Smith,
H.15.2(1), printed pp.398--399 (refs/quasithin.pdf). The generator is untrusted;
all matrix identities and mask memberships are checked by the Lean kernel.
-/

@[expose] public section
namespace CFSG.Quasithin.Chapter7.NormalizedSource.MathieuNearOffenderCertificate
def unpack (x : Fin 2048) : Coordinates := fun i => if x.val.testBit i.val then 1 else 0

theorem unpack_injective : Function.Injective unpack := by
  intro x y h
  apply Fin.ext
  apply Nat.eq_of_testBit_eq
  intro i
  by_cases hi : i < 11
  · have hh := congrFun h ⟨i,hi⟩
    change (if x.val.testBit i then (1 : ZMod 2) else 0) =
      (if y.val.testBit i then 1 else 0) at hh
    cases hx : x.val.testBit i <;> cases hy : y.val.testBit i <;> simp_all
  · have hx : x.val < 2 ^ i := lt_of_lt_of_le x.isLt (Nat.pow_le_pow_right (n := 2) (i := 11) (by decide) (by omega))
    have hy : y.val < 2 ^ i := lt_of_lt_of_le y.isLt (Nat.pow_le_pow_right (n := 2) (i := 11) (by decide) (by omega))
    rw [Nat.testBit_eq_false_of_lt hx,Nat.testBit_eq_false_of_lt hy]

noncomputable def unpackEquiv : Fin 2048 ≃ Coordinates := Equiv.ofBijective unpack
  ((Fintype.bijective_iff_injective_and_card unpack).mpr ⟨unpack_injective, by simp [Coordinates]⟩)

-- The source action of a single coordinate pair uses the forward permutation.
theorem full_pair (g : M24) (j : Fin 11) :
    fullRepresentation g (coordinateWord j).val =
      Pi.single (g.val (nonpivot j)) 1 + Pi.single (g.val 23) 1 := by
  ext i
  change ((Pi.single (nonpivot j) 1 + Pi.single 23 1) : Full) (g.val.symm i) = _
  simp only [Pi.add_apply, Pi.single_apply]
  congr 1
  · congr 1
    exact propext (Equiv.symm_apply_eq g.val)
  · congr 1
    exact propext (Equiv.symm_apply_eq g.val)

def bits (x : Nat) : Coordinates := fun i => if x.testBit i.val then 1 else 0

theorem bits_xor (x y : Nat) : bits (x ^^^ y) = bits x + bits y := by
  ext i
  simp only [bits, Nat.testBit_xor, Pi.add_apply]
  cases x.testBit i.val <;> cases y.testBit i.val <;> decide

@[simp] theorem bits_zero : bits 0 = 0 := by ext i; simp [bits]

def packed (c : Nat → Nat) (x : Nat) : Nat → Nat
  | 0 => 0
  | n+1 => packed c x n ^^^ (if x.testBit n then c n else 0)

theorem bits_packed (c : Nat → Nat) (x n : Nat) :
    bits (packed c x n) = ∑ j ∈ Finset.range n, if x.testBit j then bits (c j) else 0 := by
  induction n with
  | zero => simp [packed]
  | succ n ih =>
    rw [packed, bits_xor, ih, Finset.sum_range_succ]
    congr 1
    cases x.testBit n <;> simp

