def correctionColumn (v : Fin 192) (j : Nat) : Nat := (lookup 8 correctionTable v.val >>> (11*j)) % 2048
def seven (x : Fin 128) : Fin 7 → ZMod 2 := fun i => if x.val.testBit i.val then 1 else 0

theorem seven_injective : Function.Injective seven := by
  intro x y h
  apply Fin.ext
  apply Nat.eq_of_testBit_eq
  intro i
  by_cases hi : i < 7
  · have hh := congrFun h ⟨i,hi⟩
    change (if x.val.testBit i then (1 : ZMod 2) else 0) =
      (if y.val.testBit i then 1 else 0) at hh
    cases hx : x.val.testBit i <;> cases hy : y.val.testBit i <;> simp_all
  · have hx : x.val < 2 ^ i := lt_of_lt_of_le x.isLt
      (Nat.pow_le_pow_right (n := 2) (i := 7) (by decide) (by omega))
    have hy : y.val < 2 ^ i := lt_of_lt_of_le y.isLt
      (Nat.pow_le_pow_right (n := 2) (i := 7) (by decide) (by omega))
    rw [Nat.testBit_eq_false_of_lt hx,Nat.testBit_eq_false_of_lt hy]

noncomputable def sevenEquiv : Fin 128 ≃ (Fin 7 → ZMod 2) := Equiv.ofBijective seven
  ((Fintype.bijective_iff_injective_and_card seven).mpr ⟨seven_injective,by simp⟩)

def numericMatrix (v : Fin 192) : Matrix (Fin 11) (Fin 11) (ZMod 2) :=
  fun i j => bits (column v j.val) i

def basisMatrix (v : Fin 192) : Matrix (Fin 11) (Fin 7) (ZMod 2) :=
  fun i j => bits (basisColumn v j.val) i

def selector (v : Fin 192) : Matrix (Fin 7) (Fin 11) (ZMod 2) :=
  fun i j => if freeIndex v i = j then 1 else 0

def correctionMatrix (v : Fin 192) : Matrix (Fin 11) (Fin 11) (ZMod 2) :=
  fun i j => bits (correctionColumn v j.val) i

def GoodRepair (v : Fin 192) : Prop := v ≠ 0 →
  (1 : Matrix (Fin 11) (Fin 11) (ZMod 2)) =
    basisMatrix v * selector v + correctionMatrix v * numericMatrix v

def GoodImage (v : Fin 192) : Prop := ∀ y : Fin 128,
    (lookup 8 fixedTable v.val).testBit (packed (basisColumn v) y.val 7) = true

theorem zero_fixed : ∀ x : Fin 2048, fixedTest 0 x = true := by decide +kernel

theorem packed_basis_lt (v : Fin 192) (x n : Nat) : packed (basisColumn v) x n < 2048 := by
  induction n with
  | zero => change 0 < 2048; decide
  | succ n ih =>
    apply Nat.xor_lt_two_pow (n := 11) ih
    split_ifs
    · exact Nat.mod_lt _ (by decide)
    · decide

theorem bits_packed_basis (v : Fin 192) (y : Fin 128) :
    bits (packed (basisColumn v) y.val 7) = (basisMatrix v).mulVec (seven y) := by
  rw [bits_packed, ←Fin.sum_univ_eq_sum_range]
  ext i
  simp only [Finset.sum_apply, Matrix.mulVec, dotProduct, seven, basisMatrix]
  apply Finset.sum_congr rfl
  intro j _
  cases y.val.testBit j.val <;>
    simp only [Bool.false_eq_true, if_false, Pi.zero_apply, mul_zero, if_true, mul_one]

theorem goodFixed_of_repair (v : Fin 192) (hc : GoodColumn v)
    (hr : GoodRepair v) (hi : GoodImage v) : GoodFixed v := by
  intro x hx
  by_cases hv : v = 0
  · subst v
    exact zero_fixed x
  have hm : numericMatrix v = rawMatrix v := Matrix.ext (fun i j => hc i j)
  have hz : (numericMatrix v).mulVec (unpack x) = 0 := by
    rw [hm,←bits_packed_matrix v hc,hx,bits_zero]
  obtain ⟨y,hy⟩ := sevenEquiv.surjective ((selector v).mulVec (unpack x))
  change seven y = _ at hy
  have hb := congrArg (fun M : Matrix (Fin 11) (Fin 11) (ZMod 2) => M.mulVec (unpack x)) (hr hv)
  rw [Matrix.one_mulVec,Matrix.add_mulVec,←Matrix.mulVec_mulVec,←Matrix.mulVec_mulVec,hz,
    Matrix.mulVec_zero,add_zero,←hy,←bits_packed_basis] at hb
  have he : x = ⟨packed (basisColumn v) y.val 7,packed_basis_lt v _ _⟩ :=
    unpack_injective hb
  rw [he]
  exact hi y



private def GoodBlock (k : Fin 24) : Prop := ∀ j : Fin 8,
    GoodColumn ⟨8*k.val+j.val,by omega⟩ ∧
    GoodRepair ⟨8*k.val+j.val,by omega⟩ ∧
    GoodImage ⟨8*k.val+j.val,by omega⟩

