def allowed : List (Fin 192) := [0,9,10,11,12,13,15,16,18,19,21,22,24,27,33,35]

def rawMatrix (v : Fin 192) : Matrix (Fin 11) (Fin 11) (ZMod 2) := fun i j =>
  reduce ((Pi.single (vertexPoint v (nonpivot j)) 1 + Pi.single (vertexPoint v 23) 1) : Full) i -
    (Pi.single j 1 : Coordinates) i

theorem rawMatrix_eq (v : Fin 192) : rawMatrix v = displacementMatrix (native v).val := by
  ext i j
  simp only [rawMatrix, displacementMatrix, full_pair, native_apply]

def GoodColumn (v : Fin 192) : Prop := ∀ i j : Fin 11,
  bits (column v j.val) i = rawMatrix v i j

theorem bits_packed_matrix (v : Fin 192) (hv : GoodColumn v) (x : Fin 2048) :
    bits (packed (column v) x.val 11) = (rawMatrix v).mulVec (unpack x) := by
  rw [bits_packed, ←Fin.sum_univ_eq_sum_range]
  ext i
  simp only [Finset.sum_apply, Matrix.mulVec, dotProduct, unpack]
  apply Finset.sum_congr rfl
  intro j _
  cases hx : x.val.testBit j.val <;> simp only [Bool.false_eq_true, if_false, Pi.zero_apply, mul_zero, if_true, mul_one]
  exact hv i j

theorem packed_lt (v : Fin 192) (x n : Nat) : packed (column v) x n < 2048 := by
  induction n with
  | zero => change 0 < 2048; decide
  | succ n ih =>
    apply Nat.xor_lt_two_pow (n := 11) ih
    split_ifs
    · exact Nat.mod_lt _ (by decide)
    · decide

theorem bits_eq_zero_iff {x : Nat} (hx : x < 2048) : bits x = 0 ↔ x = 0 := by
  constructor
  · intro h
    exact congrArg Fin.val (unpack_injective (a₁ := ⟨x,hx⟩) (a₂ := 0) (h.trans bits_zero.symm))
  · rintro rfl
    exact bits_zero

noncomputable def code (z : Cocode) : Fin 2048 := unpackEquiv.symm (coordinates z)

theorem unpack_code (z : Cocode) : unpack (code z) = coordinates z :=
  unpackEquiv.apply_symm_apply _

theorem code_injective : Function.Injective code :=
  unpackEquiv.symm.injective.comp coordinateEquiv.injective

theorem native_fixed_code (v : Fin 192) (hv : GoodColumn v) (z : Cocode)
    (hz : cocodeRepresentation (native v).val z = z) :
    packed (column v) (code z).val 11 = 0 := by
  apply (bits_eq_zero_iff (packed_lt v _ _)).mp
  rw [bits_packed_matrix v hv, unpack_code, rawMatrix_eq,
    ←Matrix.mulVecLin_apply, displacementMatrix_eq]
  change coordinates (cocodeRepresentation (native v).val (sectionMap (coordinates z)) -
    sectionMap (coordinates z)) = 0
  have hsec := LinearMap.congr_fun sectionMap_coordinates z
  change sectionMap (coordinates z) = z at hsec
  rw [hsec,hz,sub_self,map_zero]

def GoodFixed (v : Fin 192) : Prop := ∀ x : Fin 2048,
  packed (column v) x.val 11 = 0 → fixedTest v x = true


