/-!
# The outside-overgroup generation comparison in the Mathieu branch

The source E.2.2 dispatcher constructs an odd Hall subgroup in the literal
H ∩ N_G(L), containing a cyclic group of order 2ᶠ − 1 with n(H) ≤ f.
The Hall-faithfulness input and quotient-conjugation transport put this
witness in an automorphism subgroup of L/O₂(L) containing its inner group.
The Mathieu Cartan restriction then gives f ≤ 2. The two central quotients
are identified using the actual chosen-module action, rather than replacing
the component by a simple group or discarding an outer extension.

The native model calculation discharges the Cartan restriction on this
literal quotient-conjugation image. The completed normalized 4.4.14 theorem
supplies Hall faithfulness, giving the generation bound on the original
chosen module with no additional Hall or model premise.

Source: Aschbacher--Smith, 7.3.4 and Table 7.2.1, printed pp.698--699,
using E.3.38 and 4.4.14. The separate min(w,r) comparison belongs to the
global-bounds consumer.
-/

public noncomputable section
open Subgroup Theory.GroupTheory Representation.BinaryOffender
open scoped Pointwise IsMulCommutative
namespace CFSG.Quasithin.Chapter12.Section02.ChosenModule
open ChapterE ChapterE.Section06.FixedPointBounds
open ChapterE.Section06.FixedPointBounds.ParabolicCartan
open Chapter7.NormalizedSource Chapter7.NormalizedSource.MathieuGeneration
universe u
variable {G : Type u} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}
  (D : ChosenModule T L V)

/-- The projective marking is transported through the actual orbit action;
the source quotient L/O₂(L) is allowed to remain a central cover. -/
theorem sourceOrbit_mathieu_coreQuotient
    (h : Hypothesis1221 KnownSimple.IsKnownSimple T L)
    (hm : HasMathieuCentralQuotient D.orbitComponent) :
    HasMathieuCentralQuotient (L ⧸ pCore 2 L) := by
  rcases hm with ⟨⟨e⟩⟩ | ⟨⟨e⟩⟩ | ⟨⟨e⟩⟩ | ⟨⟨e⟩⟩
  · exact Or.inl ⟨(D.orbitCentralQuotientEquiv h).trans e⟩
  · exact Or.inr (Or.inl ⟨(D.orbitCentralQuotientEquiv h).trans e⟩)
  · exact Or.inr (Or.inr (Or.inl ⟨(D.orbitCentralQuotientEquiv h).trans e⟩))
  · exact Or.inr (Or.inr (Or.inr ⟨(D.orbitCentralQuotientEquiv h).trans e⟩))

/-- The Cartan restriction on the literal quotient-conjugation image.
This discharges `MathieuCartanRestriction` for the chosen-module consumer,
including central covers and every intermediate outer extension. -/
theorem sourceOrbit_mathieu_quotientAction_nPrime_le_two
    (h : Hypothesis1221 KnownSimple.IsKnownSimple T L)
    (hm : HasMathieuCentralQuotient D.orbitComponent) :
    nPrime (normalizerPCoreQuotientAction L).range ≤ 2 :=
  mathieuCartanRestriction (L ⧸ pCore 2 L) inferInstance inferInstance h.quasisimple
    (D.sourceOrbit_mathieu_coreQuotient h hm) _ (inner_le_quotientAction_range L)

/-- The actual faithful Hall--Cartan witness has exponent at most two.
The generation assembly supplies the normalized Hall-faithfulness premise;
no model restriction is left as an extra premise. -/
theorem sourceOrbit_mathieu_cartan_le_two
    (h : Hypothesis1221 KnownSimple.IsKnownSimple T L)
    (hm : HasMathieuCentralQuotient D.orbitComponent) {f : ℕ}
    (w : NPrimeWitness (normalizer (L : Set G)) f)
    (hfaith : w.cyclicGroup.map (normalizer (L : Set G)).subtype ⊓
      Chapter4.sectionCentralizer L = ⊥) : f ≤ 2 :=
  (le_nPrime_quotientAction_of_faithful L w hfaith).trans
    (D.sourceOrbit_mathieu_quotientAction_nPrime_le_two h hm)

/-- The outside-overgroup generation bound in the Mathieu rows of 7.3.4.
The literal Hall subgroup of H ∩ N_G(L) supplied by E.2.2 acts faithfully
on L/O₂(L) by normalized 4.4.14. Its cyclic Cartan witness therefore has
exponent at most two, including for central covers and outer extensions. -/
theorem sourceOrbit_mathieu_generation_le_two
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hV : V = D.sourceOrbit)
    (hs : ChapterK.RankOne.SourceHypotheses D.orbitRepresentation D.orbitComponent)
    (hm : HasMathieuCentralQuotient D.orbitComponent)
    (hnon : ¬ IsFFModule D.sourceOrbitNormalizerRepresentation)
    {H : Subgroup G}
    (hH : H ∈ Chapter3.HStar (T : Subgroup G) (normalizer (L : Set G))) :
    generationParameter H ≤ 2 := by
  by_cases hn : generationParameter H ≤ 1
  · exact hn.trans (by decide)
  have hlarge : 1 < generationParameter H := by omega
  let F := D.fundamentalSetup h.toHypothesis1221
  have hFM : F.maximalLocal = normalizer (L : Set G) := by
    change normalizer (Chapter3.Section02.localOrbit T L : Set G) = _
    rw [D.localOrbit_eq]
  have hH' : H ∈ Chapter3.HStar (T : Subgroup G) F.maximalLocal := hFM.symm ▸ hH
  obtain ⟨hP, f, _, hf, d, he, hBT, _⟩ :=
    Chapter10.source_hstar_cartan_data_of_generation_gt_one F hH' hlarge
  have he' : ChapterB.minimalParabolicMax (T.subtype hH.1.1.2) hP =
      (normalizer (L : Set G)).subgroupOf H := by simpa only [hFM] using he
  have hB := sourceMathieuHallFaithfulAt T L V D h hmany hV hs hm hnon H hH hlarge
    d.witness.abelianGroup (d.hall_le.trans_eq he') (he' ▸ d.hall)
    d.witness.abelian hBT
  let w := overlapWitness hH.1.1.2 D.sylow_normalizes_component d he'
  apply hf.trans (D.sourceOrbit_mathieu_cartan_le_two h.toHypothesis1221 hm w ?_)
  exact (congrArg (fun C : Subgroup G => C ⊓ Chapter4.sectionCentralizer L)
    (overlapWitness_cyclic_image hH.1.1.2 D.sylow_normalizes_component d he')).trans
      (bot_unique ((inf_le_inf_right _ (map_mono d.witness.cyclic_le)).trans_eq hB))

/-- The generation-cap consumer on the original chosen module. Its Chapter K
source hypotheses are constructed from the multiple-overgroup and non-FF
assumptions; no independent representation or Hall input remains. -/
theorem sourceOrbit_mathieu_generation_le_two_of_many
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hV : V = D.sourceOrbit)
    (hm : HasMathieuCentralQuotient D.orbitComponent)
    (hnon : ¬ IsFFModule D.sourceOrbitNormalizerRepresentation)
    {H : Subgroup G}
    (hH : H ∈ Chapter3.HStar (T : Subgroup G) (normalizer (L : Set G))) :
    generationParameter H ≤ 2 :=
  D.sourceOrbit_mathieu_generation_le_two h hmany hV
    (D.sourceOrbit_chapterK_of_many h hmany hnon hV) hm hnon hH

end CFSG.Quasithin.Chapter12.Section02.ChosenModule
