module
public import CFSG.Quasithin.ChapterB.InternalThompsonAction
public import CFSG.Quasithin.ChapterB.Section05.GeneralClassification.Complete
public import Theory.GroupTheory.ReducedNormal.Defs
public import Stellmacher.ElementaryAbelianMaxGlobal

/-!
# Thompson classification on the original reduced quotient

The maximum-elementary Thompson subgroup of H maps to best offenders on
its original normal elementary subgroup. Restricting to that actual image
preserves bestness, so its faithful action is generated by best offenders.
Reducedness supplies the trivial two-core, and the inverse image in H
supplies the genuine SQTK cover. The complete adequate B.5.6 theorem then
classifies this very Thompson image, without replacing it by the full
best-offender subgroup of the ambient quotient.

NonFFSourceDoubledBinaryOmega applies this to the reduced omega-center
orbit of the original escaping group. The adequate outer A₆–C₃ alternative
retains its group configuration; no disputed direct-sum clause is used.
Source: Aschbacher–Smith B.2.5–7, B.5.3–6 and the opening paragraph of the
proof of 7.7.3, printed pp.76–77,104–105,707, refs/quasithin.pdf.
-/

@[expose] public noncomputable section
open Subgroup Representation Representation.BinaryOffender Stellmacher Theory.GroupTheory
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter7.NormalizedSource.DoubledBinaryThompson
open ChapterB.InternalThompsonAction ChapterB.SourceInduction
universe u
variable {H : Type u} [Group H] [Finite H]

/-- The image of the original global maximum-elementary Thompson subgroup
in the literal quotient by the centralizer of the reduced module. -/
abbrev thompsonImage (U : Subgroup H) [U.Normal] :=
  (elementaryAbelianMaxJ (⊤ : Subgroup H)).map (actionMk U)

/-- The actual faithful action of that Thompson image. -/
abbrev thompsonAction (U : Subgroup H) [U.Normal] [IsElementaryAbelian 2 U] :=
  (action U).comp (thompsonImage U).subtype

/-- B.2.5 generates the actual Thompson image by its best offenders;
B.5.3 is therefore available on this image, with the original SQTK cover. -/
theorem thompson_hypothesis
    (U : Subgroup H) [U.Normal] [IsElementaryAbelian 2 U]
    (hH : IsSQTK KnownSimple.IsKnownSimple H)
    (hcore : pCore 2 (ActionQuotient U) = ⊥) :
    FFHypothesis KnownSimple.IsKnownSimple (thompsonAction U) := by
  let q := actionMk U
  have hq : Function.Surjective q := QuotientGroup.mk'_surjective _
  let J := thompsonImage U
  let ρ := action U
  let : (elementaryAbelianMaxJ (⊤ : Subgroup H)).Characteristic :=
    elementaryAbelianMaxJ_top_characteristic
  let : J.Normal := (inferInstance : (elementaryAbelianMaxJ (⊤ : Subgroup H)).Normal).map q hq
  have hgen : offenderSubgroup (ρ.comp J.subtype) = ⊤ := by
    have hle : J ≤ (offenderSubgroup (ρ.comp J.subtype)).map J.subtype := by
      change (elementaryAbelianMaxJ (⊤ : Subgroup H)).map q ≤ _
      rw [map_le_iff_le_comap]
      apply sSup_le
      intro A hA
      apply map_le_iff_le_comap.mp
      by_cases hz : A.map q = ⊥
      · rw [hz]
        exact bot_le
      have hAJ : A.map q ≤ J := map_mono (le_sSup hA)
      have hb := NormalElementaryQuotient.maxElementary_isBestOffender U q hq
        (QuotientGroup.ker_mk' _) ⊤ A le_top hA hz
      have hh := (hb.subgroupOf ρ hAJ).le_offenderSubgroup (ρ.comp J.subtype)
      exact (map_subgroupOf_eq_of_le hAJ).symm.le.trans (map_mono hh)
    apply top_unique
    intro x _
    obtain ⟨y,hy,he⟩ := hle x.property
    exact J.subtype_injective he ▸ hy
  have htwo : pCore 2 J = ⊥ := by
    have hn : ((pCore 2 J).map J.subtype).Normal := ConjAct.normal_of_characteristic_of_normal
    have hl : (pCore 2 J).map J.subtype ≤ pCore 2 (ActionQuotient U) :=
      le_sSup ⟨hn,pCore_isPGroup.map _⟩
    rw [hcore] at hl
    exact ((pCore 2 J).map_eq_bot_iff_of_injective J.subtype_injective).mp (le_bot_iff.mp hl)
  refine ⟨inferInstance,(action_faithful U).comp J.subtype_injective,htwo,hgen,?_⟩
  exact ⟨{ Cover := J.comap q
           kernel := (q.subgroupComap J).ker
           sqtk := hH.subgroup _
           equiv := QuotientGroup.quotientKerEquivOfSurjective _
             (q.subgroupComap_surjective_of_surjective _ hq) }⟩

/-- The source-adequate B.5.6 alternatives hold for the literal nontrivial
Thompson image, with no classification or quotient-action premise. -/
theorem thompson_adequate
    (U : Subgroup H) [U.Normal] [IsElementaryAbelian 2 U]
    (hH : IsSQTK KnownSimple.IsKnownSimple H)
    (hcore : pCore 2 (ActionQuotient U) = ⊥)
    (hJ : ¬ elementaryAbelianMaxJ (⊤ : Subgroup H) ≤ centralizer (U : Set H)) :
    NontrivialAdequateAlternative (thompsonAction U) := by
  have hne : thompsonImage U ≠ ⊥ := by
    intro hz
    apply hJ
    simpa only [actionMk,QuotientGroup.ker_mk'] using
      (map_eq_bot_iff (elementaryAbelianMaxJ (⊤ : Subgroup H))).mp hz
  let : Nontrivial (thompsonImage U) := (Subgroup.nontrivial_iff_ne_bot _).mpr hne
  exact nontrivialAdequateAlternative_knownSimple _ (thompson_hypothesis U hH hcore)

/-- The complete adequate alternatives on a specified reduced module,
using that module's actual normality and elementary structure. -/
def ReducedThompsonAlternative (U : Subgroup H) (hU : IsPReduced 2 U) : Prop :=
  let := hU.normal
  let := hU.elementary
  NontrivialAdequateAlternative (thompsonAction U)

theorem reduced_thompson_adequate
    (U : Subgroup H) (hU : IsPReduced 2 U)
    (hH : IsSQTK KnownSimple.IsKnownSimple H)
    (hJ : ¬ elementaryAbelianMaxJ (⊤ : Subgroup H) ≤ centralizer (U : Set H)) :
    ReducedThompsonAlternative U hU := by
  let := hU.normal
  let := hU.elementary
  exact thompson_adequate U hH hU.quotient_pCore_eq_bot hJ

end CFSG.Quasithin.Chapter7.NormalizedSource.DoubledBinaryThompson
