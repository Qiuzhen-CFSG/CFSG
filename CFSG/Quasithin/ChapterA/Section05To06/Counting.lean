module

public import Theory.GroupTheory.TwoInvolutionClassOrder
public import Theory.GroupTheory.PGroup.CyclicInvolution

/-!
# The counting sets and Thompson formula of A.6

The source's `A(x)` uses membership in the cyclic group generated by the
product, rather than a specified power. Uniqueness of the involution in a
finite cyclic group identifies this set with the existing Thompson fiber.
Thus the order formula below counts exactly the source's pairs.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), A.6.1,
printed p. 64. The subsequent counting sets are those of A.6.2–5.
-/

@[expose] public section

namespace CFSG.Quasithin.ChapterA.Section05To06

open Subgroup Theory.GroupTheory.TwoInvolutionClassOrder

variable {G : Type*} [Group G]

/-- The two representatives describe precisely the two involution classes. -/
structure TwoInvolutionClasses (z t : G) : Prop where
  order_z : orderOf z = 2
  order_t : orderOf t = 2
  distinct : ¬ IsConj z t
  exhaustive : ∀ x : G, orderOf x = 2 → IsConj z x ∨ IsConj t x

/-- Source `A(x)`, with both conjugacy class representatives explicit. -/
def A (z t x : G) : Set (G × G) :=
  {p | IsConj z p.1 ∧ IsConj t p.2 ∧ x ∈ zpowers (p.1 * p.2)}

def A1 (z t x : G) : Set (G × G) :=
  {p | p ∈ A z t x ∧ orderOf (p.1 * p.2) % 4 = 0}

def A2 (z t x : G) : Set (G × G) :=
  {p | p ∈ A z t x ∧ orderOf (p.1 * p.2) % 4 = 2}

def B1 (x : G) : Set G :=
  {u | IsConj x u ∧ Commute u x ∧ IsConj u (u * x)}

def B2 (x : G) : Set G :=
  {u | IsConj x u ∧ Commute u x ∧ ¬ IsConj u (u * x)}

/-- `y` represents the involution class different from that of `x`. -/
def C1 (x y : G) : Set G :=
  {u | IsConj y u ∧ Commute u x ∧ IsConj u (u * x)}

def C2 (x y : G) : Set G :=
  {u | IsConj y u ∧ Commute u x ∧ ¬ IsConj u (u * x)}

noncomputable def a (z t x : G) : ℕ := Nat.card (A z t x)
noncomputable def a1 (z t x : G) : ℕ := Nat.card (A1 z t x)
noncomputable def a2 (z t x : G) : ℕ := Nat.card (A2 z t x)
noncomputable def b1 (x : G) : ℕ := Nat.card (B1 x)
noncomputable def b2 (x : G) : ℕ := Nat.card (B2 x)
noncomputable def c1 (x y : G) : ℕ := Nat.card (C1 x y)
noncomputable def c2 (x y : G) : ℕ := Nat.card (C2 x y)

/-- The root condition in A.6 is equivalent to the canonical half-order
power, for an involution and a mixed pair. -/
theorem mem_zpowers_iff_halfOrder [Finite G] {z t u v x : G}
    (h : TwoInvolutionClasses z t) (hx : orderOf x = 2)
    (hu : IsConj z u) (hv : IsConj t v) :
    x ∈ zpowers (u * v) ↔ halfOrder u v = x := by
  have hh := (halfOrder_properties h.order_z h.order_t h.distinct hu hv).1
  have hm : halfOrder u v ∈ zpowers (u * v) := by
    rw [halfOrder_def]
    exact pow_mem (mem_zpowers _) _
  constructor
  · intro hxmem
    have heq : (⟨halfOrder u v, hm⟩ : zpowers (u * v)) = ⟨x, hxmem⟩ :=
      IsCyclic.eq_of_orderOf_eq_two (by simpa using hh) (by simpa using hx)
    exact congrArg Subtype.val heq
  · rintro rfl
    exact hm

theorem a_eq_kappa [Finite G] {z t x : G} (h : TwoInvolutionClasses z t)
    (hx : orderOf x = 2) : a z t x = kappa z t x := by
  rw [kappa_def]
  simp_rw [← halfOrder_def]
  apply Nat.card_congr
  apply Equiv.subtypeEquivRight
  intro p
  change (_ ∧ _ ∧ _) ↔ (_ ∧ _ ∧ _)
  constructor
  · rintro ⟨hu, hv, hm⟩
    exact ⟨hu, hv, (mem_zpowers_iff_halfOrder h hx hu hv).mp hm⟩
  · rintro ⟨hu, hv, hm⟩
    exact ⟨hu, hv, (mem_zpowers_iff_halfOrder h hx hu hv).mpr hm⟩

/-- A.6.1, Thompson's order formula, with the source's literal `A(x)`. -/
theorem lemma_A_6_1 [Finite G] {z t : G} (h : TwoInvolutionClasses z t) :
    Nat.card G = Nat.card (centralizer ({z} : Set G)) * a z t t +
      Nat.card (centralizer ({t} : Set G)) * a z t z := by
  rw [a_eq_kappa h h.order_z, a_eq_kappa h h.order_t]
  simpa only [mul_comm, add_comm] using
    card_eq z t h.order_z h.order_t h.distinct h.exhaustive

/-- The disjoint decomposition immediately after A.6.1. An involution
in the product's cyclic subgroup forces its order to be even. -/
theorem A_eq_union {z t x : G} (hx : orderOf x = 2) :
    A z t x = A1 z t x ∪ A2 z t x := by
  ext p
  constructor
  · intro hp
    have hd : 2 ∣ orderOf (p.1 * p.2) := hx ▸ orderOf_dvd_of_mem_zpowers hp.2.2
    have he : orderOf (p.1 * p.2) % 4 = 0 ∨ orderOf (p.1 * p.2) % 4 = 2 := by
      omega
    exact he.elim (fun h => Or.inl ⟨hp, h⟩) (fun h => Or.inr ⟨hp, h⟩)
  · rintro (hp | hp)
    · exact hp.1
    · exact hp.1

theorem disjoint_A1_A2 (z t x : G) : Disjoint (A1 z t x) (A2 z t x) := by
  rw [Set.disjoint_left]
  intro p hp hq
  have hp' := hp.2
  have hq' := hq.2
  omega

theorem a_eq_add [Finite G] {z t x : G} (hx : orderOf x = 2) :
    a z t x = a1 z t x + a2 z t x := by
  classical
  unfold a a1 a2
  rw [A_eq_union hx, Nat.card_congr (Equiv.Set.union (disjoint_A1_A2 z t x)), Nat.card_sum]

end CFSG.Quasithin.ChapterA.Section05To06

end
