module

public import CFSG.Quasithin.ChapterA.Section02.Sporadic
public import Theory.SpecificGroups.BabyMonster.AlternatingNine
public import Theory.SpecificGroups.Alternating.NineRank

/-!
# The Baby Monster obstruction in A.2.19

An explicit identification of a nontrivial group with the complete Y433
presentation supplies an involution and an embedded A9 in its centralizer.
The numerator is the actual image subgroup, and the quotient map is the inverse
of the proved isomorphism onto that image. In particular its kernel is normal
in the numerator; no splitting or ambient-normality hypothesis is assumed.
The section is nonabelian simple and has 3-rank at least three.

The source eliminates the Baby Monster using involution-centralizer simple
sections (GLS3, Table 5.3y lists Co2 and 2E6(2) sections). Here a smaller section
is obtained directly from the presentation: the S9 chain on vertices 0,...,7
commutes with vertex 9. The imported proof establishes faithfulness on A9.
Three disjoint 3-cycles then give the odd-prime rank obstruction of A.2.15(2).
For a finite ambient group we also place the image in the normalizer of the
cyclic subgroup generated by this involution and deduce m_{2,3} >= 3 directly.

Nontriviality is supplied by the parent's actual simple group, through the
explicit equivalence. No finiteness, order, simplicity, matrix faithfulness or
centralizer-identification theorem for the presentation is assumed. Both
ninth-power relations remain in BabyMonster.Carrier; no double-cover carrier
is substituted. The parent retains the induction and cover arguments.

Source: Aschbacher--Smith, *The Classification of Quasithin Groups*, combined
manuscript of 1 March 2004, A.2.15(2) and A.2.19, printed pp. 37--41
(PDF pp. 48--52); Breuer--Magaard--Wilson (2019), section 3.1, for Y433.
-/

public section
namespace CFSG.Quasithin.ChapterA

variable {G : Type*} [Group G]

/-- Transport the actual A9 chain homomorphism through the given identification. -/
noncomputable def babyMonster_alternatingNineEmbedding (e : G ≃* BabyMonster.Carrier) :
    alternatingGroup (Fin 9) →* G :=
  e.symm.toMonoidHom.comp BabyMonster.alternatingNineHom

/-- The parent's nontriviality hypothesis makes the transported map faithful. -/
theorem babyMonster_alternatingNineEmbedding_injective [Nontrivial G]
    (e : G ≃* BabyMonster.Carrier) :
    Function.Injective (babyMonster_alternatingNineEmbedding e) := by
  let : Nontrivial BabyMonster.Carrier := e.injective.nontrivial
  exact e.symm.injective.comp BabyMonster.alternatingNineHom_injective

/-- The image of canonical generator 9 under the inverse identification. -/
def babyMonster_sectionInvolution (e : G ≃* BabyMonster.Carrier) : G :=
  e.symm (BabyMonster.generator 9)

/-- The selected element has order exactly two. -/
theorem babyMonster_sectionInvolution_order [Nontrivial G]
    (e : G ≃* BabyMonster.Carrier) : orderOf (babyMonster_sectionInvolution e) = 2 := by
  let : Nontrivial BabyMonster.Carrier := e.injective.nontrivial
  exact (e.symm.orderOf_eq _).trans (BabyMonster.generator_orderOf 9)

/-- Every element of the constructed A9 commutes with the selected involution. -/
theorem babyMonster_alternatingNineEmbedding_centralizes
    (e : G ≃* BabyMonster.Carrier) (a : alternatingGroup (Fin 9)) :
    babyMonster_alternatingNineEmbedding e a ∈
      Subgroup.centralizer ({babyMonster_sectionInvolution e} : Set G) := by
  apply Subgroup.mem_centralizer_singleton_iff.mpr
  have h := Subgroup.mem_centralizer_singleton_iff.mp
    (BabyMonster.alternatingNineHom_centralizes a)
  exact (e.symm.map_mul _ _).symm.trans ((congrArg e.symm h).trans (e.symm.map_mul _ _))

/-- An actual centralizing numerator and a surjection from it onto concrete A9. -/
noncomputable def babyMonster_alternatingNineQuotientData [Nontrivial G]
    (e : G ≃* BabyMonster.Carrier) :
    InvolutionCentralizerQuotientData G (alternatingGroup (Fin 9)) where
  involution := babyMonster_sectionInvolution e
  involution_order := babyMonster_sectionInvolution_order e
  numerator := (babyMonster_alternatingNineEmbedding e).range
  centralizes := by
    rintro _ ⟨a, rfl⟩
    exact babyMonster_alternatingNineEmbedding_centralizes e a
  quotientMap := (MonoidHom.ofInjective
    (babyMonster_alternatingNineEmbedding_injective e)).symm.toMonoidHom
  surjective := (MonoidHom.ofInjective
    (babyMonster_alternatingNineEmbedding_injective e)).symm.surjective

/-- Simplicity of the concrete nine-letter alternating group. -/
theorem babyMonster_section_simple : IsSimpleGroup (alternatingGroup (Fin 9)) :=
  alternatingGroup.isSimpleGroup (by simp)

/-- The section has explicit noncommuting elements. -/
theorem babyMonster_section_nonabelian :
    ∃ a b : alternatingGroup (Fin 9), a * b ≠ b * a :=
  Theory.AlternatingNine.noncommuting

/-- This section violates the odd-prime rank bound in A.2.15(2). -/
theorem babyMonster_section_three_rank : 2 < primeRank 3 (alternatingGroup (Fin 9)) :=
  Theory.AlternatingNine.three_le_primeRank

/-- The constructed subgroup yields a genuine two-local rank obstruction. -/
theorem babyMonster_three_le_twoLocalPrimeRank [Nontrivial G] [Finite G]
    (e : G ≃* BabyMonster.Carrier) : 3 ≤ twoLocalPrimeRank 3 G := by
  let t := babyMonster_sectionInvolution e
  let Q := Subgroup.zpowers t
  have ht : orderOf t = 2 := babyMonster_sectionInvolution_order e
  have hQ : Q ≠ ⊥ := by
    intro h
    have : t = 1 := Subgroup.mem_bot.mp (h ▸ Subgroup.mem_zpowers t)
    rw [this, orderOf_one] at ht
    contradiction
  have hp : IsPGroup 2 Q := IsPGroup.of_card (n := 1)
    (by simpa only [pow_one] using (Nat.card_zpowers t).trans ht)
  let N := Subgroup.normalizer (Q : Set G)
  have hN : IsTwoLocal N := ⟨Q, hQ, hp, rfl⟩
  have hf (a : alternatingGroup (Fin 9)) : babyMonster_alternatingNineEmbedding e a ∈ N := by
    apply Subgroup.centralizer_le_normalizer
    rw [show Q = Subgroup.closure {t} from Subgroup.zpowers_eq_closure t,
      Subgroup.centralizer_closure]
    exact babyMonster_alternatingNineEmbedding_centralizes e a
  let f := (babyMonster_alternatingNineEmbedding e).codRestrict N hf
  have hi : Function.Injective f := by
    intro a b h
    exact babyMonster_alternatingNineEmbedding_injective e (congrArg Subtype.val h)
  exact Theory.AlternatingNine.three_le_primeRank.trans
    ((primeRank_le_of_injective 3 f hi).trans (hN.primeRank_le 3))

/-- No finite nontrivial group identified with this carrier is quasithin. -/
theorem not_quasithin_of_babyMonster_equiv [Nontrivial G] [Finite G]
    (e : G ≃* BabyMonster.Carrier) : ¬ IsQuasithin G := by
  intro h
  have hle := isQuasithin_iff_twoLocalPrimeRank.mp h 3 (by decide) (by decide)
  have hge := babyMonster_three_le_twoLocalPrimeRank e
  omega

end CFSG.Quasithin.ChapterA
