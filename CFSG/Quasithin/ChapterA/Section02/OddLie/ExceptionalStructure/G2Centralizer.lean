module

public import Theory.SpecificGroups.G2.OddFundamentalCentralizer

/-!
# The fundamental residual centralizer in the G₂ branch of A.2.17

The marked subgroup is generated by Wilson's long-root group E and its
opposite. Its full centralizer, and hence its prime-to-p residual, is the
other quaternion SL₂. The defining-characteristic rank of this literal
residual is at least the field degree. Thus the source bound m_p(J) ≤ 1
forces the field to be prime. The same rank argument works inside an
arbitrary ambient group through its actual embedded fundamental subgroup.

Source: Aschbacher–Smith, `refs/quasithin.pdf`, A.2.17, printed p.39,
especially (*) and the final G₂ case. The model calculation implements
the fundamental-subgroup input cited there from Aschbacher, *On finite
groups of Lie type and odd characteristic*, J. Algebra 66 (1980),
pp.401–402, Theorem 1. No perfectness assumption excludes SL₂(3).
-/

@[expose] public section

namespace CFSG.Quasithin.ChapterA.Section02
open Matrix
open scoped MatrixGroups
open Atlas.G2.OddFundamentalCentralizer
variable {F : Type*} [Field F]

/-- The source J, computed inside the full centralizer of the marked long-root SL₂. -/
abbrev g2FundamentalResidual (F : Type*) [Field F] (p : ℕ) :=
  Subgroup.primeToResidual p
    (Subgroup.centralizer (fundamental (F := F) : Set (Atlas.G2.Model F)))

private theorem two_ne_zero_of_odd_prime {p : ℕ} [Fact p.Prime] [CharP F p]
    (hp : p ≠ 2) : (2 : F) ≠ 0 := by
  intro h
  have hlt : 2 < p := lt_of_le_of_ne (Fact.out : p.Prime).two_le (Ne.symm hp)
  exact Nat.not_dvd_of_pos_of_lt (by decide : 0 < 2) hlt
    ((CharP.cast_eq_zero_iff F p 2).mp (by simpa using h))

/-- The actual residual centralizer in odd G₂ is SL₂ over the defining field. -/
noncomputable def g2FundamentalResidualEquivSL2 {p : ℕ} [Fact p.Prime] [CharP F p]
    (hp : p ≠ 2) : g2FundamentalResidual F p ≃* SL(2,F) :=
  residualEquivSL2 p (by exact two_ne_zero_of_odd_prime hp)

/-- The literal inclusion of J is the previously constructed first quaternion factor. -/
theorem g2_fundamental_residual_image {p : ℕ} [Fact p.Prime] [CharP F p]
    (hp : p ≠ 2) :
    (g2FundamentalResidual F p).map
      (Subgroup.centralizer (fundamental (F := F) : Set (Atlas.G2.Model F))).subtype =
        complementHom.range :=
  residual_map_eq_complement p (two_ne_zero_of_odd_prime hp)

/-- Apply the source bound (*) to the actual G₂ residual, forcing q = p. -/
theorem g2_fieldExponent_eq_one_of_fundamental_residual_rank [Finite F]
    {p e : ℕ} [Fact p.Prime] [CharP F p]
    (he : 1 ≤ e) (hcard : Nat.card F = p^e)
    (hrank : primeRank p (g2FundamentalResidual F p) ≤ 1) : e = 1 :=
  Nat.le_antisymm ((fieldExponent_le_residualRank hcard).trans hrank) he

variable {G : Type*} [Group G]

/-- The complementary factor included in the residual of the embedded fundamental centralizer. -/
def g2EmbeddedResidualHom (p : ℕ) [CharP F p] (f : Atlas.G2.Model F →* G) :
    SL(2,F) →* Subgroup.primeToResidual p
      (Subgroup.centralizer ((f.comp fundamentalHom).range : Set G)) :=
  let j : SL(2,F) →* Subgroup.centralizer ((f.comp fundamentalHom).range : Set G) :=
    (f.comp complementHom).codRestrict _ fun A => by
      apply Subgroup.mem_centralizer_iff.mpr
      rintro _ ⟨B,rfl⟩
      exact ((factors_commute A B).map f).eq.symm
  j.codRestrict _ (Matrix.SL2.map_mem_primeToResidual p j)

/-- The residual map retains the actual octonion inclusion. -/
theorem g2EmbeddedResidualHom_coe (p : ℕ) [CharP F p]
    (f : Atlas.G2.Model F →* G) (A : SL(2,F)) :
    ((g2EmbeddedResidualHom p f A).val : G) = f (complementHom A) := rfl

/-- A faithful G₂ embedding gives the field-degree rank witness inside the source's literal J. -/
theorem g2_fieldExponent_le_embedded_residual_rank [Finite F] [Finite G]
    {p e : ℕ} [Fact p.Prime] [CharP F p] (hcard : Nat.card F = p^e)
    (f : Atlas.G2.Model F →* G) (hf : Function.Injective f) :
    e ≤ primeRank p (Subgroup.primeToResidual p
      (Subgroup.centralizer ((f.comp fundamentalHom).range : Set G))) := by
  apply SpecialLinearGroup.fieldExponent_le_primeRank_of_injective hcard
    (g2EmbeddedResidualHom p f)
  intro A B h
  exact Atlas.G2.orthogonalLeftHom_injective (hf (congrArg (fun x => x.val.val) h))

/-- Discharge the prime-field step from (*) in any actual ambient embedding. -/
theorem g2_fieldExponent_eq_one_of_embedded_residual_rank [Finite F] [Finite G]
    {p e : ℕ} [Fact p.Prime] [CharP F p]
    (he : 1 ≤ e) (hcard : Nat.card F = p^e)
    (f : Atlas.G2.Model F →* G) (hf : Function.Injective f)
    (hrank : primeRank p (Subgroup.primeToResidual p
      (Subgroup.centralizer ((f.comp fundamentalHom).range : Set G))) ≤ 1) : e = 1 :=
  Nat.le_antisymm ((g2_fieldExponent_le_embedded_residual_rank hcard f hf).trans hrank) he

end CFSG.Quasithin.ChapterA.Section02
