module

public import CFSG.Quasithin.ChapterA.Section03.OddPrime.SourceModels.FieldArithmetic
public import CFSG.KnownSimple.CarrierCatalogue
public import Theory.GroupTheory.CComponent.Basic
public import Theory.GroupTheory.PResidual.PrimeTo

/-!
# The complete source proposition A.3.18

`LemmaA318` is a proposition specifying the universal earlier-source input.
This module does not assert that proposition as a theorem. Its alternatives
keep the original H and L, the quotient H/O_{p'}(H), the actual image of L,
and the prime-to-p residual. In particular, theta is generated by elements
of order exactly three in H, and the conjugacy assertion in (3b) ranges
over every outside subgroup of order three in the entire H*.

The split alternative retains a marked action on an actual special linear
or special unitary group. Conjugation is by a general linear or unitary
matrix and is required to be outer. The internal product, trivial
intersection and order-three complement express the split extension in
the literal residual, without replacing the original subgroups.

Source: Aschbacher--Smith, combined manuscript of 1 March 2004,
Definition A.3.17 and Lemma A.3.18, printed pp.51--52.
-/

@[expose] public section
noncomputable section

open scoped MatrixGroups
open Matrix Subgroup Theory.GroupTheory
open BenderSuzuki.MatrixGroups
open CFSG.Quasithin.Chapter1.Section02.LocalModels

namespace CFSG.Quasithin.ChapterA.Section03.OddPrime.SourceModels

universe u

/-- A.3.17: generation by actual elements of order three. -/
def theta (H : Type*) [Group H] : Subgroup H :=
  closure {x : H | orderOf x = 3}

/-- The source star quotient, with precisely the prime-to-p core as kernel. -/
abbrev Star (p : ℕ) (H : Type*) [Group H] := H ⧸ pPrimeCore p H

def starMap (p : ℕ) (H : Type*) [Group H] : H →* Star p H :=
  QuotientGroup.mk' (pPrimeCore p H)

def starComponent {H : Type*} [Group H] (p : ℕ) (L : Subgroup H) :
    Subgroup (Star p H) := L.map (starMap p H)

/-- A marked diagonal automorphism of SL₃, via actual GL₃ conjugation. -/
def IsLinearDiagonal (L : Type u) [Group L] (q : ℕ) (α : MulAut L) : Prop :=
  ∃ (F : Type) (_ : Field F) (_ : Finite F), Nat.card F = q ∧
    ∃ (e : L ≃* SL(3,F)) (g : GL (Fin 3) F),
      ∀ l : L, SpecialLinearGroup.toGL (e (α l)) =
        g * SpecialLinearGroup.toGL (e l) * g⁻¹

/-- A marked diagonal automorphism of SU₃, via actual unitary conjugation. -/
def IsUnitaryDiagonal (L : Type u) [Group L] (q : ℕ) (α : MulAut L) : Prop :=
  ∃ (F : Type) (_ : Field F) (_ : Finite F) (J : HermitianForm 3 F),
    Nat.card F = q ^ 2 ∧ (∀ x, J.conj x = x ^ q) ∧
      ∃ (e : L ≃* J.specialSubgroup) (g : J.unitarySubgroup),
        ∀ l : L, (e (α l)).val = g.val * (e l).val * g.val⁻¹

def IsDiagonalSign (L : Type u) [Group L] (unitary : Bool) (q : ℕ)
    (α : MulAut L) : Prop :=
  if unitary then IsUnitaryDiagonal L q α else IsLinearDiagonal L q α

/-- The full list in A.3.18(3), including all three exceptional covers. -/
def CoverAlternative (L : Type u) [Group L] : Prop :=
  (∃ (unitary : Bool) (q : ℕ), SignedCongruence unitary q ∧ IsSLSign L unitary 3 q) ∨
    IsAlternatingCover L 6 ∨ IsAlternatingCover L 7 ∨ IsM22Cover L

/-- A.3.18(3b), with all products and conjugates in the given ambient group. -/
def SplitDiagonalAlternative {S : Type u} [Group S] (L : Subgroup S) : Prop :=
  ∃ (unitary : Bool) (q : ℕ), SignedCongruence unitary q ∧ IsSLSign L unitary 3 q ∧
    ∃ (x : S) (α : MulAut L),
      orderOf x = 3 ∧
      (∀ l : L, (α l).val = x * l.val * x⁻¹) ∧
      α ∉ MulAut.innerSubgroup L ∧ IsDiagonalSign L unitary q α ∧
      primeToResidual 3 S = L ⊔ zpowers x ∧ Disjoint L (zpowers x) ∧
      IsCyclic ((centralizer ({x} : Set S)).comap L.subtype) ∧
      Nat.card ((centralizer ({x} : Set S)).comap L.subtype) = singerOrder unitary q ∧
      ∀ X : Subgroup S, Nat.card X = 3 → ¬ X ≤ L →
        ∃ l : L, X.map (MulAut.conj l.val).toMonoidHom = zpowers x

/-- A.3.18(2): the projective component and the two actual residual models. -/
def ProjectiveAlternative {H : Type u} [Group H] (p : ℕ) (L : Subgroup H) : Prop :=
  p = 3 ∧ ∃ (unitary : Bool) (q : ℕ), SignedCongruence unitary q ∧
    IsPSLSign (starComponent p L) unitary 3 q ∧
      (IsPGLSign (primeToResidual 3 (Star p H)) unitary q ∨
        ((∃ m : ℕ, 0 < m ∧ q = 2 ^ (3 * m)) ∧
          IsCircleSign (primeToResidual 3 (Star p H)) unitary q))

/-- The literal disjunction printed in A.3.18, without extra input conclusions. -/
def Alternatives {H : Type u} [Group H] (p : ℕ) (L : Subgroup H) : Prop :=
  L = primeToResidual p H ∨ ProjectiveAlternative p L ∨
    (p = 3 ∧ CoverAlternative (starComponent p L) ∧
      (L = theta H ∨ SplitDiagonalAlternative (starComponent p L)))

/-- The universal source premise. Proving this proposition is the A.3.18 owner's
task; defining it does not supply that theorem or any of its alternatives. -/
def LemmaA318 : Prop :=
  ∀ (H : Type u) [Group H] [Finite H], IsSQTK KnownSimple.IsKnownSimple H →
    ∀ (L : Subgroup H), L.IsCComponent → IsQuasisimple (L ⧸ pCore 2 L) →
      ∀ p : ℕ, p.Prime → Odd p → 1 < primeRank p L → Alternatives p L

end CFSG.Quasithin.ChapterA.Section03.OddPrime.SourceModels
