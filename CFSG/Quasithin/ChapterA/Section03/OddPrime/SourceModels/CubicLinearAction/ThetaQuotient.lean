module

public import CFSG.Quasithin.ChapterA.Section03.OddPrime.SourceModels.CubicLinearAction
public import CFSG.Quasithin.ChapterA.Section03.OddPrime.SourceModels.ProjectiveIndices
public import Theory.GroupAction.ComponentRankAction.PrimeClosure

/-!
# The exact cubic theta dichotomy for a binary linear component

The source theta is generated by elements of order three. Its action on the
component's central quotient is inner-diagonal by the fixed-nine rank bound.
The component itself is generated by cubics, so the theta image contains all
inner automorphisms. The index-three comparison leaves exactly the inner and
full PGL images. The inner case absorbs every cubic through the three-prime
kernel. In the full case that kernel is exactly the three-prime core of theta,
giving an equivalence on the literal quotient theta/O₃′(theta).

Source: Aschbacher–Smith, A.3.18, pp.51–53, used in 2.5.7, printed p.556.
Normality, cubic generation, field exclusion and the core identification are
proved from the original SQTK component and its central two-kernel.
-/

@[expose] public section
noncomputable section
open Subgroup Theory.GroupTheory
open scoped MatrixGroups
open Theory.GroupAction.ComponentRankAction
open Matrix.PSL3.OuterSolvable Matrix.PSL3.ExtensionBorel
namespace CFSG.Quasithin.ChapterA.Section03.OddPrime.SourceModels.CubicLinearAction

variable {H F : Type*} [Group H] [Finite H] [Field F] [Finite F]

omit [Finite H] [Finite F] in
/-- The ambient action has exactly the original component centralizer as kernel. -/
theorem ambientAction_ker {L : Subgroup H} [L.Normal] [Group.IsPerfect L]
    (e : L ⧸ center L ≃* PSL(3,F)) :
    (ambientAction L e).ker = centralizer (L : Set H) := by
  ext x
  change (⟨x, by rw [L.normalizer_eq_top]; trivial⟩ : normalizer (L : Set H)) ∈
    (action L e).ker ↔ x ∈ centralizer (L : Set H)
  rw [ker_eq]
  rfl

omit [Finite H] [Finite F] in
/-- Restriction to the original component gives precisely the inner image. -/
theorem ambientAction_component_image {L : Subgroup H} [L.Normal]
    (e : L ⧸ center L ≃* PSL(3,F)) :
    L.map (ambientAction L e) = MulAut.innerSubgroup PSL(3,F) := by
  apply le_antisymm
  · rintro _ ⟨x, hx, rfl⟩
    exact ⟨e (QuotientGroup.mk' (center L) ⟨x, hx⟩),
      (action_on_component L e ⟨x, hx⟩).symm⟩
  · rintro _ ⟨y, rfl⟩
    obtain ⟨x, rfl⟩ := (e.surjective.comp (QuotientGroup.mk'_surjective (center L))) y
    exact ⟨x, x.property, action_on_component L e x⟩

private theorem image_alternatives (A : Subgroup (MulAut PSL(3,F)))
    (hi : MulAut.innerSubgroup PSL(3,F) ≤ A) (ha : A ≤ innerDiagonal F)
    (hmod : Nat.card F % 3 = 1) :
    A = MulAut.innerSubgroup PSL(3,F) ∨ A = innerDiagonal F := by
  let I := MulAut.innerSubgroup PSL(3,F)
  let D := innerDiagonal F
  have hc : Nat.card D = 3 * Nat.card I := by
    rw [← Nat.card_congr (pglEquivInnerDiagonal F).toEquiv,
      card_pgl_three_eq_three_mul_psl hmod]
    congr 1
    exact Nat.card_congr (MonoidHom.ofInjective (inner_injective F)).toEquiv
  have hid : I.relIndex D = 3 := by
    have hh := (I.subgroupOf D).card_mul_index
    rw [Nat.card_congr (subgroupOfEquivOfLe (inner_le_innerDiagonal F)).toEquiv] at hh
    change Nat.card I * I.relIndex D = Nat.card D at hh
    rw [hc] at hh
    have hpos : 0 < Nat.card I := Nat.card_pos
    nlinarith
  have hm := I.relIndex_mul_relIndex A D hi ha
  rw [hid] at hm
  have hd : I.relIndex A ∣ 3 := ⟨A.relIndex D, hm.symm⟩
  rcases (Nat.dvd_prime Nat.prime_three).mp hd with h | h
  · exact Or.inl (le_antisymm (relIndex_eq_one.mp h) hi)
  · have h' : A.relIndex D = 1 := by
      rw [h] at hm
      omega
    exact Or.inr (le_antisymm ha (relIndex_eq_one.mp h'))

/-- The original component is the source theta, or theta modulo its own
three-prime core is the actual PGL₃ over the marked coefficient field. -/
theorem theta_eq_or_marked_quotient_pgl (hH : IsSQTK KnownSimple.IsKnownSimple H)
    {L : Subgroup H} (hL : IsComponent H L) (hZ : IsPGroup 2 (center L))
    {n : ℕ} (hn : 0 < n) (hF : Nat.card F = 2 ^ n) (hd : 3 ∣ 2 ^ n - 1)
    (e : L ⧸ center L ≃* PSL(3,F)) :
    let _ := component_normal hH hL hZ hF hd e
    L = theta H ∨ ∃ E :
      ((theta H) ⧸ pPrimeCore 3 (theta H)) ≃* Matrix.ProjGenLinGroup (Fin 3) F,
      ∀ x : theta H,
        (pglEquivInnerDiagonal F (E (QuotientGroup.mk' (pPrimeCore 3 (theta H)) x))).val =
          ambientAction L e x := by
  let := hL.2
  let := component_normal hH hL hZ hF hd e
  let : IsSimpleGroup PSL(3,F) := e.isSimpleGroup_congr.mp IsQuasisimple.simple
  have hz : Nat.Coprime 3 (Nat.card (center L)) := by
    obtain ⟨m, hm⟩ := hZ.exists_card_eq
    rw [hm]
    exact (by decide : Nat.Coprime 3 2).pow_right m
  have hr := Matrix.PSL3.CubicComponentAction.component_rank hZ hF
    ((Nat.BinaryTorusParity.three_dvd_sub_one_iff n).mp hd) e
  have hdiv : 3 ∣ Nat.card L := by
    by_contra hh
    have hz' := PrimeRank.eq_zero_iff_not_dvd_card.mpr hh
    omega
  have hgen : L ≤ theta H := component_le_prime_closure L hz hdiv
  let f := ambientAction L e
  have hfker : Nat.Coprime 3 (Nat.card f.ker) := by
    rw [ambientAction_ker]
    exact centralizer_coprime L hz hr (hH.stronglyQuasithin 3 Nat.prime_three (by decide))
  have himage : L.map f = MulAut.innerSubgroup PSL(3,F) := ambientAction_component_image e
  have hinner : MulAut.innerSubgroup PSL(3,F) ≤ (theta H).map f :=
    himage ▸ map_mono hgen
  have hdiag : (theta H).map f ≤ innerDiagonal F := theta_image_le hH hL hZ hn hF hd e
  have hmod : Nat.card F % 3 = 1 := by
    have hpos : 0 < Nat.card F := Nat.card_pos
    rw [← hF] at hd
    omega
  rcases image_alternatives _ hinner hdiag hmod with hi | hi
  · left
    exact (prime_closure_eq_component_of_image_le f hfker L hz hdiv
      (by change (theta H).map f ≤ L.map f; rw [hi, himage])).symm
  · right
    let g : theta H →* innerDiagonal F :=
      (f.comp (theta H).subtype).codRestrict _
        (fun x => hdiag (mem_map_of_mem f x.property))
    have hg : Function.Surjective g := by
      intro y
      obtain ⟨x, hx, he⟩ := hi.ge y.property
      exact ⟨⟨x, hx⟩, Subtype.ext he⟩
    have hgker : Nat.Coprime 3 (Nat.card g.ker) := by
      have he : g.ker = f.ker.subgroupOf (theta H) := by
        ext x
        exact Subtype.ext_iff
      rw [he]
      exact hfker.of_dvd_right (card_comap_dvd_of_injective f.ker
        (theta H).subtype (theta H).subtype_injective)
    have hds : 3 ∣ Nat.card PSL(3,F) := by
      by_contra hh
      have hz' := PrimeRank.eq_zero_iff_not_dvd_card.mpr hh
      have hh' := Theory.SpecificGroups.SignedThreeCubicRank.linear_projective hF
        ((Nat.BinaryTorusParity.three_dvd_sub_one_iff n).mp hd)
      omega
    have hc : pPrimeCore 3 (innerDiagonal F) = ⊥ := by
      apply actor_pPrimeCore_eq_bot (innerDiagonal F) (inner_le_innerDiagonal F) _ hds
      let : Group.IsPerfect SL(3,F) := Atlas.sl_perfect 3 (by decide)
      exact Group.IsPerfect.center_quotient_center_eq_bot SL(3,F)
    have hkernel : pPrimeCore 3 (theta H) = g.ker := by
      have hh := pPrimeCore_comap_eq_of_surjective_coprime 3 g hg hgker
      rw [hc] at hh
      exact hh.symm
    let E := ((QuotientGroup.quotientMulEquivOfEq hkernel).trans
      (QuotientGroup.quotientKerEquivOfSurjective g hg)).trans
        (pglEquivInnerDiagonal F).symm
    refine ⟨E, ?_⟩
    intro x
    simp only [E, MulEquiv.trans_apply, MulEquiv.apply_symm_apply]
    rfl

/-- The quotient equivalence after forgetting its explicit compatibility marking. -/
theorem theta_eq_or_quotient_pgl (hH : IsSQTK KnownSimple.IsKnownSimple H)
    {L : Subgroup H} (hL : IsComponent H L) (hZ : IsPGroup 2 (center L))
    {n : ℕ} (hn : 0 < n) (hF : Nat.card F = 2 ^ n) (hd : 3 ∣ 2 ^ n - 1)
    (e : L ⧸ center L ≃* PSL(3,F)) :
    L = theta H ∨ Nonempty
      (((theta H) ⧸ pPrimeCore 3 (theta H)) ≃* Matrix.ProjGenLinGroup (Fin 3) F) := by
  rcases theta_eq_or_marked_quotient_pgl hH hL hZ hn hF hd e with h | ⟨E, _⟩
  · exact Or.inl h
  · exact Or.inr ⟨E⟩

/-- The exact source model predicate, keeping the quotient of theta itself. -/
theorem theta_eq_or_isPGLThree {F : Type} [Field F] [Finite F]
    (hH : IsSQTK KnownSimple.IsKnownSimple H)
    {L : Subgroup H} (hL : IsComponent H L) (hZ : IsPGroup 2 (center L))
    {n : ℕ} (hn : 0 < n) (hF : Nat.card F = 2 ^ n) (hd : 3 ∣ 2 ^ n - 1)
    (e : L ⧸ center L ≃* PSL(3,F)) :
    L = theta H ∨ IsPGLThree ((theta H) ⧸ pPrimeCore 3 (theta H)) (2 ^ n) := by
  rcases theta_eq_or_quotient_pgl hH hL hZ hn hF hd e with h | h
  · exact Or.inl h
  · exact Or.inr ⟨F, inferInstance, inferInstance, hF, h⟩

/-- The cubic linear specialization of A.3.18 uses only the original source model. -/
theorem theta_eq_or_isPGLThree_of_model
    (hH : IsSQTK KnownSimple.IsKnownSimple H)
    {L : Subgroup H} (hL : IsComponent H L) (hZ : IsPGroup 2 (center L))
    {n : ℕ} (hn : 1 < n) (hd : 3 ∣ 2 ^ n - 1)
    (hm : ClassicalGroup.IsPSL (L ⧸ center L) 3 (2 ^ n)) :
    L = theta H ∨ IsPGLThree ((theta H) ⧸ pPrimeCore 3 (theta H)) (2 ^ n) := by
  obtain ⟨F, _, _, hF, ⟨e⟩⟩ := hm
  exact theta_eq_or_isPGLThree hH hL hZ (by omega) hF hd e

end CFSG.Quasithin.ChapterA.Section03.OddPrime.SourceModels.CubicLinearAction
