module
public import CFSG.Quasithin.ChapterA.Section03.OddPrime.SourceModels.NormalSplitPrime.ReeField
public import Theory.GroupTheory.PPrimeCorePGroupQuotient
public import Theory.GroupTheory.PResidual.QuasisimpleCubicGeneration
public import Theory.GroupTheory.GeneralizedFitting.QuasisimpleCore
public import Theory.GroupTheory.PrimeRankSquareFree

/-!
# Retaining the cubic cover in the literal source quotient

In the remaining normal split extension, the two-core component is
quasisimple with center of order three. Its three-prime core is trivial,
and the outside cubic makes the ambient component quotient a three-group.
Thus the ambient three-prime core also vanishes. Pulling back along the
original two-core map proves O_{3'}(H) = O₂(H); the source star quotient
retains the whole central cover.

An elementary nine cannot lie in the cyclic center, so the cover is
generated by cubics. Together with the outside actor this proves the
source residual product. Prime order and nonmembership prove the trivial
intersection. These establish the elementary splitting clauses; the
marked diagonal action, Singer centralizer and conjugacy clauses remain
separate obligations. `alternatives_or_star_cover` applies the calculation
to the original universal split domain, and OddRankSource applies it to
the literal Cartan extension.

Source: Aschbacher–Smith A.3.18, printed pp.51–53, and 4.3.6, p.615.
-/

@[expose] public noncomputable section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.ChapterA.Section03.OddPrime.SourceModels.NormalSplitPrime.CoverStructure
variable {G : Type*} [Group G] [Finite G]

private theorem quasisimple_cubic_closure [IsQuasisimple G]
    (hz : Nat.card (center G) = 3) (hr : 1 < primeRank 3 G) :
    closure {x : G | orderOf x = 3} = ⊤ := by
  have hO : pCore 2 G = ⊥ := by
    have hc := IsQuasisimple.pCore_le_center (G := G) 2
    have hcop : Nat.Coprime 2 (Nat.card (pCore 2 G)) :=
      (show Nat.Coprime 2 (Nat.card (center G)) by rw [hz]; decide).of_dvd_right
        (card_dvd_of_le hc)
    apply eq_bot_iff.mpr
    intro x hx
    have h := (pCore_isPGroup (p := 2) (G := G)).orderOf_coprime hcop
      (⟨x,hx⟩ : pCore 2 G)
    have he := Nat.eq_one_of_dvd_coprimes h dvd_rfl (orderOf_dvd_natCard (⟨x,hx⟩ : pCore 2 G))
    exact mem_bot.mpr (congrArg Subtype.val (orderOf_eq_one_iff.mp he))
  let e : (G ⧸ pCore 2 G) ≃* G :=
    (QuotientGroup.quotientMulEquivOfEq hO).trans (QuotientGroup.quotientBot)
  let : IsQuasisimple (G ⧸ pCore 2 G) := IsQuasisimple.of_mulEquiv e.symm
  apply cubic_closure_eq_top_of_twoCore_quasisimple (by omega)
  rw [primeRank_congr 3 (centerCongr e)]
  apply primeRank_le_one_of_square_not_dvd
  rw [hz]
  decide

/-- The actual cubic cover survives its three-prime star quotient. -/
theorem pPrimeCore_eq_bot {K : Subgroup G} [K.Normal] [IsQuasisimple K]
    (hz : Nat.card (center K) = 3)
    (a : G) (ha : orderOf a = 3) (hgen : K ⊔ zpowers a = ⊤) :
    pPrimeCore 3 G = ⊥ := by
  have hc : IsPGroup 3 (center K) := IsPGroup.of_card (n := 1) (by simpa only [pow_one] using hz)
  have hd : 3 ∣ Nat.card K := hz ▸ (center K).card_subgroup_dvd_card
  have hK : pPrimeCore 3 K = ⊥ := IsQuasisimple.pPrimeCore_eq_bot hc hd
  apply pPrimeCore_eq_bot_of_isPGroup_quotient 3 K hK
  apply isPGroup_quotient_of_sup_eq_top K (zpowers a) _ hgen
  apply IsPGroup.of_card (n := 1)
  simpa only [Nat.card_zpowers, pow_one] using ha

/-- Rank two in the cover gives cubic generation of the whole split extension. -/
theorem theta_eq_top {K : Subgroup G} [IsQuasisimple K]
    (hz : Nat.card (center K) = 3) (hr : 1 < primeRank 3 K)
    (a : G) (ha : orderOf a = 3) (hgen : K ⊔ zpowers a = ⊤) : theta G = ⊤ := by
  have hK : K ≤ theta G := by
    have hm := congrArg (map K.subtype) (quasisimple_cubic_closure hz hr)
    rw [MonoidHom.map_closure, ← MonoidHom.range_eq_map, range_subtype] at hm
    rw [← hm]
    apply Subgroup.closure_mono
    rintro x ⟨y,hy,rfl⟩
    exact (K.orderOf_coe y).trans hy
  apply top_unique
  rw [← hgen]
  exact sup_le hK (zpowers_le.mpr (subset_closure ha))

/-- The residual in the source is the whole actual split extension. -/
theorem residual_eq_top {K : Subgroup G} [IsQuasisimple K]
    (hz : Nat.card (center K) = 3) (hr : 1 < primeRank 3 K)
    (a : G) (ha : orderOf a = 3) (hgen : K ⊔ zpowers a = ⊤) :
    primeToResidual 3 G = ⊤ := by
  apply top_unique
  rw [← theta_eq_top hz hr a ha hgen]
  apply (Subgroup.closure_le _).mpr
  intro x hx
  change orderOf x = 3 at hx
  apply mem_primeToResidual_of_pow (n := 1)
  simpa only [pow_one, ← hx] using pow_orderOf_eq_one x

/-- For the original C-component extension, O_{3'}(G) is exactly O₂(G),
so its central cubic cover is not collapsed in the source star quotient. -/
theorem pPrimeCore_eq_twoCore {K : Subgroup G} [K.Normal] (hK : K.IsCComponent)
    [IsQuasisimple (K ⧸ pCore 2 K)]
    (hz : Nat.card (center (twoCoreComponent K)) = 3)
    (a : G) (ha : orderOf a = 3) (haK : a ∉ K) (hgen : K ⊔ zpowers a = ⊤) :
    pPrimeCore 3 G = pCore 2 G := by
  let : (twoCoreComponent K).Normal := twoCore_normal K
  let := (twoCore_isComponent hK).2
  have ha' := twoCore_actor Nat.prime_three (by decide) a ha haK
  have hb := pPrimeCore_eq_bot hz (QuotientGroup.mk' (pCore 2 G) a) ha'.1
    (twoCore_join a hgen)
  have hc : Nat.Coprime 3 (Nat.card (QuotientGroup.mk' (pCore 2 G)).ker) := by
    rw [QuotientGroup.ker_mk']
    obtain ⟨n,hn⟩ := (pCore_isPGroup (p := 2) (G := G)).exists_card_eq
    rw [hn]
    exact (by decide : Nat.Coprime 3 2).pow_right n
  have hh := pPrimeCore_comap_eq_of_surjective_coprime 3
    (QuotientGroup.mk' (pCore 2 G)) (QuotientGroup.mk'_surjective _) hc
  rw [hb] at hh
  exact hh.symm.trans (QuotientGroup.ker_mk' _)

/-- The complete elementary splitting clauses on the literal star cover.
The diagonal marking, Singer centralizer and outside-line conjugacy are
separate source obligations. -/
structure StarCover (K : Subgroup G) (a : G) : Prop where
  core : pPrimeCore 3 G = pCore 2 G
  outer : OuterCubicCoverActor (starComponent 3 K) (starMap 3 G a)
  quasisimple : IsQuasisimple (starComponent 3 K)
  rank : 1 < primeRank 3 (starComponent 3 K)
  order : orderOf (starMap 3 G a) = 3
  outside : starMap 3 G a ∉ starComponent 3 K
  residual : primeToResidual 3 (Star 3 G) = starComponent 3 K ⊔ zpowers (starMap 3 G a)
  disjoint : Disjoint (starComponent 3 K) (zpowers (starMap 3 G a))

/-- Preserve the whole cubic cover and establish the residual product and
trivial intersection for the original actor, using the exact source maps. -/
theorem star_cover {K : Subgroup G} [K.Normal] (hK : K.IsCComponent)
    [IsQuasisimple (K ⧸ pCore 2 K)] (hr : 1 < primeRank 3 K)
    (a : G) (ha : orderOf a = 3) (haK : a ∉ K) (hgen : K ⊔ zpowers a = ⊤)
    (hc : OuterCubicCoverActor (twoCoreComponent K) (QuotientGroup.mk' (pCore 2 G) a)) :
    StarCover K a := by
  have he := pPrimeCore_eq_twoCore hK hc.1 a ha haK hgen
  have transfer (N : Subgroup G) [N.Normal] (hN : N = pCore 2 G) :
      OuterCubicCoverActor (K.map (QuotientGroup.mk' N)) (QuotientGroup.mk' N a) ∧
      IsQuasisimple (K.map (QuotientGroup.mk' N)) ∧
      1 < primeRank 3 (K.map (QuotientGroup.mk' N)) ∧
      (orderOf (QuotientGroup.mk' N a) = 3 ∧ QuotientGroup.mk' N a ∉ K.map (QuotientGroup.mk' N)) ∧
      K.map (QuotientGroup.mk' N) ⊔ zpowers (QuotientGroup.mk' N a) = ⊤ := by
    subst N
    exact ⟨hc,(twoCore_isComponent hK).2,
      (twoCore_rank hK (by decide : Odd 3)).symm ▸ hr,
      twoCore_actor Nat.prime_three (by decide) a ha haK,twoCore_join a hgen⟩
  obtain ⟨ho,hquasi,hr',ha',hjoin⟩ := transfer (pPrimeCore 3 G) he
  let := hquasi
  refine ⟨he,ho,hquasi,hr',ha'.1,ha'.2,?_,?_⟩
  · exact (residual_eq_top ho.1 hr' _ ha'.1 hjoin).trans hjoin.symm
  · exact (starComponent 3 K).disjoint_zpowers_of_prime_order_not_mem _ ha'.1 ha'.2

/-- The universal source domain, with all remaining cubic-cover obligations
now on H/O_{3'}(H), and the elementary split clauses already discharged. -/
theorem alternatives_or_star_cover
    (hG : IsSQTK KnownSimple.IsKnownSimple G)
    {K : Subgroup G} [K.Normal] (hK : K.IsCComponent)
    [IsQuasisimple (K ⧸ pCore 2 K)]
    {p : ℕ} (hp : p.Prime) (ho : Odd p) (hr : 1 < primeRank p K)
    (a : G) (ha : orderOf a = p) (haK : a ∉ K) (hgen : K ⊔ zpowers a = ⊤) :
    Alternatives p K ∨ (p = 3 ∧ StarCover K a) := by
  rcases alternatives_or_outer_cubic_cover hG hK hp ho hr a ha haK hgen with halt | ⟨rfl,hc⟩
  · exact Or.inl halt
  · exact Or.inr ⟨rfl,star_cover hK hr a ha haK hgen hc⟩

end CFSG.Quasithin.ChapterA.Section03.OddPrime.SourceModels.NormalSplitPrime.CoverStructure
