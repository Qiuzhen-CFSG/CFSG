module
public import CFSG.Quasithin.ChapterA.Section03.OddPrime.SourceModels.NormalSplitPrime.TwoCore
public import CFSG.Quasithin.ChapterA.Section03.OddPrime.SourceModels.NormalSplitPrime.Star
public import CFSG.Quasithin.ChapterA.Section03.OddPrime.SourceModels.EvenRankTwo
public import CFSG.Quasithin.ChapterA.Section03.OddPrime.SourceModels.ComponentStar
public import Theory.GroupTheory.PResidual.PrimeToTransport

/-!
# The full source alternative for the binary rank-two split branch

For an ordinary component with two-group center and central quotient
PSL₃(2ⁿ) or PSp₄(2ⁿ), an outside split-torus-prime actor rules out the
residual and theta equalities. The surviving cubic linear case has theta(H)=H:
the component is generated by cubics and the specified outside cubic completes
its generators. Thus the known theta quotient is the actual ambient star
quotient, and its three-residual is the whole quotient.

The second theorem applies this argument in H/O₂(H), then transports the
actual star component and star residual back through the proved coprime-kernel
equivalences. It proves the literal Alternatives conclusion for this marked
branch, retaining every original split-domain hypothesis. Other Theorem C
models and covering centers remain separate branches of A.3.18.
Source: Aschbacher–Smith A.3.18, printed pp.51–53.
-/

@[expose] public section
noncomputable section
open Subgroup Theory.GroupTheory
open CFSG.Quasithin.Chapter1.Section02.LocalModels
open Theory.GroupAction.ComponentRankAction
namespace CFSG.Quasithin.ChapterA.Section03.OddPrime.SourceModels.NormalSplitPrime
variable {H : Type*} [Group H] [Finite H]

/-- The marked binary branch; this is not an exhaustive source catalogue. -/
def BinaryModel (B : Type*) [Group B] (p : ℕ) : Prop :=
  IsPGroup 2 (center B) ∧ ∃ n : ℕ, 1 < n ∧ p ∣ 2 ^ n - 1 ∧
    (ClassicalGroup.IsPSL (B ⧸ center B) 3 (2 ^ n) ∨
      ClassicalGroup.IsPSp (B ⧸ center B) 2 (2 ^ n))

def centralQuotientEquiv {A B : Type*} [Group A] [Group B] (e : A ≃* B) :
    (A ⧸ center A) ≃* B ⧸ center B :=
  QuotientGroup.congr _ _ e (by
    ext x
    constructor
    · rintro ⟨y, hy, rfl⟩
      exact (centerCongr e ⟨y, hy⟩).property
    · intro hx
      exact ⟨e.symm x, (centerCongr e.symm ⟨x, hx⟩).property, e.apply_symm_apply x⟩)

theorem BinaryModel.of_mulEquiv {A B : Type*} [Group A] [Group B] {p : ℕ}
    (h : BinaryModel B p) (e : A ≃* B) : BinaryModel A p := by
  obtain ⟨hz, n, hn, hd, hm⟩ := h
  refine ⟨hz.of_equiv (centerCongr e).symm, n, hn, hd, ?_⟩
  exact hm.imp (fun h => h.of_mulEquiv (centralQuotientEquiv e))
    (fun h => h.of_mulEquiv (centralQuotientEquiv e))

theorem ordinary_binary_projective
    (hH : IsSQTK KnownSimple.IsKnownSimple H)
    {K : Subgroup H} (hK : IsComponent H K) (hZ : IsPGroup 2 (center K))
    {n p : ℕ} (hn : 1 < n) (hp : p.Prime) (ho : Odd p)
    (hr : 1 < primeRank p K) (hd : p ∣ 2 ^ n - 1)
    (hm : ClassicalGroup.IsPSL (K ⧸ center K) 3 (2 ^ n) ∨
      ClassicalGroup.IsPSp (K ⧸ center K) 2 (2 ^ n))
    (a : H) (ha : orderOf a = p) (haK : a ∉ K) (hgen : K ⊔ zpowers a = ⊤) :
    p = 3 ∧ SignedCongruence false (2 ^ n) ∧
      ClassicalGroup.IsPSL (starComponent p K) 3 (2 ^ n) ∧
        IsPGLThree (primeToResidual 3 (Star p H)) (2 ^ n) := by
  have halt := even_rank_two_dichotomy hH hK hZ hn hp ho hd hm
  have hncl := ne_prime_closures a ha haK
  rcases halt with he | ⟨hp3, hlin, hpg⟩
  · split_ifs at he with hp3
    · exact ((ne_prime_closures a (ha.trans hp3) haK).1 he).elim
    · exact (hncl.2 he).elim
  · cases hp3
    let := hK.2
    have hz : Nat.Coprime 3 (Nat.card (center K)) := by
      obtain ⟨m, hm⟩ := hZ.exists_card_eq
      rw [hm]
      exact (by decide : Nat.Coprime 3 2).pow_right m
    have hdiv : 3 ∣ Nat.card K := by
      by_contra hdK
      have hzK := PrimeRank.eq_zero_iff_not_dvd_card.mpr hdK
      omega
    have htheta : theta H = ⊤ := by
      apply top_unique
      rw [← hgen]
      exact sup_le (component_le_prime_closure K hz hdiv)
        (zpowers_le.mpr (subset_closure ha))
    have hres : primeToResidual 3 H = ⊤ := by
      apply top_unique
      rw [← htheta]
      apply (closure_le _).mpr
      intro x hx
      change orderOf x = 3 at hx
      apply mem_primeToResidual_of_pow (n := 1)
      simpa only [pow_one, ← hx] using pow_orderOf_eq_one x
    have hstarres : primeToResidual 3 (Star 3 H) = ⊤ := by
      rw [← map_primeToResidual_of_surjective 3 (starMap 3 H)
        (QuotientGroup.mk'_surjective _), hres]
      exact map_top_of_surjective _ (QuotientGroup.mk'_surjective _)
    let e : theta H ≃* H := (MulEquiv.subgroupCongr htheta).trans Subgroup.topEquiv
    let eQ : ((theta H) ⧸ pPrimeCore 3 (theta H)) ≃* Star 3 H :=
      QuotientGroup.congr _ _ e (pPrimeCore_map_iso 3 e)
    obtain ⟨F, _, _, hF, ⟨eF⟩⟩ := hpg
    have hpgstar : IsPGLThree (primeToResidual 3 (Star 3 H)) (2 ^ n) := by
      refine ⟨F, inferInstance, inferInstance, hF, ⟨?_⟩⟩
      exact ((MulEquiv.subgroupCongr hstarres).trans Subgroup.topEquiv).trans
        (eQ.symm.trans eF)
    refine ⟨rfl, ?_, ?_, hpgstar⟩
    · change 2 ^ n % 3 = 1
      have hpos : 0 < 2 ^ n := by positivity
      omega
    · exact hlin.of_mulEquiv (ComponentStar.quotientEquiv hK hZ (by decide) hdiv).symm

theorem alternatives_of_binary_twoCore_model
    (hH : IsSQTK KnownSimple.IsKnownSimple H)
    {K : Subgroup H} [K.Normal] (hK : K.IsCComponent)
    [IsQuasisimple (K ⧸ pCore 2 K)]
    {n p : ℕ} (hn : 1 < n) (hp : p.Prime) (ho : Odd p)
    (hr : 1 < primeRank p K) (hd : p ∣ 2 ^ n - 1)
    (hZ : IsPGroup 2 (center (twoCoreComponent K)))
    (hm : ClassicalGroup.IsPSL
        (twoCoreComponent K ⧸ center (twoCoreComponent K)) 3 (2 ^ n) ∨
      ClassicalGroup.IsPSp
        (twoCoreComponent K ⧸ center (twoCoreComponent K)) 2 (2 ^ n))
    (a : H) (ha : orderOf a = p) (haK : a ∉ K) (hgen : K ⊔ zpowers a = ⊤) :
    Alternatives p K := by
  let : Fact p.Prime := ⟨hp⟩
  let f := QuotientGroup.mk' (pCore 2 H)
  have hc : Nat.Coprime p (Nat.card f.ker) := by
    rw [QuotientGroup.ker_mk']
    obtain ⟨m, hm⟩ := (pCore_isPGroup (p := 2) (G := H)).exists_card_eq
    rw [hm]
    exact (Nat.coprime_two_right.mpr ho).pow_right m
  have hra : 1 < primeRank p (twoCoreComponent K) := by
    rwa [twoCore_rank hK ho]
  have ha' := twoCore_actor hp ho a ha haK
  obtain ⟨hp3, hcong, hlin, hpg⟩ := ordinary_binary_projective (twoCore_sqtk hH)
    (twoCore_isComponent hK) hZ hn hp ho hra hd hm (f a) ha'.1 ha'.2 (twoCore_join a hgen)
  apply Or.inr ∘ Or.inl
  refine ⟨hp3, false, 2 ^ n, hcong, ?_, Or.inl ?_⟩
  · exact hlin.of_mulEquiv (starComponentEquiv p f (QuotientGroup.mk'_surjective _) hc K)
  · cases hp3
    obtain ⟨F, _, _, hF, ⟨eF⟩⟩ := hpg
    exact ⟨F, inferInstance, inferInstance, hF,
      ⟨(starResidualEquiv 3 f (QuotientGroup.mk'_surjective _) hc).trans eF⟩⟩

theorem alternatives_of_binary_model
    (hH : IsSQTK KnownSimple.IsKnownSimple H)
    {K : Subgroup H} [K.Normal] (hK : K.IsCComponent)
    [IsQuasisimple (K ⧸ pCore 2 K)]
    {p : ℕ} (hp : p.Prime) (ho : Odd p) (hr : 1 < primeRank p K)
    (hm : BinaryModel (K ⧸ pCore 2 K) p)
    (a : H) (ha : orderOf a = p) (haK : a ∉ K) (hgen : K ⊔ zpowers a = ⊤) :
    Alternatives p K := by
  obtain ⟨hz, n, hn, hd, hmod⟩ := hm.of_mulEquiv (twoCoreComponentEquiv hK)
  exact alternatives_of_binary_twoCore_model hH hK hn hp ho hr hd hz hmod a ha haK hgen

end CFSG.Quasithin.ChapterA.Section03.OddPrime.SourceModels.NormalSplitPrime
