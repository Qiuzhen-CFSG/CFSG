module

public import CFSG.Quasithin.ChapterA.Section03.OddPrime.SourceModels
public import Theory.SpecificGroups.SymplecticFour.OddFieldActors.Exclusion
public import Theory.GroupAction.ComponentRankAction.ResidualSource

/-!
# The odd-prime residual of an original binary symplectic component

The actual split torus gives the component full p-rank. Its central two-kernel
is p-prime, so rank forces normality and bounds the rank of its literal
conjugation image. The complete symplectic field-actor theorem makes every
p-element in this image inner. Coprime-kernel absorption then identifies the
original component both with O^{p′}(H) and with the subgroup generated by
order-p elements. At p = 3 the latter is exactly the source theta(H).

Source: Aschbacher–Smith, A.3.18, pp.51–53, applied on printed p.556 in 2.5.7.
No ambient normality, field-action exclusion or residual identity is assumed.
-/

@[expose] public section
noncomputable section
open Subgroup Theory.GroupTheory
open Theory.GroupAction.ComponentRankAction
open Theory.SpecificGroups.SymplecticFour
namespace CFSG.Quasithin.ChapterA.Section03.OddPrime.SourceModels.SymplecticResidual
variable {H : Type*} [Group H] [Finite H]

/-- The concrete symplectic marking retains both the component and its central kernel. -/
theorem component_eq_primeClosure_and_residual {F : Type*} [Field F] [Finite F]
    (hH : IsSQTK KnownSimple.IsKnownSimple H)
    {L : Subgroup H} (hL : IsComponent H L) (hZ : IsPGroup 2 (center L))
    {n p : ℕ} (hn : 1 < n) (hp : p.Prime) (ho : Odd p)
    (hF : Nat.card F = 2 ^ n) (hd : p ∣ 2 ^ n - 1)
    (e : L ⧸ center L ≃* Sp F) :
    L = closure {x : H | orderOf x = p} ∧ L = primeToResidual p H := by
  let : Fact p.Prime := ⟨hp⟩
  let : CharP F 2 := EvenProjective.charTwo_of_card hF
  let := hL.2
  have hz : Nat.Coprime p (Nat.card (center L)) := by
    obtain ⟨m, hm⟩ := hZ.exists_card_eq
    rw [hm]
    exact (Nat.coprime_two_right.mpr ho).pow_right m
  have hdF : p ∣ Nat.card F - 1 := hF ▸ hd
  have hr : 2 ≤ primeRank p L := by
    have hh := OddFieldActors.split_prime_rank hdF
    rw [← primeRank_congr p e] at hh
    exact hh.trans (primeRank_quotient_le_of_coprime p (center L) hz)
  have hbound := hH.stronglyQuasithin p hp ho
  have hlarge : 2 < Nat.card F := by
    rw [hF]
    exact (by norm_num : 2 = 2 ^ 1) ▸ Nat.pow_lt_pow_right (by decide) hn
  apply Theory.GroupAction.ComponentRankAction.component_eq_primeClosure_and_residual
    hL hz hr hbound e
  intro a ha m hm
  exact OddFieldActors.primePower_actor_inner hlarge ho hdF (action L e).range
    (inner_le_range L e) (range_rank_le_two L e hz hr hbound) a ha ⟨m, hm⟩

/-- The original PSp₄ model, using the canonical central quotient equivalence in characteristic two. -/
theorem component_eq_primeClosure_and_residual_of_model
    (hH : IsSQTK KnownSimple.IsKnownSimple H)
    {L : Subgroup H} (hL : IsComponent H L) (hZ : IsPGroup 2 (center L))
    {n p : ℕ} (hn : 1 < n) (hp : p.Prime) (ho : Odd p) (hd : p ∣ 2 ^ n - 1)
    (hm : ClassicalGroup.IsPSp (L ⧸ center L) 2 (2 ^ n)) :
    L = closure {x : H | orderOf x = p} ∧ L = primeToResidual p H := by
  obtain ⟨F, _, _, hF, ⟨e⟩⟩ := hm
  let : CharP F 2 := EvenProjective.charTwo_of_card hF
  exact component_eq_primeClosure_and_residual hH hL hZ hn hp ho hF hd
    (e.trans EvenProjective.equiv.symm)

/-- The source theta convention is retained at three, and O^{p′} at the other primes. -/
theorem component_eq_source_theta
    (hH : IsSQTK KnownSimple.IsKnownSimple H)
    {L : Subgroup H} (hL : IsComponent H L) (hZ : IsPGroup 2 (center L))
    {n p : ℕ} (hn : 1 < n) (hp : p.Prime) (ho : Odd p) (hd : p ∣ 2 ^ n - 1)
    (hm : ClassicalGroup.IsPSp (L ⧸ center L) 2 (2 ^ n)) :
    L = if p = 3 then theta H else primeToResidual p H := by
  have h := component_eq_primeClosure_and_residual_of_model hH hL hZ hn hp ho hd hm
  split_ifs with he
  · subst p
    exact h.1
  · exact h.2

end CFSG.Quasithin.ChapterA.Section03.OddPrime.SourceModels.SymplecticResidual
