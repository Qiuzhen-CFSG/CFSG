module
public import CFSG.Quasithin.ChapterA.Section01.RankActions.SourceActions
public import CFSG.Quasithin.ChapterA.Section01.SectionRank
public import Theory.Quasithin.Rank

/-!
# Odd-core action detected by a large elementary two-subgroup

In a quasithin group an elementary two-subgroup of order greater than eight
forces every odd-prime core to have rank at most two, by A.1.28. When that
subgroup is generated by its commutators with a two-perfect actor, A.1.26
then makes it centralize the entire odd core. Only quasithinness is used.

Source: Aschbacher--Smith, A.1.26 and A.1.28, printed pp.25--26;
the six-dimensional specialization is the odd-core step of 4.4.8, p.620.
-/

public section
open Subgroup
namespace CFSG.Quasithin.ChapterA
variable {H:Type*} [Group H] [Finite H]

/-- A large elementary two-subgroup bounds every normal odd-prime core rank. -/
theorem odd_core_rank_of_large_elementary
    (hqt:IsQuasithin H) (V:Subgroup H) [IsElementaryAbelian 2 V]
    (hcard:8<Nat.card V) (p:ℕ) [Fact p.Prime] (hp:Odd p) :
    primeRank p (pCore p H)≤2 := by
  have hrank:3<primeRank 2 H:=by
    by_contra hn
    have hc:Nat.card V≤2^3:=
      (primeRank_le_iff_elementary_card_le H).mp (not_lt.mp hn) V inferInstance
    norm_num at hc
    omega
  exact lemma_A_1_28_core_rank_le_two hp
    ((isQuasithin_iff_twoLocalPrimeRank.mp hqt) p Fact.out hp) hrank

/-- A commutator-generated elementary subgroup of order greater than eight
centralizes the odd core under the genuine local rank bounds. -/
theorem large_elementary_commutator_centralizes_oddCore
    (hqt:IsQuasithin H) (X V:Subgroup H) (hX:IsPPerfect 2 X)
    [IsElementaryAbelian 2 V] (hcard:8<Nat.card V) (hcomm:V=⁅V,X⁆) :
    ⁅V,pPrimeCore 2 H⁆=⊥ := by
  have hV:IsPGroup 2 V:=IsElementaryAbelian.isPGroup 2 V
  let : Fact (IsPGroup 2 V):=⟨hV⟩
  exact lemma_A_1_26_1 X V ((pResidual_eq_top_iff 2 X).mpr hX) hV hcomm
    (frattini_eq_bot_of_isElementaryAbelian (R:=V) (p:=2))
    (fun p _ hp=>odd_core_rank_of_large_elementary hqt V hcard p hp)
end CFSG.Quasithin.ChapterA
