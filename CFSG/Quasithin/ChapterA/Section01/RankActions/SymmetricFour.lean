module

public import CFSG.Quasithin.ChapterA.Section01.RankActions.SourceActions
public import Theory.GroupTheory.PResidual.PrimeToPerfect
public import Theory.GroupTheory.Fitting.PrimeComplementCentralizer
public import Theory.SpecificGroups.SymmetricSix.Parabolics.TwoCores.Duad.Calculation

/-!
# Symmetric-four actors in a solvable group with trivial two-core

The Klein four in S₄ is generated by its commutators with O^{3′}(S₄).
A.1.26 therefore makes its image centralize the odd core whenever every
odd prime core has rank at most two. In a solvable group with trivial
two-core the odd core is self-centralizing, so the Klein four is killed.
The homomorphism need not be injective or surjective.

The actual consumer is the action of C_L(z) in H/C_H(V_H) in the
A₆-block argument of Aschbacher–Smith 13.4.8, printed p.904.
The elementary residual-action input A.1.26 is proved in SourceActions.
-/

public noncomputable section
namespace CFSG.Quasithin.ChapterA.RankActions
open Subgroup Theory.GroupTheory
open scoped commutatorElement
open Theory.SpecificGroups.SymmetricSix

private theorem symmetricFour_core_moved :
    ⁅pCore 2 (Equiv.Perm (Fin 4)),primeToResidual 3 (Equiv.Perm (Fin 4))⁆ =
      pCore 2 (Equiv.Perm (Fin 4)) := by
  let a : Equiv.Perm (Fin 4) := Equiv.swap 0 1 * Equiv.swap 1 2
  let c : Equiv.Perm (Fin 4) := Equiv.swap 0 1 * Equiv.swap 2 3
  have ha : a ∈ primeToResidual 3 (Equiv.Perm (Fin 4)) :=
    mem_primeToResidual_of_pow (n := 1) (by decide)
  have hc : c ∈ pCore 2 (Equiv.Perm (Fin 4)) := by
    rw [← DuadCalculation.core_eq,DuadCalculation.core_mem_iff]
    decide
  have hn : ⁅pCore 2 (Equiv.Perm (Fin 4)),primeToResidual 3 (Equiv.Perm (Fin 4))⁆ ≠ ⊥ := by
    intro he
    have hm := commutator_mem_commutator hc ha
    rw [he,mem_bot] at hm
    exact (by decide : ⁅c,a⁆ ≠ 1) hm
  exact ((DuadCalculation.normal_subgroup_core _
    (by rw [DuadCalculation.core_eq];exact commutator_le_left _ _)).resolve_left hn).trans
      DuadCalculation.core_eq

/-- A symmetric-four actor in a solvable odd-rank-two group with trivial
 two-core kills its Klein four. This is the A.1.26 step in 13.4.8. -/
theorem symmetricFour_twoCore_le_kernel
    {H : Type*} [Group H] [Finite H] (hsolv : Group.IsSolvable H)
    (hcore : pCore 2 H = ⊥)
    (hrank : ∀ (p : ℕ) [Fact p.Prime], Odd p → primeRank p (pCore p H) ≤ 2)
    (f : Equiv.Perm (Fin 4) →* H) : pCore 2 (Equiv.Perm (Fin 4)) ≤ f.ker := by
  let X := (primeToResidual 3 (Equiv.Perm (Fin 4))).map f
  let P := (pCore 2 (Equiv.Perm (Fin 4))).map f
  let : IsElementaryAbelian 2 (pCore 2 (Equiv.Perm (Fin 4))) :=
    DuadCalculation.core_eq ▸ inferInstance
  let : IsElementaryAbelian 2 P := IsElementaryAbelian.map f
  have hX : IsPPerfect 2 X :=
    (isPPerfect_primeToResidual 3 2 (by decide)).of_surjective
      (f.subgroupMap _) (f.subgroupMap_surjective _)
  have hm : P = ⁅P,X⁆ := by
    dsimp only [P,X]
    rw [← map_commutator,symmetricFour_core_moved]
  have hp : IsPGroup 2 P := IsElementaryAbelian.isPGroup 2 P
  let : Fact (IsPGroup 2 P) := ⟨hp⟩
  have hc : P ≤ centralizer (pPrimeCore 2 H : Set H) :=
    commutator_eq_bot_iff_le_centralizer.mp (ChapterA.lemma_A_1_26_1 X P
      ((pResidual_eq_top_iff 2 X).mpr hX) hp hm
      (frattini_eq_bot_of_isElementaryAbelian (R := P) (p := 2)) hrank)
  have he : P = ⊥ := by
    by_contra hn
    exact not_le_centralizer_pPrimeCore_of_isPGroup 2 hsolv hcore hp hn hc
  exact (Subgroup.map_eq_bot_iff _).mp he

end CFSG.Quasithin.ChapterA.RankActions
