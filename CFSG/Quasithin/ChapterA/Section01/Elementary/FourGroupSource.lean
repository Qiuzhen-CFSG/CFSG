module

public import Theory.GroupAction.FourGroupCoreAction.Kernel
public import Theory.GroupAction.FourGroupCoreAction.QuotientRank

/-!
# The complete four-group core lemma

Let V be a four-group and let Y be generated by the two-cores of the
centralizers of two distinct involutions of V. If each core induces the
transvections centered at its marked involution, Y induces every automorphism
of V. Its kernel is O₂(Y), the product of the two pointwise fixed cores.
The normal closure of either point core in N_G(V) is Y, and the actual quotient
N_G(V)/O₂(Y) is the direct product of the images of Y and C_G(V).
For quasithin G, the latter centralizer has three-rank at most one.

The conjugate-involution argument proves the kernel identity. We supply that
identity to the normalizer quotient and rank calculations, thereby discharging
their extra premise on the original subgroups and quotient map.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*, combined
manuscript of 1 March 2004, Lemma A.1.14(1–4), printed p.23.
-/

public section

open Subgroup

namespace CFSG.Quasithin.ChapterA

variable {G : Type*} [Group G] [Finite G] {V : Subgroup G} {v₁ v₂ : G}

/-- A.1.14(1): the full action, its exact kernel and the literal product of
the two fixed point cores. The product factors retain their printed order. -/
theorem lemma_A_1_14_1 (h : FourGroupCorePair V v₁ v₂) :
    Function.Surjective h.action ∧
    h.action.ker = pCore 2 (FourGroupCorePair.generated v₁ v₂) ∧
    (FourGroupCorePair.generated v₁ v₂).pCoreIn 2 =
      FourGroupCorePair.generated v₁ v₂ ⊓ centralizer (V : Set G) ∧
    ∀ x : G, x ∈ (FourGroupCorePair.generated v₁ v₂).pCoreIn 2 ↔
      ∃ a ∈ FourGroupCorePair.pointKernel V v₁,
        ∃ b ∈ FourGroupCorePair.pointKernel V v₂, a * b = x :=
  ⟨h.action_surjective, h.action_ker_eq_twoCore,
    h.twoCore_eq_generated_inf_centralizer, h.mem_twoCore_iff⟩

/-- The identification with the automorphism group in A.1.14(1) uses the
original action after the canonical projection by O₂(Y). -/
theorem lemma_A_1_14_quotient_action (h : FourGroupCorePair V v₁ v₂) :
    ∃ e : (FourGroupCorePair.generated v₁ v₂ ⧸
      pCore 2 (FourGroupCorePair.generated v₁ v₂)) ≃* MulAut V,
      ∀ y : FourGroupCorePair.generated v₁ v₂,
        e (QuotientGroup.mk' (pCore 2 (FourGroupCorePair.generated v₁ v₂)) y) =
          h.action y := by
  let e := (QuotientGroup.quotientMulEquivOfEq h.action_ker_eq_twoCore.symm).trans
    (QuotientGroup.quotientKerEquivOfSurjective h.action h.action_surjective)
  exact ⟨e, fun _ => rfl⟩

/-- The full four-group action also identifies the source quotient with S₃. -/
theorem lemma_A_1_14_quotient_symmetricThree (h : FourGroupCorePair V v₁ v₂) :
    Nonempty ((FourGroupCorePair.generated v₁ v₂ ⧸
      pCore 2 (FourGroupCorePair.generated v₁ v₂)) ≃* Equiv.Perm (Fin 3)) := by
  let := h.four
  obtain ⟨e, _⟩ := lemma_A_1_14_quotient_action h
  exact ⟨e.trans (IsKleinFour.autEquivPermThree V)⟩

/-- A.1.14(2), with its normal closure inside the actual normalizer.
The earlier `lemma_A_1_14_2` in `Elementary` retains its original statement. -/
theorem lemma_A_1_14_2_source (h : FourGroupCorePair V v₁ v₂) :
    (normalClosure ((FourGroupCorePair.core v₁).subgroupOf
      (normalizer (V : Set G)) : Set (normalizer (V : Set G)))).map
        (normalizer (V : Set G)).subtype = FourGroupCorePair.generated v₁ v₂ ∧
    ((FourGroupCorePair.generated v₁ v₂).subgroupOf
      (normalizer (V : Set G))).Normal :=
  ⟨h.normalClosure_core₁, h.generated_normal⟩

/-- A.1.14(3): the quotient of the original normalizer is the direct product
of the two actual quotient images, and the equivalence is multiplication. -/
theorem lemma_A_1_14_3 (h : FourGroupCorePair V v₁ v₂) :
    let Y := FourGroupCorePair.generated v₁ v₂
    let C := centralizer (V : Set G)
    let M := normalizer (V : Set G)
    let P := Y.pCoreIn 2
    let A := Y.subgroupOf M
    let B := C.subgroupOf M
    let Pm := P.subgroupOf M
    let hPnormG : M ≤ normalizer (P : Set G) :=
      h.normalizer_le_normalizer_generated.trans
        (by
          simpa only [Y, P, pCoreIn] using
            (Subgroup.normalizer_le_normalizer_characteristic_image
              Y (pCore 2 Y)))
    letI : Pm.Normal := normal_subgroupOf_of_le_normalizer hPnormG
    let q : M →* (M ⧸ Pm) := QuotientGroup.mk' Pm
    ∃ e : A.map q × B.map q ≃* (M ⧸ Pm),
      ∀ a b, (e (a, b) : M ⧸ Pm) = (a : M ⧸ Pm) * (b : M ⧸ Pm) :=
  h.quotient_directProduct h.twoCore_eq_generated_inf_centralizer

/-- A.1.14(4), under precisely the additional quasithin hypothesis. -/
theorem lemma_A_1_14_4 (h : FourGroupCorePair V v₁ v₂) (hG : IsQuasithin G) :
    primeRank 3 (centralizer (V : Set G)) ≤ 1 :=
  h.primeRank_three_centralizer_quotient_le_one
    h.twoCore_eq_generated_inf_centralizer hG

end CFSG.Quasithin.ChapterA
