module
public import Theory.GroupTheory.PGroup.ExtraspecialAutomorphisms
public import Theory.GroupTheory.PGroup.ClassTwoOmegaGenerated
public import Theory.GroupTheory.PGroup.SL2OmegaObstruction
public import Theory.GroupTheory.PrimeRankElementary
public import CFSG.Quasithin.ChapterA.Section01.PStructure.Homocyclic
public import CFSG.Quasithin.ChapterA.Section01.PStructure.RankTwo

/-!
# Extraspecial automorphisms and small p-group structure

This module assembles the p-group structure lemmas A.1.23, A.1.24 and
A.1.30 of Aschbacher–Smith, *The Classification of Quasithin Groups*,
printed pp.25 and 27.

A.1.23 follows from the perfect commutator pairing of the central quotient
with the center. For A.1.24, the odd-prime class-two collection formula gives
exponent p; the rank bound gives order at most p³, and recognition supplies
the elementary plane or the concrete prime Heisenberg group. For A.1.30,
the homocyclic displacement calculation gives fixation of first omega.
The restriction kernel is a p-group, so transvection generation and the
central involution exclude an SL₂(p) subgroup.
-/

namespace CFSG.Quasithin.ChapterA

/-- A.1.23: the inner automorphism group is precisely the kernel of the
automorphism action on the Frattini quotient. -/
public theorem lemma_A_1_23 {p : ℕ} [Fact p.Prime]
    {P : Type*} [Group P] [Finite P] [IsExtraspecial p P] :
    (MulAut.conj : P →* MulAut P).range =
      (Subgroup.quotientAut (frattini P)).ker :=
  (IsExtraspecial.quotientAut_frattini_ker_eq_range_conj (p := p)).symm

/-- The exponent assertion in the proof of A.1.24. -/
public theorem lemma_A_1_24_exponent {p : ℕ} [Fact p.Prime]
    {P : Type*} [Group P] [Finite P] (hp : p ≠ 2)
    (homega : omega₁ P (p := p) = ⊤)
    (hclass : _root_.commutator P ≤ Subgroup.center P) (hrank : primeRank p P = 2) :
    Monoid.exponent P = p := by
  have hn : Nontrivial P := by
    by_contra h
    let : Subsingleton P := not_nontrivial_iff_subsingleton.mp h
    have hr : primeRank p P ≤ 0 :=
      (primeRank_le_iff_elementary_card_le P).mpr (fun E _ => by simp)
    omega
  let : Nontrivial P := hn
  exact exponent_eq_prime_of_omega_one_eq_top hp hclass homega

/-- A.1.24: an odd-prime p-group generated by first omega, of prime rank two
and class at most two, is the elementary plane or the extraspecial prime
Heisenberg group. The alternatives include genuine group isomorphisms and
the corresponding orders. -/
public theorem lemma_A_1_24 {p : ℕ} [Fact p.Prime]
    {P : Type*} [Group P] [Finite P] (hp : p ≠ 2) (hP : IsPGroup p P)
    (homega : omega₁ P (p := p) = ⊤)
    (hclass : _root_.commutator P ≤ Subgroup.center P) (hrank : primeRank p P = 2) :
    (Nat.card P = p ^ 2 ∧
      Nonempty (P ≃* (Multiplicative (ZMod p) × Multiplicative (ZMod p)))) ∨
    (Nat.card P = p ^ 3 ∧ IsExtraspecial p P ∧
      Nonempty (P ≃* HeisenbergPrime p)) :=
  rankTwo_models hp hP (lemma_A_1_24_exponent hp homega hclass hrank) hrank hclass

/-- The order alternatives of A.1.24, without choosing an isomorphism. -/
public theorem lemma_A_1_24_card {p : ℕ} [Fact p.Prime]
    {P : Type*} [Group P] [Finite P] (hp : p ≠ 2) (hP : IsPGroup p P)
    (homega : omega₁ P (p := p) = ⊤)
    (hclass : _root_.commutator P ≤ Subgroup.center P) (hrank : primeRank p P = 2) :
    Nat.card P = p ^ 2 ∨ Nat.card P = p ^ 3 :=
  (lemma_A_1_24 hp hP homega hclass hrank).imp And.left And.left

/-- The SL₂-exclusion deduction used in A.1.30, for any finite abelian
p-group whose order-p automorphisms fix first omega. -/
public theorem no_SL2_of_order_prime_fixes_omega {p : ℕ} [Fact p.Prime]
    {P : Type*} [Group P] [Finite P] [IsMulCommutative P] (hp : 3 < p)
    (hP : IsPGroup p P)
    (hfix : ∀ a : MulAut P, orderOf a = p → ∀ x ∈ omega₁ P (p := p), a x = x)
    (f : Matrix.SpecialLinearGroup (Fin 2) (ZMod p) →* MulAut P) :
    ¬ Function.Injective f :=
  not_injective_SL2_mulAut_of_prime_order_fixes_omega (by omega) hP hfix f

/-- A.1.30: for p > 3, every order-p automorphism of C(p²) × C(p²) fixes
first omega, and its automorphism group admits no faithful SL₂(p) embedding.
Both conclusions are transported through the given homocyclic isomorphism. -/
public theorem lemma_A_1_30 {p : ℕ} [Fact p.Prime]
    {P : Type*} [Group P] [Finite P] (hp : 3 < p)
    (e : P ≃* (Multiplicative (ZMod (p ^ 2)) × Multiplicative (ZMod (p ^ 2)))) :
    (∀ a : MulAut P, orderOf a = p → ∀ x ∈ omega₁ P (p := p), a x = x) ∧
      (∀ f : Matrix.SpecialLinearGroup (Fin 2) (ZMod p) →* MulAut P,
        ¬ Function.Injective f) := by
  let : IsMulCommutative P :=
    ⟨⟨fun x y => e.injective (by simp only [map_mul, mul_comm])⟩⟩
  have hP : IsPGroup p P := by
    apply IsPGroup.of_card (n := 4)
    rw [Nat.card_congr e.toEquiv, Nat.card_prod,
      Nat.card_congr (Multiplicative.toAdd : Multiplicative (ZMod (p ^ 2)) ≃ ZMod (p ^ 2)),
      Nat.card_zmod, ← pow_add]
  have hfix := homocyclic_order_prime_fixes_omega hp e
  exact ⟨hfix, fun f => no_SL2_of_order_prime_fixes_omega hp hP hfix f⟩

/-- The literal subgroup exclusion in A.1.30: no subgroup of the homocyclic
automorphism group is isomorphic to SL₂(p). -/
public theorem lemma_A_1_30_no_subgroup {p : ℕ} [Fact p.Prime]
    {P : Type*} [Group P] [Finite P] (hp : 3 < p)
    (e : P ≃* (Multiplicative (ZMod (p ^ 2)) × Multiplicative (ZMod (p ^ 2))))
    (H : Subgroup (MulAut P)) :
    ¬ Nonempty (H ≃* Matrix.SpecialLinearGroup (Fin 2) (ZMod p)) := by
  rintro ⟨f⟩
  exact (lemma_A_1_30 hp e).2 (H.subtype.comp f.symm.toMonoidHom)
    (H.subtype_injective.comp f.symm.injective)

end CFSG.Quasithin.ChapterA
