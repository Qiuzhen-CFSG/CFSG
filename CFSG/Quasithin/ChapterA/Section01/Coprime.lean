module

public import Theory.GroupAction.AbelianCoprimeFullFixedGeneration
public import Theory.GroupTheory.PGroup.Supercritical
public import Theory.GroupTheory.PGroup.SupercriticalExistence
public import Theory.GroupTheory.PGroup.SupercriticalAutomorphisms
public import Theory.GroupTheory.PGroup.SupercriticalRank
public import CFSG.Quasithin.ChapterA.Section01.Coprime.DirectSumObstruction
public import CFSG.Quasithin.ChapterA.Section01.Coprime.ThompsonAB

/-!
# Coprime action and supercritical subgroups in §A.1

The generation assertion of A.1.17 follows from coprime fixed-point generation
after discarding trivial fixed subgroups. The residual Thompson A × B lemma
A.1.18 is re-exported with both its centralization and faithful-restriction
conclusions. Definition A.1.20 is exposed by `IsSupercriticalPSubgroup`.

For A.1.21, the existence construction uses a maximal characteristic
exponent-p subgroup and propagation of central prime roots from the second
center. The ambient commutator condition bounds its class by two. The kernel
on its Frattini quotient is a p-group, giving faithful restriction of every
cyclic p'-automorphism group. Its order-p centralizer condition detects
ambient p-rank greater than one. These results apply to the actual
supercritical conditions, including the strengthened centralizer clause.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*,
printed pp.24–25. The printed direct-sum assertion of A.1.17 for general
abelian r-groups requires correction: C4 acting by inversion on C3 has both
the trivial and the order-two actor subgroup in the indexing family, and
both fixed subgroups equal C3. The generation assertion does not have this
problem.
-/

namespace CFSG.Quasithin.ChapterA

/-- A.1.17: the nontrivial cyclic-quotient fixed subgroups generate the group. -/
public theorem lemma_A_1_17
    {G A : Type*} [Group G] [Finite G] [CommGroup A] [Finite A]
    (r : ℕ) [Fact r.Prime] [Fact (IsPGroup r A)] [MulDistribMulAction A G]
    (hG : Nat.Coprime r (Nat.card G)) :
    (⨆ (B : Subgroup A) (_ : IsCyclic (A ⧸ B))
      (_ : fixedPointSubgroup B G ≠ ⊥), fixedPointSubgroup B G) = ⊤ := by
  apply top_unique
  rw [← iSup_fixedPoints_cyclicQuot_eq_top_of_coprime_abelian_pGroup_action
    (G := G) (A := A) r hG]
  refine iSup_le fun B => iSup_le fun hB => ?_
  by_cases hfix : fixedPointSubgroup B G = ⊥
  · rw [hfix]
    exact bot_le
  · exact le_iSup_of_le B (le_iSup_of_le hB (le_iSup_of_le hfix le_rfl))

/-- A.1.21(1): every finite odd p-group has a supercritical subgroup. -/
public theorem lemma_A_1_21_1
    {p : ℕ} [Fact p.Prime] {P : Type*} [Group P] [Finite P]
    (hP : IsPGroup p P) (hp : Odd p) :
    ∃ X : Subgroup P, IsSupercriticalPSubgroup p X := by
  apply hP.exists_supercriticalPSubgroup
  rintro rfl
  obtain ⟨k, hk⟩ := hp
  omega

/-- A.1.21(2): supercritical subgroups have class at most two. -/
public theorem lemma_A_1_21_2
    {p : ℕ} {P : Type*} [Group P] {X : Subgroup P}
    (hX : IsSupercriticalPSubgroup p X) : Group.nilpotencyClass X ≤ 2 :=
  hX.nilpotencyClass_le_two

/-- A.1.21(3): the cyclic group generated by each p'-automorphism acts
faithfully on the supercritical Frattini quotient, via restriction and the
induced quotient automorphism. -/
public theorem lemma_A_1_21_3
    {p : ℕ} [Fact p.Prime] {P : Type*} [Group P] [Finite P]
    {X : Subgroup P} (hX : IsSupercriticalPSubgroup p X)
    (hP : IsPGroup p P) (hp : Odd p) (a : MulAut P)
    (hcop : Nat.Coprime p (orderOf a)) :
    letI : X.Characteristic := hX.characteristic
    Function.Injective
      (((Subgroup.quotientAut (frattini X)).comp
        (MulAut.characteristic X)).comp (Subgroup.zpowers a).subtype) :=
  hX.injective_cyclic_frattini_action_of_coprime hP hp a hcop

/-- A.1.21(4): a supercritical subgroup detects p-rank greater than one. -/
public theorem lemma_A_1_21_4
    {p : ℕ} [Fact p.Prime] {P : Type*} [Group P] [Finite P]
    {X : Subgroup P} (hX : IsSupercriticalPSubgroup p X)
    (hP : IsPGroup p P) (hp : Odd p) (hr : 1 < primeRank p P) :
    1 < primeRank p X :=
  hX.one_lt_primeRank hP hp hr

/-- A.1.21 with the existence witness and all its asserted consequences.
In particular, no supercritical-existence or automorphism-detection premise
is left to the caller. -/
public theorem lemma_A_1_21
    {p : ℕ} [Fact p.Prime] {P : Type*} [Group P] [Finite P]
    (hP : IsPGroup p P) (hp : Odd p) :
    ∃ (X : Subgroup P) (hX : IsSupercriticalPSubgroup p X),
      Group.nilpotencyClass X ≤ 2 ∧
      (letI : X.Characteristic := hX.characteristic
       ∀ a : MulAut P, Nat.Coprime p (orderOf a) →
         Function.Injective
           (((Subgroup.quotientAut (frattini X)).comp
             (MulAut.characteristic X)).comp (Subgroup.zpowers a).subtype)) ∧
      (1 < primeRank p P → 1 < primeRank p X) := by
  obtain ⟨X, hX⟩ := lemma_A_1_21_1 hP hp
  exact ⟨X, hX, lemma_A_1_21_2 hX, lemma_A_1_21_3 hX hP hp,
    lemma_A_1_21_4 hX hP hp⟩

end CFSG.Quasithin.ChapterA
