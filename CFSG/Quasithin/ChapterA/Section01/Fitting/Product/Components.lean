module

public import CFSG.Quasithin.ChapterA.Section01.Fitting.Characteristic
public import Theory.GroupTheory.GeneralizedFitting.ComponentExclusion
public import Theory.GroupTheory.SylowSubnormalIntersection
public import Theory.GroupTheory.Commutator.CentralizingFactor
public import Theory.GroupTheory.NormalProductProjection
public import FeitThompson.FinalTheorem

/-!
# The component case of A.1.10

A component X cannot lie in the characteristic-two normal factor L,
so it centralizes L. Sylow restriction gives T ∩ X ∈ Syl₂(X), and
quasisimplicity gives X = [T ∩ X, X]. The Dedekind identity
LX = L(M ∩ LX) removes the centralizing L-factor from this commutator,
placing X in M. Characteristic two in M then excludes X.

The Sylow commutator assertion uses the odd-order theorem only to exclude
a central Sylow two-subgroup in a nontrivial quasisimple group.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*,
Lemma A.1.10, printed p.21 (PDF p.32).
-/

public section

open Subgroup Theory.GroupTheory
open scoped Pointwise
namespace CFSG.Quasithin.ChapterA.FittingProduct
variable {G : Type*} [Group G] [Finite G]

/-- A finite quasisimple group is generated by commutators with any Sylow two-subgroup. -/
theorem quasisimple_sylow_commutator [IsQuasisimple G] (S : Sylow 2 G) :
    ⁅(⊤ : Subgroup G), (S : Subgroup G)⁆ = ⊤ := by
  have htop : IsComponent G ⊤ :=
    ⟨IsSubnormal.top, IsQuasisimple.of_mulEquiv Subgroup.topEquiv.symm⟩
  rcases htop.commutator_dichotomy (S : Subgroup G) with hb | he
  · have hsc : (S : Subgroup G) ≤ center G :=
      commutator_top_left_eq_bot_iff_le_center.mp hb
    let q := QuotientGroup.mk' (center G)
    let Sbar := S.mapSurjective (f := q) (QuotientGroup.mk'_surjective _)
    have hbar : (Sbar : Subgroup (G ⧸ center G)) = ⊥ := by
      change (S : Subgroup G).map q = ⊥
      apply (Subgroup.map_eq_bot_iff _).mpr
      simpa only [q, QuotientGroup.ker_mk'] using hsc
    have hodd : Odd (Nat.card (G ⧸ center G)) := by
      have hi := Sbar.not_dvd_index
      rw [hbar, index_bot] at hi
      exact Nat.not_even_iff_odd.mp (fun h => hi (even_iff_two_dvd.mp h))
    let : IsSimpleGroup (G ⧸ center G) := IsQuasisimple.simple
    let : Group.IsPerfect (G ⧸ center G) :=
      Group.IsPerfect.ofSurjective (QuotientGroup.mk'_surjective _)
    exact (Group.IsPerfect.not_isSolvable (G ⧸ center G)
      (odd_order_theorem _ hodd)).elim
  · exact top_unique ((le_iSup_conjugates (⊤ : Subgroup G) (S : Subgroup G)).trans he.symm.le)

/-- A component centralizing the normal factor of G = LM lies in a supplement M
containing an ambient Sylow two-subgroup. No ambient normality of X is assumed. -/
theorem component_le_supplement (L M X : Subgroup G) [L.Normal]
    (hgen : L ⊔ M = ⊤) (hX : IsComponent G X)
    (hcent : L ≤ centralizer (X : Set G))
    (T : Sylow 2 G) (hTM : (T : Subgroup G) ≤ M) : X ≤ M := by
  let U := (T : Subgroup G) ⊓ X
  obtain ⟨S, hS⟩ := T.exists_subgroupOf_eq_of_subnormal X hX.1
  let := hX.2
  have hfull : ⁅U, X⁆ = X := by
    have h := congrArg (Subgroup.map X.subtype) (quasisimple_sylow_commutator S)
    rw [map_commutator, ← MonoidHom.range_eq_map, range_subtype, hS,
      subgroupOf_map_subtype, commutator_comm] at h
    exact h
  let Y := M ⊓ (L ⊔ X)
  have hLY : L ⊔ Y = L ⊔ X := normal_product_intersection L M X hgen
  have hc : U ≤ centralizer (L : Set G) := inf_le_right.trans
    (le_centralizer_iff.mp hcent)
  have hxprod : ((L ⊔ X : Subgroup G) : Set G) = (X : Set G) * (L : Set G) := by
    ext x
    rw [sup_comm]
    exact mem_sup_of_normal_right
  have hyprod : ((L ⊔ X : Subgroup G) : Set G) = (Y : Set G) * (L : Set G) := by
    rw [← hLY, sup_comm]
    ext x
    exact mem_sup_of_normal_right
  have he : ⁅U, X⁆ = ⁅U, Y⁆ :=
    (commutator_eq_of_product_centralizing_factor hxprod hc).symm.trans
      (commutator_eq_of_product_centralizing_factor hyprod hc)
  rw [← hfull, he]
  exact (Subgroup.commutator_le_sup U Y).trans (sup_le (inf_le_left.trans hTM) inf_le_left)

/-- The component case of A.1.10: characteristic two in both factors excludes
every ambient component. -/
theorem no_component (L M : Subgroup G) [L.Normal]
    (hgen : L ⊔ M = ⊤)
    (hL : generalizedFitting L = pCore 2 L)
    (hM : generalizedFitting M = pCore 2 M)
    (T : Sylow 2 G) (hTM : (T : Subgroup G) ≤ M)
    (X : Subgroup G) (hX : IsComponent G X) : False := by
  have hnL : ¬ X ≤ L := fun h =>
    not_isComponent_of_twoCore ((generalizedFitting_eq_pCore_iff 2).mp hL) _
      (hX.subgroupOf h)
  have hc : L ≤ centralizer (X : Set G) := by
    rcases hX.normal_dichotomy L with h | h
    · exact (hnL h).elim
    · exact le_centralizer_iff.mp (commutator_eq_bot_iff_le_centralizer.mp h)
  exact not_isComponent_of_twoCore ((generalizedFitting_eq_pCore_iff 2).mp hM) _
    (hX.subgroupOf (component_le_supplement L M X hgen hX hc T hTM))
end CFSG.Quasithin.ChapterA.FittingProduct
