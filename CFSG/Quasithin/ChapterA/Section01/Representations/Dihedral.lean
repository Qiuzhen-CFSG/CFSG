module

public import Theory.Representation.BinaryDihedralSplitting
public import Mathlib.GroupTheory.SpecificGroups.Dihedral
public import Theory.Comparator.Defs

/-!
# The binary dihedral decomposition, A.1.44

For a faithful finite-dimensional binary module of a finite dihedral group
of twice odd order, generated by the distinct involutions `t` and `u`, put
`x = t * u` and `W = [V,x]`. Then `V = W ⊕ C_V(x)`,
`W = [W,t] ⊕ [W,u]`, and `C_W(t) = [W,t]`.

The group is identified with an actual `DihedralGroup n`, with `n` odd.
Every involution is a reflection, so their product is a rotation of odd
order. The reusable binary decomposition then applies to the original
operators `t`, `u`, and their product. The source's faithfulness, generation,
distinctness and finite-dimensionality hypotheses are retained, although
the stronger linear theorem does not need them.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*,
1 March 2004 manuscript, Lemma A.1.44, printed p.32 (PDF p.43).
-/

open DihedralGroup
namespace CFSG.Quasithin.ChapterA
variable {G : Type*} [Group G]

private lemma odd_orderOf_product (n : ℕ) (hn : Odd n) (e : G ≃* DihedralGroup n)
    (t u : G) (ht : IsInvolution t) (hu : IsInvolution u) :
    Odd (orderOf (t * u)) := by
  have reflect (g : G) (hg : IsInvolution g) : ∃ i, e g = sr i := by
    cases he : e g with
    | sr i => exact ⟨i, rfl⟩
    | r i =>
      have hs : (r i : DihedralGroup n) ^ 2 = 1 := by
        rw [← he, ← map_pow, hg.2, map_one]
      have hi : i + i = 0 := by
        simpa only [pow_two, r_mul_r, ← r_zero, r.injEq] using hs
      have hi0 : i = 0 := (ZMod.add_self_eq_zero_iff_eq_zero hn).mp hi
      exact (hg.1 (e.injective (by simp [he, hi0]))).elim
  obtain ⟨i, hi⟩ := reflect t ht
  obtain ⟨j, hj⟩ := reflect u hu
  rw [← e.orderOf_eq (t * u), map_mul, hi, hj, sr_mul_sr]
  apply hn.of_dvd_nat
  apply orderOf_dvd_of_pow_eq_one
  simp

variable {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]

open Representation Representation.BinaryOffender

/-- A.1.44, with each direct sum expressed by ambient subspace complementarity
or by disjointness together with the equality of the supremum to `W`. -/
public theorem lemma_A_1_44 [Finite G] [FiniteDimensional (ZMod 2) V]
    (ρ : Representation (ZMod 2) G V) (_hfaith : Function.Injective ρ)
    (n : ℕ) (hn : Odd n) (hdihedral : Nonempty (G ≃* DihedralGroup n))
    (t u : G) (ht : IsInvolution t) (hu : IsInvolution u) (_htu : t ≠ u)
    (_hgen : Subgroup.zpowers t ⊔ Subgroup.zpowers u = ⊤) :
    let x := t * u
    let W := subspaceCommutator ρ ⊤ (Subgroup.zpowers x)
    IsCompl W (fixedSpace ρ (Subgroup.zpowers x)) ∧
      Disjoint (subspaceCommutator ρ W (Subgroup.zpowers t))
        (subspaceCommutator ρ W (Subgroup.zpowers u)) ∧
      subspaceCommutator ρ W (Subgroup.zpowers t) ⊔
        subspaceCommutator ρ W (Subgroup.zpowers u) = W ∧
      W ⊓ fixedSpace ρ (Subgroup.zpowers t) =
        subspaceCommutator ρ W (Subgroup.zpowers t) := by
  obtain ⟨e⟩ := hdihedral
  exact BinaryDihedralSplitting.splitting_of_odd_product ρ t u
    (by simpa only [pow_two] using ht.2)
    (by simpa only [pow_two] using hu.2)
    (odd_orderOf_product n hn e t u ht hu)

end CFSG.Quasithin.ChapterA
