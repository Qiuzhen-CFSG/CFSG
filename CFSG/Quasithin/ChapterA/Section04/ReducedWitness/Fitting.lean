module
public import CFSG.Quasithin.ChapterA.Section04.ReducedWitness.Intrinsic
public import Theory.GroupTheory.Fitting.TwoCoreMonotonicity
public import Theory.GroupTheory.NormalSubgroupCoreQuotient
public import Theory.GroupTheory.PResidual.SylowSupplement
public import Theory.GroupTheory.SolvableRadical.Transport

/-!
# Passing radical centralization from the reduced module to the omega-center

A subnormal subgroup with odd two-core quotient is generated by its
two-residual and its normal Sylow two-subgroup. The residual satisfies the
chief-factor hypothesis of A.4.11, so movement of the ambient omega-center
would imply movement of the reduced subgroup. The Sylow factor lies in
the ambient two-core and already centralizes its omega-center.

The literal Fitting preimage has odd two-core quotient and lies in the
solvable radical. The final theorem retains both inclusions K ≤ M ≤ G.
It supplies the A.4.11 step in 11.4.2, conditional only on the earlier
radical-centralization conclusion; it does not prove source 3.2.14.
Source: Aschbacher--Smith, A.4.11, pp.60--61, and 11.4.2, p.777.
-/

open Subgroup Theory.GroupTheory Stellmacher
public noncomputable section
namespace CFSG.Quasithin.ChapterA.Section04

private theorem chief_of_coprime {A : Type*} [Group A] [Finite A]
    {p : ℕ} [Fact p.Prime] (ho : Nat.Coprime p (Nat.card A)) :
    HasCentralPChiefFactors p A := by
  intro K L hK hL hlt _ hp
  let := hK
  let := hL
  have hc : Nat.card (L ⧸ K.subgroupOf L) = 1 :=
    hp.card_eq_or_dvd.resolve_right (fun hd =>
      (Fact.out : p.Prime).not_dvd_one
        (ho ▸ Nat.dvd_gcd (dvd_refl p)
          (hd.trans ((K.subgroupOf L).index_dvd_card.trans (card_subgroup_dvd_card L)))))
  have he : K.subgroupOf L = ⊤ := index_eq_one.mp hc
  exact (hlt.not_ge (subgroupOf_eq_top.mp he)).elim

/-- Centralization of the reduced module passes to the omega-center for
subnormal subgroups with odd two-core quotient. -/
theorem centralizes_omegaCenter_of_reduced_of_odd_core_quotient {G : Type*} [Group G] [Finite G] (B : Subgroup G)
    (hB : B.IsSubnormal) (ho : Nat.Coprime 2 (Nat.card (B ⧸ pCore 2 B)))
    (hc : B ≤ centralizer (reducedTwoSubgroup G : Set G)) :
    B ≤ centralizer (omegaOneCenterAmbient (pCore 2 G) : Set G) := by
  let P := pResidual 2 B
  let X := P.map B.subtype
  let e : P ≃* X := P.equivMapOfInjective B.subtype B.subtype_injective
  have hX : X.IsSubnormal := (inferInstance : P.Normal).isSubnormal.trans' hB
  have hp : IsPPerfect 2 X :=
    (isPPerfect_pResidual 2).of_surjective e.toMonoidHom e.surjective
  have hxodd : Nat.Coprime 2 (Nat.card (X ⧸ pCore 2 X)) := by
    let eq := QuotientGroup.congr _ _ e (pCore_map_iso 2 e)
    rw [← Nat.card_congr eq.toEquiv,
      Nat.card_congr (coreQuotientEquivImage 2 P).toEquiv]
    exact ho.of_dvd_right (card_subgroup_dvd_card _)
  have hchief : HasCentralPChiefFactorsAbove 2 (pCore 2 X) :=
    (hasCentralPChiefFactorsAbove_iff_quotient _).mpr (chief_of_coprime hxodd)
  have hx : X ≤ centralizer (omegaOneCenterAmbient (pCore 2 G) : Set G) := by
    apply commutator_eq_bot_iff_le_centralizer.mp
    by_contra hm
    have hm' : ⁅omegaOneCenterAmbient (pCore 2 G), X⁆ ≠ ⊥ := by
      rwa [commutator_comm]
    have hr := (reduced_witness_of_omegaCenter_moved X hX hp hchief hm').2
    exact hr (commutator_eq_bot_iff_le_centralizer.mpr
      (le_centralizer_iff.mpr ((map_subtype_le P).trans hc)))
  have hi : ¬ 2 ∣ (pCore 2 B).index := Nat.prime_two.coprime_iff_not_dvd.mp ho
  let S : Sylow 2 B := (pCore_isPGroup (p := 2) (G := B)).toSylow hi
  have hgen := congrArg (Subgroup.map B.subtype) (pResidual_sup_sylow_eq_top S)
  rw [Subgroup.map_sup, ← MonoidHom.range_eq_map, range_subtype] at hgen
  rw [← hgen]
  refine sup_le hx ?_
  intro b hb w hw
  exact ((mem_omegaOneCenterAmbient_iff _ _).mp hw).2.2 b
    (pCoreIn_le_of_subnormal 2 hB hb) |>.symm

/-- The actual two-Fitting preimage centralizes the omega-center when the
solvable radical centralizes the reduced subgroup. -/
theorem twoFittingCore_centralizes_omegaCenter_of_radical_reduced {G : Type*} [Group G] [Finite G] (J : Subgroup G)
    (hJ : J.IsSubnormal)
    (hc : (solvableRadical J).map J.subtype ≤ centralizer (reducedTwoSubgroup G : Set G)) :
    (twoFittingCore J).map J.subtype ≤ centralizer (omegaOneCenterAmbient (pCore 2 G) : Set G) := by
  let F := twoFittingCore J
  let B := F.map J.subtype
  let e : F ≃* B := F.equivMapOfInjective J.subtype J.subtype_injective
  have hB : B.IsSubnormal := (inferInstance : F.Normal).isSubnormal.trans' hJ
  have ho : Nat.Coprime 2 (Nat.card (B ⧸ pCore 2 B)) := by
    let eq := QuotientGroup.congr _ _ e (pCore_map_iso 2 e)
    rw [← Nat.card_congr eq.toEquiv, Nat.card_congr (coreQuotientEquivImage 2 F).toEquiv]
    have he : F.map (QuotientGroup.mk' (pCore 2 J)) = fittingSubgroup (J ⧸ pCore 2 J) :=
      map_comap_eq_self_of_surjective (QuotientGroup.mk'_surjective _) _
    rw [he]
    exact (pPrimeCore_coprime_card (p := 2) (G := J ⧸ pCore 2 J)).of_dvd_right
      (card_dvd_of_le (fitting_le_pPrimeCore_of_pCore_eq_bot 2 (pCore_quotient_pCore_eq_bot 2)))
  have hBC : B ≤ centralizer (reducedTwoSubgroup G : Set G) :=
    (map_mono (le_solvableRadical F inferInstance twoFittingCore_solvable)).trans hc
  exact centralizes_omegaCenter_of_reduced_of_odd_core_quotient B hB ho hBC

/-- The same implication in a relative overgroup, with the original
subgroup inclusion maps and ambient omega-center preserved. -/
theorem embedded_twoFittingCore_centralizes_omegaCenter_of_radical_reduced {G : Type*} [Group G] [Finite G] (K M : Subgroup G)
    (hKM : K ≤ M) (hsub : (K.subgroupOf M).IsSubnormal)
    (hc : (solvableRadical K).map K.subtype ≤
      centralizer ((reducedTwoSubgroup M).map M.subtype : Set G)) :
    (twoFittingCore K).map K.subtype ≤
      centralizer (omegaOneCenterAmbient (M.pCoreIn 2) : Set G) := by
  let B := K.subgroupOf M
  let e : B ≃* K := subgroupOfEquivOfLe hKM
  have hrad : (solvableRadical B).map B.subtype ≤
      centralizer (reducedTwoSubgroup M : Set M) := by
    rintro b ⟨a,ha,rfl⟩ w hw
    have hr : e a ∈ solvableRadical K :=
      (map_solvableRadical_equiv e) ▸ mem_map_of_mem e.toMonoidHom ha
    exact Subtype.ext (hc (mem_map_of_mem K.subtype hr) w.val
      (mem_map_of_mem M.subtype hw))
  have hf := twoFittingCore_centralizes_omegaCenter_of_radical_reduced B hsub hrad
  change (twoFittingCore K).map K.subtype ≤
    centralizer (omegaOneCenterAmbient ((pCore 2 M).map M.subtype) : Set G)
  rw [omegaOneCenterAmbient_map_injective M.subtype M.subtype_injective]
  rintro k ⟨a,ha,rfl⟩ w ⟨b,hb,rfl⟩
  have hF : e.symm a ∈ twoFittingCore B :=
    twoFittingCore_map_equiv_le e.symm (mem_map_of_mem e.symm.toMonoidHom ha)
  exact congrArg Subtype.val (hf (mem_map_of_mem B.subtype hF) b hb)

end CFSG.Quasithin.ChapterA.Section04
