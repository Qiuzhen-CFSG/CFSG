module
public import CFSG.Quasithin.ChapterD.Section02.StarredConjugacy
public import Theory.GroupTheory.SylowNormalGenerationFrattini

/-!
# Generation of the symmetric-three pair at cubic ratio three halves

A minimum cubic actor in a group of order36 has order two or four. Its
ratio three halves rules out order two, so it is a Sylow two-subgroup.
The starred core is normal and contains this Sylow. Since a product of
symmetric groups is generated by involutions, its Sylow normal closure is
the whole group. This proves generation for transported natural Omega-four
actions without substituting an ambient module.

Source: Aschbacher--Smith15.1.7(3) and15.1.13(4), pp.1087,1091.
-/

public section
open Subgroup Representation Representation.BinaryOffender
open scoped ENNReal
namespace CFSG.Quasithin.ChapterD
variable {D V : Type*} [Group D] [Finite D] [AddCommGroup V] [Module (ZMod 2) V]
  [FiniteDimensional (ZMod 2) V]

theorem Jhat_eq_top_of_symmetricThree_pair_ratio
    (ρ : Representation (ZMod 2) D V)
    (e : D ≃* (Equiv.Perm (Fin 3) × Equiv.Perm (Fin 3)))
    (hq : cubicRatio ρ = 3/2) : Jhat ρ = ⊤ := by
  have hD : Nat.card D = 36 := by
    rw [Nat.card_congr e.toEquiv]
    norm_num [Nat.card_prod,Nat.card_eq_fintype_card,Fintype.card_perm,Nat.factorial]
  obtain ⟨A,hA⟩ := (QhatStar_nonempty_iff ρ).mpr (by rw [hq]; norm_num [ENNReal.div_le_iff])
  let : IsElementaryAbelian 2 A := hA.1.2.1.2
  have hpos := hA.1.2.1.rank_pos
  have hcard : Nat.card A ∣ 36 := hD ▸ A.card_subgroup_dvd_card
  have hpow := hA.1.2.1.card_eq_two_pow_rank
  have hcop : Nat.Coprime (Nat.card A) 9 := by
    rw [hpow]
    exact (by decide : Nat.Coprime 2 9).pow_left _
  have hdiv : Nat.card A ∣ 2^2 := hcop.dvd_of_dvd_mul_right hcard
  have hr : rank A ≤ 2 := by
    have hl := Nat.le_of_dvd (by decide : 0 < 2^2) hdiv
    rw [hpow] at hl
    exact (Nat.pow_le_pow_iff_right Nat.one_lt_two).mp hl
  have hr2 : rank A = 2 := by
    by_contra hh
    have hr1 : rank A = 1 := by omega
    have he := hA.1.2.2.2
    rw [actionRatio,hr1,Nat.cast_one,div_one,hq] at he
    have he' : (fixedCodim ρ A : ℝ≥0∞) * 2 = 3 := by
      rw [he]
      exact ENNReal.div_mul_cancel (by norm_num) (by norm_num)
    have hc : fixedCodim ρ A * 2 = 3 := by exact_mod_cast he'
    omega
  have hcA : Nat.card A = 4 := by rw [hpow,hr2]; rfl
  obtain ⟨S,hAS⟩ := (IsElementaryAbelian.isPGroup 2 A).exists_le_sylow
  have hcS : Nat.card S = 4 := by
    have h4 : 4 ∣ Nat.card S := S.pow_dvd_card_of_pow_dvd_card (n := 2) (by rw [hD]; decide)
    obtain ⟨k,hk⟩ := S.isPGroup'.exists_card_eq
    have hcop : Nat.Coprime (Nat.card S) 9 := by
      rw [hk]
      exact (by decide : Nat.Coprime 2 9).pow_left k
    have hdiv : Nat.card S ∣ 4*9 := by change Nat.card S ∣ 36; rw [←hD]; exact card_subgroup_dvd_card _
    exact Nat.dvd_antisymm (hcop.dvd_of_dvd_mul_right hdiv) h4
  have hAe : A = (S : Subgroup D) := eq_of_le_of_card_ge hAS (by rw [hcS,hcA])
  let K := (Jhat ρ).map e.toMonoidHom
  let : (Jhat ρ).Normal := Jhat_normal ρ
  let : K.Normal := Normal.map inferInstance _ e.surjective
  have hSK : ((S : Subgroup D).map e.toMonoidHom) ≤ K := map_mono (hAe ▸ le_sSup hA)
  have hK : K = ⊤ := by
    apply top_unique
    rw [←normalClosure_sylow_eq_top_of_involutions (S.mapSurjective (f := e.toMonoidHom) e.surjective)
      (symmetric_product_involutions_generate (Fin 3) (Fin 3))]
    exact normalClosure_le_normal hSK
  apply (map_injective (f := e.toMonoidHom) e.injective)
  exact hK.trans (map_top_of_surjective e.toMonoidHom e.surjective).symm
end CFSG.Quasithin.ChapterD
