module
public import CFSG.Quasithin.ChapterB.Section02.Thompson.Sylow
public import CFSG.Quasithin.ChapterD.Section02.StarredConjugacy

/-!
# Thompson images generating the starred core

The starred core is normally generated by its intersection with any Sylow
two-subgroup, because its generators are elementary two-groups. The higher
Thompson subgroup of the whole group is the normal closure of the one in a
Sylow subgroup. Hence equality of the Sylow Thompson image with the Sylow
intersection already gives equality of the whole-group image with the core.

Source: Aschbacher--Smith 15.1.13(4), printed p.1091.
-/

public section
open Subgroup Representation Representation.BinaryOffender
namespace CFSG.Quasithin.ChapterB
variable {G : Type*} [Group G] [Finite G]

theorem thompsonJ_subgroupOf (M S : Subgroup G) (hSM : S ≤ M) (i : ℕ) :
    thompsonJ (S.subgroupOf M) i = (thompsonJ S i).subgroupOf M := by
  apply map_injective M.subtype_injective
  rw [←thompsonJ_map_injective M.subtype M.subtype_injective,
    map_subgroupOf_eq_of_le hSM,
    map_subgroupOf_eq_of_le ((thompsonJ_le S i).trans hSM)]
end CFSG.Quasithin.ChapterB

namespace CFSG.Quasithin.ChapterD
variable {G D W : Type*} [Group G] [Finite G] [Group D] [Finite D]
  [AddCommGroup W] [Module (ZMod 2) W] [FiniteDimensional (ZMod 2) W]

theorem Jhat_eq_normalClosure_sylow_inf (ρ : Representation (ZMod 2) D W)
    (S : Sylow 2 D) : Jhat ρ = normalClosure ((S : Subgroup D) ⊓ Jhat ρ : Set D) := by
  let : (Jhat ρ).Normal := Jhat_normal ρ
  apply le_antisymm ?_ (normalClosure_le_normal inf_le_right)
  apply sSup_le
  intro A hA
  let : IsElementaryAbelian 2 A := hA.1.2.1.2
  exact (IsElementaryAbelian.isPGroup 2 A).le_normalClosure_sylow_inf S (Jhat ρ)
    inferInstance (le_sSup hA)

theorem thompson_image_eq_Jhat_of_sylow_inf
    (ρ : Representation (ZMod 2) D W) (S : Sylow 2 G)
    (f : G →* D) (hf : Function.Surjective f) (i : ℕ)
    (he : (ChapterB.thompsonJ (S : Subgroup G) i).map f =
      (S : Subgroup G).map f ⊓ Jhat ρ) :
    (ChapterB.thompsonJ (⊤ : Subgroup G) i).map f = Jhat ρ := by
  rw [ChapterB.thompsonJ_top_eq_normalClosure_sylow S i,map_normalClosure _ f hf]
  change normalClosure ((ChapterB.thompsonJ (S : Subgroup G) i).map f : Set D) = _
  rw [he]
  exact (Jhat_eq_normalClosure_sylow_inf ρ (S.mapSurjective hf)).symm
end CFSG.Quasithin.ChapterD
