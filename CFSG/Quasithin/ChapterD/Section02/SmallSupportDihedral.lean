module
public import Theory.Representation.SmallBinaryPrimeNormalizer.SupportedInvolution
public import CFSG.Quasithin.ChapterD.Section02.SmallSupportDecomposition
public import Mathlib.GroupTheory.NoncommPiCoprod

/-!
# Normal products of dihedral groups on the canonical five-supports

A minimal normal subgroup generated by canonical five-factors acts
transitively by ambient conjugation on those factors. A supported reflection
extends one factor to D10. Its normalizer preserves that extension, making
its conjugates a well-defined family indexed by the original canonical
factors. Their supports and fixed complements are unchanged. Cross-fixation
makes the dihedral factors commute and be independent; their literal
multiplication map identifies the product, which is normal in the ambient
group. The factor normalizers agree with those of their five-subgroups.

Source: Aschbacher–Smith, D.2.12–17 and 14.7.6, printed pp.183–187 and1044,
refs/quasithin.pdf. The ambient exclusions in 14.7.6 require further geometry.
-/

public noncomputable section
open Subgroup
open scoped IsMulCommutative
namespace CFSG.Quasithin.ChapterD
variable {G V : Type*} [Group G] [Finite G] [Group V] [Finite V]
  [IsElementaryAbelian 2 V] [MulDistribMulAction G V] [FaithfulSMul G V]

/-- The factors have their literal canonical supports and ambient conjugation action. -/
structure CanonicalFiveDihedralFamily where
  factor : smallSupportFactors G V 2 → Subgroup G
  contains : ∀ i, i.val ≤ factor i
  model : ∀ i, Nonempty (factor i ≃* DihedralGroup 5)
  support : ∀ i, commutatorAction (factor i) V = commutatorAction i.val V
  fixed : ∀ i, FixedPoints.subgroup i.val V ≤ FixedPoints.subgroup (factor i) V
  permuted : ∀ g i, (factor i).conjBy g = factor (smallSupportFactors_conjEquiv 2 g i)
  independent : iSupIndep factor
  commute : Pairwise fun i j => ∀ x y : G, x ∈ factor i → y ∈ factor j → Commute x y

omit [Finite G] [Finite V] [IsElementaryAbelian 2 V] [FaithfulSMul G V] in
private theorem fixed_conjugate {C D : Subgroup G}
    (h : FixedPoints.subgroup C V ≤ FixedPoints.subgroup D V) (g : G) :
    FixedPoints.subgroup (C.conjBy g) V ≤ FixedPoints.subgroup (D.conjBy g) V := by
  intro v hv d
  obtain ⟨a,ha,he⟩ := d.property
  have hv' : g⁻¹ • v ∈ FixedPoints.subgroup C V := by
    intro c
    have hh := hv ⟨g * c * g⁻¹,mem_map.mpr ⟨c,c.property,rfl⟩⟩
    change (g * (c : G) * g⁻¹) • v = v at hh
    change (c : G) • (g⁻¹ • v) = g⁻¹ • v
    have hh' := congrArg (fun w : V => g⁻¹ • w) hh
    simpa only [mul_smul,inv_smul_smul] using hh'
  have hh := congrArg (fun w : V => g • w) (h hv' ⟨a,ha⟩)
  change g • (a • (g⁻¹ • v)) = g • (g⁻¹ • v) at hh
  change (d : G) • v = v
  rw [←he]
  change (g * a * g⁻¹) • v = v
  simpa only [mul_smul,smul_inv_smul] using hh

/-- Minimality makes all the canonical five-factors conjugate. -/
theorem canonical_five_conjugate_of_minimal
    (X : Subgroup G) [X.Normal]
    (hgen : smallSupportGroup G V 2 = X)
    (hmin : ∀ N : Subgroup G, N.Normal → N ≤ X → N = ⊥ ∨ N = X)
    (C : smallSupportFactors G V 2) :
    ∀ i : smallSupportFactors G V 2, ∃ g : G, C.val.conjBy g = i.val := by
  have hCX : C.val ≤ X := hgen ▸ le_sSup C.property
  have hne : normalClosure (C.val : Set G) ≠ ⊥ := by
    intro he
    have hh : C.val = ⊥ := bot_unique (le_normalClosure.trans he.le)
    have hc := C.property.2.1
    rw [hh,card_bot] at hc
    norm_num at hc
  have hfull : normalClosure (C.val : Set G) = X :=
    (hmin _ inferInstance (normalClosure_le_normal hCX)).resolve_left hne
  intro i
  by_contra hn
  have hle : normalClosure (C.val : Set G) ≤ ⨆ j : smallSupportFactors G V 2,
      ⨆ (_ : j ≠ i), j.val := by
    apply (closure_le _).mpr
    intro x hx
    obtain ⟨c,hc,hcx⟩ := Group.mem_conjugatesOfSet_iff.mp hx
    obtain ⟨g,rfl⟩ := isConj_iff.mp hcx
    let j : smallSupportFactors G V 2 := ⟨C.val.conjBy g,smallSupportFactors_conjBy C.property g⟩
    have hji : j ≠ i := fun he => hn ⟨g,congrArg Subtype.val he⟩
    have hjle : j.val ≤ ⨆ j : smallSupportFactors G V 2, ⨆ (_ : j ≠ i), j.val :=
      le_iSup₂_of_le j hji le_rfl
    exact hjle (mem_map.mpr ⟨c,hc,rfl⟩)
  have hiX : i.val ≤ X := hgen ▸ le_sSup i.property
  have hb : i.val = ⊥ := bot_unique (by
    rw [←hfull] at hiX
    exact (le_inf le_rfl (hiX.trans hle)).trans
      ((smallSupport_decomposition (G := G) (V := V) (Or.inr rfl)).1 i).le_bot)
  have hc := i.property.2.1
  rw [hb,card_bot] at hc
  norm_num at hc

/-- A supported reflection extends the whole minimal canonical family to dihedral factors. -/
theorem canonical_five_dihedral_family
    (X : Subgroup G) [X.Normal]
    (hgen : smallSupportGroup G V 2 = X)
    (hmin : ∀ N : Subgroup G, N.Normal → N ≤ X → N = ⊥ ∨ N = X)
    (C : smallSupportFactors G V 2) (R : Subgroup G) (hR : Nat.card R = 2)
    (hn : R ≤ normalizer (C.val : Set G))
    (hfix : FixedPoints.subgroup C.val V ≤ FixedPoints.subgroup R V) :
    ∃ f : CanonicalFiveDihedralFamily (G := G) (V := V), f.factor C = C.val ⊔ R := by
  classical
  let D := C.val ⊔ R
  obtain ⟨⟨e⟩,hND⟩ := SmallBinaryPrimeNormalizer.supported_dihedral_normalizer
    C.val R C.property.2.1 hR hn hfix C.property.2.2
  obtain ⟨hFD,hUD⟩ := SmallBinaryPrimeNormalizer.supported_join_support C.val R C.property.2.1 hn hfix
  have hc := canonical_five_conjugate_of_minimal X hgen hmin C
  choose g hg using hc
  let F (i : smallSupportFactors G V 2) := D.conjBy (g i)
  have hwell (a b : G) (h : C.val.conjBy a = C.val.conjBy b) : D.conjBy a = D.conjBy b := by
    have hnC : a⁻¹ * b ∈ normalizer (C.val : Set G) :=
      mem_normalizer_iff_map_conj_eq.mpr (conjBy_inv_mul_cancel C.val h)
    have hnD : D.conjBy (a⁻¹ * b) = D := mem_normalizer_iff_map_conj_eq.mp (hND hnC)
    have hh := congrArg (fun E : Subgroup G => E.conjBy a) hnD
    simpa only [conjBy_conjBy,mul_inv_cancel_left] using hh.symm
  have hsupport (i) : commutatorAction (F i) V = commutatorAction i.val V := by
    rw [←hg i,←ActionSupport.commutatorAction_conjBy,←ActionSupport.commutatorAction_conjBy,hUD]
  have hfixed (i) : FixedPoints.subgroup i.val V ≤ FixedPoints.subgroup (F i) V := by
    rw [←hg i]
    exact fixed_conjugate hFD (g i)
  have hcross (i j : smallSupportFactors G V 2) (hne : i ≠ j) :
      commutatorAction (F j) V ≤ FixedPoints.subgroup (F i) V := by
    rw [hsupport]
    exact (smallSupportFactors_cross_fixed (Or.inr rfl) i.property j.property
      (fun he => hne (Subtype.ext he))).trans (hfixed i)
  have hind : iSupIndep F := by
    rw [iSupIndep_def]
    intro i
    rw [Subgroup.disjoint_def]
    intro x hxi hxrest
    have hrest : (⨆ j, ⨆ (_ : j ≠ i), F j) ≤
        fixingSubgroup G (commutatorAction (F i) V : Set V) := by
      refine iSup_le fun j => iSup_le fun hji => ?_
      intro y hy
      exact (mem_fixingSubgroup_iff G).mpr (fun v hv => hcross j i hji hv ⟨y,hy⟩)
    have hxU := (mem_fixingSubgroup_iff G).mp (hrest hxrest)
    have hs := ActionSupport.fixed_support_isCompl i.val
      (smallSupportFactor_coprime (Or.inr rfl) i.property)
    apply FaithfulSMul.eq_of_smul_eq_smul (α := V)
    intro v
    obtain ⟨a,ha,b,hb,rfl⟩ := Subgroup.mem_sup.mp
      (show v ∈ FixedPoints.subgroup i.val V ⊔ commutatorAction i.val V from hs.sup_eq_top ▸ mem_top v)
    have hxF : x • a = a := hfixed i ha ⟨x,hxi⟩
    have hxB := hxU b ((hsupport i).symm ▸ hb)
    simp only [smul_mul',one_smul,hxF,hxB]
  refine ⟨⟨F,?_,?_,hsupport,hfixed,?_,hind,?_⟩,?_⟩
  · intro i
    rw [←hg i]
    exact map_mono le_sup_left
  · intro i
    exact ⟨(D.equivMapOfInjective (MulAut.conj (g i)).toMonoidHom
      (MulAut.conj (g i)).injective).symm.trans e⟩
  · intro a i
    change (D.conjBy (g i)).conjBy a = D.conjBy (g (smallSupportFactors_conjEquiv 2 a i))
    rw [conjBy_conjBy]
    apply hwell
    rw [conjBy_mul,hg,hg]
    rfl
  · intro i j hij x y hx hy
    exact ActionSupport.commute_of_cross_fixed (F i) (F j)
      (hcross i j hij) (hcross j i hij.symm) ⟨x,hx⟩ ⟨y,hy⟩
  · change D.conjBy (g C) = D
    exact (hwell (g C) 1 (by rw [hg,conjBy_one])).trans (conjBy_one D)

namespace CanonicalFiveDihedralFamily
variable (f : CanonicalFiveDihedralFamily (G := G) (V := V))

/-- Distinct canonical supports give distinct dihedral factors. -/
theorem factor_injective : Function.Injective f.factor := by
  intro i j he
  apply smallSupportFactors_support_injective (Or.inr rfl)
  change commutatorAction i.val V = commutatorAction j.val V
  rw [←f.support i,←f.support j,he]

/-- A dihedral factor and its canonical five-factor have the same normalizer. -/
theorem normalizer_factor (i : smallSupportFactors G V 2) :
    normalizer (f.factor i : Set G) = normalizer (i.val : Set G) := by
  ext g
  simp only [mem_normalizer_iff_map_conj_eq]
  change (f.factor i).conjBy g = f.factor i ↔ i.val.conjBy g = i.val
  rw [f.permuted]
  constructor
  · intro he
    exact congrArg Subtype.val (f.factor_injective he)
  · intro he
    exact congrArg f.factor (Subtype.ext he : smallSupportFactors_conjEquiv 2 g i = i)

/-- The normal product uses the literal embedded dihedral factors. -/
@[expose] def product : Subgroup G := ⨆ i, f.factor i

instance product_normal : f.product.Normal := by
  constructor
  intro x hx g
  have hh : f.product ≤ f.product.comap (MulAut.conj g).toMonoidHom := by
    apply iSup_le
    intro i
    apply map_le_iff_le_comap.mp
    change (f.factor i).conjBy g ≤ f.product
    rw [f.permuted]
    exact le_iSup _ _
  exact hh hx

omit [Finite G] [Finite V] [IsElementaryAbelian 2 V] [FaithfulSMul G V] in
theorem core_le_product : smallSupportGroup G V 2 ≤ f.product := by
  rw [smallSupportGroup_eq_iSup]
  exact iSup_mono f.contains

/-- The multiplication isomorphism retains every factor inclusion. -/
def productEquiv : (∀ i, f.factor i) ≃* f.product := by
  classical
  letI : Fintype (smallSupportFactors G V 2) := Fintype.ofFinite _
  let q := noncommPiCoprod f.commute
  exact (MonoidHom.ofInjective (injective_noncommPiCoprod_of_iSupIndep f.independent)).trans
    (MulEquiv.subgroupCongr (noncommPiCoprod_range (hcomm := f.commute)))

omit [Finite V] [IsElementaryAbelian 2 V] [FaithfulSMul G V] in
theorem product_card : Nat.card f.product = 10 ^ Nat.card (smallSupportFactors G V 2) := by
  classical
  let : Fintype (smallSupportFactors G V 2) := Fintype.ofFinite _
  rw [←Nat.card_congr f.productEquiv.toEquiv,Nat.card_pi]
  have hc (i) : Nat.card (f.factor i) = 10 := by
    rw [Nat.card_congr (f.model i).some.toEquiv,DihedralGroup.nat_card]
  simp only [hc,Finset.prod_const,Finset.card_univ,Nat.card_eq_fintype_card]

omit [Finite V] [IsElementaryAbelian 2 V] [FaithfulSMul G V] in
/-- Coordinates of the multiplication map are the original subgroup inclusions. -/
theorem productEquiv_single [DecidableEq (smallSupportFactors G V 2)] (i : smallSupportFactors G V 2) (x : f.factor i) :
    (f.productEquiv (Pi.mulSingle i x) : G) = (x : G) := by
  classical
  let : Fintype (smallSupportFactors G V 2) := Fintype.ofFinite _
  exact noncommPiCoprod_mulSingle (hcomm := f.commute) i x

/-- The normal product is an actual product of concrete dihedral models. -/
def modelEquiv : f.product ≃* (smallSupportFactors G V 2 → DihedralGroup 5) :=
  f.productEquiv.symm.trans (MulEquiv.piCongrRight fun i => (f.model i).some)

omit [Finite G] [Finite V] [IsElementaryAbelian 2 V] [FaithfulSMul G V] in
/-- The direct sum of the original canonical supports is the product's moved space. -/
theorem product_support :
    commutatorAction f.product V =
      ⨆ i : smallSupportFactors G V 2, commutatorAction i.val V := by
  rw [product,ActionSupport.commutatorAction_eq_iSup_of_eq_iSup f.factor rfl]
  simp_rw [f.support]

/-- The support dimensions and independence retain the actual action. -/
theorem support_geometry :
    (∀ i, Nat.card (commutatorAction (f.factor i) V) = 16) ∧
      iSupIndep (fun i => commutatorAction (f.factor i) V) := by
  constructor
  · intro i
    rw [f.support]
    exact i.property.2.2
  · simp_rw [f.support]
    exact (smallSupport_decomposition (G := G) (V := V) (Or.inr rfl)).2.2.1
end CanonicalFiveDihedralFamily
end CFSG.Quasithin.ChapterD
