module
public import CFSG.Quasithin.ChapterD.Section02.CyclicSource.SmallThree.TwoFactorGeometry
public import CFSG.Quasithin.ChapterD.Section02.CyclicSource.SmallThree.EndpointGroup

/-!
# The two-factor endpoint in D.2.25

The two canonical cubic support planes embed the faithful actor in O₄⁺(2),
so its order divides 72. Cubic ratio two excludes every elementary four.
The normal elementary nine has a two-group quotient generated by
involutions; the absence of a four-group makes that quotient have order two.
Hence the original actor has order 18 and is generated by the specified nine
and an actual starred involution of fixed codimension two.

All factors, the kernel inclusion and the chosen involution remain in the
original actor. The source assembly uses this generation to establish the
full kernel commutator and construct its `LocalGeneration` witness.
Source: Aschbacher--Smith, D.2.25, printed p.190.
-/

open Subgroup Representation.BinaryOffender
namespace CFSG.Quasithin.ChapterD.CyclicSource.SmallThree
variable {G V : Type*} [Group G] [Finite G] [AddCommGroup V] [Module (ZMod 2) V]
    [FiniteDimensional (ZMod 2) V]

public theorem two_factor_endpoint (ρ : Representation (ZMod 2) G V)
    (hf : Function.Injective ρ) (P : Subgroup G) [P.Normal] [IsElementaryAbelian 3 P]
    (d : FittingConfigurations.SupportFactors ρ P 2) (hcard : Nat.card P = 9)
    (hgen : Jhat ρ = ⊤) (hq : cubicRatio ρ = 2)
    (hrank : ∀ A ∈ QhatStar ρ, rank A = 1) :
    Nat.card G = 18 ∧ ∃ t : G, orderOf t = 2 ∧ P ⊔ zpowers t = ⊤ ∧
      fixedCodim ρ (zpowers t) = 2 := by
  obtain ⟨t,ht,hcodim⟩ := exists_rank_two_involution ρ hq hrank
  obtain ⟨hG,hjoin⟩ := order_eighteen_of_involution_generated P hcard
    (two_supports_card_dvd_seventy_two ρ hf P d)
    (supportFactors_two_no_elementary_four ρ d hq)
    (involution_generated_of_Jhat_eq_top ρ hgen) t ht
  exact ⟨hG,t,ht,hjoin,hcodim⟩
end CFSG.Quasithin.ChapterD.CyclicSource.SmallThree
