module
public import Theory.GroupTheory.CoprimeQuotientSubgroups
public import Theory.GroupTheory.PGroup.RankOneInvolution
public import Theory.GroupTheory.NormalizingInvolutionCard

/-!
# The group order in the two-support endpoint

A normal subgroup of order nine in a group of order dividing 72 has a
2-group quotient. Elementary fours lift through its odd kernel. Thus if
the original group has no elementary four, neither does the quotient.
A nontrivial finite 2-group without elementary fours has a unique
involution. Involution generation forces this quotient to have order two,
so the original group has order eighteen and is generated by its normal
nine-subgroup and any involution.

This supplies the group-theoretic step after the faithful embedding in
O₄⁺(2) in Aschbacher--Smith, D.2.25, printed p.190. The orthogonal order,
no-four hypothesis and involution generation are discharged by the
literal two-support representation in the endpoint consumer.
-/

open Subgroup
namespace CFSG.Quasithin.ChapterD.CyclicSource.SmallThree

private theorem two_group_card_le_two_of_involution_generated
    {Q : Type*} [Group Q] [Finite Q] (hQ : IsPGroup 2 Q)
    (hno : ∀ A : Subgroup Q, IsElementaryAbelian 2 A → Nat.card A ≠ 4)
    (hgen : closure {g : Q | g ^ 2 = 1} = ⊤) : Nat.card Q ≤ 2 := by
  classical
  cases subsingleton_or_nontrivial Q with
  | inl hs =>
    have hc : Nat.card Q = 1 := Nat.card_eq_one_iff_unique.mpr ⟨hs, inferInstance⟩
    omega
  | inr hn =>
    obtain ⟨z, hz, _, huniq⟩ := hQ.exists_central_involution_of_no_elementary_four hno
    have htop : zpowers z = ⊤ := by
      apply top_unique
      rw [← hgen]
      apply (closure_le _).mpr
      intro x hx
      rcases huniq x hx with rfl | rfl
      · exact one_mem _
      · exact mem_zpowers _
    have hc := Nat.card_zpowers z
    rw [htop, card_top, hz] at hc
    exact hc.le

/-- The normal nine-subgroup and any involution generate the group in the
involution-generated, no-elementary-four branch of the binary orthogonal
four-space bound. -/
public theorem order_eighteen_of_involution_generated
    {G : Type*} [Group G] [Finite G]
    (P : Subgroup G) [P.Normal] (hP : Nat.card P = 9)
    (hdiv : Nat.card G ∣ 72)
    (hno : ∀ A : Subgroup G, IsElementaryAbelian 2 A → Nat.card A ≠ 4)
    (hgen : closure {g : G | g ^ 2 = 1} = ⊤)
    (t : G) (ht : orderOf t = 2) :
    Nat.card G = 18 ∧ P ⊔ zpowers t = ⊤ := by
  classical
  let Q := G ⧸ P
  let q : G →* Q := QuotientGroup.mk' P
  have hq : Function.Surjective q := QuotientGroup.mk'_surjective P
  have hker : Nat.Coprime 2 (Nat.card q.ker) := by
    dsimp only [q]
    rw [QuotientGroup.ker_mk', hP]
    decide
  have hQdiv : Nat.card Q ∣ 2 ^ 3 := by
    have hc : 9 * Nat.card Q = Nat.card G := by
      change 9 * P.index = Nat.card G
      simpa only [hP] using P.card_mul_index
    apply (Nat.mul_dvd_mul_iff_left (by decide : 0 < 9)).mp
    change 9 * Nat.card Q ∣ 72
    rwa [hc]
  have hQ : IsPGroup 2 Q := IsPGroup.of_card_dvd_pow hQdiv
  have hQno : ∀ A : Subgroup Q, IsElementaryAbelian 2 A → Nat.card A ≠ 4 := by
    intro A hA hcard
    let := hA
    obtain ⟨B, hB, _, hBc⟩ :=
      exists_elementaryAbelian_map_eq_of_surjective_coprime q hq hker A
    exact hno B hB (hBc.trans hcard)
  have hQgen : closure {g : Q | g ^ 2 = 1} = ⊤ := by
    apply top_unique
    rw [← map_top_of_surjective q hq, ← hgen, MonoidHom.map_closure]
    apply Subgroup.closure_mono
    rintro x ⟨y, hy, rfl⟩
    change q y ^ 2 = 1
    rw [← map_pow, hy, map_one]
  have hQle : Nat.card Q ≤ 2 := two_group_card_le_two_of_involution_generated hQ hQno hQgen
  have htP : t ∉ P := by
    intro hm
    have hd := orderOf_dvd_natCard (⟨t, hm⟩ : P)
    rw [← Subgroup.orderOf_coe, ht, hP] at hd
    norm_num at hd
  have htq : q t ≠ 1 := by
    intro h
    exact htP ((QuotientGroup.eq_one_iff t).mp h)
  have hQnt : Nontrivial Q := ⟨⟨q t, 1, htq⟩⟩
  have hQc : Nat.card Q = 2 := by
    have hh : 1 < Nat.card Q := Finite.one_lt_card
    omega
  have hGc : Nat.card G = 18 := by
    have hh := P.card_mul_index
    change Nat.card P * Nat.card Q = Nat.card G at hh
    rw [hP, hQc] at hh
    omega
  refine ⟨hGc, ?_⟩
  apply eq_top_of_card_eq
  rw [card_sup_zpowers_of_normalizing_involution P t
    (orderOf_eq_prime_iff.mp ht).1 htP (le_normalizer_of_normal (mem_top t)), hP, hGc]

end CFSG.Quasithin.ChapterD.CyclicSource.SmallThree
