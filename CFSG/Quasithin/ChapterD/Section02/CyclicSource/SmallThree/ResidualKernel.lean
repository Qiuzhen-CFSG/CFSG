module
public import CFSG.Quasithin.ChapterD.Section02.CyclicSource.SmallThree.FixedComplementCancellation
public import CFSG.Quasithin.ChapterD.Section02.CyclicSource.SmallThree.FixedComplementBudget
public import Theory.GroupTheory.Fitting.Subgroup

/-!
# The kernel on the canonical cubic fixed complement

Let `Y` be generated by the canonical order-three factors and let `W` be its
fixed space. On each canonical plane an element of `C_G(Y)` acts through
that plane's cubic. Consequently an element centralizing `Y` and fixing `W`
has cube one and commutes with all of `C_G(Y)`.

This proves a specialized lifting statement for the residual action: a
normal nilpotent subgroup contained in the image of `C_G(Y)` lifts into the
original Fitting subgroup. Its preimage inside the centralizer is a central
extension of a nilpotent group, hence nilpotent and normal in the original
group. The final theorem uses the literal faithful image on `W`.

The decomposition of the original module into the canonical fixed and moved
parts is retained explicitly. No equality between Fitting subgroups and their
images under arbitrary quotients is asserted.

Source: the canonical-support argument in Aschbacher--Smith D.2.25,
printed p.190. This supplies the central-kernel lifting step for the residual
inverter argument; placing the residual Fitting subgroup in the centralizer
image and obtaining the inverted mover remain separate source steps.
-/

public section
open Subgroup
open scoped IsMulCommutative
namespace CFSG.Quasithin.ChapterD.CyclicSource.SmallThree
variable {G V : Type*} [Group G] [Finite G] [Group V] [Finite V]
  [MulDistribMulAction G V] [IsElementaryAbelian 2 V] [FaithfulSMul G V]

omit [Finite G] [Finite V] [IsElementaryAbelian 2 V] in
private theorem eq_of_same_action_on_parts
    (hsplit : FixedPoints.subgroup (smallSupportGroup G V 1) V ⊔
      commutatorAction (smallSupportGroup G V 1) V = ⊤)
    (x y : G)
    (hf : ∀ v ∈ FixedPoints.subgroup (smallSupportGroup G V 1) V, x • v = y • v)
    (hs : ∀ X ∈ smallSupportFactors G V 1, ∀ v ∈ commutatorAction X V, x • v = y • v) : x=y := by
  apply FaithfulSMul.eq_of_smul_eq_smul (α := V)
  intro v
  let E := (MulDistribMulAction.toMulAut G V x).toMonoidHom.eqLocus
    (MulDistribMulAction.toMulAut G V y).toMonoidHom
  have hE : (⊤ : Subgroup V) ≤ E := by
    rw [←hsplit,smallSupportGroup_support_eq_iSup]
    exact sup_le hf (iSup_le fun X => hs X.val X.property)
  exact hE (mem_top v)

theorem centralizing_fixed_kernel_cube
    (hsplit : FixedPoints.subgroup (smallSupportGroup G V 1) V ⊔
      commutatorAction (smallSupportGroup G V 1) V = ⊤)
    (x : G) (hx : x ∈ centralizer (smallSupportGroup G V 1 : Set G))
    (hfix : ∀ v ∈ FixedPoints.subgroup (smallSupportGroup G V 1) V, x • v = v) : x^3=1 := by
  apply eq_of_same_action_on_parts hsplit
  · intro v hv
    simpa only [one_smul] using smul_eq_self_of_mem_zpowers
      ((zpowers x).pow_mem (mem_zpowers x) 3) (hfix v hv)
  · intro X hX v hv
    obtain ⟨z,hz,hzx⟩ := smallThree_exists_same_support_action hX x
      (fun w hw => (mem_centralizer_iff.mp hx w ((le_sSup hX) hw)).symm)
    have hz3 : z^3=1 := by
      apply orderOf_dvd_iff_pow_eq_one.mp
      simpa only [hX.2.1] using X.orderOf_dvd_natCard hz
    have hstable : ∀ w ∈ commutatorAction X V, z • w ∈ commutatorAction X V :=
      fun w hw => (commutatorAction_isInvariant (A := X) (G := V)).invariant ⟨z,hz⟩ w |>.mp hw
    have hh : x^3 • v=z^3 • v := by
      simp only [pow_succ,pow_zero,one_mul,mul_smul]
      rw [←hzx v hv,←hzx (z•v) (hstable v hv),←hzx (z•(z•v)) (hstable _ (hstable v hv))]
    simpa only [hz3,one_smul] using hh

theorem centralizing_fixed_kernel_commute
    (hsplit : FixedPoints.subgroup (smallSupportGroup G V 1) V ⊔
      commutatorAction (smallSupportGroup G V 1) V = ⊤)
    (x y : G) (hx : x ∈ centralizer (smallSupportGroup G V 1 : Set G))
    (hy : y ∈ centralizer (smallSupportGroup G V 1 : Set G))
    (hfix : ∀ v ∈ FixedPoints.subgroup (smallSupportGroup G V 1) V, x • v = v) : Commute x y := by
  apply eq_of_same_action_on_parts hsplit
  · intro v hv
    have hyv := (canonical_fixed_isInvariant (G:=G) (V:=V)).invariant y v |>.mp hv
    simp only [mul_smul,hfix v hv,hfix (y•v) hyv]
  · intro X hX v hv
    have hxc : ∀ z ∈ X, Commute x z :=
      fun z hz => (mem_centralizer_iff.mp hx z ((le_sSup hX) hz)).symm
    have hyc : ∀ z ∈ X, Commute y z :=
      fun z hz => (mem_centralizer_iff.mp hy z ((le_sSup hX) hz)).symm
    obtain ⟨a,ha,hax⟩ := smallThree_exists_same_support_action hX x hxc
    obtain ⟨b,hb,hby⟩ := smallThree_exists_same_support_action hX y hyc
    have hast : a•v ∈ commutatorAction X V :=
      (commutatorAction_isInvariant (A := X) (G := V)).invariant ⟨a,ha⟩ v |>.mp hv
    have hbst : b•v ∈ commutatorAction X V :=
      (commutatorAction_isInvariant (A := X) (G := V)).invariant ⟨b,hb⟩ v |>.mp hv
    have hab : Commute a b := ((smallSupportFactors_commutingFamily (V:=V) (Or.inl rfl) X hX X hX) ha b hb).symm
    simp only [mul_smul]
    rw [←hby v hv,←hax v hv,←hax (b•v) hbst,←hby (a•v) hast,
      ←mul_smul,←mul_smul,hab.eq]

/-- Nilpotent normal subgroups in the residual image of the canonical
centralizer lift to the original Fitting subgroup. -/
theorem residual_centralizer_nilpotent_lift
    (hsplit : FixedPoints.subgroup (smallSupportGroup G V 1) V ⊔
      commutatorAction (smallSupportGroup G V 1) V = ⊤)
    {D : Type*} [Group D] (f : G →* D)
    (hker : ∀ x, f x = 1 → ∀ v ∈ FixedPoints.subgroup (smallSupportGroup G V 1) V,
      x • v = v)
    (L : Subgroup D) [L.Normal] [Group.IsNilpotent L]
    (hL : L ≤ (centralizer (smallSupportGroup G V 1 : Set G)).map f) :
    L ≤ (fittingSubgroup G).map f := by
  let C := centralizer (smallSupportGroup G V 1 : Set G)
  let R := C ⊓ L.comap f
  let r : R →* L := (f.comp R.subtype).codRestrict L (fun x => x.property.2)
  have hrk : r.ker ≤ center R := by
    intro x hx
    have hfx : f x.val = 1 := congrArg (fun a : L => (a : D)) (show r x = 1 from hx)
    apply mem_center_iff.mpr
    intro y
    apply Subtype.ext
    exact (centralizing_fixed_kernel_commute hsplit x.val y.val
      x.property.1 y.property.1 (hker _ hfx)).symm.eq
  let : Group.IsNilpotent R := Subgroup.isNilpotent_of_ker_le_center r hrk
  have hRF : R ≤ fittingSubgroup G := le_sSup ⟨inferInstance, inferInstance⟩
  intro z hz
  obtain ⟨x,hx,hxz⟩ := hL hz
  exact ⟨x,hRF ⟨hx,by change f x ∈ L; rwa [hxz]⟩,hxz⟩

/-- The Fitting subgroup of the residual centralizer image lies in the
image of the original Fitting subgroup. -/
theorem residual_centralizer_fitting_lift
    (hsplit : FixedPoints.subgroup (smallSupportGroup G V 1) V ⊔
      commutatorAction (smallSupportGroup G V 1) V = ⊤)
    {D : Type*} [Group D] [Finite D] (f : G →* D) (hf : Function.Surjective f)
    (hker : ∀ x, f x = 1 → ∀ v ∈ FixedPoints.subgroup (smallSupportGroup G V 1) V,
      x • v = v) :
    fittingSubgroupOf ((centralizer (smallSupportGroup G V 1 : Set G)).map f) ≤
      (fittingSubgroup G).map f := by
  let C := (centralizer (smallSupportGroup G V 1 : Set G)).map f
  have hC : C.Normal := Normal.map inferInstance f hf
  let := fittingSubgroupOf_normal C hC
  let := fittingSubgroupOf_isNilpotent C
  apply residual_centralizer_nilpotent_lift hsplit f hker
  rintro _ ⟨x,_,rfl⟩
  exact x.property

/-- Actual consumer on the faithful image of the action on the canonical
fixed complement. The ambient homomorphism is the literal restricted action. -/
theorem fixed_complement_fitting_lift
    (hsplit : FixedPoints.subgroup (smallSupportGroup G V 1) V ⊔
      commutatorAction (smallSupportGroup G V 1) V = ⊤) :
    let W := FixedPoints.subgroup (smallSupportGroup G V 1) V
    letI : IsInvariant G V W := canonical_fixed_isInvariant
    let f := (MulDistribMulAction.toMulAut G W).rangeRestrict
    fittingSubgroupOf ((centralizer (smallSupportGroup G V 1 : Set G)).map f) ≤
      (fittingSubgroup G).map f := by
  let : IsInvariant G V (FixedPoints.subgroup (smallSupportGroup G V 1) V) :=
    canonical_fixed_isInvariant
  dsimp only
  apply residual_centralizer_fitting_lift hsplit _ (MonoidHom.rangeRestrict_surjective _) ?_
  intro x hx v hv
  exact congrArg Subtype.val
    (congrArg (fun a : (MulDistribMulAction.toMulAut G
      (FixedPoints.subgroup (smallSupportGroup G V 1) V)).range =>
      a.val ⟨v,hv⟩) hx)
end CFSG.Quasithin.ChapterD.CyclicSource.SmallThree
