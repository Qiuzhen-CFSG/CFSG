module
public import CFSG.Quasithin.ChapterD.Section02.CyclicSource.PrimeEndpoints
public import CFSG.Quasithin.ChapterD.Section02.CyclicSource.SmallThree.Source
public import CFSG.Quasithin.ChapterD.Section02.CyclicSource.NoSmallThreeEndpoints

/-!
# The cyclic starred-actor source theorem D.2.17

The faithful original action is generated by its cyclic starred actors and
is indecomposable in the source sense. The source assumption [V,F(G)]=V is
retained. A moved five-core or ratio one gives D.2.23–24; at ratio two,
D.2.25 treats the canonical two-dimensional cubic supports and D.2.26–29
treat their absence. Every branch produces actual local generation, so the
proved small-support classification applies without an additional premise.
Source: Aschbacher–Smith D.2.17–29, printed pp.188–192.
-/

@[expose] public section
open Subgroup Representation Representation.BinaryOffender Theory.GroupTheory
open scoped ENNReal
namespace CFSG.Quasithin.ChapterD.CyclicSource
universe u
variable {G V : Type u} [Group G] [Finite G]
  [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V]
  {ρ : Representation (ZMod 2) G V}

/-- The source cyclic family supplies every premise of the local endpoint
classification on its unchanged actor and module. -/
theorem Hypotheses.localGeneration (h : Hypotheses ρ)
    {H : Type*} [Group H] [Finite H] {K : GroupClass} (hH : IsSQTK K H)
    (f : H →* G) (honto : Function.Surjective f) : Nonempty (LocalGeneration ρ) := by
  classical
  by_cases hf : ∃ A ∈ QhatStar ρ, ⁅pCore 5 G,A⁆ ≠ ⊥
  · obtain ⟨A,hA,hm⟩ := hf
    exact five_core_localGeneration ρ h hA hm
  have hfive : ∀ A ∈ QhatStar ρ, ⁅pCore 5 G,A⁆ = ⊥ := by
    intro A hA
    by_contra hm
    exact hf ⟨A,hA,hm⟩
  rcases h.toCoreHypotheses.ratio_one_or_two with hq | hq
  · exact ratio_one_localGeneration ρ h hq
  by_cases hs : ∃ X : Subgroup G, X ≤ pCore 3 G ∧ Nat.card X = 3 ∧
      Module.finrank (ZMod 2) (subspaceCommutator ρ ⊤ X) = 2
  · exact Hypotheses.small_three_localGeneration ρ h hH f honto hq hfive hs
  have hNo : ∀ X : Subgroup G, X ≤ pCore 3 G → Nat.card X = 3 →
      Module.finrank (ZMod 2) (subspaceCommutator ρ ⊤ X) ≠ 2 := by
    intro X hXP hc hd
    exact hs ⟨X,hXP,hc,hd⟩
  exact h.no_small_three_localGeneration hH f honto hq hfive hNo

/-- Original source hypotheses for the cyclic part of D.2.17. In particular,
full Fitting movement is not inferred from a small cubic ratio. -/
theorem source_theorem_D_2_17_cyclic
    (hf : Function.Injective ρ) (hq : cubicRatio ρ ≤ 2)
    (hJ : Jhat ρ = ⊤) (hind : IsRatioIndecomposable ρ)
    (hF : generalizedFitting G = fittingSubgroup G) (hO : pCore 2 G = ⊥)
    (hm : subspaceCommutator ρ ⊤ (fittingSubgroup G) = ⊤)
    (hc : ∀ A ∈ QhatStar ρ, IsCyclic A)
    {H : Type*} [Group H] [Finite H] {K : GroupClass} (hH : IsSQTK K H)
    (f : H →* G) (honto : Function.Surjective f) : Nonempty (LocalGeneration ρ) := by
  apply Hypotheses.localGeneration (ρ := ρ) ?_ hH f honto
  exact {
    faithful := hf
    ratio_le := hq
    generated := hJ
    fitting := hF
    twoCore := hO
    rank_one := fun A hA => rank_one_of_cyclic ρ hA (hc A hA)
    indecomposable := hind
    moved := hm
  }

end CFSG.Quasithin.ChapterD.CyclicSource
