module
public import CFSG.Quasithin.ChapterD.Section02.CyclicSource.NormalizerEndpoint
public import Theory.GroupTheory.PGroup.ExtraspecialThreeNormalizerGeneration

/-!
# The extraspecial normalizer generation endpoint of D.2.29

The original small involutions generate the group. Once the literal
extraspecial subgroup of order 27 is normal, has central center, and is
self-centralizing, the group-theoretic Frattini action argument gives its
cyclic supplement generated by the originally selected involution.

The centralizer bound is supplied independently by the faithful six-dimensional
binary action. This module retains that precise premise, not a normalizer
recognition or a classification assumption.
Source: Aschbacher–Smith D.2.29, printed p.192.
-/

public section
open Subgroup Representation Representation.BinaryOffender
namespace CFSG.Quasithin.ChapterD.CyclicSource
variable {G V : Type*} [Group G] [Finite G]
  [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V]
  {ρ : Representation (ZMod 2) G V}

/-- The original extraspecial subgroup and selected small involution generate G. -/
theorem CoreHypotheses.extraspecial_normalizer_endpoint (h : CoreHypotheses ρ)
    (F : Subgroup G) [F.Normal] [IsExtraspecial 3 F] (hF : Nat.card F = 27)
    (hC : centralizer (F : Set G) ≤ F)
    (hZ : (center F).map F.subtype ≤ center G)
    (t : G) (ht : t ∈ smallSupportInvolutions ρ) : F ⊔ zpowers t = ⊤ := by
  have hti : BenderSuzuki.PFAppendixIII.IsInvolution t := by
    refine ⟨?_,?_⟩
    · intro he
      have ho := ht.1
      simp [he] at ho
    · rw [← ht.1]
      exact pow_orderOf_eq_one t
  apply IsExtraspecial.sup_involution_eq_top_of_card27 F hF hC h.involution_generated _ t hti
  intro s _ z hz
  apply Subtype.ext
  change s * (z : G) * s⁻¹ = (z : G)
  have hc : s * (z : G) = (z : G) * s :=
    mem_center_iff.mp (hZ (mem_map_of_mem F.subtype hz)) s
  rw [hc,mul_inv_cancel_right]

end CFSG.Quasithin.ChapterD.CyclicSource
