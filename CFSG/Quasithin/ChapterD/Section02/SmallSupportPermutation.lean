module

public import CFSG.Quasithin.ChapterD.Section02.SmallSupportDecomposition
public import CFSG.Quasithin.ChapterD.Section02.SmallSupportInvolutions
public import CFSG.Quasithin.ChapterD.Section02.SmallSupportPermutation.NormalizedFactors
public import CFSG.Quasithin.ChapterD.Section02.SmallSupportPermutation.Transpositions
public import Theory.GroupAction.SwappedSupportDisplacementBound

/-!
# Involutions and the canonical small-support factors

Aschbacher--Smith, *The Classification of Quasithin Groups*, D.2.12(3–5),
printed pp.183–184. Distinct canonical supports are independent. Moving one
of them therefore costs its full order in displacement, proving normalization
when the involution has rank `k`. The normalized-factor dichotomy then gives
centralization or inversion of exactly one factor, with no additional premise.
For rank two and `k = 1`, the re-exported transposition theorem uses saturation
of this displacement bound to fix every remaining factor and support.

These arguments use the actual canonical decomposition and the cyclic group
generated by the involution; they do not require D.2.9 or action-ratio notation.
The alternatives also apply when the canonical family is empty.
-/

namespace CFSG.Quasithin.ChapterD

variable {G V : Type*} [Group G] [Group V] [MulDistribMulAction G V]
    [Finite G] [Finite V] [IsElementaryAbelian 2 V] [FaithfulSMul G V]

/-- D.2.12(4): an actor whose displacement has rank `k` normalizes every
canonical factor of support rank `2k`. In particular this applies to the
involutions of D.2.12(3). -/
public theorem smallSupportFactors_normalized_of_displacement_card
    {k : ℕ} (hk : k = 1 ∨ k = 2) (t : G)
    (hcard : Nat.card (commutatorAction (Subgroup.zpowers t) V) = 2 ^ k) :
    ∀ X ∈ smallSupportFactors G V k,
      t ∈ Subgroup.normalizer (X : Set G) := by
  intro X hX
  apply Subgroup.mem_normalizer_iff_map_conj_eq.mpr
  change X.conjBy t = X
  by_contra hmove
  have hY : X.conjBy t ∈ smallSupportFactors G V k :=
    smallSupportFactors_conjBy hX t
  have hcross : commutatorAction (X.conjBy t) V ≤
      FixedPoints.subgroup X V :=
    smallSupportFactors_cross_fixed hk hX hY (Ne.symm hmove)
  have hdisjoint : Disjoint (commutatorAction X V)
      (commutatorAction (X.conjBy t) V) :=
    (ActionSupport.fixed_support_isCompl X
      (smallSupportFactor_coprime hk hX)).disjoint.symm.mono_right hcross
  have hbound := commutatorAction_card_ge_of_disjoint_moved_support
    (Subgroup.zpowers t) (commutatorAction X V) t
    (Subgroup.mem_zpowers t)
    ((smallSupport_support_conjBy (V := V) X t).symm ▸ hdisjoint)
  have hbad : 2 ^ (2 * k) ≤ 2 ^ k := by
    simpa only [hX.2.2, hcard] using hbound
  rcases hk with rfl | rfl <;> norm_num at hbad

/-- D.2.12(3): an involution of displacement rank `k` either centralizes
`G_k` and its support, or inverts exactly one canonical factor. In the latter
case that factor's support accounts for the full displacement, and every
other factor and support is centralized. Normalization is proved from the
displacement bound, rather than imposed as an extra hypothesis. -/
public theorem smallSupportFactors_involution_alternative
    {k : ℕ} (hk : k = 1 ∨ k = 2) (t : G) (ht : IsInvolution t)
    (hcard : Nat.card (commutatorAction (Subgroup.zpowers t) V) = 2 ^ k) :
    ((∀ X ∈ smallSupportFactors G V k,
      (∀ x ∈ X, Commute t x) ∧ (∀ v ∈ commutatorAction X V, t • v = v)) ∧
      (∀ x ∈ smallSupportGroup G V k, Commute t x) ∧
      (∀ v ∈ commutatorAction (smallSupportGroup G V k) V, t • v = v)) ∨
    ∃ X ∈ smallSupportFactors G V k,
      (∀ x ∈ X, t * x * t⁻¹ = x⁻¹) ∧
      (∀ Y ∈ smallSupportFactors G V k,
        (∀ y ∈ Y, t * y * t⁻¹ = y⁻¹) → Y = X) ∧
      commutatorAction (Subgroup.zpowers t) V =
        commutatorSubgroup (Subgroup.zpowers t) V (commutatorAction X V) ∧
      ∀ Y ∈ smallSupportFactors G V k, Y ≠ X →
        (∀ y ∈ Y, Commute t y) ∧ (∀ v ∈ commutatorAction Y V, t • v = v) := by
  exact smallSupportFactors_normalized_involution_alternative hk t ht hcard
    (smallSupportFactors_normalized_of_displacement_card hk t hcard)

end CFSG.Quasithin.ChapterD
