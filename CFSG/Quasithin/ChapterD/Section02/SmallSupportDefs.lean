module

public import Theory.GroupTheory.Fitting.Core
public import Theory.GroupAction.Defs

/-!
# The small odd-support factors

This is the notation of Aschbacher--Smith, *The Classification of Quasithin
Groups*, D.2.12, printed pp.183–184. For k = 1 or 2, the family consists
of subgroups of F(G) of order 2k+1 whose binary support has rank 2k.
Rank is expressed by its equivalent cardinality 2^(2k), so no choice of
coordinates or pending action-ratio definitions enters the interface.
-/

namespace CFSG.Quasithin.ChapterD

/-- The family X_k in D.2.12. -/
@[expose] public def smallSupportFactors (G V : Type*) [Group G] [Group V]
    [MulDistribMulAction G V] (k : ℕ) : Set (Subgroup G) :=
  {X | X ≤ fittingSubgroup G ∧ Nat.card X = 2 * k + 1 ∧
    Nat.card (commutatorAction X V) = 2 ^ (2 * k)}

/-- The subgroup G_k generated by X_k. -/
@[expose] public def smallSupportGroup (G V : Type*) [Group G] [Group V]
    [MulDistribMulAction G V] (k : ℕ) : Subgroup G :=
  sSup (smallSupportFactors G V k)

/-- The generated small-support group lies in the Fitting subgroup. -/
public theorem smallSupportGroup_le_fitting (G V : Type*) [Group G] [Group V]
    [MulDistribMulAction G V] (k : ℕ) :
    smallSupportGroup G V k ≤ fittingSubgroup G := by
  exact sSup_le fun _ hX => hX.1

end CFSG.Quasithin.ChapterD
