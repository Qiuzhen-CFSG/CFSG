module
public import CFSG.Quasithin.ChapterD.Section02.FittingOffenders.SourceTransport
public import Theory.Representation.BinaryOffender.ComponentSum
public import Theory.Representation.BinaryOffender.MovedDimension
public import Theory.ElementaryAbelian.Injective
/-!
# Literal factor actions in a ratio sum

For a D.2.16 ratio sum, faithfulness and the complementary action clauses
make the two generated subgroups disjoint and commuting. If the whole module
is generated by its action differences, each prescribed summand is exactly
the moved space of its factor. Restriction to that summand is faithful and
fully moved; its cubic minimum and starred actors are transported through the
literal subgroup inclusion. The original actor partition is recovered exactly,
and both group orders decrease for finite recursive decomposition.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*, D.2.16,
printed p.187 (1 March 2004 manuscript).
-/

public section
namespace CFSG.Quasithin.ChapterD.RatioDecomposition
open Subgroup Representation.BinaryOffender
open scoped ENNReal
variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]
  (ρ : Representation (ZMod 2) G V)

@[expose] def sideModule (H : Subgroup G) (U : Submodule (ZMod 2) V)
    (hs : H ≤ subspaceStabilizer ρ U) : Subrepresentation (ρ.comp H.subtype) where
  toSubmodule := U
  apply_mem_toSubmodule g := fun _ hv => (hs g.property _).mpr hv

@[expose] def side (H : Subgroup G) (U : Submodule (ZMod 2) V)
    (hs : H ≤ subspaceStabilizer ρ U) : Representation (ZMod 2) H U :=
  (sideModule ρ H U hs).toRepresentation

private theorem invariant_of_moved_le {H : Subgroup G} {U : Submodule (ZMod 2) V}
    (h : subspaceCommutator ρ ⊤ H ≤ U) : H ≤ subspaceStabilizer ρ U := by
  apply le_subspaceStabilizer
  intro g hg v hv
  have hh := U.add_mem (h (Submodule.subset_span ⟨g,hg,v,Submodule.mem_top,rfl⟩)) hv
  simpa only [sub_add_cancel] using hh

private theorem commutator_sup (H K : Subgroup G) :
    subspaceCommutator ρ ⊤ (H ⊔ K) =
      subspaceCommutator ρ ⊤ H ⊔ subspaceCommutator ρ ⊤ K := by
  simpa only [iSup_bool_eq, Bool.false_eq_true, ↓reduceIte] using
    subspaceCommutator_iSup_family ρ (fun b : Bool => if b then H else K)

private theorem full_side {H K : Subgroup G} {U W : Submodule (ZMod 2) V}
    (hgen : H ⊔ K = ⊤) (hfull : subspaceCommutator ρ ⊤ ⊤ = ⊤)
    (hcompl : IsCompl U W)
    (hU : subspaceCommutator ρ ⊤ H ≤ U) (hW : subspaceCommutator ρ ⊤ K ≤ W)
    (hfix : W ≤ fixedSpace ρ H) :
    subspaceCommutator ρ ⊤ H = U ∧ subspaceCommutator ρ U H = U := by
  have hs : subspaceCommutator ρ ⊤ H ⊔ W = ⊤ := by
    apply top_unique
    calc
      ⊤ = subspaceCommutator ρ ⊤ (H ⊔ K) := by rw [hgen,hfull]
      _ = subspaceCommutator ρ ⊤ H ⊔ subspaceCommutator ρ ⊤ K := commutator_sup ρ H K
      _ ≤ subspaceCommutator ρ ⊤ H ⊔ W := sup_le_sup_left hW _
  have he : subspaceCommutator ρ ⊤ H = U :=
    eq_of_le_of_inf_le_of_le_sup hU
      (by rw [hcompl.inf_eq_bot]; exact bot_le) (by rw [hs]; exact le_top)
  refine ⟨he, le_antisymm (subspaceCommutator_le_of_invariant ρ
    (invariant_of_moved_le ρ hU)) ?_⟩
  apply he.ge.trans
  apply Submodule.span_le.mpr
  rintro _ ⟨g,hg,v,_,rfl⟩
  obtain ⟨u,hu,w,hw,rfl⟩ := Submodule.mem_sup.mp
    (show v ∈ U ⊔ W from hcompl.sup_eq_top ▸ Submodule.mem_top)
  have hf : ρ g w = w := hfix hw ⟨g,hg⟩
  have hh : ρ g (u+w) - (u+w) = ρ g u-u := by rw [map_add,hf]; abel
  rw [hh]
  exact Submodule.subset_span ⟨g,hg,u,hu,rfl⟩

/-- A literal restricted action is fully moved when its support generates itself. -/
theorem side_full {H : Subgroup G} {U : Submodule (ZMod 2) V}
    (hs : H ≤ subspaceStabilizer ρ U) (hfull : subspaceCommutator ρ U H = U) :
    subspaceCommutator (side ρ H U hs) ⊤ ⊤ = ⊤ := by
  apply Submodule.map_injective_of_injective U.subtype_injective
  have hm := subspaceCommutator_map_embedding (ρ.comp H.subtype) (side ρ H U hs)
    (MonoidHom.id H) U.subtype (fun _ _ => rfl) ⊤ ⊤
  have htop : (⊤ : Subgroup H).map H.subtype = H := by
    rw [← MonoidHom.range_eq_map,Subgroup.range_subtype]
  simpa only [Submodule.map_top,Submodule.range_subtype,Subgroup.map_id,
    subspaceCommutator_comp_map,htop,hfull] using hm.symm

/-- A faithful action remains faithful on a summand with a fixed complementary span. -/
theorem side_faithful (hf : Function.Injective ρ)
    {H : Subgroup G} {U W : Submodule (ZMod 2) V}
    (hs : H ≤ subspaceStabilizer ρ U) (hspan : U ⊔ W = ⊤)
    (hfix : W ≤ fixedSpace ρ H) : Function.Injective (side ρ H U hs) := by
  intro a b he
  apply Subtype.ext
  apply hf
  ext v
  obtain ⟨u,hu,w,hw,rfl⟩ := Submodule.mem_sup.mp
    (show v ∈ U ⊔ W from hspan ▸ Submodule.mem_top)
  have huab : ρ (a:G) u = ρ (b:G) u := congrArg Subtype.val
    (DFunLike.congr_fun he (⟨u,hu⟩ : U))
  have hwa : ρ (a:G) w = w := hfix hw a
  have hwb : ρ (b:G) w = w := hfix hw b
  simp only [map_add,huab,hwa,hwb]

private theorem group_disjoint (hf : Function.Injective ρ)
    {H K : Subgroup G} {U W : Submodule (ZMod 2) V}
    (hspan : U ⊔ W = ⊤) (hfixU : U ≤ fixedSpace ρ K) (hfixW : W ≤ fixedSpace ρ H) :
    Disjoint H K := by
  apply disjoint_iff_inf_le.mpr
  rintro g ⟨hgH,hgK⟩
  apply Subgroup.mem_bot.mpr
  apply hf
  ext v
  obtain ⟨u,hu,w,hw,rfl⟩ := Submodule.mem_sup.mp
    (show v ∈ U ⊔ W from hspan ▸ Submodule.mem_top)
  have hgu : ρ g u = u := hfixU hu ⟨g,hgK⟩
  have hgw : ρ g w = w := hfixW hw ⟨g,hgH⟩
  simp only [map_add,hgu,hgw,map_one,Module.End.one_apply]

private theorem groups_commute (hf : Function.Injective ρ)
    {H K : Subgroup G} {U W : Submodule (ZMod 2) V}
    (hspan : U ⊔ W = ⊤)
    (hsU : H ≤ subspaceStabilizer ρ U) (hsW : K ≤ subspaceStabilizer ρ W)
    (hfixU : U ≤ fixedSpace ρ K) (hfixW : W ≤ fixedSpace ρ H) :
    ∀ x ∈ H, ∀ y ∈ K, Commute x y := by
  intro x hx y hy
  apply hf
  ext v
  obtain ⟨u,hu,w,hw,rfl⟩ := Submodule.mem_sup.mp
    (show v ∈ U ⊔ W from hspan ▸ Submodule.mem_top)
  have hyu : ρ y u = u := hfixU hu ⟨y,hy⟩
  have hxw : ρ x w = w := hfixW hw ⟨x,hx⟩
  have hyxu : ρ y (ρ x u) = ρ x u := hfixU ((hsU hx u).mpr hu) ⟨y,hy⟩
  have hxyw : ρ x (ρ y w) = ρ y w := hfixW ((hsW hy w).mpr hw) ⟨x,hx⟩
  simp only [map_mul,Module.End.mul_apply,map_add,hyu,hxw,hyxu,hxyw]

private theorem elementary_map_iff {H : Subgroup G} (B : Subgroup H) :
    IsElementaryTwo B ↔ IsElementaryTwo (B.map H.subtype) := by
  constructor
  · intro h
    let : IsElementaryAbelian 2 B := h.2
    refine ⟨?_, IsElementaryAbelian.map H.subtype⟩
    intro hb
    apply h.1
    exact (Subgroup.map_injective H.subtype_injective) (by simpa only [Subgroup.map_bot] using hb)
  · intro h
    let : IsElementaryAbelian 2 (B.map H.subtype) := h.2
    refine ⟨?_, IsElementaryAbelian.of_injective
      (B.equivMapOfInjective H.subtype H.subtype_injective).toMonoidHom
      (B.equivMapOfInjective H.subtype H.subtype_injective).injective⟩
    intro hb
    exact h.1 (by rw [hb,Subgroup.map_bot])

variable [FiniteDimensional (ZMod 2) V]
private theorem side_laws {H : Subgroup G} {U W : Submodule (ZMod 2) V}
    (hs : H ≤ subspaceStabilizer ρ U) (hspan : U ⊔ W = ⊤)
    (hfix : W ≤ fixedSpace ρ H) :
    (∀ B : Subgroup H, actionRatio (side ρ H U hs) B = actionRatio ρ (B.map H.subtype)) ∧
    (∀ B : Subgroup H, IsCubic (side ρ H U hs) B ↔ IsCubic ρ (B.map H.subtype)) := by
  have hspan' : (sideModule ρ H U hs).toSubmodule ⊔
      fixedSpace (ρ.comp H.subtype) ⊤ = ⊤ := by
    apply top_unique
    calc
      ⊤ = U ⊔ W := hspan.symm
      _ ≤ U ⊔ fixedSpace ρ H := sup_le_sup_left hfix _
      _ = _ := by rw [fixedSpace_comp_map, ← MonoidHom.range_eq_map, Subgroup.range_subtype]; rfl
  constructor
  · intro B
    have hc : fixedCodim (side ρ H U hs) B = fixedCodim (ρ.comp H.subtype) B := by
      apply (fixedCodim_subrepresentation_eq_iff (ρ.comp H.subtype) (sideModule ρ H U hs) B).mpr
      apply top_unique
      rw [← hspan']
      exact sup_le_sup_left (fixedSpace_antitone _ le_top) _
    rw [actionRatio,actionRatio,hc,rank_map_injective H.subtype H.subtype_injective]
    congr 1
    unfold fixedCodim
    rw [fixedSpace_comp_map]
  · intro B
    change IsCubic (sideModule ρ H U hs).toRepresentation B ↔ _
    rw [SourceReduction.cubic_fixed_complement_iff (ρ.comp H.subtype)
      (sideModule ρ H U hs) hspan' B]
    constructor
    · intro hc
      exact hc.map_equivariant (ρ.comp H.subtype) ρ H.subtype
        (LinearEquiv.refl _ _) (fun _ _ => rfl)
    · intro hc a ha b hb c hc' v
      exact hc a (mem_map_of_mem H.subtype ha) b (mem_map_of_mem H.subtype hb)
        c (mem_map_of_mem H.subtype hc') v

/-- Removing a fixed complementary span preserves the minimum and exactly the starred actors. -/
theorem side_transport {H : Subgroup G} {U W : Submodule (ZMod 2) V}
    (hs : H ≤ subspaceStabilizer ρ U) (hspan : U ⊔ W = ⊤)
    (hfix : W ≤ fixedSpace ρ H)
    (hwit : ∃ A ∈ QhatStar ρ, A ≤ H) :
    cubicRatio (side ρ H U hs) = cubicRatio ρ ∧
    (∀ B : Subgroup H, B ∈ QhatStar (side ρ H U hs) ↔ B.map H.subtype ∈ QhatStar ρ) := by
  obtain ⟨hr,hc⟩ := side_laws ρ hs hspan hfix
  have hspan' : (sideModule ρ H U hs).toSubmodule ⊔
      fixedSpace (ρ.comp H.subtype) ⊤ = ⊤ := by
    apply top_unique
    calc
      ⊤ = U ⊔ W := hspan.symm
      _ ≤ U ⊔ fixedSpace ρ H := sup_le_sup_left hfix _
      _ = _ := by rw [fixedSpace_comp_map, ← MonoidHom.range_eq_map, Subgroup.range_subtype]; rfl
  obtain ⟨A,hA,hAH⟩ := hwit
  have hA' := SourceReduction.fixed_complement_starred (ρ.comp H.subtype)
    (sideModule ρ H U hs) hspan' (SourceReduction.starred_subgroupOf ρ hA hAH)
  have he : cubicRatio (side ρ H U hs) = cubicRatio ρ := by
    calc
      _ = actionRatio (side ρ H U hs) (A.subgroupOf H) := hA'.1.2.2.2.symm
      _ = actionRatio ρ A := by rw [hr,map_subgroupOf_eq_of_le hAH]
      _ = cubicRatio ρ := hA.1.2.2.2
  have hmin (B : Subgroup H) : B ∈ QhatMin (side ρ H U hs) ↔
      B.map H.subtype ∈ QhatMin ρ := by
    simp only [QhatMin,Set.mem_ofPred_eq,he,elementary_map_iff,hr,hc]
  refine ⟨he,fun B => ⟨?_,?_⟩⟩
  · intro hB
    refine ⟨(hmin B).mp hB.1,?_⟩
    intro C hC hCB
    have hCH : C ≤ H := hCB.trans (map_subtype_le B)
    have hC' : C.subgroupOf H ∈ QhatMin (side ρ H U hs) :=
      (hmin _).mpr (by rwa [map_subgroupOf_eq_of_le hCH])
    have hle : C.subgroupOf H ≤ B := by
      intro c hc
      obtain ⟨b,hb,he⟩ := hCB hc
      have heq : b = c := Subtype.ext he
      exact heq ▸ hb
    have heq := hB.2 _ hC' hle
    simpa only [map_subgroupOf_eq_of_le hCH] using congrArg (Subgroup.map H.subtype) heq
  · intro hB
    refine ⟨(hmin B).mpr hB.1,?_⟩
    intro C hC hCB
    apply Subgroup.map_injective H.subtype_injective
    exact hB.2 _ ((hmin C).mp hC) (Subgroup.map_mono hCB)

/-- One literal factor action, with its full moved support and exact starred actors. -/
structure FactorData (H : Subgroup G) (U : Submodule (ZMod 2) V) where
  representation : Representation (ZMod 2) H U
  equivariant : ∀ g v, ((representation g v : U) : V) = ρ (g:G) (v:V)
  faithful : Function.Injective representation
  generated : Jhat representation = ⊤
  full : subspaceCommutator representation ⊤ ⊤ = ⊤
  support : subspaceCommutator ρ ⊤ H = U
  fixed_complement : U ⊔ fixedSpace ρ H = ⊤
  ratio : cubicRatio representation = cubicRatio ρ
  stars : ∀ A : Subgroup H, A ∈ QhatStar representation ↔ A.map H.subtype ∈ QhatStar ρ

omit [FiniteDimensional (ZMod 2) V] in
/-- The original partition is exactly the ambient starred actors in each factor. -/
theorem partition_characterization {H K : Subgroup G} {Q₁ Q₂ : Set (Subgroup G)}
    (hQ : Q₁ ∪ Q₂ = QhatStar ρ) (hH : sSup Q₁ = H) (hK : sSup Q₂ = K)
    (hdis : Disjoint H K) (A : Subgroup G) :
    A ∈ Q₁ ↔ A ∈ QhatStar ρ ∧ A ≤ H := by
  constructor
  · intro hA
    exact ⟨hQ ▸ Or.inl hA,hH ▸ le_sSup hA⟩
  · rintro ⟨hA,hAH⟩
    have hh : A ∈ Q₁ ∪ Q₂ := hQ.symm ▸ hA
    rcases hh with h₁ | h₂
    · exact h₁
    · have hAK : A ≤ K := hK ▸ le_sSup h₂
      exact (hA.1.2.1.1 (le_bot_iff.mp
        ((le_inf hAH hAK).trans (disjoint_iff_inf_le.mp hdis)))).elim

omit [FiniteDimensional (ZMod 2) V] in
/-- Exact partition membership for the restricted actor, before mapping it into G. -/
theorem FactorData.star_partition_iff {H : Subgroup G} {U : Submodule (ZMod 2) V}
    (d : FactorData ρ H U) {Q : Set (Subgroup G)}
    (hQ : (Subgroup.map H.subtype) '' QhatStar d.representation = Q)
    (B : Subgroup H) : B ∈ QhatStar d.representation ↔ B.map H.subtype ∈ Q := by
  rw [← hQ]
  constructor
  · intro hB
    exact ⟨B,hB,rfl⟩
  · rintro ⟨C,hC,hCB⟩
    exact (Subgroup.map_injective H.subtype_injective hCB) ▸ hC

private theorem factor_data (hf : Function.Injective ρ)
    {H K : Subgroup G} {U W : Submodule (ZMod 2) V}
    {Q₁ Q₂ : Set (Subgroup G)}
    (hfull : subspaceCommutator ρ ⊤ ⊤ = ⊤)
    (hgen : H ⊔ K = ⊤) (hcompl : IsCompl U W)
    (hU : subspaceCommutator ρ ⊤ H ≤ U) (hW : subspaceCommutator ρ ⊤ K ≤ W)
    (hfix : W ≤ fixedSpace ρ H) (hdis : Disjoint H K)
    (hQ : Q₁ ∪ Q₂ = QhatStar ρ) (hQne : Q₁.Nonempty)
    (hH : sSup Q₁ = H) (hK : sSup Q₂ = K) :
    ∃ d : FactorData ρ H U,
      (Subgroup.map H.subtype) '' QhatStar d.representation = Q₁ := by
  let hs := invariant_of_moved_le ρ hU
  have hwit : ∃ A ∈ QhatStar ρ, A ≤ H := by
    obtain ⟨A,hA⟩ := hQne
    exact ⟨A,(partition_characterization ρ hQ hH hK hdis A).mp hA⟩
  obtain ⟨hratio,hstars⟩ := side_transport ρ hs hcompl.sup_eq_top hfix hwit
  have himage : (Subgroup.map H.subtype) '' QhatStar (side ρ H U hs) = Q₁ := by
    ext A
    constructor
    · rintro ⟨B,hB,rfl⟩
      exact (partition_characterization ρ hQ hH hK hdis _).mpr
        ⟨(hstars B).mp hB,map_subtype_le B⟩
    · intro hA
      obtain ⟨hA',hAH⟩ := (partition_characterization ρ hQ hH hK hdis A).mp hA
      refine ⟨A.subgroupOf H,(hstars _).mpr ?_,map_subgroupOf_eq_of_le hAH⟩
      rwa [map_subgroupOf_eq_of_le hAH]
  have hJ : Jhat (side ρ H U hs) = ⊤ := by
    apply Subgroup.map_injective H.subtype_injective
    rw [← MonoidHom.range_eq_map, Subgroup.range_subtype]
    apply le_antisymm (map_subtype_le _)
    apply hH.ge.trans
    apply sSup_le
    intro A hA
    obtain ⟨B,hB,rfl⟩ := himage.symm ▸ hA
    exact Subgroup.map_mono (le_sSup hB)
  obtain ⟨hsupport,hself⟩ := full_side ρ hgen hfull hcompl hU hW hfix
  exact ⟨⟨side ρ H U hs,fun _ _ => rfl,
    side_faithful ρ hf hs hcompl.sup_eq_top hfix,hJ,
    side_full ρ hs hself,hsupport,
    top_unique (hcompl.sup_eq_top.ge.trans (sup_le_sup_left hfix U)),hratio,hstars⟩,himage⟩

variable [Finite G]
/-- The literal D.2.16 split preserves the ratio and exact starred partition.
Both factors have smaller order, so this is the recursive decomposition step. -/
theorem split_witnesses (hf : Function.Injective ρ)
    (hfull : subspaceCommutator ρ ⊤ ⊤ = ⊤)
    {G₁ G₂ : Subgroup G} {V₁ V₂ : Submodule (ZMod 2) V}
    (hn₁ : G₁ ≠ ⊥) (hn₂ : G₂ ≠ ⊥)
    {Q₁ Q₂ : Set (Subgroup G)}
    (hgen : Jhat ρ = ⊤) (hne₁ : Q₁.Nonempty) (hne₂ : Q₂.Nonempty)
    (hQ : Q₁ ∪ Q₂ = QhatStar ρ) (hG₁ : sSup Q₁ = G₁) (hG₂ : sSup Q₂ = G₂)
    (hcompl : IsCompl V₁ V₂)
    (hV₁ : subspaceCommutator ρ ⊤ G₁ ≤ V₁) (hV₂ : subspaceCommutator ρ ⊤ G₂ ≤ V₂)
    (hcross₁ : subspaceCommutator ρ V₂ G₁ = ⊥)
    (hcross₂ : subspaceCommutator ρ V₁ G₂ = ⊥) :
    ∃ d₁ : FactorData ρ G₁ V₁, ∃ d₂ : FactorData ρ G₂ V₂,
      Nat.card G₁ < Nat.card G ∧ Nat.card G₂ < Nat.card G ∧
      Disjoint G₁ G₂ ∧ G₁ ⊔ G₂ = ⊤ ∧
      (∀ x ∈ G₁, ∀ y ∈ G₂, Commute x y) ∧
      (Subgroup.map G₁.subtype) '' QhatStar d₁.representation = Q₁ ∧
      (Subgroup.map G₂.subtype) '' QhatStar d₂.representation = Q₂ := by
  have hfix₁ := (subspaceCommutator_eq_bot_iff ρ V₂ G₁).mp hcross₁
  have hfix₂ := (subspaceCommutator_eq_bot_iff ρ V₁ G₂).mp hcross₂
  have hsup : G₁ ⊔ G₂ = ⊤ := by
    rw [← hG₁,← hG₂,← sSup_union,hQ]
    exact hgen
  have hdis := group_disjoint ρ hf hcompl.sup_eq_top hfix₂ hfix₁
  obtain ⟨d₁,he₁⟩ := factor_data ρ hf hfull hsup hcompl hV₁ hV₂ hfix₁ hdis
    hQ hne₁ hG₁ hG₂
  obtain ⟨d₂,he₂⟩ := factor_data ρ hf hfull (sup_comm G₂ G₁ ▸ hsup) hcompl.symm
    hV₂ hV₁ hfix₂ hdis.symm (Set.union_comm Q₂ Q₁ ▸ hQ) hne₂ hG₂ hG₁
  refine ⟨d₁,d₂,?_,?_,hdis,hsup,?_,he₁,he₂⟩
  · apply Nat.lt_of_not_ge
    intro hcard
    have ht := G₁.eq_top_of_le_card hcard
    exact hdis.symm.ne_top_of_ne_bot hn₂ ht
  · apply Nat.lt_of_not_ge
    intro hcard
    have ht := G₂.eq_top_of_le_card hcard
    exact hdis.ne_top_of_ne_bot hn₁ ht
  · exact groups_commute ρ hf hcompl.sup_eq_top (invariant_of_moved_le ρ hV₁)
      (invariant_of_moved_le ρ hV₂) hfix₂ hfix₁

/-- A ratio sum yields two faithful fully moved factors and its literal actor partition. -/
theorem split (hf : Function.Injective ρ)
    (hfull : subspaceCommutator ρ ⊤ ⊤ = ⊤)
    {G₁ G₂ : Subgroup G} {V₁ V₂ : Submodule (ZMod 2) V}
    (h : IsRatioSum ρ G₁ G₂ V₁ V₂) (hn₁ : G₁ ≠ ⊥) (hn₂ : G₂ ≠ ⊥) :
    ∃ d₁ : FactorData ρ G₁ V₁, ∃ d₂ : FactorData ρ G₂ V₂,
      Nat.card G₁ < Nat.card G ∧ Nat.card G₂ < Nat.card G ∧
      Disjoint G₁ G₂ ∧ G₁ ⊔ G₂ = ⊤ ∧
      (∀ x ∈ G₁, ∀ y ∈ G₂, Commute x y) ∧ IsCompl V₁ V₂ ∧
      QhatStar ρ = (Subgroup.map G₁.subtype) '' QhatStar d₁.representation ∪
        (Subgroup.map G₂.subtype) '' QhatStar d₂.representation := by
  obtain ⟨hgen,Q₁,Q₂,hnQ₁,hnQ₂,_,hQ,hG₁,hG₂,hcompl,hV₁,hV₂,hc₁,hc₂⟩ := h
  obtain ⟨d₁,d₂,hn₁',hn₂',hd,hs,hc,he₁,he₂⟩ := split_witnesses ρ hf hfull hn₁ hn₂
    hgen hnQ₁ hnQ₂ hQ hG₁ hG₂ hcompl hV₁ hV₂ hc₁ hc₂
  exact ⟨d₁,d₂,hn₁',hn₂',hd,hs,hc,hcompl,by rw [he₁,he₂,hQ]⟩

end CFSG.Quasithin.ChapterD.RatioDecomposition
