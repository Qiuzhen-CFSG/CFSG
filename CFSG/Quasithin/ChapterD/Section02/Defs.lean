module

public import Theory.Representation.BinaryOffender.CubicRatio
public import Mathlib.GroupTheory.OrderOfElement

/-!
# The ratio families of D.2

These are Definitions D.2.1, D.2.10, D.2.15 and D.2.16 of
Aschbacher–Smith, *The Classification of Quasithin Groups*, combined
manuscript (1 March 2004), printed pp.178, 183 and 187. The quadratic and
cubic minima are the existing B.1/B.4 minima, with infinity for an empty
indexing set. In particular `QhatStar` uses the global cubic minimum and
inclusion minimality, not the equal-weight order on best offenders.

The section's source hypotheses are a finite group and a faithful finite
binary module. The definitions themselves also make sense without these
hypotheses. The decomposability relation retains the proper partition of
`QhatStar`, the actual generated subgroups and both action conditions.
-/

@[expose] public section
namespace CFSG.Quasithin.ChapterD

open Representation.BinaryOffender
open scoped ENNReal
variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]

/-- D.2.1: elementary actors with action ratio at most `r`. -/
def R (ρ : Representation (ZMod 2) G V) (r : ℝ≥0∞) : Set (Subgroup G) :=
  {A | IsElementaryTwo A ∧ actionRatio ρ A ≤ r}

/-- The exact-ratio family. -/
def REq (ρ : Representation (ZMod 2) G V) (r : ℝ≥0∞) : Set (Subgroup G) :=
  {A | IsElementaryTwo A ∧ actionRatio ρ A = r}

/-- D.2.1: the actor minimizes its ratio among its nontrivial subgroups. -/
def RPlus (ρ : Representation (ZMod 2) G V) : Set (Subgroup G) :=
  {A | IsElementaryTwo A ∧ ∀ B ≤ A, B ≠ ⊥ → actionRatio ρ A ≤ actionRatio ρ B}

/-- The source's bounded `R⁺` family. -/
def RPlusBound (ρ : Representation (ZMod 2) G V) (r : ℝ≥0∞) : Set (Subgroup G) :=
  R ρ r ∩ RPlus ρ

/-- The iterated commutator subspaces `L_A^k(V)`. -/
def iteratedCommutator (ρ : Representation (ZMod 2) G V) (A : Subgroup G) :
    ℕ → Submodule (ZMod 2) V
  | 0 => ⊤
  | k + 1 => subspaceCommutator ρ (iteratedCommutator ρ A k) A

/-- The `k`-fold commutator restriction on `R`. -/
def RIterated (ρ : Representation (ZMod 2) G V) (k : ℕ) (r : ℝ≥0∞) :
    Set (Subgroup G) := {A | A ∈ R ρ r ∧ iteratedCommutator ρ A k = ⊥}

/-- The `k`-fold commutator restriction on `R⁺`. -/
def RIteratedPlus (ρ : Representation (ZMod 2) G V) (k : ℕ) (r : ℝ≥0∞) :
    Set (Subgroup G) := RIterated ρ k r ∩ RPlus ρ

/-- The general minimum `ᵏq`, including its empty-index convention. -/
noncomputable def iteratedRatio (ρ : Representation (ZMod 2) G V) (k : ℕ) : ℝ≥0∞ :=
  ⨅ (A : Subgroup G) (_ : IsElementaryTwo A ∧ iteratedCommutator ρ A k = ⊥),
    actionRatio ρ A

/-- D.2.1: quadratic elementary actors of ratio at most two. -/
def Q (ρ : Representation (ZMod 2) G V) : Set (Subgroup G) :=
  {A | IsElementaryTwo A ∧ IsQuadratic ρ A ∧ actionRatio ρ A ≤ 2}

/-- D.2.1: cubic elementary actors of ratio at most two. -/
def Qhat (ρ : Representation (ZMod 2) G V) : Set (Subgroup G) :=
  {A | IsElementaryTwo A ∧ IsCubic ρ A ∧ actionRatio ρ A ≤ 2}

/-- The cubic actors attaining the global minimum, when that minimum is at most two. -/
def QhatMin (ρ : Representation (ZMod 2) G V) : Set (Subgroup G) :=
  {A | cubicRatio ρ ≤ 2 ∧ IsElementaryTwo A ∧ IsCubic ρ A ∧
    actionRatio ρ A = cubicRatio ρ}

/-- D.2.1: inclusion-minimal actors attaining the global cubic minimum. -/
def QhatStar (ρ : Representation (ZMod 2) G V) : Set (Subgroup G) :=
  {A | A ∈ QhatMin ρ ∧ ∀ B, B ∈ QhatMin ρ → B ≤ A → B = A}

/-- D.2.10: involutions whose displacement space has dimension at most two. -/
def smallSupportInvolutions (ρ : Representation (ZMod 2) G V) : Set G :=
  {t | orderOf t = 2 ∧ Module.finrank (ZMod 2) (LinearMap.range (displacement ρ t)) ≤ 2}

/-- D.2.15: the subgroup generated by the minimal global cubic actors. -/
def Jhat (ρ : Representation (ZMod 2) G V) : Subgroup G := sSup (QhatStar ρ)

/-- D.2.16: a sum decomposition, with its source partition and action clauses. -/
def IsRatioSum (ρ : Representation (ZMod 2) G V) (G₁ G₂ : Subgroup G)
    (V₁ V₂ : Submodule (ZMod 2) V) : Prop :=
  Jhat ρ = ⊤ ∧ ∃ Q₁ Q₂ : Set (Subgroup G),
    Q₁.Nonempty ∧ Q₂.Nonempty ∧ Disjoint Q₁ Q₂ ∧ Q₁ ∪ Q₂ = QhatStar ρ ∧
    sSup Q₁ = G₁ ∧ sSup Q₂ = G₂ ∧ IsCompl V₁ V₂ ∧
    subspaceCommutator ρ ⊤ G₁ ≤ V₁ ∧ subspaceCommutator ρ ⊤ G₂ ≤ V₂ ∧
    subspaceCommutator ρ V₂ G₁ = ⊥ ∧ subspaceCommutator ρ V₁ G₂ = ⊥

/-- Decomposability in D.2.16, including nontriviality of both group factors. -/
def IsRatioDecomposable (ρ : Representation (ZMod 2) G V) : Prop :=
  ∃ G₁ G₂ V₁ V₂, G₁ ≠ ⊥ ∧ G₂ ≠ ⊥ ∧ IsRatioSum ρ G₁ G₂ V₁ V₂

/-- Indecomposability in D.2.16. -/
def IsRatioIndecomposable (ρ : Representation (ZMod 2) G V) : Prop :=
  ¬ IsRatioDecomposable ρ

variable (ρ : Representation (ZMod 2) G V)

theorem iteratedCommutator_mono {A B : Subgroup G} (hBA : B ≤ A) (k : ℕ) :
    iteratedCommutator ρ B k ≤ iteratedCommutator ρ A k := by
  induction k with
  | zero => exact le_rfl
  | succ k ih =>
    apply Submodule.span_le.mpr
    rintro _ ⟨b, hb, v, hv, rfl⟩
    exact Submodule.subset_span ⟨b, hBA hb, v, ih hv, rfl⟩

theorem iteratedCommutator_two_eq_bot_iff (A : Subgroup G) :
    iteratedCommutator ρ A 2 = ⊥ ↔ IsQuadratic ρ A := by
  rw [iteratedCommutator, subspaceCommutator_eq_bot_iff]
  constructor
  · intro h a ha b hb v
    exact h (Submodule.subset_span ⟨b, hb, v, Submodule.mem_top, rfl⟩) ⟨a, ha⟩
  · intro h
    apply Submodule.span_le.mpr
    rintro _ ⟨b, hb, v, _, rfl⟩ a
    exact h a a.property b hb v

theorem iteratedCommutator_three_eq_bot_iff (A : Subgroup G) :
    iteratedCommutator ρ A 3 = ⊥ ↔ IsCubic ρ A :=
  (isCubic_iff_commutator_eq_bot ρ A).symm

theorem iteratedRatio_two : iteratedRatio ρ 2 = quadraticRatio ρ := by
  simp only [iteratedRatio, quadraticRatio, iteratedCommutator_two_eq_bot_iff]

theorem iteratedRatio_three : iteratedRatio ρ 3 = cubicRatio ρ := by
  simp only [iteratedRatio, cubicRatio, iteratedCommutator_three_eq_bot_iff]

theorem Q_eq_RIterated : Q ρ = RIterated ρ 2 2 := by
  ext A
  simp only [Q, RIterated, R, Set.mem_ofPred_eq, iteratedCommutator_two_eq_bot_iff]
  tauto

theorem Qhat_eq_RIterated : Qhat ρ = RIterated ρ 3 2 := by
  ext A
  simp only [Qhat, RIterated, R, Set.mem_ofPred_eq, iteratedCommutator_three_eq_bot_iff]
  tauto

theorem iteratedRatio_le (k : ℕ) {A : Subgroup G}
    (hA : IsElementaryTwo A) (hk : iteratedCommutator ρ A k = ⊥) :
    iteratedRatio ρ k ≤ actionRatio ρ A :=
  iInf_le_of_le A (iInf_le_of_le ⟨hA, hk⟩ le_rfl)

/-- D.2.3(1): equal-ratio subgroups inherit the local minimum property. -/
theorem RPlus.of_equal_ratio {A B : Subgroup G} (hA : A ∈ RPlus ρ)
    (hBA : B ≤ A) (hB : B ≠ ⊥) (heq : actionRatio ρ B = actionRatio ρ A) :
    B ∈ RPlus ρ := by
  refine ⟨hA.1.of_le hBA hB, fun C hCB hC => ?_⟩
  rw [heq]
  exact hA.2 C (hCB.trans hBA) hC

/-- D.2.3(2): attaining the global iterated minimum implies local minimality. -/
theorem RPlus.of_iterated_minimum {A : Subgroup G} (hA : IsElementaryTwo A)
    (k : ℕ) (hk : iteratedCommutator ρ A k = ⊥)
    (heq : actionRatio ρ A = iteratedRatio ρ k) : A ∈ RPlus ρ := by
  refine ⟨hA, fun B hBA hB => ?_⟩
  rw [heq]
  exact iteratedRatio_le ρ k (hA.of_le hBA hB)
    (le_bot_iff.mp ((iteratedCommutator_mono ρ hBA k).trans_eq hk))

variable [Finite G]

/-- Finite minima are attained, and an empty family cannot satisfy a finite bound. -/
theorem iteratedRatio_le_iff (k : ℕ) {r : ℝ≥0∞} (hr : r ≠ ⊤) :
    iteratedRatio ρ k ≤ r ↔ (RIterated ρ k r).Nonempty := by
  classical
  constructor
  · intro h
    let S := {A : Subgroup G // IsElementaryTwo A ∧ iteratedCommutator ρ A k = ⊥}
    by_cases hS : Nonempty S
    · let : Nonempty S := hS
      obtain ⟨A, hA⟩ := exists_eq_ciInf_of_finite (f := fun A : S => actionRatio ρ A.val)
      rw [iInf_subtype] at hA
      exact ⟨A, ⟨A.property.1, hA.trans_le h⟩, A.property.2⟩
    · have ht : iteratedRatio ρ k = ⊤ := by
        apply iInf_eq_top.mpr
        intro A
        apply iInf_eq_top.mpr
        intro hA
        exact (hS ⟨⟨A, hA⟩⟩).elim
      exact (hr (top_le_iff.mp (ht ▸ h))).elim
  · rintro ⟨A, ⟨hA, hrA⟩, hk⟩
    exact (iteratedRatio_le ρ k hA hk).trans hrA

theorem Q_nonempty_iff : (Q ρ).Nonempty ↔ quadraticRatio ρ ≤ 2 := by
  rw [Q_eq_RIterated, ← iteratedRatio_le_iff ρ 2 (by simp), iteratedRatio_two]

theorem Qhat_nonempty_iff : (Qhat ρ).Nonempty ↔ cubicRatio ρ ≤ 2 := by
  rw [Qhat_eq_RIterated, ← iteratedRatio_le_iff ρ 3 (by simp), iteratedRatio_three]

/-- Each minimum actor contains an inclusion-minimal minimum actor. -/
theorem QhatMin.exists_minimal {A : Subgroup G} (hA : A ∈ QhatMin ρ) :
    ∃ B ≤ A, B ∈ QhatStar ρ := by
  let S : Set (Subgroup G) := {B | B ∈ QhatMin ρ ∧ B ≤ A}
  obtain ⟨B, hB, hmin⟩ := Set.exists_min_image S (fun B => Nat.card B)
    (Set.toFinite _) ⟨A, hA, le_rfl⟩
  refine ⟨B, hB.2, hB.1, fun C hC hCB => ?_⟩
  exact Subgroup.eq_of_le_of_card_ge hCB (hmin C ⟨hC, hCB.trans hB.2⟩)

/-- D.2.1's starred family has a genuine witness exactly at a finite bound of two. -/
theorem QhatStar_nonempty_iff : (QhatStar ρ).Nonempty ↔ cubicRatio ρ ≤ 2 := by
  constructor
  · rintro ⟨A, hA⟩
    exact hA.1.1
  · intro h
    obtain ⟨A, hA, hc, hr⟩ := (cubicRatio_le_iff ρ (ne_top_of_le_ne_top (by simp) h)).mp le_rfl
    have hmin : A ∈ QhatMin ρ := ⟨h, hA, hc,
      le_antisymm hr (iInf_le_of_le A (iInf_le_of_le ⟨hA, hc⟩ le_rfl))⟩
    obtain ⟨B, _, hB⟩ := QhatMin.exists_minimal ρ hmin
    exact ⟨B, hB⟩

end CFSG.Quasithin.ChapterD
