/-!
# Minimal quadratic actors on component constituents

A locally minimum action-ratio actor retains its bound on each actual
noncentral invariant action image by D.2.5. If it moves a member of an
independent constituent orbit, quadraticity makes the orbit image have
order two. The ratio bound then forces that constituent to have dimension
at most two, excluding nontrivial perfect component constituents.

The same argument allows kernels on the individual component. Homogeneous
central-image independence lifts whenever the constituent has no fixed
vectors. The final consumer gives the bound in the literal faithful image
of the subgroup generated by the component and the actor, ready for the
B.4 classifier. No faithful projection to the component is assumed.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), D.2.5,
p.179, and the component-preserving branch of D.3.6–D.3.7, pp.196–199.
-/

public noncomputable section
open Subgroup Representation Representation.BinaryOffender
open scoped IsMulCommutative ENNReal
namespace CFSG.Quasithin.ChapterD
variable {G V : Type*} [Group G] [Finite G] [AddCommGroup V] [Module (ZMod 2) V]
  (ρ : Representation (ZMod 2) G V)

theorem exists_RPlusBound_subgroup {A : Subgroup G} (hA : IsElementaryTwo A)
    {r : ℝ≥0∞} (hr : actionRatio ρ A ≤ r) :
    ∃ C ≤ A, C ∈ RPlusBound ρ r := by
  let S : Set (Subgroup G) := {C | C ≤ A ∧ C ≠ ⊥}
  obtain ⟨C,hC,hmin⟩ := Set.exists_min_image S (actionRatio ρ)
    (Set.toFinite _) ⟨A,le_rfl,hA.1⟩
  have he := hA.of_le hC.1 hC.2
  exact ⟨C,hC.1,⟨he,(hmin A ⟨le_rfl,hA.1⟩).trans hr⟩,
    he,fun B hBC hB => hmin B ⟨hBC.trans hC.1,hB⟩⟩

open Representation.BinaryOffender.Homogeneous

omit [Finite G] in
theorem quadratic_moving_restricted_card_eq_two
    (I : Submodule (ZMod 2) V) (hI : I ≠ ⊥) (A : Subgroup G)
    (hA : IsElementaryTwo A) (hq : IsQuadratic ρ A)
    (hind : sSupIndep (subspaceOrbit ρ A I))
    {a : G} (ha : a ∈ A) (haI : I.map (ρ a) ≠ I) :
    Nat.card (restrictedSubgroup ρ (orbitSpan ρ A I) A) = 2 := by
  classical
  let : IsElementaryAbelian 2 A := hA.2
  let W := orbitSpan ρ A I
  have hW := orbitSpan_invariant ρ A I
  let f := subgroupActionHom ρ W A hW
  have ha2 : a * a = 1 := by
    simpa only [pow_two] using elemPow_eq_one_of_isElementaryAbelian (p := 2) a ha
  have hImem : I ∈ subspaceOrbit ρ A I := by
    refine ⟨1, ?_⟩
    simp only [Subgroup.coe_one, map_one, Module.End.one_eq_id, Submodule.map_id]
  have hdis : Disjoint I (I.map (ρ a)) :=
    hind.pairwiseDisjoint hImem ⟨⟨a,ha⟩,rfl⟩ haI.symm
  have hfix {b : G} (hb : b ∈ A) (hbI : I.map (ρ b) = I) : f ⟨b,hb⟩ = 1 := by
    have hbs := (subspace_map_eq_iff ρ I b).mp hbI
    have hfixI := quadratic_fixes_disjoint_summand ρ I hq ha hb hdis
      (fun v hv => (hbs v).2 hv)
    have hfixW : W ≤ (ρ b - LinearMap.id).ker := by
      apply iSup_le
      rintro t _ ⟨v,hv,rfl⟩
      change ρ b (ρ t v) - ρ t v = 0
      have hbt : b * (t : G) = (t : G) * b :=
        congrArg Subtype.val (mul_comm (⟨b,hb⟩ : A) t)
      rw [← Module.End.mul_apply, ← map_mul, hbt, map_mul,
        Module.End.mul_apply, hfixI v hv, sub_self]
    apply subspaceImageRepresentation_injective ρ W
    ext w
    exact sub_eq_zero.mp (hfixW w.property)
  have hfa : f ⟨a,ha⟩ ≠ 1 := by
    intro he
    apply haI
    apply (subspace_map_eq_iff ρ I a).mpr
    intro v
    have hf : ∀ w ∈ I, ρ a w = w := by
      intro w hw
      exact congrArg (fun x => (subspaceImageRepresentation ρ W x
        ⟨w,le_orbitSpan ρ A I hw⟩ : V)) he
    constructor
    · intro hv
      have hev := hf (ρ a v) hv
      rw [← Module.End.mul_apply, ← map_mul, ha2, map_one, Module.End.one_apply] at hev
      exact hev ▸ hv
    · intro hv
      rwa [hf v hv]
  have htwo (b : A) : f b = 1 ∨ f b = f ⟨a,ha⟩ := by
    rcases quadratic_orbit_eq_self_or_moving ρ I hI A hq hind ha ha2 haI b.property with hb | hb
    · exact Or.inl (hfix b.property hb)
    · right
      have hab : I.map (ρ (a * b)) = I := by
        rw [subspace_map_mul, hb, ← subspace_map_mul, ha2]
        simp only [map_one, Module.End.one_eq_id, Submodule.map_id]
      have hf := hfix (A.mul_mem ha b.property) hab
      change f (⟨a,ha⟩ * b) = 1 at hf
      rw [map_mul] at hf
      have hf2 : f ⟨a,ha⟩ * f ⟨a,ha⟩ = 1 := by
        rw [← map_mul]
        have haa : (⟨a,ha⟩ : A) * ⟨a,ha⟩ = 1 := Subtype.ext ha2
        rw [haa,map_one]
      exact mul_left_cancel (hf.trans hf2.symm)
  rw [← subgroupActionHom_range ρ W A hW]
  apply Nat.card_eq_two_iff.mpr
  refine ⟨1,f.rangeRestrict ⟨a,ha⟩,?_,?_⟩
  · intro he
    exact hfa (congrArg Subtype.val he).symm
  · apply Set.eq_univ_of_forall
    rintro ⟨b,c,rfl⟩
    rcases htwo c with hc | hc
    · have he : f.rangeRestrict c = 1 := Subtype.ext hc
      exact Or.inl he
    · have he : f.rangeRestrict c = f.rangeRestrict ⟨a,ha⟩ := Subtype.ext hc
      exact Or.inr he

theorem RPlusBound.quadratic_stabilizes_of_independent_orbit
    [FiniteDimensional (ZMod 2) V]
    {A : Subgroup G} (hA : A ∈ RPlusBound ρ 2)
    (hq : IsQuadratic ρ A) (I : Submodule (ZMod 2) V)
    (hind : sSupIndep (subspaceOrbit ρ A I))
    (hdim : 2 < Module.finrank (ZMod 2) I) :
    A ≤ subspaceStabilizer ρ I := by
  intro a ha
  apply (subspace_map_eq_iff ρ I a).mp
  by_contra hm
  have hI : I ≠ ⊥ := Submodule.nontrivial_iff_ne_bot.mp
    (Module.nontrivial_of_finrank_pos (by omega : 0 < Module.finrank (ZMod 2) I))
  let W := orbitSpan ρ A I
  have hW := orbitSpan_invariant ρ A I
  have hIW : I ≤ W := le_orbitSpan ρ A I
  have hImem : I ∈ subspaceOrbit ρ A I := by
    refine ⟨1, ?_⟩
    simp only [Subgroup.coe_one,map_one,Module.End.one_eq_id,Submodule.map_id]
  have hdis : Disjoint I (I.map (ρ a)) :=
    hind.pairwiseDisjoint hImem ⟨⟨a,ha⟩,rfl⟩ (Ne.symm hm)
  have hdf : Disjoint I (W ⊓ fixedSpace ρ A) := by
    apply Submodule.disjoint_def.mpr
    intro v hv hf
    exact Submodule.disjoint_def.mp hdis v hv ⟨v,hv,hf.2 ⟨a,ha⟩⟩
  have hn : ¬ W ≤ fixedSpace ρ A := by
    intro hf
    apply hI
    exact le_bot_iff.mp (fun v hv => Submodule.disjoint_def.mp hdf v hv ⟨hIW hv,hf (hIW hv)⟩)
  have hb := RPlusBound.restricted ρ hA W hW hn
  have hcard := quadratic_moving_restricted_card_eq_two ρ I hI A hA.1.1 hq hind ha hm
  have hr : rank (restrictedSubgroup ρ W A) = 1 := by
    change Nat.log 2 (Nat.card (restrictedSubgroup ρ (orbitSpan ρ A I) A)) = 1
    rw [hcard]; decide
  have hc := (actionRatio_le_nat_iff _ hb.1 2).mp hb.2
  rw [hr,fixedCodim_restrictedSubgroup ρ W A hW] at hc
  have he := I.finrank_sup_add_finrank_inf_eq (W ⊓ fixedSpace ρ A)
  rw [hdf.eq_bot,finrank_bot,add_zero] at he
  have hd : Module.finrank (ZMod 2) (I ⊔ (W ⊓ fixedSpace ρ A) : Submodule (ZMod 2) V) ≤ Module.finrank (ZMod 2) W :=
    Submodule.finrank_mono (sup_le hIW inf_le_left)
  omega

end CFSG.Quasithin.ChapterD

namespace Representation.BinaryOffender.Homogeneous
variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]
  (ρ : Representation (ZMod 2) G V)

theorem IsIrrPlusWith.independent_orbit_of_inf_fixedSpace_eq_bot
    {K A : Subgroup G} {I : Submodule (ZMod 2) V}
    (hI : IsIrrPlusWith ρ K A I) (hfix : I ⊓ fixedSpace ρ K = ⊥) :
    sSupIndep (subspaceOrbit ρ A I) := by
  classical
  let q := (fixedSpace ρ K).mkQ
  let S := quotientImage ρ K I hI.invariant
  let Ω := centralOrbit ρ K A hI.normalizes S
  let f : subspaceOrbit ρ A I → Ω := fun J =>
    ⟨centralRightConjugate ρ K A hI.normalizes S (Classical.choose J.property)⁻¹,
      ⟨(Classical.choose J.property)⁻¹,rfl⟩⟩
  have hfmap (J : subspaceOrbit ρ A I) : (f J).val.toSubmodule = J.val.map q := by
    change (centralRightConjugate ρ K A hI.normalizes S
      (Classical.choose J.property)⁻¹).toSubmodule = J.val.map q
    rw [centralRightConjugate_toSubmodule]
    change (I.map q).map (normalizerQuotientRepresentation ρ K
      ⟨((Classical.choose J.property : A)⁻¹ : G)⁻¹,_⟩) = _
    rw [← quotientImage_map_normalizer]
    simp only [inv_inv]
    exact congrArg (fun N : Submodule (ZMod 2) V => N.map q)
      (Classical.choose_spec J.property)
  have hJ (J : subspaceOrbit ρ A I) : IsIrrPlus ρ K J.val := by
    obtain ⟨a,ha⟩ := J.property
    exact ha ▸ hI.isIrrPlus.map_normalizer ρ (hI.normalizes a.property)
  have hfinj : Function.Injective f := by
    intro J L he
    apply Subtype.ext
    have hmap := (hfmap J).symm.trans
      ((congrArg (fun U : Ω => U.val.toSubmodule) he).trans (hfmap L))
    exact le_antisymm
      (le_of_quotientImage_le ρ (hJ J).choose_spec.1 (hJ L).choose hmap.le)
      (le_of_quotientImage_le ρ (hJ L).choose_spec.1 (hJ J).choose hmap.ge)
  have hind := (hI.orbit_decomposition ρ).1.comp hfinj
  change iSupIndep (fun J : subspaceOrbit ρ A I => (f J).val.toSubmodule) at hind
  simp only [hfmap] at hind
  apply (sSupIndep_iff _).mpr
  intro J
  apply Submodule.disjoint_def.mpr
  intro v hv hs
  have hqv : q v = 0 := by
    apply Submodule.disjoint_def.mp (hind J) (q v) ⟨v,hv,rfl⟩
    have hm : q v ∈ (⨆ L : subspaceOrbit ρ A I, ⨆ (_ : L ≠ J), L.val).map q :=
      ⟨v,hs,rfl⟩
    simpa only [Submodule.map_iSup] using hm
  have hvf : v ∈ fixedSpace ρ K := (Submodule.Quotient.mk_eq_zero _).mp hqv
  obtain ⟨a,ha⟩ := J.property
  rw [← ha] at hv
  obtain ⟨w,hw,rfl⟩ := hv
  have hwf : w ∈ fixedSpace ρ K :=
    (normalizer_le_fixedSpace_stabilizer ρ K (hI.normalizes a.property) w).mp hvf
  have hw0 : w = 0 := by
    have hz : w ∈ I ⊓ fixedSpace ρ K := ⟨hw,hwf⟩
    rwa [hfix] at hz
  rw [hw0,map_zero]

theorem IsIrrPlusWith.minimal_quadratic_stabilizes
    [Finite G] [FiniteDimensional (ZMod 2) V]
    {K A : Subgroup G} [Group.IsPerfect K] {I : Submodule (ZMod 2) V}
    (hI : IsIrrPlusWith ρ K A I) (hfix : I ⊓ fixedSpace ρ K = ⊥)
    (hA : A ∈ CFSG.Quasithin.ChapterD.RPlusBound ρ 2)
    (hq : IsQuadratic ρ A) : A ≤ subspaceStabilizer ρ I :=
  CFSG.Quasithin.ChapterD.RPlusBound.quadratic_stabilizes_of_independent_orbit ρ hA hq I
    (hI.independent_orbit_of_inf_fixedSpace_eq_bot ρ hfix)
    (hI.isIrrPlus.finrank_gt_two ρ K)

end Representation.BinaryOffender.Homogeneous

namespace Representation.BinaryOffender
variable {G V : Type*} [Group G] [Finite G] [AddCommGroup V] [Module (ZMod 2) V]
  [FiniteDimensional (ZMod 2) V] (ρ : Representation (ZMod 2) G V)

omit [Finite G] [FiniteDimensional (ZMod 2) V] in
theorem isIrrPlus_of_simple_noncentral (K : Subgroup G) [Group.IsPerfect K]
    (S : Subrepresentation (ρ.comp K.subtype)) (hS : IsIrreducible S.toRepresentation)
    (hn : ¬ S.toSubmodule ≤ fixedSpace ρ K) : IsIrrPlus ρ K S.toSubmodule := by
  have hs : K ≤ subspaceStabilizer ρ S.toSubmodule :=
    le_subspaceStabilizer ρ _ (fun k hk v hv => S.apply_mem_toSubmodule ⟨k,hk⟩ hv)
  have hm (J : Submodule (ZMod 2) V) (hJ : K ≤ subspaceStabilizer ρ J)
      (hJS : J ≤ S.toSubmodule) : J = S.toSubmodule ∨ J ≤ fixedSpace ρ K := by
    let U := invariantSubspace ρ K J hJ
    by_cases hU : U = ⊥
    · right
      have he : J = ⊥ := congrArg Subrepresentation.toSubmodule hU
      rw [he]
      exact bot_le
    · left
      have he : U = S := (((Subrepresentation.irreducible_iff_isAtom S).mp hS).le_iff_eq hU).mp hJS
      exact congrArg Subrepresentation.toSubmodule he
  have hc : subspaceCommutator ρ S.toSubmodule K = S.toSubmodule := by
    rcases hm _ (subspaceCommutator_invariant ρ _ K)
      (subspaceCommutator_le_of_invariant ρ hs) with he | hf
    · exact he
    · exact (hn (le_fixedSpace_of_commutator_le_fixedSpace ρ K S.toSubmodule hs hf)).elim
  exact isIrrPlus_of_minimal ρ hs hc hn hm

omit [FiniteDimensional (ZMod 2) V] in
theorem quadraticRatio_image_invariantSubspace_le_two
    (D C : Subgroup G) (I : Submodule (ZMod 2) V)
    (hD : D ≤ subspaceStabilizer ρ I) (hCD : C ≤ D)
    (hC : IsElementaryTwo (restrictedSubgroup ρ I C))
    (hq : IsQuadratic ρ C)
    (hc : actionRatio (subspaceImageRepresentation ρ I) (restrictedSubgroup ρ I C) ≤ 2) :
    quadraticRatio (imageRepresentation (invariantSubspace ρ D I hD).toRepresentation) ≤ 2 := by
  let σ : Representation (ZMod 2) D I := (invariantSubspace ρ D I hD).toRepresentation
  let R := restrictedSubgroup ρ I C
  let Q := actionSubgroup σ (C.subgroupOf D)
  have hRQ : R.map (subspaceActionImage ρ I).subtype = Q.map (actionImage σ).subtype := by
    ext x
    constructor
    · rintro ⟨y,⟨c,hc,rfl⟩,rfl⟩
      refine ⟨actionHom σ ⟨c,hCD hc⟩,⟨⟨c,hCD hc⟩,hc,rfl⟩,?_⟩
      apply Units.ext
      ext v
      rfl
    · rintro ⟨y,⟨c,hc,rfl⟩,rfl⟩
      refine ⟨subspaceActionHom ρ I ⟨c,hD c.property⟩,
        ⟨⟨c,hD c.property⟩,hc,rfl⟩,?_⟩
      apply Units.ext
      ext v
      rfl
  have hrank : rank R = rank Q := by
    unfold rank
    congr 1
    rw [← Subgroup.card_map_of_injective (subspaceActionImage ρ I).subtype_injective,
      hRQ]
    exact Subgroup.card_map_of_injective (actionImage σ).subtype_injective
  have hzero : Q ≠ ⊥ := by
    intro he
    apply hC.1
    apply Subgroup.map_injective (subspaceActionImage ρ I).subtype_injective
    rw [hRQ,he,Subgroup.map_bot,Subgroup.map_bot]
  have helem : IsElementaryAbelian 2 Q := by
    let : IsElementaryAbelian 2 R := hC.2
    let : IsElementaryAbelian 2 (R.map (subspaceActionImage ρ I).subtype) :=
      IsElementaryAbelian.map _
    let hE : IsElementaryAbelian 2 (Q.map (actionImage σ).subtype) :=
      hRQ ▸ (inferInstance : IsElementaryAbelian 2 (R.map (subspaceActionImage ρ I).subtype))
    exact IsElementaryAbelian.of_injective
      (Subgroup.equivMapOfInjective Q (actionImage σ).subtype
        (actionImage σ).subtype_injective).toMonoidHom
      (Subgroup.equivMapOfInjective Q (actionImage σ).subtype
        (actionImage σ).subtype_injective).injective
  have hfix : fixedSpace (imageRepresentation σ) Q =
      fixedSpace (subspaceImageRepresentation ρ I) R := by
    rw [fixedSpace_actionSubgroup, fixedSpace_restrictedSubgroup ρ I C (hCD.trans hD)]
    ext v
    constructor
    · intro hv c
      exact congrArg Subtype.val (hv ⟨⟨c,hCD c.property⟩,c.property⟩)
    · intro hv c
      exact Subtype.ext (hv ⟨c.val,c.property⟩)
  apply (quadraticRatio_le_two_iff _).mpr
  refine ⟨Q,⟨hzero,helem⟩,?_,?_⟩
  · rintro a ⟨a,ha,rfl⟩ b ⟨b,hb,rfl⟩ v
    exact Subtype.ext (hq a.val ha b.val hb v)
  · have hd := (actionRatio_le_nat_iff _ hC 2).mp hc
    change fixedCodim (subspaceImageRepresentation ρ I) R ≤ 2 * rank R at hd
    change fixedCodim (imageRepresentation σ) Q ≤ 2 * rank Q
    have hcodim : fixedCodim (imageRepresentation σ) Q =
        fixedCodim (subspaceImageRepresentation ρ I) R :=
      congrArg (fun F : Submodule (ZMod 2) I => Module.finrank (ZMod 2) (I ⧸ F)) hfix
    rw [hcodim,←hrank]
    exact hd

end Representation.BinaryOffender

namespace CFSG.Quasithin.ChapterD
open Representation.BinaryOffender.Homogeneous
variable {G V : Type*} [Group G] [Finite G] [AddCommGroup V] [Module (ZMod 2) V]
  [FiniteDimensional (ZMod 2) V] (ρ : Representation (ZMod 2) G V)

theorem stable_section_image_bound
    {K C : Subgroup G} [Theory.GroupTheory.IsQuasisimple K]
    {I : Submodule (ZMod 2) V} (hI : IsIrrPlusWith ρ K C I)
    (hfix : I ⊓ fixedSpace ρ K = ⊥) (hZ : center K = ⊥)
    (hC : C ∈ RPlusBound ρ 2) (hq : IsQuadratic ρ C)
    (hn : ¬ C ≤ centralizer (K : Set G)) :
    ∃ hD : K ⊔ C ≤ subspaceStabilizer ρ I,
      quadraticRatio (imageRepresentation (invariantSubspace ρ (K ⊔ C) I hD).toRepresentation) ≤ 2 := by
  have hs := hI.minimal_quadratic_stabilizes ρ hfix hC hq
  have hnI : ¬ I ≤ fixedSpace ρ C := by
    intro hf
    apply hn
    intro c hc
    exact centralizes_of_fixes_faithful_section ρ K I hI.invariant
      (hI.isIrrPlus.component_faithful ρ K hZ) (hI.normalizes hc)
      (fun v hv => hf hv ⟨c,hc⟩)
  have hb := RPlusBound.restricted ρ hC I hs hnI
  refine ⟨sup_le hI.invariant hs,?_⟩
  exact quadraticRatio_image_invariantSubspace_le_two ρ (K ⊔ C) C I
    (sup_le hI.invariant hs) le_sup_right hb.1 hq hb.2

end CFSG.Quasithin.ChapterD
