module

public import Theory.ElementaryAbelian.Basic
public import Theory.PGroupCore
public import Mathlib.GroupTheory.Sylow
public import Mathlib.GroupTheory.Subgroup.Centralizer

/-!
# The subgroup configuration for the qrc-Lemma

These definitions express Hypothesis D.1.1 of Aschbacher–Smith, *The
Classification of Quasithin Groups*, combined manuscript of 1 March 2004,
printed pp. 171–172. All subgroups are embedded in the same ambient group,
which need not itself be finite. The action image on the internal module
is used for the quotient by its centralizer.

`QRCConfiguration` records exactly the displayed hypotheses. In particular
it does not add a nontriviality assumption on V. Applications of the later
chief-factor argument must supply nontriviality separately: the printed
hypotheses alone also allow G₁ = T = V = 1 and G₂ of odd prime order.
-/

namespace CFSG.Quasithin.ChapterD

variable {G : Type*} [Group G]

/-- The ambient image of the 2-core of a subgroup. -/
@[expose] public noncomputable def twoCoreIn (H : Subgroup G) : Subgroup G :=
  (pCore 2 H).map H.subtype

/-- The faithful image of the conjugation action of H on V. -/
@[expose] public noncomputable def internalActionImage
    (H V : Subgroup G) (h : H ≤ (Subgroup.normalizer (V : Set G))) : Subgroup (MulAut V) :=
  (V.normalizerMonoidHom.comp (Subgroup.inclusion h)).range

/-- The subgroup generated by the H-conjugates of V, denoted ⟨Vᴴ⟩. -/
@[expose] public noncomputable def conjugateSpan
    (H V : Subgroup G) : Subgroup G :=
  ⨆ g : H, V.map (MulAut.conj (g : G)).toMonoidHom

/-- Hypothesis D.1.1, without implicit nontriviality conventions. -/
public structure QRCConfiguration (G₁ G₂ T V : Subgroup G) : Prop where
  finite_left : Finite G₁
  finite_right : Finite G₂
  sylow_left : ∃ S : Sylow 2 G₁, (S : Subgroup G₁).map G₁.subtype = T
  sylow_right : ∃ S : Sylow 2 G₂, (S : Subgroup G₂).map G₂.subtype = T
  module_le : V ≤ G₁
  module_normalized : G₁ ≤ (Subgroup.normalizer (V : Set G))
  module_elementary : IsElementaryAbelian 2 V
  module_reduced : pCore 2 (internalActionImage G₁ V module_normalized) = ⊥
  unique_maximal : ∃! M : Subgroup G₂, IsCoatom M ∧ T ≤ M.map G₂.subtype
  core_eq_centralizer : twoCoreIn G₁ = T ⊓ Subgroup.centralizer (V : Set G)
  no_common_normal : ∀ K : Subgroup G, K ≤ twoCoreIn G₁ →
    G₁ ⊔ G₂ ≤ (Subgroup.normalizer (K : Set G)) → K = ⊥

end CFSG.Quasithin.ChapterD
