module
public import CFSG.Quasithin.Chapter13.Section04.FixedCoreSource.LocalGeometry.OmegaIndexAt
public import CFSG.Quasithin.Chapter13.Section04.FixedCoreSource.LocalGeometry.NormalizerResidual
public import CFSG.Quasithin.Chapter13.Section04.FixedCoreSource.Solvable.LocalProduct.FirstFlagNormalizer
public import Theory.GroupTheory.IndexThreeResidual

/-!
# The original omega residual with ambient-local source inputs

The actual ordinary C-component in its full normalizer is O^{3'}(M).
The fixed-line centralizer puts C_G(Omega_1 Z(T)) in M. The original
omega decomposition and Sylow-fixed plane identify its intersection with
L as C_L(z). Intersecting the literal prime-to-three residual therefore
identifies the full omega-centralizer residual with the original L1.

The structural and recognition theorems are only invoked at the same G,T.
The ordinary two-core quotient remains explicit; it is not inferred from
the augmentation marking. FixedModuleAt applies this identity after
constructing the actual escaping omega point and its marking.
Source: Aschbacher--Smith 13.4.2(5),13.4.3, printed p.897.
-/

public noncomputable section
open Subgroup Theory.GroupTheory Stellmacher Representation BinaryPermutation
namespace CFSG.Quasithin.Chapter13.Section04.FixedCoreSource.LocalGeometry
open Chapter12.Section02 Chapter14.Section03.FaithfulSource Solvable
open Section08.TransvectionRecognition.Component.ModelExtension
universe u
variable {G : Type u} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}

/-- The ordinary clause of 13.4.2(5), with the full ambient embedding. -/
theorem normalizer_primeToThree_residual_at
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (structural : Structural1222At KnownSimple.IsKnownSimple T)
    (e : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 6)) :
    (primeToResidual 3 (normalizer (L : Set G))).map
      (normalizer (L : Set G)).subtype = L := by
  let : IsQuasisimple (L ⧸ pCore 2 L) := h.quasisimple
  have hc := h.source_normalizer_component_at structural
    (fun _ _ _ => ChapterA.Section02.theoremA_knownSimple)
    (fun _ _ _ => ChapterA.Section02.theoremC_knownSimple)
  have hs := h.source_normalizer_sqtk_at structural
    (fun _ _ _ => ChapterA.Section02.theoremA_knownSimple)
    (fun _ _ _ => ChapterA.Section02.theoremC_knownSimple)
  exact hc.map_primeToResidual_three_eq_of_quotient_alternating L.le_normalizer le_rfl
    (Or.inl rfl) e (hs.stronglyQuasithin 3 Nat.prime_three (by decide))

private theorem marked_sylow_fixed (D : ChosenModule T L V) (m : CoreMarking D) :
    ∃ P : Sylow 2 (alternatingGroup (Fin 6)), ∀ v : V,
      v.val ∈ omegaOneCenterAmbient (T : Subgroup G) →
      ∀ a ∈ (P : Subgroup (alternatingGroup (Fin 6))),
      BinaryPermutation.alternatingCoreRepresentation (Fin 6) a (m.coordinate v).toAdd =
        (m.coordinate v).toAdd := by
  let X := L ⊔ (T : Subgroup G)
  let N := L.subgroupOf X
  let : N.Normal := normal_subgroupOf_of_le_normalizer
    (sup_le L.le_normalizer D.sylow_normalizes_component)
  obtain ⟨S,hS⟩ := (T.subtype (show (T : Subgroup G) ≤ X from le_sup_right)).exists_subgroupOf_eq_of_normal N
  let e := subgroupOfEquivOfLe (show L ≤ X from le_sup_left)
  let q : N →* alternatingGroup (Fin 6) :=
    m.quotient.toMonoidHom.comp ((QuotientGroup.mk' (centralCore L)).comp e.toMonoidHom)
  have hq : Function.Surjective q := m.quotient.surjective.comp
    ((QuotientGroup.mk'_surjective _).comp e.surjective)
  refine ⟨S.mapSurjective hq,?_⟩
  intro v hv a ha
  obtain ⟨b,hb,rfl⟩ := ha
  have hbT : b.val.val ∈ (T : Subgroup G) := by
    rw [hS] at hb
    exact hb
  change BinaryPermutation.coreRepresentation (Fin 6)
    (m.quotient (QuotientGroup.mk' (centralCore L) (e b))).val (m.coordinate v).toAdd = _
  rw [← m.equivariant (e b) v]
  congr 2
  apply Subtype.ext
  change b.val.val * v.val * b.val.val⁻¹ = v.val
  exact mul_inv_eq_iff_eq_mul.mpr
    (((mem_omegaOneCenterAmbient_iff _ _).mp hv).2.2 b.val.val hbT)

omit [Finite G] in
private theorem marked_natural_nonzero (D : ChosenModule T L V) (m : CoreMarking D)
    (z : V) (hzL : z.val ∉ centralizer (L : Set G)) :
    BinaryPermutation.coreToNatural (Fin 6) (m.coordinate z).toAdd ≠ 0 := by
  intro he
  apply hzL
  apply (m.mem_fixed_iff z).mpr
  exact (Submodule.Quotient.mk_eq_zero _).mp (congrArg Subtype.val he)

/-- The literal Sylow-fixed plane is generated by z and the original fixed line. -/
theorem first_fixed_plane_eq_at (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (structural : Structural1222At KnownSimple.IsKnownSimple T)
    (D : ChosenModule T L V) (m : CoreMarking D)
    (z : V) (hz : z.val ∈ omegaOneCenterAmbient (T : Subgroup G))
    (hzL : z.val ∉ centralizer (L : Set G)) :
    V ⊓ omegaOneCenterAmbient (T : Subgroup G) =
      (V ⊓ centralizer (L : Set G)) ⊔ zpowers z.val := by
  let F := V ⊓ centralizer (L : Set G)
  have hFZ : F ≤ omegaOneCenterAmbient (T : Subgroup G) := by
    intro d hd
    apply (mem_omegaOneCenterAmbient_iff _ _).mpr
    let := D.elementary
    refine ⟨D.le_sylow hd.1,elemPow_eq_one_of_isElementaryAbelian d hd.1,?_⟩
    intro t ht
    exact (normalizer_component_le_fixed_centralizer_at h structural D m
      (D.sylow_normalizes_component ht) d hd).symm
  apply le_antisymm
  · obtain ⟨P,hP⟩ := marked_sylow_fixed D m
    intro v hv
    let w : V := ⟨v,hv.1⟩
    have ho := BinaryPermutation.core_sylow_fixed_quotient_or P
      (m.coordinate z).toAdd (m.coordinate w).toAdd (marked_natural_nonzero D m z hzL)
      (hP z hz) (hP w hv.2)
    rcases ho with ho | ho
    · apply mem_sup_left
      refine ⟨hv.1,(m.mem_fixed_iff w).mpr ?_⟩
      exact (Submodule.Quotient.mk_eq_zero _).mp (congrArg Subtype.val ho)
    · have hf : (w * z⁻¹).val ∈ F := by
        refine ⟨(w*z⁻¹).property,(m.mem_fixed_iff (w*z⁻¹)).mpr ?_⟩
        have he : BinaryPermutation.coreToNatural (Fin 6) (m.coordinate (w*z⁻¹)).toAdd = 0 := by
          rw [map_mul,map_inv,toAdd_mul,toAdd_inv,map_add,map_neg,ho,add_neg_cancel]
        exact (Submodule.Quotient.mk_eq_zero _).mp (congrArg Subtype.val he)
      have hh := (F ⊔ zpowers z.val).mul_mem (mem_sup_left hf) (mem_sup_right (mem_zpowers z.val))
      simpa only [coe_mul,coe_inv,inv_mul_cancel_right] using hh
  · exact sup_le (le_inf inf_le_left hFZ) (zpowers_le.mpr ⟨z.property,hz⟩)

/-- Identify the literal full omega-centralizer residual with the original first residual. -/
theorem ordinary_omega_residual_at
    (h₀ : Hypothesis1331 T L)
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (structural : Structural1222At KnownSimple.IsKnownSimple T)
    (D : ChosenModule T L V) (m : CoreMarking D)
    (earlier : Theorem12213At KnownSimple.IsKnownSimple T)
    (eL : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 6))
    (z : V) (hz : z.val ∈ omegaOneCenterAmbient (T : Subgroup G))
    (hzL : z.val ∉ centralizer (L : Set G)) :
    (primeToResidual 3 (centralizer (omegaOneCenterAmbient (T : Subgroup G) : Set G))).map
      (centralizer (omegaOneCenterAmbient (T : Subgroup G) : Set G)).subtype =
      firstCentralizerResidual L z.val := by
  let Z := omegaOneCenterAmbient (T : Subgroup G)
  let C := centralizer (Z : Set G)
  have hCM : C ≤ normalizer (L : Set G) := by
    rw [←fixed_generator_centralizer_at h structural D m
      ⟨m.constant.property,m.constant_fixed⟩
      (fun he => m.constant_ne_one (Subtype.ext he))]
    intro x hx
    exact mem_centralizer_singleton_iff.mpr
      (hx m.constant.val (m.constant_mem_central_four_at h structural).2).symm
  have hLC : L ⊓ C = L ⊓ centralizer ({z.val} : Set G) := by
    apply le_antisymm (inf_le_inf_left L (centralizer_le (Set.singleton_subset_iff.mpr hz)))
    rintro l ⟨hl,hzl⟩
    refine ⟨hl,?_⟩
    have hV : V ⊓ Z ≤ centralizer ({l} : Set G) := by
      rw [first_fixed_plane_eq_at h structural D m z hz hzL]
      apply sup_le
      · intro v hv
        exact mem_centralizer_singleton_iff.mpr (hv.2 l hl).symm
      · exact zpowers_le.mpr (mem_centralizer_singleton_iff.mpr
          (mem_centralizer_singleton_iff.mp hzl).symm)
    have hs : Z = (V ⊓ Z) ⊔ (Z ⊓ centralizer (L : Set G)) :=
      original_omega_decomposition_at h₀ h structural D m earlier
    have hZ : Z ≤ centralizer ({l} : Set G) := by
      rw [hs]
      exact sup_le hV (fun x hx => mem_centralizer_singleton_iff.mpr (hx.2 l hl).symm)
    exact fun x hx => mem_centralizer_singleton_iff.mp (hZ hx)
  have he := embedded_primeToResidual_intersection_of_le 3 (normalizer (L : Set G)) L C hCM
    (normalizer_primeToThree_residual_at h structural eL)
  rw [hLC] at he
  simpa only [firstCentralizerResidual_eq] using he

end CFSG.Quasithin.Chapter13.Section04.FixedCoreSource.LocalGeometry
