module
public import CFSG.Quasithin.Chapter13.Section04.FixedCoreSource.LocalGeometry.ComponentSixGeometryAt
public import CFSG.Quasithin.Chapter13.Section04.FixedCoreSource.Nonsolvable.ComponentFullSix

/-!
# The full selected-six orbit with structural facts at G,T

The original fixed-line calculation splits the full centralizer orbit into
its K-moved part and the line generated by z. Both full-orbit subgroups
are reduced. Thompson generation at the original G,T and the ordinary A₆
minimality theorem then identify the moved part with the selected module.
Thus C_G(z) normalizes that module and has the same central seed orbit as K.

The proof specializes the source argument in Nonsolvable/ComponentFullSix;
its intrinsic reduced-module minimality is reused unchanged. The following
centralizer module consumes the literal orbit and kernel identities. Both
natural and five-dimensional selected modules, the original |V|=32 and
full omega center are retained. Earlier Chapter 12/13.3 inputs remain explicit.
Source: Aschbacher--Smith B.2.14, B.5.1/6 and 13.4.10(7), printed p.909.
-/

public noncomputable section
open Subgroup Theory.GroupTheory Stellmacher
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter13.Section04.FixedCoreSource.LocalGeometry
open Chapter12.Section02 Chapter14.Section03.FaithfulSource Nonsolvable
universe u
variable {G : Type u} [Group G] [Finite G] {T : Sylow 2 G} {L K V : Subgroup G}

/-- The full centralizer orbit and its actual K-moved subgroup are reduced.
The latter is precisely the full-centralizer span of the previously constructed
component-moved orbit. Their literal action kernels agree. -/
theorem component_full_orbit_at
    (h₀ : Hypothesis1331 T L)
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (structural : Structural1222At KnownSimple.IsKnownSimple T)
    (D : ChosenModule T L V) (m : CoreMarking D)
    (hindex : ((omegaOneCenterAmbient (T : Subgroup G)) ⊓ centralizer (L : Set G)).relIndex
      (omegaOneCenterAmbient (T : Subgroup G)) = 2)
    (z : V) (hzT : z.val ∈ omegaOneCenterAmbient (T : Subgroup G))
    (hzL : z.val ∉ centralizer (L : Set G))
    (hKz : K ≤ centralizer ({z.val} : Set G))
    (hHN : centralizer ({z.val} : Set G) ≤ normalizer (K : Set G))
    (hKM : ¬ K ≤ normalizer (L : Set G)) :
    let H := centralizer ({z.val} : Set G)
    let Z := omegaOneCenterAmbient (T : Subgroup G)
    let U := ⁅conjugateSpanBy Z K,K⁆
    let W := conjugateSpanBy Z H
    let Q := ⁅W,K⁆
    IsPReduced 2 (W.subgroupOf H) ∧ IsPReduced 2 (Q.subgroupOf H) ∧
      Q = conjugateSpanBy U H ∧ W = Q ⊔ zpowers z.val ∧
      ⁅Q,K⁆ = Q ∧ Q ≠ ⊥ ∧ U ≤ Q ∧ Q ≤ W ∧
      H ≤ normalizer (Q : Set G) ∧
      H ⊓ centralizer (W : Set G) = H ⊓ centralizer (Q : Set G) := by
  let H := centralizer ({z.val} : Set G)
  let Z := omegaOneCenterAmbient (T : Subgroup G)
  let U := ⁅conjugateSpanBy Z K,K⁆
  let W := conjugateSpanBy Z H
  let Q := ⁅W,K⁆
  have hz1 : z.val ≠ 1 := fun he => hzL (he ▸ one_mem _)
  have hTH := Solvable.original_sylow_le_centralizer hzT
  have hTK := hTH.trans hHN
  have hZT : Z ≤ (T : Subgroup G) := fun _ hv => (mem_omegaOneCenterAmbient_iff _ _).mp hv |>.1
  have hZH : Z ≤ H := hZT.trans hTH
  have hsplit := component_seed_split h₀ hzT hz1 hKz hTK
  rw [component_full_fixed_line_at h structural z.val hz1 hzT hindex K hKz hKM] at hsplit
  obtain ⟨hW,hQ,hmove,hn,hUQ,hQW,hker⟩ := central_seed_overgroup_orbit Z K H U z.val
    hKz hHN le_rfl hzT hZH hsplit (component_moved_eq_commutator h₀ hzT hz1 hKz hTK)
  change Q = conjugateSpanBy U H at hQ
  rw [←hQ] at hW hmove hn hUQ hQW hker
  have hWH : W ≤ H := conjugateSpanBy_le_self hZH
  let : IsElementaryAbelian 2 Z := omegaOneCenterAmbient_elementaryAbelian _
  have hrW : IsPReduced 2 (W.subgroupOf H) := reduced_conjugateSpan_of_sylow_central
    T H Z hTH hZT (fun _ hv => (mem_omegaOneCenterAmbient_iff _ _).mp hv |>.2.2)
    (Chapter1.mem_He_iff.mp (Chapter1.lemma_1_1_4_6 T (h₀.qtke.evenCharacteristic T)
      (Solvable.centralizer_mem_HOver hzT hz1)))
  have hrQ : IsPReduced 2 (Q.subgroupOf H) := by
    let : (Q.subgroupOf H).Normal := normal_subgroupOf_of_le_normalizer hn
    let : (W.subgroupOf H).Normal := hrW.normal
    let : IsElementaryAbelian 2 (W.subgroupOf H) := hrW.elementary
    have hc : centralizer (Q.subgroupOf H : Set H) = centralizer (W.subgroupOf H : Set H) := by
      ext x
      constructor
      · intro hx w hw
        have hxQ : x.val ∈ centralizer (Q : Set G) := fun v hv =>
          congrArg Subtype.val (hx ⟨v,(hQW.trans hWH) hv⟩ hv)
        have hxW := hker.symm ▸ show x.val ∈ H ⊓ centralizer (Q : Set G) from ⟨x.property,hxQ⟩
        exact Subtype.ext (hxW.2 w.val hw)
      · intro hx v hv
        exact hx v (hQW hv)
    refine ⟨inferInstance,IsElementaryAbelian.of_le (show Q.subgroupOf H ≤ W.subgroupOf H from comap_mono hQW),?_⟩
    let e := QuotientGroup.quotientMulEquivOfEq hc
    apply (map_eq_bot_iff_of_injective _ (f := e.toMonoidHom) e.injective).mp
    rw [pCore_map_iso 2 e]
    exact hrW.quotient_pCore_eq_bot
  exact ⟨hrW,hrQ,hQ,hW,hmove,
    fun he => component_moved_ne_bot_at h structural m hKM (bot_unique (hUQ.trans_eq he)),
    hUQ,hQW,hn,hker⟩


/-- The full A₆ centralizer has the same moved module and seed orbit as K. -/
theorem ordinary_six_full_orbit_eq_at
    (h₀ : Hypothesis1331 T L)
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (structural : Structural1222At KnownSimple.IsKnownSimple T)
    (modules : Theorem1222ModulesAt KnownSimple.IsKnownSimple T)
    (D : ChosenModule T L V) (m : CoreMarking D)
    (h1332 : Section03.Noncentrality.SupercriticalSource.Source1332OneTwo T)
    (fixed : Section03.SourceCompletion.OriginalFixedModule1332At T L)
    (hindex : ((omegaOneCenterAmbient (T : Subgroup G)) ⊓ centralizer (L : Set G)).relIndex
      (omegaOneCenterAmbient (T : Subgroup G)) = 2)
    (z : V) (hzT : z.val ∈ omegaOneCenterAmbient (T : Subgroup G))
    (hzL : z.val ∉ centralizer (L : Set G))
    (hK : K ∈ Chapter1.cComponentsIn (centralizer ({z.val} : Set G)))
    (hHN : centralizer ({z.val} : Set G) ≤ normalizer (K : Set G))
    (hKM : ¬ K ≤ normalizer (L : Set G))
    (hfK : K ∈ MainForward.faithfulLocalComponents T)
    (eK : (K ⧸ pCore 2 K) ≃* alternatingGroup (Fin 6)) :
    let H := centralizer ({z.val} : Set G)
    let Z := omegaOneCenterAmbient (T : Subgroup G)
    ⁅conjugateSpanBy Z H,K⁆ = ⁅conjugateSpanBy Z K,K⁆ ∧
      conjugateSpanBy Z H = conjugateSpanBy Z K ∧
      H ≤ normalizer ((⁅conjugateSpanBy Z K,K⁆ : Subgroup G) : Set G) := by
  have hKz := hK.1
  let H := centralizer ({z.val} : Set G)
  let Z := omegaOneCenterAmbient (T : Subgroup G)
  let U := ⁅conjugateSpanBy Z K,K⁆
  let Q := ⁅conjugateSpanBy Z H,K⁆
  let A := K.subgroupOf H
  let B := Q.subgroupOf H
  let B₀ := U.subgroupOf H
  have hz1 : z.val ≠ 1 := fun hh => hzL (hh ▸ one_mem _)
  have hTH := Solvable.original_sylow_le_centralizer hzT
  have hTK := hTH.trans hHN
  let S := T.subtype hTH
  obtain ⟨_,hrQ,_,hsplit,hmove,hne,hUQ,hQW,hnQ,_⟩ := component_full_orbit_at h₀ h structural
    D m hindex z hzT hzL hKz hHN hKM
  have hQH : Q ≤ H := hQW.trans (Solvable.centralizerOmegaOrbit_le hzT)
  have hUH : U ≤ H := hUQ.trans hQH
  obtain ⟨DK,_,_,_,_,_,_,_,_,_⟩ := ordinary_six_component_geometry_at h₀ h structural modules
    D m h1332 fixed hindex z hzT hzL hK hHN hKM hfK eK
  let : A.Normal := normal_subgroupOf_of_le_normalizer hHN
  let : B.Normal := hrQ.normal
  let : IsElementaryAbelian 2 B := hrQ.elementary
  let a := subgroupOfEquivOfLe hKz
  let aq := QuotientGroup.congr _ _ a (pCore_map_iso 2 a)
  let b := subgroupOfEquivOfLe hQH
  let := component_quotient_quasisimple h1332 hfK
  have hqA : IsQuasisimple (A ⧸ pCore 2 A) := IsQuasisimple.of_mulEquiv aq.symm
  have hcomp : A.IsCComponent := by
    have ht : (⊤ : Subgroup K).IsCComponent := by
      have hh := hfK.1.1.subgroupOf_of_le (le_refl K) (show K ≤ K ⊔ (T : Subgroup G) from le_sup_left)
      simpa only [subgroupOf_self] using hh
    have htA : (⊤ : Subgroup A).IsCComponent := by
      simpa only [map_top_of_surjective a.symm.toMonoidHom a.symm.surjective] using ht.map_equiv a.symm
    have hh := htA.map_subtype (inferInstance : A.Normal).isSubnormal
    simpa only [←MonoidHom.range_eq_map,range_subtype] using hh
  have hSQ : IsSQTK KnownSimple.IsKnownSimple H :=
    h₀.qtke.involution_centralizer_sqtk (orderOf_eq_prime
      ((mem_omegaOneCenterAmbient_iff _ _).mp hzT).2.1 hz1)
  have hgenA : ⁅A,elementaryAbelianMaxJ (S : Subgroup H)⁆ = A := by
    apply map_injective H.subtype_injective
    rw [map_commutator,map_subgroupOf_eq_of_le hKz,
      ←elementaryAbelianMaxJ_map_injective H.subtype H.subtype_injective]
    change ⁅K,elementaryAbelianMaxJ (((T : Subgroup G).subgroupOf H).map H.subtype)⁆ = K
    rw [map_subgroupOf_eq_of_le hTH]
    exact component_thompson_generation_at (D := D) h₀ h structural h1332 hzT hHN hKM hfK
  have hBmove : ⁅B,A⁆ = B := by
    apply map_injective H.subtype_injective
    rw [map_commutator,map_subgroupOf_eq_of_le hQH,map_subgroupOf_eq_of_le hKz]
    exact hmove
  have hBne : B ≠ ⊥ := by
    intro hh
    have hm := congrArg (map H.subtype) hh
    rw [map_subgroupOf_eq_of_le hQH,Subgroup.map_bot] at hm
    exact hne hm
  have hmin := full_six_reduced_component_minimal S A B hSQ hrQ hcomp hqA
    (aq.trans eK) hgenA hBmove hBne
  have hB₀B : B₀ ≤ B := comap_mono hUQ
  have hn : A ≤ normalizer (B₀ : Set H) := by
    intro k hk
    apply mem_normalizer_iff.mpr
    intro v
    exact mem_normalizer_iff.mp (DK.normalizes hk) v.val
  have hB₀move : ⁅B₀,A⁆ = B₀ := by
    apply map_injective H.subtype_injective
    rw [map_commutator,map_subgroupOf_eq_of_le hUH,map_subgroupOf_eq_of_le hKz]
    exact component_moved_eq_commutator h₀ hzT hz1 hKz hTK
  have hB₀ne : B₀ ≠ ⊥ := by
    intro hh
    have hm := congrArg (map H.subtype) hh
    rw [map_subgroupOf_eq_of_le hUH,Subgroup.map_bot] at hm
    exact DK.ne_bot hm
  have heq : B₀ = B := (hmin B₀ hB₀B hn).resolve_right (by
    intro hc
    have hh := commutator_eq_bot_iff_le_centralizer.mpr hc
    rw [hB₀move] at hh
    exact hB₀ne hh)
  have hU : U = Q := by
    have hm := congrArg (map H.subtype) heq
    change (U.subgroupOf H).map H.subtype = (Q.subgroupOf H).map H.subtype at hm
    rwa [map_subgroupOf_eq_of_le hUH,map_subgroupOf_eq_of_le hQH] at hm
  have hseed := component_seed_split h₀ hzT hz1 hKz hTK
  rw [component_full_fixed_line_at h structural z.val hz1 hzT hindex K hKz hKM] at hseed
  refine ⟨hU.symm,?_,?_⟩
  · exact hsplit.trans ((congrArg (fun W : Subgroup G => W ⊔ zpowers z.val) hU.symm).trans hseed.symm)
  · change H ≤ normalizer (U : Set G)
    rw [hU]
    exact hnQ


end CFSG.Quasithin.Chapter13.Section04.FixedCoreSource.LocalGeometry
