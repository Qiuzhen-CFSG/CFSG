module
public import Theory.Representation.BinaryPermutation.SixCoreSylowWeights
public import Theory.GroupTheory.SylowNormalizedResidual
public import CFSG.Quasithin.Chapter13.Section04.FixedCoreSource.Solvable.LocalProduct.PairQuotient

/-!
# The original first flag normalizer

Restrict the original Sylow subgroup to L and map it through the literal
core marking. The natural quotient has one fixed line; this proves
V₁=V∩Ω₁Z(T)=⟨z,C_V(L)⟩. Weight separation in the five-dimensional core
then identifies N_LT(V₁) with C_LT(z), without assuming the size of V₁.

In the ordinary A₆ row, C_L(z)/O₂(C_L(z)) is S₃, so C_L(z) is a
{2,3}-group. Its prime-to-three residual and the original Sylow cover
C_LT(z), giving N_LT(V₁)=L₁T before the solvable local product is used.
FirstFlagCore uses this equality to recover the original R₁.

Source: Aschbacher–Smith Notation13.2.1, 13.3.4 and13.4.8,
printed pp.877,885,904–905. Earlier-source discharge remains with
qt-d-1341-fixed-core-source; the solvable assembly remains with
qt-d-1341-solvable-source.
-/

@[expose] public noncomputable section
open Subgroup Theory.GroupTheory Stellmacher
open scoped Pointwise
namespace CFSG.Quasithin.Chapter13.Section04.FixedCoreSource.Solvable
open Chapter12.Section02 Chapter14.Section03.FaithfulSource
open Section08.TransvectionRecognition.Component.ModelExtension
universe u
variable {G : Type u} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}

private theorem marked_sylow_fixed (D : ChosenModule T L V) (m : CoreMarking D) :
    ∃ P : Sylow 2 (alternatingGroup (Fin 6)), ∀ v : V,
      v.val ∈ omegaOneCenterAmbient (T : Subgroup G) →
      ∀ a ∈ (P : Subgroup (alternatingGroup (Fin 6))),
      BinaryPermutation.alternatingCoreRepresentation (Fin 6) a (m.coordinate v).toAdd =
        (m.coordinate v).toAdd := by
  let X := L ⊔ (T : Subgroup G)
  let N := L.subgroupOf X
  let : N.Normal := normal_subgroupOf_of_le_normalizer
    (sup_le L.le_normalizer D.sylow_normalizes_component)
  obtain ⟨S,hS⟩ := (T.subtype (show (T : Subgroup G) ≤ X from le_sup_right)).exists_subgroupOf_eq_of_normal N
  let e := subgroupOfEquivOfLe (show L ≤ X from le_sup_left)
  let q : N →* alternatingGroup (Fin 6) :=
    m.quotient.toMonoidHom.comp ((QuotientGroup.mk' (centralCore L)).comp e.toMonoidHom)
  have hq : Function.Surjective q := m.quotient.surjective.comp
    ((QuotientGroup.mk'_surjective _).comp e.surjective)
  refine ⟨S.mapSurjective hq,?_⟩
  intro v hv a ha
  obtain ⟨b,hb,rfl⟩ := ha
  have hbT : b.val.val ∈ (T : Subgroup G) := by
    rw [hS] at hb
    exact hb
  change BinaryPermutation.coreRepresentation (Fin 6)
    (m.quotient (QuotientGroup.mk' (centralCore L) (e b))).val (m.coordinate v).toAdd = _
  rw [← m.equivariant (e b) v]
  congr 2
  apply Subtype.ext
  change b.val.val * v.val * b.val.val⁻¹ = v.val
  exact mul_inv_eq_iff_eq_mul.mpr
    (((mem_omegaOneCenterAmbient_iff _ _).mp hv).2.2 b.val.val hbT)

omit [Finite G] in
private theorem marked_natural_nonzero (D : ChosenModule T L V) (m : CoreMarking D)
    (z : V) (hzL : z.val ∉ centralizer (L : Set G)) :
    BinaryPermutation.coreToNatural (Fin 6) (m.coordinate z).toAdd ≠ 0 := by
  intro he
  apply hzL
  apply (m.mem_fixed_iff z).mpr
  exact (Submodule.Quotient.mk_eq_zero _).mp (congrArg Subtype.val he)

/-- The literal Sylow-fixed plane is generated by z and the original fixed line. -/
theorem first_fixed_plane_eq (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (structural : Structural1222.{u} KnownSimple.IsKnownSimple)
    (D : ChosenModule T L V) (m : CoreMarking D)
    (z : V) (hz : z.val ∈ omegaOneCenterAmbient (T : Subgroup G))
    (hzL : z.val ∉ centralizer (L : Set G)) :
    V ⊓ omegaOneCenterAmbient (T : Subgroup G) =
      (V ⊓ centralizer (L : Set G)) ⊔ zpowers z.val := by
  let F := V ⊓ centralizer (L : Set G)
  have hFZ : F ≤ omegaOneCenterAmbient (T : Subgroup G) := by
    intro d hd
    apply (mem_omegaOneCenterAmbient_iff _ _).mpr
    let := D.elementary
    refine ⟨D.le_sylow hd.1,elemPow_eq_one_of_isElementaryAbelian d hd.1,?_⟩
    intro t ht
    exact (normalizer_component_le_fixed_centralizer h structural D m
      (D.sylow_normalizes_component ht) d hd).symm
  apply le_antisymm
  · obtain ⟨P,hP⟩ := marked_sylow_fixed D m
    intro v hv
    let w : V := ⟨v,hv.1⟩
    have ho := BinaryPermutation.core_sylow_fixed_quotient_or P
      (m.coordinate z).toAdd (m.coordinate w).toAdd (marked_natural_nonzero D m z hzL)
      (hP z hz) (hP w hv.2)
    rcases ho with ho | ho
    · apply mem_sup_left
      refine ⟨hv.1,(m.mem_fixed_iff w).mpr ?_⟩
      exact (Submodule.Quotient.mk_eq_zero _).mp (congrArg Subtype.val ho)
    · have hf : (w * z⁻¹).val ∈ F := by
        refine ⟨(w*z⁻¹).property,(m.mem_fixed_iff (w*z⁻¹)).mpr ?_⟩
        have he : BinaryPermutation.coreToNatural (Fin 6) (m.coordinate (w*z⁻¹)).toAdd = 0 := by
          rw [map_mul,map_inv,toAdd_mul,toAdd_inv,map_add,map_neg,ho,add_neg_cancel]
        exact (Submodule.Quotient.mk_eq_zero _).mp (congrArg Subtype.val he)
      have hh := (F ⊔ zpowers z.val).mul_mem (mem_sup_left hf) (mem_sup_right (mem_zpowers z.val))
      simpa only [coe_mul,coe_inv,inv_mul_cancel_right] using hh
  · exact sup_le (le_inf inf_le_left hFZ) (zpowers_le.mpr ⟨z.property,hz⟩)

/-- Normalizing the source plane inside LT is the same as centralizing z. -/
theorem first_flag_normalizer_eq_centralizer
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (structural : Structural1222.{u} KnownSimple.IsKnownSimple)
    (D : ChosenModule T L V) (m : CoreMarking D)
    (z : V) (hz : z.val ∈ omegaOneCenterAmbient (T : Subgroup G))
    (hzL : z.val ∉ centralizer (L : Set G)) :
    (L ⊔ (T : Subgroup G)) ⊓ normalizer (V ⊓ omegaOneCenterAmbient (T : Subgroup G) : Set G) =
      (L ⊔ (T : Subgroup G)) ⊓ centralizer ({z.val} : Set G) := by
  let W := V ⊓ omegaOneCenterAmbient (T : Subgroup G)
  have hTC : (T : Subgroup G) ≤ centralizer (W : Set G) := by
    intro t ht v hv
    exact (((mem_omegaOneCenterAmbient_iff _ _).mp hv.2).2.2 t ht).symm
  apply le_antisymm
  · intro x hx
    have hxprod : x ∈ (L : Set G) * ((T : Subgroup G) : Set G) := by
      rw [← coe_mul_of_right_le_normalizer_left L (T : Subgroup G) D.sylow_normalizes_component]
      exact hx.1
    obtain ⟨l,hl,t,ht,rfl⟩ := hxprod
    have hln : l ∈ normalizer (W : Set G) := by
      have hh := (normalizer (W : Set G)).mul_mem hx.2
        ((normalizer (W : Set G)).inv_mem (Subgroup.centralizer_le_normalizer _ (hTC ht)))
      simpa only [mul_inv_cancel_right] using hh
    let w := V.normalizerMonoidHom ⟨l,D.normalizes hl⟩ z
    have hw : w.val ∈ W := (mem_normalizer_iff.mp hln z.val).mp ⟨z.property,hz⟩
    obtain ⟨P,hP⟩ := marked_sylow_fixed D m
    have he : w = z := by
      apply m.coordinate.injective
      apply Multiplicative.toAdd.injective
      apply BinaryPermutation.core_sylow_fixed_eq_of_weight P _ _
        (marked_natural_nonzero D m z hzL) (hP z hz) (hP w hw.2)
      rw [m.equivariant ⟨l,hl⟩ z]
      exact (BinaryPermutation.wordWeight_permute
        (m.quotient (QuotientGroup.mk' (centralCore L) ⟨l,hl⟩)).val (m.coordinate z).toAdd.val).symm
    have hlc : l ∈ centralizer ({z.val} : Set G) := by
      apply mem_centralizer_singleton_iff.mpr
      exact (mul_inv_eq_iff_eq_mul.mp (congrArg Subtype.val he))
    exact ⟨hx.1,(centralizer ({z.val} : Set G)).mul_mem hlc (original_sylow_le_centralizer hz ht)⟩
  · intro x hx
    refine ⟨hx.1,?_⟩
    change x ∈ normalizer ((V ⊓ omegaOneCenterAmbient (T : Subgroup G) : Subgroup G) : Set G)
    rw [first_fixed_plane_eq h structural D m z hz hzL]
    have hxM : x ∈ normalizer (L : Set G) :=
      (sup_le L.le_normalizer D.sylow_normalizes_component) hx.1
    have hxF := Subgroup.centralizer_le_normalizer _
      (normalizer_component_le_fixed_centralizer h structural D m hxM)
    have hxz : x ∈ normalizer (zpowers z.val : Set G) := by
      apply Subgroup.centralizer_le_normalizer _
      rw [zpowers_eq_closure,centralizer_closure]
      exact hx.2
    exact normalizer_inf_normalizer_le_normalizer_sup _ _ ⟨hxF,hxz⟩

/-- The original component centralizer is a {2,3}-group in the ordinary row. -/
theorem component_centralizer_twoThree (D : ChosenModule T L V) (m : CoreMarking D)
    (e : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 6))
    (z : V) (hzL : z.val ∉ centralizer (L : Set G)) :
    IsPiGroup twoThreePrimes (L ⊓ centralizer ({z.val} : Set G) : Subgroup G) := by
  let C := L ⊓ centralizer ({z.val} : Set G)
  have hcore : IsPGroup 2 (centralCore L) := by
    rw [centralCore_eq_twoCore_of_ordinary e]
    exact pCore_isPGroup
  obtain ⟨f⟩ := component_centralizer_quotient D m hcore z hzL
  have hq : Nat.card (C ⧸ pCore 2 C) = 6 := by
    rw [Nat.card_congr f.toEquiv,Nat.card_eq_fintype_card,Fintype.card_perm,Fintype.card_fin]
    decide
  obtain ⟨n,hn⟩ := (pCore_isPGroup (p := 2) (G := C)).exists_card_eq
  rw [IsPiGroup_iff]
  intro p hp
  have hd : p.val ∣ 6 * 2^n := by
    rwa [card_eq_card_quotient_mul_card_subgroup (pCore 2 C),hq,hn] at hp
  change p.val = 2 ∨ p.val = 3
  rcases p.property.dvd_mul.mp hd with hd | hd
  · have hd' : p.val ∣ 2 * 3 := hd
    rcases p.property.dvd_mul.mp hd' with hd2 | hd3
    · exact Or.inl ((Nat.dvd_prime Nat.prime_two).mp hd2 |>.resolve_left p.property.ne_one)
    · exact Or.inr ((Nat.dvd_prime Nat.prime_three).mp hd3 |>.resolve_left p.property.ne_one)
  · exact Or.inl ((Nat.dvd_prime Nat.prime_two).mp
      (p.property.dvd_of_dvd_pow hd) |>.resolve_left p.property.ne_one)

/-- The centralizer in LT is L₁T, before constructing the product in C_G(z). -/
theorem local_centralizer_eq_firstResidual_sylow
    (D : ChosenModule T L V) (m : CoreMarking D)
    (e : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 6))
    (z : V) (hz : z.val ∈ omegaOneCenterAmbient (T : Subgroup G))
    (hzL : z.val ∉ centralizer (L : Set G)) :
    (L ⊔ (T : Subgroup G)) ⊓ centralizer ({z.val} : Set G) =
      firstCentralizerResidual L z.val ⊔ (T : Subgroup G) := by
  let H := centralizer ({z.val} : Set G)
  let C := L ⊓ H
  have hTH : (T : Subgroup G) ≤ H := original_sylow_le_centralizer hz
  have hnC : (T : Subgroup G) ≤ normalizer (C : Set G) :=
    (le_inf D.sylow_normalizes_component (hTH.trans H.le_normalizer)).trans
      inf_normalizer_le_normalizer_inf
  have hcover := le_embedded_pResidual_sup_sylow_of_normalizes T C hnC
  rw [twoResidual_eq_primeToResidual_three (component_centralizer_twoThree D m e z hzL)] at hcover
  have hcover' : C ≤ firstCentralizerResidual L z.val ⊔ (T : Subgroup G) := by
    simpa only [firstCentralizerResidual_eq] using hcover
  apply le_antisymm
  · intro x hx
    have hxprod : x ∈ (L : Set G) * ((T : Subgroup G) : Set G) := by
      rw [← coe_mul_of_right_le_normalizer_left L (T : Subgroup G) D.sylow_normalizes_component]
      exact hx.1
    obtain ⟨l,hl,t,ht,rfl⟩ := hxprod
    have hlH : l ∈ H := by
      have hh := H.mul_mem hx.2 (H.inv_mem (hTH ht))
      simpa only [mul_inv_cancel_right] using hh
    exact (firstCentralizerResidual L z.val ⊔ (T : Subgroup G)).mul_mem
      (hcover' ⟨hl,hlH⟩) (mem_sup_right ht)
  · exact sup_le
      (le_inf ((firstCentralizerResidual_le L z.val).trans inf_le_left |>.trans le_sup_left)
        ((firstCentralizerResidual_le L z.val).trans inf_le_right))
      (le_inf le_sup_right hTH)

/-- The source first flag normalizer is the literal residual parabolic. -/
theorem first_flag_normalizer_eq_firstResidual_sylow
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (structural : Structural1222.{u} KnownSimple.IsKnownSimple)
    (D : ChosenModule T L V) (m : CoreMarking D)
    (e : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 6))
    (z : V) (hz : z.val ∈ omegaOneCenterAmbient (T : Subgroup G))
    (hzL : z.val ∉ centralizer (L : Set G)) :
    (L ⊔ (T : Subgroup G)) ⊓ normalizer (V ⊓ omegaOneCenterAmbient (T : Subgroup G) : Set G) =
      firstCentralizerResidual L z.val ⊔ (T : Subgroup G) :=
  (first_flag_normalizer_eq_centralizer h structural D m z hz hzL).trans
    (local_centralizer_eq_firstResidual_sylow D m e z hz hzL)


end CFSG.Quasithin.Chapter13.Section04.FixedCoreSource.Solvable
