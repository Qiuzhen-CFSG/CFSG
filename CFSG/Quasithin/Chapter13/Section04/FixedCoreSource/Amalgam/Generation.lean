module
public import CFSG.Quasithin.Chapter13.Section04.FixedCoreSource.Amalgam.PrimeStructure
public import CFSG.Quasithin.Chapter13.Section04.FixedCoreSource.Amalgam.ComponentAction

/-!
# Lifting the component factorization to the original join

The selected component is the entire two-residual modulo O₃′(X).
The index of K in K O₃′(X) is prime to three, as is the index above that
product. Since O²(X)=O^{3′}(X), this forces O²(X)≤K. Perfectness gives
the reverse inclusion. The Sylow supplement theorem now gives X=KT.

The final theorem constructs K from nonsolvability of the original pair,
retaining relative C-component membership, faithful-local maximality,
normality in X and the exact embedded residual. This supplies the
component-generation step of 13.4.7; the final model selection, module
alternatives, Thompson normality and overgroup formula remain required.
The source input Source1332OneTwo is unchanged.
Source: Aschbacher–Smith 13.4.7, printed p.900.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter13.Section04.FixedCoreSource.Amalgam
open Chapter12.Section02 Chapter14.Section03.FaithfulSource
open Section03.Noncentrality.SupercriticalSource
variable {G : Type*} [Group G] [Finite G]
variable {T : Sylow 2 G} {L V A B : Subgroup G}

private theorem twoResidual_eq_component_of_prime_image
    {X : Type*} [Group X] [Finite X] (K : Subgroup X) [K.Normal]
    [Group.IsPerfect K]
    (hr : pResidual 2 X = primeToResidual 3 X)
    (hq : pResidual 2 (X ⧸ pPrimeCore 3 X) =
      K.map (QuotientGroup.mk' (pPrimeCore 3 X))) : pResidual 2 X = K := by
  let N := pPrimeCore 3 X
  let q := QuotientGroup.mk' N
  have hm : (pResidual 2 X).map q = K.map q :=
    (map_pResidual_of_surjective 2 q (QuotientGroup.mk'_surjective _)).trans hq
  have hle : pResidual 2 X ≤ K ⊔ N := by
    have hh := map_le_iff_le_comap.mp hm.le
    simpa only [comap_map_eq,q,QuotientGroup.ker_mk'] using hh
  have hidxR : Nat.Coprime 3 (pResidual 2 X).index := by
    obtain ⟨n,hn⟩ := (isPGroup_quotient_pResidual (G := X) 2).exists_card_eq
    rw [index_eq_card,hn]
    exact (by decide : Nat.Coprime 3 2).pow_right n
  have hrel : Nat.Coprime 3 (K.relIndex (K ⊔ N)) := by
    rw [relIndex_sup_left]
    exact pPrimeCore_coprime_card.of_dvd_right (relIndex_dvd_card K N)
  have hidx := hrel.mul_right (hidxR.of_dvd_right (index_dvd_of_le hle))
  rw [relIndex_mul_index (show K ≤ K ⊔ N from le_sup_left)] at hidx
  apply le_antisymm
  · rw [hr]
    exact primeToResidual_le K hidx
  · let : Group.IsNilpotent (X ⧸ pResidual 2 X) := (isPGroup_quotient_pResidual 2).isNilpotent
    exact le_of_isPerfect_of_solvable_quotient K (pResidual 2 X)

/-- The actual nonsolvable join is generated by its selected component and T. -/
theorem original_pair_component_is_residual
    (h₀ : Hypothesis1331 T L) (D : ChosenModule T L V) (m : CoreMarking D)
    (h1332 : Source1332OneTwo T)
    (hTA : (T : Subgroup G) ≤ A) (hTB : (T : Subgroup G) ≤ B)
    (eA : (A ⧸ pCore 2 A) ≃* Equiv.Perm (Fin 3))
    (eB : (B ⧸ pCore 2 B) ≃* Equiv.Perm (Fin 3)) (hne : A ≠ B)
    (hindexA : ((Stellmacher.omegaOneCenterAmbient (T : Subgroup G)) ⊓
      centralizer (A : Set G)).relIndex (Stellmacher.omegaOneCenterAmbient (T : Subgroup G)) = 2)
    (hindexB : ((Stellmacher.omegaOneCenterAmbient (T : Subgroup G)) ⊓
      centralizer (B : Set G)).relIndex (Stellmacher.omegaOneCenterAmbient (T : Subgroup G)) = 2)
    (K : Subgroup (A ⊔ B : Subgroup G)) (hK : K.IsCComponent) :
    pResidual 2 (A ⊔ B : Subgroup G) = K ∧
      A ⊔ B = K.map (A ⊔ B).subtype ⊔ (T : Subgroup G) := by
  let X := A ⊔ B
  have hTX : (T : Subgroup G) ≤ X := hTA.trans le_sup_left
  obtain ⟨hn,_,_,_,_⟩ := original_pair_component_geometry h₀ D m h1332
    hTA hTB eA eB hne hindexA hindexB K hK
  let := hn
  let := hK.perfect
  have hr : pResidual 2 X = primeToResidual 3 X :=
    (map_injective X.subtype_injective) (pair_twoResidual_eq_primeToThree hTA hTB eA eB hne)
  have he := twoResidual_eq_component_of_prime_image K hr
    (original_pair_prime_component_is_residual h₀ D m h1332
      hTA hTB eA eB hne hindexA hindexB K hK).1
  refine ⟨he,?_⟩
  have hgen := pResidual_sup_sylow_eq_top (T.subtype hTX)
  rw [he] at hgen
  have hh := congrArg (Subgroup.map X.subtype) hgen
  rw [Subgroup.map_sup,Sylow.coe_subtype,map_subgroupOf_eq_of_le hTX,
    ←MonoidHom.range_eq_map,range_subtype] at hh
  exact hh.symm

/-- Construct the genuine local component and the original join factorization. -/
theorem exists_original_pair_nonsolvable_generation
    (h₀ : Hypothesis1331 T L) (D : ChosenModule T L V) (m : CoreMarking D)
    (h1332 : Source1332OneTwo T)
    (hTA : (T : Subgroup G) ≤ A) (hTB : (T : Subgroup G) ≤ B)
    (eA : (A ⧸ pCore 2 A) ≃* Equiv.Perm (Fin 3))
    (eB : (B ⧸ pCore 2 B) ≃* Equiv.Perm (Fin 3)) (hne : A ≠ B)
    (hindexA : ((Stellmacher.omegaOneCenterAmbient (T : Subgroup G)) ⊓
      centralizer (A : Set G)).relIndex (Stellmacher.omegaOneCenterAmbient (T : Subgroup G)) = 2)
    (hindexB : ((Stellmacher.omegaOneCenterAmbient (T : Subgroup G)) ⊓
      centralizer (B : Set G)).relIndex (Stellmacher.omegaOneCenterAmbient (T : Subgroup G)) = 2)
    (hnonsolv : ¬ Group.IsSolvable (A ⊔ B : Subgroup G)) :
    let X := A ⊔ B
    ∃ C : Subgroup G,
      C ∈ Chapter1.cComponentsIn X ∧
      C ∈ MainForward.faithfulLocalComponents T ∧ C ∈ Chapter1.LStar G T ∧
      X ≤ normalizer (C : Set G) ∧
      (pResidual 2 X).map X.subtype = C ∧ X = C ⊔ (T : Subgroup G) := by
  let X := A ⊔ B
  obtain ⟨K,hK⟩ := exists_isCComponent_of_not_isSolvable hnonsolv
  obtain ⟨hn,hf,hstar,_,_⟩ := original_pair_component_geometry h₀ D m h1332
    hTA hTB eA eB hne hindexA hindexB K hK
  obtain ⟨hr,hgen⟩ := original_pair_component_is_residual h₀ D m h1332
    hTA hTB eA eB hne hindexA hindexB K hK
  have hrestrict : (K.map X.subtype).subgroupOf X = K :=
    comap_map_eq_self_of_injective X.subtype_injective K
  have hc : ((K.map X.subtype).subgroupOf X).IsCComponent := hrestrict.symm ▸ hK
  have hn' : ((K.map X.subtype).subgroupOf X).Normal := hrestrict.symm ▸ hn
  exact ⟨K.map X.subtype,⟨map_subtype_le _,hc⟩,hf,hstar,
    (normal_subgroupOf_iff_le_normalizer (map_subtype_le K)).mp hn',
    congrArg (Subgroup.map X.subtype) hr,hgen⟩

end CFSG.Quasithin.Chapter13.Section04.FixedCoreSource.Amalgam
