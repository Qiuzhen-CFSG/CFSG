module
public import CFSG.Quasithin.Chapter13.Section04.FixedCoreSource.Amalgam.FaithfulQuotient
public import Theory.SpecificGroups.Alternating.FiveSylowMaximal
public import Theory.SpecificGroups.SymmetricFive.SylowJoin
public import Theory.SpecificGroups.Alternating.FiveTwoCoreExtension

/-!
# Excluding the alternating-five component from the original amalgam

If K/O₂(K) were A₅, the proved supplement X=KT would make X/O₂(X)
either A₅ or S₅. The original Goldschmidt triple descends to this literal
quotient. Its two vertices are solvable and hence proper, whereas neither
five-point model can be generated by proper subgroups containing a common
Sylow two-subgroup. This excludes A₅ without assuming an amalgam classifier.

The final theorem applies the exclusion to the actual preceding 13.3.2
list and retains each other model with its genuine isomorphism. In particular
it does not discard U₃(3) or the alternating triple cover: their earlier-source
and module arguments remain necessary.
Source: Aschbacher–Smith 13.4.7, printed p.900.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter13.Section04.FixedCoreSource.Amalgam
variable {G : Type*} [Group G] [Finite G]

private theorem local_ne_top {A B : Subgroup G}
    (h : ChapterF.IsGoldschmidtTriple A B) (hn : ¬ Group.IsSolvable G) : A ≠ ⊤ := by
  intro ht
  have hs : Group.IsSolvable (⊤ : Subgroup G) := ht ▸ h.local_solvable
  let := hs
  exact hn (Group.isSolvable_of_surjective (f := (topEquiv (G := G)).toMonoidHom)
    topEquiv.surjective)

private theorem no_five_triple {A B : Subgroup G}
    (h : ChapterF.IsGoldschmidtTriple A B) (hn : ¬ Group.IsSolvable G)
    (e : G ≃* alternatingGroup (Fin 5)) : False := by
  have hm := h.map_of_two_kernel e.toMonoidHom e.surjective
    (IsPGroup.ker_isPGroup_of_injective e.injective)
    (by rw [e.toMonoidHom.ker_eq_bot e.injective]; exact bot_le)
  have hn' : ¬ Group.IsSolvable (alternatingGroup (Fin 5)) := by
    intro hs
    let := hs
    exact hn (Group.isSolvable_of_surjective (f := e.symm.toMonoidHom) e.symm.surjective)
  obtain ⟨S,hS⟩ := hm.intersection_sylow
  have ha := Theory.SpecificGroups.Alternating.FiveSylowMaximal.overgroup_le_sylow_normalizer
    S _ (hS.symm.le.trans inf_le_left) (local_ne_top hm hn')
  have hb := Theory.SpecificGroups.Alternating.FiveSylowMaximal.overgroup_le_sylow_normalizer
    S _ (hS.symm.le.trans inf_le_right) (local_ne_top hm.symm hn')
  have ht : normalizer (S : Set (alternatingGroup (Fin 5))) = ⊤ := top_unique (by
    rw [←hm.generated]
    exact sup_le ha hb)
  exact (Theory.SpecificGroups.Alternating.FiveSylowMaximal.sylow_normalizer_isCoatom S).1 ht

private theorem no_symmetric_five_triple {A B : Subgroup G}
    (h : ChapterF.IsGoldschmidtTriple A B) (hn : ¬ Group.IsSolvable G)
    (e : G ≃* Equiv.Perm (Fin 5)) : False := by
  have hm := h.map_of_two_kernel e.toMonoidHom e.surjective
    (IsPGroup.ker_isPGroup_of_injective e.injective)
    (by rw [e.toMonoidHom.ker_eq_bot e.injective]; exact bot_le)
  have hn' : ¬ Group.IsSolvable (Equiv.Perm (Fin 5)) := by
    intro hs
    let := hs
    exact hn (Group.isSolvable_of_surjective (f := e.symm.toMonoidHom) e.symm.surjective)
  obtain ⟨S,hS⟩ := hm.intersection_sylow
  exact Theory.SpecificGroups.SymmetricFive.SylowOvergroup.proper_sylow_overgroups_join_ne_top
    S _ _ (local_ne_top hm hn') (local_ne_top hm.symm hn')
    (hS.symm.le.trans inf_le_left) (hS.symm.le.trans inf_le_right) hm.generated

open Chapter12.Section02 Chapter14.Section03.FaithfulSource
open Section03.Noncentrality.SupercriticalSource
variable {T : Sylow 2 G} {L V A B : Subgroup G}

/-- An actual component of the original join cannot have A₅ as its two-core quotient. -/
theorem original_pair_component_not_alternatingFive
    (h₀ : Hypothesis1331 T L) (D : ChosenModule T L V) (m : CoreMarking D)
    (h1332 : Source1332OneTwo T)
    (hTA : (T : Subgroup G) ≤ A) (hTB : (T : Subgroup G) ≤ B)
    (eA : (A ⧸ pCore 2 A) ≃* Equiv.Perm (Fin 3))
    (eB : (B ⧸ pCore 2 B) ≃* Equiv.Perm (Fin 3)) (hne : A ≠ B)
    (hindexA : ((Stellmacher.omegaOneCenterAmbient (T : Subgroup G)) ⊓
      centralizer (A : Set G)).relIndex (Stellmacher.omegaOneCenterAmbient (T : Subgroup G)) = 2)
    (hindexB : ((Stellmacher.omegaOneCenterAmbient (T : Subgroup G)) ⊓
      centralizer (B : Set G)).relIndex (Stellmacher.omegaOneCenterAmbient (T : Subgroup G)) = 2)
    (K : Subgroup (A ⊔ B : Subgroup G)) (hK : K.IsCComponent) :
    ¬ Nonempty (((K.map (A ⊔ B).subtype) ⧸ pCore 2 (K.map (A ⊔ B).subtype)) ≃*
      alternatingGroup (Fin 5)) := by
  rintro ⟨e⟩
  let X := A ⊔ B
  let C := K.map X.subtype
  obtain ⟨_,_,_,hTC,_⟩ := original_pair_component_geometry h₀ D m h1332
    hTA hTB eA eB hne hindexA hindexB K hK
  have hgen := (original_pair_component_is_residual h₀ D m h1332
    hTA hTB eA eB hne hindexA hindexB K hK).2
  change X = C ⊔ (T : Subgroup G) at hgen
  have hm : Nonempty ((X ⧸ pCore 2 X) ≃* alternatingGroup (Fin 5)) ∨
      Nonempty ((X ⧸ pCore 2 X) ≃* Equiv.Perm (Fin 5)) := by
    let j := MulEquiv.subgroupCongr hgen
    let jq := QuotientGroup.congr (pCore 2 X) (pCore 2 (C ⊔ (T : Subgroup G) : Subgroup G))
      j (pCore_map_iso 2 j)
    have hm := Theory.SpecificGroups.Alternating.FiveExtensionAction.core_quotient_of_two_supplement
      C (T : Subgroup G) hTC T.isPGroup' e
    exact hm.imp (fun hj => ⟨jq.trans hj.some⟩) (fun hj => ⟨jq.trans hj.some⟩)
  have hn : ¬ Group.IsSolvable (X ⧸ pCore 2 X) := by
    intro hs
    let : Group.IsNilpotent (pCore 2 X) := pCore_isPGroup.isNilpotent
    have hx := (Group.isSolvable_iff_subgroup_quotient (pCore 2 X)).mpr
      ⟨inferInstance,hs⟩
    let := hx
    exact hK.not_isSolvable inferInstance
  have hg := (pair_goldschmidt hTA hTB eA eB hne).quotient_twoCore
  rcases hm with hj | hj
  · exact no_five_triple hg hn hj.some
  · exact no_symmetric_five_triple hg hn hj.some

/-- The literal earlier list loses its alternating-five row in the original amalgam.
Unitary and covered alternating-six remain until their separate source exclusions. -/
theorem original_pair_component_quotient_models
    (h₀ : Hypothesis1331 T L) (D : ChosenModule T L V) (m : CoreMarking D)
    (h1332 : Source1332OneTwo T)
    (hTA : (T : Subgroup G) ≤ A) (hTB : (T : Subgroup G) ≤ B)
    (eA : (A ⧸ pCore 2 A) ≃* Equiv.Perm (Fin 3))
    (eB : (B ⧸ pCore 2 B) ≃* Equiv.Perm (Fin 3)) (hne : A ≠ B)
    (hindexA : ((Stellmacher.omegaOneCenterAmbient (T : Subgroup G)) ⊓
      centralizer (A : Set G)).relIndex (Stellmacher.omegaOneCenterAmbient (T : Subgroup G)) = 2)
    (hindexB : ((Stellmacher.omegaOneCenterAmbient (T : Subgroup G)) ⊓
      centralizer (B : Set G)).relIndex (Stellmacher.omegaOneCenterAmbient (T : Subgroup G)) = 2)
    (K : Subgroup (A ⊔ B : Subgroup G)) (hK : K.IsCComponent) :
    let C := K.map (A ⊔ B).subtype
    ClassicalGroup.IsPSL (C ⧸ pCore 2 C) 3 2 ∨
      Chapter1.Section02.LocalModels.IsAlternating (C ⧸ pCore 2 C) 6 ∨
      Chapter1.Section02.LocalModels.IsAlternatingCover (C ⧸ pCore 2 C) 6 ∨
      ClassicalGroup.IsPSU (C ⧸ pCore 2 C) 3 3 := by
  have hf := (original_pair_component_geometry h₀ D m h1332
    hTA hTB eA eB hne hindexA hindexB K hK).2.1
  exact (h1332 _ hf).2.resolve_left
    (original_pair_component_not_alternatingFive h₀ D m h1332
      hTA hTB eA eB hne hindexA hindexB K hK)

end CFSG.Quasithin.Chapter13.Section04.FixedCoreSource.Amalgam
