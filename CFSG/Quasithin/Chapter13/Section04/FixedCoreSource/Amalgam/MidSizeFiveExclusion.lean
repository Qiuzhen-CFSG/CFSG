module
public import CFSG.Quasithin.Chapter13.Section04.FixedCoreSource.Amalgam.MidSizeGeneration
public import Theory.SpecificGroups.Alternating.FiveSylowMaximal
public import Theory.SpecificGroups.SymmetricFive.SylowJoin
public import Theory.SpecificGroups.Alternating.FiveTwoCoreExtension

/-!
# Excluding the alternating-five quotient in the second pair

Once the component is the whole two-residual, its Sylow supplement would
make the full two-core quotient A₅ or S₅. Neither group is generated by two
proper solvable subgroups containing the same Sylow two-subgroup. The
literal Goldschmidt quotient therefore excludes the A₅ row.

SecondGeneration applies this to the constructed component of the actual
second join; no component marking or model exclusion is assumed there.
This adapts the first-pair argument in FiveExclusion without requiring its
inapplicable fixed-index hypotheses.
Source: Aschbacher--Smith 13.4.7(3), printed p.903, refs/quasithin.pdf.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter13.Section04.FixedCoreSource.Amalgam.SecondGeneration
variable {G : Type*} [Group G] [Finite G]

private theorem local_ne_top {A B : Subgroup G}
    (h : ChapterF.IsGoldschmidtTriple A B) (hn : ¬ Group.IsSolvable G) : A ≠ ⊤ := by
  intro ht
  have hs : Group.IsSolvable (⊤ : Subgroup G) := ht ▸ h.local_solvable
  let := hs
  exact hn (Group.isSolvable_of_surjective (f := (topEquiv (G := G)).toMonoidHom)
    topEquiv.surjective)

private theorem no_five_triple {A B : Subgroup G}
    (h : ChapterF.IsGoldschmidtTriple A B) (hn : ¬ Group.IsSolvable G)
    (e : G ≃* alternatingGroup (Fin 5)) : False := by
  have hm := h.map_of_two_kernel e.toMonoidHom e.surjective
    (IsPGroup.ker_isPGroup_of_injective e.injective)
    (by rw [e.toMonoidHom.ker_eq_bot e.injective]; exact bot_le)
  have hn' : ¬ Group.IsSolvable (alternatingGroup (Fin 5)) := by
    intro hs
    let := hs
    exact hn (Group.isSolvable_of_surjective (f := e.symm.toMonoidHom) e.symm.surjective)
  obtain ⟨S,hS⟩ := hm.intersection_sylow
  have ha := Theory.SpecificGroups.Alternating.FiveSylowMaximal.overgroup_le_sylow_normalizer
    S _ (hS.symm.le.trans inf_le_left) (local_ne_top hm hn')
  have hb := Theory.SpecificGroups.Alternating.FiveSylowMaximal.overgroup_le_sylow_normalizer
    S _ (hS.symm.le.trans inf_le_right) (local_ne_top hm.symm hn')
  have ht : normalizer (S : Set (alternatingGroup (Fin 5))) = ⊤ := top_unique (by
    rw [←hm.generated]
    exact sup_le ha hb)
  exact (Theory.SpecificGroups.Alternating.FiveSylowMaximal.sylow_normalizer_isCoatom S).1 ht

private theorem no_symmetric_five_triple {A B : Subgroup G}
    (h : ChapterF.IsGoldschmidtTriple A B) (hn : ¬ Group.IsSolvable G)
    (e : G ≃* Equiv.Perm (Fin 5)) : False := by
  have hm := h.map_of_two_kernel e.toMonoidHom e.surjective
    (IsPGroup.ker_isPGroup_of_injective e.injective)
    (by rw [e.toMonoidHom.ker_eq_bot e.injective]; exact bot_le)
  have hn' : ¬ Group.IsSolvable (Equiv.Perm (Fin 5)) := by
    intro hs
    let := hs
    exact hn (Group.isSolvable_of_surjective (f := e.symm.toMonoidHom) e.symm.surjective)
  obtain ⟨S,hS⟩ := hm.intersection_sylow
  exact Theory.SpecificGroups.SymmetricFive.SylowOvergroup.proper_sylow_overgroups_join_ne_top
    S _ _ (local_ne_top hm hn') (local_ne_top hm.symm hn')
    (hS.symm.le.trans inf_le_left) (hS.symm.le.trans inf_le_right) hm.generated


/-- A component which is the whole residual of a genuine Goldschmidt pair
cannot have an alternating-five two-core quotient. -/
theorem component_not_alternatingFive {P Q : Subgroup G}
    (hg : ChapterF.IsGoldschmidtTriple P Q) (K : Subgroup G)
    (hK : K.IsCComponent) [K.Normal] (hr : pResidual 2 G = K) :
    ¬ Nonempty ((K ⧸ pCore 2 K) ≃* alternatingGroup (Fin 5)) := by
  rintro ⟨e⟩
  obtain ⟨S,_⟩ := hg.intersection_sylow
  have hgen : K ⊔ (S : Subgroup G) = ⊤ := hr ▸ pResidual_sup_sylow_eq_top S
  let j : G ≃* (K ⊔ (S : Subgroup G) : Subgroup G) :=
    (topEquiv : (⊤ : Subgroup G) ≃* G).symm.trans (MulEquiv.subgroupCongr hgen.symm)
  let jq := QuotientGroup.congr (pCore 2 G) (pCore 2 (K ⊔ (S : Subgroup G) : Subgroup G))
    j (pCore_map_iso 2 j)
  have hm := Theory.SpecificGroups.Alternating.FiveExtensionAction.core_quotient_of_two_supplement
    K (S : Subgroup G) le_normalizer_of_normal S.isPGroup' e
  have hn : ¬ Group.IsSolvable (G ⧸ pCore 2 G) := by
    intro hs
    let : Group.IsNilpotent (pCore 2 G) := pCore_isPGroup.isNilpotent
    let : Group.IsSolvable G := (Group.isSolvable_iff_subgroup_quotient (pCore 2 G)).mpr
      ⟨inferInstance,hs⟩
    exact hK.not_isSolvable inferInstance
  rcases hm with hh | hh
  · exact no_five_triple hg.quotient_twoCore hn (jq.trans hh.some)
  · exact no_symmetric_five_triple hg.quotient_twoCore hn (jq.trans hh.some)

end CFSG.Quasithin.Chapter13.Section04.FixedCoreSource.Amalgam.SecondGeneration
