module
public import CFSG.Quasithin.Chapter13.Section04.FixedCoreSource.Nonsolvable.AugmentationCoveredComparison
public import CFSG.Quasithin.Chapter12.Section02.Preliminaries.ThetaSixSource
public import CFSG.Quasithin.Chapter13.Section04.FixedCoreSource.Nonsolvable.ComponentContainment
public import Theory.GroupTheory.PResidual.SixCentralQuotient

/-!
# The selected A₆ component and exclusion of the nonsplit covering row

Every three-element above either genuine A₆ central cover has order at
most three. Thus the point residuals are generated by their actual cubic
elements, even in the covered rank-two case. The local theta theorem places
L₁ in the selected K and identifies O^{3′}(C_K(d)) with O^{3′}(C_L(z)),
where d is the original fixed-line generator. This uses the original
relative C-component and the three-rank bound inside C_G(z).

For the nonsplit moved omega-orbit, earlier 13.3.2 constructs the full
five-dimensional augmentation marking. Splitting puts d in this same
module, and escape makes it nonfixed under K. If L is ordinary, the
reciprocal residual has three-rank one, which excludes a covered K. If
both are covered, their common point radical has the same Baumann subgroup
as O₂(KT). Its normalizer is contained in N_G(L), contradicting K's escape.
Consequently both L/O₂(L) and K/O₂(K) are ordinary A₆. The final application
supplies L₁ containment and the literal reciprocal O²-centralizer identity
without an assumed ordinary quotient on either side.

The original earlier Structural1222 and 13.3.2 premises retain their
producers qt-d-1222-source and qt-d-1332-source. Their guarded same-G,T
application and final discharge remain with qt-d-1341-fixed-core-source;
no universal premise is inferred from Structural1222At. The fixed-free
module cases and the remaining comparison, commutator and graph arguments
stay with qt-d-1341-nonsolvable-source. Universal nonsolvability is still
required at both escaping weights. This is not the final contradiction.
Source: Aschbacher–Smith 12.2.8 and 13.4.10(2–5), printed pp.797,908–909.
-/

public noncomputable section
open Subgroup Theory.GroupTheory Stellmacher
namespace CFSG.Quasithin.Chapter13.Section04.FixedCoreSource.Nonsolvable
open Chapter12.Section02 Chapter14.Section03.FaithfulSource
universe u
variable {G : Type u} [Group G] [Finite G] {T : Sylow 2 G} {L K V : Subgroup G}

/-- The literal point residual is generated by its cubic elements in both
A₆ central-cover rows, independently of a module marking. -/
theorem six_point_residual_cubic
    (L : Subgroup G) [IsQuasisimple (L ⧸ pCore 2 L)]
    (eL : ((L ⧸ pCore 2 L) ⧸ center (L ⧸ pCore 2 L)) ≃* alternatingGroup (Fin 6))
    (z : G) :
    Solvable.firstCentralizerResidual L z =
      closure {x : G | x ∈ L ⊓ centralizer ({z} : Set G) ∧ orderOf x = 3} := by
  let C := L ⊓ centralizer ({z} : Set G)
  rw [Solvable.firstCentralizerResidual_eq,
    SixCComponentTheta.primeToResidual_eq_cubic_closure_of_injective
      eL (inclusion (show C ≤ L from inf_le_left))
      (inclusion_injective _),MonoidHom.map_closure]
  congr 1
  ext x
  constructor
  · rintro ⟨y,hy,rfl⟩
    exact ⟨y.property,(C.orderOf_coe y).trans hy⟩
  · rintro ⟨hx,h3⟩
    exact ⟨⟨x,hx⟩,(C.orderOf_coe ⟨x,hx⟩).symm.trans h3,rfl⟩

private def centerQuotientCongr {A B : Type*} [Group A] [Group B] (e : A ≃* B) :
    (A ⧸ center A) ≃* (B ⧸ center B) :=
  QuotientGroup.congr _ _ e (by
    apply le_antisymm
    · rintro _ ⟨x,hx,rfl⟩
      exact (centerCongr e ⟨x,hx⟩).property
    · intro y hy
      exact ⟨e.symm y,(centerCongr e.symm ⟨y,hy⟩).property,e.apply_symm_apply y⟩)

/-- The actual selected ordinary or covered A₆ component is theta(C_G(z)).
The three-rank bound is applied inside this two-local subgroup. -/
theorem component_theta_of_six_central_quotient
    (h₀ : Hypothesis1331 T L) {z : G}
    (hzT : z ∈ omegaOneCenterAmbient (T : Subgroup G)) (hz1 : z ≠ 1)
    (hK : K ∈ Chapter1.cComponentsIn (centralizer ({z} : Set G)))
    (hHN : centralizer ({z} : Set G) ≤ normalizer (K : Set G))
    (hqK : IsQuasisimple (K ⧸ pCore 2 K))
    (eK : ((K ⧸ pCore 2 K) ⧸ center (K ⧸ pCore 2 K)) ≃* alternatingGroup (Fin 6)) :
    closure {x : G | x ∈ centralizer ({z} : Set G) ∧ orderOf x = 3} = K := by
  let H := centralizer ({z} : Set G)
  let A := K.subgroupOf H
  let : A.Normal := normal_subgroupOf_of_le_normalizer hHN
  let q : (A ⧸ pCore 2 A) ≃* (K ⧸ pCore 2 K) :=
    QuotientGroup.congr _ _ (subgroupOfEquivOfLe hK.1) (pCore_map_iso 2 _)
  let := hqK
  let : IsQuasisimple (A ⧸ pCore 2 A) := IsQuasisimple.of_mulEquiv q.symm
  have hr : primeRank 3 H ≤ 2 :=
    (isQuasithin_iff_twoLocal.mp h₀.qtke.quasithin) _
      (isTwoLocal_involution_centralizer
        (orderOf_eq_prime ((mem_omegaOneCenterAmbient_iff _ _).mp hzT).2.1 hz1))
      3 (by decide) (by decide)
  have hh := SixCComponentTheta.cubic_closure_eq_of_central_quotient_six A hK.2
    ((centerQuotientCongr q).trans eK) hr
  have hm := congrArg (map H.subtype) hh
  rw [MonoidHom.map_closure,map_subgroupOf_eq_of_le hK.1] at hm
  convert hm using 1
  congr 1
  ext x
  constructor
  · rintro ⟨hx,h3⟩
    exact ⟨⟨x,hx⟩,(H.orderOf_coe ⟨x,hx⟩).symm.trans h3,rfl⟩
  · rintro ⟨y,hy,rfl⟩
    exact ⟨y.property,(H.orderOf_coe y).trans hy⟩

/-- In either selected A₆ covering row, cubic generation proves the source
containment L₁ ≤ K without any assumption on the selected module. -/
theorem firstResidual_le_component_of_six_central_quotient
    (h₀ : Hypothesis1331 T L)
    (D : ChosenModule T L V) (m : CoreMarking D)
    [IsQuasisimple (L ⧸ pCore 2 L)] {z : G}
    (hzT : z ∈ omegaOneCenterAmbient (T : Subgroup G)) (hz1 : z ≠ 1)
    (hK : K ∈ Chapter1.cComponentsIn (centralizer ({z} : Set G)))
    (hHN : centralizer ({z} : Set G) ≤ normalizer (K : Set G))
    (hqK : IsQuasisimple (K ⧸ pCore 2 K))
    (eK : ((K ⧸ pCore 2 K) ⧸ center (K ⧸ pCore 2 K)) ≃* alternatingGroup (Fin 6)) :
    Solvable.firstCentralizerResidual L z ≤ K := by
  rw [six_point_residual_cubic L (augmentationCentralQuotient D m),
    ←component_theta_of_six_central_quotient h₀ hzT hz1 hK hHN hqK eK]
  exact Subgroup.closure_mono fun _ hx => ⟨hx.1.2,hx.2⟩

/-- Both selected A₆ covering rows have the same literal reciprocal point
residual as the original component, without a whole-module hypothesis. -/
theorem six_component_reciprocal_residual
    (h₀ : Hypothesis1331 T L)
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (structural : Structural1222.{u} KnownSimple.IsKnownSimple)
    (D : ChosenModule T L V) (m : CoreMarking D)
    {z : G} (hzT : z ∈ omegaOneCenterAmbient (T : Subgroup G)) (hz1 : z ≠ 1)
    (hK : K ∈ Chapter1.cComponentsIn (centralizer ({z} : Set G)))
    (hHN : centralizer ({z} : Set G) ≤ normalizer (K : Set G))
    (hqK : IsQuasisimple (K ⧸ pCore 2 K))
    (eK : ((K ⧸ pCore 2 K) ⧸ center (K ⧸ pCore 2 K)) ≃* alternatingGroup (Fin 6)) :
    Solvable.firstCentralizerResidual K m.constant.val =
      Solvable.firstCentralizerResidual L z := by
  let := h.quasisimple
  let := hqK
  have htK := component_theta_of_six_central_quotient h₀ hzT hz1 hK hHN hqK eK
  have htL := h.toHypothesis1221.source_theta_eq_of_central_quotient_six
    D.sylow_normalizes_component
    (fun _ _ _ => ChapterA.Section02.theoremA_knownSimple)
    (fun _ _ _ => ChapterA.Section02.theoremC_knownSimple) (augmentationCentralQuotient D m)
  have hd := fixed_generator_centralizer h structural D m
    ⟨m.constant.property,m.constant_fixed⟩
    (fun hh => m.constant_ne_one (Subtype.ext hh))
  rw [six_point_residual_cubic K eK,
    six_point_residual_cubic L (augmentationCentralQuotient D m),hd]
  apply le_antisymm
  · apply Subgroup.closure_mono
    rintro x ⟨⟨hxK,hxM⟩,h3⟩
    exact ⟨⟨htL ▸ Subgroup.subset_closure ⟨hxM,h3⟩,hK.1 hxK⟩,h3⟩
  · apply Subgroup.closure_mono
    rintro x ⟨⟨hxL,hxz⟩,h3⟩
    exact ⟨⟨htK ▸ Subgroup.subset_closure ⟨hxz,h3⟩,L.le_normalizer hxL⟩,h3⟩

/-- A covered augmentation module on the actual nonsplit selected component
is impossible. Reciprocal cubic generation supplies the common point radical. -/
theorem covered_component_excluded_of_source_fixed
    (h₀ : Hypothesis1331 T L)
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (structural : Structural1222.{u} KnownSimple.IsKnownSimple)
    (D : ChosenModule T L V) (m : CoreMarking D)
    (h1332 : Section03.Noncentrality.SupercriticalSource.Source1332OneTwo T)
    (fixed : Section03.SourceCompletion.OriginalFixedModule1332At T L)
    (hindex : ((omegaOneCenterAmbient (T : Subgroup G)) ⊓ centralizer (L : Set G)).relIndex
      (omegaOneCenterAmbient (T : Subgroup G)) = 2)
    (z : V) (hzT : z.val ∈ omegaOneCenterAmbient (T : Subgroup G))
    (hzL : z.val ∉ centralizer (L : Set G))
    (hK : K ∈ Chapter1.cComponentsIn (centralizer ({z.val} : Set G)))
    (hHN : centralizer ({z.val} : Set G) ≤ normalizer (K : Set G))
    (hKM : ¬ K ≤ normalizer (L : Set G))
    (hfK : K ∈ MainForward.faithfulLocalComponents T)
    (hcK : Nat.card (center (K ⧸ pCore 2 K)) = 3)
    (hfixed : (⁅conjugateSpanBy (omegaOneCenterAmbient (T : Subgroup G)) K,K⁆ :
      Subgroup G) ⊓ centralizer (K : Set G) ≠ ⊥) : False := by
  let U := ⁅conjugateSpanBy (omegaOneCenterAmbient (T : Subgroup G)) K,K⁆
  have hz1 : z.val ≠ 1 := fun he => hzL (he ▸ one_mem _)
  have hqK := component_quotient_quasisimple h1332 hfK
  let := hqK
  let := h.quasisimple
  obtain ⟨DK,⟨mK⟩,hfix,_,_,_,_⟩ := component_core_marking_of_source_fixed
    h₀ h structural m h1332 fixed hindex z.property hzT hz1 hK.1 hHN hKM hfK hfixed
  have hsplit : conjugateSpanBy (omegaOneCenterAmbient (T : Subgroup G)) K = U := by
    have hh := component_seed_split h₀ hzT hz1 hK.1 (h1332 K hfK).1
    rw [component_full_fixed_line h structural z.val hz1 hzT hindex K hK.1 hKM,
      sup_eq_left.mpr (show zpowers z.val ≤ U from hfix.symm ▸ inf_le_left)] at hh
    exact hh
  have hdT := (m.constant_mem_central_four h structural).2
  have hdU : m.constant.val ∈ U := hsplit ▸ le_conjugateSpanBy _ _ hdT
  have hdK : m.constant.val ∉ centralizer (K : Set G) := by
    intro hd
    apply hKM
    rw [←fixed_generator_centralizer h structural D m
      ⟨m.constant.property,m.constant_fixed⟩
      (fun he => m.constant_ne_one (Subtype.ext he))]
    exact fun k hk => mem_centralizer_singleton_iff.mpr (hd k hk)
  have hrec := six_component_reciprocal_residual h₀ h structural D m
    hzT hz1 hK hHN hqK (augmentationCentralQuotient DK mK)
  have hn : ¬ 2 ∣ Nat.card (center (L ⧸ pCore 2 L)) :=
    PerfectCentralCovering.not_dvd_card_central_of_pCore_eq_bot
      (pCore_quotient_pCore_eq_bot 2) (center (L ⧸ pCore 2 L)) le_rfl
  have ho : Odd (Nat.card (center (L ⧸ pCore 2 L))) :=
    Nat.not_even_iff_odd.mp (fun he => hn (even_iff_two_dvd.mp he))
  rcases GLS3.Chapter5.OddCentralCovers.odd_center_alternatives 6 (by decide)
      (augmentationCentralQuotient D m) ho with hcL | ⟨_,hcL⟩
  · let eL := GLS3.Chapter5.OddCentralCovers.alternatingEquivOfCenterCardOne 6
      (augmentationCentralQuotient D m) hcL
    have hr : primeRank 3 (Solvable.firstCentralizerResidual K m.constant.val) ≤ 1 := by
      rw [hrec,Solvable.firstCentralizerResidual_threeRank]
      exact core_component_point_threeRank_le_one D m eL z hzL
    obtain ⟨eK⟩ := Solvable.ordinary_of_firstCentralizerResidual_threeRank DK mK
      ⟨m.constant.val,hdU⟩ hdK hr
    have hone : Nat.card (center (K ⧸ pCore 2 K)) = 1 := by
      rw [Nat.card_congr (centerCongr eK).toEquiv,
        alternatingGroup.center_eq_bot (by simp),Subgroup.card_bot]
    omega
  · have hstar := Section03.Noncentrality.source1332_faithful_maximal h₀.qtke T h1332 hfK
    have hK12 := h₀.hypothesis1311.hypothesis1223
      ⟨hstar,(Chapter1.Section02.Adequate.mem_faithfulLocalComponents_iff T K).mp hfK |>.2⟩ hqK
    let P := Solvable.firstCentralizerResidual L z.val ⊔ (T : Subgroup G)
    let X := K ⊔ (T : Subgroup G)
    have he := (covered_augmentation_thompson_baumann hK12 structural DK mK hcK
      ⟨m.constant.val,hdU⟩ hdT hdK).2
    rw [hrec] at he
    have hKB : K ≤ normalizer (ChapterB.baumann (P.pCoreIn 2) : Set G) := by
      rw [he]
      exact (le_sup_left.trans (X.le_normalizer.trans
        (normalizer_le_normalizer_characteristic_image X (pCore 2 X)))).trans
          (normalizer_le_normalizer_baumann (X.pCoreIn 2))
    exact hKM (hKB.trans
      (covered_augmentation_baumann_normalizer h structural D m hcL z hzT hzL))

/-- The nonsplit source branch has an ordinary selected A₆ quotient. Its
augmentation marking and the exclusion of the covering row are constructed. -/
theorem ordinary_component_of_source_fixed
    (h₀ : Hypothesis1331 T L)
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (structural : Structural1222.{u} KnownSimple.IsKnownSimple)
    (D : ChosenModule T L V) (m : CoreMarking D)
    (h1332 : Section03.Noncentrality.SupercriticalSource.Source1332OneTwo T)
    (fixed : Section03.SourceCompletion.OriginalFixedModule1332At T L)
    (hindex : ((omegaOneCenterAmbient (T : Subgroup G)) ⊓ centralizer (L : Set G)).relIndex
      (omegaOneCenterAmbient (T : Subgroup G)) = 2)
    (z : V) (hzT : z.val ∈ omegaOneCenterAmbient (T : Subgroup G))
    (hzL : z.val ∉ centralizer (L : Set G))
    (hK : K ∈ Chapter1.cComponentsIn (centralizer ({z.val} : Set G)))
    (hHN : centralizer ({z.val} : Set G) ≤ normalizer (K : Set G))
    (hKM : ¬ K ≤ normalizer (L : Set G))
    (hfK : K ∈ MainForward.faithfulLocalComponents T)
    (hfixed : (⁅conjugateSpanBy (omegaOneCenterAmbient (T : Subgroup G)) K,K⁆ :
      Subgroup G) ⊓ centralizer (K : Set G) ≠ ⊥) :
    Nonempty ((K ⧸ pCore 2 K) ≃* alternatingGroup (Fin 6)) := by
  have hz1 : z.val ≠ 1 := fun he => hzL (he ▸ one_mem _)
  let := component_quotient_quasisimple h1332 hfK
  obtain ⟨DK,⟨mK⟩,_,_,_,_,_⟩ := component_core_marking_of_source_fixed
    h₀ h structural m h1332 fixed hindex z.property hzT hz1 hK.1 hHN hKM hfK hfixed
  have hn : ¬ 2 ∣ Nat.card (center (K ⧸ pCore 2 K)) :=
    PerfectCentralCovering.not_dvd_card_central_of_pCore_eq_bot
      (pCore_quotient_pCore_eq_bot 2) (center (K ⧸ pCore 2 K)) le_rfl
  have ho : Odd (Nat.card (center (K ⧸ pCore 2 K))) :=
    Nat.not_even_iff_odd.mp (fun he => hn (even_iff_two_dvd.mp he))
  rcases GLS3.Chapter5.OddCentralCovers.odd_center_alternatives 6 (by decide)
      (augmentationCentralQuotient DK mK) ho with hc | ⟨_,hc⟩
  · exact ⟨GLS3.Chapter5.OddCentralCovers.alternatingEquivOfCenterCardOne 6
      (augmentationCentralQuotient DK mK) hc⟩
  · exact (covered_component_excluded_of_source_fixed h₀ h structural D m h1332 fixed
      hindex z hzT hzL hK hHN hKM hfK hc hfixed).elim

/-- Source application: neither component quotient is supplied as ordinary.
Both are constructed on the nonsplit branch, together with the literal
L₁ containment and the reciprocal O² centralizer identity. -/
theorem nonsplit_component_ordinary_residuals
    (h₀ : Hypothesis1331 T L)
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (structural : Structural1222.{u} KnownSimple.IsKnownSimple)
    (D : ChosenModule T L V) (m : CoreMarking D)
    (h1332 : Section03.Noncentrality.SupercriticalSource.Source1332OneTwo T)
    (fixed : Section03.SourceCompletion.OriginalFixedModule1332At T L)
    (hindex : ((omegaOneCenterAmbient (T : Subgroup G)) ⊓ centralizer (L : Set G)).relIndex
      (omegaOneCenterAmbient (T : Subgroup G)) = 2)
    (z : V) (hzT : z.val ∈ omegaOneCenterAmbient (T : Subgroup G))
    (hzL : z.val ∉ centralizer (L : Set G))
    (hK : K ∈ Chapter1.cComponentsIn (centralizer ({z.val} : Set G)))
    (hHN : centralizer ({z.val} : Set G) ≤ normalizer (K : Set G))
    (hKM : ¬ K ≤ normalizer (L : Set G))
    (hfK : K ∈ MainForward.faithfulLocalComponents T)
    (hfixed : (⁅conjugateSpanBy (omegaOneCenterAmbient (T : Subgroup G)) K,K⁆ :
      Subgroup G) ⊓ centralizer (K : Set G) ≠ ⊥) :
    let U := ⁅conjugateSpanBy (omegaOneCenterAmbient (T : Subgroup G)) K,K⁆
    Nonempty ((K ⧸ pCore 2 K) ≃* alternatingGroup (Fin 6)) ∧
      Nonempty ((L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 6)) ∧
      Solvable.firstCentralizerResidual L z.val ≤ K ∧
      primeRank 3 (Solvable.firstCentralizerResidual L z.val) = 1 ∧
      m.constant.val ∈ U ∧
      (pResidual 2 (K ⊓ centralizer
          (omegaOneCenterAmbient (T : Subgroup G) : Set G) : Subgroup G)).map
          (K ⊓ centralizer (omegaOneCenterAmbient (T : Subgroup G) : Set G)).subtype =
        (pResidual 2 (L ⊓ centralizer ({z.val} : Set G) : Subgroup G)).map
          (L ⊓ centralizer ({z.val} : Set G)).subtype := by
  obtain ⟨eK⟩ := ordinary_component_of_source_fixed h₀ h structural D m h1332 fixed hindex
    z hzT hzL hK hHN hKM hfK hfixed
  exact ⟨⟨eK⟩,ordinary_original_of_nonsplit_ordinary_component h₀ h structural m h1332
    fixed hindex z hzT hzL hK hHN hKM hfK eK hfixed⟩

end CFSG.Quasithin.Chapter13.Section04.FixedCoreSource.Nonsolvable
