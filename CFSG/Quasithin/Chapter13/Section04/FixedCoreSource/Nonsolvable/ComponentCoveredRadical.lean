/-!
# The source radical inside the selected component's smaller overgroup

If the reciprocal point centralizer is a {2,3}-group and nine does not divide
|K|, its two-residual is generated by cubics. The genuine theta(N(L))=L
calculation places that residual in L in both covering cases. Sylow
supplementation then places the reciprocal point centralizer in the actual
L₁T, without assuming L₁≤K.

In the covered original row this identifies R=O₂(L₁T) with the two-core
of C_{KR}(d), where d is the original fixed-line generator. The general
relative-normality argument retains KR=K R(T∩K), not all of KT. The A₅ and
doubled-natural consumers discharge the numerical and point hypotheses
from their actual marked modules.

Structural1222 remains the genuine universal earlier premise. Its final
same-G,T specialization and discharge stay with the original source owners;
no universal instance is inferred from Structural1222At.
Source: Aschbacher–Smith 12.2.8 and 13.4.10, printed pp.797,908.
-/

public noncomputable section
open Subgroup Theory.GroupTheory Stellmacher
open scoped Pointwise
namespace CFSG.Quasithin.Chapter13.Section04.FixedCoreSource.Nonsolvable
open Chapter12.Section02 Chapter14.Section03.FaithfulSource
universe u
variable {G : Type u} [Group G] [Finite G] {T : Sylow 2 G} {L K V : Subgroup G}

private theorem reciprocal_residual_le_original
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (D : ChosenModule T L V) (m : CoreMarking D)
    (h23 : IsPiGroup twoThreePrimes (K ⊓ normalizer (L : Set G) : Subgroup G))
    (h9 : ¬ 9 ∣ Nat.card K) :
    (pResidual 2 (K ⊓ normalizer (L : Set G) : Subgroup G)).map
      (K ⊓ normalizer (L : Set G)).subtype ≤ L := by
  let C := K ⊓ normalizer (L : Set G)
  let B := pResidual 2 C
  have h9B : ¬ 9 ∣ Nat.card B := fun hd => h9 (hd.trans
    (B.card_subgroup_dvd_card.trans (card_dvd_of_le (show C ≤ K from inf_le_left))))
  have hgen := cubic_closure_eq_top_of_twoPerfect
    (h23.of_injective B.subtype B.subtype_injective) (isPPerfect_pResidual 2) h9B
  let f := C.subtype.comp B.subtype
  have hf : Function.Injective f := C.subtype_injective.comp B.subtype_injective
  have hm := congrArg (Subgroup.map f) hgen
  rw [MonoidHom.map_closure,←MonoidHom.range_eq_map] at hm
  have htheta := h.toHypothesis1221.source_theta_eq_of_central_quotient_six
    D.sylow_normalizes_component
    (fun _ _ _ => ChapterA.Section02.theoremA_knownSimple)
    (fun _ _ _ => ChapterA.Section02.theoremC_knownSimple) (augmentationCentralQuotient D m)
  have hr : f.range = B.map C.subtype := by
    rw [MonoidHom.range_comp,range_subtype]
  rw [←hr,←hm,←htheta]
  apply Subgroup.closure_mono
  rintro x ⟨b,hb,rfl⟩
  exact ⟨b.val.property.2,(orderOf_injective f hf b).trans hb⟩

/-- The reciprocal point centralizer lies in the original L₁T, without
requiring the original residual itself to lie in K. -/
theorem reciprocal_point_le_original_parabolic
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (D : ChosenModule T L V) (m : CoreMarking D)
    (hc : Nat.card (center (L ⧸ pCore 2 L)) = 3)
    (z : V) (hzT : z.val ∈ omegaOneCenterAmbient (T : Subgroup G))
    (hzL : z.val ∉ centralizer (L : Set G))
    (hKz : K ≤ centralizer ({z.val} : Set G))
    (hTK : (T : Subgroup G) ≤ normalizer (K : Set G))
    (h23 : IsPiGroup twoThreePrimes (K ⊓ normalizer (L : Set G) : Subgroup G))
    (h9 : ¬ 9 ∣ Nat.card K) :
    K ⊓ normalizer (L : Set G) ≤
      Solvable.firstCentralizerResidual L z.val ⊔ (T : Subgroup G) := by
  let C := K ⊓ normalizer (L : Set G)
  have hn : (T : Subgroup G) ≤ normalizer (C : Set G) :=
    (le_inf hTK (D.sylow_normalizes_component.trans (normalizer (L : Set G)).le_normalizer)).trans
      inf_normalizer_le_normalizer_inf
  have hR : (pResidual 2 C).map C.subtype ≤ L ⊓ centralizer ({z.val} : Set G) :=
    le_inf (reciprocal_residual_le_original h D m h23 h9)
      ((map_subtype_le _).trans (inf_le_left.trans hKz))
  have hCT : C ≤ L ⊔ (T : Subgroup G) := by
    apply le_trans (show C ≤ C ⊔ (T : Subgroup G) from le_sup_left)
    rw [←embedded_pResidual_sup_sylow_of_normalizes T C hn]
    exact sup_le (hR.trans (inf_le_left.trans le_sup_left)) le_sup_right
  rw [covered_augmentation_point_parabolic D m hc z hzT hzL]
  exact le_inf hCT (inf_le_left.trans hKz)

/-- The literal source R is the point radical in KR=K R(T∩K). -/
theorem covered_component_point_radical
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (structural : Structural1222.{u} KnownSimple.IsKnownSimple)
    (D : ChosenModule T L V) (m : CoreMarking D)
    (hc : Nat.card (center (L ⧸ pCore 2 L)) = 3)
    (z : V) (hzT : z.val ∈ omegaOneCenterAmbient (T : Subgroup G))
    (hzL : z.val ∉ centralizer (L : Set G))
    (hKz : K ≤ centralizer ({z.val} : Set G))
    (hHN : centralizer ({z.val} : Set G) ≤ normalizer (K : Set G))
    (h23 : IsPiGroup twoThreePrimes (K ⊓ normalizer (L : Set G) : Subgroup G))
    (h9 : ¬ 9 ∣ Nat.card K) :
    let R := (Solvable.firstCentralizerResidual L z.val ⊔ (T : Subgroup G)).pCoreIn 2
    ((K ⊔ R) ⊓ centralizer ({m.constant.val} : Set G)).pCoreIn 2 = R := by
  let P := Solvable.firstCentralizerResidual L z.val ⊔ (T : Subgroup G)
  have hPH : P ≤ centralizer ({z.val} : Set G) := sup_le
    ((Solvable.firstCentralizerResidual_le L z.val).trans inf_le_right)
    (Solvable.original_sylow_le_centralizer hzT)
  have hPM : P ≤ normalizer (L : Set G) := sup_le
    ((Solvable.firstCentralizerResidual_le L z.val).trans inf_le_left |>.trans L.le_normalizer)
    D.sylow_normalizes_component
  rw [fixed_generator_centralizer h structural D m
    ⟨m.constant.property,m.constant_fixed⟩ (fun hh => m.constant_ne_one (Subtype.ext hh))]
  exact point_twoCore_eq_of_normalized_join K P _ hPM (hPH.trans hHN)
    (reciprocal_point_le_original_parabolic h D m hc z hzT hzL hKz
      ((Solvable.original_sylow_le_centralizer hzT).trans hHN) h23 h9)



end CFSG.Quasithin.Chapter13.Section04.FixedCoreSource.Nonsolvable
