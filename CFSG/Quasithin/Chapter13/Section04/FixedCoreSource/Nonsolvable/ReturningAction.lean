module
public import CFSG.Quasithin.Chapter13.Section04.FixedCoreSource.Nonsolvable.WeightTwoReturning
/-!
# The permutation image of the original returning conjugate

An elementary actor whose nonzero displacements all have weight two
acts through a single transposition on the five-dimensional augmentation
core. Apply this to the actual rank-one returning conjugate from the
coset graph. Since the original L maps onto A6, this odd actor also
proves that the full normalizer action maps onto S6. Its original
central-core projection, module coordinates and centralizer kernel
are retained.

The terminal actor selection uses the same displacement calculation,
then lifts an even model conjugator through the actual L projection.
Source: Aschbacher–Smith 13.4.17(2) and the final proof of 13.4.1,
printed pp.914–915, refs/quasithin.pdf.
-/

public noncomputable section
open Subgroup Theory.GroupTheory Representation Representation.BinaryOffender
open scoped IsMulCommutative commutatorElement
namespace CFSG.Quasithin.Chapter13.Section04.FixedCoreSource.Nonsolvable
open Chapter12.Section02 BinaryConjugationCoordinates Stellmacher
open Chapter14.Section03.FaithfulSource Section03.Noncentrality.SupercriticalSource
open Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.SmallExtension.MarkedMS
open AlternatingSixReconstruction.Natural.Exhaustion
universe u
variable {G : Type u} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}

omit [Finite G] in
/-- Weight-two displacements identify the original elementary actor's
image with the group generated by one transposition, under any exact
permutation marking of the normalizer action. -/
theorem core_weight_two_actor_image
    (D : ChosenModule T L V) (m : CoreMarking D)
    (M A : Subgroup G) (hn : M ≤ normalizer (V : Set G))
    (q : M →* Equiv.Perm (Fin 6))
    (hq : ∀ (a : M) (v : V),
      (m.coordinate (V.normalizerMonoidHom (inclusion hn a) v)).toAdd =
        BinaryPermutation.coreRepresentation (Fin 6) (q a) (m.coordinate v).toAdd)
    [IsElementaryAbelian 2 A] (hAM : A ≤ M)
    (hw : ∀ v : V, v.val ∈ ⁅V,A⁆ → v ≠ 1 → m.weight v = 2)
    (hm : ⁅V,A⁆ ≠ ⊥) :
    ∃ t ∈ (q.comp (inclusion hAM)).range, t.IsSwap ∧
      (q.comp (inclusion hAM)).range = zpowers t := by
  let f := q.comp (inclusion hAM)
  have hf (a : A) (v : V) :
      (m.coordinate (V.normalizerMonoidHom ⟨a.val,(hAM.trans hn) a.property⟩ v)).toAdd =
        BinaryPermutation.coreRepresentation (Fin 6) (f a) (m.coordinate v).toAdd :=
    hq (inclusion hAM a) v
  let : IsElementaryAbelian 2 f.range :=
    IsElementaryAbelian.of_surjective f.rangeRestrict f.rangeRestrict_surjective
  have hdispl (a : A) (v : V) :
      (m.coordinate (V.normalizerMonoidHom ⟨a.val,(hAM.trans hn) a.property⟩ v * v⁻¹)).toAdd =
        BinaryPermutation.coreRepresentation (Fin 6) (f a) (m.coordinate v).toAdd -
          (m.coordinate v).toAdd := by
    rw [map_mul,map_inv]
    simp only [toAdd_mul,toAdd_inv,←sub_eq_add_neg]
    exact congrArg (fun x => x - (m.coordinate v).toAdd) (hf a v)
  have hweights : ∀ a ∈ f.range, ∀ v : BinaryPermutation.core (Fin 6),
      BinaryPermutation.coreRepresentation (Fin 6) a v ≠ v →
      BinaryPermutation.wordWeight (BinaryPermutation.coreRepresentation (Fin 6) a v - v).val = 2 := by
    rintro _ ⟨a,rfl⟩ v hv
    let w := m.coordinate.symm (Multiplicative.ofAdd v)
    let c : V := V.normalizerMonoidHom ⟨a.val,(hAM.trans hn) a.property⟩ w * w⁻¹
    have hc : (m.coordinate c).toAdd = BinaryPermutation.coreRepresentation (Fin 6) (f a) v - v := by
      simpa only [w,m.coordinate.apply_symm_apply,toAdd_ofAdd] using hdispl a w
    have hcV : c.val ∈ ⁅V,A⁆ := by
      rw [commutator_comm]
      exact commutator_mem_commutator a.property w.property
    have hc1 : c ≠ 1 := by
      intro he
      rw [he,map_one] at hc
      exact hv (sub_eq_zero.mp hc.symm)
    have hh := hw c hcV hc1
    change BinaryPermutation.wordWeight (m.coordinate c).toAdd.val = 2 at hh
    rwa [hc] at hh
  have hne : f.range ≠ ⊥ := by
    intro he
    apply hm
    rw [commutator_comm]
    apply commutator_eq_bot_iff_le_centralizer.mpr
    intro a ha v hv
    have hfa : f ⟨a,ha⟩ = 1 := (eq_bot_iff_forall _).mp he _ ⟨⟨a,ha⟩,rfl⟩
    have hh := hf ⟨a,ha⟩ ⟨v,hv⟩
    rw [hfa,map_one,Module.End.one_apply] at hh
    have hc := congrArg Subtype.val (m.coordinate.injective (Multiplicative.toAdd.injective hh))
    change a*v*a⁻¹ = v at hc
    exact (mul_inv_eq_iff_eq_mul.mp hc).symm
  exact BinaryPermutation.SixCoreWeightTwo.actor_eq_zpowers f.range hne hweights

/-- The original returning conjugate acts as a transposition. In particular
the full original normalizer action is onto S6, with the literal marking
on L and its actual centralizer kernel retained. -/
theorem escaping_original_returning_action
    (hl : LargeDistanceInput.{u} KnownSimple.IsKnownSimple)
    (h₀ : Hypothesis1331 T L)
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (structural : Structural1222.{u} KnownSimple.IsKnownSimple)
    (modules : Theorem1222ModulesAt KnownSimple.IsKnownSimple T)
    (D : ChosenModule T L V) (m : CoreMarking D)
    (h1332 : Source1332OneTwo T)
    (fixed : Section03.SourceCompletion.OriginalFixedModule1332At T L)
    (five : Section03.SourceCompletion.OriginalAlternatingFiveModules1332At T L)
    (covered : OriginalCoveredNatural1332At T L)
    (h13316 : ∀ A : Subgroup G, Hypothesis1331 T A →
      ¬ ClassicalGroup.IsPSU (A ⧸ pCore 2 A) 3 3)
    (hindex : ((omegaOneCenterAmbient (T : Subgroup G)) ⊓ centralizer (L : Set G)).relIndex
      (omegaOneCenterAmbient (T : Subgroup G)) = 2)
    (hM : normalizer (L : Set G) = L ⊔ (T : Subgroup G))
    (h1347 : Solvable.PlaneAmalgamSource1347 D m)
    (hpair1347 : PairAmalgamSource1347 T)
    (h1338 : ∀ H ∈ Chapter1.HOutside G (T : Set G) (normalizer (L : Set G) : Set G),
      ∀ Y : Subgroup G, Y ≤ H → H ≤ normalizer (Y : Set G) →
        IsPPerfect 2 Y → Y ≤ normalizer (L : Set G) → IsPiGroup twoThreePrimes Y)
    (hfusion : ∀ v : V, v ≠ 1 → ∀ w ∈ V, IsConj v.val w →
      ∃ n ∈ normalizer (V : Set G), MulAut.conj n v.val = w)
    (hnonsolvable : ∀ w : V,
      w.val ∈ omegaOneCenterAmbient (T : Subgroup G) →
      w.val ∉ centralizer (L : Set G) →
      ¬ centralizer ({w.val} : Set G) ≤ normalizer (L : Set G) →
      ¬ Group.IsSolvable (centralizer ({w.val} : Set G)))
    (z : V) (hz1 : z ≠ 1)
    (hzT : z.val ∈ omegaOneCenterAmbient (T : Subgroup G))
    (hzout : ¬ centralizer ({z.val} : Set G) ≤ normalizer (L : Set G)) :
    ∃ q : normalizer (L : Set G) →* Equiv.Perm (Fin 6),
      Function.Surjective q ∧
      (∀ (a : normalizer (L : Set G)) (v : V),
        (m.coordinate (V.normalizerMonoidHom
          (inclusion (normalizer_component_le_module h structural D m) a) v)).toAdd =
            BinaryPermutation.coreRepresentation (Fin 6) (q a) (m.coordinate v).toAdd) ∧
      (∀ l : L, q (inclusion L.le_normalizer l) =
        (m.quotient (QuotientGroup.mk' (Section08.TransvectionRecognition.Component.ModelExtension.centralCore L) l)).val) ∧
      q.ker = (centralizer (V : Set G)).subgroupOf (normalizer (L : Set G)) ∧
      ∃ g ∈ centralizer ({z.val} : Set G),
        ⁅V,V.conjBy g⁆ = zpowers z.val ∧ z.val ∈ V.conjBy g ∧
        ∃ hg : V.conjBy g ≤ normalizer (L : Set G),
          ∃ t ∈ (q.comp (inclusion hg)).range, t.IsSwap ∧
            (q.comp (inclusion hg)).range = zpowers t := by
  classical
  obtain ⟨hw2,_,g,hg,hcomm,hzg,hgM⟩ := escaping_original_rank_one_return
    hl h₀ h structural modules D m h1332 fixed five covered h13316 hindex hM
      h1347 hpair1347 h1338 hfusion hnonsolvable z hz1 hzT hzout
  have hn := normalizer_component_le_module h structural D m
  obtain ⟨q,hq,hqL,hker⟩ := exists_core_normalizer_permutation D m hn
  let := D.elementary
  let : IsElementaryAbelian 2 (V.conjBy g) := IsElementaryAbelian.map _
  have hzorder : orderOf z.val = 2 := orderOf_eq_prime
    (elemPow_eq_one_of_isElementaryAbelian z.val z.property)
    (fun he => hz1 (Subtype.ext he))
  have hweights : ∀ v : V, v.val ∈ ⁅V,V.conjBy g⁆ → v ≠ 1 → m.weight v = 2 := by
    intro v hv hv1
    rw [hcomm,mem_zpowers_iff_mem_range_orderOf,hzorder] at hv
    obtain ⟨n,hn,he⟩ := Finset.mem_image.mp hv
    have hn2 := Finset.mem_range.mp hn
    interval_cases n
    · exact (hv1 (Subtype.ext (by simpa using he.symm))).elim
    · have hvz : v = z := Subtype.ext (by simpa using he.symm)
      rwa [hvz]
  have hmove : ⁅V,V.conjBy g⁆ ≠ ⊥ := by
    rw [hcomm]
    intro he
    have hh := he ▸ mem_zpowers z.val
    exact hz1 (Subtype.ext (mem_bot.mp hh))
  obtain ⟨t,ht,htswap,htimage⟩ := core_weight_two_actor_image D m _ (V.conjBy g)
    hn q hq hgM hweights hmove
  have hAlt : alternatingGroup (Fin 6) ≤ q.range := by
    intro a ha
    obtain ⟨b,hb⟩ := m.quotient.surjective ⟨a,ha⟩
    obtain ⟨l,rfl⟩ := QuotientGroup.mk'_surjective _ b
    exact ⟨inclusion L.le_normalizer l,(hqL l).trans (congrArg Subtype.val hb)⟩
  have hsurj : Function.Surjective q := by
    have hi : q.range.index ∣ 2 := by
      simpa only [alternatingGroup.index_eq_two] using index_dvd_of_le hAlt
    rcases (Nat.dvd_prime Nat.prime_two).mp hi with hi | hi
    · exact MonoidHom.range_eq_top.mp (index_eq_one.mp hi)
    · have he := Equiv.Perm.eq_alternatingGroup_of_index_eq_two hi
      obtain ⟨a,ha⟩ := ht
      have htq : t ∈ q.range := ⟨inclusion hgM a,ha⟩
      rw [he] at htq
      have hh := htswap.sign_eq
      rw [Equiv.Perm.mem_alternatingGroup.mp htq] at hh
      contradiction
  exact ⟨q,hsurj,hq,hqL,hker,g,hg,hcomm,hzg,hgM,t,ht,htswap,htimage⟩

end CFSG.Quasithin.Chapter13.Section04.FixedCoreSource.Nonsolvable
