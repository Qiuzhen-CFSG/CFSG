theorem columnMatrix3_checked : ∀ v : Fin 3 → F,
    (∑ i, star (v i) * v i) = 1 →
    star (columnMatrix3 v) * columnMatrix3 v = 1 ∧
      (∀ i, columnMatrix3 v i 0 = v i) := by decide +kernel

