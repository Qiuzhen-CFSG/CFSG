def columnMatrix4 (v : Fin 4 → F) : Matrix (Fin 4) (Fin 4) F :=
  decodeMatrix 4 (columnCodes4 (vectorCode v))

theorem columnMatrix4_checked : ∀ v : Fin 4 → F,
    (∑ i, star (v i) * v i) = 1 →
    star (columnMatrix4 v) * columnMatrix4 v = 1 ∧
      (∀ i, columnMatrix4 v i 0 = v i) := by decide +kernel


theorem col_surjective3 : Function.Surjective (col (n := 2)) := by
  intro v
  have h := columnMatrix3_checked v.val v.property
  exact ⟨⟨columnMatrix3 v.val, Matrix.mem_unitaryGroup_iff'.mpr h.1⟩,
    Subtype.ext (funext h.2)⟩

theorem col_surjective4 : Function.Surjective (col (n := 3)) := by
  intro v
  have h := columnMatrix4_checked v.val v.property
  exact ⟨⟨columnMatrix4 v.val, Matrix.mem_unitaryGroup_iff'.mpr h.1⟩,
    Subtype.ext (funext h.2)⟩

public theorem card_unitary_four :
    Nat.card (Matrix.unitaryGroup (Fin 4) GoldenFour) = 77760 := by
  have h2 : Nat.card (U 2) = 18 := by
    let e : U 2 ≃ {M : Matrix (Fin 2) (Fin 2) F // star M * M = 1} :=
      Equiv.subtypeEquivRight (fun _ => Matrix.mem_unitaryGroup_iff')
    rw [Nat.card_congr e, Nat.card_eq_fintype_card]
    decide +kernel
  have h3 : Nat.card (C 3) = 36 := by rw [Nat.card_eq_fintype_card]; decide +kernel
  have h4 : Nat.card (C 4) = 120 := by rw [Nat.card_eq_fintype_card]; decide +kernel
  rw [card_step col_surjective4, card_step col_surjective3, h2, h3, h4]

