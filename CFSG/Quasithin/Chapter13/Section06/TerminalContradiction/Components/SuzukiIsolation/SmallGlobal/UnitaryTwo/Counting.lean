/-!
# Counting the field-two unitary endpoint by orthonormal columns

The full isometry group on four coordinates over the existing computable
field `GoldenFour` has order 77760. The first-column fibers are identified
with the unitary group on one fewer coordinate: multiply by the inverse of
an orthonormal completion, then delete the fixed first row and column.
There are 120 unit columns in dimension four, 36 in dimension three, and
18 unitary matrices in dimension two.

The small completion tables were generated by `source/generate_columns.py`.
Lean checks every completion, its first column, and all three finite counts
by kernel reduction. No enumeration of all four-by-four matrices is used.
The generator is untrusted; only the checked identities enter the proof.

This is the precise order-divisibility calculation needed for the PSU₄(2)
endpoint of Aschbacher–Smith 5.2.3, printed p.649/PDF666, in the final
component exclusion of 13.6.27, printed p.934/PDF951 (`refs/quasithin.pdf`).
The actual arbitrary-form and projective transports are in `UnitaryTwo.lean`.
-/

open Matrix Atlas.Algebra

namespace CFSG.Quasithin.Chapter13.Section06.TerminalContradiction.Components.SuzukiIsolation.SmallGlobalUnitary

abbrev F := GoldenFour
abbrev U (n : ℕ) := Matrix.unitaryGroup (Fin n) F
abbrev C (n : ℕ) := {v : Fin n → F // ∑ i, star (v i) * v i = 1}

variable {n : ℕ}

def col (A : U (n + 1)) : C (n + 1) :=
  ⟨fun i => A.val i 0, by
    have h := congrArg (fun M : Matrix (Fin (n+1)) (Fin (n+1)) F => M 0 0)
      (Matrix.mem_unitaryGroup_iff'.mp A.property)
    simpa [Matrix.mul_apply, Matrix.star_apply] using h⟩

theorem col_mul_eq (A B D : U (n+1)) (h : col B = col D) :
    col (A*B) = col (A*D) := by
  apply Subtype.ext
  funext i
  change ∑ k, A.val i k * B.val k 0 = ∑ k, A.val i k * D.val k 0
  exact Finset.sum_congr rfl (fun k _ => congrArg (A.val i k * ·)
    (congrArg (fun v : C (n+1) => v.val k) h))

abbrev Fix (n : ℕ) := {A : U (n+1) // col A = col 1}

theorem fix_col (A : Fix n) (i : Fin (n+1)) :
    A.val.val i 0 = if i = 0 then 1 else 0 :=
  congrArg (fun v : C (n+1) => v.val i) A.property

theorem fix_row (A : Fix n) (i : Fin (n+1)) :
    A.val.val 0 i = if i = 0 then 1 else 0 := by
  have h := col_mul_eq A.val⁻¹ A.val 1 A.property
  simp only [inv_mul_cancel, mul_one] at h
  have hi := congrArg (fun v : C (n+1) => star (v.val i)) h.symm
  change star (star (A.val.val 0 i)) =
    star ((1 : Matrix (Fin (n+1)) (Fin (n+1)) F) i 0) at hi
  simpa only [star_star, Matrix.one_apply, apply_ite, star_one, star_zero] using hi

def tail (A : Fix n) : U n :=
  ⟨Matrix.of (fun i j => A.val.val i.succ j.succ), by
    apply Matrix.mem_unitaryGroup_iff'.mpr
    apply Matrix.ext
    intro i j
    have h := congrArg (fun M : Matrix (Fin (n+1)) (Fin (n+1)) F => M i.succ j.succ)
      (Matrix.mem_unitaryGroup_iff'.mp A.val.property)
    simpa only [Matrix.mul_apply, Matrix.star_apply, Fin.sum_univ_succ,
      fix_row, Fin.succ_ne_zero, if_false, star_zero, zero_mul, zero_add,
      Matrix.one_apply, Fin.succ_inj, Matrix.of_apply] using h⟩

def blockMatrix (A : U n) : Matrix (Fin (n+1)) (Fin (n+1)) F :=
  fun i => Fin.cases (Fin.cases 1 (fun _ => 0))
    (fun i => Fin.cases 0 (fun j => A.val i j)) i

def block (A : U n) : Fix n := by
  refine ⟨⟨blockMatrix A, ?_⟩, ?_⟩
  · apply Matrix.mem_unitaryGroup_iff'.mpr
    apply Matrix.ext
    intro i j
    refine Fin.cases ?_ (fun i => ?_) i <;> refine Fin.cases ?_ (fun j => ?_) j
    · simp [Matrix.mul_apply, Matrix.star_apply, blockMatrix, Fin.sum_univ_succ]
    · simp [Matrix.mul_apply, Matrix.star_apply, blockMatrix, Fin.sum_univ_succ,
        Ne.symm (Fin.succ_ne_zero j)]
    · simp [Matrix.mul_apply, Matrix.star_apply, blockMatrix, Fin.sum_univ_succ]
    · have h := congrArg (fun M : Matrix (Fin n) (Fin n) F => M i j)
        (Matrix.mem_unitaryGroup_iff'.mp A.property)
      simpa [Matrix.mul_apply, Matrix.star_apply, blockMatrix, Fin.sum_univ_succ, Matrix.one_apply] using h
  · apply Subtype.ext
    funext i
    refine Fin.cases ?_ (fun i => ?_) i <;> simp [col, blockMatrix]

def tailEquiv : Fix n ≃ U n where
  toFun := tail
  invFun := block
  left_inv A := by
    apply Subtype.ext
    apply Subtype.ext
    apply Matrix.ext
    intro i j
    refine Fin.cases ?_ (fun i => ?_) i <;> refine Fin.cases ?_ (fun j => ?_) j
    · simpa [block, blockMatrix] using (fix_col A 0).symm
    · simpa [block, blockMatrix] using (fix_row A j.succ).symm
    · simpa [block, blockMatrix] using (fix_col A i.succ).symm
    · rfl
  right_inv A := rfl

noncomputable def fiberEquiv (v : C (n+1)) (r : U (n+1)) (hr : col r = v) :
    {A : U (n+1) // col A = v} ≃ Fix n where
  toFun A := ⟨r⁻¹*A.val, by
    have h := col_mul_eq r⁻¹ A.val r (A.property.trans hr.symm)
    simpa only [inv_mul_cancel] using h⟩
  invFun A := ⟨r*A.val, by
    have h := col_mul_eq r A.val 1 A.property
    simpa only [mul_one, hr] using h⟩
  left_inv A := by apply Subtype.ext; simp
  right_inv A := by apply Subtype.ext; simp

theorem card_step (hs : Function.Surjective (col (n := n))) :
    Nat.card (U (n+1)) = Nat.card (C (n+1)) * Nat.card (U n) := by
  have hf (v : C (n+1)) : Nat.card {A : U (n+1) // col A = v} = Nat.card (U n) := by
    obtain ⟨r, hr⟩ := hs v
    exact Nat.card_congr ((fiberEquiv v r hr).trans tailEquiv)
  rw [← Nat.card_congr (Equiv.sigmaFiberEquiv col), Nat.card_sigma]
  simp only [hf, Finset.sum_const, Finset.card_univ, nsmul_eq_mul, Nat.cast_id,
    Nat.card_eq_fintype_card]




def fieldCode (x : F) : ℕ := x.re.val + 2 * x.im.val

def vectorCode {n : ℕ} (v : Fin n → F) : Fin (4^n) :=
  Fin.ofNat (4^n) (∑ i, fieldCode (v i) * 4 ^ i.val)

def fieldDecode (k : ℕ) : F := ⟨(k % 2 : ℕ), ((k / 2) % 2 : ℕ)⟩

def decodeMatrix (n k : ℕ) : Matrix (Fin n) (Fin n) F :=
  fun i j => fieldDecode (k / 4 ^ (i.val*n+j.val) % 4)

