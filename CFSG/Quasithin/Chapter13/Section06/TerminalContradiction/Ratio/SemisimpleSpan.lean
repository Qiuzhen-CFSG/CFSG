module
public import CFSG.Quasithin.Chapter13.Section06.TerminalContradiction.Ratio.QuotientAction
public import Theory.Representation.ExtendScalars
public import Theory.Representation.NormalSemisimpleSpan
/-!
# The semisimple span of the original terminal section

The literal quotient U_H/V₁ is generated by the images of V₃ under H. This
remains true after scalar extension: descend invariant subspaces along
v ↦ 1 ⊗ v, then use pure tensors to recover the whole extended space.
Consequently, semisimple cyclic modules containing those seed vectors make
the restriction to any normal subgroup of H semisimple.

This is the normal-component span step used after full Suzuki Borel fixation.
It requires no extra spanning hypothesis and preserves the actual source
quotient and action. Source: Aschbacher--Smith, 13.6, printed p.918, and
Notation 13.5.8, printed pp.934--935.
-/

@[expose] public noncomputable section
open Subgroup Representation
open scoped TensorProduct IsMulCommutative MonoidAlgebra
namespace CFSG.Quasithin.Chapter13.Section06.TerminalContradiction.Ratio
open Section08
variable {G : Type*} [Group G] {H V₃ V₁ : Subgroup G}
  [IsElementaryAbelian 2 (Source.UH H V₃)]
  (hn : H ≤ normalizer (V₁ : Set G))

/-- The image of an original V₃ element in the actual quotient U_H/V₁. -/
def seedVector (v : V₃) : Space H V₃ V₁ :=
  Additive.ofMul (QuotientGroup.mk' (V₁.subgroupOf (Source.UH H V₃))
    ⟨v.val,le_conjugateSpanBy V₃ H v.property⟩)


set_option backward.isDefEq.respectTransparency false in
/-- An H-subrepresentation containing every original seed is the whole quotient. -/
theorem eq_top_of_seed_mem (S : Subrepresentation (representation H V₃ V₁ hn))
    (hS : ∀ v : V₃, seedVector (H := H) (V₁ := V₁) v ∈ S) : S = ⊤ := by
  have hall (u : G) (hu : u ∈ Source.UH H V₃) :
      Additive.ofMul (QuotientGroup.mk' (V₁.subgroupOf (Source.UH H V₃)) ⟨u,hu⟩) ∈ S := by
    induction hu using Subgroup.closure_induction with
    | mem x hx =>
      obtain ⟨h,hh,v,hv,rfl⟩ := hx
      have hh := S.apply_mem_toSubmodule ⟨h,hh⟩ (hS ⟨v,hv⟩)
      simp only [seedVector, representation_apply] at hh
      exact hh
    | one =>
      change Additive.ofMul ((QuotientGroup.mk' _) 1) ∈ S
      rw [map_one]
      exact S.toSubmodule.zero_mem
    | mul x y hx hy hxm hym =>
      change Additive.ofMul ((QuotientGroup.mk' _) (⟨x,hx⟩ * ⟨y,hy⟩)) ∈ S
      rw [map_mul]
      exact S.toSubmodule.add_mem hxm hym
    | inv x hx hxm =>
      change Additive.ofMul ((QuotientGroup.mk' _) (⟨x,hx⟩ : Source.UH H V₃)⁻¹) ∈ S
      rw [map_inv]
      exact S.toSubmodule.neg_mem hxm
  apply top_unique
  intro w _
  obtain ⟨u,hu⟩ := QuotientGroup.mk'_surjective (V₁.subgroupOf (Source.UH H V₃)) w.toMul
  have he : Additive.ofMul (QuotientGroup.mk' (V₁.subgroupOf (Source.UH H V₃)) u) = w :=
    congrArg Additive.ofMul hu
  rw [← he]
  exact hall u u.property

variable (K : Type*) [Field K] [Algebra (ZMod 2) K]
set_option backward.isDefEq.respectTransparency false in
/-- Scalar extension preserves generation by the literal original seed vectors. -/
theorem extendScalars_eq_top_of_seed_mem
    (S : Subrepresentation (extendScalars K (representation H V₃ V₁ hn)))
    (hS : ∀ v : V₃, (1 : K) ⊗ₜ[ZMod 2] seedVector (H := H) (V₁ := V₁) v ∈ S) : S = ⊤ := by
  let U : Subrepresentation (representation H V₃ V₁ hn) := {
    toSubmodule := (S.toSubmodule.restrictScalars (ZMod 2)).comap
      (TensorProduct.mk (ZMod 2) K (Space H V₃ V₁) 1)
    apply_mem_toSubmodule h w hw := by
      change (1 : K) ⊗ₜ[ZMod 2] (representation H V₃ V₁ hn h w) ∈ S.toSubmodule
      have hh := S.apply_mem_toSubmodule h hw
      change extendScalars K (representation H V₃ V₁ hn) h ((1 : K) ⊗ₜ[ZMod 2] w) ∈ S.toSubmodule at hh
      simpa only [extendScalars_apply, LinearMap.baseChange_tmul] using hh }
  have hU : U = ⊤ := eq_top_of_seed_mem hn U hS
  apply top_unique
  intro w hwtop
  clear hwtop
  induction w using TensorProduct.induction_on with
  | zero => exact S.toSubmodule.zero_mem
  | tmul c v =>
    have hv : v ∈ U := hU.symm ▸ Submodule.mem_top
    change (1 : K) ⊗ₜ[ZMod 2] v ∈ S.toSubmodule at hv
    have hh := S.toSubmodule.smul_mem c hv
    simp only [TensorProduct.smul_tmul', smul_eq_mul, mul_one] at hh
    exact hh
  | add x y hx hy => exact S.toSubmodule.add_mem hx hy
set_option backward.isDefEq.respectTransparency false in
/-- Borel-fixed semisimple seed modules generate a semisimple normal-component
restriction on the original source quotient. -/
theorem extendScalars_normal_restriction_semisimple
    (D : Subgroup H) [D.Normal]
    (hseed : ∀ v : V₃, ∃ S : Subrepresentation
      ((extendScalars K (representation H V₃ V₁ hn)).comp D.subtype),
      (1 : K) ⊗ₜ[ZMod 2] seedVector (H := H) (V₁ := V₁) v ∈ S ∧
      Subrepresentation.IsSemisimple S) :
    IsSemisimpleModule K[D] (Representation.asModule
      ((extendScalars K (representation H V₃ V₁ hn)).comp D.subtype)) := by
  choose S hmem hsemi using hseed
  apply normal_restriction_semisimple_of_generating_family _ D S hsemi
  intro U hU
  apply extendScalars_eq_top_of_seed_mem hn K U
  intro v
  exact hU v (hmem v)

end CFSG.Quasithin.Chapter13.Section06.TerminalContradiction.Ratio
