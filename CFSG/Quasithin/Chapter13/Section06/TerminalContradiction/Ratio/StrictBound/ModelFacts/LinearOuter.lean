module

public import CFSG.Quasithin.Chapter13.Section06.TerminalContradiction.Ratio.StrictBound.Models
public import Theory.SpecificGroups.PSL3.OuterSolvable.Coverage
public import Theory.SpecificGroups.PSL3.OuterSolvable.StandardQuotient
public import Theory.SpecificGroups.PSL3.OuterSolvable
public import Mathlib.Algebra.Algebra.ZMod

/-!
# A cardinal bound for the actual outer group of PSL₃(4)

The determinant kernel acts by inner automorphisms, so the diagonal image
in Aut/Inn has order dividing |F₄ˣ| = 3. The relative field–graph quotient
is an image of the product of the field automorphisms and the cyclic group
generated by inverse transpose; its order divides four. Standard-automorphism
coverage then bounds the full outer order by divisibility into twelve.

This uses the actual projective quotient and graph action. No splitting,
independent simplicity certification, or unconnected model tag is needed.
Source: GLS3, Theorem 2.5.12 and §2.7; Aschbacher–Smith, combined manuscript
(1 March 2004), printed pp.934–935.
-/

public section

open Subgroup Theory.GroupTheory
open CFSG.Quasithin.Chapter13.Section06.TerminalContradiction
namespace CFSG.Quasithin.Chapter13.Section06.TerminalContradiction.Ratio.StrictBound.ModelFacts

private theorem card_range_dvd_of_ker_le
    {A C D : Type*} [Group A] [Group C] [Group D]
    (d : A →* C) (f : A →* D) (hk : d.ker ≤ f.ker) :
    Nat.card f.range ∣ Nat.card C := by
  have hk' : d.ker ≤ f.rangeRestrict.ker := by
    simpa only [MonoidHom.ker_rangeRestrict] using hk
  have hd := card_dvd_of_surjective (QuotientGroup.lift d.ker f.rangeRestrict hk')
    (QuotientGroup.lift_surjective_of_surjective d.ker f.rangeRestrict
      f.rangeRestrict_surjective hk')
  rw [Nat.card_congr (QuotientGroup.quotientKerEquivRange d).toEquiv] at hd
  exact hd.trans (card_subgroup_dvd_card d.range)

private theorem four_fieldAut_card_dvd : Nat.card (Components.F4 ≃+* Components.F4) ∣ 2 := by
  let f : (Components.F4 ≃+* Components.F4) →*
      (Components.F4 ≃ₐ[ZMod 2] Components.F4) :=
    { toFun := fun σ => AlgEquiv.ofRingEquiv (f := σ) (fun z => by
        exact congrArg (fun f : ZMod 2 →+* Components.F4 => f z)
          (Subsingleton.elim (σ.toRingHom.comp (algebraMap (ZMod 2) Components.F4))
            (algebraMap (ZMod 2) Components.F4)))
      map_one' := by ext; rfl
      map_mul' := by intros; ext; rfl }
  have hi : Function.Injective f := fun σ τ h => RingEquiv.ext fun x =>
    congrArg (fun f : Components.F4 ≃ₐ[ZMod 2] Components.F4 => f x) h
  have h := card_dvd_of_injective f hi
  rwa [IsGalois.card_aut_eq_finrank, GaloisField.finrank 2 (by decide)] at h

open Matrix.PSL3.OuterSolvable

private theorem four_standardQuotient_card_dvd :
    Nat.card (StandardOuterQuotient Components.F4) ∣ 4 := by
  let f := fieldStandardQuotient Components.F4
  let g := graphStandardQuotient Components.F4
  have hc : ∀ σ (z : zpowers g), Commute (f σ) ((zpowers g).subtype z) := by
    intro σ ⟨z, hz⟩
    obtain ⟨n, rfl⟩ := hz
    exact (fieldStandardQuotient_commute_graph Components.F4 σ).zpow_right n
  let φ := f.noncommCoprod (zpowers g).subtype hc
  have hs : Function.Surjective φ := by
    apply MonoidHom.range_eq_top.mp
    exact (MonoidHom.noncommCoprod_range f (zpowers g).subtype hc).trans
      (by rw [range_subtype]; exact standardOuterQuotient_generators Components.F4)
  have hg : Nat.card (zpowers g) ∣ 2 := by
    rw [Nat.card_zpowers]
    exact orderOf_dvd_of_pow_eq_one (graphStandardQuotient_sq Components.F4)
  have hd := card_dvd_of_surjective φ hs
  rw [Nat.card_prod] at hd
  exact hd.trans (Nat.mul_dvd_mul four_fieldAut_card_dvd hg)

theorem l3Four_outer_card_dvd : Nat.card (MulAut.Outer Components.L3Four) ∣ 12 := by
  have hcover := standard_eq_top_of_two_power_card Components.F4
    (by decide : 0 < 2) (GaloisField.card 2 2 (by decide))
  have htop := standardOuter_eq_top_of_standard_eq_top Components.F4 hcover
  have hd : Nat.card (innerDiagonalOuter Components.F4) ∣ 3 := by
    have h := card_range_dvd_of_ker_le Matrix.GeneralLinearGroup.det
      (linearOuterAction Components.F4) (det_ker_le_linearOuterAction_ker Components.F4)
    simpa only [innerDiagonalOuter, Nat.card_units, GaloisField.card 2 2 (by decide),
      Nat.reducePow, Nat.reduceSub] using h
  have hn : Nat.card ((innerDiagonalOuter Components.F4).subgroupOf
      (standardOuter Components.F4)) ∣ 3 := by
    rw [Nat.card_congr (subgroupOfEquivOfLe
      (innerDiagonalOuter_le_standardOuter Components.F4)).toEquiv]
    exact hd
  have he := card_eq_card_quotient_mul_card_subgroup
    ((innerDiagonalOuter Components.F4).subgroupOf (standardOuter Components.F4))
  have ho : Nat.card (standardOuter Components.F4) ∣ 12 := by
    rw [he]
    exact Nat.mul_dvd_mul four_standardQuotient_card_dvd hn
  rwa [htop, Nat.card_congr topEquiv.toEquiv] at ho

end CFSG.Quasithin.Chapter13.Section06.TerminalContradiction.Ratio.StrictBound.ModelFacts
