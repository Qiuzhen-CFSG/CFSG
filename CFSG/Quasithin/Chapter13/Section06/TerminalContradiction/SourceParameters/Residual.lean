module

public import CFSG.Quasithin.Chapter13.Section06.TerminalContradiction.SourceParameters.Cores
public import CFSG.Quasithin.MainForward.SourceFamilies
public import Theory.GroupTheory.PResidual.PrimeSet

/-!
# The residual application of 13.3.8(2)

For X = O^{p′}(O_{2,p}(H)), the solvable member of H(T) used by
13.6.25(3) is X T. Its two-core contains O₂(H), since the latter is
nontrivial, normal in H, and contained in T. The prime-to-p residual
has no nontrivial two-group quotient when p > 3, so it satisfies the
Y = O²(Y) hypothesis of 13.3.8(2). That earlier theorem makes X a
{2,3}-group, forcing X = 1 and hence the asserted iterated-core equality.

`Earlier1338Two` is the universal earlier implication, with the literal
faithful family, relative normality and full H(T,M) family. Its producer
is Chapter 13 §3 (`qt-13-03-preliminaries`). This file proves the
residual-specific applicability; the 13.6.25(3) premise remains to be
assembled in the owning SourceParameters task.

Source: Aschbacher–Smith, combined manuscript (1 March 2004),
13.3.8(2) and 13.6.26(2), printed pp.886–887, 934.
-/

@[expose] public section
namespace CFSG.Quasithin.Chapter13.Section06.TerminalContradiction.SourceParameters

open Subgroup

variable {G : Type*} [Group G] [Finite G]

/-- The universal earlier source result in the fixed Hypothesis 13.3.1
setup. All groups and normalizers are the actual ambient subgroups. -/
def Earlier1338Two (T : Sylow 2 G) : Prop :=
  ∀ K ∈ MainForward.faithfulLocalComponents T,
    ∀ H ∈ Chapter1.HOutside G (T : Set G) (normalizer (K : Set G) : Set G),
      ∀ Y : Subgroup G, Y ≤ H → H ≤ normalizer (Y : Set G) →
        IsPPerfect 2 Y → Y ≤ normalizer (K : Set G) → IsPiGroup twoThreePrimes Y

/-- The residual itself is generated by its p-elements, expressed as
idempotence of the correct residual. -/
theorem O2pResidual_primeToResidual_eq_top (H : Subgroup G) (p : ℕ) [Fact p.Prime] :
    primeToResidual p (O2pResidual H p) = ⊤ := by
  let R := primeToResidual p (O2p H p)
  have hR : primeToResidual p R = ⊤ := by
    apply map_injective R.subtype_injective
    rw [embedded_primeToResidual_eq_of_normal p R le_rfl]
    change R = (⊤ : Subgroup R).map R.subtype
    rw [← MonoidHom.range_eq_map, R.range_subtype]
  let e : R ≃* O2pResidual H p :=
    R.equivMapOfInjective (O2p H p).subtype (O2p H p).subtype_injective
  rw [← map_primeToResidual e, hR, map_top_of_surjective _ e.surjective]

/-- The Y = O²(Y) premise of 13.3.8(2) holds for the source residual. -/
theorem O2pResidual_isTwoPerfect (H : Subgroup G) (p : ℕ) [Fact p.Prime]
    (hp : 3 < p) : IsPPerfect 2 (O2pResidual H p) := by
  intro N hN hQ
  let := hN
  obtain ⟨n, hn⟩ := hQ.exists_card_eq
  have hcop : p.Coprime 2 :=
    (Fact.out : p.Prime).coprime_iff_not_dvd.mpr (Nat.not_dvd_of_pos_of_lt (by decide) (by omega))
  have hR := primeToResidual_le_ker (p := p) (QuotientGroup.mk' N)
    (by rw [hn]; exact hcop.pow_right n)
  rw [O2pResidual_primeToResidual_eq_top, QuotientGroup.ker_mk'] at hR
  exact top_le_iff.mp hR

/-- Joining the residual to the actual Sylow subgroup is solvable. -/
theorem O2pResidual_sup_sylow_isSolvable (H : Subgroup G) (T : Sylow 2 G)
    (hTH : (T : Subgroup G) ≤ H) (p : ℕ) [Fact p.Prime] :
    Group.IsSolvable (O2pResidual H p ⊔ (T : Subgroup G) : Subgroup G) := by
  let X := O2pResidual H p
  let J := X ⊔ (T : Subgroup G)
  let A := X.subgroupOf J
  let B := (T : Subgroup G).subgroupOf J
  let : A.Normal := (normal_subgroupOf_iff_le_normalizer le_sup_left).mpr
    (sup_le X.le_normalizer (hTH.trans (le_normalizer_O2pResidual H p)))
  let := O2pResidual_isSolvable H p
  let : Group.IsSolvable A := Group.isSolvable_of_isSolvable_injective
    (f := (subgroupOfEquivOfLe (show X ≤ J from le_sup_left)).toMonoidHom)
    (subgroupOfEquivOfLe (show X ≤ J from le_sup_left)).injective
  let : Group.IsNilpotent B := T.isPGroup'.comap_subtype.isNilpotent
  apply Group.isSolvable_of_normal_sup_eq_top A B
  apply map_injective J.subtype_injective
  rw [Subgroup.map_sup,
    show A.map J.subtype = X from map_subgroupOf_eq_of_le (show X ≤ J from le_sup_left),
    show B.map J.subtype = (T : Subgroup G) from
      map_subgroupOf_eq_of_le (show (T : Subgroup G) ≤ J from le_sup_right),
    ← MonoidHom.range_eq_map, J.range_subtype]

omit [Finite G] in
/-- The solvable overgroup, not X itself, is a member of H(T). -/
theorem O2pResidual_sup_sylow_mem_HOver (H : Subgroup G) (T : Sylow 2 G)
    (hH : H ∈ Chapter1.H G) (hTH : (T : Subgroup G) ≤ H) (p : ℕ) :
    O2pResidual H p ⊔ (T : Subgroup G) ∈ Chapter1.HOver G (T : Set G) := by
  have hcoreT : H.pCoreIn 2 ≤ (T : Subgroup G) := by
    simpa only [Sylow.coe_subtype, map_subgroupOf_eq_of_le hTH] using
      pCoreIn_le_sylow H (T.subtype hTH)
  have hNH : H ≤ normalizer (H.pCoreIn 2 : Set G) :=
    H.le_normalizer.trans (normalizer_le_normalizer_characteristic_image H (pCore 2 H))
  have hc : H.pCoreIn 2 ≤ (O2pResidual H p ⊔ (T : Subgroup G)).pCoreIn 2 :=
    le_pCoreIn_of_normalizes (isPGroup_pCoreIn 2 H) (hcoreT.trans le_sup_right)
      ((sup_le ((O2pResidual_le H p).trans (O2p_le H p)) hTH).trans hNH)
  refine ⟨?_, show (T : Subgroup G) ≤ O2pResidual H p ⊔ (T : Subgroup G) from le_sup_right⟩
  intro hz
  exact hH (le_bot_iff.mp (hc.trans_eq hz))

/-- Literal use of 13.6.25(3), with every H(T) and solvability premise proved. -/
theorem O2pResidual_le_M_of_solvable_HOver (H M : Subgroup G) (T : Sylow 2 G)
    (hH : H ∈ Chapter1.H G) (hTH : (T : Subgroup G) ≤ H)
    (h25 : ∀ J ∈ Chapter1.HOver G (T : Set G), Group.IsSolvable J → J ≤ M)
    (p : ℕ) [Fact p.Prime] : O2pResidual H p ≤ M :=
  le_sup_left.trans (h25 _ (O2pResidual_sup_sylow_mem_HOver H T hH hTH p)
    (O2pResidual_sup_sylow_isSolvable H T hTH p))

/-- A {2,3}-group generated by p-elements for p > 3 is trivial. -/
theorem O2pResidual_eq_bot_of_twoThree (H : Subgroup G) (p : ℕ) [Fact p.Prime]
    (hp : 3 < p) (h23 : IsPiGroup twoThreePrimes (O2pResidual H p)) :
    O2pResidual H p = ⊥ := by
  have hcop : p.Coprime (Nat.card (O2pResidual H p)) := by
    apply (Fact.out : p.Prime).coprime_iff_not_dvd.mpr
    intro hd
    have h := (IsPiGroup_iff _ _).mp h23 ⟨p, Fact.out⟩ hd
    change p = 2 ∨ p = 3 at h
    omega
  have hR := primeToResidual_le_ker (p := p) (MonoidHom.id (O2pResidual H p)) hcop
  rw [O2pResidual_primeToResidual_eq_top] at hR
  apply le_antisymm _ bot_le
  intro x hx
  exact congrArg Subtype.val (hR (show (⟨x, hx⟩ : O2pResidual H p) ∈ ⊤ from trivial))

/-- Source 13.6.26(2) from genuine 13.6.25(3) and universal 13.3.8(2).
The Sylow, relative-normality, residual, and Hz applicability obligations
are all discharged here. -/
theorem source_13_6_26_2_of_13_6_25_3
    (T : Sylow 2 G) (L L₁ G₁ M : Subgroup G)
    (hL : L ∈ MainForward.faithfulLocalComponents T)
    (hM : M = normalizer (L : Set G)) (h1338 : Earlier1338Two T)
    (h25 : ∀ J ∈ Chapter1.HOver G (T : Set G), Group.IsSolvable J → J ≤ M)
    {H : Subgroup G} (hH : H ∈ Chapter13.Section08.Source.Hz L₁ T G₁ M)
    (p : ℕ) [Fact p.Prime] (hp : 3 < p) :
    O2p H p = Chapter13.Section08.Source.QH H := by
  have hTH : (T : Subgroup G) ≤ H := le_sup_right.trans hH.1.2
  have hXM := O2pResidual_le_M_of_solvable_HOver H M T hH.1.1 hTH h25 p
  apply O2p_eq_QH_of_residual_eq_bot H p hp
  apply O2pResidual_eq_bot_of_twoThree H p hp
  apply h1338 L hL H
  · rw [← hM]
    exact ⟨⟨hH.1.1, hTH⟩, hH.2.2⟩
  · exact (O2pResidual_le H p).trans (O2p_le H p)
  · exact le_normalizer_O2pResidual H p
  · exact O2pResidual_isTwoPerfect H p hp
  · simpa only [← hM] using hXM

end CFSG.Quasithin.Chapter13.Section06.TerminalContradiction.SourceParameters
