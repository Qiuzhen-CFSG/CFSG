module

public import CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.CharacteristicTwo.ComponentReduction.InitialSieve.SymmetricSix.Inputs
public import Theory.GroupTheory.PResidual.PrimeToSubnormal
public import Theory.GroupTheory.PResidual.PerfectCover

/-!
# Residual containment and source identifications in the S₆ branch

The cubic quotient of Lᵥ and its two-perfection imply O^{3′}(Lᵥ) = Lᵥ.
Functoriality then embeds Lᵥ in the prime-to-three residual of the actual
centralizer Gᵥ. This is the containment preceding the use of A.3.18;
it does not identify that residual with the component K.

The marking identifies the actual V with the sixteen-element binary
module. The genuine T-normalization of L identifies the Fundamental
Setup's T-conjugate closure L₀ with L. Finally the outside subgroup and
uniqueness premises prove C_T(L) = 1 through the omega-center argument.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004,
13.6.3 and the S₆ paragraph of 13.6.6, printed pp.926–927.
-/

@[expose] public section
open Subgroup Theory.GroupTheory
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentReduction.InitialSieve.SymmetricSix
open A5Module ChapterC
universe u
variable {G : Type u} [Group G] [Finite G] {L V : Subgroup G}
variable {κ : GroupClass.{u}} {T : Sylow 2 G} {s : Marking L V}

/-- The marked space maps isomorphically onto the actual subgroup V. -/
noncomputable def markingEquiv (s : Marking L V) :
    Multiplicative BinaryPermutation.FiveCentralizerGeometry.Space ≃* V :=
  (MonoidHom.ofInjective s.injective).trans (MulEquiv.subgroupCongr s.range_eq)

omit [Finite G] in
theorem marking_commutative (s : Marking L V) : IsMulCommutative V := by
  let e := markingEquiv s
  refine ⟨⟨fun x y => ?_⟩⟩
  obtain ⟨a, rfl⟩ := e.surjective x
  obtain ⟨b, rfl⟩ := e.surjective y
  rw [← map_mul, ← map_mul, mul_comm]

omit [Finite G] in
theorem marking_nontrivial (s : Marking L V) : V ≠ ⊥ := by
  intro he
  apply markedV_ne_one s
  exact (show markedV s ∈ (⊥ : Subgroup G) from
    he ▸ (s.range_eq.le ⟨_, rfl⟩))

/-- The actual two-residual with cubic two-core quotient is generated by its three-elements. -/
theorem lv_primeToResidual_eq_top (s : Marking L V)
    (hc : Nat.card (Lv L (markedV s) ⧸ pCore 2 (Lv L (markedV s))) = 3) :
    primeToResidual 3 (Lv L (markedV s)) = ⊤ := by
  let : Fact (Nat.Prime 3) := ⟨by decide⟩
  let : IsSimpleGroup (Lv L (markedV s) ⧸ pCore 2 (Lv L (markedV s))) :=
    isSimpleGroup_of_prime_card hc
  exact primeToResidual_eq_top_of_simple_quotient 3 2 _ pCore_isPGroup
    (isPPerfect_embedded_pResidual 2 _) (by rw [hc])

/-- The source Lᵥ containment, inside the literal centralizer C_G(v). -/
theorem residual_le_primeToResidual (s : Marking L V)
    (hc : Nat.card (Lv L (markedV s) ⧸ pCore 2 (Lv L (markedV s))) = 3) :
    residual s ≤ primeToResidual 3 (Gv (markedV s)) := by
  apply le_primeToResidual_of_eq_top
  let e := (subgroupOfEquivOfLe (Lv_le_Gv L (markedV s))).symm
  have he := map_primeToResidual (p := 3) e
  rw [lv_primeToResidual_eq_top s hc, map_top_of_surjective _ e.surjective] at he
  exact he.symm

/-- The earlier T-normalization identifies the Fundamental Setup closure with L. -/
theorem SourceData.closure_eq (d : Setup κ T s) {M : Subgroup G}
    (h : SourceData d M) : fundamentalClosure L (T : Subgroup G) = L :=
  le_antisymm (conjugateSpanBy_le le_rfl h.T_normalizes) (le_conjugateSpanBy _ _)

theorem SourceData.M_eq_normalizer (d : Setup κ T s) {M : Subgroup G}
    (h : SourceData d M) : M = normalizer (L : Set G) := by
  rw [h.M_definition, h.closure_eq d]

theorem SourceData.LT_le_M (d : Setup κ T s) {M : Subgroup G}
    (h : SourceData d M) : L ⊔ (T : Subgroup G) ≤ M := by
  rw [h.M_eq_normalizer d]
  exact sup_le L.le_normalizer h.T_normalizes

/-- Discharge C_T(L) = 1 using the source outside subgroup and uniqueness. -/
theorem SourceData.centralizer_T (d : Setup κ T s) {M : Subgroup G}
    (h : SourceData d M) : (T : Subgroup G) ⊓ centralizer (L : Set G) = ⊥ := by
  obtain ⟨H, hout, hH⟩ := h.outside_omega
  have hz := centralizer_omega_eq_bot_of_earlier_source (T : Subgroup G) L M H
    T.isPGroup' h.unique hout hH
  exact centralizer_T_eq_bot_of_omega (T : Subgroup G) L T.isPGroup' h.T_normalizes hz

omit [Finite G] in
theorem marking_card (s : Marking L V) : Nat.card V = 16 := by
  have hc := Nat.card_congr (markingEquiv s).toEquiv
  change Nat.card (BinaryPermutation.core (Fin 5)) = Nat.card V at hc
  rw [Module.natCard_eq_pow_finrank (K := ZMod 2), Nat.card_zmod,
    BinaryPermutation.finrank_core] at hc
  norm_num at hc
  exact hc.symm

end CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentReduction.InitialSieve.SymmetricSix
