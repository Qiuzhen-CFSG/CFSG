module

public import CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.CharacteristicTwo.ComponentReduction.InitialSieve.ModelExclusions.BinarySieve.ActionTransport
public import Theory.SpecificGroups.AlternatingSix.SylowFixedAction
public import Theory.SpecificGroups.AlternatingSix.ShadowLocal.SylowGeometry
public import Theory.SpecificGroups.SymplecticFour.Binary.ProjectiveDerived

/-!
# The whole symmetric-six quotient in the exceptional binary case

When K* is A₆, the faithful four-group fixing its Sylow subgroup generates
the natural S₆ together with K*. This places the natural S₆ inside the full
action image. Its index in Aut(A₆) is two. The only larger possibility is
the whole automorphism group, whose Sylow center is cyclic; the given central
four-group excludes that possibility. The resulting equivalence identifies
all of X*, not only the subgroup generated by K* and E*.

Source: Aschbacher–Smith, proof of 13.6.6, printed p.927; the model action
and Sylow geometry are the concrete calculations also used on pp.567–570
and pp.1162–1163.
-/

@[expose] public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentReduction.InitialSieve.ModelExclusions.BinarySieve
open A5Module
variable {G : Type*} [Group G] [Finite G] {L V : Subgroup G}
  {s : Marking L V} {T : Sylow 2 G}

/-- The complete normalizer/centralizer quotient is the actual S₆. -/
theorem symmetricSix_of_component_equiv (K : Subgroup (Gv (markedV s)))
    (hK : IsComponent (Gv (markedV s)) K)
    (a : ActionData s (T : Subgroup G) K)
    (e : NormalizerAction.componentImage K ≃* alternatingGroup (Fin 6)) :
    Nonempty (XStar K ≃* Equiv.Perm (Fin 6)) := by
  let f := modelAction K e
  have hf : Function.Injective f := modelAction_injective K hK e
  let E := EStar s K a.a_normalizes a.z_normalizes
  let := a.four
  let : IsElementaryAbelian 2 E := {
    toIsMulCommutative := IsKleinFour.isMulCommutative
    exponent_dvd_p := a.four.exponent_two ▸ dvd_rfl }
  obtain ⟨S, hS⟩ := exists_model_sylow_fixed K a e
  let ρ := f.comp E.subtype
  have hρ : Function.Injective ρ := hf.comp Subtype.val_injective
  have hfix : ∀ x y, y ∈ S → ρ x y = y := fun x y hy => hS x x.property y hy
  have hn : AlternatingSix.ShadowLocal.natural ≤ f.range := by
    rw [← AlternatingSix.ShadowLocal.inner_sup_range_eq_natural_of_fixes_sylow
      S ρ hρ a.four.card_four hfix]
    apply sup_le (inner_le_modelAction_range K e)
    rintro _ ⟨x, rfl⟩
    exact ⟨x, rfl⟩
  have hnt : f.range ≠ ⊤ := by
    intro ht
    have hsurj := MonoidHom.range_eq_top.mp ht
    obtain ⟨P, hP⟩ := a.sylow
    let Q := P.mapSurjective (f := f) hsurj
    let eP : P ≃* Q := (P : Subgroup (XStar K)).equivMapOfInjective f hf
    have hcQ : IsCyclic (center Q) := by
      rw [AlternatingSix.ShadowLocal.SylowGeometry.center_eq]
      infer_instance
    exact sylow_center_not_cyclic K a P hP ((centerCongr eP).isCyclic.mpr hcQ)
  have he : f.range = AlternatingSix.ShadowLocal.natural := by
    have hd := Subgroup.index_dvd_of_le hn
    rw [GLS3.Chapter5.naturalAlternatingAutomorphismSubgroup_index] at hd
    have hidx : f.range.index = 2 := by
      rcases (Nat.dvd_prime Nat.prime_two).mp hd with h | h
      · exact (hnt (Subgroup.index_eq_one.mp h)).elim
      · exact h
    apply le_antisymm _ hn
    by_contra h
    have hlt : AlternatingSix.ShadowLocal.natural < f.range := lt_of_le_of_ne hn
      (fun he => h he.symm.le)
    have hi := Subgroup.index_strictAnti hlt
    rw [hidx, GLS3.Chapter5.naturalAlternatingAutomorphismSubgroup_index] at hi
    omega
  exact ⟨(MonoidHom.ofInjective hf).trans ((MulEquiv.subgroupCongr he).trans
    (MonoidHom.ofInjective AlternatingSix.ShadowLocal.permutationAction_injective).symm)⟩

/-- The exponent-one derived symplectic constructor uses the commutator of
PSp₄(2), not an unspecified group of the same order. -/
theorem alternatives_of_symplectic_derived (K : Subgroup (Gv (markedV s)))
    (hK : IsComponent (Gv (markedV s)) K)
    (a : ActionData s (T : Subgroup G) K)
    (hi : Nonempty (NormalizerAction.componentImage K ≃*
      commutator (ClassicalGroup.PSp 2 (ZMod 2)))) : ModelSieveAlternatives K a := by
  obtain ⟨e⟩ := hi
  exact Or.inr (symmetricSix_of_component_equiv K hK a (e.trans
    Theory.SpecificGroups.SymplecticFour.Binary.projectiveDerivedEquivAlternatingSix))

end CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentReduction.InitialSieve.ModelExclusions.BinarySieve
