open scoped IsMulCommutative

private theorem component_sylow_noncentral {H : Type*} [Group H] [Finite H]
    (hodd : pPrimeCore 2 H = ⊥) (S : Sylow 2 H)
    (K : Subgroup H) (hK : IsComponent H K) :
    ¬ K ⊓ (S : Subgroup H) ≤ centralizer (K : Set H) := by
  intro hc
  let : IsQuasisimple K := hK.2
  obtain ⟨P, hP⟩ := S.exists_subgroupOf_eq_of_subnormal K hK.1
  have hcentral : (P : Subgroup K) ≤ center K := by
    intro x hx
    apply mem_center_iff.mpr
    intro y
    apply Subtype.ext
    have hxS : x ∈ (S : Subgroup H).subgroupOf K := hP ▸ hx
    exact mem_centralizer_iff.mp (hc ⟨x.property, hxS⟩) y y.property
  have hn : normalizer (P : Set K) ≤ centralizer (P : Set K) := by
    intro x _
    exact mem_centralizer_iff.mpr fun y hy => (mem_center_iff.mp (hcentral hy) x).symm
  let : IsMulCommutative P := ⟨⟨fun x y =>
    Subtype.ext (mem_center_iff.mp (hcentral y.property) x)⟩⟩
  let f := MonoidHom.transferSylow P hn
  have hf : Function.Surjective f := by
    have hb : Function.Bijective (f.domRestrict (P : Subgroup K)) :=
      (MonoidHom.transferSylow_domRestrict_eq_pow P hn).symm ▸
        (P.isPGroup'.powEquiv' P.not_dvd_index).bijective
    intro y
    obtain ⟨x, hx⟩ := hb.surjective y
    exact ⟨x, hx⟩
  let : Group.IsPerfect P := Group.IsPerfect.ofSurjective hf
  have hp : Nat.card P = 1 := Nat.card_unique
  have hi := (P : Subgroup K).card_mul_index
  rw [hp, one_mul] at hi
  have hcop : Nat.Coprime 2 (Nat.card K) :=
    Nat.prime_two.coprime_iff_not_dvd.mpr (hi ▸ P.not_dvd_index)
  have hkodd := hK.1.pPrimeCore_eq_bot hodd K
  have ht : (⊤ : Subgroup K) = ⊥ :=
    (pPrimeCore_eq_bot_iff.mp hkodd) ⊤ inferInstance (by simpa using hcop)
  let : IsSimpleGroup (K ⧸ center K) := IsQuasisimple.simple
  let : Nontrivial K := (QuotientGroup.mk'_surjective (center K)).nontrivial
  have : Subsingleton K := ⟨fun x y => by
    have hx : x = 1 := (show x ∈ (⊥ : Subgroup K) from ht ▸ (show x ∈ (⊤ : Subgroup K) from mem_top x))
    have hy : y = 1 := (show y ∈ (⊥ : Subgroup K) from ht ▸ (show y ∈ (⊤ : Subgroup K) from mem_top y))
    exact hx.trans hy.symm⟩
  exact not_subsingleton K inferInstance

open CFSG.Quasithin.Chapter13.Section06.CentralizerReduction
open CFSG.Quasithin Chapter1

private theorem centralizer_z_char {G : Type*} [Group G] [Finite G]
    (T : Sylow 2 G) (hE : IsEvenCharacteristicAt T)
    (z : G) (hz : orderOf z = 2) (hzT : z ∈ (T : Subgroup G))
    (hzC : ∀ t ∈ (T : Subgroup G), t * z = z * t) : Gv z ∈ He G := by
  have hne : zpowers z ≠ ⊥ := by
    intro he
    have hz1 : z = 1 := (show z ∈ (⊥ : Subgroup G) from he ▸ mem_zpowers z)
    simp [hz1] at hz
  have hUT : zpowers z ≤ (T : Subgroup G) := zpowers_le.mpr hzT
  have hn : (zpowers z).subgroupOf (T : Subgroup G) |>.Normal := by
    apply (normal_subgroupOf_iff_le_normalizer hUT).mpr
    rw [normalizer_zpowers_eq_centralizer_of_order_two z hz]
    exact fun t ht => mem_centralizer_singleton_iff.mpr (hzC t ht)
  have hh := (lemma_1_1_4_2 T hE hne hUT hn).2.2
  rwa [normalizer_zpowers_eq_centralizer_of_order_two z hz] at hh

private theorem centralizer_local_char {G : Type*} [Group G] [Finite G]
    (v : G) (hv : orderOf v = 2) (w : Gv v) (hw : Gv (w : G) ∈ He G) :
    centralizer (pCore 2 (centralizer ({w} : Set (Gv v))) :
      Set (centralizer ({w} : Set (Gv v)))) ≤
        pCore 2 (centralizer ({w} : Set (Gv v))) := by
  have hp : IsPGroup 2 (zpowers v) :=
    IsPGroup.of_card (p := 2) (n := 1) (by simp [Nat.card_zpowers, hv])
  have hvw : zpowers v ≤ Gv (w : G) := zpowers_le.mpr
    (mem_centralizer_singleton_iff.mpr (mem_centralizer_singleton_iff.mp w.property).symm)
  have he : centralizer (zpowers v : Set G) = Gv v := by
    change centralizer (zpowers v : Set G) = centralizer ({v} : Set G)
    apply le_antisymm
    · exact centralizer_le (Set.singleton_subset_iff.mpr (mem_zpowers v))
    · apply le_centralizer_iff.mp
      apply zpowers_le.mpr
      exact mem_centralizer_iff.mpr fun x hx => (mem_centralizer_singleton_iff.mp hx)
  have hh := pCoreIn_selfCentralizing_centralizer hw hp hvw
  rw [he, inf_comm] at hh
  let C := centralizer ({w} : Set (Gv v))
  have hmap : C.map (Gv v).subtype = Gv v ⊓ Gv (w : G) :=
    map_subtype_centralizer_singleton _ _
  have hm : C.map (Gv v).subtype ∈ He G := hmap ▸ hh
  let e : C ≃* C.map (Gv v).subtype := C.equivMapOfInjective _ (Gv v).subtype_injective
  exact (Theory.Quasithin.centralizer_pCore_le_iff 2 e).mpr (mem_He_iff.mp hm)

private theorem centralizer_conj_char {G : Type*} [Group G] [Finite G]
    (z c : G) (hz : Gv z ∈ He G) : Gv (MulAut.conj c z) ∈ He G := by
  have hh := (Theory.Quasithin.centralizer_pCore_map_le_iff 2 (MulAut.conj c) (Gv z)).mpr
    (mem_He_iff.mp hz)
  apply (map_centralizer_singleton (MulAut.conj c) z) ▸ (mem_He_iff.mpr hh)

private theorem residual_normalizes_of_index {G : Type*} [Group G] [Finite G]
    {L V : Subgroup G} (s : A5Module.Marking L V)
    (K : Subgroup (Gv (A5Module.markedV s)))
    (hindex : K.Normal ∨ (normalizer (K : Set (Gv (A5Module.markedV s)))).index = 2) :
    ComponentReduction.residual s ≤ ComponentReduction.X K := by
  rcases hindex with hn | hi
  · let := hn
    simp only [ComponentReduction.X, normalizer_eq_top]
    exact le_top
  · let N := normalizer (K : Set (Gv (A5Module.markedV s)))
    let : N.Normal := N.normal_of_index_eq_two hi
    have hp : IsPGroup 2 (Gv (A5Module.markedV s) ⧸ N) :=
      IsPGroup.of_card (n := 1) (by simpa only [pow_one, ← index_eq_card] using hi)
    have hle : pResidual 2 (Gv (A5Module.markedV s)) ≤ N := sInf_le ⟨inferInstance, hp⟩
    let f : ↥(L ⊓ Gv (A5Module.markedV s)) →* Gv (A5Module.markedV s) :=
      inclusion inf_le_right
    intro x hx
    obtain ⟨y, hy, he⟩ := hx
    have he' : f y = x := Subtype.ext he
    exact hle (he' ▸ map_pResidual_le 2 f (mem_map_of_mem f hy))

open A5Module BinaryPermutation.FiveCentralizerGeometry
variable {G : Type*} [Group G] [Finite G] {L V : Subgroup G}

omit [Finite G] in
theorem marked_orders (s : Marking L V) :
    orderOf (markedZ s) = 2 ∧ orderOf (markedV s) = 2 := by
  have h (x : Multiplicative Space) (hx : x ≠ 1) (hxx : x * x = 1) :
      orderOf (s.map x) = 2 := by
    apply (orderOf_eq_prime_iff (p := 2)).mpr
    constructor
    · simp only [pow_two, ← map_mul, hxx, map_one]
    · intro he
      exact hx (s.injective (he.trans s.map.map_one.symm))
  exact ⟨h _ (fun he => z_ne_zero (congrArg Multiplicative.toAdd he)) (by decide +kernel),
    h _ (fun he => v_ne_zero (congrArg Multiplicative.toAdd he)) (by decide +kernel)⟩

omit [Finite G] in
theorem checked_center_of_centralizes (T : Subgroup G) (v : G) (x : Gv v)
    (hxT : x ∈ localT T v) (hxC : x ∈ centralizer (localT T v : Set (Gv v))) :
    QuotientGroup.mk' (vLine v) x ∈
      (center ((localT T v).map (QuotientGroup.mk' (vLine v)))).map
        ((localT T v).map (QuotientGroup.mk' (vLine v))).subtype := by
  refine ⟨⟨_, mem_map_of_mem _ hxT⟩, mem_center_iff.mpr ?_, rfl⟩
  intro y
  obtain ⟨t, ht, he⟩ := y.property
  apply Subtype.ext
  change (y : Gv v ⧸ vLine v) * QuotientGroup.mk' (vLine v) x =
    QuotientGroup.mk' (vLine v) x * (y : Gv v ⧸ vLine v)
  rw [← he, ← map_mul, ← map_mul]
  exact congrArg (QuotientGroup.mk' (vLine v)) (mem_centralizer_iff.mp hxC t ht)

omit [Finite G] in
theorem localT_eq_sylow (T : Subgroup G) (v : G) (S : Sylow 2 (Gv v))
    (hS : (S : Subgroup (Gv v)).map (Gv v).subtype = Tv T v) :
    localT T v = (S : Subgroup (Gv v)) := by
  apply map_injective (Gv v).subtype_injective
  rw [hS]
  ext x
  constructor
  · rintro ⟨y, hy, rfl⟩
    exact ⟨hy, y.property⟩
  · rintro ⟨hxT, hxv⟩
    exact ⟨⟨x, hxv⟩, hxT, rfl⟩

theorem z_mem_central_supplement (s : Marking L V) (hVL : V ≤ L) :
    zLocal s ∈ vLine (markedV s) ⊔ residual s := by
  have hmem (x : Multiplicative Space) : s.map x ∈ L := by
    apply hVL
    exact s.range_eq.le ⟨x, rfl⟩
  let D := L ⊓ Gv (markedV s)
  let zz : D := ⟨markedZ s, hmem _, markedZ_mem_Gv s⟩
  let vv : D := ⟨markedV s, hmem _, mem_centralizer_singleton_iff.mpr rfl⟩
  let q := QuotientGroup.mk' (pResidual 2 D)
  obtain ⟨c, hc, he⟩ := exists_residual_triple s
  obtain ⟨cc, hcc, hce⟩ := hc
  have hprod : zz * (cc * zz * cc⁻¹) * (cc ^ 2 * zz * (cc ^ 2)⁻¹) = vv := by
    apply Subtype.ext
    change (cc : G) = c at hce
    simpa only [zz, vv, Subgroup.coe_mul, Subgroup.coe_pow, MulAut.conj_apply,
      Subgroup.coe_inv, hce] using he
  have hqcc : q cc = 1 := (QuotientGroup.eq_one_iff cc).mpr hcc
  have hzz : zz * zz = 1 := by
    apply Subtype.ext
    change markedZ s * markedZ s = 1
    simpa only [pow_two] using (orderOf_eq_prime_iff.mp (marked_orders s).1).1
  have hq : q zz = q vv := by
    have hh := congrArg q hprod
    simp only [map_mul, map_inv, map_pow, hqcc, one_mul,
      inv_one, mul_one, one_pow] at hh
    simpa only [← map_mul, hzz, one_mul] using hh
  have hd : zz / vv ∈ pResidual 2 D := QuotientGroup.eq_iff_div_mem.mp hq
  have hv : centralElement (markedV s) ∈ vLine (markedV s) ⊔ residual s :=
    (show vLine (markedV s) ≤ vLine (markedV s) ⊔ residual s from le_sup_left)
      (mem_zpowers _)
  have hr : zLocal s / centralElement (markedV s) ∈ residual s :=
    ⟨zz / vv, hd, rfl⟩
  exact (div_mul_cancel (zLocal s) (centralElement (markedV s))) ▸
    mul_mem ((show residual s ≤ vLine (markedV s) ⊔ residual s from le_sup_right) hr) hv

universe u

/-- Earlier source data at the marked centralizer, without a component-sieve conclusion. -/
structure Setup {G : Type u} [Group G] [Finite G] (κ : GroupClass.{u})
    {L V : Subgroup G} (T : Sylow 2 G) (s : Marking L V) where
  ambient : IsSimpleQTKE κ G
  V_le_L : V ≤ L
  V_le_T : V ≤ (T : Subgroup G)
  z_central : ∀ t ∈ (T : Subgroup G), t * markedZ s = markedZ s * t
  sylow : Sylow 2 (Gv (markedV s))
  sylow_image : (sylow : Subgroup (Gv (markedV s))).map (Gv (markedV s)).subtype =
    Tv (T : Subgroup G) (markedV s)
  a_centralizes : markedA s ∈ centralizer (Lv L (markedV s) : Set G)
  a_checked : QuotientGroup.mk' (vLine (markedV s)) (aLocal s) ∈
    (center ((localT (T : Subgroup G) (markedV s)).map
      (QuotientGroup.mk' (vLine (markedV s))))).map
      ((localT (T : Subgroup G) (markedV s)).map
        (QuotientGroup.mk' (vLine (markedV s)))).subtype

variable {G : Type u} [Group G] [Finite G] {L V : Subgroup G}
  {κ : GroupClass.{u}} {T : Sylow 2 G} {s : Marking L V}

theorem Setup.mark_mem_T (d : Setup κ T s) (x : Multiplicative Space) :
    s.map x ∈ (T : Subgroup G) := by
  apply d.V_le_T
  exact s.range_eq.le ⟨x, rfl⟩

theorem Setup.local115 (d : Setup κ T s) :
    Lemma115Hypotheses (Gv (markedV s)) d.sylow (Gv (markedZ s)) (markedZ s) :=
  local115_at_Gv T _ _ (marked_orders s).1 (marked_orders s).2
    (d.mark_mem_T _) (d.mark_mem_T _) d.z_central d.sylow d.sylow_image
    (centralizer_z_char T (d.ambient.evenCharacteristic T) _ (marked_orders s).1
      (d.mark_mem_T _) d.z_central)

/-- Both local element centralizers have characteristic two, by the actual
ambient centralizer and the marking's conjugator from z to a. -/
theorem Setup.centralizer_cores (d : Setup κ T s) :
    (centralizer (pCore 2 (centralizer ({aLocal s} : Set (Gv (markedV s)))) :
      Set (centralizer ({aLocal s} : Set (Gv (markedV s))))) ≤
        pCore 2 (centralizer ({aLocal s} : Set (Gv (markedV s))))) ∧
    (centralizer (pCore 2 (centralizer ({zLocal s} : Set (Gv (markedV s)))) :
      Set (centralizer ({zLocal s} : Set (Gv (markedV s))))) ≤
        pCore 2 (centralizer ({zLocal s} : Set (Gv (markedV s))))) := by
  have hzchar := centralizer_z_char T (d.ambient.evenCharacteristic T) _
    (marked_orders s).1 (d.mark_mem_T _) d.z_central
  obtain ⟨c, _, hca⟩ := exists_a_conjugator s
  have hachar : Gv (markedA s) ∈ He G := hca ▸ centralizer_conj_char _ c hzchar
  exact ⟨centralizer_local_char _ (marked_orders s).2 (aLocal s) hachar,
    centralizer_local_char _ (marked_orders s).2 (zLocal s) hzchar⟩

/-- The noncentral element required by the checked-center normalization
test comes from the actual component and the prescribed Sylow subgroup. -/
theorem Setup.exists_noncentral_sylow_element (d : Setup κ T s)
    (hodd : pPrimeCore 2 (Gv (markedV s)) = ⊥)
    (K : Subgroup (Gv (markedV s))) (hK : IsComponent (Gv (markedV s)) K) :
    ∃ b ∈ K ⊓ localT (T : Subgroup G) (markedV s),
      b ∉ centralizer (K : Set (Gv (markedV s))) := by
  apply SetLike.not_le_iff_exists.mp
  rw [localT_eq_sylow _ _ d.sylow d.sylow_image]
  exact component_sylow_noncentral hodd d.sylow K hK

/-- The complete universal conjugacy alternative of A.3.8(3), as consumed
by the adequate 1.2.1(3) quotient-lifting theorem. -/
def EarlierConjugates (κ : GroupClass.{u}) : Prop :=
  ∀ (H : Type u) [Group H] [Finite H], IsSQTK κ H → pCore 2 H = ⊥ →
    ∀ B : Subgroup H, B.IsCComponent →
      B.Normal ∨ (normalizer (B : Set H)).index = 2 ∧
        Chapter1.Section02.NonnormalCComponentModel B

/-- Output data for the actual normalizer/centralizer quotient. -/
structure ActionData (s : Marking L V) (T : Subgroup G)
    (K : Subgroup (Gv (markedV s))) : Prop where
  a_normalizes : aLocal s ∈ X K
  z_normalizes : zLocal s ∈ X K
  residual_normalizes : residual s ≤ X K
  commutator_a : ⁅K, zpowers (aLocal s)⁆ = K
  commutator_z : ⁅K, zpowers (zLocal s)⁆ = K
  commutator_residual : ⁅K, residual s⁆ = K
  four : IsKleinFour (EStar s K a_normalizes z_normalizes)
  central : EStar s K a_normalizes z_normalizes ≤
    (center (NormalizerAction.sylowImage K (localT T (markedV s)))).map
      (NormalizerAction.sylowImage K (localT T (markedV s))).subtype
  sylow : ∃ P : Sylow 2 (XStar K),
    (P : Subgroup (XStar K)) = NormalizerAction.sylowImage K (localT T (markedV s))

/-- Discharge normalization and both characteristic-two premises, then
construct the literal central four-group and all three commutator identities. -/
theorem source_action_data (d : Setup κ T s) (earlier : EarlierConjugates κ)
    (hodd : pPrimeCore 2 (Gv (markedV s)) = ⊥)
    (K : Subgroup (Gv (markedV s))) (hK : IsComponent (Gv (markedV s)) K) :
    ActionData s (T : Subgroup G) K := by
  obtain ⟨hacore, hzcore⟩ := d.centralizer_cores
  have hnoncentral : ¬ K ⊓ localT (T : Subgroup G) (markedV s) ≤
      centralizer (K : Set (Gv (markedV s))) :=
    SetLike.not_le_iff_exists.mpr (d.exists_noncentral_sylow_element hodd K hK)
  have haN := normalizes_of_checked_center _ _ K hK (aLocal s) d.a_checked hnoncentral
  have hzC : zLocal s ∈ centralizer
      (localT (T : Subgroup G) (markedV s) : Set (Gv (markedV s))) := by
    intro t ht
    exact Subtype.ext (d.z_central t ht)
  have hzN := normalizes_of_checked_center _ _ K hK (zLocal s)
    (checked_center_of_centralizes _ _ _ (d.mark_mem_T _) hzC) hnoncentral
  have hindex := Chapter1.Section02.proposition_1_2_1_three_index_of_A_3_8 earlier
    (Chapter1.Section02.uniqueness_local_quotient_sqtk d.ambient d.local115.mem_H)
    hK.isCComponent
  have hDN := residual_normalizes_of_index s K (hindex.imp_right And.left)
  have hKz := component_commutator_z s K hK hzN hzcore
  have hKa := hK.commutator_eq_self_of_twoCore_centralizer _ haN hacore
  have hKD := component_commutator_residual s K hDN
    (z_mem_central_supplement s d.V_le_L) hKz
  have haD : aLocal s ∈ centralizer (residual s : Set (Gv (markedV s))) := by
    intro x hx
    exact Subtype.ext (mem_centralizer_iff.mp d.a_centralizes x hx)
  obtain ⟨hf, hc⟩ := marked_central_four s (T : Subgroup G) K hK haN hzN hDN
    (d.mark_mem_T _) (d.mark_mem_T _) haD hzC d.a_checked hacore hzcore
  refine ⟨haN, hzN, hDN, hKa, hKz, hKD, hf, hc, ?_⟩
  have hn : (X K).Normal := by
    rcases hindex with hn | ⟨hi, _⟩
    · let := hn
      change (normalizer (K : Set (Gv (markedV s)))).Normal
      rw [normalizer_eq_top]
      infer_instance
    · exact (X K).normal_of_index_eq_two hi
  let := hn
  obtain ⟨P, hP⟩ := d.sylow.exists_subgroupOf_eq_of_normal (X K)
  refine ⟨P.mapSurjective (QuotientGroup.mk'_surjective (NormalizerAction.C K)), ?_⟩
  change (P : Subgroup (X K)).map (NormalizerAction.quotient K) = _
  rw [hP, ← localT_eq_sylow _ _ d.sylow d.sylow_image]
  rfl

end CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentReduction.InitialSieve
