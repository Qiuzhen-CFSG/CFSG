module

public import CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.LocalSetup.ModuleMarking
public import Theory.GroupTheory.NormalizerAction
public import Theory.GroupTheory.GeneralizedFitting.ComponentInvolutionAction

/-!
# The actual component action and the central four-group

For a component K of Gᵥ, X is its normalizer in Gᵥ and X* is literally
X/C_X(K). Once the earlier component theory supplies normalization by
a, z and Lᵥ, the marked three-conjugate product constructs the four-group
generated by a* and z*. Characteristic two of their centralizers proves
both images nontrivial. The product proves them distinct. Centrality of
the checked a-image passes through the central line ⟨v⟩ to this action.

The normalization and characteristic-two centralizer premises below remain
to be discharged in the component classification reduction. This module
does not claim the Lie-model sieve or the final source theorem.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004,
proof of 13.6.6, printed pp.926–927.
-/

@[expose] public section
namespace CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentReduction
open Subgroup Theory.GroupTheory A5Module
open BinaryPermutation.FiveCentralizerGeometry
variable {G : Type*} [Group G] {L V : Subgroup G}

/-- The residual, now as a subgroup of the actual centralizer. -/
def residual (s : Marking L V) : Subgroup (Gv (markedV s)) :=
  (Lv L (markedV s)).subgroupOf (Gv (markedV s))

/-- C_T(v), as a subgroup of Gᵥ. -/
def localT (T : Subgroup G) (v : G) : Subgroup (Gv v) := T.subgroupOf (Gv v)

def zLocal (s : Marking L V) : Gv (markedV s) :=
  ⟨markedZ s, markedZ_mem_Gv s⟩

def aLocal (s : Marking L V) : Gv (markedV s) :=
  ⟨markedA s, mem_centralizer_singleton_iff.mpr (by
    simpa only [markedA, markedV, map_mul] using congrArg s.map
      (mul_comm (Multiplicative.ofAdd a) (Multiplicative.ofAdd v)))⟩

/-- The relative normalizer in Gᵥ. -/
abbrev X {v : G} (K : Subgroup (Gv v)) := normalizer (K : Set (Gv v))

/-- T_X = Tᵥ ∩ X, viewed inside X. -/
def TX (T : Subgroup G) {v : G} (K : Subgroup (Gv v)) : Subgroup (X K) :=
  (localT T v).subgroupOf (X K)

/-- X* = X/C_X(K), with the precise action kernel. -/
abbrev XStar {v : G} (K : Subgroup (Gv v)) := NormalizerAction.Star K

/-- The source's literal four-group candidate; its order is proved below. -/
def EStar (s : Marking L V) (K : Subgroup (Gv (markedV s)))
    (ha : aLocal s ∈ X K) (hz : zLocal s ∈ X K) : Subgroup (XStar K) :=
  NormalizerAction.four K ⟨aLocal s, ha⟩ ⟨zLocal s, hz⟩

/-- Its faithful action on the genuine component. -/
theorem XStar_action_injective {v : G} (K : Subgroup (Gv v)) :
    Function.Injective (NormalizerAction.action K) :=
  NormalizerAction.action_injective K

/-- The meaning of centrality in the literal checked Sylow image. -/
theorem checked_commute (T : Subgroup G) (v : G) (x : Gv v)
    (hx : QuotientGroup.mk' (vLine v) x ∈
      (center ((localT T v).map (QuotientGroup.mk' (vLine v)))).map
        ((localT T v).map (QuotientGroup.mk' (vLine v))).subtype)
    (t : Gv v) (ht : t ∈ localT T v) :
    Commute (QuotientGroup.mk' (vLine v) x) (QuotientGroup.mk' (vLine v) t) := by
  obtain ⟨x', hx', he⟩ := hx
  have ht' := mem_map_of_mem (QuotientGroup.mk' (vLine v)) ht
  have hh := congrArg Subtype.val (mem_center_iff.mp hx'
    ⟨QuotientGroup.mk' (vLine v) t, ht'⟩)
  change QuotientGroup.mk' (vLine v) t * x'.val =
    x'.val * QuotientGroup.mk' (vLine v) t at hh
  change x'.val = QuotientGroup.mk' (vLine v) x at he
  rw [he] at hh
  exact hh.symm

/-- The normalization argument for a checked-central element. The
remaining structural premise is a noncentral element of K ∩ Tᵥ; no
normalization conclusion is placed in that premise. -/
theorem normalizes_of_checked_center (T : Subgroup G) (v : G)
    (K : Subgroup (Gv v)) (hK : IsComponent (Gv v) K) (x : Gv v)
    (hx : QuotientGroup.mk' (vLine v) x ∈
      (center ((localT T v).map (QuotientGroup.mk' (vLine v)))).map
        ((localT T v).map (QuotientGroup.mk' (vLine v))).subtype)
    (hne : ¬ K ⊓ localT T v ≤ centralizer (K : Set (Gv v))) : x ∈ X K := by
  classical
  obtain ⟨b, hb, hbn⟩ := SetLike.not_le_iff_exists.mp hne
  exact hK.normalizes_of_noncentral_element (vLine v) (vLine_le_center v)
    x b hb.1 hbn (checked_commute T v x hx b hb.2)

private theorem zLocal_square (s : Marking L V) : zLocal s * zLocal s = 1 := by
  apply Subtype.ext
  change s.map (Multiplicative.ofAdd z) * s.map (Multiplicative.ofAdd z) = 1
  rw [← map_mul, show Multiplicative.ofAdd z * Multiplicative.ofAdd z = 1 by decide +kernel,
    map_one]

private theorem aLocal_square (s : Marking L V) : aLocal s * aLocal s = 1 := by
  apply Subtype.ext
  change s.map (Multiplicative.ofAdd a) * s.map (Multiplicative.ofAdd a) = 1
  rw [← map_mul, show Multiplicative.ofAdd a * Multiplicative.ofAdd a = 1 by decide +kernel,
    map_one]

/-- The marked source construction yields E₄ ≤ Z(T_X*), with the quotient
and every embedding specified. The two nontrivial actions and the distinction
between a* and z* are conclusions, not input fields. -/
theorem marked_central_four [Finite G] (s : Marking L V) (T : Subgroup G)
    (K : Subgroup (Gv (markedV s))) (hK : IsComponent (Gv (markedV s)) K)
    (haN : aLocal s ∈ X K) (hzN : zLocal s ∈ X K)
    (hDN : residual s ≤ X K)
    (haT : markedA s ∈ T) (hzT : markedZ s ∈ T)
    (haD : aLocal s ∈ centralizer (residual s : Set (Gv (markedV s))))
    (hzC : zLocal s ∈ centralizer (localT T (markedV s) : Set (Gv (markedV s))))
    (haCheck : QuotientGroup.mk' (vLine (markedV s)) (aLocal s) ∈
      (center ((localT T (markedV s)).map (QuotientGroup.mk' (vLine (markedV s))))).map
        ((localT T (markedV s)).map (QuotientGroup.mk' (vLine (markedV s)))).subtype)
    (haCore : centralizer (pCore 2 (centralizer ({aLocal s} : Set (Gv (markedV s)))) :
      Set (centralizer ({aLocal s} : Set (Gv (markedV s))))) ≤
        pCore 2 (centralizer ({aLocal s} : Set (Gv (markedV s)))))
    (hzCore : centralizer (pCore 2 (centralizer ({zLocal s} : Set (Gv (markedV s)))) :
      Set (centralizer ({zLocal s} : Set (Gv (markedV s))))) ≤
        pCore 2 (centralizer ({zLocal s} : Set (Gv (markedV s))))) :
    IsKleinFour (EStar s K haN hzN) ∧
      EStar s K haN hzN ≤
        (center (NormalizerAction.sylowImage K (localT T (markedV s)))).map
          (NormalizerAction.sylowImage K (localT T (markedV s))).subtype := by
  obtain ⟨c, hc, hprod⟩ := exists_residual_triple s
  let cH : Gv (markedV s) := ⟨c, Lv_le_Gv L (markedV s) hc⟩
  have hcD : cH ∈ residual s := hc
  let cX : X K := ⟨cH, hDN hcD⟩
  let aX : X K := ⟨aLocal s, haN⟩
  let zX : X K := ⟨zLocal s, hzN⟩
  have hline : vLine (markedV s) ≤ centralizer (K : Set (Gv (markedV s))) :=
    (vLine_le_center _).trans (center_le_centralizer _)
  apply NormalizerAction.central_four K (localT T (markedV s)) aX zX cX haT hzT
    (Subtype.ext (aLocal_square s)) (Subtype.ext (zLocal_square s))
    (hK.not_centralizes_of_twoCore_centralizer _ haCore)
    (hK.not_centralizes_of_twoCore_centralizer _ hzCore)
  · apply Commute.map
    apply Commute.symm
    exact Subtype.ext (mem_centralizer_iff.mp haD cH hcD)
  · apply (NormalizerAction.quotient_eq_one_iff K _).mpr
    have he : ((zX * MulAut.conj cX zX * MulAut.conj (cX ^ 2) zX : X K) :
        Gv (markedV s)) = centralElement (markedV s) := Subtype.ext hprod
    rw [he]
    exact hline (mem_zpowers _)
  · intro t ht
    apply NormalizerAction.quotient_commute_of_quotient_commute K (vLine (markedV s)) hline
    exact checked_commute T (markedV s) (aLocal s) haCheck t ht
  · intro t ht
    exact (show Commute zX t from Subtype.ext (mem_centralizer_iff.mp hzC t ht).symm).map _

/-- The same actual centralizer input gives the full commutator with z. -/
theorem component_commutator_z [Finite G] (s : Marking L V)
    (K : Subgroup (Gv (markedV s))) (hK : IsComponent (Gv (markedV s)) K)
    (hzN : zLocal s ∈ X K)
    (hzCore : centralizer (pCore 2 (centralizer ({zLocal s} : Set (Gv (markedV s)))) :
      Set (centralizer ({zLocal s} : Set (Gv (markedV s))))) ≤
        pCore 2 (centralizer ({zLocal s} : Set (Gv (markedV s))))) :
    ⁅K, zpowers (zLocal s)⁆ = K :=
  hK.commutator_eq_self_of_twoCore_centralizer _ hzN hzCore

/-- Remove ⟨v⟩ from the source containment z ∈ ⟨v⟩Lᵥ to obtain [K,Lᵥ]=K. -/
theorem component_commutator_residual (s : Marking L V)
    (K : Subgroup (Gv (markedV s))) (hDN : residual s ≤ X K)
    (hzD : zLocal s ∈ vLine (markedV s) ⊔ residual s)
    (hKz : ⁅K, zpowers (zLocal s)⁆ = K) : ⁅K, residual s⁆ = K :=
  commutator_eq_self_of_central_supplement (residual s) (vLine (markedV s)) (zLocal s)
    hDN ((vLine_le_center _).trans (center_le_centralizer _)) hzD hKz

/-- The source use of A.3.18 to exclude outer actions: once it puts the
residual action inside K*, so is z's action, since z ∈ ⟨v⟩Lᵥ. -/
theorem z_inner_of_residual_inner (s : Marking L V)
    (K : Subgroup (Gv (markedV s))) (hzN : zLocal s ∈ X K)
    (hDN : residual s ≤ X K) (hzD : zLocal s ∈ vLine (markedV s) ⊔ residual s)
    (hinner : ((residual s).subgroupOf (X K)).map (NormalizerAction.quotient K) ≤
      NormalizerAction.componentImage K) :
    K.normalizerMonoidHom ⟨zLocal s, hzN⟩ ∈ MulAut.innerSubgroup K := by
  rw [← NormalizerAction.action_quotient K ⟨zLocal s, hzN⟩]
  apply (NormalizerAction.action_mem_inner_iff K _).mpr
  exact NormalizerAction.quotient_mem_componentImage_of_central_supplement K
    (vLine (markedV s)) (residual s)
    ((vLine_le_center _).trans (center_le_centralizer _)) hDN hinner ⟨zLocal s, hzN⟩ hzD

/-- The actual inner-image deduction in the normalized component branch.
The commutator identity is transported to the relative normalizer before
passing to the abelian outer quotient. -/
theorem residual_image_le_of_abelian_outer (s : Marking L V) (T : Subgroup G)
    (K : Subgroup (Gv (markedV s))) [IsMulCommutative (MulAut.Outer K)]
    (hDN : residual s ≤ X K) (hTN : localT T (markedV s) ≤ X K)
    (hcomm : ⁅residual s, localT T (markedV s)⁆ = residual s) :
    ((residual s).subgroupOf (X K)).map (NormalizerAction.quotient K) ≤
      NormalizerAction.componentImage K := by
  apply NormalizerAction.commutator_generated_image_le K _ ((localT T (markedV s)).subgroupOf (X K))
  apply map_injective (X K).subtype_injective
  rw [map_commutator, map_subgroupOf_eq_of_le hDN, map_subgroupOf_eq_of_le hTN, hcomm]

end CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentReduction
