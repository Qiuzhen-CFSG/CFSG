module

public import CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.CharacteristicTwo.ComponentReduction.NormalizedBorel.ActionFacts
public import Theory.GroupTheory.SylowNormalGenerationFrattini
public import Theory.GroupTheory.Commutator.SylowNormalGeneration
public import Theory.GroupTheory.PResidual.PerfectCover
public import Theory.GroupTheory.PResidual.SylowSupplement
public import Theory.GroupTheory.CharacteristicCentralizerFusion

/-!
# Residual commutators in the marked A₅ centralizer

The stabilizer of v in the actual five-point module is generated by two
involutions. The restriction of the marked A₅ action onto this stabilizer
is surjective and has two-group kernel. A Sylow two-subgroup therefore
normally generates C_L(v), giving O²(C_L(v)) = [O²(C_L(v)), C_T(v)].
The given Sylow C_T(v) supplies its intersection Sylow by local normality;
no ambient normality of L is assumed.

Perfect central descent also bridges the book's Out(K*) to Out(K) in the
normalizer-action helper. Model-specific abelianness remains explicit;
this module does not prove the model classification or Borel placement.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004,
proof of 13.6.6, printed p.927, with the marked module on p.926.
-/

@[expose] public section
namespace CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentReduction.NormalizedBorel
open Subgroup Theory.GroupTheory A5Module
open BinaryPermutation.FiveCentralizerGeometry
private abbrev A := alternatingGroup (Fin 5)
private def stab : Subgroup A where
  carrier := {g | act g v = v}
  one_mem' := by simp [act]
  mul_mem' := by
    intro g h hg hh
    change act g (act h v) = v
    rw [hh, hg]
  inv_mem' := by
    intro g hg
    change act g⁻¹ v = v
    conv_lhs => rw [← hg]
    change act (g⁻¹ * g) v = v
    simp [act]
private instance : DecidablePred (· ∈ stab) := fun g => inferInstanceAs (Decidable (act g v = v))
private def u : A := ⟨Equiv.swap 0 1 * Equiv.swap 2 3, by rw [Equiv.Perm.mem_alternatingGroup]; decide +kernel⟩
private theorem coverage : ∀ g : A, act g v = v →
    g = 1 ∨ g = cubic ∨ g = cubic ^ 2 ∨ g = u ∨ g = u * cubic ∨ g = u * cubic ^ 2 := by
  decide +kernel

private def us : stab := ⟨u, by apply Subtype.ext; ext i; fin_cases i <;> decide⟩
private def cs : stab := ⟨cubic, cubic_fixes_v⟩
private theorem us_sq : us ^ 2 = 1 := by apply Subtype.ext; decide +kernel
private theorem ucs_sq : (us * cs) ^ 2 = 1 := by apply Subtype.ext; decide +kernel
private theorem stab_generated : closure {g : stab | g ^ 2 = 1} = ⊤ := by
  let C := closure {g : stab | g ^ 2 = 1}
  have hu : us ∈ C := subset_closure us_sq
  have huc : us * cs ∈ C := subset_closure ucs_sq
  have hc : cs ∈ C := by
    have he : us * (us * cs) = cs := by
      rw [← mul_assoc, ← pow_two, us_sq, one_mul]
    exact he ▸ C.mul_mem hu huc
  apply top_unique
  intro g _
  change g ∈ C
  rcases coverage g.val g.property with he | he | he | he | he | he
  · exact (show (1 : stab) = g from (Subtype.ext he).symm) ▸ C.one_mem
  · exact (show cs = g from (Subtype.ext he).symm) ▸ hc
  · exact (show cs ^ 2 = g from (Subtype.ext he).symm) ▸ C.pow_mem hc 2
  · exact (show us = g from (Subtype.ext he).symm) ▸ hu
  · exact (show us * cs = g from (Subtype.ext he).symm) ▸ huc
  · exact (show us * cs ^ 2 = g from (Subtype.ext he).symm) ▸ C.mul_mem hu (C.pow_mem hc 2)

variable {H D : Type*} [Group H] [Finite H] [Group D] [Finite D]
private theorem residual_comm (S : Sylow 2 H) (f : H →* D) (hf : Function.Surjective f)
    (hk : IsPGroup 2 f.ker) (hg : closure {x : D | x ^ 2 = 1} = ⊤) :
    ⁅pResidual 2 H, (S : Subgroup H)⁆ = pResidual 2 H := by
  let N := normalClosure (S : Set H)
  let : (N.map f).Normal := Subgroup.Normal.map inferInstance f hf
  have hn : N.map f = ⊤ := by
    apply top_unique
    rw [← normalClosure_sylow_eq_top_of_involutions (S.mapSurjective hf) hg]
    apply normalClosure_le_normal
    exact map_mono le_normalClosure
  have htop : N = ⊤ := by
    have h := congrArg (Subgroup.comap f) hn
    rw [comap_map_eq, comap_top] at h
    exact (sup_eq_left.mpr (show f.ker ≤ N from hk.le_normalClosure_sylow S)).symm.trans h
  exact (eq_commutator_of_sylow_normal_generation S (pResidual 2 H) (S : Subgroup H) ⊥
    (pResidual_sup_sylow_eq_top S) (isPPerfect_pResidual 2)
    (S : Subgroup H).le_normalizer bot_le (by simp) htop).symm

variable {G : Type*} [Group G] {L V : Subgroup G}
private def localAction (s : Marking L V) : (L ⊓ Gv (markedV s) : Subgroup G) →* stab where
  toFun c := ⟨s.action (inclusion inf_le_left c), by
    have he := s.equivariant (inclusion inf_le_left c) v
    have hc : MulAut.conj c.val (markedV s) = markedV s := by
      change c.val * markedV s * c.val⁻¹ = markedV s
      rw [mem_centralizer_singleton_iff.mp c.property.2, mul_inv_cancel_right]
    exact congrArg Multiplicative.toAdd (s.injective (he.symm.trans hc))⟩
  map_one' := Subtype.ext (s.action.map_one)
  map_mul' c d := by
    apply Subtype.ext
    change s.action ((inclusion inf_le_left) (c * d)) = _
    rw [map_mul, map_mul]
    rfl
private theorem localAction_surjective (s : Marking L V) : Function.Surjective (localAction s) := by
  intro g
  obtain ⟨c, hc⟩ := s.onto g.val
  have hcv : c.val ∈ Gv (markedV s) := by
    apply mem_centralizer_singleton_iff.mpr
    apply mul_inv_eq_iff_eq_mul.mp
    have he := s.equivariant c v
    rw [hc, g.property] at he
    exact he
  refine ⟨⟨c.val, c.property, hcv⟩, ?_⟩
  apply Subtype.ext
  exact hc
private theorem localAction_kernel (s : Marking L V) (hk : IsPGroup 2 s.action.ker) :
    IsPGroup 2 (localAction s).ker := by
  let i : (localAction s).ker →* s.action.ker := {
    toFun x := ⟨⟨x.val.val, x.val.property.1⟩, by
      change s.action ((inclusion inf_le_left) x.val) = 1
      exact congrArg (fun a : stab => a.val) x.property⟩
    map_one' := rfl
    map_mul' _ _ := rfl }
  exact hk.of_injective i (by intro x y h; exact Subtype.ext (Subtype.ext
    (congrArg (fun a : s.action.ker => a.val.val) h)))

/-- In the ambient group, the marked residual is generated by its
commutators with C_T(v). The kernel assumption is the actual two-group
kernel of the given A₅ action. -/
theorem ambient_residual_commutator [Finite G] (s : Marking L V) (T : Subgroup G)
    (hk : IsPGroup 2 s.action.ker) (hTL : T ≤ normalizer (L : Set G))
    (S : Sylow 2 (L ⊓ Gv (markedV s) : Subgroup G))
    (hST : (S : Subgroup (L ⊓ Gv (markedV s) : Subgroup G)).map
      (L ⊓ Gv (markedV s)).subtype ≤ T) :
    ⁅Lv L (markedV s), Tv T (markedV s)⁆ = Lv L (markedV s) := by
  have hnorm : Tv T (markedV s) ≤ normalizer (Lv L (markedV s) : Set G) := by
    apply le_trans _ (normalizer_le_normalizer_characteristic_image
      (L ⊓ Gv (markedV s)) (pResidual 2 (L ⊓ Gv (markedV s) : Subgroup G)))
    exact (le_inf (inf_le_left.trans hTL) (inf_le_right.trans (Gv (markedV s)).le_normalizer)).trans
      inf_normalizer_le_normalizer_inf
  apply le_antisymm (le_normalizer_iff_commutator_le_left.mp hnorm)
  have he := congrArg (fun A => A.map (L ⊓ Gv (markedV s)).subtype)
    (residual_comm S (localAction s) (localAction_surjective s) (localAction_kernel s hk)
      stab_generated)
  rw [map_commutator] at he
  apply he.symm.le.trans
  apply commutator_mono le_rfl
  exact le_inf hST ((map_subtype_le _).trans inf_le_right)

private theorem sylow_normalized_intersection {H : Type*} [Group H] [Finite H]
    (S : Sylow 2 H) (J : Subgroup H) (hSJ : (S : Subgroup H) ≤ normalizer (J : Set H)) :
    ∃ P : Sylow 2 J, (P : Subgroup J) = (S : Subgroup H).subgroupOf J := by
  let W := J ⊔ (S : Subgroup H)
  have hJW : J ≤ W := le_sup_left
  let _ : (J.subgroupOf W).Normal :=
    (normal_subgroupOf_iff_le_normalizer hJW).mpr (sup_le J.le_normalizer hSJ)
  obtain ⟨P, hP⟩ := (S.subtype (show (S : Subgroup H) ≤ W from le_sup_right)).exists_subgroupOf_eq_of_normal (J.subgroupOf W)
  let e := subgroupOfEquivOfLe hJW
  refine ⟨P.mapSurjective (f := e.toMonoidHom) e.surjective, ?_⟩
  change (P : Subgroup _).map e.toMonoidHom = _
  rw [hP]
  ext x
  constructor
  · rintro ⟨y, hy, rfl⟩
    exact hy
  · intro hx
    exact ⟨⟨⟨x, hJW x.property⟩, x.property⟩, hx, rfl⟩

/-- The source identity inside C_G(v), derived from the actual module
marking, its two-group kernel, T-normalization of L, and the given Sylow
C_T(v). No commutator or inversion identity is an input. -/
theorem residual_commutator [Finite G] (s : Marking L V) (T : Subgroup G)
    (hk : IsPGroup 2 s.action.ker) (hTL : T ≤ normalizer (L : Set G))
    (S : Sylow 2 (Gv (markedV s))) (hS : (S : Subgroup (Gv (markedV s))) = localT T (markedV s)) :
    ⁅residual s, localT T (markedV s)⁆ = residual s := by
  let H := Gv (markedV s)
  let J := L.subgroupOf H
  have hSJ : (S : Subgroup H) ≤ normalizer (J : Set H) := by
    apply le_normalizer_iff.mpr
    intro t ht j hj
    rw [hS] at ht
    exact le_normalizer_iff.mp hTL t.val ht j.val hj
  obtain ⟨P, hP⟩ := sylow_normalized_intersection S J hSJ
  let e : J ≃* (L ⊓ H : Subgroup G) :=
    (J.equivMapOfInjective H.subtype H.subtype_injective).trans
      (MulEquiv.subgroupCongr (subgroupOf_map_subtype L H))
  let R := P.mapSurjective (f := e.toMonoidHom) e.surjective
  have hRT : (R : Subgroup (L ⊓ H : Subgroup G)).map (L ⊓ H).subtype ≤ T := by
    rintro x ⟨y, ⟨j, hj, rfl⟩, rfl⟩
    change j.val.val ∈ T
    rw [hP] at hj
    have hjS : j.val ∈ (S : Subgroup H) := hj
    rw [hS] at hjS
    exact hjS
  have hc := ambient_residual_commutator s T hk hTL R hRT
  apply map_injective H.subtype_injective
  rw [map_commutator]
  change ⁅((Lv L (markedV s)).subgroupOf H).map H.subtype,
    (T.subgroupOf H).map H.subtype⁆ = ((Lv L (markedV s)).subgroupOf H).map H.subtype
  rw [map_subgroupOf_eq_of_le (Lv_le_Gv L (markedV s)), subgroupOf_map_subtype]
  exact hc


/-- The book uses Out(K*), whereas the faithful K-action uses Out(K).
Perfect central descent makes that exact outer premise sufficient, and
`residual_commutator` discharges the commutator premise from the marking. -/
theorem residualStar_le_of_abelian_outer_component [Finite G]
    (s : Marking L V) (T : Subgroup G) (K : Subgroup (Gv (markedV s)))
    (hK : IsComponent (Gv (markedV s)) K)
    [IsMulCommutative (MulAut.Outer (NormalizerAction.componentImage K))]
    (hk : IsPGroup 2 s.action.ker) (hTL : T ≤ normalizer (L : Set G))
    (S : Sylow 2 (Gv (markedV s)))
    (hS : (S : Subgroup (Gv (markedV s))) = localT T (markedV s))
    (hDN : residual s ≤ X K) (hTN : localT T (markedV s) ≤ X K) :
    residualStar s K ≤ NormalizerAction.componentImage K := by
  let : IsQuasisimple K := hK.2
  let : IsMulCommutative (MulAut.Outer K) :=
    MulAut.outer_isMulCommutative_of_centralQuotient
      (NormalizerAction.componentCentralQuotientEquiv K)
  exact residual_image_le_of_abelian_outer s T K hDN hTN
    (residual_commutator s T hk hTL S hS)

end CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentReduction.NormalizedBorel
