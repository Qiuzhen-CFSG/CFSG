/-!
# The original normalized-component contradiction in 13.6.6

The marked residual commutator and actual model automorphisms put its faithful
image in the component image; the signed-three exceptions are excluded directly.
The complete root-centralizer catalogue leaves a genuine Sp4 model with aligned
Sylow and Borel. Its proved universal-cover kernel is trivial. Full cubic rank
makes the component centralizer prime to three, while the original residual is
generated by its three-elements. This recovers containment of the residual itself
in K, preserving its kernel, and feeds the completed symplectic Borel contradiction.

The final theorem consumes the original flag, earlier local source results and
module-core data. Its only component-specific premise is normalization by the
actual local Sylow; the separate moving-component proof supplies that premise.
No A3.18 model alternative, field-actor restriction, cover or Borel input remains.
The full 13.6.7 containment still requires the subsequent FF selection argument.

Source: Aschbacher--Smith, proof of 13.6.6, printed pp.927--928.
-/

public section
open Subgroup Theory.GroupTheory
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentReduction.NormalizedBorel
open A5Module InitialSieve
universe u
variable {G : Type u} [Group G] [Finite G] {L V : Subgroup G}
  {T : Sylow 2 G} {s : Marking L V}

theorem source_residual_inner
    (d : Setup KnownSimple.IsKnownSimple T s)
    (K : Subgroup (Gv (markedV s))) (hK : IsComponent (Gv (markedV s)) K)
    (a : ActionData s (T : Subgroup G) K) {m : ℕ} (hm : 1 < m)
    (hmodel : BinaryModelAt (NormalizerAction.componentImage K) m)
    (hEK : EStar s K a.a_normalizes a.z_normalizes ≤ NormalizerAction.componentImage K)
    (hk : IsPGroup 2 s.action.ker) (hTL : (T : Subgroup G) ≤ normalizer (L : Set G))
    (hTN : localT (T : Subgroup G) (markedV s) ≤ X K) :
    residualStar s K ≤ NormalizerAction.componentImage K := by
  let : IsQuasisimple K := hK.2
  let : IsSimpleGroup (NormalizerAction.componentImage K) :=
    (NormalizerAction.componentCentralQuotientEquiv K).isSimpleGroup_congr.mp IsQuasisimple.simple
  let : Group.IsPerfect (NormalizerAction.componentImage K) :=
    Group.IsPerfect.ofSurjective
      (f := (NormalizerAction.componentCentralQuotientEquiv K).toMonoidHom)
      (NormalizerAction.componentCentralQuotientEquiv K).surjective
  rcases outer_abelian_or_signedThree hm hmodel with houter | hlin | hunit
  · let := houter
    exact residualStar_le_of_abelian_outer_component s (T : Subgroup G) K hK hk hTL
      d.sylow (localT_eq_sylow _ _ d.sylow d.sylow_image).symm a.residual_normalizes hTN
  · exact (source_not_linearThree d K hK a hEK hk hTL hTN hm hlin).elim
  · exact (source_not_unitaryThree d K hK a hEK hk hTL hTN hm hunit).elim

theorem source_symplectic_borel_of_normalized
    (d : Setup KnownSimple.IsKnownSimple T s)
    (K : Subgroup (Gv (markedV s))) (hK : IsComponent (Gv (markedV s)) K)
    (a : ActionData s (T : Subgroup G) K) {m : ℕ} (hm : 1 < m)
    (hmodel : BinaryModelAt (NormalizerAction.componentImage K) m)
    (hEK : EStar s K a.a_normalizes a.z_normalizes ≤ NormalizerAction.componentImage K)
    (hk : IsPGroup 2 s.action.ker) (hTL : (T : Subgroup G) ≤ normalizer (L : Set G))
    (hTN : localT (T : Subgroup G) (markedV s) ≤ X K) :
    Nonempty (SymplecticBorelData s (T : Subgroup G) K m) := by
  have hinner := source_residual_inner d K hK a hm hmodel hEK hk hTL hTN
  obtain ⟨M,⟨b⟩⟩ := Catalogue.exists_inner_borel_data_of_binaryModel s (T : Subgroup G) K
    hmodel hm hinner hk hTL d.sylow (localT_eq_sylow _ _ d.sylow d.sylow_image).symm
    a.residual_normalizes hTN
  have hac : aLocal s ∈ centralizer (residual s : Set (Gv (markedV s))) := by
    intro x hx
    exact Subtype.ext (mem_centralizer_iff.mp d.a_centralizes x hx)
  have hexclude (hM : M.Nonsymplectic) : False :=
    exclude_nonsymplectic_catalogue s (T : Subgroup G) K
      a.a_normalizes a.z_normalizes a.residual_normalizes hac
      (hK.not_centralizes_of_twoCore_centralizer _ d.centralizer_cores.1)
      (hK.not_centralizes_of_twoCore_centralizer _ d.centralizer_cores.2)
      (four_le_rootCenter s (T : Subgroup G) K a.a_normalizes a.z_normalizes a.central hEK)
      M hM b
  cases M with
  | symplecticFour F _ hF => exact ⟨{ F := F, cardinality := hF, marking := b }⟩
  | _ => exact (hexclude trivial).elim

open Theory.SpecificGroups.SymplecticFour

theorem source_residual_le_symplectic_component
    (d : Setup KnownSimple.IsKnownSimple T s)
    (K : Subgroup (Gv (markedV s)))
    {F : Type*} [Field F] [Finite F] [CharP F 2]
    (e : K ≃* Sp F) (hDN : residual s ≤ X K)
    (hinner : residualStar s K ≤ NormalizerAction.componentImage K)
    (hc : Nat.card (Lv L (markedV s) ⧸ pCore 2 (Lv L (markedV s))) = 3) :
    residual s ≤ K := by
  have hz : center K = ⊥ := by
    apply eq_bot_iff.mpr
    intro x hx
    have hh : e x ∈ center (Sp F) := (centerCongr e ⟨x,hx⟩).property
    have he : e x = 1 := by simpa only [EvenProjective.center_eq_bot, mem_bot] using hh
    exact mem_bot.mpr (e.map_eq_one_iff.mp he)
  have hr : 2 ≤ primeRank 3 K := by
    rw [primeRank_equiv 3 e]
    exact Theory.SpecificGroups.Classical.BinaryDerivedCubicRank.symplectic.trans
      (_root_.primeRank_le_of_injective 3 (commutator (Sp F)).subtype (commutator (Sp F)).subtype_injective)
  have hG : primeRank 3 (Gv (markedV s)) ≤ 2 :=
    (d.ambient.involution_centralizer_sqtk (marked_orders s).2).stronglyQuasithin
      3 (by decide) (by decide)
  have htop : primeToResidual 3 (residual s) = ⊤ := by
    let eD := (subgroupOfEquivOfLe (Lv_le_Gv L (markedV s))).symm
    have hh := map_primeToResidual (p := 3) eD
    rw [SymmetricSix.lv_primeToResidual_eq_top s hc,
      map_top_of_surjective _ eD.surjective] at hh
    exact hh.symm
  exact NormalizerAction.le_component_of_prime_generated_inner_image K (residual s) hDN
    hinner htop (centralizer_coprime_three_of_rank K hz hr hG)
end CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentReduction.NormalizedBorel

namespace CFSG.Quasithin.Chapter13.Section06.CentralizerReduction
open A5Module ComponentReduction InitialSieve NormalizedBorel SymplecticInputs
universe u
variable {G : Type u} [Group G] [Finite G] {L V V₁ V₂ : Subgroup G} {T : Sylow 2 G}

theorem normalized_component_false_of_earlier_source
    (d : FlagSource T L V V₁ V₂) (V₃ : Subgroup G)
    (earlier : EarlierLocal T L (normalizer (L : Set G)) V V₂ V₃ (markedZ d.flag.module))
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (hm : SymmetricSix.ModuleData d.flag.module)
    (hcounter : IsA5Counterexample G) (hfusion : ControlsFusionOfZ d.flag.module)
    (K : Subgroup (Gv (markedV d.flag.module)))
    (hK : IsComponent (Gv (markedV d.flag.module)) K)
    (hTN : localT (T : Subgroup G) (markedV d.flag.module) ≤ X K) : False := by
  obtain ⟨c⟩ := localConfiguration_of_earlier_source d (normalizer (L : Set G)) V₃
    earlier hcounter hfusion
  let ds := c.initialSetup hG (hm.V_le_core.trans (map_subtype_le _)) d.V_le_T
  have hd := c.symmetricSixSource d V₃ earlier hG hm
  obtain ⟨a,m,hn,hmodel,hEK⟩ := hd.largeField_knownSimple ds K hK
  have hk : IsPGroup 2 d.flag.module.action.ker := by
    rw [d.flag.action_kernel]
    exact pCore_isPGroup
  have hinner := source_residual_inner ds K hK a hn hmodel hEK hk earlier.T_normalizes_L hTN
  obtain ⟨b⟩ := source_symplectic_borel_of_normalized ds K hK a hn hmodel hEK hk earlier.T_normalizes_L hTN
  obtain ⟨e,he⟩ := exists_whole_model_of_trivial_universal_kernel K hK b.marking.componentEquiv
    (ChapterI.LieMultipliers.Symplectic.even_universalProjection_ker_eq_bot_of_card_pow b.F b.cardinality hn)
  have hDK := source_residual_le_symplectic_component ds K e a.residual_normalizes
    hinner hm.residual_quotient_card
  obtain ⟨S,hSyl,hD,hTK⟩ := exists_ambient_sylow_and_residual_borel d.flag.module (T : Subgroup G)
    K hK e b.cardinality hn hk earlier.T_normalizes_L ds.sylow
    (localT_eq_sylow _ _ ds.sylow ds.sylow_image).symm hTN hDK
  exact SymplecticBorel.SourceExclusion.false_of_earlier_local_source d V₃ earlier hcounter hfusion
    (K.map (Gv (markedV d.flag.module)).subtype) (ambientModel K e) b.cardinality hn S
    (map_subtype_le K) hTK hSyl hD
end CFSG.Quasithin.Chapter13.Section06.CentralizerReduction
