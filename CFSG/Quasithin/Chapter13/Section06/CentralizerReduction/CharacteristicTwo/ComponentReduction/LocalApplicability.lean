module

public import CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.LocalSetup.ModuleMarking
public import CFSG.Quasithin.Chapter1.Section01
public import Theory.GroupTheory.CharacteristicCentralizerFusion

/-!
# Applying the earlier local lemma at C_G(v)

The normal two-subgroup for 1.1.6 is the actual line generated by v.
Its normalizer and centralizer both equal C_G(v). We verify all inputs
of 1.1.5 with M = C_G(z), using the genuine earlier characteristic-two
assertion for this centralizer and the given Sylow C_T(v).

This is the applicability step in the proof of 13.6.6, printed p.926 of
Aschbacher–Smith, combined manuscript of 1 March 2004. The conclusions
of 1.1.5 are not assumed or asserted by this module.
-/

public section
namespace CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentReduction
open Subgroup
variable {G : Type*} [Group G] [Finite G]

/-- The complete 1.1.5 input at the literal element centralizer. The
earlier characteristic-two input concerns G₁ = C_G(z), not an unspecified
maximal overgroup. -/
theorem local115_at_Gv (T : Sylow 2 G) (z v : G)
    (hz : orderOf z = 2) (hv : orderOf v = 2)
    (hzT : z ∈ (T : Subgroup G)) (hvT : v ∈ (T : Subgroup G))
    (hzC : ∀ t ∈ (T : Subgroup G), t * z = z * t)
    (S : Sylow 2 (Gv v))
    (hS : (S : Subgroup (Gv v)).map (Gv v).subtype = Tv (T : Subgroup G) v)
    (hG1 : Gv z ∈ Chapter1.He G) :
    Chapter1.Lemma115Hypotheses (Gv v) S (Gv z) z := by
  have hTv : (T : Subgroup G) ≤ Gv z := fun t ht =>
    mem_centralizer_singleton_iff.mpr (hzC t ht)
  have hline (x : G) (hx : orderOf x = 2) :
      IsTwoLocal (Gv x) := by
    refine ⟨zpowers x, ?_, ?_, ?_⟩
    · intro he
      have hh := mem_zpowers x
      rw [he] at hh
      have hx1 : x = 1 := hh
      simp [hx1] at hx
    · exact IsPGroup.of_card (p := 2) (n := 1) (by simp [Nat.card_zpowers, hx])
    · exact (normalizer_zpowers_eq_centralizer_of_order_two x hx).symm
  have hB : IsPGroup 2 (zpowers v) :=
    IsPGroup.of_card (p := 2) (n := 1) (by simp [Nat.card_zpowers, hv])
  have hBv : zpowers v ≤ Gv v := zpowers_le.mpr
    (mem_centralizer_singleton_iff.mpr rfl)
  have hBN : Gv v ≤ normalizer (zpowers v : Set G) := by
    rw [normalizer_zpowers_eq_centralizer_of_order_two v hv]
    exact le_rfl
  have hBC : centralizer (zpowers v : Set G) ≤ Gv v := by
    intro x hx
    exact mem_centralizer_singleton_iff.mpr
      (mem_centralizer_iff.mp hx v (mem_zpowers v)).symm
  refine ⟨Chapter1.mem_H_of_isTwoLocal (hline v hv),
    ⟨hG1, Chapter1.mem_H_of_isTwoLocal (hline z hz), ?_⟩, ?_, hz, ?_, ?_, le_rfl⟩
  · rw [hS]
    exact inf_le_left.trans hTv
  · exact centralizer_pCoreIn_inf_le hB hBv
      (zpowers_le.mpr (hTv hvT)) hBN hBC
  · rw [hS]
    exact ⟨hzT, mem_centralizer_singleton_iff.mpr (hzC v hvT).symm⟩
  · intro t ht
    exact hzC t (show t ∈ (T : Subgroup G) from (hS ▸ ht).1)

end CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentReduction
