/-!
# Fitting-commutator generation in the double symmetric-three branch

Let N be a normal S₃ × S₃, generated by the ambient conjugates of A, where
A lies in a Sylow two-subgroup S and is normalized by S. Both coordinate
projections of A are nontrivial. Indeed, a coordinate factor has normalizer
index at most two. The Sylow subgroup supplements that normalizer, so if A
lay in this factor, all its ambient conjugates would remain in the factor.

Every odd normal subgroup F of N then satisfies [F,A] = F. Normality extracts
the two cubic coordinates of each element of F; a nonidentity involution in
the corresponding projection of A generates each coordinate by commutators.
Apply this to the literal [F(N),N], whose oddness follows from O₂(D) = 1.
No invariance of the individual factors under the ambient group is assumed.

The final theorem applies the argument to J(G_v)* using the actual star
quotient and the published Sylow marking for J(T_v)*. This supplies the
remaining double-S₃ branch to the Fitting-center assembly.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004, B.5.6(3),
printed p.105, and the first assertion after 13.6.13, printed p.929.
The orbit calculation specializes the proof in Chapter15's ProductBranches.Orbit
using the concrete normal-subgroup classification for S₃ × S₃.
-/

public section

open scoped commutatorElement
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentSelection.FittingCenter.Generation
local notation "S3" => Equiv.Perm (Fin 3)

private theorem span_le_of_small_orbit {D : Type*} [Group D] [Finite D]
    (A K : Subgroup D) (S : Sylow 2 D)
    (hSA : (S : Subgroup D) ≤ normalizer (A : Set D))
    (hi : (normalizer (K : Set D)).index ≤ 2) (hAK : A ≤ K) :
    conjugateSpanBy A ⊤ ≤ K := by
  let H := normalizer (K : Set D)
  have hpos : H.index ≠ 0 := index_ne_zero_of_finite
  by_cases h1 : H.index = 1
  · exact conjugateSpanBy_le hAK (by change ⊤ ≤ H; rw [index_eq_one.mp h1])
  have h2 : H.index = 2 := by change H.index ≤ 2 at hi; omega
  let : H.Normal := normal_of_index_eq_two h2
  have hsup : H ⊔ (S : Subgroup D) = ⊤ := by
    apply index_eq_one.mp
    have hd : (H ⊔ (S : Subgroup D)).index ∣ 2 := by
      simpa only [h2] using index_dvd_of_le (show H ≤ H ⊔ (S : Subgroup D) from le_sup_left)
    rcases (Nat.dvd_prime Nat.prime_two).mp hd with h | h
    · exact h
    · have hdS := index_dvd_of_le (show (S : Subgroup D) ≤ H ⊔ (S : Subgroup D) from le_sup_right)
      rw [h] at hdS
      exact (S.not_dvd_index hdS).elim
  apply (closure_le _).mpr
  rintro _ ⟨g, _, a, ha, rfl⟩
  obtain ⟨h, hh, s, hs, rfl⟩ := mem_sup_of_normal_left.mp (hsup ▸ mem_top g)
  have has : s * a * s⁻¹ ∈ A := (mem_normalizer_iff.mp (hSA hs) a).mp ha
  have hk := (mem_normalizer_iff.mp hh (s * a * s⁻¹)).mp (hAK has)
  change (h * s) * a * (h * s)⁻¹ ∈ K
  simpa only [mul_inv_rev, mul_assoc] using hk

private noncomputable def firstEquiv : (⊤ : Subgroup S3).prod (⊥ : Subgroup S3) ≃* S3 where
  toFun x := x.1.1
  invFun x := ⟨(x, 1), ⟨mem_top _, rfl⟩⟩
  left_inv x := by apply Subtype.ext; exact Prod.ext rfl x.property.2.symm
  right_inv _ := rfl
  map_mul' _ _ := rfl

private theorem normalizer_index {D : Type*} [Group D] [Finite D]
    (N : Subgroup D) [N.Normal] (e : N ≃* S3 × S3)
    (K : Subgroup N) [K.Normal] (eK : K ≃* S3) :
    (normalizer (K.map N.subtype : Set D)).index ≤ 2 := by
  let L := ((⊤ : Subgroup S3).prod (⊥ : Subgroup S3)).map e.symm.toMonoidHom
  let R := ((⊥ : Subgroup S3).prod (⊤ : Subgroup S3)).map e.symm.toMonoidHom
  have hall (B : Subgroup N) [B.Normal] (eB : B ≃* S3) : B = L ∨ B = R := by
    let : (B.map e.toMonoidHom).Normal := (inferInstance : B.Normal).map _ e.surjective
    have h := PermThreeProduct.normal_subgroup_eq_factor (B.map e.toMonoidHom)
      ((B.equivMapOfInjective e.toMonoidHom e.injective).symm.trans eB)
    exact h.imp
      (fun h => by simpa [map_map, L] using congrArg (map e.symm.toMonoidHom) h)
      (fun h => by simpa [map_map, R] using congrArg (map e.symm.toMonoidHom) h)
  rw [← ncard_conjugates_eq_index_normalizer]
  have hs : (Set.range fun a : D => (K.map N.subtype).map (MulAut.conj a).toMonoidHom) ⊆
      {L.map N.subtype, R.map N.subtype} := by
    rintro _ ⟨a, rfl⟩
    let α : MulAut N := MulAut.conjNormal a
    let : (K.map α.toMonoidHom).Normal := (inferInstance : K.Normal).map _ α.surjective
    have hm := hall (K.map α.toMonoidHom)
      ((K.equivMapOfInjective α.toMonoidHom α.injective).symm.trans eK)
    have he : (K.map N.subtype).map (MulAut.conj a).toMonoidHom =
        (K.map α.toMonoidHom).map N.subtype := by rw [map_map, map_map]; rfl
    change (K.map N.subtype).map (MulAut.conj a).toMonoidHom ∈
      ({L.map N.subtype, R.map N.subtype} : Set (Subgroup D))
    rw [he]
    exact hm.imp (congrArg (map N.subtype)) (congrArg (map N.subtype))
  calc
    _ ≤ ({L.map N.subtype, R.map N.subtype} : Set (Subgroup D)).ncard := Set.ncard_le_ncard hs
    _ ≤ 2 := by simpa only [Set.ncard_singleton] using
      Set.ncard_insert_le (L.map N.subtype) {R.map N.subtype}

private theorem exists_second_ne_one {D : Type*} [Group D] [Finite D]
    (N A : Subgroup D) [N.Normal] (S : Sylow 2 D)
    (hSA : (S : Subgroup D) ≤ normalizer (A : Set D))
    (hgen : N = conjugateSpanBy A ⊤) (e : N ≃* S3 × S3) :
    ∃ a : N, (a : D) ∈ A ∧ (e a).2 ≠ 1 := by
  let K := ((⊤ : Subgroup S3).prod (⊥ : Subgroup S3)).comap e.toMonoidHom
  let : K.Normal := inferInstanceAs
    (((⊤ : Subgroup S3).prod (⊥ : Subgroup S3)).comap e.toMonoidHom).Normal
  let eK : K ≃* S3 := ((MulEquiv.subgroupMap e K).trans
    (MulEquiv.subgroupCongr (map_comap_eq_self_of_surjective e.surjective _))).trans firstEquiv
  have hi := normalizer_index N e K eK
  by_contra! hn
  have hAN : A ≤ N := hgen ▸ le_conjugateSpanBy A ⊤
  have hAK : A ≤ K.map N.subtype := by
    intro a ha
    exact mem_map.mpr ⟨⟨a, hAN ha⟩, ⟨mem_top _, hn _ ha⟩, rfl⟩
  have hNK : N ≤ K.map N.subtype :=
    hgen.le.trans (span_le_of_small_orbit A _ S hSA hi hAK)
  let t : S3 := Equiv.swap 0 1
  obtain ⟨x, hx, he⟩ := hNK (e.symm (1, t)).property
  have he' : x = e.symm (1, t) := Subtype.ext he
  have ht : t = 1 := by
    have hx2 : (e x).2 = 1 := hx.2
    simpa only [he', e.apply_symm_apply] using hx2
  exact (by decide : (Equiv.swap (0 : Fin 3) 1) ≠ 1) ht

private theorem cube_commutator : ∀ x a : S3,
    x ^ 3 = 1 → a ^ 2 = 1 → a ≠ 1 → ⁅x⁻¹, a⁆ = x := by
  decide +kernel

private theorem order_dvd_six (x : S3) : orderOf x ∣ 6 := by
  simpa [Nat.card_eq_fintype_card, Fintype.card_perm, Nat.factorial] using orderOf_dvd_natCard x

private theorem cube_of_coprime (x : S3) (h : (orderOf x).Coprime 2) : x ^ 3 = 1 :=
  orderOf_dvd_iff_pow_eq_one.mp (h.dvd_of_dvd_mul_left (order_dvd_six x))

private theorem square_of_coprime (x : S3) (h : (orderOf x).Coprime 3) : x ^ 2 = 1 :=
  orderOf_dvd_iff_pow_eq_one.mp (h.dvd_of_dvd_mul_right (order_dvd_six x))

private theorem model_commutator (F B : Subgroup (S3 × S3)) [F.Normal]
    (hF : ∀ x ∈ F, x.1 ^ 3 = 1 ∧ x.2 ^ 3 = 1)
    (hB : ∀ a ∈ B, a.1 ^ 2 = 1 ∧ a.2 ^ 2 = 1)
    (h₁ : ∃ a ∈ B, a.1 ≠ 1) (h₂ : ∃ a ∈ B, a.2 ≠ 1) : ⁅F, B⁆ = F := by
  apply le_antisymm (commutator_le_left F B)
  intro x hx
  obtain ⟨a, ha, ha1⟩ := h₁
  obtain ⟨b, hb, hb2⟩ := h₂
  let t : S3 := Equiv.swap 0 1
  have ht : t ^ 2 = 1 := by decide
  have htn : t ≠ 1 := by decide
  have hx₁ : (x.1, 1) ∈ F := by
    have hm := commutator_le_left F ⊤
      (commutator_mem_commutator (F.inv_mem hx) (mem_top (t, 1)))
    have he : ⁅x⁻¹, (t, (1 : S3))⁆ = (x.1, 1) := by
      apply Prod.ext
      · exact cube_commutator x.1 t (hF x hx).1 ht htn
      · change ⁅x.2⁻¹, (1 : S3)⁆ = 1
        simp
    exact he ▸ hm
  have hx₂ : (1, x.2) ∈ F := by
    have hm := commutator_le_left F ⊤
      (commutator_mem_commutator (F.inv_mem hx) (mem_top (1, t)))
    have he : ⁅x⁻¹, ((1 : S3), t)⁆ = (1, x.2) := by
      apply Prod.ext
      · change ⁅x.1⁻¹, (1 : S3)⁆ = 1
        simp
      · exact cube_commutator x.2 t (hF x hx).2 ht htn
    exact he ▸ hm
  have hc₁ : (x.1, 1) ∈ ⁅F, B⁆ := by
    have hm := commutator_mem_commutator (F.inv_mem hx₁) ha
    have he : ⁅(x.1, (1 : S3))⁻¹, a⁆ = (x.1, 1) := by
      apply Prod.ext
      · exact cube_commutator x.1 a.1 (hF x hx).1 (hB a ha).1 ha1
      · change ⁅(1 : S3)⁻¹, a.2⁆ = 1
        simp
    exact he ▸ hm
  have hc₂ : (1, x.2) ∈ ⁅F, B⁆ := by
    have hm := commutator_mem_commutator (F.inv_mem hx₂) hb
    have he : ⁅((1 : S3), x.2)⁻¹, b⁆ = (1, x.2) := by
      apply Prod.ext
      · change ⁅(1 : S3)⁻¹, b.1⁆ = 1
        simp
      · exact cube_commutator x.2 b.2 (hF x hx).2 (hB b hb).2 hb2
    exact he ▸ hm
  simpa only [Prod.mk_mul_mk, mul_one, one_mul, Prod.mk.eta] using
    (⁅F, B⁆).mul_mem hc₁ hc₂

private theorem odd_normal_generation {D : Type*} [Group D] [Finite D]
    (N F A : Subgroup D) [N.Normal] [F.Normal] (S : Sylow 2 D)
    (hFN : F ≤ N) (hodd : Nat.Coprime 2 (Nat.card F))
    (hAS : A ≤ S) (hSA : (S : Subgroup D) ≤ normalizer (A : Set D))
    (hgen : N = conjugateSpanBy A ⊤) (e : N ≃* S3 × S3) : ⁅F, A⁆ = F := by
  have hAN : A ≤ N := hgen ▸ le_conjugateSpanBy A ⊤
  let F₀ := F.subgroupOf N
  let A₀ := A.subgroupOf N
  let F' := F₀.map e.toMonoidHom
  let B := A₀.map e.toMonoidHom
  let : F'.Normal := (inferInstance : F₀.Normal).map _ e.surjective
  have hF : ∀ x ∈ F', x.1 ^ 3 = 1 ∧ x.2 ^ 3 = 1 := by
    rintro _ ⟨x, hx, rfl⟩
    let y : F := ⟨x, hx⟩
    let f := e.toMonoidHom.comp (inclusion hFN)
    have hd (p : (S3 × S3) →* S3) : orderOf (p (e x)) ∣ Nat.card F :=
      (orderOf_map_dvd (p.comp f) y).trans (orderOf_dvd_natCard y)
    exact ⟨cube_of_coprime _ (hodd.of_dvd_right (hd (MonoidHom.fst S3 S3))).symm,
      cube_of_coprime _ (hodd.of_dvd_right (hd (MonoidHom.snd S3 S3))).symm⟩
  have hB : ∀ a ∈ B, a.1 ^ 2 = 1 ∧ a.2 ^ 2 = 1 := by
    rintro _ ⟨a, ha, rfl⟩
    let y : A := ⟨a, ha⟩
    let f := e.toMonoidHom.comp (inclusion hAN)
    have hp : IsPGroup 2 A := S.isPGroup'.of_injective (inclusion hAS) (inclusion_injective hAS)
    have hc (p : (S3 × S3) →* S3) : (orderOf (p (e a))).Coprime 3 :=
      (hp.orderOf_coprime (by decide : Nat.Coprime 2 3) y).of_dvd_left
        (orderOf_map_dvd (p.comp f) y)
    exact ⟨square_of_coprime _ (hc (MonoidHom.fst S3 S3)),
      square_of_coprime _ (hc (MonoidHom.snd S3 S3))⟩
  have h₁ : ∃ a ∈ B, a.1 ≠ 1 := by
    obtain ⟨a, ha, hne⟩ := exists_second_ne_one N A S hSA hgen (e.trans MulEquiv.prodComm)
    exact ⟨e a, mem_map.mpr ⟨a, ha, rfl⟩, hne⟩
  have h₂ : ∃ a ∈ B, a.2 ≠ 1 := by
    obtain ⟨a, ha, hne⟩ := exists_second_ne_one N A S hSA hgen e
    exact ⟨e a, mem_map.mpr ⟨a, ha, rfl⟩, hne⟩
  have hm : ⁅F₀, A₀⁆ = F₀ := by
    apply map_injective (f := e.toMonoidHom) e.injective
    rw [map_commutator]
    exact model_commutator F' B hF hB h₁ h₂
  have hf : F₀.map N.subtype = F := map_subgroupOf_eq_of_le hFN
  have ha : A₀.map N.subtype = A := map_subgroupOf_eq_of_le hAN
  have he := congrArg (map N.subtype) hm
  simpa only [map_commutator, hf, ha] using he

/-- The double-S₃ branch of the Fitting-commutator generation argument. -/
theorem fittingCommutator_generation_of_doubleThree {D : Type*} [Group D] [Finite D]
    (N A : Subgroup D) [N.Normal] (S : Sylow 2 D)
    (hcore : pCore 2 D = ⊥)
    (hAS : A ≤ S) (hSA : (S : Subgroup D) ≤ normalizer (A : Set D))
    (hgen : N = conjugateSpanBy A ⊤) (e : N ≃* S3 × S3) :
    ⁅fittingCommutator N, A⁆ = fittingCommutator N := by
  apply odd_normal_generation N (fittingCommutator N) A S _ _ hAS hSA hgen e
  · apply (fittingCommutator_le N).trans
    rintro _ ⟨x, _, rfl⟩
    exact x.property
  · exact (fittingImage_coprime_two N hcore).of_dvd_right
      (card_dvd_of_le (fittingCommutator_le N))

/-- Apply the double-S₃ argument to the literal Thompson star image and the
Sylow marking supplied by the earlier source conclusion for T_v. -/
theorem thompson_generation_of_doubleThree {G : Type*} [Group G] [Finite G]
    (T : Subgroup G) (z v : G)
    (hSyl : Chapter1.IsSylowIn 2 (Tv T v) (Gv v))
    (hcore : pCore 2 (Gstar z v) = ⊥)
    (e : JGstar z v ≃* S3 × S3) :
    ⁅fittingCommutator (JGstar z v),
      starImage z v (Stellmacher.elementaryAbelianMaxJ (Tv T v))⁆ =
        fittingCommutator (JGstar z v) := by
  let : (JGstar z v).Normal := JGstar_normal z v
  obtain ⟨S, _, hAS, hSA, hgen⟩ := exists_starSylow_marking T z v hSyl
  exact fittingCommutator_generation_of_doubleThree _ _ S hcore hAS hSA hgen e

