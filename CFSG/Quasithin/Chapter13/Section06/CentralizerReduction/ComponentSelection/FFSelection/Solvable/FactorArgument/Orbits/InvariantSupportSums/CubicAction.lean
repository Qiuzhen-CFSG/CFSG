module
public import CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentSelection.FFSelection.Solvable.FactorArgument.Orbits.SupportTransport
public import Theory.GroupAction.FourElementTwoAction
public import Theory.GroupAction.FourAutomorphismOrbit
public import Theory.GroupTheory.CommutatorPreimage
public import Theory.ElementaryAbelian.AbelianNormalClosure

/-!
# Cubic actions on the literal supports in 13.6.13

Relative normalization and disjointness make each factor fix every other
support. The product of the supports therefore makes each U_i generated by
its own H_i commutators. An action on four elements with image of order at
most two is quadratic, so this full action has image of order greater than
two. Since H_i has order six, its cubic residual has image of order three.
That image moves every nonidentity point and is transitive on those points.
All actions are restrictions of the specified star quotient action.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004,
proof of Lemma 13.6.13, printed p.929.
-/

public section
open Subgroup
open scoped commutatorElement IsMulCommutative
namespace CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentSelection.Solvable.NormalS3Decomposition
variable {G : Type*} [Group G] {z v : G} {X : Subgroup (Gstar z v)}
variable (d : NormalS3Decomposition z v X)

private theorem pre_mono {A B : Subgroup (Gstar z v)} (h : A ≤ B) :
    starPreimage z v A ≤ starPreimage z v B := map_mono (comap_mono h)

private theorem support_actor_normalizes (i : Fin d.count) :
    starPreimage z v (d.factor i) ≤ normalizer (d.support i : Set G) :=
  (pre_mono (d.factor_le i)).trans (d.support_normalized i)

/-- Different factors fix the other literal supports. -/
theorem support_cross_commutator {i j : Fin d.count} (hij : i ≠ j) :
    ⁅d.support i, starPreimage z v (d.factor j)⁆ = ⊥ := by
  apply le_bot_iff.mp
  apply (le_inf ?_ ?_).trans (d.support_disjoint hij).le_bot
  · exact le_normalizer_iff_commutator_le_left.mp
      ((pre_mono (d.factor_le j)).trans (d.support_normalized i))
  · exact commutator_mono (d.support_le i) le_rfl

/-- Its own factor generates each support by commutators. -/
theorem support_self_commutator [IsElementaryAbelian 2 (Uv z v)] (i : Fin d.count) :
    ⁅d.support i, starPreimage z v (d.factor i)⁆ = d.support i := by
  let W := movedSubgroup z v d.H
  let A := starPreimage z v (d.factor i)
  let C := ⁅d.support i, A⁆
  have hCW : C ≤ W :=
    (le_normalizer_iff_commutator_le_left.mp (d.support_actor_normalizes i)).trans
      (d.support_le i)
  have hn : W ≤ normalizer (C : Set G) := by
    apply (Subgroup.centralizer_le_normalizer _).trans'
    intro w hw c hc
    exact setLike_mul_comm ((movedSubgroup_le_Uv z v d.H) (hCW hc))
      ((movedSubgroup_le_Uv z v d.H) hw)
  have hp : W ≤ commutatorPreimage W A C := by
    change movedSubgroup z v d.H ≤ _
    rw [← d.iSup_support]
    apply iSup_le
    intro j
    apply le_commutatorPreimage (d.support_le j)
    by_cases hji : j = i
    · subst j; exact le_rfl
    · exact (d.support_cross_commutator hji).le.trans bot_le
  apply le_antisymm (le_normalizer_iff_commutator_le_left.mp (d.support_actor_normalizes i))
  exact (commutator_mono hp le_rfl).trans (commutator_commutatorPreimage_le W A C hn)

private theorem star_preserves (i : Fin d.count) (a : d.factor i) (w : d.support i) :
    (starAction z v a ⟨w, (d.support_le i).trans (movedSubgroup_le_Uv z v d.H) w.property⟩ : G)
      ∈ d.support i := by
  obtain ⟨g, hg⟩ := starMk_surjective z v a
  have hgm : (g : G) ∈ starPreimage z v (d.factor i) :=
    mem_map.mpr ⟨g, (show starMk z v g ∈ d.factor i from hg ▸ a.property), rfl⟩
  rw [← hg, starAction_mk_apply]
  exact (mem_normalizer_iff.mp (d.support_actor_normalizes i hgm) w).mp w.property

/-- The actual star action of H_i restricted to its four-element support. -/
@[expose] noncomputable def supportAction (i : Fin d.count) : d.factor i →* MulAut (d.support i) where
  toFun a :=
    { toFun := fun w => ⟨starAction z v a ⟨w,
          (d.support_le i).trans (movedSubgroup_le_Uv z v d.H) w.property⟩,
        by exact d.star_preserves i a w⟩
      invFun := fun w => ⟨starAction z v a⁻¹ ⟨w,
          (d.support_le i).trans (movedSubgroup_le_Uv z v d.H) w.property⟩,
        by exact d.star_preserves i a⁻¹ w⟩
      left_inv := by
        intro w
        apply Subtype.ext
        change ((starAction z v (a : Gstar z v)⁻¹)
          (starAction z v a ⟨w, _⟩) : G) = w
        simp only [map_inv, MulAut.inv_apply_self]
      right_inv := by
        intro w
        apply Subtype.ext
        change ((starAction z v a)
          (starAction z v (a : Gstar z v)⁻¹ ⟨w, _⟩) : G) = w
        simp only [map_inv, MulAut.apply_inv_self]
      map_mul' := by
        intro w u
        apply Subtype.ext
        exact congrArg (fun y : Uv z v => (y : G)) ((starAction z v a).map_mul
          ⟨w, (d.support_le i).trans (movedSubgroup_le_Uv z v d.H) w.property⟩
          ⟨u, (d.support_le i).trans (movedSubgroup_le_Uv z v d.H) u.property⟩) }
  map_one' := by
    apply MulEquiv.ext
    intro w
    apply Subtype.ext
    change (starAction z v 1 ⟨w, _⟩ : G) = w
    simp
  map_mul' := by
    intro a b
    apply MulEquiv.ext
    intro w
    apply Subtype.ext
    change (starAction z v ((a : Gstar z v) * b) ⟨w, _⟩ : G) =
      ((starAction z v a) (starAction z v b ⟨w, _⟩) : G)
    rw [map_mul]; rfl

theorem supportAction_mk (i : Fin d.count) (g : Gv v)
    (hg : starMk z v g ∈ d.factor i) (w : d.support i) :
    (d.supportAction i ⟨starMk z v g, hg⟩ w : G) = (g : G) * w * (g : G)⁻¹ := rfl

theorem supportAction_full [IsElementaryAbelian 2 (Uv z v)] (i : Fin d.count) :
    commutatorAction (d.supportAction i).range (d.support i) = ⊤ := by
  let C := commutatorAction (d.supportAction i).range (d.support i)
  have hm : d.support i ≤ C.map (d.support i).subtype := by
    apply (d.support_self_commutator i).ge.trans
    apply commutator_le.mpr
    intro w hw g hg
    obtain ⟨g, hgm, rfl⟩ := mem_map.mp hg
    let a : (d.supportAction i).range :=
      ⟨d.supportAction i ⟨starMk z v g, hgm⟩, ⟨_, rfl⟩⟩
    let x : d.support i := ⟨w⁻¹, inv_mem hw⟩
    refine mem_map.mpr ⟨x⁻¹ * (a : MulAut (d.support i)) x, ?_, ?_⟩
    · change _ ∈ commutatorAction (d.supportAction i).range (d.support i)
      rw [commutatorAction_eq_closure]
      exact subset_closure ⟨a, x, rfl⟩
    · change w⁻¹⁻¹ * ((g : G) * w⁻¹ * (g : G)⁻¹) = ⁅w, (g : G)⁆
      simp only [inv_inv, commutatorElement_def, mul_assoc]
  apply top_unique
  intro w _
  obtain ⟨x, hx, he⟩ := hm w.property
  exact (Subtype.ext he : x = w) ▸ hx

private theorem full_four_action_range_large {W A : Type*} [Group W] [Finite W]
    [Group A] (f : A →* MulAut W) (hcard : Nat.card W = 4)
    (hfull : commutatorAction f.range W = ⊤) : 2 < Nat.card f.range := by
  by_contra! hsmall
  have hpos : 0 < Nat.card f.range := Nat.card_pos
  have hp : IsPGroup 2 f.range := by
    rcases (show Nat.card f.range = 1 ∨ Nat.card f.range = 2 by omega) with h | h
    · exact IsPGroup.of_card (n := 0) (by simpa using h)
    · exact IsPGroup.of_card (n := 1) (by simpa using h)
  have hq := two_group_action_on_four_is_quadratic hp hcard
  rw [commutatorAction₂, hfull] at hq
  change commutatorAction f.range W = ⊥ at hq
  have hc := congrArg (fun S : Subgroup W => Nat.card S) (hfull.symm.trans hq)
  simp only [card_top, card_bot, hcard] at hc
  omega

variable [Finite G] [IsElementaryAbelian 2 (Uv z v)]

/-- The factor action has more than two automorphisms; its cubic cannot vanish. -/
theorem supportAction_range_large (i : Fin d.count) :
    2 < Nat.card (d.supportAction i).range :=
  full_four_action_range_large _ (d.support_card i) (d.supportAction_full i)

/-- The cubic residual, acting through the original factor inclusion. -/
@[expose] noncomputable def supportCubicAction (i : Fin d.count) :
    pResidual 2 (d.factor i) →* MulAut (d.support i) :=
  (d.supportAction i).comp (pResidual 2 (d.factor i)).subtype

omit [Finite G] [IsElementaryAbelian 2 (Uv z v)] in
private theorem residual_card (i : Fin d.count) :
    Nat.card (pResidual 2 (d.factor i)) = 3 := by
  have h := d.factorResidual_card i
  rwa [card_map_of_injective (d.factor i).subtype_injective] at h

/-- The cubic acts faithfully on its own support: its image has order three. -/
theorem supportCubicAction_range_card (i : Fin d.count) :
    Nat.card (d.supportCubicAction i).range = 3 := by
  let f := d.supportAction i
  have hne : ¬ pResidual 2 (d.factor i) ≤ f.ker := by
    intro hle
    have hk : 3 ≤ Nat.card f.ker := by
      simpa only [d.residual_card i] using card_le_of_le hle
    have hc : Nat.card (d.factor i) = 6 := by
      rw [Nat.card_congr (d.model i).toEquiv, Nat.card_eq_fintype_card, Fintype.card_perm]
      decide
    have he := f.ker.card_mul_index
    rw [index_ker, hc] at he
    have hbig := d.supportAction_range_large i
    change 2 < Nat.card f.range at hbig
    nlinarith
  have hd : Nat.card (d.supportCubicAction i).range ∣ 3 := by
    simpa only [d.residual_card i] using card_range_dvd (d.supportCubicAction i)
  rcases (Nat.dvd_prime Nat.prime_three).mp hd with h | h
  · exfalso
    apply hne
    have hz := (card_eq_one.mp h)
    intro a ha
    have hm : d.supportCubicAction i ⟨a, ha⟩ ∈ (d.supportCubicAction i).range := ⟨_, rfl⟩
    rw [hz, mem_bot] at hm
    exact hm
  · exact h

/-- Every nonidentity vector in a support is moved by some cubic element. -/
theorem supportCubicAction_moves (i : Fin d.count) (w : d.support i) (hw : w ≠ 1) :
    ∃ a : pResidual 2 (d.factor i), d.supportCubicAction i a w ≠ w := by
  by_contra! hfix
  have hbound := card_mulAut_subgroup_le_two_of_fixed_point (d.support_card i) w hw
    (d.supportCubicAction i).range (by
      rintro _ ⟨a, rfl⟩
      exact hfix a)
  rw [d.supportCubicAction_range_card i] at hbound
  omega

/-- The cubic residual is transitive on the three nonidentity support vectors. -/
theorem supportCubicAction_transitive (i : Fin d.count) (x y : d.support i)
    (hx : x ≠ 1) (hy : y ≠ 1) :
    ∃ a : pResidual 2 (d.factor i), d.supportCubicAction i a x = y := by
  let : IsElementaryAbelian 2 (d.support i) :=
    IsElementaryAbelian.of_le ((d.support_le i).trans (movedSubgroup_le_Uv z v d.H))
  obtain ⟨a, ha⟩ := MulAction.mem_orbit_iff.mp
    (MulAction.nonidentity_mem_orbit_of_four_automorphism_subgroup (d.support_card i)
      (d.supportCubicAction i).range (by rw [d.supportCubicAction_range_card i]; decide)
      x hx y hy)
  obtain ⟨b, hb⟩ := a.property
  exact ⟨b, by rw [hb]; exact ha⟩

end CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentSelection.Solvable.NormalS3Decomposition
