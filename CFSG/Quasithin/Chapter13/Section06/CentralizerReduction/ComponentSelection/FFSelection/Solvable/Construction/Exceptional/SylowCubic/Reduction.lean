module

public import CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentSelection.FFSelection.Solvable.Construction.Exceptional.ParityModel
public import Theory.GroupTheory.PPerfectHom
public import Mathlib.GroupTheory.Sylow

/-!
# Reduction of the parity-actor problem to cubic conjugate closures

The actor and its projections are the literal parity-matched subgroup of
S₆ × S₃. Its first-projection kernel has order three. A two-perfect subgroup
with order dividing three times a power of two and nontrivial second image
contains an element of order three with nontrivial second image.

The remaining finite input concerns the subgroup generated by the Sylow
conjugates of this element: unless the element is in the specified cubic,
that closure has order divisible by nine or five. Both are incompatible with
the subgroup's order bound. Once the cubic is contained, two-perfectness
eliminates the quotient, which is a two-group.

The finite input is explicit in `eq_cubic_of_closure_restriction`; this module
does not assert that input or the unconditional source theorem.
Source motivation: Aschbacher–Smith, B.5.6(4), B.5.7, and the outer branch
of 13.6.13, printed pp.105–106 and 929.
-/

@[expose] public section

open Subgroup
namespace CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentSelection.Solvable.Construction.Exceptional.SixPoint

/-- The canonical cubic, with its actual three-point coordinate, is A₃. -/
noncomputable def cubicEquiv : cubic ≃* alternatingGroup (Fin 3) where
  toFun x := ⟨secondProjection x, by
    rw [Equiv.Perm.mem_alternatingGroup]
    rw [← parity]
    have hx : firstProjection x = 1 := x.property
    rw [hx, map_one]⟩
  invFun x := ⟨⟨(1, x.val), by
    change Equiv.Perm.sign 1 = Equiv.Perm.sign x.val
    rw [map_one, (Equiv.Perm.mem_alternatingGroup.mp x.property)]⟩, by
      rfl⟩
  left_inv x := by
    apply Subtype.ext
    apply projections_injective
    · exact (show firstProjection x.val = 1 from x.property).symm
    · rfl
  right_inv x := rfl
  map_mul' x y := by apply Subtype.ext; exact map_mul secondProjection _ _

/-- The specified first-projection kernel has order three. -/
lemma card_cubic : Nat.card cubic = 3 := by
  rw [Nat.card_congr cubicEquiv.toEquiv, Nat.card_eq_fintype_card, card_alternatingGroup]
  decide

private lemma evenThree_cube (x : Equiv.Perm (Fin 3)) (hx : Equiv.Perm.sign x = 1) : x ^ 3 = 1 := by
  revert x
  decide

/-- Extract an order-three element whose second coordinate is nontrivial. -/
lemma exists_cubic_element (R : Subgroup Actor) (hp : IsPPerfect 2 R)
    {n : ℕ} (hc : Nat.card R ∣ 3 * 2 ^ n)
    (hne : R.map secondProjection ≠ ⊥) :
    ∃ r ∈ R, r ^ 3 = 1 ∧ secondProjection r ≠ 1 := by
  have he : ∃ g : R, secondProjection g ≠ 1 := by
    by_contra! he
    apply hne
    apply le_bot_iff.mp
    rintro x ⟨g, hg, rfl⟩
    exact he ⟨g, hg⟩
  obtain ⟨g, hg⟩ := he
  have hs : Equiv.Perm.sign (secondProjection g) = 1 := by
    have htwo : IsPGroup 2 ℤˣ := IsPGroup.of_card (n := 1) (by simp [Nat.card_eq_fintype_card])
    exact DFunLike.congr_fun (hp.hom_eq_one_of_isPGroup htwo
      ((Equiv.Perm.sign.comp secondProjection).comp R.subtype)) g
  have ho : orderOf (secondProjection g) = 3 := orderOf_eq_prime (evenThree_cube _ hs) hg
  let k := orderOf (g : ↥R) / 3
  have h3ordA : 3 ∣ orderOf (g : Actor) := by
    have hm := orderOf_map_dvd secondProjection (g : Actor)
    rw [ho] at hm
    exact hm
  have h3ord : 3 ∣ orderOf (g : ↥R) := by
    rw [← orderOf_injective R.subtype R.subtype_injective g]
    exact h3ordA
  have hkr : orderOf (g : ↥R) = 3 * k := by
    dsimp [k]
    calc
      orderOf (g : ↥R) = orderOf (g : ↥R) / 3 * 3 := (Nat.div_mul_cancel h3ord).symm
      _ = 3 * (orderOf (g : ↥R) / 3) := Nat.mul_comm _ _
  have hkrA : orderOf (g : Actor) = 3 * k := by
    calc
      orderOf (g : Actor) = orderOf (g : ↥R) :=
        orderOf_injective R.subtype R.subtype_injective g
      _ = 3 * k := hkr
  refine ⟨(g : Actor) ^ k, R.pow_mem g.property _, ?_, ?_⟩
  · have hkrA' : orderOf (g : Actor) = k * 3 := by rw [hkrA, Nat.mul_comm]
    rw [← pow_mul, ← hkrA']
    exact pow_orderOf_eq_one (g : Actor)
  · rw [map_pow]
    intro hz
    have hd : 3 ∣ k := by simpa [ho] using orderOf_dvd_of_pow_eq_one hz
    have hdiv : k ∣ 2 ^ n := by
      dsimp [k]
      apply (Nat.div_dvd_iff_dvd_mul h3ord (by decide : 0 < 3)).mpr
      exact (orderOf_dvd_natCard (g : ↥R)).trans hc
    have hthree : 3 ∣ 2 ^ n := dvd_trans hd hdiv
    exact (by have := Nat.Prime.dvd_of_dvd_pow Nat.prime_three hthree; norm_num at this)

/-- Two-perfectness removes the two-group quotient after the cubic is captured. -/
lemma eq_cubic_of_contains (R : Subgroup Actor) (hp : IsPPerfect 2 R)
    {n : ℕ} (hc : Nat.card R ∣ 3 * 2 ^ n) (hle : cubic ≤ R) : R = cubic := by
  let C := cubic.subgroupOf R
  have hcard : Nat.card C = 3 := by
    rw [Nat.card_congr (subgroupOfEquivOfLe hle).toEquiv, card_cubic]
  have hindex : C.index ∣ 2 ^ n := by
    have hmul : 3 * C.index = Nat.card R := by
      simpa [hcard] using C.card_mul_index
    apply Nat.dvd_of_mul_dvd_mul_left (by decide : 0 < 3)
    rw [hmul]
    exact hc
  have hnorm : C.Normal := by
    change (firstProjection.ker.subgroupOf R).Normal
    infer_instance
  have hgroup : IsPGroup 2 (R ⧸ C) := by
    rw [isPGroup_iff_card_dvd_pow]
    exact ⟨n, hindex⟩
  have ht := hp C hnorm hgroup
  apply le_antisymm _ hle
  intro x hx
  have hmem : (⟨x, hx⟩ : R) ∈ C := by rw [ht]; trivial
  exact hmem

/-- The subgroup generated by the literal Sylow conjugates of one actor. -/
def sylowConjugateClosure (P : Sylow 2 Actor) (r : Actor) : Subgroup Actor :=
  Subgroup.closure {x | ∃ p ∈ (P : Subgroup Actor), x = p * r * p⁻¹}

/-- The Sylow conjugate closure lies in every Sylow-normalized subgroup containing its seed. -/
lemma sylowConjugateClosure_le (P : Sylow 2 Actor) (R : Subgroup Actor)
    (hn : (P : Subgroup Actor) ≤ normalizer (R : Set Actor))
    {r : Actor} (hr : r ∈ R) : sylowConjugateClosure P r ≤ R := by
  apply (Subgroup.closure_le R).mpr
  rintro x ⟨p, hp, rfl⟩
  exact (mem_normalizer_iff.mp (hn hp) r).mp hr

/-- The explicit finite closure restriction implies the required subgroup restriction. -/
lemma eq_cubic_of_closure_restriction
    (hfinite : ∀ (P : Sylow 2 Actor) (r : Actor), r ^ 3 = 1 →
      secondProjection r ≠ 1 → firstProjection r = 1 ∨
      9 ∣ Nat.card (sylowConjugateClosure P r) ∨
      5 ∣ Nat.card (sylowConjugateClosure P r))
    (P : Sylow 2 Actor) (R : Subgroup Actor)
    (hn : (P : Subgroup Actor) ≤ normalizer (R : Set Actor))
    (hp : IsPPerfect 2 R) {n : ℕ} (hc : Nat.card R ∣ 3 * 2 ^ n)
    (hne : R.map secondProjection ≠ ⊥) : R = cubic := by
  obtain ⟨r, hr, hthree, hsecond⟩ := exists_cubic_element R hp hc hne
  have hfirst : firstProjection r = 1 := by
    rcases hfinite P r hthree hsecond with h | h | h
    · exact h
    · have hd := h.trans ((card_dvd_of_le (sylowConjugateClosure_le P R hn hr)).trans hc)
      have ht : 3 ∣ 2 ^ n := (Nat.mul_dvd_mul_iff_left (by decide : 0 < 3)).mp hd
      have := Nat.Prime.dvd_of_dvd_pow Nat.prime_three ht
      norm_num at this
    · have hd := h.trans ((card_dvd_of_le (sylowConjugateClosure_le P R hn hr)).trans hc)
      rcases Nat.Prime.dvd_mul Nat.prime_five |>.mp hd with h | h
      · norm_num at h
      · have := Nat.Prime.dvd_of_dvd_pow Nat.prime_five h
        norm_num at this
  have hro : orderOf r = 3 := by
    apply orderOf_eq_prime hthree
    intro he
    exact hsecond (by rw [he, map_one])
  have hle : zpowers r ≤ cubic := zpowers_le.mpr hfirst
  have heq : zpowers r = cubic := eq_of_le_of_card_ge hle (by
    rw [card_cubic, Nat.card_zpowers, hro])
  apply eq_cubic_of_contains R hp hc
  rw [← heq]
  exact zpowers_le.mpr hr

end CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentSelection.Solvable.Construction.Exceptional.SixPoint
