module
public import CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentSelection.ComponentModules.OrbitAction
public import Theory.GroupTheory.CentralizerPrimeKernel

/-!
# The paired plus actor and its centralizer

When Lᵥ lies in the component orbit, the full plus actor is generated by
the orbit and the image of Tᵥ. Its quotient by the normal orbit is thus a
two-group. If the orbit has trivial center, its centralizer is a two-group
as well. These literal generation and centralizer facts match the actual
components in the B.5.6 action with the two original moving components.

Source: Aschbacher--Smith 13.6.14, printed p.929.
-/

public section
open Subgroup
namespace CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentSelection
variable {G : Type*} [Group G]

/-- Plus placement alone gives the full quotient generation identity. -/
theorem paired_plus_generation_of_plus_placement_source (K L T : Subgroup G) (z v : G)
    (hL : Tv T v ≤ normalizer (Lv L v : Set G))
    (hz : Tv T v ≤ centralizer ({z} : Set G))
    (hLv : plusImage K L T z v hL hz (Lv L v) ≤
      plusImage K L T z v hL hz (Kminus K T v)) :
    plusImage K L T z v hL hz (Kminus K T v) ⊔
      plusImage K L T z v hL hz (Tv T v) = ⊤ := by
  let A := plusActor K L T v
  have hKm : Kminus K T v ≤ A := le_sup_left.trans le_sup_left
  have hLvA : Lv L v ≤ A := le_sup_right.trans le_sup_left
  have hTv : Tv T v ≤ A := le_sup_right
  have hg : ((Kminus K T v).subgroupOf A ⊔ (Lv L v).subgroupOf A) ⊔
      (Tv T v).subgroupOf A = ⊤ := by
    rw [←subgroupOf_sup hKm hLvA,←subgroupOf_sup (sup_le hKm hLvA) hTv]
    exact (Subgroup.subgroupOf_self A)
  have hm := congrArg (Subgroup.map (plusMk K L T z v hL hz)) hg
  rw [Subgroup.map_sup,Subgroup.map_sup,
    map_top_of_surjective _ (plusMk_surjective K L T z v hL hz)] at hm
  change (plusImage K L T z v hL hz (Kminus K T v) ⊔
    plusImage K L T z v hL hz (Lv L v)) ⊔ plusImage K L T z v hL hz (Tv T v) = ⊤ at hm
  rwa [sup_eq_left.mpr hLv] at hm

/-- Actual pair-plus and Sylow-plus generate the full plus actor. -/
theorem paired_plus_generation_source (K L T : Subgroup G) (z v : G)
    (hL : Tv T v ≤ normalizer (Lv L v : Set G))
    (hz : Tv T v ≤ centralizer ({z} : Set G))
    (hLv : Lv L v ≤ Kminus K T v) :
    plusImage K L T z v hL hz (Kminus K T v) ⊔
      plusImage K L T z v hL hz (Tv T v) = ⊤ := by
  have hA : plusActor K L T v = Kminus K T v ⊔ Tv T v := by
    change (Kminus K T v ⊔ Lv L v) ⊔ Tv T v = _
    rw [sup_eq_left.mpr hLv]
  rw [plusImage,plusImage,←Subgroup.map_sup,←subgroupOf_sup
    (show Kminus K T v ≤ plusActor K L T v from le_sup_left.trans le_sup_left)
    (show Tv T v ≤ plusActor K L T v from le_sup_right),←hA,subgroupOf_self,
    Subgroup.map_top_of_surjective _ (plusMk_surjective K L T z v hL hz)]

/-- The centralizer of the actual centerless pair is a two-group. -/
theorem paired_plus_centralizer_isTwoGroup_source
    (K L T : Subgroup G) (z v : G)
    (hL : Tv T v ≤ normalizer (Lv L v : Set G))
    (hz : Tv T v ≤ centralizer ({z} : Set G))
    (hK : K ∈ Yz L T z v) (hLv : Lv L v ≤ Kminus K T v)
    (hT : IsPGroup 2 (Tv T v))
    (hZ : center (plusImage K L T z v hL hz (Kminus K T v)) = ⊥) :
    IsPGroup 2 (centralizer
      (plusImage K L T z v hL hz (Kminus K T v) : Set (Gplus K L T z v hL hz))) := by
  let C := plusImage K L T z v hL hz (Kminus K T v)
  let := plusImage_Kminus_normal_source K L T z v hL hz hK
  have hq : IsPGroup 2 (Gplus K L T z v hL hz ⧸ C) :=
    isPGroup_quotient_of_sup_eq_top C (plusImage K L T z v hL hz (Tv T v))
      (hT.comap_subtype.map _) (paired_plus_generation_source K L T z v hL hz hLv)
  exact isPGroup_centralizer_of_quotient C hq (hZ.symm ▸ IsPGroup.of_bot)

/-- The same centralizer consequence only uses containment in the plus quotient. -/
theorem paired_plus_centralizer_isTwoGroup_of_plus_placement_source
    (K L T : Subgroup G) (z v : G)
    (hL : Tv T v ≤ normalizer (Lv L v : Set G))
    (hz : Tv T v ≤ centralizer ({z} : Set G))
    (hK : K ∈ Yz L T z v)
    (hLv : plusImage K L T z v hL hz (Lv L v) ≤
      plusImage K L T z v hL hz (Kminus K T v))
    (hT : IsPGroup 2 (Tv T v))
    (hZ : center (plusImage K L T z v hL hz (Kminus K T v)) = ⊥) :
    IsPGroup 2 (centralizer
      (plusImage K L T z v hL hz (Kminus K T v) : Set (Gplus K L T z v hL hz))) := by
  let C := plusImage K L T z v hL hz (Kminus K T v)
  let := plusImage_Kminus_normal_source K L T z v hL hz hK
  have hq : IsPGroup 2 (Gplus K L T z v hL hz ⧸ C) :=
    isPGroup_quotient_of_sup_eq_top C (plusImage K L T z v hL hz (Tv T v))
      (hT.comap_subtype.map _) (paired_plus_generation_of_plus_placement_source K L T z v hL hz hLv)
  exact isPGroup_centralizer_of_quotient C hq (hZ.symm ▸ IsPGroup.of_bot)

/-- Source reducedness kills the full centralizer of the centerless pair. -/
theorem paired_plus_centralizer_eq_bot_source [Finite G]
    (K L T : Subgroup G) (z v : G)
    (hL : Tv T v ≤ normalizer (Lv L v : Set G))
    (hz : Tv T v ≤ centralizer ({z} : Set G))
    (hK : K ∈ Yz L T z v)
    (hLv : plusImage K L T z v hL hz (Lv L v) ≤
      plusImage K L T z v hL hz (Kminus K T v))
    (hSylow : Chapter1.IsSylowIn 2 (Tv T v) (Gv v))
    (hZ : center (plusImage K L T z v hL hz (Kminus K T v)) = ⊥) :
    centralizer (plusImage K L T z v hL hz (Kminus K T v) : Set (Gplus K L T z v hL hz)) = ⊥ := by
  let C := plusImage K L T z v hL hz (Kminus K T v)
  let := plusImage_Kminus_normal_source K L T z v hL hz hK
  obtain ⟨S,hS⟩ := hSylow
  have hT : IsPGroup 2 (Tv T v) := hS ▸ S.isPGroup'.map (Gv v).subtype
  have hp := paired_plus_centralizer_isTwoGroup_of_plus_placement_source K L T z v hL hz hK hLv hT hZ
  have hc : centralizer (C : Set _) ≤ pCore 2 (Gplus K L T z v hL hz) :=
    le_sSup ⟨inferInstance,hp⟩
  rw [ComponentElimination.SourceContainment.LinearThree.CentralAction.ModuleAlternatives.plus_twoCore_eq_bot
    K L T z v hK.1.1 hL hz ⟨S,hS⟩] at hc
  exact le_bot_iff.mp hc

end CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentSelection
