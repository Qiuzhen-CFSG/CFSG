module

public import Theory.GroupTheory.ConjugateSpanOrder
public import Theory.GroupTheory.PResidual.Defs
public import Theory.PGroupCore

/-!
# The actual local groups in the A₅ centralizer argument

This module fixes the notation introduced before 13.6.4: the full element
centralizer, its intersection with T, the two-residual of C_L(v), the
conjugate span of z under that residual, and the two-core of C_G(v).
The checked group is literally C_G(v)/⟨v⟩. In particular neither its kernel
nor its underlying group is an unspecified quotient witness.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*, combined
1 March 2004 manuscript, printed p.926, with Notation 12.2.5 on p.796.
-/

namespace CFSG.Quasithin.Chapter13.Section06.CentralizerReduction

open Subgroup
variable {G : Type*} [Group G]

/-- Gᵥ = C_G(v). -/
@[expose] public def Gv (v : G) : Subgroup G := centralizer ({v} : Set G)

/-- Tᵥ = C_T(v), retaining its ambient embedding. -/
@[expose] public def Tv (T : Subgroup G) (v : G) : Subgroup G := T ⊓ Gv v

/-- Mᵥ = C_M(v), with relative rather than ambient centralization. -/
@[expose] public def Mv (M : Subgroup G) (v : G) : Subgroup G := M ⊓ Gv v

/-- Lᵥ uses the two-residual O², not the two-core O₂. -/
@[expose] public def Lv (L : Subgroup G) (v : G) : Subgroup G :=
  (pResidual 2 ↥(L ⊓ Gv v)).map (L ⊓ Gv v).subtype

/-- Vᵥ is the span of the actual Lᵥ-conjugates of z. -/
@[expose] public def Vv (L : Subgroup G) (z v : G) : Subgroup G :=
  conjugateSpanBy (zpowers z) (Lv L v)

/-- Qᵥ is the ambient image of the two-core of Gᵥ. -/
@[expose] public noncomputable def Qv (v : G) : Subgroup G :=
  (pCore 2 (Gv v)).map (Gv v).subtype

/-- The distinguished central element in its own centralizer. -/
@[expose] public def centralElement (v : G) : Gv v :=
  ⟨v, mem_centralizer_singleton_iff.mpr rfl⟩

/-- The actual central subgroup generated by v in Gᵥ. -/
@[expose] public def vLine (v : G) : Subgroup (Gv v) := zpowers (centralElement v)

public theorem vLine_le_center (v : G) : vLine v ≤ center (Gv v) := by
  apply zpowers_le.mpr
  apply mem_center_iff.mpr
  intro x
  apply Subtype.ext
  exact mem_centralizer_singleton_iff.mp x.property

public instance vLine_normal (v : G) : (vLine v).Normal := by
  constructor
  intro x hx g
  have he := mem_center_iff.mp (vLine_le_center v hx) g
  simpa [he, mul_assoc] using hx

/-- The checked quotient used throughout 13.6.6–23. -/
@[expose] public def Gcheck (v : G) := Gv v ⧸ vLine v

public instance (v : G) : Group (Gcheck v) := inferInstanceAs (Group (Gv v ⧸ vLine v))

public theorem Lv_le_Gv (L : Subgroup G) (v : G) : Lv L v ≤ Gv v := by
  rintro x ⟨y, _, rfl⟩
  exact y.property.2

public theorem z_mem_Vv (L : Subgroup G) (z v : G) : z ∈ Vv L z v :=
  le_conjugateSpanBy (zpowers z) (Lv L v) (mem_zpowers z)

public theorem Vv_le_Gv (L : Subgroup G) (z v : G) (hz : z ∈ Gv v) :
    Vv L z v ≤ Gv v :=
  conjugateSpanBy_le (zpowers_le.mpr hz) ((Lv_le_Gv L v).trans (Gv v).le_normalizer)

end CFSG.Quasithin.Chapter13.Section06.CentralizerReduction
