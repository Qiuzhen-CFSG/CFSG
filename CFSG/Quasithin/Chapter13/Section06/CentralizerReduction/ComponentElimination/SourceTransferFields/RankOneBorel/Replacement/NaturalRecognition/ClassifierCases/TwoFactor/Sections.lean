/-!
# Comparing a source summand with the literal component section

Map the moved space [V,C] into the prescribed submodule of V/C_V(D).
Full commutator generation in that submodule makes the map surjective.
Its vanishing C-fixed space identifies the kernel with C_[V,C](C), so
it induces the required action equivalence. This identifies only the
kernels on [V,C], without equating C_V(C) and C_V(D).

For the irreducible model rows, perfectness makes the moved space fully
generated by C; the resulting central quotient therefore certifies Irr⁺.
These comparisons are used by the two-factor rank-one specialization of
B.5.6(3) in the first paragraph of 13.6.18 (Aschbacher–Smith, combined
manuscript of 1 March 2004, printed pp.105 and 931).
-/

public section
open Subgroup Representation Representation.BinaryOffender Theory.GroupTheory Matrix
open scoped MatrixGroups
namespace CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceTransferFields.RankOneBorel.Replacement.NaturalRecognition.ClassifierCases.TwoFactor
open ChapterB.QuasisimpleSource ChapterB.SourceInduction ChapterB.QuasisimpleSource.ExtensionConsequences

variable {D V : Type*} [Group D] [AddCommGroup V] [Module (ZMod 2) V]
    {ρ : Representation (ZMod 2) D V} {C : Subgroup D}

private noncomputable def imageMap (s : MovedSection ρ C) (U : Subrepresentation ρ)
    (hle : s.space.toSubmodule ≤ U.toSubmodule) :
    s.space.toSubmodule →ₗ[ZMod 2] ((fixed ρ).quotientImage U).toSubmodule where
  toFun v := ⟨ρ.invariants.mkQ v, ⟨v, hle v.property, rfl⟩⟩
  map_add' := by intros; rfl
  map_smul' := by intros; rfl

private theorem imageMap_equivariant (s : MovedSection ρ C) (U : Subrepresentation ρ)
    (hle : s.space.toSubmodule ≤ U.toSubmodule) (g : D) (v : s.space.toSubmodule) :
    imageMap s U hle (s.space.toRepresentation g v) =
      ((fixed ρ).quotientImage U).toRepresentation g (imageMap s U hle v) := rfl

private theorem imageMap_surjective (s : MovedSection ρ C) (U : Subrepresentation ρ)
    (hle : s.space.toSubmodule ≤ U.toSubmodule)
    (hfull : moved (((fixed ρ).quotientImage U).toRepresentation.comp C.subtype) ⊤ = ⊤) :
    Function.Surjective (imageMap s U hle) := by
  apply LinearMap.range_eq_top.mp
  apply top_unique
  rw [← hfull]
  apply Submodule.span_le.mpr
  rintro _ ⟨g, _, v, _, rfl⟩
  obtain ⟨w,hw,he⟩ := v.property
  have hv : v = ⟨ρ.invariants.mkQ w, ⟨w,hw,rfl⟩⟩ := Subtype.ext he.symm
  subst v
  refine ⟨⟨ρ g w - w, ?_⟩, ?_⟩
  · rw [s.space_eq]
    exact Submodule.subset_span ⟨g,g.property,w,Submodule.mem_top,rfl⟩
  · rfl

private theorem imageMap_ker (s : MovedSection ρ C) (U : Subrepresentation ρ)
    (hle : s.space.toSubmodule ≤ U.toSubmodule)
    (hfix : Representation.invariants (((fixed ρ).quotientImage U).toRepresentation.comp C.subtype) = ⊥) :
    s.central.toSubmodule = (imageMap s U hle).ker := by
  ext v
  rw [s.central_eq]
  change (∀ g : C, s.space.toRepresentation g v = v) ↔ imageMap s U hle v = 0
  constructor
  · intro hv
    apply (Submodule.mem_bot (ZMod 2)).mp
    rw [← hfix]
    intro g
    exact (imageMap_equivariant s U hle g v).symm.trans
      (congrArg (imageMap s U hle) (hv g))
  · intro hv g
    apply Subtype.ext
    have hx : (v : V) ∈ ρ.invariants :=
      (Submodule.Quotient.mk_eq_zero _).mp (congrArg Subtype.val hv)
    exact hx g

/-- Only the kernel on the moved space is identified with the global fixed
kernel; no equality between the two ambient fixed spaces is needed. -/
noncomputable def sectionImageAction (s : MovedSection ρ C) (U : Subrepresentation ρ)
    (hle : s.space.toSubmodule ≤ U.toSubmodule)
    (hfull : moved (((fixed ρ).quotientImage U).toRepresentation.comp C.subtype) ⊤ = ⊤)
    (hfix : Representation.invariants (((fixed ρ).quotientImage U).toRepresentation.comp C.subtype) = ⊥) :
    ActionEquiv (s.action.comp C.subtype)
      (((fixed ρ).quotientImage U).toRepresentation.comp C.subtype) := by
  let f := imageMap s U hle
  have hk := imageMap_ker s U hle hfix
  let q := s.central.toSubmodule.liftQ f hk.le
  have hq : Function.Bijective q := by
    constructor
    · apply (injective_iff_map_eq_zero _).mpr
      intro v hv
      induction v using Submodule.Quotient.induction_on with
      | _ v => exact (Submodule.Quotient.mk_eq_zero _).mpr (hk.symm ▸ hv)
    · intro v
      obtain ⟨w,rfl⟩ := imageMap_surjective s U hle hfull v
      exact ⟨s.central.toSubmodule.mkQ w,rfl⟩
  refine ⟨MulEquiv.refl C, LinearEquiv.ofBijective q hq, ?_⟩
  intro g v
  induction v using Submodule.Quotient.induction_on with | _ v => rfl

private theorem full_of_irreducible {H W : Type*} [Group H] [AddCommGroup W]
    [Module (ZMod 2) W] (σ : Representation (ZMod 2) H W)
    (hi : σ.IsIrreducible) (hf : σ.invariants = ⊥) : moved σ ⊤ = ⊤ := by
  let := hi
  let S : Subrepresentation σ :=
    ⟨moved σ ⊤, fun g _ hv => (subspaceCommutator_invariant σ ⊤ ⊤ (mem_top g) _).mpr hv⟩
  rcases eq_bot_or_eq_top S with hb | ht
  · have hfix : σ.invariants = ⊤ := by
      apply top_unique
      intro v _ g
      have h : σ g v - v ∈ S := Submodule.subset_span ⟨g,mem_top _,v,Submodule.mem_top,rfl⟩
      rw [hb] at h
      exact sub_eq_zero.mp h
    let := Subrepresentation.irreducible_module_nontrivial σ
    exact (bot_ne_top (hf.symm.trans hfix)).elim
  · exact congrArg Subrepresentation.toSubmodule ht

/-- The quotient comparison transports actual model coordinates. -/
noncomputable def modelSectionAction {H W : Type*} [Group H] [AddCommGroup W]
    [Module (ZMod 2) W] {σ : Representation (ZMod 2) H W}
    (s : MovedSection ρ C) (U : Subrepresentation ρ)
    (hle : s.space.toSubmodule ≤ U.toSubmodule)
    (e : ActionEquiv (((fixed ρ).quotientImage U).toRepresentation.comp C.subtype) σ)
    (hi : σ.IsIrreducible) (hf : σ.invariants = ⊥) :
    ActionEquiv (s.action.comp C.subtype) σ :=
  FactorExtraction.transAction (sectionImageAction s U hle
    (full_of_irreducible _ (irreducible_of_equiv e hi) (invariants_of_equiv e hf))
    (invariants_of_equiv e hf)) e

/-- Perfectness gives full generation, so irreducibility of the literal
central quotient certifies membership of the whole moved space in Irr⁺. -/
theorem section_irrPlus [Group.IsPerfect C] (s : MovedSection ρ C)
    (hi : IsIrreducible (s.action.comp C.subtype)) :
    IsIrrPlus ρ C s.space.toSubmodule := by
  have hs : C ≤ subspaceStabilizer ρ s.space.toSubmodule := by
    apply le_subspaceStabilizer
    intro g hg v hv
    exact s.space.apply_mem_toSubmodule g hv
  refine ⟨hs, ?_, ?_⟩
  · rw [s.space_eq]
    exact ComponentReduction.PreliminaryActions.perfect_seed_idempotent ρ C ⊤
      (le_subspaceStabilizer ρ ⊤ (by simp))
  · have hc : (fixedSpace ρ C).comap s.space.toSubmodule.subtype = s.central.toSubmodule := by
      rw [s.central_eq]
      ext v
      exact ⟨fun h g => Subtype.ext (h g), fun h g => congrArg Subtype.val (h g)⟩
    let e : ActionEquiv (centralQuotientRepresentation ρ C s.space.toSubmodule hs)
        (s.action.comp C.subtype) :=
      ⟨MulEquiv.refl C, Submodule.Quotient.equiv _ _ (LinearEquiv.refl (ZMod 2) _)
        (by simpa using hc), by
          intro g v
          induction v using Submodule.Quotient.induction_on with | _ v => rfl⟩
    exact irreducible_of_equiv e hi
end CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceTransferFields.RankOneBorel.Replacement.NaturalRecognition.ClassifierCases.TwoFactor
