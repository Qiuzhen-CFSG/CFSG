module

public import CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceTransferFields.RankOneBorel.Replacement.NaturalRecognition.ClassifierCases.Quasisimple
public import CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceTransferFields.RankOneBorel.Replacement.NaturalRecognition.ClassifierCases.Groups
public import CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceTransferFields.RankOneBorel.Replacement.NaturalRecognition.ClassifierCases.TwoFactor
public import CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceTransferFields.RankOneBorel.Replacement.NaturalRecognition.ClassifierCases.Hyperplane
public import CFSG.Quasithin.ChapterB.Section05.GeneralClassification.SourceInduction.Product
public import Theory.Representation.BinaryOffender.GeneratedCore
public import CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceContainment.LinearThree.CentralAction.ModuleAlternatives.Action
public import CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceContainment.LinearThree.CentralAction.ModuleAlternatives.Cases

/-!
# Rank-one component cases on the actual offender action

The complete quasisimple branch is proved in Quasisimple, including the
same-field natural action and the splitting of the A₅ moved space. Groups
eliminates the trivial, S₃ and adequate outer A₆–C₃ cases. TwoFactor and
Hyperplane compare the literal product summands with the component's moved
central quotient. Together these prove the exhaustive rank-one component
specialization of the genuine universal adequate classifier. Its quasisimple
alternative already contains the full corrected projective-line B.5.1
conclusion, so no additional quasisimple-classification parameter is needed.

The application is to the literal best-offender subgroup of the faithful
action on W_K, with the literal plusImage component pulled into it. Restriction
supplies offender generation and inherits the two-core and original SQTK cover.
It never assumes that K⁺ is generated by offenders. The remaining applicability
premises have producer `qt-13-06-central-action-applicability`.

Source: Aschbacher–Smith, combined 1 March 2004 manuscript, B.5.1 and B.5.6,
pp.99–105, and the first paragraph of 13.6.18, p.931 (PDF p.948).
-/

@[expose] public section
open Subgroup Representation Representation.BinaryOffender Theory.GroupTheory Matrix
open scoped MatrixGroups IsMulCommutative
namespace CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceTransferFields.RankOneBorel.Replacement.NaturalRecognition.ClassifierCases
open ChapterB.QuasisimpleSource ChapterB.SourceInduction ComponentSelection
open CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceContainment.LinearThree.CentralAction.ModuleAlternatives
universe u w
variable {D : Type u} [Group D] [Finite D]
  {V : Type w} [AddCommGroup V] [Module (ZMod 2) V]
  {𝒦 : GroupClass.{u}} {ρ : Representation (ZMod 2) D V} {C : Subgroup D}

/-- The universal adequate classifier, with the entire quasisimple branch
resolved on the original section and the original field. Only the two literal
product module cases remain. -/
theorem case_or_product [C.Normal] (hyp : FFHypothesis 𝒦 ρ)
    (hc : IsQuasisimple C) (F : BinaryField) (e : C ≃* SL(2,F.Carrier))
    (classification : AdequateClassificationInput.{u,w} 𝒦) :
    RankOneComponentCase ρ C F ∨ Nonempty (SourceTwoFactorCase ρ) ∨
      Nonempty (HyperplaneCase ρ) := by
  let := hyp.finite_module
  rcases source_cases hc F e (classification D V ρ hyp) with h | h
  · obtain ⟨c⟩ := h
    exact Or.inl (quasisimple_case F e c)
  · exact Or.inr h

/-- Exhaustive specialization of B.5.6 to the marked rank-one component.
The natural coordinates use the originally supplied field; the A₅ coordinates
are on the whole moved space and retain Irr⁺. The sole classification input
is the genuine universal adequate implication, with its corrected B.5.1 case. -/
theorem component_case [C.Normal] (hyp : FFHypothesis 𝒦 ρ)
    (hc : IsQuasisimple C) (F : BinaryField) (hF : 1 < F.degree)
    (e : C ≃* SL(2,F.Carrier))
    (classification : AdequateClassificationInput.{u,w} 𝒦) :
    RankOneComponentCase ρ C F := by
  rcases case_or_product hyp hc F e classification with h | h
  · exact h
  · rcases h with h | h
    · obtain ⟨c⟩ := h
      exact TwoFactor.component_case hyp hc F hF e c
    · obtain ⟨c⟩ := h
      exact Hyperplane.component_case hyp hc F hF e c

/-- B.5.3 on the literal offender subgroup, retaining the supplied cover and
its group class. The two-core calculation uses normality of that subgroup. -/
theorem offender_hypothesis (h : ClassifierApplicability 𝒦 ρ C) :
    FFHypothesis 𝒦 (ρ.comp (offenderSubgroup ρ).subtype) := by
  let J := offenderSubgroup ρ
  let : J.Normal := offenderSubgroup_normal ρ
  have hn : ((pCore 2 J).map J.subtype).Normal :=
    ConjAct.normal_of_characteristic_of_normal
  have hl : (pCore 2 J).map J.subtype ≤ pCore 2 D :=
    le_sSup ⟨hn, pCore_isPGroup.map _⟩
  rw [h.twoCore] at hl
  refine ⟨h.finite_module, h.faithful.comp J.subtype_injective,
    ((pCore 2 J).map_eq_bot_iff_of_injective J.subtype_injective).mp
      (le_bot_iff.mp hl), offenderSubgroup_restrict_eq_top ρ, ?_⟩
  obtain ⟨q⟩ := h.quotient
  exact ⟨q.subgroup J⟩

/-- The marked component is pulled into the genuine classifier actor using
its actual inclusion and the original matrix-group isomorphism. -/
theorem offender_case_or_product (h : ClassifierApplicability 𝒦 ρ C)
    (hc : IsQuasisimple C) (F : BinaryField) (e : C ≃* SL(2,F.Carrier))
    (classification : AdequateClassificationInput.{u,w} 𝒦) :
    let σ := ρ.comp (offenderSubgroup ρ).subtype
    RankOneComponentCase σ (C.subgroupOf (offenderSubgroup ρ)) F ∨
      Nonempty (SourceTwoFactorCase σ) ∨ Nonempty (HyperplaneCase σ) := by
  let : C.Normal := h.normal
  let : IsQuasisimple C := hc
  let : (C.subgroupOf (offenderSubgroup ρ)).Normal := Subgroup.normal_subgroupOf
  have hq : IsQuasisimple (C.subgroupOf (offenderSubgroup ρ)) :=
    IsQuasisimple.of_mulEquiv (subgroupOfEquivOfLe h.le_offenders).symm
  exact case_or_product (offender_hypothesis h) hq F
    ((subgroupOfEquivOfLe h.le_offenders).trans e) classification

/-- Apply the exhaustive classifier to the actual offender restriction and
the component pulled into it. Applicability supplies containment in that
subgroup; no offender-generation assumption is imposed on the component. -/
theorem offender_component_case (h : ClassifierApplicability 𝒦 ρ C)
    (hc : IsQuasisimple C) (F : BinaryField) (hF : 1 < F.degree)
    (e : C ≃* SL(2,F.Carrier))
    (classification : AdequateClassificationInput.{u,w} 𝒦) :
    RankOneComponentCase (ρ.comp (offenderSubgroup ρ).subtype)
      (C.subgroupOf (offenderSubgroup ρ)) F := by
  let : C.Normal := h.normal
  let : IsQuasisimple C := hc
  let : (C.subgroupOf (offenderSubgroup ρ)).Normal := Subgroup.normal_subgroupOf
  have hq : IsQuasisimple (C.subgroupOf (offenderSubgroup ρ)) :=
    IsQuasisimple.of_mulEquiv (subgroupOfEquivOfLe h.le_offenders).symm
  exact component_case (offender_hypothesis h) hq F hF
    ((subgroupOfEquivOfLe h.le_offenders).trans e) classification

variable {G : Type u} [Group G] [Finite G]
  (K L T : Subgroup G) (z v : G)
  (hL : Tv T v ≤ normalizer (Lv L v : Set G))
  (hz : Tv T v ≤ centralizer ({z} : Set G))
  [IsElementaryAbelian 2 (WK K L T z v)]

/-- The conditional application for 13.6.18, on precisely W_K and its
literal offender actor. Product-module comparisons remain visible, and the
independent applicability producer retains its original contract. -/
theorem wk_offender_case_or_product
    (h : ClassifierApplicability 𝒦 (wkRepresentation K L T z v hL hz)
      (plusImage K L T z v hL hz K))
    (hc : IsQuasisimple (plusImage K L T z v hL hz K))
    (F : BinaryField) (e : plusImage K L T z v hL hz K ≃* SL(2,F.Carrier))
    (classification : AdequateClassificationInput.{u,u} 𝒦) :
    let σ := wkRepresentation K L T z v hL hz
    let τ := σ.comp (offenderSubgroup σ).subtype
    RankOneComponentCase τ
        ((plusImage K L T z v hL hz K).subgroupOf (offenderSubgroup σ)) F ∨
      Nonempty (SourceTwoFactorCase τ) ∨ Nonempty (HyperplaneCase τ) :=
  offender_case_or_product h hc F e classification

/-- The complete conditional B.5 comparison used in the first paragraph of
13.6.18, on the literal W_K action and pulled-back plusImage component.
Applicability is produced by `qt-13-06-central-action-applicability`; the
parent natural-recognition task retains conversion to the replacement section
and the 13.6.15 exclusion of the A₅ alternative. -/
theorem wk_offender_component_case
    (h : ClassifierApplicability 𝒦 (wkRepresentation K L T z v hL hz)
      (plusImage K L T z v hL hz K))
    (hc : IsQuasisimple (plusImage K L T z v hL hz K))
    (F : BinaryField) (hF : 1 < F.degree)
    (e : plusImage K L T z v hL hz K ≃* SL(2,F.Carrier))
    (classification : AdequateClassificationInput.{u,u} 𝒦) :
    let σ := wkRepresentation K L T z v hL hz
    RankOneComponentCase (σ.comp (offenderSubgroup σ).subtype)
      ((plusImage K L T z v hL hz K).subgroupOf (offenderSubgroup σ)) F :=
  offender_component_case h hc F hF e classification

end CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceTransferFields.RankOneBorel.Replacement.NaturalRecognition.ClassifierCases
end
