/-!
# Marking the rank-one Borel and its residual action

For the invariant component K, take the relative normalizer of K ∩ T_v
inside K T_v. The local-family Sylow witness restricts to K. Its normalizer
maps onto the Sylow normalizer in the actual plus image, and simultaneous
conjugation of the actor and natural-section coordinates marks that image
as the standard upper triangular Borel. No identification with N(K T_v)(T_v)
is used.

Once the E.2.3/Baumann argument places this Borel in C_M(v), the existing
higher-field theorem gives n = 2. The earlier O²(C_M(v)) bound also makes
O²(B) fix every a in C_V(L_v). Two-perfectness keeps the full component
Borel image in this residual. The given checked Sylow centrality then makes
the whole checked Borel fix a modulo the actual line generated by v.

The extension `Placement` constructs the E.2.3 intermediate subgroup and
proves local placement from the genuine universal source implications.
`ResidualProduct` proves O²(B) C_M(V) = Lᵥ C_M(V), and `Assembly` combines
these results on the actual source flag. These results do not assert the
printed equality of full Borel images or fixation of a by all B. The
companion diagnostic records why checked fixation alone cannot be lifted
to the full Sylow-containing B. Final 13.6.18 assembly still needs a valid
block-rigidity argument for the residual or checked fixation proved here.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004,
printed p.931 (PDF p.948), proof of 13.6.18; marked vectors on p.926.
-/

@[expose] public section

open Subgroup Matrix.SpecialLinearGroup
open scoped MatrixGroups Pointwise
open Matrix.SpecialLinearGroup.RankOneResidual
namespace CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceTransferFields.RankOneBorel
namespace BorelGeometry
variable {G : Type*} [Group G]

def borel (K T : Subgroup G) : Subgroup G :=
  (K ⊔ T) ⊓ normalizer ((K ⊓ T : Subgroup G) : Set G)

theorem le_borel (K T : Subgroup G) (h : T ≤ normalizer (K : Set G)) :
    T ≤ borel K T :=
  le_inf le_sup_right ((le_inf h T.le_normalizer).trans inf_normalizer_le_normalizer_inf)

theorem borel_le (K T : Subgroup G) : borel K T ≤ K ⊔ T := inf_le_left

theorem borel_subgroupOf (K T : Subgroup G) :
    (borel K T).subgroupOf K = normalizer (T.subgroupOf K : Set K) := by
  have h : (borel K T).subgroupOf K =
      (normalizer ((K ⊓ T : Subgroup G) : Set G)).subgroupOf K := by
    ext x
    exact and_iff_right (show (x : G) ∈ K ⊔ T from (show K ≤ K ⊔ T from le_sup_left) x.property)
  rw [h, subgroupOf_normalizer_eq inf_le_left]
  congr 1
  ext x
  exact and_iff_right x.property

variable [Finite G]

/-- The actual local-family Sylow restricts to the invariant component. -/
theorem exists_component_sylow (K T : Subgroup G)
    (hSylow : Chapter1.IsSylowIn 2 T (K ⊔ T))
    (hKT : T ≤ normalizer (K : Set G)) :
    ∃ P : Sylow 2 K, (P : Subgroup K) = T.subgroupOf K := by
  let H := K ⊔ T
  have hKH : K ≤ H := le_sup_left
  let N := K.subgroupOf H
  let : N.Normal := normal_subgroupOf_of_le_normalizer (sup_le K.le_normalizer hKT)
  obtain ⟨S, hS⟩ := hSylow
  obtain ⟨P, hP⟩ := S.exists_subgroupOf_eq_of_normal N
  let e := subgroupOfEquivOfLe hKH
  refine ⟨P.mapSurjective (f := e.toMonoidHom) e.surjective, ?_⟩
  apply map_injective K.subtype_injective
  change ((P : Subgroup N).map e.toMonoidHom).map K.subtype = _
  rw [map_map]
  change (P : Subgroup N).map (H.subtype.comp N.subtype) = _
  rw [← map_map, hP, subgroupOf_map_subtype, map_inf _ _ _ H.subtype_injective,
    hS, map_subgroupOf_eq_of_le hKH, subgroupOf_map_subtype]

variable {F : Type*} [Field F] [Finite F] [CharP F 2] [Algebra (ZMod 2) F]
variable {A W : Type*} [Group A] [Finite A] [AddCommGroup W] [Module (ZMod 2) W]

noncomputable def conjugateSection {ρ : Representation (ZMod 2) A W}
    {D : Submodule (ZMod 2) W} (s : NaturalSection (F := F) ρ D) (g : SL(2,F)) :
    NaturalSection (F := F) ρ D where
  actor := s.actor.trans (MulAut.conj g)
  invariant := s.invariant
  coordinates := s.coordinates.trans ((toLin' g).restrictScalars (ZMod 2))
  equivariant a d := by
    change toLin' g (s.coordinates _) = toLin' (g * s.actor a * g⁻¹)
      (toLin' g (s.coordinates _))
    rw [s.equivariant]
    change toLin' g (toLin' (s.actor a) _) = _
    simp only [map_mul, map_inv, LinearEquiv.mul_apply]
    rw [show (toLin' g)⁻¹ = (toLin' g).symm from rfl, LinearEquiv.symm_apply_apply]

omit [Finite A] in
theorem exists_marked_section (K T : Subgroup G) (P : Sylow 2 K)
    (hP : (P : Subgroup K) = T.subgroupOf K)
    (f : K →* A) (hf : Function.Surjective f)
    {ρ : Representation (ZMod 2) A W} {D : Submodule (ZMod 2) W}
    (s : NaturalSection (F := F) ρ D) :
    ∃ s' : NaturalSection (F := F) ρ D,
      (((borel K T).subgroupOf K).map f).map s'.actor.toMonoidHom = rankOneBorel F := by
  let q := s.actor.toMonoidHom.comp f
  have hq : Function.Surjective q := s.actor.surjective.comp hf
  let Pq := P.mapSurjective hq
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq SL(2,F) Pq (upperUnipotentSylow F 2)
  have hU : ((P : Subgroup K).map q).map (MulAut.conj g).toMonoidHom =
      upperUnipotent F := congrArg Sylow.toSubgroup hg
  refine ⟨conjugateSection s g, ?_⟩
  change (((borel K T).subgroupOf K).map f).map
    ((MulAut.conj g).toMonoidHom.comp s.actor.toMonoidHom) = _
  rw [← map_map, Subgroup.map_map _ s.actor.toMonoidHom f, borel_subgroupOf, ← hP]
  change ((normalizer (P : Set K)).map q).map (MulAut.conj g).toMonoidHom = _
  rw [P.normalizer_map_surjective q hq,
    map_normalizer_eq_of_bijective _ (MulAut.conj g).bijective, hU]

/-- Taking the two-residual preserves a two-perfect component image. -/
theorem residual_component_image {D : Type*} [Group D]
    (B K : Subgroup G) (f : K →* D)
    (hperfect : IsPPerfect 2 ((B.subgroupOf K).map f)) :
    (((pResidual 2 B).map B.subtype).subgroupOf K).map f =
      (B.subgroupOf K).map f := by
  let C := B.subgroupOf K
  let r : C →* B := {
    toFun x := ⟨x.val.val, x.property⟩
    map_one' := rfl
    map_mul' _ _ := rfl }
  have hle : (pResidual 2 C).map C.subtype ≤
      ((pResidual 2 B).map B.subtype).subgroupOf K := by
    rintro _ ⟨x, hx, rfl⟩
    exact mem_map.mpr ⟨r x, map_pResidual_le 2 r (mem_map_of_mem r hx), rfl⟩
  apply le_antisymm (map_mono (comap_mono (map_subtype_le _)))
  have hm := map_mono (f := f) hle
  rw [map_embedded_pResidual,
    (pResidual_eq_top_iff 2 _).mpr hperfect, ← MonoidHom.range_eq_map, range_subtype] at hm
  exact hm

omit [Finite G] in
/-- The earlier O²(C_M(v)) bound fixes any element of C_V(L_v),
without a field-size restriction or an equality of full Borel images. -/
theorem residual_centralizes_of_local_source
    (B L M V : Subgroup G) (v a : G) (hBM : B ≤ Mv M v)
    (haV : a ∈ V) (haL : a ∈ centralizer (Lv L v : Set G))
    (hlocal : (pResidual 2 (Mv M v)).map (Mv M v).subtype ≤
      Lv L v ⊔ (M ⊓ centralizer (V : Set G))) :
    (pResidual 2 B).map B.subtype ≤ centralizer ({a} : Set G) := by
  have hm := map_mono (f := (Mv M v).subtype)
    (map_pResidual_le 2 (inclusion hBM))
  rw [map_map, subtype_comp_inclusion] at hm
  apply hm.trans (hlocal.trans (sup_le ?_ ?_))
  · intro l hl
    exact mem_centralizer_singleton_iff.mpr (mem_centralizer_iff.mp haL l hl)
  · exact inf_le_right.trans (centralizer_le (Set.singleton_subset_iff.mpr haV))

omit [Algebra (ZMod 2) F] in
/-- On the same component coordinates, the residual still covers the whole
standard Borel. This is the subgroup to use in the field-four fixation step. -/
theorem residual_borel_image
    (B K : Subgroup G) (f : K →* SL(2,F))
    (hF : 4 ≤ Nat.card F) (hB : (B.subgroupOf K).map f = rankOneBorel F) :
    (((pResidual 2 B).map B.subtype).subgroupOf K).map f = rankOneBorel F := by
  rw [residual_component_image B K f]
  · exact hB
  · rw [hB]
    exact rankOneBorel_isPPerfect hF

/-- B.2.3(4) and 13.6.4--5 convert an invariant intermediate
Baumann carrier into the required placement. Its construction remains a
separate E.2.3 obligation. -/
theorem placement_of_invariant_intermediate
    (K T M V Q : Subgroup G) (v : G)
    (hKG : K ≤ Gv v)
    (h1324 : ChapterB.baumann T ≤ Tv T v)
    (hQ : ChapterB.baumann (Tv T v) ≤ Q) (hQT : Q ≤ Tv T v)
    (hBQ : borel K (Tv T v) ≤ normalizer (Q : Set G))
    (h1325 : normalizer (ChapterB.baumann T : Set G) ≤ M)
    (h1226 : Mv M v ≤ normalizer (V : Set G))
    (hMV : normalizer (V : Set G) ≤ M) :
    borel K (Tv T v) ≤ Mv M v := by
  have he := (baumann_and_thompson_centralizer T v h1324).1
  have hnorm : borel K (Tv T v) ≤ normalizer (ChapterB.baumann T : Set G) := by
    rw [he, ChapterB.lemma_B_2_3_4 (Tv T v) Q hQ hQT]
    exact hBQ.trans (Stellmacher.normalizer_le_normalizer_baumann Q)
  exact (le_inf ((borel_le K (Tv T v)).trans (sup_le hKG inf_le_right)) hnorm).trans
    (baumann_normalizer_control T M V v h1325 h1226 hMV).1

open A5Module

/-- The original Borel centralizes the checked image of a. The residual
fixes a itself; the prescribed Sylow centrality controls the remaining
Sylow factor. No full-Borel centralization is inferred from a quotient. -/
theorem checked_centralizes_of_local_source
    (B L T M V : Subgroup G) (v : G) (a : Gv v)
    (hS : Chapter1.IsSylowIn 2 (Tv T v) B) (hBM : B ≤ Mv M v)
    (haV : (a : G) ∈ V) (haL : (a : G) ∈ centralizer (Lv L v : Set G))
    (haT : checkedQuotientMap v a ∈
      centralizer (checkedImage v (Tv T v) : Set (Gcheck v)))
    (hlocal : (pResidual 2 (Mv M v)).map (Mv M v).subtype ≤
      Lv L v ⊔ (M ⊓ centralizer (V : Set G))) :
    checkedQuotientMap v a ∈ centralizer (checkedImage v B : Set (Gcheck v)) := by
  let R := (pResidual 2 B).map B.subtype
  have hfix : R ≤ centralizer ({(a : G)} : Set G) :=
    residual_centralizes_of_local_source B L M V v a hBM haV haL hlocal
  obtain ⟨P, hP⟩ := hS
  have hgen : R ⊔ Tv T v = B := by
    have hh := congrArg (fun U : Subgroup B => U.map B.subtype)
      (pResidual_sup_sylow_eq_top P)
    simpa only [Subgroup.map_sup, hP, ← MonoidHom.range_eq_map, range_subtype] using hh
  have hRG : R ≤ Gv v := (map_subtype_le _).trans (hBM.trans inf_le_right)
  have hchecked : checkedImage v B = checkedImage v R ⊔ checkedImage v (Tv T v) := by
    rw [← hgen, checkedImage, subgroupOf_sup hRG (show Tv T v ≤ Gv v from inf_le_right), Subgroup.map_sup]
    rfl
  have hle : checkedImage v B ≤ centralizer ({checkedQuotientMap v a} : Set (Gcheck v)) := by
    rw [hchecked]
    apply sup_le
    · rintro _ ⟨r, hr, rfl⟩
      exact mem_centralizer_singleton_iff.mpr (congrArg (checkedQuotientMap v)
        (Subtype.ext (mem_centralizer_singleton_iff.mp (hfix hr))))
    · intro x hx
      exact mem_centralizer_singleton_iff.mpr (mem_centralizer_iff.mp haT x hx)
  intro x hx
  exact mem_centralizer_singleton_iff.mp (hle hx)

open ComponentSelection
open scoped IsMulCommutative

/-- The constructed Borel, in one consistently conjugated natural-section
marking, gives degree two and residual fixation. Only its local placement
still needs the E.2.3/Baumann construction; no degree or fixation premise is
assumed. The marked checked Sylow point is fixed by the whole checked Borel. -/
theorem local_source_conclusions
    (K L T M V : Subgroup G) (z v : G)
    (hL : Tv T v ≤ normalizer (Lv L v : Set G))
    (hz : Tv T v ≤ centralizer ({z} : Set G))
    [IsElementaryAbelian 2 (WK K L T z v)]
    {n : ℕ} (hn : 1 < n) (hF : Nat.card F = 2 ^ n)
    (hK : K ∈ Yz L T z v) (hnorm : Tv T v ≤ normalizer (K : Set G))
    (s : NaturalSection (F := F) (componentRepresentation K L T z v hL hz)
      (movingSpace K L T z v))
    (hBM : borel K (Tv T v) ≤ Mv M v)
    (hBV : Mv M v ≤ normalizer (V : Set G))
    (hLV : Lv L v ≤ normalizer (V : Set G))
    (hcard : Nat.card (conjugationAction V (Lv L v) hLV).range = 3)
    (hzV : z ∈ V) (a : Gv v)
    (haV : (a : G) ∈ V) (haL : (a : G) ∈ centralizer (Lv L v : Set G))
    (haT : checkedQuotientMap v a ∈
      centralizer (checkedImage v (Tv T v) : Set (Gcheck v)))
    (hlocal : (pResidual 2 (Mv M v)).map (Mv M v).subtype ≤
      Lv L v ⊔ (M ⊓ centralizer (V : Set G))) :
    ∃ s' : NaturalSection (F := F) (componentRepresentation K L T z v hL hz)
        (movingSpace K L T z v),
      let B := borel K (Tv T v)
      let R := (pResidual 2 B).map B.subtype
      Tv T v ≤ B ∧ B ≤ K ⊔ Tv T v ∧
      ((B.subgroupOf K).map (componentMap K L T z v hL hz)).map
        s'.actor.toMonoidHom = rankOneBorel F ∧ n = 2 ∧
      R ≤ centralizer ({(a : G)} : Set G) ∧
      ((R.subgroupOf K).map (componentMap K L T z v hL hz)).map
        s'.actor.toMonoidHom = rankOneBorel F ∧
      checkedQuotientMap v a ∈ centralizer (checkedImage v B : Set (Gcheck v)) := by
  obtain ⟨P, hP⟩ := exists_component_sylow K (Tv T v) hK.1.2.2.1 hnorm
  obtain ⟨s', hs'⟩ := exists_marked_section K (Tv T v) P hP
    (componentMap K L T z v hL hz) (componentMap_surjective K L T z v hL hz) s
  have hn2 := degree_le_two_of_local_source K L T M V z v hL hz hF hK hnorm
    s' (borel K (Tv T v)) hBM hBV hLV hcard hzV hlocal hs'
  have hnexact : n = 2 := by omega
  refine ⟨s', le_borel K (Tv T v) hnorm, borel_le K (Tv T v), hs', hnexact,
    residual_centralizes_of_local_source _ L M V v a hBM haV haL hlocal, ?_, ?_⟩
  · rw [map_map] at hs' ⊢
    exact residual_borel_image _ K _ (by rw [hF, hnexact]; decide) hs'
  · exact checked_centralizes_of_local_source _ L T M V v a
      (hK.1.2.2.1.restrict (le_borel K (Tv T v) hnorm) (borel_le K (Tv T v)))
      hBM haV haL haT hlocal

end BorelGeometry
