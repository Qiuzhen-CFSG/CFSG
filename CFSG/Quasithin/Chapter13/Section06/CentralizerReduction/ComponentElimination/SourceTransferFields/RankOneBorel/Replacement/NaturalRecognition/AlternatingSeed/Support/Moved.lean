module

public import CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceTransferFields.RankOneBorel.Replacement.NaturalRecognition.ClassifierCases
public import CFSG.Quasithin.ChapterB.Section05.GeneralClassification.SourceInduction.RankOneConstituent
public import CFSG.Quasithin.ChapterB.Section05.GeneralClassification.SourceInduction.ComponentReduction.ProductGeometry.SymmetricFive
public import Theory.SpecificGroups.SL2.CardFourEquiv

/-!
# The whole moved module of a marked alternating-five constituent

The exhaustive adequate B.5 classification gives either a natural SL₂ central
section or a natural A₅ action on the whole moved space. The original A₅
constituent embeds in that moved space, and the cubic fixed-vector obstruction
excludes the first case. Equal dimensions then identify the original constituent
with the whole moved space. Vanishing of H¹(A₅,I) gives its fixed complement.

The classifier is applied to the literal offender subgroup; the component is
only assumed contained in that subgroup, not generated by offenders itself.
Source: Aschbacher–Smith, 1 March 2004 manuscript, B.5.6 and 13.6.15,
printed pp.105 and930 (PDF pp.122 and947).
-/

@[expose] public section
noncomputable section
open Subgroup Representation Representation.BinaryOffender Theory.GroupTheory
open Representation.OneCohomology
namespace CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceTransferFields.RankOneBorel.Replacement.NaturalRecognition.AlternatingSeed.Support
open ChapterB.QuasisimpleSource ChapterB.SourceInduction
open ChapterB.SourceInduction.ComponentReduction.ProductGeometry
universe u v
variable {D : Type u} [Group D] [Finite D]
    {V : Type v} [AddCommGroup V] [Module (ZMod 2) V]
    {ρ : Representation (ZMod 2) D V} {C : Subgroup D}

private def constituentInclusion (I : Subrepresentation (ρ.comp C.subtype))
    (e : ActionEquiv I.toRepresentation (alternatingNatural 5)) :
    BinaryPermutation.natural (Fin 5) →+ V :=
  I.toSubmodule.subtype.toAddMonoidHom.comp e.linearEquiv.symm.toAddMonoidHom

omit [Finite D] in
private theorem constituentInclusion_equivariant
    (I : Subrepresentation (ρ.comp C.subtype))
    (e : ActionEquiv I.toRepresentation (alternatingNatural 5))
    (a : alternatingGroup (Fin 5)) (w : BinaryPermutation.natural (Fin 5)) :
    constituentInclusion I e (alternatingNatural 5 a w) =
      ρ (e.groupEquiv.symm a) (constituentInclusion I e w) := by
  have he : e.linearEquiv.symm (alternatingNatural 5 a w) =
      I.toRepresentation (e.groupEquiv.symm a) (e.linearEquiv.symm w) := by
    apply e.linearEquiv.injective
    rw [LinearEquiv.apply_symm_apply, e.intertwines,
      e.groupEquiv.apply_symm_apply, e.linearEquiv.apply_symm_apply]
  exact congrArg (fun x : I.toSubmodule => (x : V)) he

omit [Finite D] in
/-- The exhaustive rank-one alternative identifies the same original constituent
with the full moved space; no choice of a replacement constituent is made. -/
theorem eq_moved_of_rankOneCase [Module.Finite (ZMod 2) V]
    (I : Subrepresentation (ρ.comp C.subtype))
    (e : ActionEquiv I.toRepresentation (alternatingNatural 5))
    (F : BinaryField) (h : RankOneComponentCase ρ C F) :
    I.toSubmodule = moved ρ C := by
  have hi : Function.Injective (constituentInclusion I e) :=
    I.toSubmodule.subtype_injective.comp e.linearEquiv.symm.injective
  cases h with
  | natural s a =>
    exact (RankOneConstituent.not_linearTwo_of_alternating_injection s F a
      e.groupEquiv.symm.toMonoidHom e.groupEquiv.symm.injective
      (constituentInclusion I e) hi (constituentInclusion_equivariant I e)).elim
  | alternatingFive s _ a =>
    rw [← s.space_eq]
    apply Submodule.eq_of_le_of_finrank_eq
    · intro w hw
      have hm := RankOneConstituent.alternating_image_le_moved s
        e.groupEquiv.symm.toMonoidHom (constituentInclusion I e)
        (constituentInclusion_equivariant I e) (e.linearEquiv ⟨w, hw⟩)
      change (e.linearEquiv.symm (e.linearEquiv ⟨w, hw⟩) : V) ∈ s.space.toSubmodule at hm
      simpa only [LinearEquiv.symm_apply_apply] using hm
    · exact e.linearEquiv.finrank_eq.trans a.linearEquiv.finrank_eq.symm

private theorem alternating_fixed_zero (w : BinaryPermutation.natural (Fin 5))
    (hw : ∀ a : alternatingGroup (Fin 5), alternatingNatural 5 a w = w) : w = 0 := by
  have hf : Function.Injective (alternatingNatural 5) :=
    (BinaryPermutation.naturalRepresentation_injective (Fin 5) (by decide)).comp
      (alternatingGroup (Fin 5)).subtype_injective
  have hz := invariants_eq_bot_of_faithful_irreducible (alternatingNatural 5) hf
    (BinaryPermutation.alternatingNatural_isIrreducible (Ω := Fin 5) (by decide))
  exact (show w ∈ (⊥ : Submodule (ZMod 2) _) from hz ▸ hw)

/-- H¹(A₅,I)=0 splits the original module once its actual moved space is I. -/
theorem isCompl_of_eq_moved [Module.Finite (ZMod 2) V] [C.Normal]
    (I : Subrepresentation (ρ.comp C.subtype))
    (e : ActionEquiv I.toRepresentation (alternatingNatural 5))
    (hm : I.toSubmodule = moved ρ C) :
    IsCompl I.toSubmodule (fixedSpace ρ C) := by
  let s := MovedSection.ofNormal ρ C
  have hs : s.space.toSubmodule = I.toSubmodule := s.space_eq.trans hm.symm
  let f := LinearEquiv.ofEq s.space.toSubmodule I.toSubmodule hs
  let a : ActionEquiv (s.space.toRepresentation.comp C.subtype) (alternatingNatural 5) :=
    { groupEquiv := e.groupEquiv
      linearEquiv := f.trans e.linearEquiv
      intertwines := by
        intro g w
        exact e.intertwines g (f w) }
  have hh := (H1Congr _ _ a.groupEquiv a.linearEquiv a.intertwines).finrank_eq
  have hb := supplement_quotient_finrank_le s
  have hz : Module.finrank (ZMod 2) (H1 (alternatingNatural 5)) = 0 :=
    BinaryPermutation.alternatingFive_natural_finrank_H1
  rw [hh, hz] at hb
  have hsum : I.toSubmodule ⊔ fixedSpace ρ C = ⊤ := by
    rw [← hs]
    exact Submodule.Quotient.subsingleton_iff.mp
      ((Module.finrank_zero_iff).mp (Nat.eq_zero_of_le_zero hb))
  refine ⟨Submodule.disjoint_def.mpr ?_, codisjoint_iff.mpr hsum⟩
  intro w hw hc
  have hz : e.linearEquiv ⟨w, hw⟩ = 0 := by
    apply alternating_fixed_zero
    intro g
    obtain ⟨c, rfl⟩ := e.groupEquiv.surjective g
    rw [← e.intertwines]
    congr 1
    exact Subtype.ext (hc c)
  exact congrArg Subtype.val (e.linearEquiv.injective
    (hz.trans e.linearEquiv.map_zero.symm))


private def alternatingFiveLinearTwo :
    alternatingGroup (Fin 5) ≃*
      Matrix.SpecialLinearGroup (Fin 2) BinaryField.four.Carrier :=
  (Matrix.ProjectiveSpecialLinearGroup.equiv_alternatingGroup_of_card_four
    (K := BinaryField.four.Carrier) (by
      change Nat.card (GaloisField 2 2) = 4
      rw [GaloisField.card 2 2 (by decide)]
      decide)).some.symm.trans
    ((QuotientGroup.quotientMulEquivOfEq Atlas.RankOneFieldAutomorphisms.sl_center_eq_bot).trans
      QuotientGroup.quotientBot)

open CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceContainment.LinearThree.CentralAction.ModuleAlternatives

/-- The actual B.5.6 application in 13.6.15, with the original constituent,
component inclusion and SQTK cover. The adequate classifier is the genuine
universal earlier-source implication. -/
theorem eq_moved_of_classifier {𝒦 : GroupClass.{u}}
    (h : ClassifierApplicability 𝒦 ρ C) (hc : IsQuasisimple C)
    (I : Subrepresentation (ρ.comp C.subtype))
    (e : ActionEquiv I.toRepresentation (alternatingNatural 5))
    (classification : AdequateClassificationInput.{u,v} 𝒦) :
    I.toSubmodule = moved ρ C := by
  let := h.finite_module
  let J := offenderSubgroup ρ
  let σ := ρ.comp J.subtype
  let C' := C.subgroupOf J
  let f : C' ≃* C := subgroupOfEquivOfLe h.le_offenders
  let I' : Subrepresentation (σ.comp C'.subtype) :=
    { toSubmodule := I.toSubmodule
      apply_mem_toSubmodule g := I.apply_mem_toSubmodule (f g) }
  let e' : ActionEquiv I'.toRepresentation (alternatingNatural 5) :=
    { groupEquiv := f.trans e.groupEquiv
      linearEquiv := e.linearEquiv
      intertwines g w := e.intertwines (f g) w }
  have hm := eq_moved_of_rankOneCase I' e' BinaryField.four
    (ClassifierCases.offender_component_case h hc BinaryField.four (by decide)
      (e.groupEquiv.trans alternatingFiveLinearTwo) classification)
  have he : moved σ C' = moved ρ C := by
    apply le_antisymm
    · apply Submodule.span_le.mpr
      rintro _ ⟨g, hg, w, hw, rfl⟩
      exact Submodule.subset_span ⟨g.val, hg, w, hw, rfl⟩
    · apply Submodule.span_le.mpr
      rintro _ ⟨g, hg, w, hw, rfl⟩
      exact Submodule.subset_span ⟨(⟨g, h.le_offenders hg⟩ : J), hg, w, hw, rfl⟩
  exact hm.trans he

/-- The original alternating-five constituent is the whole moved module and
has the literal fixed-space complement in W. -/
theorem moved_and_isCompl_of_classifier {𝒦 : GroupClass.{u}}
    (h : ClassifierApplicability 𝒦 ρ C) (hc : IsQuasisimple C)
    (I : Subrepresentation (ρ.comp C.subtype))
    (e : ActionEquiv I.toRepresentation (alternatingNatural 5))
    (classification : AdequateClassificationInput.{u,v} 𝒦) :
    I.toSubmodule = moved ρ C ∧ IsCompl I.toSubmodule (fixedSpace ρ C) := by
  let := h.finite_module
  let := h.normal
  have hm := eq_moved_of_classifier h hc I e classification
  exact ⟨hm, isCompl_of_eq_moved I e hm⟩

end CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceTransferFields.RankOneBorel.Replacement.NaturalRecognition.AlternatingSeed.Support
