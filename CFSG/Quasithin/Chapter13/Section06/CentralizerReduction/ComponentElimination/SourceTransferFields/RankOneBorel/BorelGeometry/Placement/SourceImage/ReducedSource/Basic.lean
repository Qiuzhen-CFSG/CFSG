variable {G : Type*} [Group G] [Finite G]

/-- B.2.13 on the actual larger actor: pull its quotient two-core back,
use the Sylow image to fix z, and propagate through the normal preimage. -/
theorem plus_twoCore_eq_bot (K L T : Subgroup G) (z v : G)
    (hL : Tv T v ≤ normalizer (Lv L v : Set G))
    (hz : Tv T v ≤ centralizer ({z} : Set G))
    (hK : K ≤ Gv v)
    (hSylow : Chapter1.IsSylowIn 2 (Tv T v) (Gv v)) :
    pCore 2 (Gplus K L T z v hL hz) = ⊥ := by
  let A := plusActor K L T v
  let f := plusMk K L T z v hL hz
  let N := (pCore 2 (Gplus K L T z v hL hz)).comap f
  let X := N.map A.subtype
  have hn : A ≤ normalizer (X : Set G) := by
    apply (normal_subgroupOf_iff_le_normalizer (map_subtype_le N)).mp
    change ((N.map A.subtype).comap A.subtype).Normal
    rw [comap_map_eq_self_of_injective A.subtype_injective]
    infer_instance
  obtain ⟨P, hP⟩ := hSylow.restrict
    (show Tv T v ≤ A from le_sup_right) (plusActor_le_Gv K L T v hK)
  let Pplus := P.mapSurjective (plusMk_surjective K L T z v hL hz)
  have hcore : pCore 2 (Gplus K L T z v hL hz) ≤ (Pplus : Subgroup _) :=
    pCore_isPGroup.le_sylow_of_normal Pplus
  have hc : X ≤ centralizer ({z} : Set G) := by
    rintro _ ⟨x, hx, rfl⟩
    obtain ⟨t, ht, he⟩ := hcore hx
    have htT : (t : G) ∈ Tv T v := hP ▸ mem_map_of_mem A.subtype ht
    have hez := congrArg (fun a : Gplus K L T z v hL hz =>
      ((plusAction K L T z v hL hz a
        ⟨z, le_conjugateSpanBy _ _ (mem_zpowers z)⟩ : WK K L T z v) : G)) he
    change (t : G) * z * (t : G)⁻¹ = (x : G) * z * (x : G)⁻¹ at hez
    have htfix : (t : G) * z * (t : G)⁻¹ = z := by
      rw [mem_centralizer_singleton_iff.mp (hz htT), mul_inv_cancel_right]
    exact mem_centralizer_singleton_iff.mpr
      (mul_inv_eq_iff_eq_mul.mp (hez.symm.trans htfix))
  have hline : X ≤ centralizer (zpowers z : Set G) := by
    simpa only [zpowers_eq_closure, centralizer_closure] using hc
  have hW : X ≤ centralizer (WK K L T z v : Set G) :=
    le_centralizer_conjugateSpanBy_of_normalizes X (zpowers z)
      (Kminus K T v ⊔ Lv L v) (le_sup_left.trans hn) hline
  apply bot_unique
  intro a ha
  obtain ⟨x, rfl⟩ := plusMk_surjective K L T z v hL hz a
  have hx : x ∈ N := ha
  have hk : x ∈ f.ker := by
    rw [plusMk_ker]
    exact hW (mem_map_of_mem A.subtype hx)
  exact MonoidHom.mem_ker.mp hk

omit [Finite G] in
/-- The local two-core fixes the genuine KTᵥ seed span. This uses its normality
and the Sylow-central seed, without making an assertion about all of W_K. -/
theorem localCore_centralizes_seedSpan (K L T : Subgroup G) (z v : G)
    (hz : Tv T v ≤ centralizer ({z} : Set G))
    (hK : K ∈ Yz L T z v) :
    (pCore 2 (K ⊔ Tv T v : Subgroup G)).map (K ⊔ Tv T v).subtype ≤
      centralizer (conjugateSpanBy (zpowers z) (K ⊔ Tv T v) : Set G) := by
  let H := K ⊔ Tv T v
  let Q := (pCore 2 H).map H.subtype
  have hn : H ≤ normalizer (Q : Set G) := by
    apply (normal_subgroupOf_iff_le_normalizer (map_subtype_le _)).mp
    change (((pCore 2 H).map H.subtype).comap H.subtype).Normal
    rw [comap_map_eq_self_of_injective H.subtype_injective]
    infer_instance
  have hQT : Q ≤ Tv T v := by
    obtain ⟨P, hP⟩ := hK.1.2.2.1
    exact (map_mono (f := H.subtype) (pCore_isPGroup.le_sylow_of_normal P)).trans hP.le
  apply le_centralizer_conjugateSpanBy_of_normalizes Q (zpowers z) H hn
  simpa only [zpowers_eq_closure, centralizer_closure] using hQT.trans hz

private theorem image_twoGroup_trivial {A D : Type*} [Group A] [Group D]
    (f : A →* D) (hf : Function.Surjective f) (hred : pCore 2 D = ⊥)
    (H J Q : Subgroup A) (hgen : H ⊔ J = ⊤)
    (hHQ : H ≤ normalizer (Q : Set A)) (hQ : IsPGroup 2 Q)
    (hcomm : ⁅Q, J⁆ ≤ f.ker) : Q ≤ f.ker := by
  have hHmap : H.map f ≤ normalizer (Q.map f : Set D) :=
    (map_mono hHQ).trans (le_normalizer_map f)
  have hCJ : J.map f ≤ centralizer (Q.map f : Set D) := by
    apply commutator_eq_bot_iff_le_centralizer.mp
    rw [← map_commutator, commutator_comm J Q]
    exact (Subgroup.map_eq_bot_iff ⁅Q, J⁆).mpr hcomm
  have hfull : H.map f ⊔ J.map f = ⊤ := by
    rw [← Subgroup.map_sup, hgen, ← MonoidHom.range_eq_map, MonoidHom.range_eq_top]
    exact hf
  let : (Q.map f).Normal := normalizer_eq_top_iff.mp
    (top_unique (hfull ▸ sup_le hHmap (hCJ.trans (Subgroup.centralizer_le_normalizer _))))
  have hbot : Q.map f = ⊥ := bot_unique
    ((show Q.map f ≤ pCore 2 D from le_sSup ⟨inferInstance, hQ.map f⟩).trans hred.le)
  exact (Subgroup.map_eq_bot_iff Q).mp hbot

/- The two independent action comparisons imply reducedness. The image of
the local two-core becomes normal in the larger reduced quotient. -/
private theorem reduced_of_generation_and_Lv_kernel (K L T : Subgroup G) (z v : G)
    (hL : Tv T v ≤ normalizer (Lv L v : Set G))
    (hz : Tv T v ≤ centralizer ({z} : Set G))
    (hK : K ∈ Yz L T z v) (hnorm : Tv T v ≤ normalizer (K : Set G))
    [IsElementaryAbelian 2 (WK K L T z v)]
    {F : Type*} [Field F] [Finite F] [CharP F 2] [Algebra (ZMod 2) F]
    {n : ℕ} (hF : Nat.card F = 2 ^ n) (hb : ChapterC.IsL2EvenBlock K n)
    (s : Matrix.SpecialLinearGroup.RankOneResidual.NaturalSection (F := F)
      (ComponentElimination.SourceTransferFields.RankOneBorel.componentRepresentation K L T z v hL hz)
      (ComponentElimination.SourceTransferFields.RankOneBorel.movingSpace K L T z v))
    (hSylow : Chapter1.IsSylowIn 2 (Tv T v) (Gv v))
    (hgen : ⁅WK K L T z v, K⁆ ≤ conjugateSpanBy (zpowers z) (K ⊔ Tv T v))
    (hU : Lv L v ≤ normalizer (⁅WK K L T z v, K⁆ : Subgroup G))
    (hfaith : Lv L v ⊓ centralizer (⁅WK K L T z v, K⁆ : Subgroup G) ≤
      centralizer (WK K L T z v : Set G)) :
    pCore 2 (localMap K L T z v hL hz).range = ⊥ := by
  let H := K ⊔ Tv T v
  let A := plusActor K L T v
  let U := ⁅WK K L T z v, K⁆
  let Q := (pCore 2 H).map H.subtype
  have hHQ : H ≤ normalizer (Q : Set G) := by
    apply (normal_subgroupOf_iff_le_normalizer (map_subtype_le _)).mp
    change (((pCore 2 H).map H.subtype).comap H.subtype).Normal
    rw [comap_map_eq_self_of_injective H.subtype_injective]
    infer_instance
  have hQT : Q ≤ Tv T v := by
    obtain ⟨P, hP⟩ := hK.1.2.2.1
    exact (map_mono (f := H.subtype) (pCore_isPGroup.le_sylow_of_normal P)).trans hP.le
  have hQU : Q ≤ centralizer (U : Set G) :=
    (localCore_centralizes_seedSpan K L T z v hz hK).trans (centralizer_le hgen)
  have hUQ : ⁅U, Q⁆ = ⊥ :=
    commutator_eq_bot_iff_le_centralizer.mpr (le_centralizer_iff.mp hQU)
  have hcomm : ⁅Q, Lv L v⁆ ≤ centralizer (WK K L T z v : Set G) := by
    apply (le_inf (le_normalizer_iff_commutator_le_right.mp (hQT.trans hL)) ?_).trans hfaith
    apply commutator_eq_bot_iff_le_centralizer.mp
    apply commutator_commutator_eq_bot_of_rotate
    · exact eq_bot_iff.mpr ((commutator_mono
        (le_normalizer_iff_commutator_le_right.mp hU) le_rfl).trans hUQ.le)
    · rw [hUQ, commutator_bot_left]
  have hHA : H ≤ A := localActor_le K L T v
  have hJA : Lv L v ≤ A := le_sup_right.trans le_sup_left
  have hQA : Q ≤ A := hQT.trans le_sup_right
  have hgenA : H ⊔ Lv L v = A := by
    dsimp [H, A, plusActor]
    rw [Kminus_eq_of_invariant K T v hnorm]
    ac_rfl
  have hgenI : H.subgroupOf A ⊔ (Lv L v).subgroupOf A = ⊤ := by
    rw [← subgroupOf_sup hHA hJA, hgenA, subgroupOf_self]
  have hnormI : H.subgroupOf A ≤ normalizer (Q.subgroupOf A : Set A) := by
    rw [← subgroupOf_normalizer_eq hQA]
    exact comap_mono hHQ
  have hcommI : ⁅Q.subgroupOf A, (Lv L v).subgroupOf A⁆ ≤
      (plusMk K L T z v hL hz).ker := by
    apply commutator_le.mpr
    intro q hq l hl
    rw [plusMk_ker]
    exact hcomm (commutator_mem_commutator hq hl)
  have hker := image_twoGroup_trivial (plusMk K L T z v hL hz)
    (plusMk_surjective K L T z v hL hz)
    (plus_twoCore_eq_bot K L T z v hL hz hK.1.1 hSylow)
    (H.subgroupOf A) ((Lv L v).subgroupOf A) (Q.subgroupOf A)
    hgenI hnormI ((pCore_isPGroup.map H.subtype).comap_subtype) hcommI
  have hcore : pCore 2 H ≤ (localMap K L T z v hL hz).ker := by
    intro x hx
    have hxA : (x : G) ∈ A := hHA x.property
    have hxQ : (⟨(x : G), hxA⟩ : A) ∈ Q.subgroupOf A :=
      mem_map_of_mem H.subtype hx
    have hc := hker hxQ
    rw [plusMk_ker] at hc
    rw [localMap_ker]
    exact hc
  apply pCore_range_eq_bot_of_ker_eq_pCore 2
  exact le_antisymm
    (le_sSup ⟨inferInstance, localMap_kernel_isPGroup K L T z v hL hz hK hnorm hF hb s⟩)
    hcore

omit [Finite G] in
/-- The X_z normalization condition preserves the actual moving subgroup
through the star preimage; no containment Lᵥ ≤ K is used. -/
theorem plusActor_normalizes_moving (K L T : Subgroup G) (z v : G)
    (hL : Tv T v ≤ normalizer (Lv L v : Set G))
    (hz : Tv T v ≤ centralizer ({z} : Set G))
    (hK : K ∈ Yz L T z v) (hnorm : Tv T v ≤ normalizer (K : Set G)) :
    plusActor K L T v ≤ normalizer (⁅WK K L T z v, K⁆ : Subgroup G) := by
  obtain ⟨hX, hUX⟩ := invariant_component_consequences K L T z v hK hnorm
  have hLX : Lv L v ≤ normalizer (starPreimage z v (starImage z v K) : Set G) := by
    apply le_normalizer_iff.mpr
    intro l hl x hx
    obtain ⟨a, ha, rfl⟩ := hx
    let l' : Gv v := ⟨l, Lv_le_Gv L v hl⟩
    have hl' : starMk z v l' ∈ normalizer (starImage z v K : Set _) :=
      (le_sup_left.trans hX.1.1) (mem_map.mpr ⟨l', hl, rfl⟩)
    refine mem_map.mpr ⟨l' * a * l'⁻¹, ?_, rfl⟩
    change starMk z v (l' * a * l'⁻¹) ∈ starImage z v K
    simpa only [map_mul, map_inv] using
      (mem_normalizer_iff.mp hl' (starMk z v a)).mp ha
  have hLU : Lv L v ≤ normalizer (⁅WK K L T z v, K⁆ : Subgroup G) := by
    rw [← hUX]
    intro l hl
    rw [UX, mem_normalizer_iff_map_conj_eq, map_commutator,
      mem_normalizer_iff_map_conj_eq.mp (hLX hl),
      mem_normalizer_iff_map_conj_eq.mp
        ((le_sup_right.trans (le_normalizer_conjugateSpanBy _ _)) hl)]
  have hTU : Tv T v ≤ normalizer (⁅WK K L T z v, K⁆ : Subgroup G) := by
    intro t ht
    rw [mem_normalizer_iff_map_conj_eq, map_commutator,
      mem_normalizer_iff_map_conj_eq.mp (hnorm ht),
      mem_normalizer_iff_map_conj_eq.mp
        ((le_sup_right.trans (plusActor_normalizes_WK K L T z v hL hz)) ht)]
  rw [plusActor, Kminus_eq_of_invariant K T v hnorm]
  exact sup_le (sup_le (normalizer_commutator_ge_right _ _) hLU) hTU

open ComponentElimination.SourceTransferFields.RankOneBorel

/-- The block's intrinsic module is already generated by the K-orbit of z.
Both identifications come from MovingBlock, inside KTᵥ. -/
theorem moving_le_localSeedSpan (K L T : Subgroup G) (z v : G)
    (hL : Tv T v ≤ normalizer (Lv L v : Set G))
    (hz : Tv T v ≤ centralizer ({z} : Set G))
    (hK : K ∈ Yz L T z v) (hnorm : Tv T v ≤ normalizer (K : Set G))
    {n : ℕ} (hb : ChapterC.IsL2EvenBlock K n)
    (hzOmega : z ∈ omegaOneCenterAmbient (Tv T v))
    (hSylow : Chapter1.IsSylowIn 2 (Tv T v) (Gv v))
    (hf : Theory.GroupTheory.generalizedFitting (Gv v) = pCore 2 (Gv v)) :
    ⁅WK K L T z v, K⁆ ≤ conjugateSpanBy (zpowers z) (K ⊔ Tv T v) := by
  have hb' : ChapterC.IsBlock (K.subgroupOf (K ⊔ Tv T v)) := {
    finite := inferInstance
    short := hb.2.1.of_mulEquiv (subgroupOfEquivOfLe (show K ≤ K ⊔ Tv T v from le_sup_left)).symm
    subnormal := hK.1.2.1.subnormal }
  have hW := WK_le_Tv K L T z v hK.1.1 hSylow hzOmega hf
  rw [Replacement.MovingBlock.source_moving_eq_blockU K L T z v hL hz hK hnorm hW hb',
    ← Replacement.MovingBlock.seed_moving_eq_blockU K L T z v hK hnorm hW hb']
  exact (le_normalizer_iff_commutator_le_left.mp
    (le_normalizer_conjugateSpanBy (zpowers z) K)).trans
      (conjugateSpanBy_mono le_rfl le_sup_left)

/-- All reducedness obligations except the precise Lᵥ restriction kernel are
discharged here. In particular this theorem assumes neither local reducedness
nor subnormality of KTᵥ in K₋LᵥTᵥ. The remaining premise has its own producer. -/
theorem local_reduced_of_Lv_kernel (K L T : Subgroup G) (z v : G)
    (hL : Tv T v ≤ normalizer (Lv L v : Set G))
    (hz : Tv T v ≤ centralizer ({z} : Set G))
    (hK : K ∈ Yz L T z v) (hnorm : Tv T v ≤ normalizer (K : Set G))
    [IsElementaryAbelian 2 (WK K L T z v)]
    {F : Type*} [Field F] [Finite F] [CharP F 2] [Algebra (ZMod 2) F]
    {n : ℕ} (hF : Nat.card F = 2 ^ n) (hb : ChapterC.IsL2EvenBlock K n)
    (s : Matrix.SpecialLinearGroup.RankOneResidual.NaturalSection (F := F)
      (componentRepresentation K L T z v hL hz) (movingSpace K L T z v))
    (hzOmega : z ∈ omegaOneCenterAmbient (Tv T v))
    (hSylow : Chapter1.IsSylowIn 2 (Tv T v) (Gv v))
    (hf : Theory.GroupTheory.generalizedFitting (Gv v) = pCore 2 (Gv v))
    (hfaith : Lv L v ⊓ centralizer (⁅WK K L T z v, K⁆ : Subgroup G) ≤
      centralizer (WK K L T z v : Set G)) :
    pCore 2 (localMap K L T z v hL hz).range = ⊥ :=
  reduced_of_generation_and_Lv_kernel K L T z v hL hz hK hnorm hF hb s hSylow
    (moving_le_localSeedSpan K L T z v hL hz hK hnorm hb hzOmega hSylow hf)
    ((le_sup_right.trans le_sup_left).trans
      (plusActor_normalizes_moving K L T z v hL hz hK hnorm)) hfaith

end CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceTransferFields.RankOneBorel.BorelGeometry.Placement.ReducedSource
