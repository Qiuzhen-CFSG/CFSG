module

public import CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceTransferFields.RankOneBorel.BorelGeometry.Placement.SourceImage.Factors.Local
public import Theory.Representation.BinaryPermutation.Faithful
public import Theory.Representation.BinaryPermutationNaturalStructure
public import Theory.Representation.BinaryOffender.ThreeConjugateNormalizer
public import Theory.Representation.BinaryOffender.NormalizerConjugateDimension
public import Mathlib.GroupTheory.SpecificGroups.Alternating.Centralizer

/-!
# Excluding a symmetric factor in the local rank-one decomposition

The S₅ clause of E.2.3 describes the unquotiented factor space Vᵢ. Restrict
its marked actor to A₅. Perfectness places its image in the actual local
two-residual, whose ambient image is K⁺. Transport the factor coordinates
through `internalWKEquiv`; `localRepresentation_component` identifies their
action with the literal component representation on W_K.

The faithful irreducible A₅ natural module is generated by displacements,
so its image lies in U_K = [W_K,K]. It has zero invariants, so its image
still injects after quotienting by C_{U_K}(K). The resulting equivariant
injection contradicts `movingSection_not_alternatingFive`. This distinguishes
the modules even over the field of four elements. Neither the global
Thompson image nor the whole selected factor is assumed equal to K⁺.

This is the conditional symmetric-branch exclusion for the supplied
`Decomposition`; the universal E.2.3 theorem and the final linear-factor
comparison remain with their source owners.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004, E.2.3(3),
printed pp.216–217 / PDF pp.227–228; B.6.9(5)(ii), printed pp.115–116 /
PDF pp.126–127; the rank-one comparison in 13.6.18, printed p.931 / PDF p.948.
-/

@[expose] public section
open Subgroup Stellmacher Matrix Representation Representation.BinaryOffender
open scoped MatrixGroups IsMulCommutative
open Matrix.SpecialLinearGroup.RankOneResidual
namespace CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceTransferFields.RankOneBorel.BorelGeometry.Placement.SourceFactors
open ComponentSelection Replacement.Action

private theorem alternatingFive_residual :
    pResidual 2 (alternatingGroup (Fin 5)) = ⊤ := by
  let : Group.IsPerfect (alternatingGroup (Fin 5)) :=
    ⟨commutator_alternatingGroup_eq_top (by simp)⟩
  apply (pResidual_eq_top_iff 2 _).mpr
  intro N hN hq
  let : N.Normal := hN
  by_contra hne
  let : Nontrivial (alternatingGroup (Fin 5) ⧸ N) := QuotientGroup.nontrivial_iff.mpr hne
  let : Group.IsPerfect (alternatingGroup (Fin 5) ⧸ N) :=
    Group.IsPerfect.ofSurjective (QuotientGroup.mk'_surjective N)
  let : Group.IsNilpotent (alternatingGroup (Fin 5) ⧸ N) := hq.isNilpotent
  exact Group.IsPerfect.not_isSolvable (alternatingGroup (Fin 5) ⧸ N) inferInstance

private theorem alternatingFive_faithful :
    Function.Injective (BinaryPermutation.alternatingNaturalRepresentation (Fin 5)) :=
  (BinaryPermutation.naturalRepresentation_injective (Fin 5) (by simp)).comp
    (alternatingGroup (Fin 5)).subtype_injective

variable {G : Type*} [Group G] [Finite G]
variable (K L T : Subgroup G) (z v : G)
variable (hL : Tv T v ≤ normalizer (Lv L v : Set G))
variable (hz : Tv T v ≤ centralizer ({z} : Set G))
variable (hK : K ∈ Yz L T z v) (hnorm : Tv T v ≤ normalizer (K : Set G))
variable [IsElementaryAbelian 2 (WK K L T z v)]
variable {F : Type*} [Field F] [Finite F] [CharP F 2] [Algebra (ZMod 2) F]
variable {n : ℕ} (hb : ChapterC.IsL2EvenBlock K n)
variable (s : NaturalSection (F := F) (componentRepresentation K L T z v hL hz)
  (movingSpace K L T z v))

private noncomputable def internalModuleMap (hW : WK K L T z v ≤ K ⊔ Tv T v) :
    Additive (internalWK K L T z v hL hz) →ₗ[ZMod 2] Additive (WK K L T z v) :=
  (internalWKEquiv K L T z v hL hz hW).toMonoidHom.toAdditive.toZModLinearMap 2

omit [Finite G] in
private theorem internalModuleMap_injective (hW : WK K L T z v ≤ K ⊔ Tv T v) :
    Function.Injective (internalModuleMap K L T z v hL hz hW) :=
  (internalWKEquiv K L T z v hL hz hW).injective

omit [Finite G] in
private theorem internalModuleMap_intertwines (hW : WK K L T z v ≤ K ⊔ Tv T v)
    (x : (localMap K L T z v hL hz).range)
    (a : plusImage K L T z v hL hz K) (hxa : x.val = a.val)
    (w : Additive (internalWK K L T z v hL hz)) :
    internalModuleMap K L T z v hL hz hW (localRepresentation K L T z v hL hz hW x w) =
      componentRepresentation K L T z v hL hz a
        (internalModuleMap K L T z v hL hz hW w) := by
  obtain ⟨k, rfl⟩ := componentMap_surjective K L T z v hL hz a
  have hx : x = localProjection K L T z v hL hz (inclusion le_sup_left k) :=
    Subtype.ext hxa
  subst x
  exact congrArg Additive.ofMul (localRepresentation_component K L T z v hL hz hW k w)

include hK hnorm hb s

omit [Finite F] in
/-- Every symmetric factor in the actual local E.2.3 decomposition contradicts
its prescribed rank-one moving section, including the field-four case. The
actor and module injections are constructed from the factor's own coordinates. -/
theorem localDecomposition_not_symmetricFactor
    (hW : WK K L T z v ≤ K ⊔ Tv T v)
    (d : Decomposition (localProjection K L T z v hL hz)
      ((Tv T v).subgroupOf (K ⊔ Tv T v))
      (localRepresentation K L T z v hL hz hW))
    (i : Fin d.factors.size)
    (m : SymmetricFactor
      ((localRepresentation K L T z v hL hz hW).comp
        (globalImage (localProjection K L T z v hL hz)).subtype)
      (d.factors.factor i)) : False := by
  let A := (localMap K L T z v hL hz).range
  let Y := globalImage (localProjection K L T z v hL hz)
  let B := d.factors.factor i
  let τ := BinaryPermutation.alternatingNaturalRepresentation (Fin 5)
  let ρ := componentRepresentation K L T z v hL hz
  let D := movingSpace K L T z v
  -- The marked A₅ embeds in the local residual and hence in the actual K⁺.
  let j : alternatingGroup (Fin 5) →* A :=
    Y.subtype.comp (B.subtype.comp (m.actor.symm.toMonoidHom.comp
      (alternatingGroup (Fin 5)).subtype))
  have hj : Function.Injective j := Y.subtype_injective.comp
    (B.subtype_injective.comp (m.actor.symm.injective.comp
      (alternatingGroup (Fin 5)).subtype_injective))
  have hjr (a : alternatingGroup (Fin 5)) : j a ∈ pResidual 2 A := by
    apply map_pResidual_le 2 j
    exact mem_map.mpr ⟨a, alternatingFive_residual ▸ mem_top a, rfl⟩
  let f : alternatingGroup (Fin 5) →* plusImage K L T z v hL hz K :=
    (A.subtype.comp j).codRestrict _ (fun a => by
      rw [← localRange_residual_image K L T z v hL hz hK hnorm hb]
      exact mem_map.mpr ⟨j a, hjr a, rfl⟩)
  have hf : Function.Injective f := by
    intro a b hab
    apply hj
    exact Subtype.ext (congrArg (fun x => x.val) hab)
  -- Carry the unquotiented factor space to W_K, preserving the component action.
  let c := internalModuleMap K L T z v hL hz hW
  let e : BinaryPermutation.natural (Fin 5) →ₗ[ZMod 2] Additive (WK K L T z v) :=
    c.comp ((factorSpace ((localRepresentation K L T z v hL hz hW).comp Y.subtype) B).subtype.comp
      m.coordinates.symm.toLinearMap)
  have he : Function.Injective e := (internalModuleMap_injective K L T z v hL hz hW).comp
    (Subtype.val_injective.comp m.coordinates.symm.injective)
  have hact (a : alternatingGroup (Fin 5)) (w : BinaryPermutation.natural (Fin 5)) :
      e (τ a w) = ρ (f a) (e w) := by
    have hmodel := m.equivariant (m.actor.symm a.val) (m.coordinates.symm w)
    simp only [MulEquiv.apply_symm_apply, LinearEquiv.apply_symm_apply] at hmodel
    have hm := congrArg (fun u => (m.coordinates.symm u).val) hmodel
    simp only [LinearEquiv.symm_apply_apply] at hm
    change c (m.coordinates.symm (τ a w)).val = _
    change _ = (m.coordinates.symm (τ a w)).val at hm
    rw [← hm]
    exact internalModuleMap_intertwines K L T z v hL hz hW (j a) (f a) rfl _
  -- Displacements put this image in U_K; zero invariants make quotienting injective.
  have hspan : subspaceCommutator τ ⊤ ⊤ = ⊤ :=
    subspaceCommutator_top_eq_top_of_faithful_irreducible τ alternatingFive_faithful
      (BinaryPermutation.alternatingNatural_isIrreducible (Ω := Fin 5) (by simp))
  have hfix : τ.invariants = ⊥ :=
    invariants_eq_bot_of_faithful_irreducible τ alternatingFive_faithful
      (BinaryPermutation.alternatingNatural_isIrreducible (Ω := Fin 5) (by simp))
  have heD (w : BinaryPermutation.natural (Fin 5)) : e w ∈ D := by
    have hle : subspaceCommutator τ ⊤ ⊤ ≤ D.comap e := by
      apply Submodule.span_le.mpr
      rintro _ ⟨a, _, w, _, rfl⟩
      change e (τ a w - w) ∈ D
      rw [map_sub, hact]
      exact displacement_mem K L T z v hL hz (f a) (e w)
    apply hle
    rw [hspan]
    exact Submodule.mem_top
  let eD : BinaryPermutation.natural (Fin 5) →ₗ[ZMod 2] D := e.codRestrict D heD
  let q : BinaryPermutation.natural (Fin 5) →ₗ[ZMod 2]
      (D ⧸ ρ.invariants.comap D.subtype) := (ρ.invariants.comap D.subtype).mkQ.comp eD
  have hq : Function.Injective q := by
    apply (LinearMap.ker_eq_bot).mp
    apply LinearMap.ker_eq_bot'.mpr
    intro w hw
    have hwfix : e w ∈ ρ.invariants := by
      change Submodule.Quotient.mk (eD w) = 0 at hw
      exact (Submodule.Quotient.mk_eq_zero (ρ.invariants.comap D.subtype)).mp hw
    have hwτ : w ∈ τ.invariants := by
      intro a
      apply he
      exact (hact a w).trans (hwfix (f a))
    simpa only [hfix, Submodule.mem_bot] using hwτ
  apply movingSection_not_alternatingFive K L T z v hL hz s f hf q hq
  intro a w
  change Submodule.Quotient.mk (eD (τ a w)) =
    Submodule.Quotient.mk (⟨ρ (f a) (eD w), movingSpace_invariant K L T z v hL hz (f a) (eD w)⟩ : D)
  apply congrArg Submodule.Quotient.mk
  exact Subtype.ext (hact a w)

end CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceTransferFields.RankOneBorel.BorelGeometry.Placement.SourceFactors
end
