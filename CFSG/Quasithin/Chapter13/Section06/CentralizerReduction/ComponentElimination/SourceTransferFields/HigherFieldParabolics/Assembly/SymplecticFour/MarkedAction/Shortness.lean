module

public import CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceTransferFields.HigherFieldParabolics.Assembly.SymplecticFour.MarkedAction.Kernel
public import CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceTransferFields.HigherFieldParabolics.LinearThree.MarkedAction.ShortCentralKernel

/-!
# Non-shortness of the moving symplectic parabolic preimages

Both literal plus images have a noncentral two-core generated by local
commutators. Centrality of the intrinsic core-comparison kernel makes the
source two-core surject onto that core. C.1.7 irreducibility then forces the
action-kernel part of the source core to be central if the source is short.

The actual elementary W_K normalizes each preimage because it lies in Tᵥ
and acts trivially on K⁺. Consequently [W_K,R] lies in both the source core
and the action kernel. Perfectness would make R centralize W_K, contradicting
its movement of z. This retains the full W_K action, including all repeated
and extension cases, and needs no triple-commutator witness.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004,
C.1.7, printed p.123, and 13.6.19, printed p.931.
-/

public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceTransferFields.HigherFieldParabolics.Assembly.SymplecticFour.MarkedAction
open ComponentSelection Theory.SpecificGroups.SymplecticFour
open Chapter1.Section02
universe u
variable {G : Type u} [Group G] [Finite G]

private theorem natural_core_data
    {D F : Type*} [Group D] [Finite D] [Field F] [Finite F] [CharP F 2]
    {Q : Subgroup D} [Q.Normal] (d : NaturalExtension (F := F) Q)
    (hF : 2 < Nat.card F) :
    ⁅pCore 2 D, (⊤ : Subgroup D)⁆ = pCore 2 D ∧ ¬ pCore 2 D ≤ center D := by
  rw [d.core_eq hF]
  exact ⟨d.commutator_eq, fun h => (ne_of_lt d.central_lt) (inf_eq_left.mpr h)⟩

private theorem not_short_of_central_coreMap (R W : Subgroup G)
    [Group.IsPerfect R] [IsElementaryAbelian 2 W]
    (hRW : R ≤ normalizer (W : Set G)) (hWR : W ≤ normalizer (R : Set G))
    (hm : ⁅W, R⁆ ≠ ⊥)
    {D : Type*} [Group D] (f : R →* D) (hf : Function.Surjective f)
    (hk : f.ker = (centralizer (W : Set G)).subgroupOf R)
    (hc : pCore 2 R ≤ (pCore 2 D).comap f)
    (hcentral : (QuotientGroup.map (pCore 2 R) (pCore 2 D) f hc).ker ≤
      center (R ⧸ pCore 2 R))
    (hcomm : ⁅pCore 2 D, (⊤ : Subgroup D)⁆ = pCore 2 D)
    (hnoncentral : ¬ pCore 2 D ≤ center D) : ¬ ChapterC.IsShort R := by
  apply LinearThree.MarkedAction.not_short_of_action_image R W hRW hWR hm f hf hk
  have hmap := f.map_pCore_eq_of_central_coreMap hf hc hcentral hcomm
  rw [ChapterC.blockU, map_commutator, hmap, map_top_of_surjective f hf, hcomm]
  exact hnoncentral

/-- Movement implies non-shortness for either fixed published preimage.
Every kernel, elementary-action and ambient placement input is derived from
the earlier source hypotheses; movement alone remains with local geometry. -/
theorem source_flag_residual_not_short
    {κ : GroupClass.{u}} (hG : IsSimpleQTKE κ G)
    (hA36 : ∀ (D : Type u) [Group D] [Finite D], IsSQTK κ D → pCore 2 D = ⊥ →
      ∀ B : Subgroup D, B.IsCComponent → A36Conclusion B)
    {F : Type*} [Field F] [Finite F] [CharP F 2] {m : ℕ}
    (hF : Nat.card F = 2 ^ m) (hm : 1 < m)
    (K L T : Subgroup G) (z v : G) [IsElementaryAbelian 2 (Uv z v)]
    (hv : orderOf v = 2)
    (hL : Tv T v ≤ normalizer (Lv L v : Set G))
    (hz : Tv T v ≤ centralizer ({z} : Set G))
    (hK : K ∈ Yz L T z v) (hn : Tv T v ≤ normalizer (K : Set G))
    (hU : Uv z v ≤ (Gv v).pCoreIn 2)
    (hSyl : Chapter1.IsSylowIn 2 (Tv T v) (Gv v))
    (hW : WK K L T z v ∈ Chapter6.Source.reducedFamily (plusActor K L T v))
    (e : plusImage K L T z v hL hz K ≃* Sp F)
    (P : Subgroup G)
    (hP : P ∈ ({pointPreimage K L T z v hL hz e,
      planePreimage K L T z v hL hz e} : Set (Subgroup G)))
    (hmove : ¬ residualIn P ≤ centralizer ({z} : Set G)) :
    ¬ ChapterC.IsShort (residualIn P) := by
  let : IsElementaryAbelian 2 (WK K L T z v) :=
    IsElementaryAbelian.of_le (WK_le_Uv K L T z v hK.1.1)
  have hWT := LinearThree.MarkedAction.WK_le_Tv_of_ambient_core K L T z v hK.1.1 hU hSyl
  have hPK : P ≤ K := by
    rcases hP with hP | hP
    · subst P
      exact pointPreimage_le K L T z v hL hz e
    · have he : P = planePreimage K L T z v hL hz e := Set.mem_singleton_iff.mp hP
      subst P
      exact planePreimage_le K L T z v hL hz e
  let R := residualIn P
  have hRK : R ≤ K := (map_subtype_le _).trans hPK
  let : Group.IsPerfect R := Group.IsPerfect.map P.subtype
  have hWR : WK K L T z v ≤ normalizer (R : Set G) := by
    apply LinearThree.residualIn_normalized _ P
    rcases hP with hP | hP
    · subst P
      exact LinearThree.MarkedAction.WK_normalizes_preimage K L T z v hL hz hWT hn e _
    · have he : P = planePreimage K L T z v hL hz e := Set.mem_singleton_iff.mp hP
      subst P
      exact LinearThree.MarkedAction.WK_normalizes_preimage K L T z v hL hz hWT hn e _
  have hcomm : ⁅WK K L T z v, R⁆ ≠ ⊥ := by
    intro he
    apply hmove
    exact (commutator_eq_bot_iff_le_centralizer.mp
      ((commutator_comm R (WK K L T z v)).trans he)).trans
        (centralizer_le (Set.singleton_subset_iff.mpr
          (le_conjugateSpanBy _ _ (mem_zpowers z))))
  have hlarge : 2 < Nat.card F := by
    rw [hF]
    exact (show 2 = (2 : ℕ) ^ 1 by decide).trans_lt
      (Nat.pow_lt_pow_right (by decide) hm)
  have hlocal : ⁅pCore 2 (plusImage K L T z v hL hz R), ⊤⁆ =
      pCore 2 (plusImage K L T z v hL hz R) ∧
        ¬ pCore 2 (plusImage K L T z v hL hz R) ≤
          center (plusImage K L T z v hL hz R) := by
    rcases hP with hP | hP
    · subst P
      exact natural_core_data ((pointNaturalExtension hF hm).comap
        (pointPlusEquiv K L T z v hL hz e hF hm)) hlarge
    · have he : P = planePreimage K L T z v hL hz e := Set.mem_singleton_iff.mp hP
      subst P
      exact natural_core_data ((planeNaturalExtension hF hm).comap
        (planePlusEquiv K L T z v hL hz e hF hm)) hlarge
  exact not_short_of_central_coreMap R (WK K L T z v)
    (hRK.trans ((K_le_plusActor K L T v).trans
      (plusActor_normalizes_WK K L T z v hL hz))) hWR hcomm
    (LinearThree.LocalStructure.subgroupPlusMap K L T R z v hL hz hRK)
    (LinearThree.LocalStructure.subgroupPlusMap_surjective K L T R z v hL hz hRK)
    (LinearThree.LocalStructure.subgroupPlusMap_ker K L T R z v hL hz hRK)
    (LinearThree.LocalStructure.subgroupPlusMap_core_le K L T R z v hL hz hRK)
    (source_coreComparison_ker_le_center K L T z v hL hz hG hA36 hv hK hW e R hRK)
    hlocal.1 hlocal.2

/-- The source non-block conclusion on the same literal preimages, with the
full known-simple catalogue. A block is short by its C.1 definition. -/
theorem source_flag_residual_not_block
    (hG : IsSimpleQTKE CFSG.KnownSimple.IsKnownSimple G)
    (hA36 : ∀ (D : Type u) [Group D] [Finite D],
      IsSQTK CFSG.KnownSimple.IsKnownSimple D → pCore 2 D = ⊥ →
        ∀ B : Subgroup D, B.IsCComponent → A36Conclusion B)
    {F : Type*} [Field F] [Finite F] [CharP F 2] {m : ℕ}
    (hF : Nat.card F = 2 ^ m) (hm : 1 < m)
    (K L T : Subgroup G) (z v : G) [IsElementaryAbelian 2 (Uv z v)]
    (hv : orderOf v = 2)
    (hL : Tv T v ≤ normalizer (Lv L v : Set G))
    (hz : Tv T v ≤ centralizer ({z} : Set G))
    (hK : K ∈ Yz L T z v) (hn : Tv T v ≤ normalizer (K : Set G))
    (hU : Uv z v ≤ (Gv v).pCoreIn 2)
    (hSyl : Chapter1.IsSylowIn 2 (Tv T v) (Gv v))
    (hW : WK K L T z v ∈ Chapter6.Source.reducedFamily (plusActor K L T v))
    (e : plusImage K L T z v hL hz K ≃* Sp F)
    (P : Subgroup G)
    (hP : P ∈ ({pointPreimage K L T z v hL hz e,
      planePreimage K L T z v hL hz e} : Set (Subgroup G)))
    (hmove : ¬ residualIn P ≤ centralizer ({z} : Set G)) :
    ¬ ChapterC.IsBlock (residualIn P) :=
  fun h => source_flag_residual_not_short hG hA36 hF hm K L T z v hv hL hz
    hK hn hU hSyl hW e P hP hmove h.short

end CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceTransferFields.HigherFieldParabolics.Assembly.SymplecticFour.MarkedAction
