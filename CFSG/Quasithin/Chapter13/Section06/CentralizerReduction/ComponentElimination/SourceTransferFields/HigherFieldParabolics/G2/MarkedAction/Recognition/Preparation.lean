module

public import CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceTransferFields.HigherFieldParabolics.G2.MarkedAction
public import CFSG.Quasithin.ChapterB.Section05.GeneralClassification.SourceInduction.Statement
public import Theory.Representation.BinaryOffender.GeneratedCore

/-!
# The actual offender actor for higher-field G₂ recognition

Restrict the faithful action on W_K to its best-offender subgroup. Normality
transfers the R₂ two-core condition, and the inverse image under the plus map
supplies a genuine finite SQTK cover. Thus the full adequate B.5.6 implication
applies without asserting that the whole plus actor is offender-generated.

The commutator condition in Y_z is transported through the literal star-to-plus
map. Once the Thompson image is placed in the offender actor, this puts K⁺ in
that actor. No classification alternative or natural-module marking is selected
here; the remaining comparison must retain the actual component and quotient.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004, the paragraph
preceding 13.6.14, printed p.929, and B.5.3–B.5.6, pp.104–105.
-/

@[expose] public noncomputable section
open Subgroup Representation Representation.BinaryOffender
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceTransferFields.HigherFieldParabolics.G2.MarkedAction.Recognition
open ComponentSelection ChapterB.SourceInduction
universe u
variable {G : Type u} [Group G]
variable (K L T : Subgroup G) (z v : G)
    (hL : Tv T v ≤ normalizer (Lv L v : Set G))
    (hz : Tv T v ≤ centralizer ({z} : Set G))
variable [IsElementaryAbelian 2 (WK K L T z v)]

/-- The subgroup generated by all best offenders on the literal W_K. -/
def offenderActor : Subgroup (Gplus K L T z v hL hz) :=
  offenderSubgroup (representation K L T z v hL hz)

instance offenderActor_normal : (offenderActor K L T z v hL hz).Normal :=
  offenderSubgroup_normal _

/-- Restriction changes the actor, not the module or its original action. -/
def offenderRepresentation :=
  (representation K L T z v hL hz).comp (offenderActor K L T z v hL hz).subtype

theorem offenderRepresentation_injective :
    Function.Injective (offenderRepresentation K L T z v hL hz) :=
  (representation_injective K L T z v hL hz).comp
    (offenderActor K L T z v hL hz).subtype_injective

theorem offenderRepresentation_generated :
    offenderSubgroup (offenderRepresentation K L T z v hL hz) = ⊤ :=
  offenderSubgroup_restrict_eq_top _

theorem offenderActor_twoCore [Finite G]
    (hR : pCore 2 (Gplus K L T z v hL hz) = ⊥) :
    pCore 2 (offenderActor K L T z v hL hz) = ⊥ := by
  rw [pCore_subnormal_eq_comap 2
    (inferInstance : (offenderActor K L T z v hL hz).Normal).isSubnormal, hR]
  exact (MonoidHom.ker_eq_bot_iff _).mpr
    (offenderActor K L T z v hL hz).subtype_injective

/-- The covering group is a subgroup of the original actor, before quotienting. -/
def offenderCover [Finite G] {𝒦 : GroupClass.{u}}
    (hSQ : IsSQTK 𝒦 (plusActor K L T v)) :
    SQTKQuotient 𝒦 (offenderActor K L T z v hL hz) where
  Cover := (offenderActor K L T z v hL hz).comap (plusMk K L T z v hL hz)
  kernel := ((plusMk K L T z v hL hz).subgroupComap
    (offenderActor K L T z v hL hz)).ker
  sqtk := hSQ.subgroup _
  equiv := QuotientGroup.quotientKerEquivOfSurjective _
    ((plusMk K L T z v hL hz).subgroupComap_surjective_of_surjective _
      (QuotientGroup.mk'_surjective _))

/-- All B.5.3 hypotheses are proved for the appropriate restricted actor. -/
theorem offenderHypothesis [Finite G] {𝒦 : GroupClass.{u}}
    (hSQ : IsSQTK 𝒦 (plusActor K L T v))
    (hR : pCore 2 (Gplus K L T z v hL hz) = ⊥) :
    FFHypothesis 𝒦 (offenderRepresentation K L T z v hL hz) where
  finite_module := Module.Finite.of_finite
  faithful := offenderRepresentation_injective K L T z v hL hz
  twoCore := offenderActor_twoCore K L T z v hL hz hR
  generated := offenderRepresentation_generated K L T z v hL hz
  quotient := ⟨offenderCover K L T z v hL hz hSQ⟩

/-- The full B.5.6 alternatives, including the potentially trivial actor. -/
theorem classify_offenderActor [Finite G] {𝒦 : GroupClass.{u}}
    (classification : AdequateClassificationInput.{u,u} 𝒦)
    (hSQ : IsSQTK 𝒦 (plusActor K L T v))
    (hR : pCore 2 (Gplus K L T z v hL hz) = ⊥) :
    AdequateAlternative (offenderRepresentation K L T z v hL hz) :=
  classification _ _ _ (offenderHypothesis K L T z v hL hz hSQ hR)

omit [IsElementaryAbelian 2 (WK K L T z v)] in
/-- The source commutator equality survives both literal action quotients. -/
theorem component_thompson_commutator (hK : K ∈ Yz L T z v)
    (hn : Tv T v ≤ normalizer (K : Set G)) :
    ⁅plusImage K L T z v hL hz K,
      plusImage K L T z v hL hz (Stellmacher.elementaryAbelianMaxJ (Tv T v))⁆ =
        plusImage K L T z v hL hz K := by
  let A := starImage z v (plusActor K L T v)
  let C := starImage z v K
  let J := starImage z v (Stellmacher.elementaryAbelianMaxJ (Tv T v))
  have hCA : C ≤ A := map_mono (comap_mono (K_le_plusActor K L T v))
  have hJA : J ≤ A := map_mono (comap_mono
    ((show Stellmacher.elementaryAbelianMaxJ (Tv T v) ≤ Tv T v from
      sSup_le fun _ h => h.1).trans le_sup_right))
  have hc : ⁅C, J⁆ = C := (invariant_component_consequences K L T z v hK hn).1.1.2.2.2
  have hci : ⁅C.subgroupOf A, J.subgroupOf A⁆ = C.subgroupOf A := by
    apply map_injective A.subtype_injective
    rw [map_commutator, map_subgroupOf_eq_of_le hCA,
      map_subgroupOf_eq_of_le hJA, hc]
  have hh := congrArg (fun B => B.map (starToPlus K L T z v hK.1.1 hL hz)) hci
  rw [map_commutator, starToPlus_image K L T z v hK.1.1 hL hz K
    (K_le_plusActor K L T v), starToPlus_image K L T z v hK.1.1 hL hz
    (Stellmacher.elementaryAbelianMaxJ (Tv T v))
    ((show Stellmacher.elementaryAbelianMaxJ (Tv T v) ≤ Tv T v from
      sSup_le fun _ h => h.1).trans le_sup_right)] at hh
  exact hh

/-- Normality and the source commutator place the component in the offender actor. -/
theorem component_le_offenderActor (hK : K ∈ Yz L T z v)
    (hn : Tv T v ≤ normalizer (K : Set G))
    (hJ : plusImage K L T z v hL hz (Stellmacher.elementaryAbelianMaxJ (Tv T v)) ≤
      offenderActor K L T z v hL hz) :
    plusImage K L T z v hL hz K ≤ offenderActor K L T z v hL hz := by
  rw [← component_thompson_commutator K L T z v hL hz hK hn]
  exact (commutator_mono le_top hJ).trans (commutator_le_right _ _)

end CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceTransferFields.HigherFieldParabolics.G2.MarkedAction.Recognition
