module

public import Theory.Representation.PSL3Two.DoubledParabolic
public import CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentSelection.Notation

/-!
# The genuine doubled-natural action obstruction

An actual subgroup U is identified with two natural binary three-spaces.
The marked parabolic acts by conjugation on U and maps onto the concrete
line parabolic of SL₃(2), compatibly with that identification. It cannot
normalize a subgroup whose image is generated by one point in each summand.
This follows from the explicit cubic calculation in `DoubledParabolic`.

In Lemma 13.6.20 the subgroup is `[V,Lᵥ]`. The parabolic preserves each
natural summand and acts irreducibly on a binary plane in each summand;
the assertion is not normalization of a set union. The source assembly
must still construct this marking and prove its equivariance and the
split-point description from the earlier module and Thompson results.
No assertion that Lᵥ ≤ K is made in this file.

Source: Aschbacher–Smith, combined 1 March 2004 manuscript, printed p.931.
-/

@[expose] public section
namespace CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.Source
open Subgroup Representation BinaryLinearThree BinaryLinearThree.DoubledParabolic
open ComponentSelection

/-- Conjugation on the marked doubled-natural module prevents normalization
of the subgroup generated by the two marked points. The model map is an
actual group isomorphism; the actor map is an actual surjection. -/
theorem not_normalizes_splitPlane
    {G : Type*} [_root_.Group G] (P U Q : Subgroup G)
    (hPU : P ≤ normalizer (U : Set G))
    (π : P →* Matrix.PSL3Two.lineParabolicSL) (hπ : Function.Surjective π)
    (e : U ≃* Multiplicative (Vector × Vector))
    (he : ∀ p : P, ∀ u : U,
      e (conjugationAction U P hPU p u) = Multiplicative.ofAdd
        ((W.prod W) (π p : Group) (Multiplicative.toAdd (e u))))
    (x y : Vector) (hx : x 2 = 0) (hn : x ≠ 0)
    (hQ : (Q.subgroupOf U).map e.toMonoidHom =
      (splitPlane x y).toAddSubgroup.toSubgroup) :
    ¬ P ≤ normalizer (Q : Set G) := by
  intro hPQ
  apply splitPlane_not_invariant x y hx hn
  intro g hg w hw
  obtain ⟨p, hp⟩ := hπ ⟨g, hg⟩
  let u : U := e.symm (Multiplicative.ofAdd w)
  have hu : e u ∈ (Q.subgroupOf U).map e.toMonoidHom := by
    rw [hQ]
    change Multiplicative.toAdd (e u) ∈ splitPlane x y
    simpa [u] using hw
  obtain ⟨q, hq, heq⟩ := hu
  have hqu : q = u := e.injective heq
  have huQ : (u : G) ∈ Q := hqu ▸ hq
  have hc : conjugationAction U P hPU p u ∈ Q.subgroupOf U :=
    (mem_normalizer_iff.mp (hPQ p.property) (u : G)).mp huQ
  have hm : e (conjugationAction U P hPU p u) ∈
      (splitPlane x y).toAddSubgroup.toSubgroup := by
    rw [← hQ]
    exact mem_map.mpr ⟨_, hc, rfl⟩
  rw [he] at hm
  change (W.prod W) (π p : Group) (Multiplicative.toAdd (e u)) ∈ splitPlane x y at hm
  simpa [u, hp] using hm

/-- Application to the literal `[V,Lᵥ]` in 13.6.20. The group P is the
source parabolic preimage acting on the actual subgroup U_K. -/
theorem doubled_natural_commutator_contradiction
    {G : Type*} [_root_.Group G] (L V P U : Subgroup G) (v : G)
    (hPU : P ≤ normalizer (U : Set G))
    (π : P →* Matrix.PSL3Two.lineParabolicSL) (hπ : Function.Surjective π)
    (e : U ≃* Multiplicative (Vector × Vector))
    (he : ∀ p : P, ∀ u : U,
      e (conjugationAction U P hPU p u) = Multiplicative.ofAdd
        ((W.prod W) (π p : Group) (Multiplicative.toAdd (e u))))
    (x y : Vector) (hx : x 2 = 0) (hn : x ≠ 0)
    (hQ : ((⁅V, Lv L v⁆ : Subgroup G).subgroupOf U).map e.toMonoidHom =
      (splitPlane x y).toAddSubgroup.toSubgroup)
    (hPV : P ≤ normalizer (V : Set G))
    (hPL : P ≤ normalizer (Lv L v : Set G)) : False := by
  apply not_normalizes_splitPlane P U ⁅V, Lv L v⁆ hPU π hπ e he x y hx hn hQ
  intro p hp
  rw [mem_normalizer_iff_map_conj_eq, map_commutator,
    mem_normalizer_iff_map_conj_eq.mp (hPV hp),
    mem_normalizer_iff_map_conj_eq.mp (hPL hp)]

end CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.Source
