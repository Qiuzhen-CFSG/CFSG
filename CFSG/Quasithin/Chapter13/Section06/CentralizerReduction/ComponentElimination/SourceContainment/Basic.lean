module

public import CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentSelection.ComponentModules
public import CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentSelection.FFSelection.SeedCommutator
public import CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceNormalizer
public import Theory.GroupTheory.PResidual.PrimeOrderGeneration
public import Theory.GroupTheory.PResidual.PerfectCover

/-!
# Action reductions for the containment argument

The module carrier in 13.6.20 is U_K = [W_K,K]. The actual earlier
13.6.11 and T_v-invariance from 13.6.14 show that L_v moves this carrier.
The star-to-plus map also carries a hypothetical action of K* on L_v*
to an action of K+ on L_v+. Since L_v is solvable and K+ is a component,
that action would centralize L_v+. Consequently a nonzero plus commutator
gives the star obstruction and, using relative normality in M_v, K ⊄ M.

These are reductions, not a proof of 13.6.20 or 13.6.21. The rank-two
A.3.18 exclusions, the construction of the doubled-natural configuration,
the noncentral projection and its lift still have to supply containment
and the required noncentral action. In particular no noncentrality or
containment input below is asserted to follow from a model name alone.

Source: Aschbacher–Smith, combined 1 March 2004 manuscript,
13.6.11 and 13.6.14, printed pp.928–930; 13.6.20–21, pp.931–932.
-/

@[expose] public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceContainment
open ComponentSelection

variable {G : Type*} [Group G]

/-- The local residual is generated by its actual elements of order three.
Only its definition as O²(C_L(v)) and the earlier cubic quotient are used. -/
theorem Lv_eq_cubic_closure [Finite G] (L : Subgroup G) (v : G)
    (hcard : Nat.card (Lv L v ⧸ pCore 2 (Lv L v)) = 3) :
    Lv L v = closure {x : G | x ∈ Lv L v ∧ orderOf x = 3} := by
  let : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hg : closure {x : Lv L v | orderOf x = 3} = ⊤ :=
    closure_prime_order_eq_top_of_isPPerfect
    (isPPerfect_embedded_pResidual 2 (L ⊓ Gv v)) (by decide : Nat.Coprime 2 3) hcard
  have hm := congrArg (map (Lv L v).subtype) hg
  rw [MonoidHom.map_closure, ← MonoidHom.range_eq_map, range_subtype] at hm
  have he : (Lv L v).subtype '' {x : Lv L v | orderOf x = 3} =
      {x : G | x ∈ Lv L v ∧ orderOf x = 3} := by
    ext x
    constructor
    · rintro ⟨y, hy, rfl⟩
      exact ⟨y.property, ((Lv L v).orderOf_coe y).trans hy⟩
    · rintro ⟨hx, ho⟩
      exact ⟨⟨x, hx⟩, ((Lv L v).orderOf_coe ⟨x, hx⟩).symm.trans ho, rfl⟩
  rw [he] at hm
  exact hm.symm

/-- The first containment L_v ≤ θ(KL_v) in the rank-two branch. The
A.3.18 case analysis still has to prove that this θ subgroup is K. -/
theorem Lv_le_cubic_closure_sup [Finite G] (K L : Subgroup G) (v : G)
    (hcard : Nat.card (Lv L v ⧸ pCore 2 (Lv L v)) = 3) :
    Lv L v ≤ closure {x : G | x ∈ K ⊔ Lv L v ∧ orderOf x = 3} := by
  apply (Lv_eq_cubic_closure L v hcard).le.trans
  apply Subgroup.closure_mono
  exact fun _ hx => ⟨(show Lv L v ≤ K ⊔ Lv L v from le_sup_right) hx.1, hx.2⟩

/-- The actual module subgroup, kept separate from the acting component. -/
def UK (K L T : Subgroup G) (z v : G) : Subgroup G := ⁅WK K L T z v, K⁆

/-- Apply both genuine earlier results to the literal U_K. In particular the
nonvanishing assertion is proved, not part of a doubled-module record. -/
theorem UK_commutator_ne_bot [Finite G] {L V : Subgroup G}
    (s : A5Module.Marking L V) (K T : Subgroup G)
    [IsElementaryAbelian 2 (Uv (A5Module.markedZ s) (A5Module.markedV s))]
    (S : Sylow 2 (Gv (A5Module.markedV s)))
    (hS : (S : Subgroup (Gv (A5Module.markedV s))).map
      (Gv (A5Module.markedV s)).subtype = Tv T (A5Module.markedV s))
    (hz : Tv T (A5Module.markedV s) ≤ centralizer ({A5Module.markedZ s} : Set G))
    (hK : K ∈ Yz L T (A5Module.markedZ s) (A5Module.markedV s))
    (hn : Tv T (A5Module.markedV s) ≤ normalizer (K : Set G)) :
    ⁅UK K L T (A5Module.markedZ s) (A5Module.markedV s),
      Lv L (A5Module.markedV s)⁆ ≠ ⊥ := by
  obtain ⟨hX, hU⟩ := invariant_component_consequences K L T _ _ hK hn
  have h := (marked_Xz_commutators_ne_bot s T S hS hz hX).2
  rwa [hU] at h

private theorem component_commutes_of_normalizes_solvable
    {H : Type*} [Group H] (C D : Subgroup H)
    (hC : IsComponent H C) [Group.IsSolvable D]
    (hn : C ≤ normalizer (D : Set H)) : ⁅C, D⁆ = ⊥ := by
  let X := C ⊔ D
  let : (D.subgroupOf X).Normal :=
    (normal_subgroupOf_iff_le_normalizer (show D ≤ X from le_sup_right)).mpr
      (sup_le hn D.le_normalizer)
  rcases (hC.subgroupOf (show C ≤ X from le_sup_left)).normal_dichotomy
      (D.subgroupOf X) with hle | hc
  · have hCD : C ≤ D := fun x hx => hle (show (⟨x, (show C ≤ X from le_sup_left) hx⟩ : X) ∈
        C.subgroupOf X from hx)
    let := hC.2
    let : IsSimpleGroup (C ⧸ center C) := IsQuasisimple.simple
    let : Nontrivial C :=
      Function.Surjective.nontrivial (QuotientGroup.mk'_surjective (center C))
    exact (Group.IsPerfect.not_isSolvable C
      (Group.isSolvable_of_isSolvable_injective (inclusion_injective hCD))).elim
  · have hm := congrArg (map X.subtype) hc
    simpa only [map_commutator, map_subgroupOf_eq_of_le (show C ≤ X from le_sup_left),
      map_subgroupOf_eq_of_le (show D ≤ X from le_sup_right), Subgroup.map_bot] using hm

/-- This uses the literal surjection, including its restriction to the same
ambient star actor on both sides. No abstract quotient identification is used. -/
theorem plus_normalizes_of_star_normalizes (K L T : Subgroup G) (z v : G)
    (hK : K ≤ Gv v) (hL : Tv T v ≤ normalizer (Lv L v : Set G))
    (hz : Tv T v ≤ centralizer ({z} : Set G))
    (hn : starImage z v K ≤ normalizer (starImage z v (Lv L v) : Set (Gstar z v))) :
    plusImage K L T z v hL hz K ≤
      normalizer (plusImage K L T z v hL hz (Lv L v) : Set _) := by
  have hLA : Lv L v ≤ plusActor K L T v := le_sup_right.trans le_sup_left
  have hLs : starImage z v (Lv L v) ≤ starImage z v (plusActor K L T v) :=
    map_mono (comap_mono hLA)
  have hnr : (starImage z v K).subgroupOf (starImage z v (plusActor K L T v)) ≤
      normalizer ((starImage z v (Lv L v)).subgroupOf
        (starImage z v (plusActor K L T v)) : Set _) := by
    rw [← subgroupOf_normalizer_eq hLs]
    exact comap_mono hn
  have hm := (map_mono (f := starToPlus K L T z v hK hL hz) hnr).trans
    (le_normalizer_map _)
  simpa only [starToPlus_image K L T z v hK hL hz K (K_le_plusActor K L T v),
    starToPlus_image K L T z v hK hL hz (Lv L v) hLA] using hm

/-- A hypothetical star action forces centralization in the faithful plus
action. The cubic two-core quotient is the earlier local A₅ calculation;
quasisimplicity and subnormality of K+ are constructed from actual Y_z
membership and the earlier R₂ consequence of B.2.14. -/
theorem plus_commutator_eq_bot_of_star_normalizes [Finite G]
    (K L T : Subgroup G) (z v : G)
    (hL : Tv T v ≤ normalizer (Lv L v : Set G))
    (hz : Tv T v ≤ centralizer ({z} : Set G)) (hK : K ∈ Yz L T z v)
    (hR : pCore 2 (Gplus K L T z v hL hz) = ⊥)
    (hcard : Nat.card (Lv L v ⧸ pCore 2 (Lv L v)) = 3)
    (hn : starImage z v K ≤ normalizer (starImage z v (Lv L v) : Set (Gstar z v))) :
    ⁅plusImage K L T z v hL hz K, plusImage K L T z v hL hz (Lv L v)⁆ = ⊥ := by
  let : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  let : Group.IsNilpotent (pCore 2 (Lv L v)) := pCore_isPGroup.isNilpotent
  let : IsCyclic (Lv L v ⧸ pCore 2 (Lv L v)) := isCyclic_of_prime_card hcard
  let : Group.IsSolvable (Lv L v) :=
    (Group.isSolvable_iff_subgroup_quotient (pCore 2 (Lv L v))).mpr
      ⟨inferInstance, inferInstance⟩
  have hLA : Lv L v ≤ plusActor K L T v := le_sup_right.trans le_sup_left
  let : Group.IsSolvable ((Lv L v).subgroupOf (plusActor K L T v)) :=
    Group.isSolvable_of_isSolvable_injective
      (f := (subgroupOfEquivOfLe hLA).toMonoidHom) (subgroupOfEquivOfLe hLA).injective
  let : Group.IsSolvable (plusImage K L T z v hL hz (Lv L v)) :=
    Group.isSolvable_of_surjective
      ((plusMk K L T z v hL hz).subgroupMap_surjective _)
  exact component_commutes_of_normalizes_solvable _ _
    ⟨plusImage_K_subnormal K L T z v hL hz hK,
      plusImage_K_quasisimple K L T z v hL hz hK hR⟩
    (plus_normalizes_of_star_normalizes K L T z v hK.1.1 hL hz hn)

/-- Conditional action deduction. The source case proofs still owe the
displayed nonzero plus commutator; it is not inferred from containment alone. -/
theorem star_action_obstruction_of_plus_commutator [Finite G]
    (K L T : Subgroup G) (z v : G)
    (hL : Tv T v ≤ normalizer (Lv L v : Set G))
    (hz : Tv T v ≤ centralizer ({z} : Set G)) (hK : K ∈ Yz L T z v)
    (hR : pCore 2 (Gplus K L T z v hL hz) = ⊥)
    (hcard : Nat.card (Lv L v ⧸ pCore 2 (Lv L v)) = 3)
    (hc : ⁅plusImage K L T z v hL hz K,
      plusImage K L T z v hL hz (Lv L v)⁆ ≠ ⊥) :
    ¬ starImage z v K ≤ normalizer (starImage z v (Lv L v) : Set (Gstar z v)) :=
  fun hn => hc (plus_commutator_eq_bot_of_star_normalizes K L T z v hL hz hK hR hcard hn)

/-- The actual 13.6.21 transport consumes relative normality in M_v.
The independent source cases retain responsibility for the plus commutator. -/
theorem not_le_M_of_plus_commutator [Finite G]
    (K L M T : Subgroup G) (z v : G)
    (hL : Tv T v ≤ normalizer (Lv L v : Set G))
    (hz : Tv T v ≤ centralizer ({z} : Set G)) (hK : K ∈ Yz L T z v)
    (hR : pCore 2 (Gplus K L T z v hL hz) = ⊥)
    (hcard : Nat.card (Lv L v ⧸ pCore 2 (Lv L v)) = 3)
    (hLM : Lv L v ≤ Mv M v) (hN : ((Lv L v).subgroupOf (Mv M v)).Normal)
    (hc : ⁅plusImage K L T z v hL hz K,
      plusImage K L T z v hL hz (Lv L v)⁆ ≠ ⊥) : ¬ K ≤ M :=
  Source.not_le_M_of_star_action_obstruction L M K z v hLM hN hK.1.1
    (star_action_obstruction_of_plus_commutator K L T z v hL hz hK hR hcard hc)

end CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceContainment
