module

public import CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceContainment.LinearThree.CentralAction.SeedGeometry
public import CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceContainment.LinearThree.CentralAction.ModuleAlternatives
public import CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceContainment.LinearThree.CentralAction.ParabolicGeometry

/-!
# Noncentrality in the L₃(2) branch of 13.6.20

The genuine marked A₅ configuration and earlier local conclusions give
[K⁺,Lᵥ⁺] ≠ 1. Under hypothetical centrality, the universal B.5.1/B.5.6
implications classify the actual U_K = [W_K,K]. The natural central
quotient contradicts 13.6.11, leaving one equivariant doubled marking.

The Thompson/Baumann and Frattini constructions in that marking identify
the image of N_K(Baum(T)) with the line parabolic and [V,Lᵥ] = [⟨z⟩,Lᵥ]
with the subgroup generated by two split points. Its normalization by the
two-residual contradicts the concrete cubic action. The residual is never
assumed to surject onto the full S₄ parabolic.

The source application retains full Hypothesis 13.3.1, the actual PSL₃(2)
identification, genuine earlier conclusions and the two universal source
classifiers. It discharges all additional module and geometry premises.
The projection and final Lᵥ ≤ K assembly belong to SourceContainment.LinearThree.

Source: Aschbacher–Smith, combined 1 March 2004 manuscript,
proof of Lemma 13.6.20, printed p.931 (PDF p.948).
-/

public section

open Subgroup Stellmacher
namespace CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceContainment.LinearThree.CentralAction
open ComponentSelection A5Module
universe u
variable {G : Type u} [Group G] [Finite G]
    {K L M V V₁ V₂ : Subgroup G} {T : Sylow 2 G}

/-- Noncentrality in the marked L₃(2) branch of 13.6.20. The universal
B.5.1/B.5.6 implications supply the module alternatives on the actual action;
13.6.11 excludes the natural central quotient under hypothetical centrality.
The resulting doubled marking feeds the constructed parabolic geometry and
the two-residual obstruction. No module or geometric witness remains an input. -/
theorem plus_commutator_ne_bot_of_marked
    (standing : RankTwo.LocalApplication.SourceHypothesis T L)
    (f : FlagMarking T L V V₁ V₂) (c : LocalConfiguration M f)
    (hM : M = normalizer (L : Set G))
    (e : ParabolicGeometry.Thompson.EarlierData K L (T : Subgroup G)
      (markedZ f.module) (markedV f.module))
    (model : plusImage K L (T : Subgroup G) (markedZ f.module) (markedV f.module)
      e.normalizeL e.fixSeed K ≃* Matrix.PSL3Two.PSL)
    (earlier : ChapterB.SourceInduction.ProjectiveLine.QuasisimpleClassificationInput.{u,u}
      KnownSimple.IsKnownSimple)
    (classification : ChapterB.SourceInduction.AdequateClassificationInput.{u,u}
      KnownSimple.IsKnownSimple) :
    ⁅plusImage K L (T : Subgroup G) (markedZ f.module) (markedV f.module)
        e.normalizeL e.fixSeed K,
      plusImage K L (T : Subgroup G) (markedZ f.module) (markedV f.module)
        e.normalizeL e.fixSeed (Lv L (markedV f.module))⁆ ≠ ⊥ := by
  intro hc
  have hsource : ModuleAlternatives.Applicability.SourceHypothesis
      KnownSimple.IsKnownSimple T L := {
    qtke := standing.qtke
    local_component := standing.local_component
    no_larger_field := standing.no_larger_field
    no_linear := standing.no_linear
    no_alternating_nine := standing.no_alternating_nine
    no_sporadic := standing.no_sporadic
    uniformA5 := standing.five_minimal }
  have hv : orderOf (markedV f.module) = 2 := by
    apply (orderOf_eq_prime_iff (p := 2)).mpr
    refine ⟨?_, markedV_ne_one f.module⟩
    change f.module.map _ ^ 2 = 1
    rw [← map_pow]
    exact (congrArg f.module.map
      (show (Multiplicative.ofAdd BinaryPermutation.FiveCentralizerGeometry.v) ^ 2 = 1
        by decide +kernel)).trans f.module.map.map_one
  obtain ⟨d⟩ := ModuleAlternatives.doubledCoordinates_of_source T f.module hsource
    standing.a5 standing.counterexample K e.normalizeL e.fixSeed e.tvSylow e.seedOmega hv
    e.characteristicTwo e.selected e.normalizeK model earlier classification hc
  exact ParabolicGeometry.false_of_marked_doubled standing f c hM e d hc

/-- Source application on the literal plus maps. The marked 13.6.2–5
configuration constructs the earlier package, with 13.3.2 normalization,
13.6.6 characteristic two, 13.6.14 invariance and 13.6.16(3) still explicit.
The two source-correct universal classifiers are specialized to the full
known-simple catalogue. The enclosing containment owner discharges these
genuine earlier-source inputs; this theorem supplies its noncentral branch. -/
theorem plus_commutator_ne_bot_of_source
    (standing : RankTwo.LocalApplication.SourceHypothesis T L)
    (f : FlagMarking T L V V₁ V₂) (c : LocalConfiguration M f)
    (hM : M = normalizer (L : Set G))
    (hTL : (T : Subgroup G) ≤ normalizer (L : Set G))
    (hK : K ∈ Yz L (T : Subgroup G) (markedZ f.module) (markedV f.module))
    (hn : Tv (T : Subgroup G) (markedV f.module) ≤ normalizer (K : Set G))
    (hchar : Theory.GroupTheory.generalizedFitting (Gv (markedV f.module)) =
      pCore 2 (Gv (markedV f.module)))
    (hgen : K = ⁅K, elementaryAbelianMaxJ (Tv (T : Subgroup G) (markedV f.module))⁆)
    (hL : Tv (T : Subgroup G) (markedV f.module) ≤
      normalizer (Lv L (markedV f.module) : Set G))
    (hz : Tv (T : Subgroup G) (markedV f.module) ≤
      centralizer ({markedZ f.module} : Set G))
    (model : plusImage K L (T : Subgroup G) (markedZ f.module) (markedV f.module)
      hL hz K ≃* Matrix.PSL3Two.PSL)
    (earlier : ChapterB.SourceInduction.ProjectiveLine.QuasisimpleClassificationInput.{u,u}
      KnownSimple.IsKnownSimple)
    (classification : ChapterB.SourceInduction.AdequateClassificationInput.{u,u}
      KnownSimple.IsKnownSimple) :
    ⁅plusImage K L (T : Subgroup G) (markedZ f.module) (markedV f.module) hL hz K,
      plusImage K L (T : Subgroup G) (markedZ f.module) (markedV f.module)
        hL hz (Lv L (markedV f.module))⁆ ≠ ⊥ :=
  plus_commutator_ne_bot_of_marked standing f c hM
    (ParabolicGeometry.Thompson.FullAction.sourceEarlierData f c hTL hK hn hchar hgen)
    model earlier classification

end CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceContainment.LinearThree.CentralAction
