module

public import CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceContainment.LinearThree.CentralAction.ParabolicGeometry.Coordinates
public import CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceContainment.LinearThree.CentralAction.SeedGeometry
public import Theory.Representation.PSL3Two.NaturalSylowFixed

/-!
# Sylow fixed points of the actual seed commutator

The marked cubic action gives |[⟨z⟩,L_v]| = 4. Under hypothetical
centrality of K+ and L_v+, this entire subgroup centralizes K ∩ T_v,
before any intersection with U_K. The literal Thompson image places the
shear radical inside the Sylow subgroup of the chosen component action.

A Sylow two-subgroup fixes at most two vectors in the natural binary
three-space. Consequently any four-element subgroup fixed in its doubled
module is the split plane generated by (x,0) and (0,x). The radical forces
x into the binary plane with last coordinate zero. Applied to the actual
seed, this keeps the original actor and module marking unchanged.

The final application is conditional on [⟨z⟩,L_v] ≤ U_K. This source
placement is still required: using `subgroupOf U_K` does not establish
it, and doubled-natural coordinates alone do not imply it. Thus this
module does not complete the split-seed task or Lemma 13.6.20.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004,
local cubic module on printed p.926 and Lemma 13.6.20 on p.931.
-/

public section

open Matrix Subgroup Representation BinaryLinearThree BinaryLinearThree.DoubledParabolic
open Representation.BinaryOffender
namespace CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceContainment.LinearThree.CentralAction.ParabolicGeometry.SplitSeed

private theorem fixed_radical_last (x : Vector)
    (h : ∀ r ∈ R, W r x = x) : x 2 = 0 := by
  have he := congrFun (h (shear (Multiplicative.ofAdd (1, 0))) ⟨_, rfl⟩) 0
  change (!![1,0,1; 0,1,0; 0,0,1].mulVec x) 0 = x 0 at he
  have hv : x 0 + x 2 = x 0 := by
    simpa [mulVec, dotProduct, Fin.sum_univ_three] using he
  exact add_left_cancel (hv.trans (add_zero (x 0)).symm)

private theorem splitPlane_card_le (x y : Vector) :
    Nat.card (splitPlane x y).toAddSubgroup.toSubgroup ≤ 4 := by
  let f : ZMod 2 × ZMod 2 → (splitPlane x y).toAddSubgroup.toSubgroup :=
    fun a => ⟨Multiplicative.ofAdd (a.1 • (x, 0) + a.2 • (0, y)),
      show a.1 • (x, 0) + a.2 • (0, y) ∈ splitPlane x y from
        Submodule.mem_span_pair.mpr ⟨a.1, a.2, rfl⟩⟩
  have hf : Function.Surjective f := by
    intro u
    have hu : u.val.toAdd ∈ splitPlane x y := u.property
    obtain ⟨a, b, he⟩ := Submodule.mem_span_pair.mp hu
    exact ⟨(a, b), Subtype.ext (congrArg Multiplicative.ofAdd he)⟩
  have hh := Nat.card_le_card_of_surjective f hf
  simpa using hh

/-- Four fixed vectors in the doubled module are exactly two copies of the
same Sylow-fixed point. The radical locates that point in its binary plane. -/
theorem split_of_sylow_fixed (P : Sylow 2 BinaryLinearThree.Group)
    (hR : R ≤ (P : Subgroup BinaryLinearThree.Group))
    (Q : Subgroup (Multiplicative (Vector × Vector))) (hcard : Nat.card Q = 4)
    (hfix : ∀ g ∈ (P : Subgroup BinaryLinearThree.Group), ∀ u ∈ Q,
      (W.prod W) g u.toAdd = u.toAdd) :
    ∃ x : Vector, x 2 = 0 ∧ x ≠ 0 ∧
      Q = (splitPlane x x).toAddSubgroup.toSubgroup := by
  classical
  let F := fixedSpace W (P : Subgroup BinaryLinearThree.Group)
  have hF : Nat.card F ≤ 2 := card_sylow_natural_fixed_le_two P
  have hcoord (u : Q) : u.val.toAdd.1 ∈ F ∧ u.val.toAdd.2 ∈ F := by
    constructor
    · intro g
      exact congrArg Prod.fst (hfix g g.property u u.property)
    · intro g
      exact congrArg Prod.snd (hfix g g.property u u.property)
  let : Nontrivial Q := Finite.one_lt_card_iff_nontrivial.mp (by omega)
  obtain ⟨q, hq⟩ := exists_ne (1 : Q)
  have hq0 : q.val.toAdd ≠ (0, 0) := by
    intro he
    apply hq
    exact Subtype.ext (congrArg Multiplicative.ofAdd he)
  have hex : ∃ x : F, x ≠ 0 := by
    by_cases h : q.val.toAdd.1 = 0
    · refine ⟨⟨q.val.toAdd.2, (hcoord q).2⟩, ?_⟩
      intro he
      exact hq0 (Prod.ext h (congrArg Subtype.val he))
    · exact ⟨⟨q.val.toAdd.1, (hcoord q).1⟩, fun he => h (congrArg Subtype.val he)⟩
  obtain ⟨x, hx⟩ := hex
  let : Nontrivial F := ⟨⟨x, 0, hx⟩⟩
  have hF2 : Nat.card F = 2 := by have := Finite.one_lt_card (α := F); omega
  obtain ⟨a, ha, huniq⟩ := (Nat.card_eq_two_iff' (0 : F)).mp hF2
  have hx_eq : x = a := huniq x hx
  have hcases (y : F) : (y : Vector) = 0 ∨ (y : Vector) = x := by
    by_cases hy : y = 0
    · exact Or.inl (congrArg Subtype.val hy)
    · exact Or.inr (congrArg Subtype.val ((huniq y hy).trans hx_eq.symm))
  have hle : Q ≤ (splitPlane (x : Vector) x).toAddSubgroup.toSubgroup := by
    intro u hu
    change u.toAdd ∈ splitPlane (x : Vector) x
    rcases hcases ⟨u.toAdd.1, (hcoord ⟨u, hu⟩).1⟩ with hf | hf <;>
      rcases hcases ⟨u.toAdd.2, (hcoord ⟨u, hu⟩).2⟩ with hs | hs <;> dsimp only at hf hs
    · exact Submodule.mem_span_pair.mpr ⟨0, 0, by simpa only [Prod.mk_add_mk, zero_smul, one_smul, add_zero, zero_add] using Prod.ext hf.symm hs.symm⟩
    · exact Submodule.mem_span_pair.mpr ⟨0, 1, by simpa only [Prod.mk_add_mk, zero_smul, one_smul, add_zero, zero_add] using Prod.ext hf.symm hs.symm⟩
    · exact Submodule.mem_span_pair.mpr ⟨1, 0, by simpa only [Prod.mk_add_mk, zero_smul, one_smul, add_zero, zero_add] using Prod.ext hf.symm hs.symm⟩
    · exact Submodule.mem_span_pair.mpr ⟨1, 1, by simpa only [Prod.mk_add_mk, zero_smul, one_smul, add_zero, zero_add] using Prod.ext hf.symm hs.symm⟩
  refine ⟨x, fixed_radical_last x (fun r hr => x.property ⟨r, hR hr⟩),
    fun he => hx (Subtype.ext he), Subgroup.eq_of_le_of_card_ge hle ?_⟩
  rw [hcard]
  exact splitPlane_card_le x x
end CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceContainment.LinearThree.CentralAction.ParabolicGeometry.SplitSeed

open Subgroup
open scoped commutatorElement
namespace CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceContainment.LinearThree.CentralAction.ParabolicGeometry.SplitSeed
open ComponentSelection A5Module
variable {G : Type*} [Group G] {K L T : Subgroup G} {z v : G}
    (hL : Tv T v ≤ normalizer (Lv L v : Set G))
    (hz : Tv T v ≤ centralizer ({z} : Set G))
    (hc : ⁅plusImage K L T z v hL hz K,
      plusImage K L T z v hL hz (Lv L v)⁆ = ⊥)

include hL hz hc in
private theorem commuting_conjugations (k : K) (l : Lv L v) (w : WK K L T z v) :
    (k : G) * ((l : G) * (w : G) * (l : G)⁻¹) * (k : G)⁻¹ =
      (l : G) * ((k : G) * (w : G) * (k : G)⁻¹) * (l : G)⁻¹ := by
  let a : plusActor K L T v := inclusion (K_le_plusActor K L T v) k
  let b : plusActor K L T v := inclusion (le_sup_right.trans le_sup_left) l
  have ha : plusMk K L T z v hL hz a ∈ plusImage K L T z v hL hz K :=
    mem_map.mpr ⟨a, k.property, rfl⟩
  have hb : plusMk K L T z v hL hz b ∈ plusImage K L T z v hL hz (Lv L v) :=
    mem_map.mpr ⟨b, l.property, rfl⟩
  have he := mem_centralizer_iff.mp ((commutator_eq_bot_iff_le_centralizer.mp hc) ha)
    _ hb
  have hm := congrArg (plusAction K L T z v hL hz) he
  rw [map_mul, map_mul] at hm
  have hw := congrArg (fun f : MulAut (WK K L T z v) => (f w : G)) hm
  exact hw.symm

include hL hz hc in
/-- Hypothetical centrality makes the entire seed commutator fixed by
K ∩ T_v. This holds before intersecting that commutator with U_K. -/
theorem seed_le_sylow_centralizer :
    ⁅zpowers z, Lv L v⁆ ≤ centralizer ((K ⊓ Tv T v : Subgroup G) : Set G) := by
  have hspan : Vv L z v ≤ centralizer ((K ⊓ Tv T v : Subgroup G) : Set G) := by
    apply (Subgroup.closure_le _).mpr
    rintro w ⟨l, hl, p, hp, rfl⟩
    apply mem_centralizer_iff.mpr
    intro k hk
    have hpW : p ∈ WK K L T z v := le_conjugateSpanBy _ _ hp
    have hkp : k * p * k⁻¹ = p := by
      have hcent : k ∈ centralizer (zpowers z : Set G) := by
        simpa only [zpowers_eq_closure, centralizer_closure] using hz hk.2
      exact mul_inv_eq_iff_eq_mul.mpr (mem_centralizer_iff.mp hcent p hp).symm
    have he := commuting_conjugations hL hz hc ⟨k, hk.1⟩ ⟨l, hl⟩ ⟨p, hpW⟩
    change k * (l * p * l⁻¹) * k⁻¹ = l * (k * p * k⁻¹) * l⁻¹ at he
    rw [hkp] at he
    exact mul_inv_eq_iff_eq_mul.mp he
  apply le_trans ?_ hspan
  exact (commutator_mono (le_conjugateSpanBy _ _) le_rfl).trans
    (le_normalizer_iff_commutator_le_left.mp (le_normalizer_conjugateSpanBy _ _))

open BinaryPermutation BinaryPermutation.FiveCentralizerGeometry A5Module.ResidualCoordinates
private theorem moved_card : Nat.card moved = 4 := by
  let : DecidablePred (· ∈ core (Fin 5)) := fun x =>
    inferInstanceAs (Decidable ((∑ i, x i) = 0))
  let : Fintype Space := Subtype.fintype _
  let : DecidablePred (· ∈ moved) := fun x =>
    inferInstanceAs (Decidable (x.toAdd.val 0 = 0 ∧ x.toAdd.val 1 = 0))
  let : Fintype moved := Subtype.fintype _
  rw [Nat.card_eq_fintype_card]
  decide +kernel

/-- The marked cubic action supplies all four elements of the literal seed
commutator; no cardinality is assumed in a geometry record. -/
theorem seed_card [Finite G] {V : Subgroup G} (s : A5Module.Marking L V) :
    Nat.card (⁅zpowers (markedZ s), Lv L (markedV s)⁆ : Subgroup G) = 4 := by
  rw [← local_commutator_eq_seed s, residual_commutator_eq_moved s,
    Subgroup.card_map_of_injective s.injective]
  exact moved_card
end CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceContainment.LinearThree.CentralAction.ParabolicGeometry.SplitSeed
open Subgroup Representation BinaryLinearThree BinaryLinearThree.DoubledParabolic
namespace CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceContainment.LinearThree.CentralAction.ParabolicGeometry.SplitSeed
open ComponentSelection A5Module
variable {G : Type*} [_root_.Group G] [Finite G] {K L T V : Subgroup G}

private theorem exists_component_sylow (v : G)
    (S : Sylow 2 (Gv v))
    (hS : (S : Subgroup (Gv v)).map (Gv v).subtype = Tv T v)
    (hK : K ≤ Gv v) (hn : Tv T v ≤ normalizer (K : Set G)) :
    ∃ P : Sylow 2 K, (P : Subgroup K).map K.subtype = K ⊓ Tv T v := by
  let N := Gv v ⊓ normalizer (K : Set G)
  have hKN : K ≤ N := le_inf hK K.le_normalizer
  have hSN : (S : Subgroup (Gv v)).map (Gv v).subtype ≤ N := by
    rw [hS]
    exact le_inf inf_le_right hn
  obtain ⟨Q, hQ⟩ := S.exists_map_subtype_eq_of_le (show N ≤ Gv v from inf_le_left) hSN
  obtain ⟨P, hP⟩ := Q.exists_map_subtype_eq_inf_of_normalizes hKN
    (show N ≤ normalizer (K : Set G) from inf_le_right)
  exact ⟨P, by simpa only [hQ, hS, inf_comm] using hP⟩

/-- The literal Thompson image lies in the Sylow of the component action,
without an assumed equality between intersections of quotient images. -/
theorem radical_le_component_sylow {z v : G}
    {hK : K ≤ Gv v} {hL : Tv T v ≤ normalizer (Lv L v : Set G)}
    {hz : Tv T v ≤ centralizer ({z} : Set G)}
    (d : DoubledCoordinates K L T z v hK hL hz)
    (S : Sylow 2 (Gv v))
    (hS : (S : Subgroup (Gv v)).map (Gv v).subtype = Tv T v)
    (P : Sylow 2 K) (hP : (P : Subgroup K).map K.subtype = K ⊓ Tv T v)
    (hJ : plusImage K L T z v hL hz (Stellmacher.elementaryAbelianMaxJ (Tv T v)) =
      R.map (modelEmbedding d)) :
    R ≤ ((P.mapSurjective d.actionMap_surjective) : Subgroup BinaryLinearThree.Group) := by
  let Q := (plusImage K L T z v hL hz (Tv T v)).comap (modelEmbedding d)
  have hTv : IsPGroup 2 (Tv T v) := by
    rw [← hS]
    exact S.isPGroup'.map _
  have hQ : IsPGroup 2 Q :=
    (hTv.comap_subtype.map (plusMk K L T z v hL hz)).comap_of_injective
      (modelEmbedding d) (modelEmbedding_injective d)
  have hPQ : ((P.mapSurjective d.actionMap_surjective) : Subgroup BinaryLinearThree.Group) ≤ Q := by
    rintro g ⟨k, hk, rfl⟩
    change modelEmbedding d (d.actionMap k) ∈ plusImage K L T z v hL hz (Tv T v)
    rw [modelEmbedding_actionMap]
    have hkt : (k : G) ∈ Tv T v := by
      have hm : (k : G) ∈ (P : Subgroup K).map K.subtype := mem_map.mpr ⟨k, hk, rfl⟩
      rw [hP] at hm
      exact hm.2
    exact mem_map.mpr ⟨inclusion (K_le_plusActor K L T v) k, hkt, rfl⟩
  have hQle := (P.mapSurjective d.actionMap_surjective).is_maximal' hQ hPQ
  apply le_trans ?_ hQle.le
  intro r hr
  change modelEmbedding d r ∈ plusImage K L T z v hL hz (Tv T v)
  have hm : modelEmbedding d r ∈ R.map (modelEmbedding d) := mem_map.mpr ⟨r, hr, rfl⟩
  rw [← hJ] at hm
  exact map_mono (comap_mono (show Stellmacher.elementaryAbelianMaxJ (Tv T v) ≤ Tv T v from
    sSup_le fun _ hA => hA.1)) hm

/-- Conditional coordinate construction. The only remaining geometric premise
is literal seed containment, which this theorem does not assert. In fact the
original marking suffices and both split points can be chosen equal. -/
theorem split_seed_of_placement
    (s : A5Module.Marking L V)
    (hK : K ≤ Gv (markedV s))
    (hL : Tv T (markedV s) ≤ normalizer (Lv L (markedV s) : Set G))
    (hz : Tv T (markedV s) ≤ centralizer ({markedZ s} : Set G))
    (d : DoubledCoordinates K L T (markedZ s) (markedV s) hK hL hz)
    (S : Sylow 2 (Gv (markedV s)))
    (hS : (S : Subgroup (Gv (markedV s))).map (Gv (markedV s)).subtype = Tv T (markedV s))
    (hn : Tv T (markedV s) ≤ normalizer (K : Set G))
    (hc : ⁅plusImage K L T (markedZ s) (markedV s) hL hz K,
      plusImage K L T (markedZ s) (markedV s) hL hz (Lv L (markedV s))⁆ = ⊥)
    (hJ : plusImage K L T (markedZ s) (markedV s) hL hz
        (Stellmacher.elementaryAbelianMaxJ (Tv T (markedV s))) = R.map (modelEmbedding d))
    (hplace : ⁅zpowers (markedZ s), Lv L (markedV s)⁆ ≤ UK K L T (markedZ s) (markedV s)) :
    ∃ x : Vector, x 2 = 0 ∧ x ≠ 0 ∧
      ((⁅zpowers (markedZ s), Lv L (markedV s)⁆ : Subgroup G).subgroupOf
        (UK K L T (markedZ s) (markedV s))).map d.moduleEquiv.toMonoidHom =
          (splitPlane x x).toAddSubgroup.toSubgroup := by
  obtain ⟨P, hP⟩ := exists_component_sylow (markedV s) S hS hK hn
  let Q := ⁅zpowers (markedZ s), Lv L (markedV s)⁆
  let U := UK K L T (markedZ s) (markedV s)
  have hcard : Nat.card ((Q.subgroupOf U).map d.moduleEquiv.toMonoidHom) = 4 := by
    rw [Subgroup.card_map_of_injective d.moduleEquiv.injective,
      Nat.card_congr (Subgroup.subgroupOfEquivOfLe hplace).toEquiv]
    exact seed_card s
  apply split_of_sylow_fixed (P.mapSurjective d.actionMap_surjective)
    (radical_le_component_sylow d S hS P hP hJ) _ hcard
  rintro g ⟨k, hk, rfl⟩ u ⟨w, hw, rfl⟩
  have hkt : (k : G) ∈ K ⊓ Tv T (markedV s) := by
    rw [← hP]
    exact mem_map.mpr ⟨k, hk, rfl⟩
  have he := mem_centralizer_iff.mp (seed_le_sylow_centralizer hL hz hc hw) k hkt
  have hkw : conjugationAction U K (K_normalizes_UK K L T _ _ hL hz) k w = w := by
    apply Subtype.ext
    exact mul_inv_eq_iff_eq_mul.mpr he
  have hd := d.equivariant k w
  rw [hkw] at hd
  exact congrArg Multiplicative.toAdd hd.symm
end CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceContainment.LinearThree.CentralAction.ParabolicGeometry.SplitSeed
