module
public import CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceOrthogonal.LocalAction.OrthogonalModule.Compatibility
public import Theory.Representation.BinarySylowFixedSpace
public import Theory.Representation.InvariantSectionExtension

/-!
# Extending the orthogonal moved-section coordinates to the seed span

The literal W_K is generated by the K-conjugates of the original seed.
Its quotient by [W_K,K] has trivial K-action. The seed is fixed by the
actual local Sylow, so odd-coset averaging on K⁺ produces a K-fixed
representative modulo [W_K,K]. Generation then proves
W_K = [W_K,K] + C_{W_K}(K).

The natural coordinates on U_K/C_{U_K}(K) therefore extend uniquely by
zero on C_{W_K}(K). The resulting surjection is equivariant for the full
plus actor, has precisely the K⁺-fixed kernel, and uses the same actor
marking. Applying the existing compatibility theorem marks the orthogonal
section, original seed stabilizer, literal C_K(z) image, and end-node
parabolic at once. NaturalMovedSection remains the explicit recognition
input; no splitting, wreath quotient, or Thompson equality is assumed.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004,
the paragraph following 13.6.23, printed p.933 (PDF p.950).
-/

@[expose] public section
open Subgroup
open scoped IsMulCommutative commutatorElement
namespace CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceOrthogonal.LocalAction.OrthogonalModule
open ComponentSelection Representation.BinaryOffender
variable {G : Type*} [Group G]
    (K L T : Subgroup G) (z v : G)
    (hL : Tv T v ≤ normalizer (Lv L v : Set G))
    (hz : Tv T v ≤ centralizer ({z} : Set G))
    [IsElementaryAbelian 2 (WK K L T z v)]

/-- Fixed vectors for the literal plus component are exactly the vectors
centralizing K in the original ambient group. -/
theorem fixedSpace_mem_iff (w : Additive (WK K L T z v)) :
    w ∈ fixedSpace (representation K L T z v hL hz) (plusImage K L T z v hL hz K) ↔
      (w.toMul : G) ∈ centralizer (K : Set G) := by
  constructor
  · intro hw
    apply mem_centralizer_iff.mpr
    intro k hk
    let a : plusActor K L T v := ⟨k, K_le_plusActor K L T v hk⟩
    have hh := hw ⟨plusMk K L T z v hL hz a, ⟨a, hk, rfl⟩⟩
    have he := congrArg (fun x : Additive (WK K L T z v) => (x.toMul : G)) hh
    change k * (w.toMul : G) * k⁻¹ = (w.toMul : G) at he
    exact mul_inv_eq_iff_eq_mul.mp he
  · intro hw k
    obtain ⟨a, ha, he⟩ := k.property
    change representation K L T z v hL hz k.val w = w
    rw [← he]
    apply Additive.toMul.injective
    apply Subtype.ext
    change (a : G) * (w.toMul : G) * (a : G)⁻¹ = (w.toMul : G)
    exact mul_inv_eq_iff_eq_mul.mpr (mem_centralizer_iff.mp hw a ha)

/-- Every K⁺ displacement lies in the literal moved space [W_K,K]. -/
theorem NaturalMovedSection.displacement_mem
    (d : NaturalMovedSection K L T z v hL hz)
    (k : plusImage K L T z v hL hz K) (w : Additive (WK K L T z v)) :
    representation K L T z v hL hz k w - w ∈ d.upper.toSubmodule := by
  apply (d.upper_mem _).mpr
  obtain ⟨a, ha, he⟩ := k.property
  rw [← he, commutator_comm (WK K L T z v) K]
  change (a : G) * (w.toMul : G) * (a : G)⁻¹ / (w.toMul : G) ∈ ⁅K, WK K L T z v⁆
  rw [div_eq_mul_inv]
  exact commutator_mem_commutator (H₁ := K) ha w.toMul.property

/-- Under normalization and Lᵥ ≤ K, the original seed generates W_K as a
K⁺-module. This uses the actual subgroup conjugation action. -/
theorem seed_generates_module
    (hK : Tv T v ≤ normalizer (K : Set G)) (hLK : Lv L v ≤ K)
    (M : Submodule (ZMod 2) (Additive (WK K L T z v)))
    (hM : ∀ k : plusImage K L T z v hL hz K, ∀ w ∈ M,
      representation K L T z v hL hz k w ∈ M)
    (hseed : Additive.ofMul (markedSeed K L T z v) ∈ M) : M = ⊤ := by
  let N : Subgroup G := (AddSubgroup.toSubgroup' M.toAddSubgroup).map (WK K L T z v).subtype
  have hzN : z ∈ N := ⟨markedSeed K L T z v, hseed, rfl⟩
  have hKN : K ≤ normalizer (N : Set G) := by
    apply le_normalizer_iff.mpr
    intro k hk x hx
    obtain ⟨w, hw, rfl⟩ := hx
    let a : plusActor K L T v := ⟨k, K_le_plusActor K L T v hk⟩
    let b : plusImage K L T z v hL hz K := ⟨plusMk K L T z v hL hz a, ⟨a, hk, rfl⟩⟩
    exact ⟨plusAction K L T z v hL hz b w, hM b (Additive.ofMul w) hw, rfl⟩
  have hWN : WK K L T z v ≤ N := by
    rw [WK, Kminus_eq_of_invariant K T v hK, sup_eq_left.mpr hLK]
    exact conjugateSpanBy_le (zpowers_le.mpr hzN) hKN
  apply top_unique
  intro w _
  obtain ⟨u, hu, he⟩ := hWN w.toMul.property
  have huw : u = w.toMul := Subtype.ext he
  change Additive.ofMul u ∈ M at hu
  simpa only [huw, ofMul_toMul] using hu

variable [Finite G]

/-- Odd-coset averaging and seed generation prove the fixed-space
supplement; it is a conclusion, not a splitting hypothesis. -/
theorem NaturalMovedSection.upper_sup_fixedSpace
    (hKGv : K ≤ Gv v)
    (hK : Tv T v ≤ normalizer (K : Set G)) (hLK : Lv L v ≤ K)
    (hSyl : Chapter1.IsSylowIn 2 (Tv T v) (Gv v))
    (d : NaturalMovedSection K L T z v hL hz) :
    d.upper.toSubmodule ⊔
      fixedSpace (representation K L T z v hL hz) (plusImage K L T z v hL hz K) = ⊤ := by
  let ρ := representation K L T z v hL hz
  let C := plusImage K L T z v hL hz K
  let : C.Normal := plusComponent_normal K L T z v hL hz hLK hK
  obtain ⟨S, hS⟩ := exists_plus_sylow K L T z v hL hz hKGv hSyl
  obtain ⟨P, hP⟩ := S.exists_subgroupOf_eq_of_normal C
  let u := Additive.ofMul (markedSeed K L T z v)
  have hu : u ∈ fixedSpace (ρ.comp C.subtype) (P : Subgroup C) := by
    intro p
    have hp : p.val ∈ (S : Subgroup _).subgroupOf C := by
      rw [← hP]
      exact p.property
    have hp' : p.val.val ∈ (S : Subgroup _) := hp
    rw [hS] at hp'
    exact seed_fixed_by_Tv K L T z v hL hz p.val.val hp'
  obtain ⟨w, hw, huw⟩ := Representation.BinarySylowFixedSpace.fixed_lift_mod_trivial_quotient
    (ρ.comp C.subtype) P d.upper.toSubmodule
    (d.displacement_mem K L T z v hL hz) u hu
  apply seed_generates_module K L T z v hL hz hK hLK
  · intro k x hx
    obtain ⟨a, ha, b, hb, rfl⟩ := Submodule.mem_sup.mp hx
    rw [map_add]
    exact Submodule.add_mem_sup (d.upper.apply_mem_toSubmodule k ha)
      (by
        have hkb : representation K L T z v hL hz k b = b := hb k
        rw [hkb]
        exact hb)
  · exact Submodule.mem_sup.mpr ⟨u - w, huw, w, hw, sub_add_cancel u w⟩

/-- Extend the moved-section coordinates to the original seed span, with
unchanged actor, full equivariance, and exactly the component-fixed kernel. -/
theorem exists_naturalSeedSection
    (hKGv : K ≤ Gv v)
    (hK : Tv T v ≤ normalizer (K : Set G)) (hLK : Lv L v ≤ K)
    (hSyl : Chapter1.IsSylowIn 2 (Tv T v) (Gv v))
    (d : NaturalMovedSection K L T z v hL hz) :
    ∃ s : NaturalSeedSection K L T z v hL hz, s.actor = d.actor ∧
      ∀ u : d.upper.toSubmodule,
        s.projection u.val = d.coordinates (d.central.toSubmodule.mkQ u) := by
  let ρ := representation K L T z v hL hz
  let N := plusImage K L T z v hL hz K
  let : N.Normal := plusComponent_normal K L T z v hL hz hLK hK
  let C := Representation.normalFixedSubrepresentation ρ N
  let σ := (BinaryPermutation.naturalRepresentation (Fin 8)).comp d.actor.toMonoidHom
  let f := d.coordinates.toLinearMap.comp d.central.toSubmodule.mkQ
  have hf : Function.Surjective f :=
    d.coordinates.surjective.comp d.central.toSubmodule.mkQ_surjective
  have he : ∀ g u, f (d.upper.toRepresentation g u) = σ g (f u) := by
    intro g u
    exact d.equivariant g (d.central.toSubmodule.mkQ u)
  have hk : ∀ u, f u = 0 ↔ u.val ∈ C.toSubmodule := by
    intro u
    change d.coordinates (d.central.toSubmodule.mkQ u) = 0 ↔ _
    rw [← d.coordinates.map_zero, d.coordinates.injective.eq_iff]
    change (Submodule.Quotient.mk u : _ ⧸ d.central.toSubmodule) = 0 ↔ _
    rw [Submodule.Quotient.mk_eq_zero, d.central_mem]
    exact (fixedSpace_mem_iff K L T z v hL hz u.val).symm
  obtain ⟨p, hp, heq, hker, hpu⟩ := Representation.exists_extension_by_zero ρ σ d.upper C
    (d.upper_sup_fixedSpace K L T z v hL hz hKGv hK hLK hSyl) f hf he hk
  exact ⟨{
    actor := d.actor
    component_image := d.component_image
    projection := p
    surjective := hp
    equivariant := heq
    kernel := hker }, rfl, hpu⟩

/-- The extension is canonical: its restriction to the moved space and its
fixed kernel determine its projection on every original seed-span vector. -/
theorem NaturalMovedSection.seedProjection_unique
    (hKGv : K ≤ Gv v)
    (hK : Tv T v ≤ normalizer (K : Set G)) (hLK : Lv L v ≤ K)
    (hSyl : Chapter1.IsSylowIn 2 (Tv T v) (Gv v))
    (d : NaturalMovedSection K L T z v hL hz)
    (s t : NaturalSeedSection K L T z v hL hz)
    (hs : ∀ u : d.upper.toSubmodule,
      s.projection u.val = d.coordinates (d.central.toSubmodule.mkQ u))
    (ht : ∀ u : d.upper.toSubmodule,
      t.projection u.val = d.coordinates (d.central.toSubmodule.mkQ u)) :
    s.projection = t.projection :=
  Representation.extension_by_zero_unique d.upper.toSubmodule
    (fixedSpace (representation K L T z v hL hz) (plusImage K L T z v hL hz K))
    (d.upper_sup_fixedSpace K L T z v hL hz hKGv hK hLK hSyl)
    s.projection t.projection (fun u => (hs u).trans (ht u).symm)
    (fun c hc => (s.kernel c).mpr hc) (fun c hc => (t.kernel c).mpr hc)

open Theory.SpecificGroups.SymmetricEight in
/-- Apply the extension to the actual source marking: one rotated actor
identifies the orthogonal section, original-seed stabilizer, literal C_K(z)
image, and end-node parabolic. Only moved-section recognition remains input. -/
theorem exists_compatible_marking_of_movedSection
    (hY : K ∈ Yz L T z v)
    (hK : Tv T v ≤ normalizer (K : Set G)) (hLK : Lv L v ≤ K)
    (hSyl : Chapter1.IsSylowIn 2 (Tv T v) (Gv v))
    (d : NaturalMovedSection K L T z v hL hz) :
    ∃ r : Equiv.Perm (Fin 8),
      (seedStabilizer K L T z v hL hz).map
        (d.conjugate K L T z v hL hz r).actor.toMonoidHom =
          A6ShadowTwoLocals.fourStabilizer ∧
      (plusImage K L T z v hL hz (K ⊓ Gv z)).map
        (d.conjugate K L T z v hL hz r).actor.toMonoidHom =
          alternatingGroup (Fin 8) ⊓ A6ShadowTwoLocals.fourStabilizer ∧
      (((plusImage K L T z v hL hz (K ⊓ Gv z)).map
        (d.conjugate K L T z v hL hz r).actor.toMonoidHom).subgroupOf
          (alternatingGroup (Fin 8))).map FourBlockParabolic.equiv.toMonoidHom =
            BinaryLinear.parabolic FourBlockParabolic.plane := by
  obtain ⟨s, hs, _⟩ := exists_naturalSeedSection K L T z v hL hz hY.1.1 hK hLK hSyl d
  exact exists_compatible_marking K L T z v hL hz hY hK hLK hSyl d s hs.symm

end CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceOrthogonal.LocalAction.OrthogonalModule
