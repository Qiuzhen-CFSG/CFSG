module

public import CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceOrthogonal.LocalAction.OrthogonalModule.Recognition.SourceAction.ComponentTransfer

/-!
# The component FF assertion following 13.6.23

The source configuration constructs the elementary structure of W_K, the
trivial two-core of its faithful plus actor, and the compatible S₈ marking.
If the full actor is not generated by offenders, the offender subgroup is
contained in K⁺ and its offenders restrict to U_K. In the generated case,
B.5.1 on S₈ and the augmentation-cover calculation produce an offender in
the actual A₈ component on the same moved covering space. These exhaustive
branches prove the ordinary FF assertion for K⁺ on U_K.

We then apply the full corrected B.5.1 theorem to that component action,
discharging its FF premise. The sole universal input is B.5.1, owned by
qt-b05-quasisimple. The earlier source configuration remains with
qt-13-06-rank-four-source-selection; selection of the orthogonal alternative
and final source assembly remain with
qt-13-06-orthogonal-ff-alternative-specialization.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), the paragraph
preceding 13.6.14, printed p.929, and the paragraph following 13.6.23,
printed p.933/PDF p.950.
-/

@[expose] public section

open Subgroup Representation Representation.BinaryOffender
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceOrthogonal.LocalAction.OrthogonalModule.Recognition.SourceAction
open ComponentSelection
open CFSG.Quasithin.Chapter15.Section04.LocalSetup.TwoFactors.FFBranch.ClassificationComparison.FFAlternatives
universe u
variable {G : Type u} [Group G] [Finite G] {Ξ : GroupClass.{u}}
  {K L V : Subgroup G} {T : Sylow 2 G} {z v : G}
  (c : Configuration Ξ K L V T z v)

/-- Ordinary FF for the actual K⁺ action on U_K, with no generation or
module-model premise. The representation retains `c.elementary` and the
canonical moved space identified with U_K by `movedSection_upper_source`. -/
theorem component_isFF
    (classification : ProjectiveLine.QuasisimpleClassificationInput.{u,u} Ξ) :
    letI := c.elementary
    let C := plusImage K L (T : Subgroup G) z v c.lv_invariant c.seed_fixed K
    let s := movedSection K L (T : Subgroup G) z v c.lv_invariant c.seed_fixed c.invariant c.lv_le
    IsFFModule (s.space.toRepresentation.comp C.subtype) := by
  let := c.elementary
  dsimp only
  by_cases hgen : offenderSubgroup
      (representation K L (T : Subgroup G) z v c.lv_invariant c.seed_fixed) = ⊤
  · exact component_ff_of_generated c classification hgen
  · exact component_ff_of_not_generated c hgen

/-- Apply all six clauses of corrected B.5.1 to the actual component action.
The source K-class, two-core, faithfulness and ordinary FF hypotheses are
all discharged from the same source configuration. -/
theorem source_classification
    (classification : ProjectiveLine.QuasisimpleClassificationInput.{u,u} Ξ) :
    letI := c.elementary
    let C := plusImage K L (T : Subgroup G) z v c.lv_invariant c.seed_fixed K
    let s := movedSection K L (T : Subgroup G) z v c.lv_invariant c.seed_fixed c.invariant c.lv_le
    Nonempty (ProjectiveLine.QuasisimpleSourceConclusion
      (s.space.toRepresentation.comp C.subtype) ⊤) := by
  let := c.elementary
  exact component_moved_classification K L (T : Subgroup G) z v c.lv_invariant c.seed_fixed
    classification c.selected c.twoCore c.alternating
    (c.standing.qtke.involution_centralizer_sqtk c.v_order).2
    (movedSection K L (T : Subgroup G) z v c.lv_invariant c.seed_fixed c.invariant c.lv_le)
    (component_isFF c classification)

end CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceOrthogonal.LocalAction.OrthogonalModule.Recognition.SourceAction
