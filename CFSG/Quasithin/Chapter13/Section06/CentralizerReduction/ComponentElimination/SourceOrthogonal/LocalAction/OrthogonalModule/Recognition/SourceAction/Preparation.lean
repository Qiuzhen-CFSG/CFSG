module

public import CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceOrthogonal.LocalAction.OrthogonalModule.Recognition.Preparation
public import CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceContainment.LinearThree.CentralAction.ModuleAlternatives.Applicability.Preparation
public import Theory.Representation.BinaryOffender.SectionLinear

/-!
# The source R₂ inputs and the full-actor FF assertion

The two linearizations of the literal plus action agree. We reuse the
source-independent elementary and R₂ deductions from the central-action
preparation: W_K lies in U_v and then in the elementary omega-center;
the Sylow-central seed kills the normal two-core of the plus quotient.
No L₃(2) marking is used.

Transport of the X_z commutator identity puts K⁺ in the normal subgroup
generated by the actual Thompson offenders. Nontriviality of K⁺ supplies
an ordinary offender on W_K. The same offender acts on its invariant
moved space, since restriction cannot increase fixed codimension.
This last assertion retains the whole plus actor. It does not assert
that the offender is contained in K⁺.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), B.2.5,
B.2.14 and the paragraph preceding 13.6.14, printed p.929; the different
component FF assertion is used following 13.6.23, printed p.933.
-/

@[expose] public section
open Subgroup Representation Representation.BinaryOffender Stellmacher
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceOrthogonal.LocalAction.OrthogonalModule.Recognition.SourceAction
open ComponentSelection SourceContainment.LinearThree.CentralAction
open CFSG.Quasithin.Chapter15.Section04.LocalSetup.TwoFactors.FFBranch.ClassificationComparison.FFAlternatives
variable {G : Type*} [Group G] [Finite G] (K L T : Subgroup G) (z v : G)

/-- Elementary structure comes from the actual inclusion W_K ≤ U_v. -/
theorem wk_elementary
    (hY : K ∈ Yz L T z v)
    (hSylow : Chapter1.IsSylowIn 2 (Tv T v) (Gv v))
    (hzOmega : z ∈ omegaOneCenterAmbient (Tv T v))
    (hf : Theory.GroupTheory.generalizedFitting (Gv v) = pCore 2 (Gv v)) :
    IsElementaryAbelian 2 (WK K L T z v) :=
  ModuleAlternatives.wk_elementary K L T z v hY.1.1 hSylow hzOmega hf

variable (hL : Tv T v ≤ normalizer (Lv L v : Set G))
    (hz : Tv T v ≤ centralizer ({z} : Set G))

/-- B.2.14's two-reducedness on the original plus quotient. The proof uses
normality of the core, the Sylow-central seed, and its conjugate span. -/
theorem plus_twoCore_eq_bot
    (hY : K ∈ Yz L T z v)
    (hSylow : Chapter1.IsSylowIn 2 (Tv T v) (Gv v)) :
    pCore 2 (Gplus K L T z v hL hz) = ⊥ :=
  ModuleAlternatives.plus_twoCore_eq_bot K L T z v hY.1.1 hL hz hSylow

variable [IsElementaryAbelian 2 (WK K L T z v)]

omit [Finite G] in
/-- The existing central-action preparation uses the very same representation. -/
theorem representation_eq_wkRepresentation :
    representation K L T z v hL hz = ModuleAlternatives.wkRepresentation K L T z v hL hz := rfl

/-- This is containment in the ambient offender subgroup, not offender
generation inside the component. -/
theorem component_le_offenders
    (hY : K ∈ Yz L T z v) (hK : Tv T v ≤ normalizer (K : Set G))
    (hzT : z ∈ Tv T v) (hSylow : Chapter1.IsSylowIn 2 (Tv T v) (Gv v)) :
    plusImage K L T z v hL hz K ≤ offenderSubgroup (representation K L T z v hL hz) :=
  ModuleAlternatives.component_plus_le_offenders K L T z v hL hz hzT hSylow hY hK

/-- The source's earlier FF assertion, after K₋ = K and L_v ≤ K:
the actor is the whole K⁺T_v⁺, not K⁺. -/
theorem wk_isFF
    (hY : K ∈ Yz L T z v) (hK : Tv T v ≤ normalizer (K : Set G))
    (hzT : z ∈ Tv T v) (hSylow : Chapter1.IsSylowIn 2 (Tv T v) (Gv v)) :
    IsFFModule (representation K L T z v hL hz) := by
  let ρ := representation K L T z v hL hz
  have hle := component_le_offenders K L T z v hL hz hY hK hzT hSylow
  have hne := plusImage_ne_bot_of_mem_Yz K L T z v hL hz hY
  by_contra hn
  apply hne
  apply bot_unique
  apply hle.trans
  unfold offenderSubgroup generatedBy
  refine iSup_le fun A => iSup_le fun hA => ?_
  exact (hn ⟨A, hA.1.isOffender ρ⟩).elim

/-- The earlier offender restricts to the literal U_K under the entire
plus actor. Passing to the smaller actor K⁺ is a separate obligation. -/
theorem moved_isFF_full_actor
    (hY : K ∈ Yz L T z v) (hK : Tv T v ≤ normalizer (K : Set G))
    (hLK : Lv L v ≤ K)
    (hzT : z ∈ Tv T v) (hSylow : Chapter1.IsSylowIn 2 (Tv T v) (Gv v)) :
    IsFFModule (movedSection K L T z v hL hz hK hLK).space.toRepresentation := by
  obtain ⟨A, hA⟩ := wk_isFF K L T z v hL hz hY hK hzT hSylow
  exact ⟨A, hA.1, (fixedCodim_subrepresentation_le _
    (movedSection K L T z v hL hz hK hLK).space A).trans hA.2⟩

end CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceOrthogonal.LocalAction.OrthogonalModule.Recognition.SourceAction
