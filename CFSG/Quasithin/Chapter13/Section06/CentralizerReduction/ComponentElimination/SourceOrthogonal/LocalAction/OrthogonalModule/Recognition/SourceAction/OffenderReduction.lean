module

public import CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceOrthogonal.LocalAction.OrthogonalModule.Recognition.SourceAction

/-!
# The component-offender branch and the remaining symmetric case

The plus group has the constructed S₈ marking and its offender subgroup
contains the actual A₈ component. A proper subgroup containing A₈ is A₈:
an outside element together with A₈ generates S₈. Thus, unless the full
plus group is offender-generated, an existing best offender lies in K⁺.
Restriction to the invariant moved space decreases fixed codimension and
supplies the ordinary component FF assertion.

The final theorem applies the full corrected B.5.1 input to that component
branch. It leaves precisely the case where the original W_K action is
offender-generated by the whole S₈. No offender-generation assertion is
assumed uniformly, and the source theorem remains unfinished in that case.
Source: Aschbacher–Smith, combined manuscript (1 March 2004), B.1.5,
B.5.1, and the paragraph following 13.6.23, printed p.933/PDF p.950.
-/

@[expose] public section

open Subgroup Representation Representation.BinaryOffender Stellmacher
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceOrthogonal.LocalAction.OrthogonalModule.Recognition.SourceAction
open ComponentSelection
open CFSG.Quasithin.Chapter15.Section04.LocalSetup.TwoFactors.FFBranch.ClassificationComparison.FFAlternatives
universe u
variable {D : Type*} [Group D]

private theorem le_component_of_ne_top (E : D ≃* Equiv.Perm (Fin 8))
    (C J : Subgroup D) (hC : C.map E.toMonoidHom = alternatingGroup (Fin 8))
    (hCJ : C ≤ J) (hJ : J ≠ ⊤) : J ≤ C := by
  intro x hx
  by_contra hxc
  have hodd : E x ∉ alternatingGroup (Fin 8) := by
    rw [← hC, Subgroup.mem_map_equiv]
    simpa only [MulEquiv.symm_apply_apply] using hxc
  have hgen := Theory.SpecificGroups.SymmetricEight.Involutions.alternating_sup_zpowers_eq_top hodd
  have htop : J.map E.toMonoidHom = ⊤ := by
    apply top_unique
    rw [← hgen]
    exact sup_le (hC ▸ map_mono hCJ) (zpowers_le.mpr (mem_map_of_mem E.toMonoidHom hx))
  apply hJ
  apply map_injective (f := E.toMonoidHom) E.injective
  rw [htop, map_top_of_surjective _ E.surjective]

variable {G : Type u} [Group G] [Finite G] {𝒦 : GroupClass.{u}}
  {K L V : Subgroup G} {T : Sylow 2 G} {z v : G}
  (c : Configuration 𝒦 K L V T z v)

/-- Construct the requested component FF witness when the full plus actor
is not generated by offenders. The source configuration discharges all
other inputs, including the actual symmetric marking. -/
theorem component_ff_of_not_generated :
    letI := c.elementary
    let ρ := representation K L (T : Subgroup G) z v c.lv_invariant c.seed_fixed
    let C := plusImage K L (T : Subgroup G) z v c.lv_invariant c.seed_fixed K
    let s := movedSection K L (T : Subgroup G) z v c.lv_invariant c.seed_fixed c.invariant c.lv_le
    offenderSubgroup ρ ≠ ⊤ → IsFFModule (s.space.toRepresentation.comp C.subtype) := by
  let := c.elementary
  dsimp only
  intro hnot
  obtain ⟨_, _, _, _, hle, hff, _, E, _, hmap⟩ := source_action_inputs c
  let ρ := representation K L (T : Subgroup G) z v c.lv_invariant c.seed_fixed
  let C := plusImage K L (T : Subgroup G) z v c.lv_invariant c.seed_fixed K
  let s := movedSection K L (T : Subgroup G) z v c.lv_invariant c.seed_fixed c.invariant c.lv_le
  have hJC : offenderSubgroup ρ ≤ C := le_component_of_ne_top E C (offenderSubgroup ρ) hmap hle hnot
  obtain ⟨A, hA⟩ := (isFFModule_iff_exists_bestOffender ρ).mp hff
  have hAC := (hA.le_offenderSubgroup ρ).trans hJC
  have hU : IsOffender s.space.toRepresentation A :=
    ⟨hA.1, (fixedCodim_subrepresentation_le ρ s.space A).trans (hA.isOffender ρ).2⟩
  exact ⟨A.subgroupOf C, hU.subgroupOf s.space.toRepresentation hAC⟩

/-- The actual B.5.1 application is complete unless the offenders generate
all of the symmetric plus actor. That remaining case is not an assumption
in the final source theorem. -/
theorem source_classification_or_generated
    (classification : ProjectiveLine.QuasisimpleClassificationInput.{u,u} 𝒦) :
    letI := c.elementary
    let ρ := representation K L (T : Subgroup G) z v c.lv_invariant c.seed_fixed
    let C := plusImage K L (T : Subgroup G) z v c.lv_invariant c.seed_fixed K
    let s := movedSection K L (T : Subgroup G) z v c.lv_invariant c.seed_fixed c.invariant c.lv_le
    Nonempty (ProjectiveLine.QuasisimpleSourceConclusion
      (s.space.toRepresentation.comp C.subtype) ⊤) ∨ offenderSubgroup ρ = ⊤ := by
  let := c.elementary
  dsimp only
  by_cases hJ : offenderSubgroup
      (representation K L (T : Subgroup G) z v c.lv_invariant c.seed_fixed) = ⊤
  · exact Or.inr hJ
  · apply Or.inl
    exact component_moved_classification K L (T : Subgroup G) z v c.lv_invariant c.seed_fixed
      classification c.selected c.twoCore c.alternating
      (c.standing.qtke.involution_centralizer_sqtk c.v_order).2
      (movedSection K L (T : Subgroup G) z v c.lv_invariant c.seed_fixed c.invariant c.lv_le)
      (component_ff_of_not_generated c hJ)

end CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceOrthogonal.LocalAction.OrthogonalModule.Recognition.SourceAction
