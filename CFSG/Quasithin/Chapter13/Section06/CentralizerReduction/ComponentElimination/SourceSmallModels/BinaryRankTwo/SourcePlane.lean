module
public import CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceSmallModels.BinaryRankTwo.Models
public import CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceSmallModels.BinaryRankTwo.MovingPlane
public import Mathlib.Algebra.Module.ZMod
public import Mathlib.LinearAlgebra.Quotient.Card
/-!
# Transporting the source four-group through the block quotient

For the actual equivariant map U → U/C_U(K), the image of an invariant
four-group l=[l,D] still has order four. Otherwise its order is one or two,
so its action is trivial; the exact centralizer kernel then forces l=1.
The image is generated by the same conjugation differences. This constructs
the moving binary plane without assuming its dimension survives the quotient.
The Sylow image and both invariance clauses use the chosen actor map.

Source: Aschbacher–Smith, Lemma 13.6.22, printed p.932.
-/

@[expose] public section
open Subgroup Representation Representation.BinaryOffender
namespace CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceSmallModels.BinaryRankTwo.SourcePlane
variable {G A W : Type*} [Group G] [Group A] [AddCommGroup W] [Module (ZMod 2) W]
  {K U l D P : Subgroup G} {ρ : Representation (ZMod 2) A W}

noncomputable def plane (m : ConjugationQuotientModel K U ρ) (l : Subgroup G) :
    Submodule (ZMod 2) W :=
  AddSubgroup.toZModSubmodule 2 ((l.subgroupOf U).map m.quotient).toAddSubgroup

theorem plane_invariant (m : ConjugationQuotientModel K U ρ)
    (hn : P ≤ normalizer (l : Set G)) :
    (P.subgroupOf K).map m.actor ≤ subspaceStabilizer ρ (plane m l) := by
  apply le_subspaceStabilizer
  rintro a ⟨k, hk, rfl⟩ w ⟨u, hu, he⟩
  change m.quotient u = Multiplicative.ofAdd w at he
  have he' : Multiplicative.toAdd (m.quotient u) = w := he
  rw [← he']
  change Multiplicative.ofAdd (ρ (m.actor k) (Multiplicative.toAdd (m.quotient u))) ∈
    (l.subgroupOf U).map m.quotient
  rw [← m.equivariant]
  exact mem_map_of_mem m.quotient ((mem_normalizer_iff.mp (hn hk) u).mp hu)

/-- If the image of the source commutator is fixed, the source line is trivial. -/
theorem line_eq_bot_of_fixed (m : ConjugationQuotientModel K U ρ)
    (hDK : D ≤ K) (hlU : l ≤ U) (hl : ⁅l, D⁆ = l)
    (hf : ∀ d : D, ∀ x : l,
      ρ (m.actor ⟨d, hDK d.property⟩)
        (Multiplicative.toAdd (m.quotient ⟨x, hlU x.property⟩)) =
        Multiplicative.toAdd (m.quotient ⟨x, hlU x.property⟩)) : l = ⊥ := by
  have hcomm : ⁅D, l⁆ ≤ m.quotient.ker.map U.subtype := by
    apply commutator_le.mpr
    intro d hd x hx
    let u : U := ⟨x, hlU hx⟩
    let k : K := ⟨d, hDK hd⟩
    let c := U.normalizerMonoidHom ⟨k, m.normalizes k.property⟩ u
    have he : m.quotient c = m.quotient u := by
      apply Multiplicative.toAdd.injective
      rw [m.equivariant]
      exact hf ⟨d, hd⟩ ⟨x, hx⟩
    have hm : c * u⁻¹ ∈ m.quotient.ker := by
      change m.quotient (c * u⁻¹) = 1
      rw [map_mul, map_inv, he, mul_inv_cancel]
    exact ⟨c * u⁻¹, hm, rfl⟩
  have hk : l ≤ centralizer (K : Set G) := by
    rw [commutator_comm, hl] at hcomm
    intro x hx
    obtain ⟨u, hu, rfl⟩ := hcomm hx
    rw [m.kernel] at hu
    exact hu
  rw [← hl]
  exact commutator_eq_bot_iff_le_centralizer.mpr (hk.trans (centralizer_le hDK))

private theorem fixed_of_card_le_two (E : Submodule (ZMod 2) W)
    (hc : Nat.card E = 1 ∨ Nat.card E = 2) (a : A)
    (ha : a ∈ subspaceStabilizer ρ E) (w : E) : ρ a w = w := by
  let y : E := ⟨ρ a w, (ha w).mpr w.property⟩
  have h : y = w := by
    rcases hc with hc | hc
    · have := (Nat.card_eq_one_iff_unique.mp hc).1
      exact Subsingleton.elim _ _
    · obtain ⟨z, _, hz⟩ := (Nat.card_eq_two_iff' (0 : E)).mp hc
      by_cases hw : w = 0
      · apply Subtype.ext
        simp [y, hw]
      · have hy : y ≠ 0 := by
          intro hy
          apply hw
          apply Subtype.ext
          have hy' : ρ a w = 0 := congrArg Subtype.val hy
          have h := congrArg (ρ a⁻¹) hy'
          change (w : W) = 0
          simpa only [y, ← Module.End.mul_apply, ← map_mul, inv_mul_cancel,
            map_one, Module.End.one_apply, map_zero] using h
        exact (hz y hy).trans (hz w hw).symm
  exact congrArg Subtype.val h

theorem plane_dimension [Finite G] (m : ConjugationQuotientModel K U ρ)
    (hDK : D ≤ K) (hlU : l ≤ U) (hl : ⁅l, D⁆ = l)
    (hc : Nat.card l = 4) (hn : D ≤ normalizer (l : Set G)) :
    Module.finrank (ZMod 2) (plane m l) = 2 := by
  let H := (l.subgroupOf U).map m.quotient
  let e : plane m l ≃ H := {
    toFun := fun w => ⟨Multiplicative.ofAdd w, w.property⟩
    invFun := fun w => ⟨Multiplicative.toAdd w, w.property⟩
    left_inv := fun _ => rfl
    right_inv := fun _ => rfl }
  have : Finite H := Finite.of_surjective (m.quotient.subgroupMap (l.subgroupOf U))
    (m.quotient.subgroupMap_surjective _)
  have : Finite (plane m l) := Finite.of_equiv H e.symm
  have hd : Nat.card (plane m l) ∣ 4 := by
    rw [Nat.card_congr e, ← hc, ← Nat.card_congr (subgroupOfEquivOfLe hlU).toEquiv]
    exact (l.subgroupOf U).card_map_dvd m.quotient
  have hsmall : Nat.card (plane m l) = 1 ∨ Nat.card (plane m l) = 2 ∨
      Nat.card (plane m l) = 4 := by
    have := (Nat.dvd_prime_pow (m := 2) (by decide : Nat.Prime 2)).mp hd
    obtain ⟨i, hi, he⟩ := this
    interval_cases i <;> norm_num at he ⊢ <;> omega
  have hc4 : Nat.card (plane m l) = 4 := by
    rcases hsmall with hh | hh | hh
    rotate_left 2
    · exact hh
    all_goals
      have hb := line_eq_bot_of_fixed m hDK hlU hl (fun d x => by
        apply fixed_of_card_le_two (plane m l) (by simp [hh])
          (m.actor ⟨d, hDK d.property⟩)
          (plane_invariant m hn (mem_map_of_mem m.actor d.property))
          ⟨_, mem_map_of_mem m.quotient x.property⟩)
      have h1 := (eq_bot_iff_card l).mp hb
      omega
  rw [Module.natCard_eq_pow_finrank (K := ZMod 2), Nat.card_zmod] at hc4
  exact Nat.pow_right_injective (by decide : 1 < 2) hc4

theorem plane_moved (m : ConjugationQuotientModel K U ρ)
    (hDK : D ≤ K) (hlU : l ≤ U) (hl : ⁅l, D⁆ = l)
    (hn : D ≤ normalizer (l : Set G)) :
    subspaceCommutator ρ (plane m l) ((D.subgroupOf K).map m.actor) = plane m l := by
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro w ⟨d, hd, x, hx, rfl⟩
    exact (plane m l).sub_mem ((plane_invariant m hn hd x).mpr hx) hx
  · let C := subspaceCommutator ρ (plane m l) ((D.subgroupOf K).map m.actor)
    let B : Subgroup (Multiplicative W) := C.toAddSubgroup.toSubgroup
    have hcomm : ⁅D, l⁆ ≤ (B.comap m.quotient).map U.subtype := by
      apply commutator_le.mpr
      intro d hd x hx
      let u : U := ⟨x, hlU hx⟩
      let k : K := ⟨d, hDK hd⟩
      let c := U.normalizerMonoidHom ⟨k, m.normalizes k.property⟩ u
      refine ⟨c * u⁻¹, ?_, rfl⟩
      change Multiplicative.toAdd (m.quotient (c * u⁻¹)) ∈ C
      rw [map_mul, map_inv, toAdd_mul, toAdd_inv, ← sub_eq_add_neg,
        m.equivariant]
      exact Submodule.subset_span ⟨m.actor k, mem_map_of_mem m.actor hd,
        Multiplicative.toAdd (m.quotient u), mem_map_of_mem m.quotient hx, rfl⟩
    rw [commutator_comm, hl] at hcomm
    rintro w ⟨u, hu, he⟩
    obtain ⟨t, ht, htU⟩ := hcomm hu
    have ht' : t = u := Subtype.ext htU
    subst t
    change Multiplicative.toAdd (m.quotient u) ∈ C at ht
    change m.quotient u = Multiplicative.ofAdd w at he
    have he' : Multiplicative.toAdd (m.quotient u) = w := he
    exact he' ▸ ht

/-- Construct the genuine moving plane from the original invariant four-group. -/
noncomputable def movingPlane [Finite G] (m : ConjugationQuotientModel K U ρ)
    (hf : Function.Surjective m.actor) (T : Subgroup G) (S : Sylow 2 K)
    (hS : (S : Subgroup K) = T.subgroupOf K)
    (hDK : D ≤ K) (hlU : l ≤ U) (hl : ⁅l, D⁆ = l)
    (hc : Nat.card l = 4) (hn : D ⊔ T ≤ normalizer (l : Set G)) :
    MovingPlane
      ρ (S.mapSurjective hf) ((D.subgroupOf K).map m.actor) where
  plane := plane m l
  dimension := plane_dimension m hDK hlU hl hc (le_sup_left.trans hn)
  invariant := by
    apply sup_le
    · exact (map_mono (f := m.actor) (show D.subgroupOf K ≤ (D ⊔ T).subgroupOf K from
        fun _ hd => (le_sup_left : D ≤ D ⊔ T) hd)).trans (plane_invariant m hn)
    · rw [Sylow.coe_mapSurjective, hS]
      exact (map_mono (f := m.actor) (show T.subgroupOf K ≤ (D ⊔ T).subgroupOf K from
        fun _ ht => (le_sup_right : T ≤ D ⊔ T) ht)).trans (plane_invariant m hn)
  moved := plane_moved m hDK hlU hl (le_sup_left.trans hn)

end CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceSmallModels.BinaryRankTwo.SourcePlane
