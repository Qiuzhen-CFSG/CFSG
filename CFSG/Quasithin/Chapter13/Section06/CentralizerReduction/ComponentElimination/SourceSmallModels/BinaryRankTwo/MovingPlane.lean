module

public import Theory.Representation.BinaryOffender.SubspaceAction
public import Mathlib.GroupTheory.Sylow

/-!
# The moving plane used in the binary rank-two source calculation

The source order-four line becomes a two-dimensional binary subspace after
passing through the actual block quotient. Its invariance and displacement
identity are retained without any parabolic-placement conclusion. This
shared interface permits the two concrete model recognition arguments to
be proved independently of the source quotient transport.
Source: Aschbacher–Smith, Lemma 13.6.22, printed p.932.
-/

@[expose] public section
open Subgroup Representation
namespace CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceSmallModels.BinaryRankTwo

/-- A two-dimensional plane invariant under both the residual actor and a
Sylow two-group, and generated by its residual displacements. The source
calls this order-four group a line. -/
structure MovingPlane {A W : Type*} [Group A] [AddCommGroup W] [Module (ZMod 2) W]
    (ρ : Representation (ZMod 2) A W) (S : Sylow 2 A) (D : Subgroup A) where
  plane : Submodule (ZMod 2) W
  dimension : Module.finrank (ZMod 2) plane = 2
  invariant : D ⊔ (S : Subgroup A) ≤ Representation.BinaryOffender.subspaceStabilizer ρ plane
  moved : Representation.BinaryOffender.subspaceCommutator ρ plane D = plane

end CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceSmallModels.BinaryRankTwo
