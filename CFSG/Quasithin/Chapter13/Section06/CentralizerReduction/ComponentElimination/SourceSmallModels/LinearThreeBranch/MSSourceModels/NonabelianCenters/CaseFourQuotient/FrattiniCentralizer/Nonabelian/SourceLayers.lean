private theorem le_conjugatesIn (A F : Subgroup G) : A ≤ conjugatesIn A F := by
  have h := le_iSup (fun g : F => rightConjugate A g) 1
  have he : (MulAut.conj (1 : G)⁻¹).toMonoidHom = MonoidHom.id G := by
    ext x
    simp
  simpa only [conjugatesIn, rightConjugate, Subgroup.coe_one, he, map_id] using h

private theorem conjugatesIn_omegaOne (A F : Subgroup G)
    (hA : omegaOneAmbient A = A) :
    omegaOneAmbient (conjugatesIn A F) = conjugatesIn A F := by
  apply le_antisymm (omegaOneAmbient_le _)
  apply iSup_le
  intro g
  have hAg : omegaOneAmbient (rightConjugate A g) = rightConjugate A g := by
    rw [rightConjugate, ← map_omegaOneAmbient_injective _ (MulAut.conj _).injective, hA]
  rw [← hAg]
  exact omegaOneAmbient_mono (le_iSup (fun g : F => rightConjugate A g) g)

private theorem conjugatesIn_le_of_normalized {A B F : Subgroup G}
    (hA : A ≤ B) (hB : F ≤ normalizer B) : conjugatesIn A F ≤ B := by
  apply iSup_le
  intro g
  apply (map_mono hA).trans
  exact (mem_normalizer_iff_map_conj_eq.mp (hB (F.inv_mem g.property))).le

variable {M : Type*} [Group M] {T : Subgroup M}

/-- The second nested orbit span lies in radius four along two source steps. -/
theorem nestedOrbit_le_radiusFour {a c d : Vertex T}
    (hca : (cosetGraph T).dist c a ≤ 2) (hdc : (cosetGraph T).dist d c ≤ 2) :
    conjugatesIn (localZSpan T d c) (stabilizer T a) ≤ VBall T a 4 := by
  apply conjugatesIn_le_of_normalized ?_
    (Escape.Propagation.RadiusFour.VBall_normalized a 4)
  apply (localZSpan_le_V T hdc).trans
  apply Escape.Propagation.RadiusFour.VBall_le_of_dist_add_le a c 2 4
  omega

/-- The three regular turns place the opposite endpoint in the same second hat layer. The proof retains the right-action conjugator k*g*h*g⁻¹. -/
theorem opposite_endpoint_le_nestedOrbit {a c d c' d' : Vertex T}
    (g : stabilizer T a) (hg : act T g c = c')
    (k : stabilizer T c) (hk : act T k d = a)
    (h : stabilizer T c') (hh : act T h a = d') :
    Z T d' ≤ conjugatesIn (localZSpan T d c) (stabilizer T a) := by
  let x : FreeAmalgam T := k * g * h * (g : FreeAmalgam T)⁻¹
  have hxc : x ∈ stabilizer T c := by
    change act T x c = c
    have hkc : act T k c = c := k.property
    have hhc : act T h c' = c' := h.property
    dsimp only [x]
    rw [act_mul, act_mul, act_mul, hkc, hg, hhc, ← hg, ← act_mul]
    simp
  have hxd : act T g (act T x d) = d' := by
    have hga : act T g a = a := g.property
    dsimp only [x]
    rw [act_mul, act_mul, act_mul, hk, hga, hh, ← act_mul]
    simp
  rw [← hxd, Z_act]
  apply (map_mono (le_iSup (fun y : stabilizer T c => Z T (act T y d)) ⟨x,hxc⟩)).trans
  exact le_iSup (fun y : stabilizer T a => rightConjugate (localZSpan T d c) y) g


variable {L : Subgroup M} {geometry : Geometry T}

/-- The literal (4.5.4)(vi) and (4.5.5) bounds imply the required Frattini-centralizer containment. No Frattini-layer identity is assumed. -/
theorem moved_le_frattiniCentralizer_of_sixthOrbit [Finite M]
    (source : LocalSource L T) (hb : geometry.b T = 8)
    {c d e : Vertex T}
    (hc : (cosetGraph T).dist c (alpha T) ≤ 2)
    (hd : (cosetGraph T).dist d c ≤ 2) (he : (cosetGraph T).dist e d ≤ 2)
    (hcore : core T (alpha T) ≤
      conjugatesIn (conjugatesIn (localZSpan T e d) (stabilizer T c))
        (stabilizer T (alpha T)))
    (hderived :
      ⁅conjugatesIn (conjugatesIn (localZSpan T e d) (stabilizer T c))
          (stabilizer T (alpha T)),
        conjugatesIn (conjugatesIn (localZSpan T e d) (stabilizer T c))
          (stabilizer T (alpha T))⁆ ≤ localZSpan T c (alpha T)) :
    ⁅VBall T (alpha T) 4, Ltilde T (alpha T)⁆ ≤
      core T (alpha T) ⊓ centralizer (frattiniIn (core T (alpha T)) : Set (FreeAmalgam T)) := by
  let E := conjugatesIn (conjugatesIn (localZSpan T e d) (stabilizer T c))
    (stabilizer T (alpha T))
  have hEr : E ≤ VBall T (alpha T) 6 := by
    apply conjugatesIn_le_of_normalized ?_
      (Escape.Propagation.RadiusFour.VBall_normalized (alpha T) 6)
    apply (nestedOrbit_le_radiusFour hd he).trans
    apply Escape.Propagation.RadiusFour.VBall_le_of_dist_add_le (alpha T) c 4 6
    omega
  have hlocal : omegaOneAmbient (localZSpan T e d) = localZSpan T e d := by
    apply le_antisymm (omegaOneAmbient_le _)
    apply iSup_le
    intro g
    rw [← DistanceEight.Z_omegaOne T (act T g e)]
    exact omegaOneAmbient_mono (le_iSup (fun g : stabilizer T d => Z T (act T g e)) g)
  have hE : omegaOneAmbient E = E :=
    conjugatesIn_omegaOne _ _ (conjugatesIn_omegaOne _ _ hlocal)
  apply moved_le_frattiniCentralizer_of_layer source hb E
    (hEr.trans (Escape.Propagation.RadiusFour.VBall_le_Q (alpha T) rfl 6 (by omega))) hcore hE
  exact hderived.trans (localZSpan_le_V T hc)

open CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceSmallModels.LinearThreeBranch.MSSourceModels.NonabelianCenters.CaseFourQuotient.FrattiniCentralizer.Nonabelian

private theorem radiusFourFactors_of_nested_layers [Finite M]
    (source : LocalSource L T) (hb : geometry.b T = 8)
    {c d e c' d' : Vertex T}
    (hc : (cosetGraph T).dist c (alpha T) ≤ 2)
    (hd : (cosetGraph T).dist d c ≤ 2) (he : (cosetGraph T).dist e d ≤ 2)
    (hd' : (cosetGraph T).dist d' (alpha T) ≤ 4)
    (hdcol : color T d' = false)
    (hcritical : CriticalPair T d' d (geometry.exists_critical d' hdcol))
    (g : stabilizer T (alpha T)) (hg : act T g c = c')
    (k : stabilizer T c) (hk : act T k d = alpha T)
    (h : stabilizer T c') (hh : act T h (alpha T) = d')
    (hmoving : conjugatesIn (localZSpan T d c) (stabilizer T (alpha T)) ≤
      ⁅conjugatesIn (localZSpan T d c) (stabilizer T (alpha T)), Ltilde T (alpha T)⁆ ⊔
        localZSpan T c (alpha T))
    (hcore : core T (alpha T) ≤
      conjugatesIn (conjugatesIn (localZSpan T e d) (stabilizer T c))
        (stabilizer T (alpha T)))
    (hderived :
      ⁅conjugatesIn (conjugatesIn (localZSpan T e d) (stabilizer T c))
          (stabilizer T (alpha T)),
        conjugatesIn (conjugatesIn (localZSpan T e d) (stabilizer T c))
          (stabilizer T (alpha T))⁆ ≤ localZSpan T c (alpha T)) :
    Nonempty (RadiusFourFactors T geometry) := by
  let W := conjugatesIn (localZSpan T d c) (stabilizer T (alpha T))
  have hWr : W ≤ VBall T (alpha T) 4 := nestedOrbit_le_radiusFour hc hd
  have hfactor : W ≤ ⁅VBall T (alpha T) 4,Ltilde T (alpha T)⁆ ⊔
      sCenter (VBall T (alpha T) 4) := hmoving.trans
    (sup_le_sup (commutator_mono hWr le_rfl)
      ((localZSpan_le_V T hc).trans (radiusTwo_le_radiusFour_center (by omega))))
  refine ⟨{
    left := d', right := d, left_color := hdcol, critical := hcritical
    left_distance := hd', right_distance := ?_
    left_factor := (opposite_endpoint_le_nestedOrbit g hg k hk h hh).trans hfactor
    right_factor := ((Z_le_localZSpan T d c).trans (le_conjugatesIn _ _)).trans hfactor
    moved_le := moved_le_frattiniCentralizer_of_sixthOrbit source hb hc hd he hcore hderived }⟩
  exact ((cosetGraph_connected T).dist_triangle (u := d) (v := c) (w := alpha T)).trans
    (by omega)


open DistanceEight.PathCentrality.RegularPaths

private theorem extendedPath_step {a : Vertex T} (p : ExtendedPath geometry a)
    (i j : ℕ) (hi : Even i) (hi8 : i ≤ 8) (hj : j ≤ geometry.b T) :
    (cosetGraph T).dist (p.walk.getVert i) (p.walk.getVert (i+j)) = j := by
  have h := (p.window i hi hi8).dist_start (i := j)
    (by rw [(p.window i hi hi8).length_eq_b]; exact hj)
  rwa [p.window_getVert i hi hi8 j hj] at h

/-- Construct the critical endpoints and their central factors from the actual extended path and the three explicitly pending orbit-layer calculations. -/
theorem radiusFourFactors_of_extendedPath [Finite M]
    (source : LocalSource L T) (hb : geometry.b T = 8)
    (p : ExtendedPath geometry (alpha T))
    (hmoving :
      conjugatesIn (localZSpan T (p.walk.getVert 8) (p.walk.getVert 6))
        (stabilizer T (alpha T)) ≤
      ⁅conjugatesIn (localZSpan T (p.walk.getVert 8) (p.walk.getVert 6))
        (stabilizer T (alpha T)), Ltilde T (alpha T)⁆ ⊔
        localZSpan T (p.walk.getVert 6) (alpha T))
    (hcore : core T (alpha T) ≤
      conjugatesIn (conjugatesIn
        (localZSpan T (p.walk.getVert 10) (p.walk.getVert 8))
        (stabilizer T (p.walk.getVert 6))) (stabilizer T (alpha T)))
    (hderived :
      let E := conjugatesIn (conjugatesIn
        (localZSpan T (p.walk.getVert 10) (p.walk.getVert 8))
        (stabilizer T (p.walk.getVert 6))) (stabilizer T (alpha T))
      ⁅E,E⁆ ≤ localZSpan T (p.walk.getVert 6) (alpha T)) :
    Nonempty (RadiusFourFactors T geometry) := by
  obtain ⟨g,hg,hgt⟩ := p.turns 4 (by decide) (by omega) (by omega)
  obtain ⟨k,hk,hkt⟩ := p.turns 6 (by decide) (by omega) (by omega)
  obtain ⟨h,hh,hht⟩ := p.turns 2 (by decide) (by omega) (by omega)
  have hg' : g ∈ stabilizer T (alpha T) := p.center_eq ▸ hg
  have hkt' : act T k (p.walk.getVert 8) = alpha T := by
    simpa only [p.center_eq] using hkt
  have hht' : act T h (alpha T) = p.walk.getVert 0 := by
    simpa only [p.center_eq] using hht
  have hc : (cosetGraph T).dist (p.walk.getVert 6) (alpha T) = 2 := by
    rw [SimpleGraph.dist_comm]
    simpa only [p.center_eq] using
      extendedPath_step p 4 2 (by decide) (by omega) (by omega)
  have hd : (cosetGraph T).dist (p.walk.getVert 8) (p.walk.getVert 6) = 2 := by
    rw [SimpleGraph.dist_comm]
    exact extendedPath_step p 6 2 (by decide) (by omega) (by omega)
  have he : (cosetGraph T).dist (p.walk.getVert 10) (p.walk.getVert 8) = 2 := by
    rw [SimpleGraph.dist_comm]
    exact extendedPath_step p 8 2 (by decide) (by omega) (by omega)
  have hd' : (cosetGraph T).dist (p.walk.getVert 0) (alpha T) = 4 := by
    simpa only [p.center_eq, Nat.zero_add] using
      extendedPath_step p 0 4 (by decide) (by omega) (by omega)
  have hcol : color T (p.walk.getVert 0) = false := by
    simpa only [SimpleGraph.Walk.getVert_zero] using p.start_color
  have hcritical : CriticalPair T (p.walk.getVert 0) (p.walk.getVert 8)
      (geometry.exists_critical _ hcol) := by
    have hp := p.critical 0 (by decide) (by omega)
    rw [hb] at hp
    refine ⟨?_,hp.2⟩
    rw [geometry.distance_constant _ hcol]
    exact hp.1.trans hb.symm
  exact radiusFourFactors_of_nested_layers source hb hc.le hd.le he.le hd'.le hcol hcritical
    ⟨g,hg'⟩ hgt ⟨k,hk⟩ hkt' ⟨h,hh⟩ hht' hmoving hcore hderived

/-- Apply the constructed endpoint factors to the published moved-group and literal source Frattini-centralizer consumers. -/
theorem extendedPath_noncommutation [Finite M]
    (source : LocalSource L T) (common : CommonFacts T source geometry) (hb : geometry.b T = 8)
    (p : ExtendedPath geometry (alpha T))
    (hmoving :
      conjugatesIn (localZSpan T (p.walk.getVert 8) (p.walk.getVert 6))
        (stabilizer T (alpha T)) ≤
      ⁅conjugatesIn (localZSpan T (p.walk.getVert 8) (p.walk.getVert 6))
        (stabilizer T (alpha T)), Ltilde T (alpha T)⁆ ⊔
        localZSpan T (p.walk.getVert 6) (alpha T))
    (hcore : core T (alpha T) ≤
      conjugatesIn (conjugatesIn
        (localZSpan T (p.walk.getVert 10) (p.walk.getVert 8))
        (stabilizer T (p.walk.getVert 6))) (stabilizer T (alpha T)))
    (hderived :
      let E := conjugatesIn (conjugatesIn
        (localZSpan T (p.walk.getVert 10) (p.walk.getVert 8))
        (stabilizer T (p.walk.getVert 6))) (stabilizer T (alpha T))
      ⁅E,E⁆ ≤ localZSpan T (p.walk.getVert 6) (alpha T)) :
    ⁅⁅VBall T (alpha T) 4, Ltilde T (alpha T)⁆,
      ⁅VBall T (alpha T) 4, Ltilde T (alpha T)⁆⁆ ≠ ⊥ ∧
    (let D := core T (alpha T) ⊓
      centralizer (frattiniIn (core T (alpha T)) : Set (FreeAmalgam T));
      ⁅D,D⁆ ≠ ⊥) := by
  obtain ⟨factors⟩ := radiusFourFactors_of_extendedPath source hb p hmoving hcore hderived
  exact ⟨radiusFour_moved_derived_ne_bot common factors,
    source_frattiniCentralizer_derived_ne_bot common factors⟩

/-- Transport the path-produced factors through the actual core isomorphism, using the published finite-core consumer. -/
theorem extendedPath_transport_noncommutation [Finite M] {K R : Subgroup G}
    (source : LocalSource L T) (common : CommonFacts T source geometry) (hb : geometry.b T = 8)
    (p : ExtendedPath geometry (alpha T))
    (hmoving :
      conjugatesIn (localZSpan T (p.walk.getVert 8) (p.walk.getVert 6))
        (stabilizer T (alpha T)) ≤
      ⁅conjugatesIn (localZSpan T (p.walk.getVert 8) (p.walk.getVert 6))
        (stabilizer T (alpha T)), Ltilde T (alpha T)⁆ ⊔
        localZSpan T (p.walk.getVert 6) (alpha T))
    (hcore : core T (alpha T) ≤
      conjugatesIn (conjugatesIn
        (localZSpan T (p.walk.getVert 10) (p.walk.getVert 8))
        (stabilizer T (p.walk.getVert 6))) (stabilizer T (alpha T)))
    (hderived :
      let E := conjugatesIn (conjugatesIn
        (localZSpan T (p.walk.getVert 10) (p.walk.getVert 8))
        (stabilizer T (p.walk.getVert 6))) (stabilizer T (alpha T))
      ⁅E,E⁆ ≤ localZSpan T (p.walk.getVert 6) (alpha T))
    (f : core T (alpha T) ≃* msQ K R) :
    let D := msQ K R ⊓ centralizer (frattiniIn (msQ K R) : Set G)
    ⁅D,D⁆ ≠ ⊥ := by
