variable {G : Type*} [Group G]

private theorem frattini_le_derived_of_involutions (E : Subgroup G) [Finite E]
    (hp : IsPGroup 2 E) (ho : omegaOneAmbient E = E) :
    frattiniIn E ≤ ⁅E,E⁆ := by
  let f : E →* Abelianization E := (powMonoidHom 2).comp Abelianization.of
  have hker : E ≤ f.ker.map E.subtype := by
    apply ho.ge.trans
    apply (omegaOneAmbient_le_iff _ _).mpr
    intro x hx hx2
    refine ⟨⟨x,hx⟩, ?_, rfl⟩
    change (Abelianization.of (⟨x,hx⟩ : E)) ^ 2 = 1
    have hx2' : (⟨x,hx⟩ : E)^2 = 1 := Subtype.ext hx2
    rw [← map_pow, hx2', map_one]
  have hsquare (x : E) : x ^ 2 ∈ commutator E := by
    obtain ⟨y,hy,heq⟩ := hker x.property
    have hyx : y = x := Subtype.ext heq
    subst y
    rw [← Abelianization.ker_of, MonoidHom.mem_ker, map_pow]
    exact hy
  change (frattini E).map E.subtype ≤ _
  apply (map_mono (show frattini E ≤ commutator E from ?_)).trans
    (map_subtype_commutator E).le
  rw [hp.frattini_eq_closure_squares]
  exact (closure_le _).mpr (by rintro _ ⟨x,rfl⟩; exact hsquare x)

private theorem frattini_le_of_involution_overgroup {P E : Subgroup G} [Finite E]
    (hPE : P ≤ E) (hp : IsPGroup 2 E) (ho : omegaOneAmbient E = E) :
    frattiniIn P ≤ ⁅E,E⁆ := by
  let : Finite P := Finite.of_injective (inclusion hPE) (inclusion_injective hPE)
  let : Fact (IsPGroup 2 E) := ⟨hp⟩
  let : Fact (IsPGroup 2 P) := ⟨hp.of_injective (inclusion hPE) (inclusion_injective hPE)⟩
  have hh := map_mono (f := E.subtype) (frattini_map_le_of_isPGroup (p := 2) (inclusion hPE))
  have hphi : frattiniIn P ≤ frattiniIn E := by
    simpa only [frattiniIn, map_map, subtype_comp_inclusion] using hh
  exact hphi.trans (frattini_le_derived_of_involutions E hp ho)

variable {M : Type*} [Group M] {T L : Subgroup M} {geometry : Geometry T}
/-- Distance alone puts the moved radius-four subgroup in the literal commutator core. -/
theorem radiusFour_moved_le_core (hb : 4 < geometry.b T) :
    ⁅VBall T (alpha T) 4, Ltilde T (alpha T)⁆ ≤ core T (alpha T) :=
  commutator_mono (Escape.Propagation.RadiusFour.VBall_le_Q (alpha T) rfl 4 hb) le_rfl

/-- The radius-two group lies in the actual radius-four center when b > 6. -/
theorem radiusTwo_le_radiusFour_center (hb : 6 < geometry.b T) :
    V T (alpha T) ≤ sCenter (VBall T (alpha T) 4) := by
  rw [centerIn_eq]
  refine le_inf ?_ ?_
  · apply Escape.Propagation.RadiusFour.VBall_le_of_dist_add_le (alpha T) (alpha T) 2 4
    simp
  · apply le_centralizer_iff.mp
    apply commutator_eq_bot_iff_le_centralizer.mp
    exact DistanceEight.PathCentrality.RegularPaths.CommutatorPropagation.Iteration.balls_commute
      (geometry := geometry) (a := alpha T) (m := 4) (n := 2) rfl hb

private theorem moved_le_frattiniCentralizer_of_layer [Finite M] (source : LocalSource L T)
    (hb : geometry.b T = 8) (E : Subgroup (FreeAmalgam T))
    (hEQ : E ≤ Q T (alpha T)) (hcore : core T (alpha T) ≤ E)
    (ho : omegaOneAmbient E = E) (hderived : ⁅E,E⁆ ≤ V T (alpha T)) :
    ⁅VBall T (alpha T) 4, Ltilde T (alpha T)⁆ ≤
      core T (alpha T) ⊓ centralizer (frattiniIn (core T (alpha T)) : Set (FreeAmalgam T)) := by
  have hb4 : 4 < geometry.b T := by omega
  have hb6 : 6 < geometry.b T := by omega
  have hQS : Q T (alpha T) ≤ stabilizer T (alpha T) := fun _ hx => hx.1
  let := finite_stabilizer T (alpha T)
  let : Finite E := Finite.of_injective (inclusion (hEQ.trans hQS))
    (inclusion_injective (hEQ.trans hQS))
  have hp : IsPGroup 2 E := (Q_isPGroup T source.two_group source.core_le (alpha T) rfl).of_injective
    (inclusion hEQ) (inclusion_injective hEQ)
  have hphi := (frattini_le_of_involution_overgroup hcore hp ho).trans hderived
  have hmoved : ⁅VBall T (alpha T) 4, Ltilde T (alpha T)⁆ ≤ VBall T (alpha T) 4 :=
    le_normalizer_iff_commutator_le_left.mp ((map_subtype_le _).trans
      (Escape.Propagation.RadiusFour.VBall_normalized (alpha T) 4))
  refine le_inf (radiusFour_moved_le_core hb4) ?_
  have hc : V T (alpha T) ≤ centralizer (VBall T (alpha T) 4 : Set (FreeAmalgam T)) :=
    (radiusTwo_le_radiusFour_center hb6).trans ((centerIn_eq _).le.trans inf_le_right)
  exact hmoved.trans ((le_centralizer_iff.mp hc).trans (centralizer_le hphi))

