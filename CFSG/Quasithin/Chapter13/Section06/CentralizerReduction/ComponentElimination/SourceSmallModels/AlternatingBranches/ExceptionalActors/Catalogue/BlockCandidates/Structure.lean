module

public import CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceSmallModels.AlternatingBranches.ExceptionalActors.Catalogue.Coordinates
public import Theory.SpecificGroups.AlternatingSeven.ThreeResidualLocals.ModelNormalizers.BlockCalculations
public import Mathlib.GroupTheory.SpecificGroups.Alternating.KleinFour
public import Mathlib.GroupTheory.SpecificGroups.Cyclic

/-!
# The four literal block candidates

The twelve-word parametrizations construct genuine A₄ isomorphisms for the
natural and both diagonal embeddings. Their embedded two-cores coincide with
the four-group generated by the marked double transposition and its conjugate.
Odd-order generators prove two-perfectness directly; the actual core quotients
have order three and are identified with `Multiplicative (ZMod 3)`.
The block action checks prove normalization and distinguish all four candidates.

These calculations supply the group structures in the exceptional A₇ branch
of Aschbacher–Smith, combined manuscript of 1 March 2004, Lemma 13.6.22,
printed p.932. Exhaustion and the representation-dependent selection are separate.
-/

@[expose] public section
open Subgroup Equiv
namespace CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceSmallModels.AlternatingBranches.ExceptionalActors.Catalogue

def fourActor (k : Fin 3) : Subgroup A7 := closure {naturalThree * tailThree ^ k.val, fourFlip}

def words {G : Type*} [Group G] (x y : G) : Fin 12 → G := ![
  1, x, y, x * x, x * y, y * x, x * x * y, x * y * x, y * x * x,
  y * x * y, x * x * y * x, x * y * x * x]

private theorem words_mem {G : Type*} [Group G] (H : Subgroup G) (x y : G)
    (hx : x ∈ H) (hy : y ∈ H) (i : Fin 12) : words x y i ∈ H := by
  fin_cases i <;> simp only [words]
  all_goals first | exact H.one_mem | exact hx | exact hy | apply H.mul_mem
  all_goals first | exact hx | exact hy | apply H.mul_mem
  all_goals first | exact hx | exact hy | apply H.mul_mem
  all_goals first | exact hx | exact hy

def actorWord (k : Fin 3) : Fin 12 → A7 := words (naturalThree * tailThree ^ k.val) fourFlip

def a4Three : alternatingGroup (Fin 4) :=
  ⟨swap 0 1 * swap 1 2, by rw [Perm.mem_alternatingGroup]; decide⟩
def a4Flip : alternatingGroup (Fin 4) :=
  ⟨swap 0 1 * swap 2 3, by rw [Perm.mem_alternatingGroup]; decide⟩
def a4Word : Fin 12 → alternatingGroup (Fin 4) := words a4Three a4Flip

local instance : Fintype (Perm (Fin 4)) := fintypePerm
local instance : Fintype (Perm (Fin 3)) := fintypePerm
private instance : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩

theorem a4Word_bijective : Function.Bijective a4Word := by decide +kernel

theorem actorWord_injective (k : Fin 3) : Function.Injective (actorWord k) := by
  decide +revert +kernel

theorem word_mul (k : Fin 3) (i j : Fin 12) : ∃ l : Fin 12,
    a4Word i * a4Word j = a4Word l ∧ actorWord k i * actorWord k j = actorWord k l := by
  decide +revert +kernel

noncomputable def a4WordEquiv : Fin 12 ≃ alternatingGroup (Fin 4) :=
  Equiv.ofBijective a4Word a4Word_bijective

noncomputable def fourHom (k : Fin 3) : alternatingGroup (Fin 4) →* A7 where
  toFun g := actorWord k (a4WordEquiv.symm g)
  map_one' := by
    have he : a4WordEquiv 0 = 1 := rfl
    rw [← he, Equiv.symm_apply_apply]
    rfl
  map_mul' g h := by
    obtain ⟨i, rfl⟩ := a4WordEquiv.surjective g
    obtain ⟨j, rfl⟩ := a4WordEquiv.surjective h
    obtain ⟨l, hl, hl'⟩ := word_mul k i j
    change a4WordEquiv i * a4WordEquiv j = a4WordEquiv l at hl
    rw [hl, Equiv.symm_apply_apply, Equiv.symm_apply_apply, Equiv.symm_apply_apply]
    exact hl'.symm

theorem fourHom_word (k : Fin 3) (i : Fin 12) : fourHom k (a4Word i) = actorWord k i :=
  congrArg (actorWord k) (a4WordEquiv.symm_apply_apply i)

theorem fourHom_injective (k : Fin 3) : Function.Injective (fourHom k) :=
  (actorWord_injective k).comp a4WordEquiv.symm.injective

theorem fourHom_range (k : Fin 3) : (fourHom k).range = fourActor k := by
  apply le_antisymm
  · rintro _ ⟨g, rfl⟩
    exact words_mem _ _ _ (subset_closure (by simp))
      (subset_closure (by simp)) _
  · apply (closure_le _).mpr
    rintro g (rfl | rfl)
    · exact ⟨a4Word 1, fourHom_word k 1⟩
    · exact ⟨a4Word 2, fourHom_word k 2⟩

noncomputable def fourActorEquiv (k : Fin 3) : alternatingGroup (Fin 4) ≃* fourActor k :=
  (MonoidHom.ofInjective (fourHom_injective k)).trans
    (MulEquiv.subgroupCongr (fourHom_range k))

theorem mem_fourActor_iff (k : Fin 3) (g : A7) :
    g ∈ fourActor k ↔ ∃ i : Fin 12, actorWord k i = g := by
  rw [← fourHom_range]
  constructor
  · rintro ⟨g, rfl⟩
    exact ⟨a4WordEquiv.symm g, rfl⟩
  · rintro ⟨i, rfl⟩
    exact ⟨a4Word i, fourHom_word k i⟩

theorem fourActor_zero : fourActor 0 = naturalActor := by simp [fourActor, naturalActor]
theorem fourActor_one : fourActor 1 = diagonalPlus := by simp [fourActor, diagonalPlus]
theorem fourActor_two : fourActor 2 = diagonalMinus := rfl

theorem fourActor_card (k : Fin 3) : Nat.card (fourActor k) = 12 := by
  rw [← Nat.card_congr (fourActorEquiv k).toEquiv]
  exact alternatingGroup.card_of_card_eq_four (by simp)

private theorem a4_twoPerfect : IsPPerfect 2 (alternatingGroup (Fin 4)) := by
  apply (pResidual_eq_top_iff _ _).mp
  apply top_unique
  intro g _
  obtain ⟨i, rfl⟩ := a4Word_bijective.surjective g
  have hx : a4Three ∈ pResidual 2 (alternatingGroup (Fin 4)) :=
    mem_pResidual_of_orderOf_coprime ((by decide : Nat.Coprime 2 3).of_dvd_right
      (orderOf_dvd_of_pow_eq_one (by decide +kernel : a4Three ^ 3 = 1)))
  have hxy : a4Three * a4Flip ∈ pResidual 2 (alternatingGroup (Fin 4)) :=
    mem_pResidual_of_orderOf_coprime ((by decide : Nat.Coprime 2 3).of_dvd_right
      (orderOf_dvd_of_pow_eq_one (by decide +kernel : (a4Three * a4Flip) ^ 3 = 1)))
  have hy := (pResidual 2 (alternatingGroup (Fin 4))).mul_mem
    ((pResidual 2 (alternatingGroup (Fin 4))).inv_mem hx) hxy
  simp only [inv_mul_cancel_left] at hy
  exact words_mem _ _ _ hx hy i

theorem fourActor_twoPerfect (k : Fin 3) : IsPPerfect 2 (fourActor k) :=
  a4_twoPerfect.of_surjective (fourActorEquiv k).toMonoidHom (fourActorEquiv k).surjective

private theorem a4_core_eq : pCore 2 (alternatingGroup (Fin 4)) =
    alternatingGroup.kleinFour (Fin 4) := by
  obtain ⟨S : Sylow 2 (alternatingGroup (Fin 4))⟩ := Sylow.nonempty (G := alternatingGroup (Fin 4))
  have he := alternatingGroup.two_sylow_eq_kleinFour_of_card_eq_four (by simp) S
  apply le_antisymm
  · rw [← he]
    exact pCore_isPGroup.le_sylow_of_normal S
  · exact le_sSup ⟨alternatingGroup.normal_kleinFour (by simp), he ▸ S.isPGroup'⟩

private theorem a4_core_generated : pCore 2 (alternatingGroup (Fin 4)) =
    closure {a4Flip, a4Three * a4Flip * a4Three⁻¹} := by
  rw [a4_core_eq]
  have hy : a4Flip ∈ alternatingGroup.kleinFour (Fin 4) := by
    rw [← SetLike.mem_coe, alternatingGroup.coe_kleinFour_of_card_eq_four (by simp)]
    decide +kernel
  have hy' : a4Three * a4Flip * a4Three⁻¹ ∈ alternatingGroup.kleinFour (Fin 4) := by
    rw [← SetLike.mem_coe, alternatingGroup.coe_kleinFour_of_card_eq_four (by simp)]
    decide +kernel
  apply le_antisymm
  · intro g hg
    have ht : ∀ g : alternatingGroup (Fin 4),
        g = 1 ∨ g.val.cycleType = {2, 2} →
        ∃ i j : Fin 2, g = a4Flip ^ i.val * (a4Three * a4Flip * a4Three⁻¹) ^ j.val := by
      decide +kernel
    have hg' : g = 1 ∨ g.val.cycleType = {2, 2} := by
      change g ∈ (alternatingGroup.kleinFour (Fin 4) : Set (alternatingGroup (Fin 4))) at hg
      rw [alternatingGroup.coe_kleinFour_of_card_eq_four (by simp)] at hg
      exact hg
    obtain ⟨i, j, rfl⟩ := ht g hg'
    exact (Subgroup.closure _).mul_mem ((Subgroup.closure _).pow_mem (subset_closure (by simp)) _)
      ((Subgroup.closure _).pow_mem (subset_closure (by simp)) _)
  · exact (closure_le _).mpr (by simpa only [Set.pair_subset_iff, SetLike.mem_coe] using And.intro hy hy')

/-- The common four-group, as a literal subgroup of A₇. -/
def commonFour : Subgroup A7 := closure {fourFlip, naturalThree * fourFlip * naturalThree⁻¹}

private theorem fourHom_core (k : Fin 3) :
    (pCore 2 (alternatingGroup (Fin 4))).map (fourHom k) = commonFour := by
  rw [a4_core_generated, MonoidHom.map_closure, Set.image_pair, map_mul, map_mul, map_inv]
  have hx : fourHom k a4Three = naturalThree * tailThree ^ k.val := fourHom_word k 1
  have hy : fourHom k a4Flip = fourFlip := fourHom_word k 2
  rw [hx, hy]
  clear hx hy
  have he : (naturalThree * tailThree ^ k.val) * fourFlip *
      (naturalThree * tailThree ^ k.val)⁻¹ = naturalThree * fourFlip * naturalThree⁻¹ := by
    decide +revert +kernel
  rw [he]
  rfl

theorem fourActor_core (k : Fin 3) :
    (pCore 2 (fourActor k)).map (fourActor k).subtype = commonFour := by
  rw [← pCore_map_iso 2 (fourActorEquiv k), map_map]
  exact fourHom_core k

theorem fourActor_core_card (k : Fin 3) : Nat.card (pCore 2 (fourActor k)) = 4 := by
  rw [← pCore_map_iso 2 (fourActorEquiv k), card_map_of_injective (fourActorEquiv k).injective,
    a4_core_eq]
  exact alternatingGroup.kleinFour_card_of_card_eq_four (by simp)

theorem commonFour_card : Nat.card commonFour = 4 := by
  rw [← fourActor_core 0, card_map_of_injective (fourActor 0).subtype_injective,
    fourActor_core_card]

/-- The common embedded core is a Klein four-group, not merely a group of order four. -/
theorem commonFour_isKleinFour : IsKleinFour commonFour := by
  let e : pCore 2 (alternatingGroup (Fin 4)) ≃* commonFour :=
    ((pCore 2 (alternatingGroup (Fin 4))).equivMapOfInjective
      (fourHom 0) (fourHom_injective 0)).trans (MulEquiv.subgroupCongr (fourHom_core 0))
  refine ⟨commonFour_card, ?_⟩
  rw [← Monoid.exponent_eq_of_mulEquiv e, a4_core_eq]
  exact alternatingGroup.exponent_kleinFour_of_card_eq_four (by simp)

theorem fourActor_quotient_card (k : Fin 3) : Nat.card (fourActor k ⧸ pCore 2 (fourActor k)) = 3 := by
  have hc := card_eq_card_quotient_mul_card_subgroup (pCore 2 (fourActor k))
  rw [fourActor_card, fourActor_core_card] at hc
  omega

noncomputable def fourActorQuotientEquiv (k : Fin 3) :
    (fourActor k ⧸ pCore 2 (fourActor k)) ≃* Multiplicative (ZMod 3) :=
  mulEquivOfPrimeCardEq (fourActor_quotient_card k) (by simp)

theorem tailThree_order : orderOf tailThree = 3 := by
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  apply orderOf_eq_prime_iff.mpr
  decide +kernel

theorem cyclicActor_card : Nat.card cyclicActor = 3 := by
  rw [cyclicActor, Nat.card_zpowers, tailThree_order]

theorem cyclicActor_twoPerfect : IsPPerfect 2 cyclicActor := by
  apply (pResidual_eq_top_iff _ _).mp
  apply top_unique
  intro g _
  exact mem_pResidual_of_orderOf_coprime
    ((show Nat.Coprime 2 (Nat.card cyclicActor) by rw [cyclicActor_card]; decide).of_dvd_right
      (_root_.orderOf_dvd_natCard g))

theorem cyclicActor_core : pCore 2 cyclicActor = ⊥ := by
  have hd := (pCore 2 cyclicActor).card_subgroup_dvd_card
  rw [cyclicActor_card] at hd
  have hc := (pCore_isPGroup (p := 2) (G := cyclicActor)).exists_card_dvd_pow
  obtain ⟨n, hn⟩ := hc
  apply card_eq_one.mp
  exact Nat.eq_one_of_dvd_coprimes ((by decide : Nat.Coprime 2 3).pow_left n) hn hd

theorem cyclicActor_quotient_card : Nat.card (cyclicActor ⧸ pCore 2 cyclicActor) = 3 := by
  rw [cyclicActor_core]
  exact (Nat.card_congr (QuotientGroup.quotientBot (G := cyclicActor)).toEquiv).trans cyclicActor_card

noncomputable def cyclicActorQuotientEquiv :
    (cyclicActor ⧸ pCore 2 cyclicActor) ≃* Multiplicative (ZMod 3) :=
  mulEquivOfPrimeCardEq cyclicActor_quotient_card (by simp)

private theorem block_conjugates (k : Fin 3) (p : Perm (Fin 4) × Perm (Fin 3))
    (hp : AlternatingSeven.ThreeResidualLocals.blockHom p ∈ alternatingGroup (Fin 7)) :
    (∃ i : Fin 12, (actorWord k i).val =
      AlternatingSeven.ThreeResidualLocals.blockHom p *
        (naturalThree * tailThree ^ k.val).val *
        (AlternatingSeven.ThreeResidualLocals.blockHom p)⁻¹) ∧
    (∃ i : Fin 12, (actorWord k i).val =
      AlternatingSeven.ThreeResidualLocals.blockHom p * fourFlip.val *
        (AlternatingSeven.ThreeResidualLocals.blockHom p)⁻¹) := by
  rcases p with ⟨p, q⟩
  fin_cases k <;> fin_cases q <;> decide +revert +kernel

theorem block_normalizes_fourActor (k : Fin 3) :
    blockStabilizer ≤ normalizer (fourActor k : Set A7) := by
  classical
  intro g hg
  have hg' : g.val ∈ AlternatingSeven.ThreeResidualLocals.blockHom.range := by
    rw [AlternatingSeven.ThreeResidualLocals.blockHom_range]
    exact hg
  obtain ⟨p, hp⟩ := hg'
  have hc := block_conjugates k p (hp.symm ▸ g.property)
  rw [hp] at hc
  have hn : (fourActor k).map (MulAut.conj g).toMonoidHom ≤ fourActor k := by
    rw [fourActor, MonoidHom.map_closure, closure_le]
    rintro _ ⟨x, hx, rfl⟩
    change g * x * g⁻¹ ∈ fourActor k
    apply (mem_fourActor_iff k _).mpr
    rcases hx with rfl | rfl
    · obtain ⟨i, hi⟩ := hc.1
      exact ⟨i, Subtype.ext hi⟩
    · obtain ⟨i, hi⟩ := hc.2
      exact ⟨i, Subtype.ext hi⟩
  apply mem_normalizer_fintype
  intro x hx
  exact hn ⟨x, hx, rfl⟩

private theorem block_conjugates_tail (p : Perm (Fin 4) × Perm (Fin 3)) :
    ∃ i : Fin 3, tailThree.val ^ i.val =
      AlternatingSeven.ThreeResidualLocals.blockHom p * tailThree.val *
        (AlternatingSeven.ThreeResidualLocals.blockHom p)⁻¹ := by
  decide +revert +kernel

theorem block_normalizes_cyclicActor : blockStabilizer ≤ normalizer (cyclicActor : Set A7) := by
  classical
  intro g hg
  have hg' : g.val ∈ AlternatingSeven.ThreeResidualLocals.blockHom.range := by
    rw [AlternatingSeven.ThreeResidualLocals.blockHom_range]
    exact hg
  obtain ⟨p, hp⟩ := hg'
  obtain ⟨i, hi⟩ := block_conjugates_tail p
  rw [hp] at hi
  have hn : (cyclicActor).map (MulAut.conj g).toMonoidHom ≤ cyclicActor := by
    rw [cyclicActor, MonoidHom.map_zpowers, zpowers_le]
    have he : tailThree ^ i.val = g * tailThree * g⁻¹ := Subtype.ext hi
    change g * tailThree * g⁻¹ ∈ zpowers tailThree
    rw [← he]
    exact npow_mem_zpowers _ _
  apply mem_normalizer_fintype
  intro x hx
  exact hn ⟨x, hx, rfl⟩

theorem fourActor_injective : Function.Injective fourActor := by
  intro k l he
  have hx : naturalThree * tailThree ^ k.val ∈ fourActor l :=
    he ▸ subset_closure (by simp)
  obtain ⟨i, hi⟩ := (mem_fourActor_iff l _).mp hx
  have hc : ∀ k l : Fin 3, ∀ i : Fin 12,
      actorWord l i = naturalThree * tailThree ^ k.val → k = l := by
    decide +kernel
  exact hc k l i hi

theorem cyclicActor_ne_fourActor (k : Fin 3) : cyclicActor ≠ fourActor k := by
  intro he
  have hc := congrArg (fun H : Subgroup A7 => Nat.card H) he
  rw [cyclicActor_card, fourActor_card] at hc
  omega

end CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceSmallModels.AlternatingBranches.ExceptionalActors.Catalogue
