module

public import CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceSmallModels.AlternatingBranches.CoveredSix.Action
public import CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceSmallModels.AlternatingBranches.BlockQuotient
public import Theory.Representation.BinaryOffender.CentralSectionSplitting

/-!
# Vanishing of the cubic norm on a covered-six block

Irreducibility in the block definition concerns U/C_U(K). For a nonidentity
central actor, its fixed space gives a normal subgroup in precisely this
interval. Faithfulness excludes the upper endpoint, so its fixed vectors
are globally fixed. The cubic norm has image in that fixed space; the
literal group identity [U,K]=U then forces the norm to vanish on U itself.
No irreducibility or fixed-space conclusion on U is assumed.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004, C.1.7 and
C.1.22, printed pp.123 and 129; the field-module application is K.1.3,
printed p.453, and the covered-six branch of 13.6.22, printed p.932.
-/

@[expose] public section

open Subgroup CFSG.Quasithin.ChapterC Theory.GroupTheory Representation
open Representation.BinaryOffender
open scoped IsMulCommutative commutatorElement
namespace CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceSmallModels.AlternatingBranches.CoveredSix
variable {K : Type*} [Group K] (h : IsExceptionalAhat6Block K)
variable [IsElementaryAbelian 2 (blockU K)]

private def ambientSpace (S : Submodule (ZMod 2) (Additive (blockU K))) : Subgroup K :=
  S.toAddSubgroup.toSubgroup'.map (blockU K).subtype

private theorem mem_ambientSpace (S : Submodule (ZMod 2) (Additive (blockU K)))
    (v : Additive (blockU K)) : (v.toMul : K) ∈ ambientSpace S ↔ v ∈ S := by
  constructor
  · rintro ⟨w, hw, he⟩
    have hh : w = v.toMul := Subtype.ext he
    subst w
    exact hw
  · intro hv
    exact ⟨v.toMul, hv, rfl⟩

private theorem ambientSpace_normal (S : Submodule (ZMod 2) (Additive (blockU K)))
    (hs : ∀ g v, v ∈ S → binaryAction h g v ∈ S) : (ambientSpace S).Normal := by
  constructor
  rintro x ⟨v, hv, rfl⟩ k
  refine ⟨(binaryAction h (QuotientGroup.mk' (pCore 2 K) k) (Additive.ofMul v)).toMul,
    hs _ _ hv, ?_⟩
  exact binaryAction_apply h k _

/-- The original six-space is generated by its actual quotient-action commutators. -/
theorem binaryAction_fully_moved : subspaceCommutator (binaryAction h) ⊤ ⊤ = ⊤ := by
  let S := subspaceCommutator (binaryAction h) ⊤ ⊤
  have hc : ⁅(⊤ : Subgroup K), blockU K⁆ ≤ ambientSpace S := by
    apply commutator_le.mpr
    intro k _ u hu
    let v : Additive (blockU K) := Additive.ofMul ⟨u, hu⟩
    have hv : binaryAction h (QuotientGroup.mk' (pCore 2 K) k) v - v ∈ S :=
      Submodule.subset_span ⟨_, mem_top _, v, Submodule.mem_top, rfl⟩
    refine ⟨(binaryAction h (QuotientGroup.mk' (pCore 2 K) k) v - v).toMul, hv, ?_⟩
    change ((binaryAction h (QuotientGroup.mk' (pCore 2 K) k) v).toMul : K) / u = _
    rw [div_eq_mul_inv, binaryAction_apply]
    rfl
  rw [commutator_comm, short_module_commutator h.1] at hc
  apply top_unique
  intro v _
  exact (mem_ambientSpace S v).mp (hc v.toMul.property)

private theorem fixed_of_center (v : Additive (blockU K))
    (hv : (v.toMul : K) ∈ center K) (g : K ⧸ pCore 2 K) : binaryAction h g v = v := by
  obtain ⟨k, rfl⟩ := QuotientGroup.mk'_surjective (pCore 2 K) g
  apply Additive.toMul.injective
  apply Subtype.ext
  rw [binaryAction_apply, (mem_center_iff.mp hv k), mul_inv_cancel_right]

/-- A nonidentity central actor has exactly the global fixed vectors. This uses
only irreducibility of U/C_U(K), not irreducibility of U. -/
theorem central_fixed_is_global (z : K ⧸ pCore 2 K)
    (hz : z ∈ center (K ⧸ pCore 2 K)) (hne : z ≠ 1)
    (v : Additive (blockU K)) (hv : binaryAction h z v = v) :
    v ∈ fixedSpace (binaryAction h) ⊤ := by
  let ρ := binaryAction h
  have hcomm (g : K ⧸ pCore 2 K) (w : Additive (blockU K)) :
      ρ z (ρ g w) = ρ g (ρ z w) := by
    change (ρ z * ρ g) w = (ρ g * ρ z) w
    rw [← map_mul, ← map_mul, (mem_center_iff.mp hz g).symm]
  let S := (ρ z - 1).ker
  have hs : ∀ g w, w ∈ S → ρ g w ∈ S := by
    intro g w hw
    change ρ z w - w = 0 at hw
    change ρ z (ρ g w) - ρ g w = 0
    rw [hcomm, sub_eq_zero.mp hw, sub_self]
  have hlow : blockU K ⊓ center K ≤ ambientSpace S := by
    intro u hu
    apply (mem_ambientSpace S (Additive.ofMul ⟨u, hu.1⟩)).mpr
    change ρ z (Additive.ofMul ⟨u, hu.1⟩) - Additive.ofMul ⟨u, hu.1⟩ = 0
    rw [fixed_of_center h (Additive.ofMul ⟨u, hu.1⟩) hu.2, sub_self]
  have he : ambientSpace S = blockU K ⊓ center K := by
    rcases h.1.irreducible.2 (ambientSpace S) (ambientSpace_normal h S hs)
      hlow (map_subtype_le _) with he | he
    · exact he
    · exfalso
      apply hne
      apply binaryAction_injective h
      rw [map_one]
      apply LinearMap.ext
      intro w
      have hw : w ∈ S := (mem_ambientSpace S w).mp (by rw [he]; exact w.toMul.property)
      exact sub_eq_zero.mp hw
  have hvc : (v.toMul : K) ∈ center K := by
    have hm : (v.toMul : K) ∈ ambientSpace S := by
      apply (mem_ambientSpace S v).mpr
      change ρ z v - v = 0
      exact sub_eq_zero.mpr hv
    rw [he] at hm
    exact hm.2
  intro g
  exact fixed_of_center h v hvc g

/-- The cubic norm vanishes on the original U. No fixed-space vanishing is assumed. -/
theorem central_cubic_quadratic (z : K ⧸ pCore 2 K)
    (hz : z ∈ center (K ⧸ pCore 2 K)) (hne : z ≠ 1) (hz3 : z ^ 3 = 1) :
    binaryAction h z ^ 2 + binaryAction h z + 1 = 0 := by
  let ρ := binaryAction h
  have hc (v : Additive (blockU K)) : ρ z (ρ z (ρ z v)) = v := by
    have hp : ρ z ^ 3 = 1 := by rw [← map_pow, hz3, map_one]
    simpa only [pow_succ, pow_zero, one_mul, Module.End.mul_apply,
      Module.End.one_apply] using LinearMap.congr_fun hp v
  have hn (v : Additive (blockU K)) : centralCubicNorm ρ z v ∈ fixedSpace ρ ⊤ := by
    apply central_fixed_is_global h z hz hne
    rw [centralCubicNorm_apply, map_add, map_add, hc]
    abel
  have hzero := centralCubicNorm_eq_zero_on_commutator ρ ⊤ ⊤
    (binaryAction_fully_moved h) z (fun g _ => (mem_center_iff.mp hz g).symm)
    (fun v _ => hn v)
  apply LinearMap.ext
  intro v
  exact hzero v Submodule.mem_top

end CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceSmallModels.AlternatingBranches.CoveredSix
