module

public import CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceSmallModels.AlternatingBranches.CoveredSix.MarkedPlane.Assembly
public import Stellmacher.ElementaryAbelianMaxJFixedCenter

/-!
# The literal Thompson image and its Baumann fixed vectors

The selected component is generated by its commutators with J(Tᵥ) in the
star action. Restricting to the actual actor and applying the star-to-plus
map proves the same identity in the plus action, so J(Tᵥ)⁺ is nontrivial.

Every elementary vector in Tᵥ centralizing J(Tᵥ) belongs to Ω₁(Z(J(Tᵥ))).
Consequently Baum(Tᵥ)⁺ fixes the entire fixed space of J(Tᵥ)⁺ on W_K.
Identifying J(Tᵥ)⁺ as the pointwise kernel therefore proves equality of the
two images without changing either original subgroup.

This is preparation for the covered-six marking, not its completion. The
offender geometry identifying the nontrivial Thompson image as a four-group
and its comparison with the original block layer are still required.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004, B.2.3,
printed pp.74–75, and 13.6.14 and 13.6.22, printed pp.929 and 932.
-/

@[expose] public section
open Subgroup Stellmacher Representation Representation.BinaryOffender
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceSmallModels.AlternatingBranches.CoveredSix.ThompsonImage
open CFSG.Quasithin.Chapter13.Section06.CentralizerReduction ComponentSelection
variable {G : Type*} [Group G]

private theorem thompson_le (S : Subgroup G) : elementaryAbelianMaxJ S ≤ S :=
  sSup_le fun _ hA => hA.1

private theorem thompson_le_baumann (S : Subgroup G) :
    elementaryAbelianMaxJ S ≤ ChapterB.baumann S := by
  refine le_inf (thompson_le S) ?_
  intro j hj w hw
  exact (((mem_omegaOneCenterAmbient_iff _ _).mp hw).2.2 j hj).symm

/-- Selection in Y_z gives commutator generation in the literal plus quotient.
The restriction to the star image of the plus actor is part of the proof. -/
theorem component_commutator_thompson
    (K L T : Subgroup G) (z v : G)
    (hK : K ∈ Yz L T z v) (hn : Tv T v ≤ normalizer (K : Set G))
    (hL : Tv T v ≤ normalizer (Lv L v : Set G))
    (hz : Tv T v ≤ centralizer ({z} : Set G)) :
    ⁅plusImage K L T z v hL hz K,
      plusImage K L T z v hL hz (elementaryAbelianMaxJ (Tv T v))⁆ =
        plusImage K L T z v hL hz K := by
  let H := starImage z v (plusActor K L T v)
  let C := starImage z v K
  let J := starImage z v (elementaryAbelianMaxJ (Tv T v))
  have hCH : C ≤ H := map_mono (comap_mono (K_le_plusActor K L T v))
  have hJH : J ≤ H := map_mono (comap_mono ((thompson_le _).trans le_sup_right))
  have hc : ⁅C, J⁆ = C :=
    (invariant_component_consequences K L T z v hK hn).1.1.2.2.2
  have hr : ⁅C.subgroupOf H, J.subgroupOf H⁆ = C.subgroupOf H := by
    apply map_injective H.subtype_injective
    rw [map_commutator, map_subgroupOf_eq_of_le hCH,
      map_subgroupOf_eq_of_le hJH, hc]
  have hm := congrArg (map (starToPlus K L T z v hK.1.1 hL hz)) hr
  rw [map_commutator] at hm
  simpa only [C, J, H,
    starToPlus_image K L T z v hK.1.1 hL hz K (K_le_plusActor K L T v),
    starToPlus_image K L T z v hK.1.1 hL hz (elementaryAbelianMaxJ (Tv T v))
      ((thompson_le _).trans le_sup_right)] using hm

/-- The actual Thompson image is nontrivial; it is not an arbitrary chosen
offender or four-subgroup. -/
theorem thompson_plus_ne_bot
    (K L T : Subgroup G) (z v : G)
    (hK : K ∈ Yz L T z v) (hn : Tv T v ≤ normalizer (K : Set G))
    (hL : Tv T v ≤ normalizer (Lv L v : Set G))
    (hz : Tv T v ≤ centralizer ({z} : Set G)) :
    plusImage K L T z v hL hz (elementaryAbelianMaxJ (Tv T v)) ≠ ⊥ := by
  intro he
  have hc := component_commutator_thompson K L T z v hK hn hL hz
  rw [he, commutator_bot_right] at hc
  exact plusImage_ne_bot_of_mem_Yz K L T z v hL hz hK hc.symm

/-- Some member of the original maximum-elementary family has nontrivial
plus image. This supplies nonemptiness before any offender classification. -/
theorem exists_maximum_moving
    (K L T : Subgroup G) (z v : G)
    (hK : K ∈ Yz L T z v) (hn : Tv T v ≤ normalizer (K : Set G))
    (hL : Tv T v ≤ normalizer (Lv L v : Set G))
    (hz : Tv T v ≤ centralizer ({z} : Set G)) :
    ∃ E ∈ elementaryAbelianMaxSubgroups (Tv T v), plusImage K L T z v hL hz E ≠ ⊥ := by
  by_contra he
  apply thompson_plus_ne_bot K L T z v hK hn hL hz
  apply (plusImage_eq_bot_iff K L T z v hL hz _
    ((thompson_le _).trans le_sup_right)).mpr
  apply sSup_le
  intro E hE
  have hbot : plusImage K L T z v hL hz E = ⊥ :=
    by_contra fun hne => he ⟨E, hE, hne⟩
  exact (plusImage_eq_bot_iff K L T z v hL hz E (hE.1.trans le_sup_right)).mp hbot

section Binary
variable (K L T : Subgroup G) (z v : G)
    (hL : Tv T v ≤ normalizer (Lv L v : Set G))
    (hz : Tv T v ≤ centralizer ({z} : Set G))
    [IsElementaryAbelian 2 (WK K L T z v)]

/-- The full plus action on the original W_K, written in binary coordinates. -/
noncomputable def plusBinaryAction :
    Representation (ZMod 2) (Gplus K L T z v hL hz) (Additive (WK K L T z v)) where
  toFun g := (plusAction K L T z v hL hz g).toMonoidHom.toAdditive.toZModLinearMap 2
  map_one' := by
    apply LinearMap.ext
    intro w
    change Additive.ofMul (plusAction K L T z v hL hz 1 w.toMul) = w
    rw [map_one]
    rfl
  map_mul' a b := by
    apply LinearMap.ext
    intro w
    change Additive.ofMul (plusAction K L T z v hL hz (a * b) w.toMul) = _
    rw [map_mul]
    rfl

/-- The binary action retains the exact ambient conjugation formula. -/
theorem plusBinaryAction_apply (g : plusActor K L T v) (w : Additive (WK K L T z v)) :
    ((plusBinaryAction K L T z v hL hz (plusMk K L T z v hL hz g) w).toMul : G) =
      (g : G) * (w.toMul : G) * (g : G)⁻¹ :=
  plusAction_mk_apply K L T z v hL hz g w.toMul

/-- Passing from automorphisms to the binary representation loses no actor. -/
theorem plusBinaryAction_injective :
    Function.Injective (plusBinaryAction K L T z v hL hz) := by
  intro a b he
  apply plusAction_injective K L T z v hL hz
  apply MulEquiv.ext
  intro w
  exact congrArg Additive.toMul (LinearMap.congr_fun he (Additive.ofMul w))

/-- Fixed vectors are precisely the ambient elements commuting with the
original subgroup, including when it has a nontrivial plus kernel. -/
theorem mem_fixedSpace_plusImage (D : Subgroup G) (hD : D ≤ plusActor K L T v)
    (w : Additive (WK K L T z v)) :
    w ∈ fixedSpace (plusBinaryAction K L T z v hL hz) (plusImage K L T z v hL hz D) ↔
      (w.toMul : G) ∈ centralizer (D : Set G) := by
  constructor
  · intro hw d hd
    have he := congrArg (fun u : Additive (WK K L T z v) => (u.toMul : G))
      (hw ⟨plusMk K L T z v hL hz ⟨d, hD hd⟩,
        mem_map.mpr ⟨⟨d, hD hd⟩, hd, rfl⟩⟩)
    change ((plusBinaryAction K L T z v hL hz
      (plusMk K L T z v hL hz ⟨d, hD hd⟩) w).toMul : G) = (w.toMul : G) at he
    rw [plusBinaryAction_apply] at he
    exact mul_inv_eq_iff_eq_mul.mp he
  · intro hw a
    obtain ⟨d, hd, he⟩ := a.property
    change plusBinaryAction K L T z v hL hz a.val w = w
    rw [← he]
    apply Additive.toMul.injective
    apply Subtype.ext
    rw [plusBinaryAction_apply, hw d hd, mul_inv_cancel_right]

/-- Baumann fixes every Thompson-fixed vector of the actual W_K. This is
the B.2.3 maximal-elementary argument, with the original source groups. -/
theorem baumann_plus_fixes_thompson_fixedSpace [Finite G]
    (hWT : WK K L T z v ≤ Tv T v) :
    plusImage K L T z v hL hz (ChapterB.baumann (Tv T v)) ≤
      subspaceKernel (plusBinaryAction K L T z v hL hz)
        (fixedSpace (plusBinaryAction K L T z v hL hz)
          (plusImage K L T z v hL hz (elementaryAbelianMaxJ (Tv T v)))) ⊤ := by
  rintro b ⟨b₀, hb, rfl⟩
  refine ⟨mem_top _, ?_⟩
  intro w hw
  have hwC := (mem_fixedSpace_plusImage K L T z v hL hz
    (elementaryAbelianMaxJ (Tv T v)) ((thompson_le _).trans le_sup_right) w).mp hw
  let : IsElementaryAbelian 2 (zpowers (w.toMul : G)) :=
    IsElementaryAbelian.zpowers_of_pow_eq_one
      (elemPow_eq_one_of_isElementaryAbelian (p := 2) _ w.toMul.property)
  have hwOmega := elementary_centralizer_maxJ_le_omegaCenter (Tv T v)
    (zpowers (w.toMul : G)) (zpowers_le.mpr (hWT w.toMul.property))
    (zpowers_le.mpr hwC) (mem_zpowers (w.toMul : G))
  apply Additive.toMul.injective
  apply Subtype.ext
  rw [plusBinaryAction_apply]
  have hc := hb.2 _ hwOmega
  change (w.toMul : G) * (b₀ : G) = (b₀ : G) * (w.toMul : G) at hc
  rw [← hc, mul_inv_cancel_right]

/-- The finite pointwise-kernel calculation suffices for the source equality
S⁺=J(Tᵥ)⁺. The kernel premise is still a separate mathematical obligation. -/
theorem baumann_plus_eq_of_pointwise_kernel [Finite G]
    (hWT : WK K L T z v ≤ Tv T v)
    (hkernel : subspaceKernel (plusBinaryAction K L T z v hL hz)
      (fixedSpace (plusBinaryAction K L T z v hL hz)
        (plusImage K L T z v hL hz (elementaryAbelianMaxJ (Tv T v)))) ⊤ =
      plusImage K L T z v hL hz (elementaryAbelianMaxJ (Tv T v))) :
    plusImage K L T z v hL hz (ChapterB.baumann (Tv T v)) =
      plusImage K L T z v hL hz (elementaryAbelianMaxJ (Tv T v)) := by
  apply le_antisymm
  · rw [← hkernel]
    exact baumann_plus_fixes_thompson_fixedSpace K L T z v hL hz hWT
  · exact map_mono (comap_mono (thompson_le_baumann _))

end Binary
end CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceSmallModels.AlternatingBranches.CoveredSix.ThompsonImage
