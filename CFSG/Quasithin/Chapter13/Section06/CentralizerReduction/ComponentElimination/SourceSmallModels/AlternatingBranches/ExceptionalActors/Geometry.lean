module
public import CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceSmallModels.AlternatingBranches.BlockQuotient
public import CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.LocalSetup.Configuration.ResidualModule.Natural
public import Theory.Representation.BinaryOffender.SubspaceAction
public import Theory.GroupTheory.PResidual.PerfectCover

/-!
# The source moved plane in the actual centralizer quotient

The marked A₅ module identifies l=[V,Lᵥ] with the binary three-point core.
The cubic permutes its three nonzero vectors and its difference map is onto.
This proves l=[z,Lᵥ]=[l,Lᵥ] and C_l(Lᵥ)=1 using the actual residual lifts.

For any conjugation quotient U → U/C_U(K) containing l and with Lᵥ ≤ K,
the restriction to l is injective. Its linear range is the marked quotient
plane. We prove its dimension, invariance, full commutator and zero common
fixed space for the residual restriction. Membership is characterized using
the literal quotient map. `ExceptionalActors` applies this construction to
the faithful four-dimensional exceptional-block model.

The seed commutator bound still supplies placement in U; its source derivation
and the Sylow/actor catalogue are separate obligations. None of the results
here asserts zero common fixed space on the entire four-space by itself.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004, the local
geometry on printed p.926 and Lemma 13.6.22 on printed p.932.
-/

@[expose] public section
open Subgroup Representation
open CFSG.Quasithin.Chapter13.Section06.CentralizerReduction
open CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.A5Module
open CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.A5Module.ResidualCoordinates
open BinaryPermutation BinaryPermutation.FiveCentralizerGeometry
open scoped commutatorElement
namespace CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceSmallModels.AlternatingBranches.ExceptionalActors

local instance : DecidablePred (· ∈ core (Fin 5)) := fun x =>
  inferInstanceAs (Decidable ((∑ i, x i) = 0))
local instance : Fintype Space := Subtype.fintype _

private theorem moved_cubic_fixed (x : moved) (hx : movedAction ⟨cubic, cubic_mem⟩ x = x) :
    x = 1 := by
  have h : ∀ y : Space, y.val 0 = 0 → y.val 1 = 0 → act cubic y = y → y = 0 := by
    decide +kernel
  apply Subtype.ext
  exact h x.val.toAdd x.property.1 x.property.2 (congrArg (fun a : moved => a.val.toAdd) hx)

private theorem moved_cubic_difference (x : moved) :
    ∃ y : moved, movedAction ⟨cubic, cubic_mem⟩ y * y⁻¹ = x := by
  have h : ∀ x : Space, x.val 0 = 0 → x.val 1 = 0 →
      ∃ y : Space, y.val 0 = 0 ∧ y.val 1 = 0 ∧ act cubic y - y = x := by
    decide +kernel
  obtain ⟨y, hy0, hy1, he⟩ := h x.val.toAdd x.property.1 x.property.2
  refine ⟨⟨Multiplicative.ofAdd y, hy0, hy1⟩, Subtype.ext ?_⟩
  apply Multiplicative.toAdd.injective
  change act cubic y + -y = x.val.toAdd
  simpa only [sub_eq_add_neg] using he

variable {G : Type*} [Group G] [Finite G] {L V K U : Subgroup G}
    (s : Marking L V)

/-- The source moved plane has trivial centralizer for the actual residual actor. -/
theorem moved_centralizer :
    ⁅V, Lv L (markedV s)⁆ ⊓ centralizer (Lv L (markedV s) : Set G) = ⊥ := by
  apply bot_unique
  rintro x ⟨hx, hc⟩
  obtain ⟨y, hy⟩ := (movedAmbientEquiv s).surjective ⟨x, hx⟩
  have hval : s.map y.val = x := congrArg Subtype.val hy
  obtain ⟨d, hd⟩ := residualCubicAction_surjective s ⟨cubic, cubic_mem⟩
  have he := s.equivariant (inclusion (residual_le_L s) d) y.val.toAdd
  have hfixed : movedAction ⟨cubic, cubic_mem⟩ y = y := by
    apply Subtype.ext
    apply s.injective
    change s.map (Multiplicative.ofAdd (act cubic y.val.toAdd)) = s.map y.val
    have hact : residualAction s d = cubic := congrArg Subtype.val hd
    rw [← hact]
    change s.map (Multiplicative.ofAdd (act (s.action (inclusion (residual_le_L s) d)) y.val.toAdd)) = _
    rw [← he]
    change (d : G) * s.map y.val * (d : G)⁻¹ = s.map y.val
    rw [hval]
    exact mul_inv_eq_iff_eq_mul.mpr (hc d d.property)
  have hyone := moved_cubic_fixed y hfixed
  change x = 1
  rw [← hval, hyone]
  exact map_one s.map

/-- The moved plane is already generated by commutators of the marked z. -/
theorem moved_eq_seed_commutator :
    ⁅V, Lv L (markedV s)⁆ = ⁅zpowers (markedZ s), Lv L (markedV s)⁆ := by
  apply le_antisymm _ (commutator_mono (zpowers_le.mpr (map_mem s _)) le_rfl)
  rw [residual_commutator_eq_moved s]
  have hd (g : cubicGroup) :
      s.map (Multiplicative.ofAdd (act g.val z - z)) ∈ ⁅zpowers (markedZ s), Lv L (markedV s)⁆ := by
    obtain ⟨d, he⟩ := residualCubicAction_surjective s g
    have hact : residualAction s d = g.val := congrArg Subtype.val he
    rw [← hact, ← residual_commutator_formula, commutator_comm]
    exact commutator_mem_commutator d.property (mem_zpowers _)
  have h1 := hd ⟨cubic, cubic_mem⟩
  have h2 := hd ⟨cubic ^ 2, cubicGroup.pow_mem cubic_mem 2⟩
  rintro x ⟨y, hy, rfl⟩
  change s.map (Multiplicative.ofAdd y.toAdd) ∈ _
  rcases moved_cases y.toAdd hy with he | he | he | he <;> rw [he]
  · exact (map_one s.map) ▸ one_mem _
  · exact h1
  · exact h2
  · rw [ofAdd_add, map_mul]
    exact mul_mem h1 h2

/-- The source plane equals its commutator with the residual. -/
theorem moved_self_commutator :
    ⁅⁅V, Lv L (markedV s)⁆, Lv L (markedV s)⁆ = ⁅V, Lv L (markedV s)⁆ := by
  apply le_antisymm
  · exact le_normalizer_iff_commutator_le_left.mp (normalizer_commutator_ge_right _ _)
  · intro x hx
    obtain ⟨y, hy⟩ := (movedAmbientEquiv s).surjective ⟨x, hx⟩
    have hval : s.map y.val = x := congrArg Subtype.val hy
    obtain ⟨u, hu⟩ := moved_cubic_difference y
    obtain ⟨d, hd⟩ := residualCubicAction_surjective s ⟨cubic, cubic_mem⟩
    have hact : residualAction s d = cubic := congrArg Subtype.val hd
    have he : act cubic u.val.toAdd - u.val.toAdd = y.val.toAdd :=
      by
        have hh := congrArg (fun a : moved => a.val.toAdd) hu
        change act cubic u.val.toAdd + -u.val.toAdd = y.val.toAdd at hh
        simpa only [sub_eq_add_neg] using hh
    rw [← hval]
    change s.map (Multiplicative.ofAdd y.val.toAdd) ∈ _
    rw [← he, ← hact, ← residual_commutator_formula, commutator_comm]
    exact commutator_mem_commutator d.property
      (by rw [residual_commutator_eq_moved s]; exact ⟨u, u.property, rfl⟩)

/-- Source placement follows from the seed commutator bound and Lᵥ ≤ K. -/
theorem moved_le_of_seed (hLK : Lv L (markedV s) ≤ K)
    (hz : ⁅zpowers (markedZ s), K⁆ ≤ U) : ⁅V, Lv L (markedV s)⁆ ≤ U := by
  rw [moved_eq_seed_commutator s]
  exact (commutator_mono le_rfl hLK).trans hz

variable {A W : Type*} [Group A] [AddCommGroup W] [Module (ZMod 2) W]
    {ρ : Representation (ZMod 2) A W}
    (m : ConjugationQuotientModel K U ρ)
    (hlU : ⁅V, Lv L (markedV s)⁆ ≤ U)

/-- Restrict the specified quotient map to the coordinate realization of [V,Lᵥ]. -/
def movedQuotientMap : moved →* Multiplicative W :=
  m.quotient.comp ((s.map.comp moved.subtype).codRestrict U fun x =>
    hlU (by rw [residual_commutator_eq_moved s]; exact ⟨x, x.property, rfl⟩))

/-- The marked plane survives injectively in U/C_U(K). -/
theorem movedQuotientMap_injective (hLK : Lv L (markedV s) ≤ K) :
    Function.Injective (movedQuotientMap s m hlU) := by
  apply (MonoidHom.ker_eq_bot_iff _).mp
  apply bot_unique
  intro x hx
  have hker : (⟨s.map x.val, hlU (by
      rw [residual_commutator_eq_moved s]; exact ⟨x, x.property, rfl⟩)⟩ : U) ∈ m.quotient.ker := hx
  rw [m.kernel] at hker
  have hone : s.map x.val ∈ (⊥ : Subgroup G) := by
    rw [← moved_centralizer s]
    exact ⟨by rw [residual_commutator_eq_moved s]; exact ⟨x, x.property, rfl⟩,
      centralizer_le hLK hker⟩
  change x = 1
  apply Subtype.ext
  exact s.injective (hone.trans (map_one s.map).symm)

/-- Equivariance uses the actual ambient residual elements and actual quotient map. -/
theorem movedQuotientMap_equivariant (hLK : Lv L (markedV s) ≤ K)
    (d : Lv L (markedV s)) (x : moved) :
    movedQuotientMap s m hlU (movedAction (residualCubicAction s d) x) =
      Multiplicative.ofAdd (ρ (m.actor (inclusion hLK d))
        (movedQuotientMap s m hlU x).toAdd) := by
  have he := m.equivariant (inclusion hLK d)
    ⟨s.map x.val, hlU (by rw [residual_commutator_eq_moved s]; exact ⟨x, x.property, rfl⟩)⟩
  apply Eq.trans _ he
  apply congrArg m.quotient
  apply Subtype.ext
  exact (s.equivariant (inclusion (residual_le_L s) d) x.val.toAdd).symm

/-- Binary linear coordinates on the literal quotient image of the source plane. -/
noncomputable def planeMap : core (Fin 3) →ₗ[ZMod 2] W :=
  let f := (movedQuotientMap s m hlU).comp movedCoreEquiv.symm.toMonoidHom
  ({ toFun := fun x => (f (Multiplicative.ofAdd x)).toAdd
     map_zero' := congrArg Multiplicative.toAdd (map_one f)
     map_add' := fun x y => congrArg Multiplicative.toAdd
       (map_mul f (Multiplicative.ofAdd x) (Multiplicative.ofAdd y)) } :
    core (Fin 3) →+ W).toZModLinearMap 2

/-- The marked quotient plane, defined through the specified quotient. -/
noncomputable def quotientPlane : Submodule (ZMod 2) W := LinearMap.range (planeMap s m hlU)

theorem quotientPlane_finrank (hLK : Lv L (markedV s) ≤ K) :
    Module.finrank (ZMod 2) (quotientPlane s m hlU) = 2 := by
  rw [quotientPlane, LinearMap.finrank_range_of_inj
    ((movedQuotientMap_injective s m hlU hLK).comp movedCoreEquiv.symm.injective)]
  exact three_rank

theorem mem_quotientPlane_iff (w : W) :
    w ∈ quotientPlane s m hlU ↔ ∃ x : moved, (movedQuotientMap s m hlU x).toAdd = w := by
  constructor
  · rintro ⟨x, rfl⟩
    exact ⟨movedCoreEquiv.symm (Multiplicative.ofAdd x), rfl⟩
  · rintro ⟨x, rfl⟩
    exact ⟨(movedCoreEquiv x).toAdd, congrArg (fun y => (movedQuotientMap s m hlU y).toAdd)
      (movedCoreEquiv.symm_apply_apply x)⟩

/-- Membership uses the literal image of [V,Lᵥ] under the given quotient map. -/
theorem mem_quotientPlane_iff_ambient (w : W) :
    w ∈ quotientPlane s m hlU ↔
      ∃ u : U, (u : G) ∈ ⁅V, Lv L (markedV s)⁆ ∧ (m.quotient u).toAdd = w := by
  rw [mem_quotientPlane_iff]
  constructor
  · rintro ⟨x, rfl⟩
    have hx : s.map x.val ∈ ⁅V, Lv L (markedV s)⁆ := by
      rw [residual_commutator_eq_moved s]
      exact ⟨x, x.property, rfl⟩
    exact ⟨⟨s.map x.val, hlU hx⟩, hx, rfl⟩
  · rintro ⟨u, hu, rfl⟩
    obtain ⟨x, hx⟩ := (movedAmbientEquiv s).surjective ⟨u, hu⟩
    refine ⟨x, ?_⟩
    apply congrArg (fun a : U => (m.quotient a).toAdd)
    apply Subtype.ext
    change s.map x.val = (u : G)
    exact congrArg (fun a : ↥(⁅V, Lv L (markedV s)⁆ : Subgroup G) => (a : G)) hx

/-- Any actual normalizer of l inside K preserves its specified quotient image. -/
theorem quotientPlane_invariant_of_normalizes (k : K)
    (hk : (k : G) ∈ normalizer ((⁅V, Lv L (markedV s)⁆ : Subgroup G) : Set G))
    {w : W} (hw : w ∈ quotientPlane s m hlU) :
    ρ (m.actor k) w ∈ quotientPlane s m hlU := by
  obtain ⟨u, hu, rfl⟩ := (mem_quotientPlane_iff_ambient s m hlU w).mp hw
  refine (mem_quotientPlane_iff_ambient s m hlU _).mpr
    ⟨U.normalizerMonoidHom ⟨k, m.normalizes k.property⟩ u, ?_,
      congrArg Multiplicative.toAdd (m.equivariant k u)⟩
  exact (mem_normalizer_iff.mp hk (u : G)).mp hu

/-- Invariance of the marked quotient plane under the actual residual image. -/
theorem quotientPlane_invariant (hLK : Lv L (markedV s) ≤ K)
    (d : Lv L (markedV s)) {w : W} (hw : w ∈ quotientPlane s m hlU) :
    ρ (m.actor (inclusion hLK d)) w ∈ quotientPlane s m hlU := by
  obtain ⟨x, rfl⟩ := (mem_quotientPlane_iff s m hlU w).mp hw
  exact (mem_quotientPlane_iff s m hlU _).mpr
    ⟨movedAction (residualCubicAction s d) x,
      congrArg Multiplicative.toAdd (movedQuotientMap_equivariant s m hlU hLK d x)⟩

/-- The whole source residual has zero common fixed space on its marked plane. -/
theorem quotientPlane_fixed_eq_zero (hLK : Lv L (markedV s) ≤ K)
    (w : W) (hw : w ∈ quotientPlane s m hlU)
    (hfixed : ∀ d : Lv L (markedV s), ρ (m.actor (inclusion hLK d)) w = w) : w = 0 := by
  obtain ⟨x, rfl⟩ := (mem_quotientPlane_iff s m hlU w).mp hw
  obtain ⟨d, hd⟩ := residualCubicAction_surjective s ⟨cubic, cubic_mem⟩
  have he := movedQuotientMap_equivariant s m hlU hLK d x
  rw [hfixed d, hd] at he
  have hx := (movedQuotientMap_injective s m hlU hLK) he
  rw [moved_cubic_fixed x hx, map_one]
  rfl

/-- The subgroup generated by the actual residual quotient images. -/
def actorImage (hLK : Lv L (markedV s) ≤ K) : Subgroup A :=
  (m.actor.comp (inclusion hLK)).range

/-- The source plane is fully moved by the actual actor image. -/
theorem quotientPlane_commutator (hLK : Lv L (markedV s) ≤ K) :
    BinaryOffender.subspaceCommutator ρ (quotientPlane s m hlU) (actorImage s m hLK) =
      quotientPlane s m hlU := by
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro w ⟨_, ⟨d, rfl⟩, x, hx, rfl⟩
    exact (quotientPlane s m hlU).sub_mem (quotientPlane_invariant s m hlU hLK d hx) hx
  · intro w hw
    obtain ⟨x, rfl⟩ := (mem_quotientPlane_iff s m hlU w).mp hw
    obtain ⟨y, hy⟩ := moved_cubic_difference x
    obtain ⟨d, hd⟩ := residualCubicAction_surjective s ⟨cubic, cubic_mem⟩
    apply Submodule.subset_span
    refine ⟨m.actor (inclusion hLK d), ⟨d, rfl⟩, (movedQuotientMap s m hlU y).toAdd,
      (mem_quotientPlane_iff s m hlU _).mpr ⟨y, rfl⟩, ?_⟩
    have he := congrArg (fun a : moved => (movedQuotientMap s m hlU a).toAdd) hy
    have heq := movedQuotientMap_equivariant s m hlU hLK d y
    rw [hd] at heq
    rw [map_mul, map_inv, heq] at he
    change ρ (m.actor (inclusion hLK d)) (movedQuotientMap s m hlU y).toAdd +
      -(movedQuotientMap s m hlU y).toAdd = (movedQuotientMap s m hlU x).toAdd at he
    simpa only [sub_eq_add_neg] using he.symm

/-- Restriction of the actual actor to its image preserves two-perfection. -/
theorem actorImage_twoPerfect (hLK : Lv L (markedV s) ≤ K) :
    IsPPerfect 2 (actorImage s m hLK) :=
  (isPPerfect_embedded_pResidual 2 (L ⊓ Gv (markedV s))).of_surjective
    (m.actor.comp (inclusion hLK)).rangeRestrict
    (m.actor.comp (inclusion hLK)).rangeRestrict_surjective

end CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceSmallModels.AlternatingBranches.ExceptionalActors
