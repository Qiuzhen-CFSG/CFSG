/-!
# The actual block quotient and the exceptional A₇ action

Two-perfection gives [U(K),K]=U(K). Hence the conjugation action on
U(K)/C_U(K) is nontrivial, and is faithful when K/O₂(K) is simple.
For an exceptional A₇ block this constructs a faithful binary representation
of dimension four, together with the literal ambient quotient map and its
centralizer kernel. No representation or fixed-space conclusion is assumed.

The same commutator identity proves [Z₀,K]=U(K) for the preimage of the
center of the two-core under a surjection with two-group kernel. The checked
quotient application is in `CheckedCenter`.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004, C.1.7,
C.1.22 and the last two paragraphs of 13.6.22, printed pp.123, 129, 932–933.
-/

@[expose] public section
open Subgroup CFSG.Quasithin.ChapterC
open scoped IsMulCommutative commutatorElement
namespace CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceSmallModels.AlternatingBranches
variable {K : Type*} [Group K]

/-- The block commutator is generated by its own K-commutators. -/
theorem short_module_commutator (h : IsShort K) : ⁅blockU K, (⊤ : Subgroup K)⁆ = blockU K := by
  let := h.finite
  exact commutator_isPPerfect_idempotent ⊤ (pCore 2 K)
    (h.twoPerfect.of_surjective (topEquiv (G := K)).symm.toMonoidHom (topEquiv (G := K)).symm.surjective)
    pCore_isPGroup le_normalizer_of_normal

/-- Trivial action on the central quotient contradicts the nonzero block module. -/
theorem short_quotientAction_ne_one (h : IsShort K)
    (ρ : (K ⧸ pCore 2 K) →* MulAut (BlockModule K))
    (he : ∀ (k : K) (u : blockU K),
      ρ (QuotientGroup.mk' (pCore 2 K) k) (QuotientGroup.mk' (blockFixed K) u) =
        QuotientGroup.mk' (blockFixed K) (blockConjugate K k u)) : ρ ≠ 1 := by
  intro htriv
  have hcomm : ⁅blockU K, (⊤ : Subgroup K)⁆ ≤ center K := by
    rw [commutator_comm]
    apply commutator_le.mpr
    intro k _ u hu
    have hh := he k ⟨u, hu⟩
    rw [htriv] at hh
    change QuotientGroup.mk' (blockFixed K) ⟨u, hu⟩ =
      QuotientGroup.mk' (blockFixed K) (blockConjugate K k ⟨u, hu⟩) at hh
    have hmem : (blockConjugate K k ⟨u, hu⟩ * (⟨u, hu⟩ : blockU K)⁻¹) ∈ blockFixed K := by
      apply (QuotientGroup.eq_one_iff _).mp
      change (QuotientGroup.mk' (blockFixed K)) _ = 1
      rw [map_mul, map_inv, ← hh, mul_inv_cancel]
    exact hmem
  rw [short_module_commutator h] at hcomm
  exact h.irreducible.1.ne (inf_eq_left.mpr hcomm)

/-- Simplicity and nontriviality make the actual quotient action faithful. -/
theorem short_quotientAction_injective (h : IsShort K) [IsSimpleGroup (K ⧸ pCore 2 K)]
    (ρ : (K ⧸ pCore 2 K) →* MulAut (BlockModule K))
    (he : ∀ (k : K) (u : blockU K),
      ρ (QuotientGroup.mk' (pCore 2 K) k) (QuotientGroup.mk' (blockFixed K) u) =
        QuotientGroup.mk' (blockFixed K) (blockConjugate K k u)) :
    Function.Injective ρ := by
  rcases (inferInstance : ρ.ker.Normal).eq_bot_or_eq_top with hh | hh
  · exact ρ.ker_eq_bot_iff.mp hh
  · exact (short_quotientAction_ne_one h ρ he (by
      apply MonoidHom.ext
      intro k
      exact show k ∈ ρ.ker from hh ▸ mem_top k)).elim

variable {H : Type*} [Group H]

/-- The source center-preimage identity for any surjection with two-group kernel. -/
theorem short_centerPreimage_commutator (h : IsShort K) (q : K →* H)
    (hq : Function.Surjective q) (hp : IsPGroup 2 q.ker) :
    ⁅((center (pCore 2 H)).map (pCore 2 H).subtype).comap q, (⊤ : Subgroup K)⁆ =
      blockU K := by
  let := h.finite
  let : Finite H := Finite.of_surjective q hq
  let Z := ((center (pCore 2 H)).map (pCore 2 H).subtype).comap q
  have hc : (pCore 2 H).comap q = pCore 2 K := q.comap_pCore_of_ker_isPGroup hq hp
  have hm : (pCore 2 K).map q = pCore 2 H := by
    rw [← hc, map_comap_eq_self_of_surjective hq]
  have hUZ : blockU K ≤ Z := by
    intro u hu
    have huQ : q u ∈ pCore 2 H := by
      rw [← hm]
      exact mem_map_of_mem q (blockU_le_core hu)
    refine mem_map.mpr ⟨⟨q u, huQ⟩, ?_, rfl⟩
    rw [mem_center_iff]
    intro x
    have hx : (x : H) ∈ (pCore 2 K).map q := by rw [hm]; exact x.property
    obtain ⟨y, hy, hxy⟩ := hx
    apply Subtype.ext
    change (x : H) * q u = q u * x
    rw [← hxy, ← map_mul, ← map_mul]
    exact congrArg q (mem_centralizer_iff.mp (h.central hu) y hy)
  have hZQ : Z ≤ pCore 2 K := by
    rw [← hc]
    exact comap_mono (map_subtype_le _)
  apply le_antisymm (commutator_mono hZQ le_rfl)
  change blockU K ≤ ⁅Z, ⊤⁆
  rw [← short_module_commutator h]
  exact commutator_mono hUZ le_rfl

section Binary
variable [IsElementaryAbelian 2 (BlockModule K)]

/-- Write the actual elementary abelian quotient action as a binary representation. -/
def blockBinaryAction (ρ : (K ⧸ pCore 2 K) →* MulAut (BlockModule K)) :
    Representation (ZMod 2) (K ⧸ pCore 2 K) (Additive (BlockModule K)) where
  toFun k := (ρ k).toMonoidHom.toAdditive.toZModLinearMap 2
  map_one' := by
    ext u
    change Additive.ofMul (ρ 1 u.toMul) = u
    rw [map_one]
    rfl
  map_mul' k j := by
    ext u
    change Additive.ofMul (ρ (k * j) u.toMul) = _
    rw [map_mul]
    rfl

theorem blockBinaryAction_injective
    (ρ : (K ⧸ pCore 2 K) →* MulAut (BlockModule K)) (hi : Function.Injective ρ) :
    Function.Injective (blockBinaryAction ρ) := by
  intro k j hh
  apply hi
  ext u
  exact congrArg (fun f : Module.End (ZMod 2) (Additive (BlockModule K)) =>
    (f (Additive.ofMul u)).toMul) hh
end Binary

section Ambient
variable {G : Type*} [Group G] (K : Subgroup G)
variable [IsElementaryAbelian 2 (BlockModule K)]
variable {A : Type*} [Group A]

/-- Return the intrinsic block action to its actual ambient subgroup. -/
noncomputable def blockConjugationQuotientModel (e : (K ⧸ pCore 2 K) ≃* A)
    (σ : (K ⧸ pCore 2 K) →* MulAut (BlockModule K))
    (he : ∀ (k : K) (u : blockU K),
      σ (QuotientGroup.mk' (pCore 2 K) k) (QuotientGroup.mk' (blockFixed K) u) =
        QuotientGroup.mk' (blockFixed K) (blockConjugate K k u)) :
    Representation.ConjugationQuotientModel K ((blockU K).map K.subtype)
      ((blockBinaryAction σ).comp e.symm.toMonoidHom) := by
  let U := (blockU K).map K.subtype
  let eU : blockU K ≃* U := (blockU K).equivMapOfInjective K.subtype K.subtype_injective
  have hval (u : U) : (((eU.symm u : blockU K) : K) : G) = (u : G) :=
    congrArg Subtype.val (eU.apply_symm_apply u)
  have hUK : U.subgroupOf K = blockU K :=
    comap_map_eq_self_of_injective K.subtype_injective _
  have hKU : K ≤ normalizer (U : Set G) := by
    apply (normal_subgroupOf_iff_le_normalizer (map_subtype_le _)).mp
    rw [hUK]
    infer_instance
  let q := (MulEquiv.multiplicativeAdditive (BlockModule K)).symm.toMonoidHom.comp
    ((QuotientGroup.mk' (blockFixed K)).comp eU.symm.toMonoidHom)
  refine {
    normalizes := hKU
    actor := e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 K))
    quotient := q
    surjective := (MulEquiv.multiplicativeAdditive (BlockModule K)).symm.surjective.comp
      ((QuotientGroup.mk'_surjective _).comp eU.symm.surjective)
    kernel := ?_
    equivariant := ?_ }
  · ext u
    change QuotientGroup.mk' (blockFixed K) (eU.symm u) = 1 ↔
      (u : G) ∈ centralizer (K : Set G)
    rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
    change (eU.symm u : K) ∈ center K ↔ (u : G) ∈ centralizer (K : Set G)
    rw [mem_center_iff, mem_centralizer_iff]
    constructor
    · intro hc k hk
      simpa only [Subgroup.coe_mul, hval] using congrArg Subtype.val (hc ⟨k, hk⟩)
    · intro hc k
      apply Subtype.ext
      simpa only [Subgroup.coe_mul, hval] using hc k k.property
  · intro k u
    have hc : eU.symm (U.normalizerMonoidHom ⟨k, hKU k.property⟩ u) =
        blockConjugate K k (eU.symm u) := by
      apply Subtype.ext
      apply Subtype.ext
      rw [hval]
      change (k : G) * (u : G) * (k : G)⁻¹ =
        (k : G) * (((eU.symm u : blockU K) : K) : G) * (k : G)⁻¹
      rw [hval]
    change QuotientGroup.mk' (blockFixed K)
      (eU.symm (U.normalizerMonoidHom ⟨k, hKU k.property⟩ u)) =
      σ (e.symm (e (QuotientGroup.mk' (pCore 2 K) k)))
        (QuotientGroup.mk' (blockFixed K) (eU.symm u))
    rw [hc, e.symm_apply_apply, he]
end Ambient

variable {G : Type*} [Group G] [Finite G] (K : Subgroup G)

/-- Construct the faithful four-space and quotient model from the exceptional-block predicate. -/
theorem exceptionalSeven_quotientModel (h : IsExceptionalA7Block K)
    (e : (K ⧸ pCore 2 K) ≃* alternatingGroup (Fin 7)) :
    letI := h.1.module_elementary
    ∃ ρ : Representation (ZMod 2) (alternatingGroup (Fin 7)) (Additive (BlockModule K)),
      Function.Injective ρ ∧ Module.finrank (ZMod 2) (Additive (BlockModule K)) = 4 ∧
      ∃ m : Representation.ConjugationQuotientModel K ((blockU K).map K.subtype) ρ,
        m.actor = e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 K)) := by
  let := h.1.module_elementary
  let : IsSimpleGroup (alternatingGroup (Fin 7)) :=
    alternatingGroup.isSimpleGroup (by simp)
  let : IsSimpleGroup (K ⧸ pCore 2 K) := e.isSimpleGroup
  obtain ⟨σ, hσ⟩ := h.1.exists_quotient_moduleAction
  refine ⟨(blockBinaryAction σ).comp e.symm.toMonoidHom,
    (blockBinaryAction_injective σ (short_quotientAction_injective h.1 σ hσ)).comp e.symm.injective,
    ?_, blockConjugationQuotientModel K e σ hσ, rfl⟩
  have hc : 2 ^ Module.finrank (ZMod 2) (Additive (BlockModule K)) = 2 ^ 4 := by
    calc
      _ = Nat.card (Additive (BlockModule K)) := by
        rw [Module.natCard_eq_pow_finrank (K := ZMod 2), Nat.card_zmod]
      _ = 2 ^ 4 := h.2.2
  exact Nat.pow_right_injective (by decide : 1 < 2) hc
end CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceSmallModels.AlternatingBranches
