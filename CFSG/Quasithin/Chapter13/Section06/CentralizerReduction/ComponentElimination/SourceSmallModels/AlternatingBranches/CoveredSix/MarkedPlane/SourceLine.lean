module

public import CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceSmallModels.AlternatingBranches.CoveredSix.NormalizerTransport
public import CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentSelection.ComponentModules
public import Theory.GroupTheory.PResidual.SubnormalCoreAction

/-!
# The source commutator lies in the actual covered-six block layer

The two cubic differences of the marked z generate [V,Lᵥ]. Thus this is
[⟨z⟩,Lᵥ]. Intersecting Uᵥ with KTᵥ gives a two-group normalized by K;
Tᵥ-invariance of K gives the reverse normalization. Two-perfection then
places its K-commutator in [O₂(K),K], the literal block layer.

Source: Aschbacher–Smith, combined manuscript, 13.6.22, printed p.932,
using the source marking on p.926 and 13.6.14 on p.929.
-/

@[expose] public section
open Subgroup CFSG.Quasithin.ChapterC
open scoped commutatorElement
namespace CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceSmallModels.AlternatingBranches.CoveredSix
open CFSG.Quasithin.Chapter13.Section06.CentralizerReduction
open ComponentSelection A5Module A5Module.ResidualCoordinates
open BinaryPermutation.FiveCentralizerGeometry
variable {G : Type*} [Group G] [Finite G] {L V : Subgroup G}

/-- The source line is generated by commutators of the same marked z. -/
theorem source_commutator_eq_seed (s : A5Module.Marking L V) :
    ⁅V, Lv L (markedV s)⁆ = ⁅zpowers (markedZ s), Lv L (markedV s)⁆ := by
  apply le_antisymm ?_ (commutator_mono (zpowers_le.mpr (map_mem s _)) le_rfl)
  rw [residual_commutator_eq_moved s]
  have hd (g : cubicGroup) : s.map (Multiplicative.ofAdd
      (BinaryPermutation.FiveCentralizerGeometry.act g.val
        BinaryPermutation.FiveCentralizerGeometry.z -
        BinaryPermutation.FiveCentralizerGeometry.z)) ∈
        ⁅zpowers (markedZ s), Lv L (markedV s)⁆ := by
    obtain ⟨l, hl⟩ := residualCubicAction_surjective s g
    have he : residualAction s l = g.val := congrArg Subtype.val hl
    rw [← he, ← residual_commutator_formula]
    rw [commutator_comm]
    exact commutator_mem_commutator l.property (mem_zpowers _)
  have h1 := hd ⟨cubic, cubic_mem⟩
  have h2 := hd ⟨cubic ^ 2, cubicGroup.pow_mem cubic_mem 2⟩
  change s.map (Multiplicative.ofAdd deltaOne) ∈ _ at h1
  change s.map (Multiplicative.ofAdd deltaTwo) ∈ _ at h2
  rintro x ⟨y, hy, rfl⟩
  change s.map (Multiplicative.ofAdd y.toAdd) ∈ _
  rcases moved_cases y.toAdd hy with he | he | he | he <;> rw [he]
  · exact (map_one s.map) ▸ one_mem _
  · exact h1
  · exact h2
  · rw [ofAdd_add, map_mul]
    exact mul_mem h1 h2

private theorem commutator_le_block (K Q : Subgroup G)
    (hK : IsPPerfect 2 K) (hQ : IsPGroup 2 Q)
    (hKQ : K ≤ normalizer (Q : Set G)) (hQK : Q ≤ normalizer (K : Set G)) :
    ⁅Q, K⁆ ≤ (blockU K).map K.subtype := by
  have hCK : ⁅Q, K⁆ ≤ K := le_normalizer_iff_commutator_le_right.mp hQK
  have hCQ : ⁅Q, K⁆ ≤ Q := le_normalizer_iff_commutator_le_left.mp hKQ
  have hn : (⁅Q, K⁆.subgroupOf K).Normal :=
    normal_subgroupOf_of_le_normalizer (normalizer_commutator_ge_right Q K)
  have hcore := isPGroup_le_pCoreAmbient_of_isSubnormalIn K ⁅Q, K⁆ 2 hCK
    hn.isSubnormal (hQ.to_le hCQ)
  change ⁅Q, K⁆ ≤ (⁅pCore 2 K, (⊤ : Subgroup K)⁆).map K.subtype
  rw [map_commutator, ← MonoidHom.range_eq_map, range_subtype]
  exact (commutator_isPPerfect_idempotent K Q hK hQ hKQ).symm.le.trans
    (commutator_mono hcore le_rfl)

/-- The genuine earlier containment Lᵥ≤K and Tᵥ-invariance put the source
commutator in U(K). Only the earlier two-group assertion for Uᵥ is used. -/
theorem source_commutator_le_block (s : A5Module.Marking L V) (K T : Subgroup G)
    (h : IsExceptionalAhat6Block K)
    (hK : K ∈ Yz L T (markedZ s) (markedV s))
    (hn : Tv T (markedV s) ≤ normalizer (K : Set G))
    (hz : markedZ s ∈ Tv T (markedV s))
    (hU : IsPGroup 2 (Uv (markedZ s) (markedV s)))
    (hLK : Lv L (markedV s) ≤ K) :
    ⁅V, Lv L (markedV s)⁆ ≤ (blockU K).map K.subtype := by
  let H := K ⊔ Tv T (markedV s)
  let Q := Uv (markedZ s) (markedV s) ⊓ H
  have hKQ : K ≤ normalizer (Q : Set G) :=
    (le_inf (hK.1.1.trans (Gv_normalizes_Uv _ _))
      (le_sup_left.trans H.le_normalizer)).trans inf_normalizer_le_normalizer_inf
  have hQK : Q ≤ normalizer (K : Set G) :=
    inf_le_right.trans (sup_le K.le_normalizer hn)
  rw [source_commutator_eq_seed s]
  have hzQ : zpowers (markedZ s) ≤ Q :=
    zpowers_le.mpr ⟨z_mem_Uv _ _, (show Tv T (markedV s) ≤ H from le_sup_right) hz⟩
  exact (commutator_mono hzQ hLK).trans (commutator_le_block K Q h.1.twoPerfect (hU.to_le inf_le_left) hKQ hQK)

end CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceSmallModels.AlternatingBranches.CoveredSix
