/-!
# The original plus-A₇ module alternatives of 13.6.22

The source Sylow and characteristic-two hypotheses make W_K elementary
and the literal plus actor two-reduced. Thompson movement places K⁺ in the
subgroup generated by best offenders. Its actual A₇ model supplies SQTK
and, using Lᵥ≤K and Tᵥ-invariance, a trivial component centralizer.

The complete B.5.1 application consequently returns the full moved module
with its pointwise-fixed complement: either the natural S₇ action with
K⁺ marked as A₇, or the faithful four-dimensional A₇ action. Neither
shortness, block recognition nor a classification callback is assumed.
All quotient maps, fixed codimensions and natural-vector lifts use the
original W_K representation.

Source: Aschbacher–Smith B.5.1 and C.1.24, applied in 13.6.22, p.932.
-/

public section
open Subgroup Representation Representation.BinaryOffender Theory.GroupTheory Stellmacher
open scoped IsMulCommutative
open CFSG.Quasithin.Chapter15.Section04.LocalSetup.TwoFactors.FFBranch.ClassificationComparison.FFAlternatives
namespace CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceSmallModels.OriginalAssembly.AlternatingModels
open ComponentSelection
open SourceContainment.LinearThree.CentralAction.ModuleAlternatives
open SourceOrthogonal.LocalAction
universe u
variable {G : Type u} [Group G] [Finite G]

theorem source_actionData (K L T : Subgroup G) (z v : G)
    (hL : Tv T v ≤ normalizer (Lv L v : Set G))
    (hz : Tv T v ≤ centralizer ({z} : Set G))
    (hK : K ∈ Yz L T z v) (hn : Tv T v ≤ normalizer (K : Set G))
    (hLK : Lv L v ≤ K)
    (hSylow : Chapter1.IsSylowIn 2 (Tv T v) (Gv v))
    (hzOmega : z ∈ omegaOneCenterAmbient (Tv T v))
    (hchar : generalizedFitting (Gv v) = pCore 2 (Gv v))
    (hsource : IsKGroup KnownSimple.IsKnownSimple (Gv v))
    (eC : plusImage K L T z v hL hz K ≃* alternatingGroup (Fin 7)) :
    let := wk_elementary K L T z v hK.1.1 hSylow hzOmega hchar
    Nonempty (ActionData (wkRepresentation K L T z v hL hz)
      (plusImage K L T z v hL hz K)) := by
  let := wk_elementary K L T z v hK.1.1 hSylow hzOmega hchar
  let : Module.Finite (ZMod 2) (Additive (WK K L T z v)) := Module.Finite.of_finite
  let C := plusImage K L T z v hL hz K
  have hR := plus_twoCore_eq_bot K L T z v hK.1.1 hL hz hSylow
  let : C.Normal := plusImage_K_normal K L T z v hL hz hK hn
  let : IsSimpleGroup (alternatingGroup (Fin 7)) := alternatingGroup.isSimpleGroup (by simp)
  let : IsSimpleGroup C := eC.isSimpleGroup
  let : IsQuasisimple C := plusImage_K_quasisimple K L T z v hL hz hK hR
  exact nonempty_actionData _ C eC
    (component_centralizer_eq_bot K L T z v hL hz hK hn hLK hSylow hR eC)
    (component_sqtk K L T z v hL hz hK hsource eC)
    (wkRepresentation_faithful K L T z v hL hz)
    (component_plus_le_offenders K L T z v hL hz
      ((mem_omegaOneCenterAmbient_iff (Tv T v) z).mp hzOmega).1 hSylow hK hn)
end CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceSmallModels.OriginalAssembly.AlternatingModels
