module
public import CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceSmallModels.OriginalAssembly.CoveredSixModels.Rows
public import CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceSmallModels.OriginalAssembly.SixModels
public import Theory.GroupTheory.GeneralizedFitting.QuasisimpleTwoQuotient
public import Theory.Representation.BinaryOffender.Stability

/-!
# The full moved covered-six module on the original plus actor

Restrict the original action to its normal subgroup generated by best
offenders. The normal quasisimple component has two-group quotient and the
actor has trivial two-core, so its generalized Fitting subgroup is precisely
that component. Complete B.5.1 and the covered-six row comparison then give
a faithful six-dimensional moved module with zero central denominator and
a complement fixed by the offender actor.

The source application uses the literal W_K representation and K⁺ image.
Its SQTK component premise is retained for the intrinsic quotient producer;
no block, shortness or classification callback is assumed.

Source: Aschbacher--Smith B.5.1 and 13.6.22, pp.99--103 and 932.
-/

public section
open Subgroup Representation Representation.BinaryOffender Theory.GroupTheory Stellmacher
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceSmallModels.OriginalAssembly.CoveredSixModels
open ChapterB.QuasisimpleSource ChapterB.SourceInduction
open ComponentSelection SourceContainment.LinearThree.CentralAction.ModuleAlternatives
universe u w

section Representation
variable {D : Type u} [Group D] [Finite D]
  {V : Type w} [AddCommGroup V] [Module (ZMod 2) V] [Module.Finite (ZMod 2) V]
  (ρ : Representation (ZMod 2) D V) (C : Subgroup D) [C.Normal]

/-- The actual B.5.1 conclusion on the original offender actor, with the
covered-six row and the entire moved module retained. -/
structure ActionData where
  component_le_offenders : C ≤ offenderSubgroup ρ
  conclusion : ProjectiveLine.QuasisimpleSourceConclusion
    (ρ.comp (offenderSubgroup ρ).subtype) (C.subgroupOf (offenderSubgroup ρ))
  irrPlus : IsIrrPlus (ρ.comp (offenderSubgroup ρ).subtype)
    (C.subgroupOf (offenderSubgroup ρ)) conclusion.sectionData.space.toSubmodule
  faithful : Function.Injective conclusion.sectionData.action
  irreducible : IsIrreducible (conclusion.sectionData.action.comp
    (C.subgroupOf (offenderSubgroup ρ)).subtype)
  tripleSix : ProjectiveLine.TripleSixAction conclusion.sectionData.action
    (C.subgroupOf (offenderSubgroup ρ))
  invariant_complement : IsCompl conclusion.sectionData.space.toSubmodule
    (Representation.invariants (ρ.comp (offenderSubgroup ρ).subtype))
  central_eq_bot : conclusion.sectionData.central.toSubmodule = ⊥
  dimension : Module.finrank (ZMod 2) conclusion.sectionData.space.toSubmodule = 6

/-- Normality of the offender actor lets the original two-core hypothesis
pass to the exact B.5 group. Its component quotient remains a two-group. -/
theorem nonempty_actionData [IsQuasisimple C]
    (eC : C ≃* Atlas.Codes.HexEvenAutomorphisms)
    (hsq : IsSQTK KnownSimple.IsKnownSimple C)
    (hquot : IsPGroup 2 (D ⧸ C)) (hcore : pCore 2 D = ⊥)
    (hf : Function.Injective ρ) (hCJ : C ≤ offenderSubgroup ρ) :
    Nonempty (ActionData ρ C) := by
  let J := offenderSubgroup ρ
  let B := C.subgroupOf J
  let e : B ≃* C := subgroupOfEquivOfLe hCJ
  let : J.Normal := offenderSubgroup_normal ρ
  let : IsQuasisimple B := IsQuasisimple.of_mulEquiv e.symm
  have hjcore : pCore 2 J = ⊥ := by
    rw [pCore_subnormal_eq_comap 2 (inferInstance : J.Normal).isSubnormal, hcore]
    exact J.ker_subtype
  have hjquot : IsPGroup 2 (J ⧸ B) := by
    obtain ⟨n, hn⟩ := hquot.exists_card_eq
    apply IsPGroup.of_card_dvd_pow (n := n)
    rw [← hn, ← B.index_eq_card, ← C.index_eq_card]
    exact C.relIndex_dvd_index_of_le hCJ
  have hfit : generalizedFitting J = B :=
    generalizedFitting_eq_of_quasisimple_two_quotient B hjquot hjcore
  obtain ⟨c⟩ := SourceCompletion.knownSimple_quasisimpleClassificationInput
    (fun _ _ _ => ChapterA.Section02.theoremA_knownSimple)
    (ChapterA.SQTKStructure.a36Input_of_theoremsAC
      (fun _ _ _ => ChapterA.Section02.theoremA_knownSimple)
      (fun _ _ _ => ChapterA.Section02.theoremC_knownSimple))
    ChapterB.SourceClassification.irreducibleClassification_knownSimple
    ChapterB.SourceInduction.nonbinaryG2RootPairInput J V (ρ.comp J.subtype) B
    ⟨inferInstance, hf.comp J.subtype_injective, inferInstance,
      (IsSQTK.equiv e).mpr hsq, by
        rw [hfit]
        exact (sup_eq_left.mpr (by
          rw [← hfit]
          exact (show center J ≤ fittingSubgroup J from le_sSup ⟨inferInstance, inferInstance⟩).trans
            (fitting_le_generalizedFitting J))).symm,
      hjcore, offenderSubgroup_restrict_eq_top ρ⟩
  obtain ⟨hi, hfaith, hirr, _, ⟨a⟩, _⟩ := source_tripleSix _ c (e.trans eC)
  exact ⟨⟨hCJ, c, hi, hfaith, hirr, a, source_invariant_split _ c (e.trans eC),
    source_central_eq_bot _ c (e.trans eC), source_moved_finrank _ c (e.trans eC)⟩⟩

omit [Finite D] [Module.Finite (ZMod 2) V] [C.Normal] in
/-- Its moved subspace is literally the original component commutator. -/
theorem ActionData.space_eq (m : ActionData ρ C) :
    m.conclusion.sectionData.space.toSubmodule = subspaceCommutator ρ ⊤ C := by
  rw [m.conclusion.sectionData.space_eq]
  change subspaceCommutator (ρ.comp (offenderSubgroup ρ).subtype) ⊤
    (C.subgroupOf (offenderSubgroup ρ)) = _
  rw [subspaceCommutator_comp_map, map_subgroupOf_eq_of_le m.component_le_offenders]

end Representation

variable {G : Type u} [Group G] [Finite G]

/-- Apply B.5.1 and the covered-six comparison to the actual original W_K.
The local Sylow, characteristic-two and invariance hypotheses discharge
faithfulness, the two-core, offender generation and the two-group quotient. -/
theorem source_actionData (K L T : Subgroup G) (z v : G)
    (hL : Tv T v ≤ normalizer (Lv L v : Set G))
    (hz : Tv T v ≤ centralizer ({z} : Set G))
    (hK : K ∈ Yz L T z v) (hn : Tv T v ≤ normalizer (K : Set G))
    (hLK : Lv L v ≤ K)
    (hSylow : Chapter1.IsSylowIn 2 (Tv T v) (Gv v))
    (hzOmega : z ∈ omegaOneCenterAmbient (Tv T v))
    (hchar : generalizedFitting (Gv v) = pCore 2 (Gv v))
    (hsq : IsSQTK KnownSimple.IsKnownSimple (plusImage K L T z v hL hz K))
    (eC : plusImage K L T z v hL hz K ≃* Atlas.Codes.HexEvenAutomorphisms) :
    let := wk_elementary K L T z v hK.1.1 hSylow hzOmega hchar
    let := plusImage_K_normal K L T z v hL hz hK hn
    Nonempty (ActionData (wkRepresentation K L T z v hL hz)
      (plusImage K L T z v hL hz K)) := by
  let := wk_elementary K L T z v hK.1.1 hSylow hzOmega hchar
  let : Module.Finite (ZMod 2) (Additive (WK K L T z v)) := Module.Finite.of_finite
  let C := plusImage K L T z v hL hz K
  have hR := plus_twoCore_eq_bot K L T z v hK.1.1 hL hz hSylow
  let : C.Normal := plusImage_K_normal K L T z v hL hz hK hn
  let : IsQuasisimple C := plusImage_K_quasisimple K L T z v hL hz hK hR
  obtain ⟨S, hS⟩ := hSylow
  have hT : IsPGroup 2 (Tv T v) := hS ▸ S.isPGroup'.map (Gv v).subtype
  have hquot : IsPGroup 2 (Gplus K L T z v hL hz ⧸ C) :=
    isPGroup_quotient_of_sup_eq_top C (plusImage K L T z v hL hz (Tv T v))
      (hT.comap_subtype.map _)
      (AlternatingModels.component_plus_generation K L T z v hL hz hn hLK)
  exact nonempty_actionData _ C eC hsq hquot hR
    (wkRepresentation_faithful K L T z v hL hz)
    (component_plus_le_offenders K L T z v hL hz
      ((mem_omegaOneCenterAmbient_iff (Tv T v) z).mp hzOmega).1 ⟨S, hS⟩ hK hn)

end CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceSmallModels.OriginalAssembly.CoveredSixModels
