/-!
# Applying B.5.1 to the actual A₇ offender actor

The normal self-centralizing component remains the generalized Fitting
subgroup after restriction to the subgroup generated by best offenders.
The complete known-simple B.5.1 theorem applies to that literal restriction.
Its moved space and central denominator extend back to the ambient actor
without changing their carriers. Faithfulness follows because the ambient
kernel centralizes the component. A trivial central denominator identifies
the quotient coordinates with the full moved module.

Source: Aschbacher–Smith B.5.1, pp.99–103, applied in 13.6.22, p.932.
-/

public section
open Subgroup Representation Representation.BinaryOffender Theory.GroupTheory
open CFSG.Quasithin.Chapter15.Section04.LocalSetup.TwoFactors.FFBranch.ClassificationComparison.FFAlternatives
namespace CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceSmallModels.OriginalAssembly.AlternatingModels
open SourceContainment.LinearThree.CentralAction.ModuleAlternatives.Classifier
open scoped IsMulCommutative
universe u v
variable {D : Type u} [Group D] [Finite D]
  {V : Type v} [AddCommGroup V] [Module (ZMod 2) V] [Module.Finite (ZMod 2) V]
  (ρ : Representation (ZMod 2) D V) (C : Subgroup D) [C.Normal]

theorem offender_source_conclusion [IsQuasisimple C] [IsSimpleGroup C]
    (hC : centralizer (C : Set D) = ⊥)
    (hsq : IsSQTK KnownSimple.IsKnownSimple C)
    (hf : Function.Injective ρ) (hCJ : C ≤ offenderSubgroup ρ) :
    Nonempty (ProjectiveLine.QuasisimpleSourceConclusion
      (ρ.comp (offenderSubgroup ρ).subtype) (C.subgroupOf (offenderSubgroup ρ))) := by
  let J := offenderSubgroup ρ
  let B := C.subgroupOf J
  let e : B ≃* C := subgroupOfEquivOfLe hCJ
  let : IsQuasisimple B := IsQuasisimple.of_mulEquiv e.symm
  let : IsSimpleGroup B := e.isSimpleGroup
  have hCB : centralizer (B : Set J) = ⊥ := by
    apply bot_unique
    intro x hx
    have hm : (x : D) ∈ centralizer (C : Set D) := by
      intro y hy
      exact congrArg Subtype.val (mem_centralizer_iff.mp hx ⟨y,hCJ hy⟩ hy)
    exact mem_bot.mpr (Subtype.ext (mem_bot.mp (hC ▸ hm)))
  have hfit : generalizedFitting J = B := generalizedFitting_eq_of_quasisimple_centralizer B hCB
  have hcore : pCore 2 J = ⊥ := SimpleSocle.pCore_eq_bot (SimpleSocle.radical_eq_bot B hCB) 2
  apply SourceB5.classification.quasisimple J V (ρ.comp J.subtype) B
  refine ⟨inferInstance, hf.comp J.subtype_injective, inferInstance,
    (IsSQTK.equiv e).mpr hsq, ?_, hcore, offenderSubgroup_restrict_eq_top ρ⟩
  rw [hfit]
  exact (sup_eq_left.mpr (by
    rw [← hfit]
    exact (show center J ≤ fittingSubgroup J from le_sSup ⟨inferInstance,inferInstance⟩).trans
      (fitting_le_generalizedFitting J))).symm

omit [Finite D] [Module.Finite (ZMod 2) V] in
noncomputable def ambientSection {H : Subgroup D} (hCH : C ≤ H)
    (s : MovedSection (ρ.comp H.subtype) (C.subgroupOf H)) : MovedSection ρ C :=
  SourceB5.movedSection (liftSection hCH
    (⟨s.space, s.space_eq, s.central, s.central_eq⟩ : ChapterB.QuasisimpleSource.MovedSection
      (ρ.comp H.subtype) (C.subgroupOf H)))

omit [Finite D] [Module.Finite (ZMod 2) V] in
/-- Extending the actor does not change the underlying central quotient. -/
theorem ambientSection_finrank {H : Subgroup D} (hCH : C ≤ H)
    (s : MovedSection (ρ.comp H.subtype) (C.subgroupOf H)) :
    Module.finrank (ZMod 2) ((ambientSection ρ C hCH s).space.toSubmodule ⧸
      (ambientSection ρ C hCH s).central.toSubmodule) =
    Module.finrank (ZMod 2) (s.space.toSubmodule ⧸ s.central.toSubmodule) := by rfl

omit [Finite D] [Module.Finite (ZMod 2) V] in
theorem ambientSection_irreducible {H : Subgroup D} (hCH : C ≤ H)
    (s : MovedSection (ρ.comp H.subtype) (C.subgroupOf H))
    (hi : IsIrreducible (s.action.comp (C.subgroupOf H).subtype)) :
    IsIrreducible ((ambientSection ρ C hCH s).action.comp C.subtype) := by
  let e : C.subgroupOf H ≃* C := subgroupOfEquivOfLe hCH
  exact (irreducible_comp_surjective_iff e.toMonoidHom e.surjective
    ((ambientSection ρ C hCH s).action.comp C.subtype)).mp hi

omit [Finite D] [Module.Finite (ZMod 2) V] in
/-- A model for the restricted component action extends to the same literal
moved quotient in the ambient actor. -/
theorem ambientSection_actionEquiv {H : Subgroup D} (hCH : C ≤ H)
    (s : MovedSection (ρ.comp H.subtype) (C.subgroupOf H))
    {J W : Type*} [Group J] [AddCommGroup W] [Module (ZMod 2) W]
    (σ : Representation (ZMod 2) J W)
    (e : ActionEquiv (s.action.comp (C.subgroupOf H).subtype) σ) :
    Nonempty (ActionEquiv ((ambientSection ρ C hCH s).action.comp C.subtype) σ) := by
  refine ⟨⟨(subgroupOfEquivOfLe hCH).symm.trans e.groupEquiv, e.linearEquiv, ?_⟩⟩
  intro c v
  exact e.intertwines ((subgroupOfEquivOfLe hCH).symm c) v

omit [Finite D] [Module.Finite (ZMod 2) V] in
theorem ambientSection_natural {H : Subgroup D} (hCH : C ≤ H)
    (s : MovedSection (ρ.comp H.subtype) (C.subgroupOf H))
    (hn : IsAlternatingNatural (s.action.comp (C.subgroupOf H).subtype) 7) :
    IsAlternatingNatural ((ambientSection ρ C hCH s).action.comp C.subtype) 7 := by
  obtain ⟨e⟩ := hn
  refine ⟨⟨(subgroupOfEquivOfLe hCH).symm.trans e.groupEquiv, e.linearEquiv, ?_⟩⟩
  intro c v
  exact e.intertwines ((subgroupOfEquivOfLe hCH).symm c) v
omit [Finite D] [Module.Finite (ZMod 2) V] in
theorem ambientSection_faithful {H : Subgroup D} (hCH : C ≤ H)
    (s : MovedSection (ρ.comp H.subtype) (C.subgroupOf H))
    (hC : centralizer (C : Set D) = ⊥) (hf : Function.Injective s.action) :
    Function.Injective (ambientSection ρ C hCH s).action := by
  let α := (ambientSection ρ C hCH s).action
  have hd : α.ker ⊓ C = ⊥ := by
    apply bot_unique
    intro x hx
    have he : (MovedSection.action _ s) (⟨x, hCH hx.2⟩ : H) = (MovedSection.action _ s) 1 := by
      rw [map_one]
      exact hx.1
    exact mem_bot.mpr (congrArg Subtype.val (hf he))
  have hc : ⁅α.ker, C⁆ = ⊥ := bot_unique ((commutator_le_inf _ _).trans_eq hd)
  exact α.ker_eq_bot_iff.mp (bot_unique
    ((commutator_eq_bot_iff_le_centralizer.mp hc).trans hC.le))

omit [Finite D] [Module.Finite (ZMod 2) V] [C.Normal] in
theorem full_moved_natural (s : MovedSection ρ C)
    (hz : s.central.toSubmodule = ⊥)
    (hn : IsAlternatingNatural (s.action.comp C.subtype) 7) :
    IsAlternatingNatural (s.space.toRepresentation.comp C.subtype) 7 := by
  obtain ⟨e⟩ := hn
  let q := (s.central.toSubmodule.quotEquivOfEqBot hz).symm
  refine ⟨⟨e.groupEquiv, q.trans e.linearEquiv, ?_⟩⟩
  intro c v
  exact e.intertwines c (q v)

omit [Finite D] [Module.Finite (ZMod 2) V] [C.Normal] in
theorem full_moved_dimension (s : MovedSection ρ C)
    (hz : s.central.toSubmodule = ⊥)
    (hd : Module.finrank (ZMod 2) (s.space.toSubmodule ⧸ s.central.toSubmodule) = 4) :
    Module.finrank (ZMod 2) s.space.toSubmodule = 4 :=
  (s.central.toSubmodule.quotEquivOfEqBot hz).finrank_eq.symm.trans hd

end CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceSmallModels.OriginalAssembly.AlternatingModels
