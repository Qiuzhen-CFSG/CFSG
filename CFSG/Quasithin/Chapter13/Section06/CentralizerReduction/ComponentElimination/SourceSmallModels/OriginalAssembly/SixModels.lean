open SourceOrthogonal.LocalAction
open ChapterB.QuasisimpleSource
universe u w

section Representation
variable {D : Type u} [Group D] [Finite D]
  {V : Type w} [AddCommGroup V] [Module (ZMod 2) V] [Module.Finite (ZMod 2) V]
  (ρ : Representation (ZMod 2) D V) (C : Subgroup D)

/-- The literal B.5 moved section on the best-offender actor, including its
central attachment and the natural A₆ marking on the central quotient. -/
structure ActionData where
  component_le_offenders : C ≤ offenderSubgroup ρ
  conclusion : ChapterB.SourceInduction.ProjectiveLine.QuasisimpleSourceConclusion
    (ρ.comp (offenderSubgroup ρ).subtype) (C.subgroupOf (offenderSubgroup ρ))
  irrPlus : IsIrrPlus (ρ.comp (offenderSubgroup ρ).subtype)
    (C.subgroupOf (offenderSubgroup ρ)) conclusion.sectionData.space.toSubmodule
  natural : Nonempty (ActionEquiv
    (conclusion.sectionData.action.comp (C.subgroupOf (offenderSubgroup ρ)).subtype)
    (alternatingNatural 6))

private theorem offender_source_conclusion [C.Normal] [IsQuasisimple C] [IsSimpleGroup C]
    (hC : centralizer (C : Set D) = ⊥)
    (hsq : IsSQTK KnownSimple.IsKnownSimple C)
    (hf : Function.Injective ρ) (hCJ : C ≤ offenderSubgroup ρ) :
    Nonempty (ChapterB.SourceInduction.ProjectiveLine.QuasisimpleSourceConclusion
      (ρ.comp (offenderSubgroup ρ).subtype) (C.subgroupOf (offenderSubgroup ρ))) := by
  let J := offenderSubgroup ρ
  let B := C.subgroupOf J
  let e : B ≃* C := subgroupOfEquivOfLe hCJ
  let : IsQuasisimple B := IsQuasisimple.of_mulEquiv e.symm
  let : IsSimpleGroup B := e.isSimpleGroup
  have hCB : centralizer (B : Set J) = ⊥ := by
    apply bot_unique
    intro x hx
    have hm : (x : D) ∈ centralizer (C : Set D) := by
      intro y hy
      exact congrArg Subtype.val (mem_centralizer_iff.mp hx ⟨y,hCJ hy⟩ hy)
    exact mem_bot.mpr (Subtype.ext (mem_bot.mp (hC ▸ hm)))
  have hfit : generalizedFitting J = B := generalizedFitting_eq_of_quasisimple_centralizer B hCB
  have hcore : pCore 2 J = ⊥ := SimpleSocle.pCore_eq_bot (SimpleSocle.radical_eq_bot B hCB) 2
  apply SourceCompletion.knownSimple_quasisimpleClassificationInput
    (fun _ _ _ => ChapterA.Section02.theoremA_knownSimple)
    (ChapterA.SQTKStructure.a36Input_of_theoremsAC
      (fun _ _ _ => ChapterA.Section02.theoremA_knownSimple)
      (fun _ _ _ => ChapterA.Section02.theoremC_knownSimple))
    ChapterB.SourceClassification.irreducibleClassification_knownSimple
    ChapterB.SourceInduction.nonbinaryG2RootPairInput J V (ρ.comp J.subtype) B
  refine ⟨inferInstance, hf.comp J.subtype_injective, inferInstance,
    (IsSQTK.equiv e).mpr hsq, ?_, hcore, offenderSubgroup_restrict_eq_top ρ⟩
  rw [hfit]
  exact (sup_eq_left.mpr (by
    rw [← hfit]
    exact (show center J ≤ fittingSubgroup J from le_sSup ⟨inferInstance,inferInstance⟩).trans
      (fitting_le_generalizedFitting J))).symm

theorem nonempty_actionData [C.Normal] [IsQuasisimple C] [IsSimpleGroup C]
    (eC : C ≃* alternatingGroup (Fin 6))
    (hC : centralizer (C : Set D) = ⊥)
    (hsq : IsSQTK KnownSimple.IsKnownSimple C)
    (hf : Function.Injective ρ) (hCJ : C ≤ offenderSubgroup ρ) :
    Nonempty (ActionData ρ C) := by
  obtain ⟨c⟩ := offender_source_conclusion ρ C hC hsq hf hCJ
  obtain ⟨hi, hn⟩ := ChapterC.C27Source.AlternatingSixMovedModel.source_natural
    (ρ.comp (offenderSubgroup ρ).subtype) c ((subgroupOfEquivOfLe hCJ).trans eC)
  exact ⟨⟨hCJ, c, hi, hn⟩⟩

omit [Finite D] [Module.Finite (ZMod 2) V] in
/-- The selected space is the literal full moved space of the original component. -/
theorem ActionData.space_eq (m : ActionData ρ C) :
    m.conclusion.sectionData.space.toSubmodule = subspaceCommutator ρ ⊤ C := by
  rw [m.conclusion.sectionData.space_eq]
  change subspaceCommutator (ρ.comp (offenderSubgroup ρ).subtype) ⊤
    (C.subgroupOf (offenderSubgroup ρ)) = _
  rw [subspaceCommutator_comp_map, map_subgroupOf_eq_of_le m.component_le_offenders]

omit [Finite D] [Module.Finite (ZMod 2) V] in
/-- Irr+ transfers back along the literal subgroup inclusion. -/
theorem ActionData.irrPlus_ambient (m : ActionData ρ C) :
    IsIrrPlus ρ C m.conclusion.sectionData.space.toSubmodule :=
  (IsIrrPlus.subgroupOf_iff ρ C (offenderSubgroup ρ) m.component_le_offenders _).mp m.irrPlus

end Representation

variable {G : Type u} [Group G] [Finite G]
  (K L T : Subgroup G) (z v : G)
  (hL : Tv T v ≤ normalizer (Lv L v : Set G))
  (hz : Tv T v ≤ centralizer ({z} : Set G))

/-- The original K-class descends to the component image; the A₆ order
has no odd prime cube and therefore supplies the strongly quasithin bounds. -/
theorem component_sqtk {Ξ : GroupClass.{u}}
    (hY : K ∈ Yz L T z v)
    (hsource : IsKGroup Ξ (Gv v))
    (e : plusImage K L T z v hL hz K ≃* alternatingGroup (Fin 6)) :
    IsSQTK Ξ (plusImage K L T z v hL hz K) := by
  have hcard : Nat.card (plusImage K L T z v hL hz K) = 360 := by
    rw [Nat.card_congr e.toEquiv, nat_card_alternatingGroup]
    norm_num [Nat.factorial]
  refine ⟨?_, ?_⟩
  · intro p hp ho
    let : Fact p.Prime := ⟨hp⟩
    apply primeRank_le_two_of_cube_not_dvd
    rw [hcard]
    intro hd
    have hpd : p ∣ 2 ^ 3 * 3 ^ 2 * 5 :=
      (dvd_pow_self p (by decide : 3 ≠ 0)).trans hd
    have hsmall : p ∣ 2 ∨ p ∣ 3 ∨ p ∣ 5 := by
      rcases hp.dvd_mul.mp hpd with h | h
      · rcases hp.dvd_mul.mp h with h | h
        · exact .inl (hp.dvd_of_dvd_pow h)
        · exact .inr (.inl (hp.dvd_of_dvd_pow h))
      · exact .inr (.inr h)
    have heq (q : ℕ) (hq : q.Prime) (h : p ∣ q) : p = q :=
      (Nat.prime_dvd_prime_iff_eq hp hq).mp h
    rcases hsmall with h | h | h
    · have he := heq 2 (by decide) h
      subst p
      exact ho.not_two_dvd_nat (dvd_refl 2)
    · have he := heq 3 (by decide) h
      subst p
      norm_num at hd
    · have he := heq 5 (by decide) h
      subst p
      norm_num at hd
  · exact (hsource.of_injective (inclusion hY.1.1) (inclusion_injective hY.1.1)).of_surjective
      (imageProjection K L T z v hL hz K (K_le_plusActor K L T v))
      (imageProjection_surjective K L T z v hL hz K (K_le_plusActor K L T v))

/-- The original A₆ component is self-centralizing in the two-reduced plus actor. -/
theorem component_centralizer_eq_bot
    (hY : K ∈ Yz L T z v)
    (hn : Tv T v ≤ normalizer (K : Set G)) (hLK : Lv L v ≤ K)
    (hSylow : Chapter1.IsSylowIn 2 (Tv T v) (Gv v))
    (hR : pCore 2 (Gplus K L T z v hL hz) = ⊥)
    (e : plusImage K L T z v hL hz K ≃* alternatingGroup (Fin 6)) :
    centralizer (plusImage K L T z v hL hz K : Set (Gplus K L T z v hL hz)) = ⊥ := by
  let C := plusImage K L T z v hL hz K
  let : C.Normal := plusImage_K_normal K L T z v hL hz hY hn
  let : IsSimpleGroup (alternatingGroup (Fin 6)) := alternatingGroup.isSimpleGroup (by simp)
  let : IsSimpleGroup C := e.isSimpleGroup
  let : IsQuasisimple C := plusImage_K_quasisimple K L T z v hL hz hY hR
  obtain ⟨S, hS⟩ := hSylow
  have hT : IsPGroup 2 (Tv T v) := hS ▸ S.isPGroup'.map (Gv v).subtype
  have hquot : IsPGroup 2 (Gplus K L T z v hL hz ⧸ C) :=
    isPGroup_quotient_of_sup_eq_top C (plusImage K L T z v hL hz (Tv T v))
      (hT.comap_subtype.map _)
      (AlternatingModels.component_plus_generation K L T z v hL hz hn hLK)
  exact centralizer_eq_bot_of_simple_two_quotient C
    (Group.IsPerfect.not_isMulCommutative C) hquot hR

/-- B.5.1 on the original plus-A₆ action supplies its natural moved quotient,
including Irr+ and its literal central attachment, without a classifier premise. -/
theorem source_actionData
    (hK : K ∈ Yz L T z v) (hn : Tv T v ≤ normalizer (K : Set G))
    (hLK : Lv L v ≤ K)
    (hSylow : Chapter1.IsSylowIn 2 (Tv T v) (Gv v))
    (hzOmega : z ∈ omegaOneCenterAmbient (Tv T v))
    (hchar : generalizedFitting (Gv v) = pCore 2 (Gv v))
    (hsource : IsKGroup KnownSimple.IsKnownSimple (Gv v))
    (eC : plusImage K L T z v hL hz K ≃* alternatingGroup (Fin 6)) :
    let := wk_elementary K L T z v hK.1.1 hSylow hzOmega hchar
    Nonempty (ActionData (wkRepresentation K L T z v hL hz)
      (plusImage K L T z v hL hz K)) := by
  let := wk_elementary K L T z v hK.1.1 hSylow hzOmega hchar
  let : Module.Finite (ZMod 2) (Additive (WK K L T z v)) := Module.Finite.of_finite
  let C := plusImage K L T z v hL hz K
  have hR := plus_twoCore_eq_bot K L T z v hK.1.1 hL hz hSylow
  let : C.Normal := plusImage_K_normal K L T z v hL hz hK hn
  let : IsSimpleGroup (alternatingGroup (Fin 6)) := alternatingGroup.isSimpleGroup (by simp)
  let : IsSimpleGroup C := eC.isSimpleGroup
  let : IsQuasisimple C := plusImage_K_quasisimple K L T z v hL hz hK hR
  exact nonempty_actionData _ C eC
    (component_centralizer_eq_bot K L T z v hL hz hK hn hLK hSylow hR eC)
    (component_sqtk K L T z v hL hz hK hsource eC)
    (wkRepresentation_faithful K L T z v hL hz)
    (component_plus_le_offenders K L T z v hL hz
      ((mem_omegaOneCenterAmbient_iff (Tv T v) z).mp hzOmega).1 hSylow hK hn)

end CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceSmallModels.OriginalAssembly.SixModels
