module
public import CFSG.Quasithin.Chapter13.Section09.TerminalSubgroup.SourceCoordinates
public import CFSG.Quasithin.Chapter13.Section09.LocalGeometry.InvolutionClasses

/-!
# Original coordinate inputs for the 13.9.10 alignment

The original E meets B in the line generated by t. Hence any E-element
outside B, multiplied by z, is a literal local conjugate of z outside B.
The eight-group B∩Q has ambient centralizer B: the source common centralizer
puts it in J(T), and one diagonal reflection forces both dihedral coordinates
into the designated nonnormal four-planes.
Source: Aschbacher--Smith, 13.9.10, printed p.973.
-/

public section
namespace CFSG.Quasithin.Chapter13.Section09.Marking
open Subgroup SymmetricFourWreath SymmetricFourWreath.InvolutionClasses
private instance : DecidableEq W := (RegularWreathProduct.equivProd S4 C2).injective.decidableEq
variable {G : Type*} [Group G] {d : Configuration G} (m : Marking d)

private theorem z_mem_marked_B : m.z∈m.B := by
  rw [←m.sylowModelEmbedding_center]
  exact (m.elementaryGroup_coordinate (DihedralGroup.r 2) (DihedralGroup.r 2) false false).mpr
    ⟨by decide,by decide⟩

theorem terminalFour_inf_B : m.terminalFour⊓m.B=zpowers m.t := by
  apply le_antisymm
  · rintro x ⟨⟨⟨a,b⟩,⟨ha,hb⟩,rfl⟩,hxB⟩
    change b=1 at hb
    subst b
    have haf:=((m.elementaryGroup_coordinate a 1 false false).mp hxB).1
    have ha' : a=1 ∨ a=DihedralGroup.r 2 :=
      (by decide : ∀a:D8,a∈plane true→a∈plane false→a=1∨a=DihedralGroup.r 2) a ha haf
    rcases ha' with rfl|rfl
    · exact (map_one m.baseProductEmbedding) ▸ (zpowers m.t).one_mem
    · rw [m.baseProductEmbedding_axis]
      exact mem_zpowers _
  · apply zpowers_le.mpr
    refine ⟨m.t_mem_terminalFour,?_⟩
    rw [←m.baseProductEmbedding_axis]
    exact (m.elementaryGroup_coordinate _ _ false false).mpr ⟨by decide,(plane false).one_mem⟩

/-- An element of E outside B gives exactly the local conjugate used in13.9.10. -/
theorem terminalFour_mul_z_conjugate (e:G) (he:e∈m.terminalFour) (heB:e∉m.B) :
    IsConj m.z (e*m.z) ∧ e*m.z∉m.B := by
  constructor
  · obtain ⟨⟨a,b⟩,⟨ha,hb⟩,rfl⟩:=he
    change b=1 at hb
    subst b
    have haf : a∉plane false := by
      intro ha'
      exact heB ((m.elementaryGroup_coordinate a 1 false false).mpr ⟨ha',(plane false).one_mem⟩)
    have hcert : (sylowEmbedding (pair (a,1))*SymmetricFourWreath.z)^2=1 ∧
        sylowEmbedding (pair (a,1))*SymmetricFourWreath.z≠1 ∧
        classIndex (sylowEmbedding (pair (a,1))*SymmetricFourWreath.z)=0 :=
      (by decide +kernel : ∀a:D8,a∈plane true→a∉plane false→
        (sylowEmbedding (pair (a,1))*SymmetricFourWreath.z)^2=1 ∧
        sylowEmbedding (pair (a,1))*SymmetricFourWreath.z≠1 ∧
        classIndex (sylowEmbedding (pair (a,1))*SymmetricFourWreath.z)=0) a ha haf
    have hdata := And.intro (orderOf_eq_prime hcert.1 hcert.2.1) hcert.2.2
    have hconj: IsConj SymmetricFourWreath.z (sylowEmbedding (pair (a,1))*SymmetricFourWreath.z) :=
      (isConj_representative_iff 0 _).mpr hdata
    simpa only [map_mul,Marking.z,baseProductEmbedding,MonoidHom.comp_apply] using m.embedding.map_isConj hconj
  · intro h
    have hzB := m.z_mem_marked_B
    exact heB (by simpa only [mul_inv_cancel_right] using m.B.mul_mem h (m.B.inv_mem hzB))

private theorem diagonal_reflection_mem_B_core :
    m.baseProductEmbedding (DihedralGroup.sr 0,DihedralGroup.sr 0)∈m.B⊓m.core := by
  refine ⟨(m.elementaryGroup_coordinate _ _ false false).mpr ⟨by decide,by decide⟩,?_⟩
  apply mem_map_of_mem m.sylowModelEmbedding
  exact (mem_coreInP _).mpr (by decide)

variable [Finite G]

/-- The intrinsic eight-group in B has exactly B as its ambient centralizer. -/
theorem centralizer_B_inf_core (hE:IsEvenCharacteristicAt d.T) :
    centralizer (m.B⊓m.core:Set G)=m.B := by
  have htB : m.t∈m.B := by
    rw [←m.baseProductEmbedding_axis]
    exact (m.elementaryGroup_coordinate _ _ false false).mpr ⟨by decide,by decide⟩
  have hzB := m.z_mem_marked_B
  apply le_antisymm
  · intro x hx
    have hxJ : x∈m.dihedralBase := by
      rw [←m.elementary_thompson,←m.marked_common_centralizer hE]
      exact ⟨mem_centralizer_singleton_iff.mpr
        (mem_centralizer_iff.mp hx m.z ⟨hzB,m.z_mem_core⟩).symm,
        mem_centralizer_singleton_iff.mpr
        (mem_centralizer_iff.mp hx m.t ⟨htB,m.t_mem_core⟩).symm⟩
    rw [←m.range_baseProductEmbedding] at hxJ
    obtain ⟨⟨a,b⟩,rfl⟩:=hxJ
    have hc:=mem_centralizer_iff.mp hx _ m.diagonal_reflection_mem_B_core
    rw [←map_mul,←map_mul] at hc
    have hab:=m.baseProductEmbedding_injective hc
    have ha : a∈plane false :=
      (by decide : ∀a:D8,DihedralGroup.sr 0*a=a*DihedralGroup.sr 0→a∈plane false) a
        (congrArg Prod.fst hab)
    have hb : b∈plane false :=
      (by decide : ∀a:D8,DihedralGroup.sr 0*a=a*DihedralGroup.sr 0→a∈plane false) b
        (congrArg Prod.snd hab)
    exact (m.elementaryGroup_coordinate a b false false).mpr ⟨ha,hb⟩
  · exact (le_centralizer_iff_isMulCommutative.mpr inferInstance).trans (centralizer_le inf_le_left)

end CFSG.Quasithin.Chapter13.Section09.Marking
