module
public import CFSG.Quasithin.Chapter13.Section09.TerminalSubgroup.SourceProjection
public import CFSG.Quasithin.Chapter13.Section09.TerminalSubgroup.SourceModels
public import CFSG.Quasithin.ChapterI.Section04To05.Dihedral.Eight
public import Theory.GroupTheory.SylowElementConjugacy

/-!
# Recognition of the original terminal residual

An order-eight subgroup generated by the two source A₄ cores fills the
actual Sylow of H = O²(C_G(E)), by the faithful second-coordinate projection.
Its central involution has this entire Sylow as its centralizer. Internal
fusion of its involutions supplies the literal I.4.1 hypotheses. The actual
quasithin bound and A₄ pointwise-fixer geometry exclude A₆ and centralize the
PSL₃(2) outcome by the original first S₄ factor.

Source: Aschbacher--Smith, proof of 13.9.1, printed pp.973--974.
-/

public section
namespace CFSG.Quasithin.Chapter13.Section09.Marking
open Subgroup SymmetricFourWreath TerminalSubgroup
variable {G:Type*} [Group G] [Finite G] {d:Configuration G} (m:Marking d)

/-- Recognition applies to the literal terminal residual once its two original
A4 cores generate an order-eight subgroup and fuse its involutions there. -/
theorem terminal_recognition_of_generated_base
    (hE:IsEvenCharacteristicAt d.T) (D:Subgroup G) (hDJ:D≤m.dihedralBase)
    (hDH:D≤terminal m.terminalFour) (hcard:Nat.card D=8) (hz:m.t*m.z∈D)
    (hfusion:∀x:D,orderOf x=2→IsConj (⟨(x:G),hDH x.property⟩:terminal m.terminalFour)
      ⟨m.t*m.z,hDH hz⟩) :
    Nonempty (terminal m.terminalFour≃*Matrix.ProjectiveSpecialLinearGroup (Fin 3) (ZMod 2)) ∨
      Nonempty (terminal m.terminalFour≃*alternatingGroup (Fin 6)) := by
  let H:=terminal m.terminalFour
  let z:H:=⟨m.t*m.z,hDH hz⟩
  have hzorder:orderOf z=2 := by
    rw [←orderOf_coe z]
    change orderOf (m.t*m.z)=2
    have he : m.t*m.z=m.s*m.t*m.s⁻¹ := by
      rw [m.z_eq,←mul_assoc,m.t_sq,one_mul]
    rw [he]
    exact ((MulAut.conj m.s).orderOf_eq m.t).trans m.t_order
  obtain ⟨P,hP⟩:=m.exists_terminalBase_sylow
  rw [m.terminalBase_eq_of_eight D hDJ hDH hcard] at hP
  have hcent : Nonempty (centralizer ({z}:Set H)≃*D8) := by
    let e:(centralizer ({z}:Set H))≃*D :=
      ((centralizer ({z}:Set H)).equivMapOfInjective H.subtype H.subtype_injective).trans
        (MulEquiv.subgroupCongr ((m.terminal_centralizer_eq_base hE (hDH hz)).trans
          (m.terminalBase_eq_of_eight D hDJ hDH hcard)))
    exact ⟨e.trans (m.terminalBaseDihedralEquiv D hDJ hDH hcard)⟩
  apply DihedralInvolutionCentralizerHypotheses.recognize_eight
  refine {two_le:=by decide,z:=z,involution:=?_,involutions_conjugate:=?_,centralizer_equiv:=hcent}
  · exact ⟨by intro he;rw [he,orderOf_one] at hzorder;omega,by rw [←hzorder];exact pow_orderOf_eq_one z⟩
  · intro x hx
    have hxorder:orderOf x=2:=orderOf_eq_prime hx.2 hx.1
    obtain ⟨y,hy⟩:=P.exists_isConj_of_orderOf_eq_prime_pow (n:=1) (by simpa using hxorder)
    have hyD:((y:H):G)∈D := hP ▸ mem_map_of_mem H.subtype y.property
    have hxy := hy
    obtain ⟨c,hc⟩ := hxy
    have hyorder:orderOf (⟨((y:H):G),hyD⟩:D)=2 := by
      rw [←orderOf_coe]
      exact (orderOf_injective H.subtype H.subtype_injective (y:H)).trans
        ((SemiconjBy.orderOf_eq (c : H) hc).symm.trans hxorder)
    have hf:=hfusion ⟨((y:H):G),hyD⟩ hyorder
    exact isConj_iff.mp (hy.trans hf)

/-- The actual quasithin hypothesis eliminates the A6 result, leaving a
centralized PSL3(2) on the original terminal subgroup. -/
theorem terminal_psl3Two_of_generated_base
    {𝒦:GroupClass} (hG:IsSimpleQTKE 𝒦 G)
    (D:Subgroup G) (hDJ:D≤m.dihedralBase) (hDH:D≤terminal m.terminalFour)
    (hcard:Nat.card D=8) (hz:m.t*m.z∈D)
    (hfusion:∀x:D,orderOf x=2→IsConj (⟨(x:G),hDH x.property⟩:terminal m.terminalFour)
      ⟨m.t*m.z,hDH hz⟩) :
    Nonempty (terminal m.terminalFour≃*Matrix.ProjectiveSpecialLinearGroup (Fin 3) (ZMod 2)) ∧
      m.factor 1≤centralizer (terminal m.terminalFour:Set G) := by
  rcases m.terminal_recognition_of_generated_base (hG.evenCharacteristic d.T) D hDJ hDH hcard hz hfusion with h | h
  · rcases h with ⟨e⟩
    exact ⟨⟨e⟩,m.terminal_centralized_of_psl3Two e⟩
  · rcases h with ⟨e⟩
    exact (m.false_of_terminal_alternatingSix hG.quasithin e).elim
end CFSG.Quasithin.Chapter13.Section09.Marking
