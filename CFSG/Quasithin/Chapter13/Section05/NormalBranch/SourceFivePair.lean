module
public import CFSG.Quasithin.Chapter13.Section05.NormalBranch.SourcePointCore
public import Theory.SpecificGroups.SymmetricSix.BinaryFlags.FivePair
public import Theory.GroupTheory.ConjugatePairInternalLift

/-!
# The original selected A₅ image in the ordinary A₆ branch

Lift the marked cubic (04)(14) through the original natural quotient.
It fixes one letter fixed by the point residual, but moves the source line.
The original U_H has the full even point-core image, so its pair with the
selected conjugate maps onto the actual five-letter alternating subgroup.
The entire generated pair lies in the original L.

This supplies the quotient-generation step of13.5.14(3). It asserts no
A₅ block structure before the G.2.4 source substitution is established.
In particular it does not require the original Sylow to normalize this
five-letter subgroup, an unavailable assumption in the n=6 case.

Source: Aschbacher–Smith,13.5.14(3–4), printed p.919.
-/

@[expose] public section
open Subgroup BinaryPermutation
namespace CFSG.Quasithin.Chapter13.Section05.NormalBranch.SourceFivePair
open Section08.SourceCompletion
open Theory.SpecificGroups.SymmetricSix.BinaryFlags
open Theory.SpecificGroups.SymmetricSix.BinaryFlags.NaturalGeometry
open PlaneGeometry.TwoBlocks
variable {G : Type*} [Group G] [Finite G]
  {D : ChapterF.Section09.Setup G} {V₂ M : Subgroup G}
  (d : NaturalSetup D.T D.L D.V D.V₁ V₂ D.Vplus M D.Gz)
include d

omit d [Finite G] in
theorem pair_inside (hUL : D.UH ≤ D.L) (g : D.L) : NormalBranch.K D g.val ≤ D.L := by
  apply sup_le hUL
  rintro _ ⟨u,hu,rfl⟩
  change g.val⁻¹*u*(g.val⁻¹)⁻¹∈D.L
  rw [inv_inv]
  exact D.L.mul_mem (D.L.mul_mem (D.L.inv_mem g.property) (hUL hu)) g.property

theorem pair_image (hUL : D.UH ≤ D.L) (g : D.L) :
    ((NormalBranch.K D g.val).subgroupOf D.L).map (localMap d) =
      ((D.UH.subgroupOf D.L).map (localMap d)) ⊔
      ((D.UH.subgroupOf D.L).map (localMap d)).map
        (MulAut.conj (localMap d g)⁻¹).toMonoidHom := by
  have hc : (ChapterG.Section02.Setup.conjugate D.UH g.val).subgroupOf D.L =
      (D.UH.subgroupOf D.L).map (MulAut.conj g⁻¹).toMonoidHom :=
    (conj_smul_subgroupOf hUL g⁻¹).symm
  have hcg : ChapterG.Section02.Setup.conjugate D.UH g.val ≤ D.L :=
    le_sup_right.trans (pair_inside hUL g)
  have hi : (NormalBranch.K D g.val).subgroupOf D.L =
      D.UH.subgroupOf D.L ⊔ (ChapterG.Section02.Setup.conjugate D.UH g.val).subgroupOf D.L := by
    apply map_injective D.L.subtype_injective
    rw [map_subgroupOf_eq_of_le (pair_inside hUL g),Subgroup.map_sup,
      map_subgroupOf_eq_of_le hUL,map_subgroupOf_eq_of_le hcg]
    rfl
  rw [hi,Subgroup.map_sup,hc]
  congr 1
  change ((D.UH.subgroupOf D.L).conjBy g⁻¹).map (localMap d) =
    ((D.UH.subgroupOf D.L).map (localMap d)).conjBy (localMap d g)⁻¹
  rw [map_conjBy_hom,map_inv]

/-- The chosen original element fixes a source letter but moves its point;
the pair generated by the actual U_H has precisely the marked A₅ image. -/
theorem exists_original_five_pair (h : D.Hypothesis)
    (e : (D.L ⧸ pCore 2 D.L) ≃* alternatingGroup (Fin 6))
    (hseed : D.Vplus = ⁅D.V,D.L₁⁆) (hn : (D.L₁.subgroupOf D.H).Normal)
    (hU : ¬ IsMulCommutative D.UH) :
    ∃ a : alternatingGroup (Fin 6),
      Section07.NaturalAction.image d D.V₁ = move a.val canonicalLine ∧
      ∃ g : D.L, localMap d g = a.val*FivePair.mover*a.val⁻¹ ∧
        g.val ∉ D.Gz ∧ localMap d g (a.val 5)=a.val 5 ∧
        NormalBranch.K D g.val ≤ D.L ∧
        ((NormalBranch.K D g.val).subgroupOf D.L).map (localMap d) =
          FivePair.five.map (MulAut.conj a.val).toMonoidHom := by
  obtain ⟨a,ha,_⟩ := QuadraticSource.source_even_flag d
  have hr : a.val*FivePair.mover*a.val⁻¹ ∈ alternatingGroup (Fin 6) :=
    (inferInstance : (alternatingGroup (Fin 6)).Normal).conj_mem _ FivePair.mover_mem.2 a.val
  have hrange : a.val*FivePair.mover*a.val⁻¹ ∈ (localMap d).range :=
    (localMap_range d).symm ▸ hr
  obtain ⟨g,hg⟩ := hrange
  have hUL := (closure_reduction h hseed hn).2.2
  refine ⟨a,ha,g,hg,?_,?_,pair_inside hUL g,?_⟩
  · intro hz
    have hh := (ReturningPlane.localNormalizer_mem d D.V₁
      (h.point_lt.le.trans h.plus_le) g).mp (h.normalizer_point_eq.symm ▸ hz)
    rw [hg,ha,flagStabilizer_move,flagStabilizer_line] at hh
    have hc : FivePair.mover∈H1 := by
      have hs : (MulAut.conj a.val) FivePair.mover ∈ H1.map (MulAut.conj a.val).toMonoidHom := hh
      simpa only [MulEquiv.symm_apply_apply] using mem_map_equiv.mp hs
    exact FivePair.mover_moves_line hc
  · rw [hg]
    change a.val (FivePair.mover (a.val.symm (a.val 5)))=a.val 5
    rw [a.val.symm_apply_apply]
    exact congrArg a.val FivePair.mover_mem.1
  · rw [pair_image d hUL g,hg,SourcePointCore.closure_image_eq_point_core d h e hseed hn hU a ha]
    exact FivePair.marked_pair_generates a.val

end CFSG.Quasithin.Chapter13.Section05.NormalBranch.SourceFivePair
end
