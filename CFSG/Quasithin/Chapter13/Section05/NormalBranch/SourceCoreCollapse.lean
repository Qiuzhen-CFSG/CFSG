/-!
# The terminal core collapse for the original normal A₆ pair

A cubic element of the literal L₁ image acts fixed-point-freely on the
recognized natural upper section. Surjectivity of its commutator map
lifts to S=[S,L₁]V, where S=O₂(K). The original F.9 centrality then makes
U_H act trivially on S/V. Since K is generated by U_H and U_H^g, the
entire K action is trivial. Its two complementary marked images coincide,
so S/V vanishes and O₂(K)=V.

The final theorem constructs the selected original pair and discharges
all upper-action and recognition inputs. This is the genuine terminal
core conclusion needed for13.5.15(3–5), without a fixed-T G.2 marking.

Source: Aschbacher–Smith,G.2.4(8), printed pp.334–335, applied in13.5.15,
printed p.920.
-/

@[expose] public section
open Subgroup
open scoped MatrixGroups commutatorElement IsMulCommutative
namespace CFSG.Quasithin.Chapter13.Section05.NormalBranch.SourceCoreCollapse
open Section08.SourceCompletion
open Theory.SpecificGroups.SymmetricSix.BinaryFlags
open PlaneGeometry.TwoBlocks
open SourceFiveModule SourceUpperStructure SourceUpperAction SourceUpperBorel SourceUpperNatural
open ChapterG.Section02.AlternatingFive.Recognition.ProjectiveGeometry
variable {G : Type*} [Group G] [Finite G] {D : ChapterF.Section09.Setup G}
  {V₂ M : Subgroup G}
  (d : NaturalSetup D.T D.L D.V D.V₁ V₂ D.Vplus M D.Gz)

theorem exists_local_cubic (h : D.Hypothesis) (g : D.L)
    (hK : NormalBranch.K D g.val ≤ D.L) (hL : D.L₁ ≤ NormalBranch.K D g.val)
    (a : alternatingGroup (Fin 6))
    (hi : ((NormalBranch.K D g.val).subgroupOf D.L).map (localMap d) =
      FivePair.five.map (MulAut.conj a.val).toMonoidHom) :
    ∃t:NormalBranch.K D g.val,t.val∈D.L₁∧orderOf (restrictedActor d hK a hi t)=3 := by
  let B := (D.L₁.subgroupOf (NormalBranch.K D g.val)).map (restrictedActor d hK a hi)
  have hc : Nat.card B=12 := local_image_card d h g hK hL a hi
  obtain ⟨x,hx⟩ := exists_prime_orderOf_dvd_card' (G:=B) 3 (by rw [hc];decide)
  obtain ⟨t,ht,he⟩ := x.property
  exact ⟨t,ht,by rw [he];exact (orderOf_injective B.subtype B.subtype_injective x).trans hx⟩

theorem full_core_commutator (h : D.Hypothesis)
    (e : (D.L ⧸ pCore 2 D.L) ≃* alternatingGroup (Fin 6))
    (hseed : D.Vplus = ⁅D.V,D.L₁⁆) (hn : (D.L₁.subgroupOf D.H).Normal)
    (hU : ¬ IsMulCommutative D.UH) (g : D.L) (hgn : g.val∉D.Gz)
    (hg : g.val∈NormalBranch.K D g.val)
    (hK : NormalBranch.K D g.val ≤ D.L) (hL : D.L₁ ≤ NormalBranch.K D g.val)
    (hp : IsPPerfect 2 (NormalBranch.K D g.val)) (a : alternatingGroup (Fin 6))
    (hi : ((NormalBranch.K D g.val).subgroupOf D.L).map (localMap d) =
      FivePair.five.map (MulAut.conj a.val).toMonoidHom)
    {E : Type*} [AddCommGroup E] [Module (ZMod 2) E] [Finite E]
    (σ : Representation (ZMod 2) (alternatingGroup (Fin 5)) E)
    (c : Representation.BinaryConjugationSection (NormalBranch.K D g.val)
      ((NormalBranch.K D g.val).pCoreIn 2) D.V (σ.comp (restrictedActor d hK a hi))) :
    (NormalBranch.K D g.val).pCoreIn 2 =
      ⁅(NormalBranch.K D g.val).pCoreIn 2,D.L₁⁆⊔D.V := by
  let := (ZMod.algebra F4 2).toModule
  obtain ⟨m,s,q,hq⟩ := natural_coordinates d h e hseed hn hU g hgn hg hK hL hp a hi σ c
  obtain ⟨t,htL,ht⟩ := exists_local_cubic d h g hK hL a hi
  apply c.section_eq_commutator_sup_of_fixedPointFree D.L₁ hL t htL
  intro v hv
  apply q.injective
  rw [map_zero]
  funext j
  have hh := hq (restrictedActor d hK a hi t) v j
  change σ (restrictedActor d hK a hi t) v=v at hv
  rw [hv] at hh
  exact Matrix.SL2.cubic_fixed_eq_zero _ ((m.orderOf_eq _).trans ht) _ hh.symm

theorem core_commutator_closure (h : D.Hypothesis)
    (e : (D.L ⧸ pCore 2 D.L) ≃* alternatingGroup (Fin 6))
    (hn : (D.L₁.subgroupOf D.H).Normal)
    (g : D.L) (hK : NormalBranch.K D g.val ≤ D.L) (hL : D.L₁ ≤ NormalBranch.K D g.val)
    (a : alternatingGroup (Fin 6))
    (hi : ((NormalBranch.K D g.val).subgroupOf D.L).map (localMap d) =
      FivePair.five.map (MulAut.conj a.val).toMonoidHom)
    (hfull : (NormalBranch.K D g.val).pCoreIn 2 =
      ⁅(NormalBranch.K D g.val).pCoreIn 2,D.L₁⁆⊔D.V) :
    ⁅(NormalBranch.K D g.val).pCoreIn 2,D.UH⁆≤D.V := by
  have hbound : (NormalBranch.K D g.val).pCoreIn 2≤D.L₁.pCoreIn 2⊔D.V := by
    rw [hfull]
    exact sup_le_sup (core_commutator_le_local_core d h e g hK hL a hi) le_rfl
  have hcore : D.L₁.pCoreIn 2≤D.QH := (local_core_intersection h hn).symm.le.trans inf_le_right
  have hloc : D.L₁.pCoreIn 2≤normalizer (D.V:Set G) :=
    ((pCoreIn_le 2 D.L₁).trans (hL.trans hK)).trans (le_sup_left.trans d.normalizes_V)
  have hUn : D.UH≤normalizer (D.V:Set G) :=
    ((show D.UH≤NormalBranch.K D g.val from le_sup_left).trans hK).trans
      (le_sup_left.trans d.normalizes_V)
  have hc : ⁅D.L₁.pCoreIn 2,D.UH⁆≤D.V :=
    ((commutator_mono hcore le_rfl).trans
      (commutator_comm D.UH D.QH ▸ h.commutator_UH_QH_le_point)).trans
        (h.point_lt.le.trans h.plus_le)
  have hpre : (NormalBranch.K D g.val).pCoreIn 2≤
      commutatorPreimage (normalizer (D.V:Set G)) D.UH D.V :=
    hbound.trans (sup_le (le_commutatorPreimage hloc hc)
      (le_commutatorPreimage D.V.le_normalizer (le_normalizer_iff_commutator_le_left.mp hUn)))
  exact (commutator_mono hpre le_rfl).trans (commutator_commutatorPreimage_le _ _ _ le_rfl)

theorem core_eq_module (h : D.Hypothesis)
    (e : (D.L ⧸ pCore 2 D.L) ≃* alternatingGroup (Fin 6))
    (hseed : D.Vplus = ⁅D.V,D.L₁⁆) (hn : (D.L₁.subgroupOf D.H).Normal)
    (hU : ¬ IsMulCommutative D.UH) (g : D.L) (hgn : g.val∉D.Gz)
    (hg : g.val∈NormalBranch.K D g.val)
    (hK : NormalBranch.K D g.val ≤ D.L) (hL : D.L₁ ≤ NormalBranch.K D g.val)
    (hp : IsPPerfect 2 (NormalBranch.K D g.val)) (a : alternatingGroup (Fin 6))
    (hi : ((NormalBranch.K D g.val).subgroupOf D.L).map (localMap d) =
      FivePair.five.map (MulAut.conj a.val).toMonoidHom) :
    (NormalBranch.K D g.val).pCoreIn 2=D.V := by
  let J := NormalBranch.K D g.val
  let S := J.pCoreIn 2
  let W := D.UH⊓S
  let f := restrictedActor d hK a hi
  let k : J := ⟨g.val,hg⟩
  let := module_normal_in_core d g hK
  let := upper_elementary d h e hseed hn hU g hg hK hL hp a hi
  obtain ⟨σ,c,hcoord⟩ := upper_action d h e hseed hn hU g hg hK hL hp a hi
  have hfull : S=⁅S,D.L₁⁆⊔D.V := full_core_commutator (E:=Additive (S ⧸ D.V.subgroupOf S))
    d h e hseed hn hU g hgn hg hK hL hp a hi σ c
  have hc := core_commutator_closure d h e hn g hK hL a hi hfull
  let ρ := σ.comp f
  have hUker : D.UH.subgroupOf J≤ρ.ker := by
    intro u hu
    apply LinearMap.ext
    intro v
    obtain ⟨s,hs⟩ := c.onto (Multiplicative.ofAdd v)
    have hfix := c.fixed_on_imageSpace_of_commutator_le D.UH S
      (commutator_comm S D.UH ▸ hc) u hu (c.coordinates s).toAdd
      ((c.mem_imageSpace_iff S _).mpr ⟨s,s.property,rfl⟩)
    change ρ u v=v
    simpa only [hs,toAdd_ofAdd] using hfix
  have hgker : k⁻¹∈ρ.ker := by
    have hconj : (D.UH.subgroupOf J).map (MulAut.conj k⁻¹).toMonoidHom≤ρ.ker := by
      have hm := map_mono (f:=(MulAut.conj k⁻¹).toMonoidHom) hUker
      have he : ρ.ker.map (MulAut.conj k⁻¹).toMonoidHom=ρ.ker :=
        mem_normalizer_iff_map_conj_eq.mp (ρ.ker.normalizer_eq_top ▸ mem_top _)
      rwa [he] at hm
    have hgen : D.UH.subgroupOf J⊔(D.UH.subgroupOf J).map (MulAut.conj k⁻¹).toMonoidHom=⊤ := by
      apply map_injective J.subtype_injective
      rw [Subgroup.map_sup,map_subgroupOf_eq_of_le (show D.UH≤J from le_sup_left),
        map_map,←MonoidHom.range_eq_map,range_subtype]
      change D.UH⊔(D.UH.subgroupOf J).map
        (((MulAut.conj g.val⁻¹).toMonoidHom).comp J.subtype)=J
      rw [←map_map,map_subgroupOf_eq_of_le (show D.UH≤J from le_sup_left)]
      rfl
    exact (hgen ▸ sup_le hUker hconj) (mem_top _)
  obtain ⟨hcompl,hmove⟩ := upper_marked_complement d h e hseed hn hU g hgn hg hK hL hp a hi ρ c
  have he : c.imageSpace (ChapterG.Section02.Setup.conjugate W g.val)=c.imageSpace W := by
    rw [hmove]
    change (c.imageSpace W).map (ρ k⁻¹)=_
    rw [show ρ k⁻¹=1 from hgker]
    simp only [Module.End.one_eq_id,Submodule.map_id]
  have htop : c.imageSpace W=⊤ := by
    have hh := hcompl.codisjoint
    rw [he,codisjoint_iff,sup_idem] at hh
    exact hh
  have hbot : c.imageSpace W=⊥ := by
    have hh := hcompl.disjoint
    rw [he] at hh
    exact disjoint_self.mp hh
  apply le_antisymm ?_ (module_le_core d h hseed g hK hL a hi)
  intro s hs
  apply (c.coordinates_eq_one_iff (⟨s,hs⟩:S)).mp
  have hz : (c.coordinates (⟨s,hs⟩:S)).toAdd∈c.imageSpace W := htop ▸ Submodule.mem_top
  rw [hbot] at hz
  exact Multiplicative.toAdd.injective hz

/-- The original hypotheses construct a selected pair with its exact two-core. -/
theorem exists_original_collapsed_pair (h : D.Hypothesis)
    (e : (D.L ⧸ pCore 2 D.L) ≃* alternatingGroup (Fin 6))
    (hseed : D.Vplus = ⁅D.V,D.L₁⁆) (hn : (D.L₁.subgroupOf D.H).Normal)
    (hU : ¬ IsMulCommutative D.UH) :
    ∃ (a : alternatingGroup (Fin 6)) (g : D.L), g.val∉D.Gz ∧
      g.val∈NormalBranch.K D g.val ∧ NormalBranch.K D g.val≤D.L ∧
      D.L₁≤NormalBranch.K D g.val ∧ IsPPerfect 2 (NormalBranch.K D g.val) ∧
      blockResidual D g.val=NormalBranch.K D g.val ∧
      conjugateSpanBy D.V₁ (NormalBranch.K D g.val)=D.V ∧
      ((NormalBranch.K D g.val).subgroupOf D.L).map (localMap d)=
        FivePair.five.map (MulAut.conj a.val).toMonoidHom ∧
      (NormalBranch.K D g.val).pCoreIn 2=D.V := by
  obtain ⟨a,g,hgn,hg,hK,hL,hp,hr,hs,hi,_,_⟩ :=
    SourceCoreProduct.exists_original_core_pair d h e hseed hn hU
  exact ⟨a,g,hgn,hg,hK,hL,hp,hr,hs,hi,
    core_eq_module d h e hseed hn hU g hgn hg hK hL hp a hi⟩

end CFSG.Quasithin.Chapter13.Section05.NormalBranch.SourceCoreCollapse
