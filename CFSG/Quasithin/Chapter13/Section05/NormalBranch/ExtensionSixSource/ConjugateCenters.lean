module
public import CFSG.Quasithin.Chapter13.Section05.NormalBranch.ExtensionSixSource.Geometry
/-!
# Common centers of the original extension cores

Two distinct mutually normalizing conjugates of the original Q_H have
centralizers generated by their two Frattini lines. Each centralizer has
order four, so they coincide. Transporting the original Frattini identity
then places all squares and commutators of the conjugate in this unchanged
center. These are the exact inputs to the marked-action uniqueness
argument proving weak closure.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*,
Proposition 13.5.16, printed p.921, the weak-closure paragraph.
-/

public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter13.Section05.NormalBranch.ExtensionSixSource
open Section08.SourceCompletion
variable {G : Type*} [Group G] [Finite G] {D : ChapterF.Section09.Setup G}
  {V₂ M : Subgroup G} {g : G}
  (d : NaturalSetup D.T D.L D.V D.V₁ V₂ D.Vplus M D.Gz)
  (h : D.Hypothesis) (e : (D.L ⧸ pCore 2 D.L) ≃* alternatingGroup (Fin 6))
  (hseed : D.Vplus = ⁅D.V,D.L₁⁆) (hn : (D.L₁.subgroupOf D.H).Normal)
  (hU : ¬IsMulCommutative D.UH)
  (b : Conclusions D M 6 g)
  (hS : Nonempty ((M ⧸ pCore 2 M) ≃* Equiv.Perm (Fin 6)))
include d h e hseed hn hU b hS

private theorem centralizer_card : Nat.card (centralizer (D.QH : Set G)) = 4 := by
  rw [core_centralizer h b, card_map_of_injective D.QH.subtype_injective]
  exact extension_center_card d h e hseed hn hU b hS

omit d e hseed hn hU hS in
private theorem point_le_core_centralizer : D.V₁ ≤ centralizer (D.QH : Set G) := by
  apply le_centralizer_iff.mp
  have hh : D.QH ≤ D.H := h.QH_le_T.trans h.T_le_H
  rwa [b.six.1] at hh

/-- Distinct mutually normalizing source cores have the same order-four center,
generated by their two original Frattini lines. -/
theorem conjugate_core_centralizer_eq (x : G)
    (hne : D.QH.conjBy x ≠ D.QH)
    (hx : D.QH.conjBy x ≤ normalizer (D.QH : Set G))
    (hq : D.QH ≤ normalizer (D.QH.conjBy x : Set G)) :
    centralizer (D.QH.conjBy x : Set G) = centralizer (D.QH : Set G) ∧
    D.V₁ ⊔ D.V₁.conjBy x = centralizer (D.QH : Set G) := by
  let f := (MulAut.conj x).toMonoidHom
  have hmapC : (centralizer (D.QH : Set G)).map f =
      centralizer (D.QH.conjBy x : Set G) :=
    map_centralizer_equiv (D.QH : Set G) (MulAut.conj x)
  have hmapH : normalizer (D.QH.conjBy x : Set G) =
      centralizer (D.V₁.conjBy x : Set G) := by
    change normalizer (D.QH.map f : Set G) = centralizer (D.V₁.conjBy x : Set G)
    rw [←map_equiv_normalizer_eq D.QH (MulAut.conj x),
      core_normalizer d h e hseed hn hU b,b.six.1]
    exact map_centralizer_equiv (D.V₁ : Set G) (MulAut.conj x)
  have hqx : D.QH.conjBy x ≤ D.H := by
    rwa [core_normalizer d h e hseed hn hU b] at hx
  have hv : D.V₁ ≤ centralizer (D.QH.conjBy x : Set G) := by
    apply le_centralizer_iff.mp
    rwa [b.six.1] at hqx
  have hvx : D.V₁.conjBy x ≤ centralizer (D.QH : Set G) := by
    apply le_centralizer_iff.mp
    rwa [hmapH] at hq
  have hvown := point_le_core_centralizer h b
  have hvxown : D.V₁.conjBy x ≤ centralizer (D.QH.conjBy x : Set G) := by
    exact (map_mono (f := f) hvown).trans hmapC.le
  have hline : D.V₁.conjBy x ≠ D.V₁ := by
    intro he
    have hxH : x ∈ D.H := by
      rw [b.six.1,←h.normalizer_point_eq]
      exact mem_normalizer_iff_map_conj_eq.mpr he
    apply hne
    apply mem_normalizer_iff_map_conj_eq.mp
    rwa [core_normalizer d h e hseed hn hU b]
  let E := D.V₁ ⊔ D.V₁.conjBy x
  have hE : E ≤ centralizer (D.QH : Set G) := sup_le hvown hvx
  have hE' : E ≤ centralizer (D.QH.conjBy x : Set G) := sup_le hv hvxown
  have hlt : D.V₁ < E := by
    refine lt_of_le_of_ne le_sup_left ?_
    intro he
    have hle : D.V₁.conjBy x ≤ D.V₁ := (show D.V₁.conjBy x ≤ E from le_sup_right).trans he.ge
    exact hline (eq_of_le_of_card_ge hle (by
      change Nat.card D.V₁ ≤ Nat.card (D.V₁.map f)
      rw [card_map_of_injective (MulAut.conj x).injective]))
  have hlo : 2 < Nat.card E := by
    rw [←h.point_card]
    by_contra hno
    exact hlt.ne (eq_of_le_of_card_ge hlt.le (by omega))
  have hd := card_dvd_of_le hE
  rw [centralizer_card d h e hseed hn hU b hS] at hd
  have hecard : Nat.card E = 4 := by
    have hh := (Nat.dvd_prime_pow (by decide : Nat.Prime 2)).mp
      (show Nat.card E ∣ 2^2 by norm_num; exact hd)
    obtain ⟨k,hk,he⟩ := hh
    interval_cases k
    · simp only [pow_zero] at he
      omega
    · simp only [pow_one] at he
      omega
    · simpa using he
  have heq : E = centralizer (D.QH : Set G) := eq_of_le_of_card_ge hE (by
    rw [hecard,centralizer_card d h e hseed hn hU b hS])
  have heq' : E = centralizer (D.QH.conjBy x : Set G) := eq_of_le_of_card_ge hE' (by
    rw [←hmapC,card_map_of_injective (MulAut.conj x).injective,
      centralizer_card d h e hseed hn hU b hS,hecard])
  exact ⟨heq'.symm.trans heq,heq⟩
/-- The original Frattini lines put all squares and commutators of a
mutually normalizing conjugate into the unchanged center. -/
theorem conjugate_core_square_commutator (x : G)
    (hne : D.QH.conjBy x ≠ D.QH)
    (hx : D.QH.conjBy x ≤ normalizer (D.QH : Set G))
    (hq : D.QH ≤ normalizer (D.QH.conjBy x : Set G)) :
    (∀ y ∈ D.QH.conjBy x, y ^ 2 ∈ (center D.QH).map D.QH.subtype) ∧
      ⁅D.QH.conjBy x,D.QH.conjBy x⁆ ≤ (center D.QH).map D.QH.subtype := by
  let K := D.QH.conjBy x
  have hp : IsPGroup 2 K := (isPGroup_pCoreIn 2 D.H).map (MulAut.conj x).toMonoidHom
  let : Fact (IsPGroup 2 K) := ⟨hp⟩
  have hphi : (frattini K).map K.subtype ≤ (center D.QH).map D.QH.subtype := by
    have he := (conjugate_core_centralizer_eq d h e hseed hn hU b hS x hne hx hq).1
    change (frattini (D.QH.map (MulAut.conj x).toMonoidHom)).map
      (D.QH.map (MulAut.conj x).toMonoidHom).subtype ≤ _
    rw [frattini_image_map D.QH (MulAut.conj x).toMonoidHom (MulAut.conj x).injective,
      core_frattini_image d h e hseed hn hU b,←core_centralizer h b,←he]
    exact (map_mono (point_le_core_centralizer h b)).trans
      (map_centralizer_le_centralizer_image _ _)
  constructor
  · intro y hy
    exact hphi (mem_map_of_mem K.subtype
      (pth_power_mem_frattini_of_isPGroup (p := 2) (⟨y,hy⟩ : K)))
  · rw [← K.map_subtype_commutator]
    exact (map_mono (commutator_le_frattini_of_isPGroup (R := K) (p := 2))).trans hphi

end CFSG.Quasithin.Chapter13.Section05.NormalBranch.ExtensionSixSource
