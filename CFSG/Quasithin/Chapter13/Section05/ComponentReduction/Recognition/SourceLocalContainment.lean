module
public import Theory.GroupTheory.CComponent.RankTwoResidual
public import CFSG.Quasithin.Chapter13.Section05.ComponentReduction.Recognition.ComponentAction

/-!
# The original local residual lies in a surviving binary component

The actual two-core image forces component normality and exhausts the
prime-to-three residual. The original L₁ is generated by its three-elements
because its two-core quotient has order three. This proves its containment
in the selected K from the concrete model's center, rank and outer group.
Source: Aschbacher–Smith13.5.21(1), p.924, ordinary case of A.3.18.
-/
public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter13.Section05.ComponentReduction.Recognition
open Section08.Source
variable {G : Type*} [Group G] [Finite G]
  {D : ChapterF.Section09.Setup G} {K : Subgroup G}

/-- The ordinary binary component case places the original two-residual in K. -/
theorem Selected.local_le_of_binary_component (s : Selected D K) (h : D.Hypothesis)
    (hc : Nat.card (D.L₁ ⧸ pCore 2 D.L₁) = 3)
    (hz : center (starImage D.H K) = ⊥)
    (hr : 2 ≤ primeRank 3 (starImage D.H K)) (hrH : primeRank 3 D.H ≤ 2)
    (ho : IsPGroup 2 (MulAut.Outer (starImage D.H K))) :
    D.L₁ ≤ K ∧ (K.subgroupOf D.H).Normal := by
  let : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  let B := K.subgroupOf D.H
  let e : (B ⧸ pCore 2 B) ≃* starImage D.H K := cComponentTwoCoreQuotientEquiv s.ccomponent
  let : IsQuasisimple (starImage D.H K) := s.quasisimple
  let : IsQuasisimple (B ⧸ pCore 2 B) := IsQuasisimple.of_mulEquiv e.symm
  have hzB : center (B ⧸ pCore 2 B) = ⊥ := by
    apply le_bot_iff.mp
    intro b hb
    exact e.map_eq_one_iff.mp (hz.le ((centerCongr e) ⟨b,hb⟩).property)
  have hrB : 2 ≤ primeRank 3 (B ⧸ pCore 2 B) := by rwa [primeRank_congr 3 e]
  have hoB : IsPGroup 2 (MulAut.Outer (B ⧸ pCore 2 B)) :=
    ho.of_injective (MulAut.outerCongr e).toMonoidHom (MulAut.outerCongr e).injective
  have he := s.ccomponent.eq_primeToResidual_three_of_rank_outer_two hzB hrB hrH hoB
  have hn : B.Normal := by
    change (K.subgroupOf D.H).Normal
    rw [he]
    infer_instance
  refine ⟨?_,hn⟩
  have hp : IsPPerfect 2 D.L₁ := isPPerfect_embedded_pResidual 2 (D.L ⊓ D.Gz)
  let : IsSimpleGroup (D.L₁ ⧸ pCore 2 D.L₁) := isSimpleGroup_of_prime_card hc
  have hg : primeToResidual 3 D.L₁ = ⊤ :=
    primeToResidual_eq_top_of_simple_quotient 3 2 (pCore 2 D.L₁) pCore_isPGroup hp
      (by rw [hc])
  let f : D.L₁ →* D.H := inclusion (le_sup_left.trans h.local_le)
  have hm := map_primeToResidual_le_of_hom 3 f
  intro x hx
  have hx' : f ⟨x,hx⟩ ∈ primeToResidual 3 D.H :=
    hm (mem_map_of_mem f (hg.symm ▸ (show (⟨x,hx⟩ : D.L₁) ∈ ⊤ from trivial)))
  rw [←he] at hx'
  exact hx'
end CFSG.Quasithin.Chapter13.Section05.ComponentReduction.Recognition
