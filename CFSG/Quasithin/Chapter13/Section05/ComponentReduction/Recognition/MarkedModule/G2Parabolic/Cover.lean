module

public import CFSG.Quasithin.Chapter13.Section05.ComponentReduction.Recognition.MarkedModule.G2Parabolic.Model
public import CFSG.Quasithin.Chapter13.Section05.ComponentReduction.Recognition.MarkedModule.G2Parabolic.Geometry
public import Theory.Representation.G2OrthogonalCover.Universal
public import Theory.Representation.BinaryOffender.IrreducibleTransport
public import Theory.GroupTheory.PResidual.FiniteImage
public import Theory.GroupTheory.PResidual.SylowSupplement

/-!
# Parabolic generation on every central natural G₂ cover

The universal-cover theorem maps the literal seven-dimensional trace-zero
space onto every central natural extension generated by G₂(2)′. The two
explicit residual displacements therefore generate every such extension.
Sylow conjugacy transports this calculation to every invariant plane.
A normalized non-two subgroup, together with the Sylow, fills its plane
stabilizer; two-perfectness identifies that subgroup with the actual residual.

This is the whole-module step in Aschbacher–Smith 13.5.21(6), printed
p.924 / PDF p.941, using I.2.3. The original octonion conventions and
ATLAS attribution are preserved through the imported model calculation.
-/

@[expose] public section
open Subgroup Representation Representation.BinaryOffender
open Atlas.G2.Natural Atlas.G2.Natural.BinaryPlane Atlas.G2.BinaryParabolicPair
namespace CFSG.Quasithin.Chapter13.Section05.ComponentReduction.Recognition.MarkedModule.G2Parabolic
namespace Cover
variable {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]

/-- The parabolic residual generates every perfect central natural cover. -/
theorem standard_residual_generates [FiniteDimensional (ZMod 2) V]
    (σ : Representation (ZMod 2) Actor V)
    (p : σ.IntertwiningMap (OrthogonalCover.binaryNatural (ZMod 2)))
    (hp : OneCohomology.IsCover p) :
    subspaceCommutator σ ⊤ Model.residual = ⊤ := by
  obtain ⟨f,hf,_⟩ := OrthogonalCover.exists_quotient (ZMod 2) p hp
  have he (g : Actor) (v : TraceZero (ZMod 2)) :
      σ g (f v) = f (OrthogonalCover.binaryAction (ZMod 2) g v) :=
    (LinearMap.congr_fun (f.isIntertwining' g) v).symm
  have h := subspaceCommutator_map_embedding σ (OrthogonalCover.binaryAction (ZMod 2))
    (MonoidHom.id Actor) f.toLinearMap he Model.residual ⊤
  rw [Subgroup.map_id, Submodule.map_top, LinearMap.range_eq_top.mpr hf] at h
  have hm : subspaceCommutator (OrthogonalCover.binaryAction (ZMod 2)) ⊤ Model.residual = ⊤ :=
    Model.residual_generates_seven
  rw [hm, Submodule.map_top, LinearMap.range_eq_top.mpr hf] at h
  exact h

private theorem conjugate_generates (σ : Representation (ZMod 2) Actor V)
    (g : Actor) (L : Subgroup Actor)
    (h : subspaceCommutator σ ⊤ (L.map (MulAut.conj g).toMonoidHom) = ⊤) :
    subspaceCommutator σ ⊤ L = ⊤ := by
  have he (a : Actor) (v : V) :
      σ a (σ g⁻¹ v) = σ g⁻¹ (σ ((MulAut.conj g) a) v) := by
    simp only [← Module.End.mul_apply, ← map_mul, MulAut.conj_apply]
    congr 2
    group
  have ht := subspaceCommutator_map_embedding σ σ (MulAut.conj g).toMonoidHom
    (σ g⁻¹) he L ⊤
  rw [h, Submodule.map_top, LinearMap.range_eq_top.mpr (σ.apply_bijective g⁻¹).surjective] at ht
  exact ht

/-- The stabilizer of any Sylow-invariant plane has a residual generating the
entire cover, not just its six-dimensional central quotient. -/
theorem plane_residual_generates [FiniteDimensional (ZMod 2) V]
    (σ : Representation (ZMod 2) Actor V)
    (p : σ.IntertwiningMap (OrthogonalCover.binaryNatural (ZMod 2)))
    (hp : OneCohomology.IsCover p)
    (S : Sylow 2 Actor) (W : Submodule (ZMod 2) Coefficients)
    (hW : Nat.card W = 4) (hS : (S : Subgroup Actor) ≤ subspaceStabilizer action W) :
    subspaceCommutator σ ⊤
      ((pResidual 2 (subspaceStabilizer action W)).map (subspaceStabilizer action W).subtype) = ⊤ := by
  obtain ⟨g,hg⟩ := Geometry.plane_conjugacy S W hW hS
  have he := map_subspaceStabilizer_equivariant action action (MulAut.conj g)
    (innerCoordinates g) (innerCoordinates_equivariant g) W
  rw [hg, standardPlane_stabilizer] at he
  apply conjugate_generates σ g
  rw [map_embedded_pResidual, he]
  exact standard_residual_generates σ p hp

/-- A normalized non-two subgroup and the Sylow fill the plane parabolic. -/
theorem local_eq_plane_stabilizer (S : Sylow 2 Actor) (L : Subgroup Actor)
    (W : Submodule (ZMod 2) Coefficients) (hW : Nat.card W = 4)
    (hi : L ⊔ (S : Subgroup Actor) ≤ subspaceStabilizer action W)
    (hne : ¬ L ≤ (S : Subgroup Actor)) :
    L ⊔ (S : Subgroup Actor) = subspaceStabilizer action W := by
  let P := subspaceStabilizer action W
  have hSP : (S : Subgroup Actor) ≤ P := le_sup_right.trans hi
  have hcard := Geometry.card_plane_stabilizer S W hW hSP
  have hcS : Nat.card S = 32 :=
    (Nat.card_congr (S.equiv standardSylow)).trans card_standardSylow
  have hindex : (S : Subgroup Actor).relIndex P = 3 := by
    have hc := relIndex_mul_relIndex (⊥ : Subgroup Actor) S P bot_le hSP
    rw [relIndex_bot_left, relIndex_bot_left, hcS, hcard] at hc
    omega
  have hm := relIndex_mul_relIndex (S : Subgroup Actor) (L ⊔ (S : Subgroup Actor)) P
    le_sup_right hi
  rw [hindex] at hm
  have hd : (L ⊔ (S : Subgroup Actor)).relIndex P ∣ 3 :=
    ⟨_, hm.symm.trans (Nat.mul_comm _ _)⟩
  rcases Nat.prime_three.eq_one_or_self_of_dvd _ hd with hone | hthree
  · exact le_antisymm hi (relIndex_eq_one.mp hone)
  · rw [hthree] at hm
    have hsmall : (S : Subgroup Actor).relIndex (L ⊔ (S : Subgroup Actor)) = 1 := by omega
    exact (hne (le_sup_left.trans (relIndex_eq_one.mp hsmall))).elim

/-- Application to the original normalized local actor after group/module
transport. No splitting of its central extension is required. -/
theorem local_generates [FiniteDimensional (ZMod 2) V]
    (σ : Representation (ZMod 2) Actor V)
    (p : σ.IntertwiningMap (OrthogonalCover.binaryNatural (ZMod 2)))
    (hp : OneCohomology.IsCover p)
    (S : Sylow 2 Actor) (L : Subgroup Actor)
    (hn : (S : Subgroup Actor) ≤ normalizer (L : Set Actor))
    (hperfect : IsPPerfect 2 L)
    (W : Submodule (ZMod 2) Coefficients) (hW : Nat.card W = 4)
    (hi : L ⊔ (S : Subgroup Actor) ≤ subspaceStabilizer action W)
    (hne : ¬ L ≤ (S : Subgroup Actor)) : subspaceCommutator σ ⊤ L = ⊤ := by
  have he := local_eq_plane_stabilizer S L W hW hi hne
  have hr := embedded_pResidual_join_pGroup L (S : Subgroup Actor) hperfect S.isPGroup' hn
  rw [he] at hr
  rw [← hr]
  exact plane_residual_generates σ p hp S W hW (le_sup_right.trans hi)
end Cover
end CFSG.Quasithin.Chapter13.Section05.ComponentReduction.Recognition.MarkedModule.G2Parabolic
