module

public import CFSG.Quasithin.Chapter13.Section05.ComponentReduction.Recognition.Catalogue.LocalModels.AlternatingRows.Residual
public import CFSG.Quasithin.Chapter13.Section05.ComponentReduction.Recognition.Configuration
public import CFSG.Quasithin.Chapter13.Section05.ComponentReduction.Recognition.Catalogue.FullCatalogue
public import Theory.SpecificGroups.AlternatingSix.SylowCentralExtension

/-!
# The outer A₆ actor in the full 13.5.21 catalogue

Condition (ii) excludes an inner involution: its automorphism centralizer
is a two-group, whereas the literal image of L₁ is nontrivial and two-perfect.
Condition (i) then identifies the group generated by K̂ and the original V̂
with S₆. The equivalence retains the supplied K̂ ≃ A₆ and the conjugation
action. The corrected B.4.2 alternating-six row is applied with its original
linear intertwiner and an explicit faithful-chief-image comparison.

Configuration and faithful-chief comparisons retain their independent
producers. These results do not assert an exclusion of the A₅ or A₇ rows,
and do not replace the full B.4.2/B.4.5 catalogue by a shortlist.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004, 13.5.21,
printed p.924 (PDF p.941).
-/

@[expose] public section
open Subgroup Theory.GroupTheory
open AlternatingSix.ShadowLocal
namespace CFSG.Quasithin.Chapter13.Section05.ComponentReduction.Recognition.Catalogue.LocalModels
open Configuration
variable {G : Type*} [Group G] [Finite G]
  {D : ChapterF.Section09.Setup G} {K : Subgroup G}
  (s : Selected D K) (h : D.Hypothesis) [(componentCentralizer s h).Normal]

/-- In the A₆ branch the marked subgroup V̂ is outside K̂. This follows from
condition (ii) and the actual inner involution centralizer of order 32 in
Aut(A₆); condition (iv) need not be strengthened. -/
theorem source_six_actor_not_le (Y : Subgroup G) (p : Prefix s h Y)
    (hc : LocalCoreCondition s h) (e : Khat s h ≃* A6) :
    ¬ Vhat s h ≤ Khat s h := by
  intro hi
  let : (Khat s h).Normal := by rw [← p.khat_fitting]; infer_instance
  obtain ⟨hn, hp, hl⟩ := source_condition_ii_residual s h Y p hc
  have hcard : Nat.card (Vhat s h) = 2 := p.actor_card
  let : IsCyclic (Vhat s h) := isCyclic_of_prime_card hcard
  obtain ⟨w,hw⟩ := isCyclic_iff_exists_zpowers_eq_top.mp (inferInstance : IsCyclic (Vhat s h))
  have ho : orderOf w = 2 := (orderOf_eq_card_of_zpowers_eq_top hw).trans hcard
  let v : Khat s h := ⟨w, hi w.property⟩
  have hv : orderOf v = 2 := (orderOf_injective _ (Khat s h).subtype_injective v).symm.trans
    ((orderOf_injective _ (Vhat s h).subtype_injective w).trans ho)
  apply hn
  exact AlternatingSix.SylowCentralExtension.residual_centralizing_inner_eq_bot _ e
    (source_centralizer_eq_bot s h Y p) v hv _ hp (by
      intro x hx
      exact mem_centralizer_singleton_iff.mpr
        (mem_centralizer_iff.mp (hl hx) w w.property).symm)

/-- The A₆ outcome with the original component coordinates and original action.
The S₆ equivalence is constructed, including exceptional-automorphism exclusion;
no substitute permutation action or fixed-group characteristic-two premise is used. -/
theorem source_six_marked_extension (Y : Subgroup G) (p : Prefix s h Y)
    (hc : LocalCoreCondition s h) (e : Khat s h ≃* A6) :
    ∃ q : (Khat s h ⊔ Vhat s h : Subgroup (Xhat s h)) ≃* Equiv.Perm (Fin 6),
      (∀ x : Khat s h, q ⟨x, (le_sup_left : Khat s h ≤ Khat s h ⊔ Vhat s h) x.property⟩ =
        (e x : Equiv.Perm (Fin 6))) ∧
      (∀ g : (Khat s h ⊔ Vhat s h : Subgroup (Xhat s h)),
        ∀ x : Khat s h, ∀ hx : (g : Xhat s h) * x * (g : Xhat s h)⁻¹ ∈ Khat s h,
          (e ⟨(g : Xhat s h) * x * (g : Xhat s h)⁻¹, hx⟩ : Equiv.Perm (Fin 6)) =
            q g * (e x : Equiv.Perm (Fin 6)) * (q g)⁻¹) := by
  classical
  let : (Khat s h).Normal := by rw [← p.khat_fitting]; infer_instance
  have hn := source_six_actor_not_le s h Y p hc e
  obtain ⟨v,hvV,hvK⟩ := SetLike.not_le_iff_exists.mp hn
  have hv1 : v ≠ 1 := fun he => hvK (he ▸ one_mem _)
  have hvord : orderOf v = 2 := by
    have hd : orderOf (⟨v,hvV⟩ : Vhat s h) ∣ 2 := p.actor_card ▸ orderOf_dvd_natCard _
    have he : orderOf (⟨v,hvV⟩ : Vhat s h) = 2 :=
      (Nat.dvd_prime Nat.prime_two).mp hd |>.resolve_left (by
        intro hh
        exact hv1 (congrArg Subtype.val (orderOf_eq_one_iff.mp hh)))
    exact (orderOf_injective _ (Vhat s h).subtype_injective ⟨v,hvV⟩).trans he
  have hvgen : zpowers v = Vhat s h := eq_of_le_of_card_ge (zpowers_le.mpr hvV) (by
    rw [Nat.card_zpowers, hvord, p.actor_card])
  obtain ⟨T,hT⟩ := p.marked_sylow
  have hext := AlternatingSix.SylowCentralExtension.exists_marked_symmetric_extension _
    (source_centralizer_eq_bot s h Y p) e T v hvord (by
      intro x hx
      exact (mem_centralizer_iff.mp (p.actor_central hvV) x (hT ▸ hx)).symm) hvK
  rw [hvgen] at hext
  obtain ⟨q,hq,ha⟩ := hext
  refine ⟨q,hq,?_⟩
  intro g x hx
  exact ha g x

open ChapterB.QuasisimpleSource

/-- Application to the literal corrected B.4.2 `alternatingSix` constructor.
The faithful-chief comparison is explicit; the row's given linear intertwiner
is retained with the constructed S₆ marking on the original component. -/
theorem source_alternatingSix_row
    {F W : Type*} [Group F] [AddCommGroup W] [Module (ZMod 2) W]
    (ρ : Representation (ZMod 2) F W) (L : Subgroup F)
    (comparison : Khat s h ≃* L)
    (row : ActionEquiv (ρ.comp L.subtype) (alternatingNatural 6))
    (Y : Subgroup G) (hY : Y ≤ D.L₁) (c : SourceConfiguration s h Y hY) :
    ¬ Vhat s h ≤ Khat s h ∧
      ∃ q : (Khat s h ⊔ Vhat s h : Subgroup (Xhat s h)) ≃* Equiv.Perm (Fin 6),
        (∀ x : Khat s h,
          q ⟨x, (le_sup_left : Khat s h ≤ Khat s h ⊔ Vhat s h) x.property⟩ =
            (row.groupEquiv (comparison x) : Equiv.Perm (Fin 6))) ∧
        ∀ (x : Khat s h) (w : W),
          row.linearEquiv (ρ (comparison x : F) w) =
            BinaryPermutation.naturalRepresentation (Fin 6)
              (q ⟨x, (le_sup_left : Khat s h ≤ Khat s h ⊔ Vhat s h) x.property⟩)
              (row.linearEquiv w) := by
  let e := comparison.trans row.groupEquiv
  have ho := source_six_actor_not_le s h Y c.proved_prefix c.condition_ii_O23 e
  obtain ⟨q,hq,_⟩ := source_six_marked_extension s h Y c.proved_prefix c.condition_ii_O23 e
  refine ⟨ho,q,hq,?_⟩
  intro x w
  rw [hq]
  exact row.intertwines (comparison x) w

end CFSG.Quasithin.Chapter13.Section05.ComponentReduction.Recognition.Catalogue.LocalModels
