module
public import CFSG.Quasithin.Chapter13.Section05.ComponentReduction.Recognition.Catalogue.ChiefComparison

/-!
# The genuine marked involution on every source chief image

The component is generated by its commutators with the original V* generator.
Consequently that generator cannot disappear on a noncentral chief section.
Its image is an involution of displacement at most two, and it together with
the actual generalized Fitting subgroup generates the faithful chief image.
This is a stronger source input than merely a numerical quadratic-ratio bound.
Source: Aschbacher–Smith13.5.21, printed pp.923–924, before B.4.2/B.4.5.
-/
public section
open Subgroup Representation Representation.BinaryOffender Theory.GroupTheory
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter13.Section05.ComponentReduction.Recognition.Catalogue
open Section08.Source Configuration
universe u
/-- The literal marked-image witness used by the catalogue. -/
@[expose] def MarkedImageWitness {E W : Type*} [Group E] [AddCommGroup W]
    [Module (ZMod 2) W] (σ : Representation (ZMod 2) E W) (t : actionImage σ) : Prop :=
  orderOf t = 2 ∧
    Module.finrank (ZMod 2) (LinearMap.range (imageRepresentation σ t - 1)) ≤ 2 ∧
    generalizedFitting (actionImage σ) ⊔ zpowers t = ⊤

/-- Noncentrality and commutator generation keep the marked image nonidentity. -/
theorem marked_image_of_commutator {E W : Type*} [Group E] [AddCommGroup W]
    [Module (ZMod 2) W] (σ : Representation (ZMod 2) E W) (L : Subgroup E)
    (v : E) (hv : v ^ 2 = 1) (hm : ⁅L,zpowers v⁆ = L) (hn : ¬ L ≤ σ.ker)
    (hgen : L ⊔ zpowers v = ⊤)
    (hf : actionSubgroup σ L = generalizedFitting (actionImage σ))
    (hr : Module.finrank (ZMod 2) (LinearMap.range (σ v - 1)) ≤ 2) :
    MarkedImageWitness σ (actionHom σ v) := by
  let f := actionHom σ
  have ht1 : f v ≠ 1 := by
    intro he
    obtain ⟨w,hw⟩ := generator_moves_of_noncentral σ L v hm hn
    exact hw ((actionHom_eq_one_iff σ v).mp he w)
  have ht2 : f v ^ 2 = 1 :=
    (map_pow f v 2).symm.trans ((congrArg f hv).trans f.map_one)
  have hsur : Function.Surjective f := σ.asGroupHom.rangeRestrict_surjective
  have hg := congrArg (Subgroup.map f) hgen
  rw [Subgroup.map_sup,MonoidHom.map_zpowers,←MonoidHom.range_eq_map,
    MonoidHom.range_eq_top_of_surjective f hsur] at hg
  change actionSubgroup σ L ⊔ zpowers (f v) = ⊤ at hg
  rw [hf] at hg
  exact ⟨orderOf_eq_prime ht2 ht1,hr,hg⟩

variable {G : Type u} [Group G] [Finite G]
  (D : ChapterF.Section09.Setup G) (K : Subgroup G) (h : D.Hypothesis)
  [(D.V₁.subgroupOf D.UH).Normal] [IsElementaryAbelian 2 (Action.ModuleGroup D)]

/-- The literal image of the original marked involution is nontrivial and generates with F*. -/
theorem source_chief_marked_involution (s : Selected D K)
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G) (hH : D.H ∈ Chapter1.H G)
    (hi : D.Vplus.relIndex D.V = 2) (hu : ¬ IsMulCommutative D.UH)
    (v : actor D K) (hv : zpowers (v : Hstar D.H) = starImage D.H D.V)
    (hr : Module.finrank (ZMod 2)
      (LinearMap.range (Action.starRepresentation D h (v : Hstar D.H) - 1)) = 2)
    (U N : Subrepresentation (representation D K h))
    (hn : ¬ component D K ≤ (chiefRepresentation D K h U N).ker)
    (hirr : IsIrreducible (chiefRepresentation D K h U N)) :
    MarkedImageWitness (chiefRepresentation D K h U N)
      (actionHom (chiefRepresentation D K h U N) v) := by
  let σ := chiefRepresentation D K h U N
  have hc := LocalGeometry.star_V_card_two h hi hu
  have hv2 : v ^ 2 = 1 := by
    apply Subtype.ext
    have ho : orderOf (v : Hstar D.H) = 2 := by rw [←Nat.card_zpowers,hv,hc]
    change (v : Hstar D.H) ^ 2 = 1
    simpa only [ho] using pow_orderOf_eq_one (v : Hstar D.H)
  have hp := source_chief_hypotheses D K h s hG hH hi hu v hv hr U N hn hirr
  let : IsQuasisimple (generalizedFitting (actionImage σ)) := hp.quasisimple
  have hnorm := (s.normalizes_and_commutator h hc (selected_section_even s)).1
  let : (component D K).Normal := normal_subgroupOf_of_le_normalizer
    (sup_le (starImage D.H K).le_normalizer hnorm)
  let : IsQuasisimple (starImage D.H K) := s.quasisimple
  let : IsQuasisimple (component D K) :=
    IsQuasisimple.of_mulEquiv (subgroupOfEquivOfLe
      (show starImage D.H K ≤ actor D K from le_sup_left)).symm
  have hd := fixedCodim_section_le (representation D K h) U N (zpowers v)
  rw [fixedCodim_zpowers_eq_displacement_rank,
    fixedCodim_zpowers_eq_displacement_rank] at hd
  exact marked_image_of_commutator σ (component D K) v hv2
    (component_commutator D K h s hc (selected_section_even s) v hv) hn
    (source_actor_generation D K v hv) (image_component_eq_fitting σ (component D K) hn)
    (hd.trans hr.le)

/-- A genuine nonidentity small-displacement involution on every noncentral chief image. -/
@[expose] def MarkedChiefHypotheses : Prop :=
  ∀ U N : Subrepresentation (representation D K h),
    ¬ component D K ≤ (chiefRepresentation D K h U N).ker →
    IsIrreducible (chiefRepresentation D K h U N) →
    ∃ t : actionImage (chiefRepresentation D K h U N),
      MarkedImageWitness (chiefRepresentation D K h U N) t

/-- Construct the original marked generator before passing to each actual chief image. -/
theorem source_chief_marked_all (s : Selected D K)
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G) (hH : D.H ∈ Chapter1.H G)
    (hi : D.Vplus.relIndex D.V = 2) (hu : ¬ IsMulCommutative D.UH)
    (hcard : Nat.card D.V = 16) : MarkedChiefHypotheses D K h := by
  have hc := LocalGeometry.star_V_card_two h hi hu
  have hcyc : IsCyclic (starImage D.H D.V) := isCyclic_of_prime_card hc
  obtain ⟨x,hx⟩ := (starImage D.H D.V).isCyclic_iff_exists_zpowers_eq_top.mp hcyc
  have hxV : x ∈ starImage D.H D.V := hx ▸ mem_zpowers x
  let v : actor D K := ⟨x,(show starImage D.H D.V ≤ actor D K from le_sup_right) hxV⟩
  have hv : zpowers (v : Hstar D.H) = starImage D.H D.V := hx
  have hr : Module.finrank (ZMod 2)
      (LinearMap.range (Action.starRepresentation D h (v : Hstar D.H) - 1)) = 2 := by
    change Module.finrank (ZMod 2)
      (LinearMap.range (Action.starRepresentation D h (v : Hstar D.H) - LinearMap.id)) = 2
    rw [← fixedCodim_zpowers_eq_displacement_rank,hv,sourceRepresentation_eq h]
    exact Fitting.SourceAction.source_fixedCodim_two h hi hu hcard
  intro U N hn hirr
  exact ⟨actionHom (chiefRepresentation D K h U N) v,
    source_chief_marked_involution D K h s hG hH hi hu v hv hr U N hn hirr⟩

end CFSG.Quasithin.Chapter13.Section05.ComponentReduction.Recognition.Catalogue
