module
public import CFSG.Quasithin.Chapter13.Section05.PlaneGeometry.PlaneClosure
public import CFSG.Quasithin.Chapter13.Section07.ModelExclusions.PlaneOrbit
public import Theory.GroupTheory.Commutator.NormalizedIndexTwo
public import Theory.GroupTheory.AbelianConjugateSpan

/-!
# The original G.2 seed setup before F.9

The seed is generated by its point-residual commutators. A proper invariant
subgroup strictly above the point would have index two in the seed, forcing
those same commutators inside it. This proves the original seed interval
without using F.9. The genuine point-normalizer G.2 application then contains
the seed closure in its two-core. Nonabelianness of any selected seed closure
forces this two-core to move V₂, supplying the earlier plane-noncentrality
input without a circular F.9 assumption.
Source: Aschbacher–Smith13.5.7 and13.3.14, printed pp.918 and893.
-/
public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter13.Section05.ComponentReduction.OriginalSix
open Section08.SourceCompletion Section07.ModelExclusions
open Section08.TransvectionRecognition.Component.ModelExtension
open Section08.TransvectionQuotients.FiveSeed.BarMarking
open Section08.ComponentSieve.FieldComponents.LinearThree.Geometry.CoveredProduct.ResidualPlacement
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G}
  {L V V₁ V₂ V₃ M G₁ : Subgroup G}
  (d : NaturalSetup T L V V₁ V₂ V₃ M G₁)
include d

theorem source_seed_interval (A : Subgroup G) (hPA : V₁ ≤ A) (hAU : A ≤ V₃)
    (hn : sourceOne L T V₁ ⊔ (T : Subgroup G) ≤ normalizer (A : Set G)) :
    A = V₁ ∨ A = V₃ := by
  by_cases hA : A=V₁
  · exact Or.inl hA
  right
  by_contra hU
  have hcard : Nat.card A = 4 := by
    have hd : Nat.card A ∣ 8 := d.seed_card ▸ card_dvd_of_le hAU
    have hm := Nat.mem_divisors.mpr ⟨hd,by decide⟩
    rw [show (8:ℕ).divisors = {1,2,4,8} by decide] at hm
    simp only [Finset.mem_insert,Finset.mem_singleton] at hm
    have hl : 2 ≤ Nat.card A := d.line_card ▸ card_le_of_le hPA
    have h2 : Nat.card A ≠ 2 := fun hc => hA
      (eq_of_le_of_card_ge hPA (by rw [d.line_card,hc])).symm
    have h8 : Nat.card A ≠ 8 := fun hc => hU
      (eq_of_le_of_card_ge hAU (by rw [d.seed_card,hc]))
    omega
  have hi : A.relIndex V₃ = 2 := by
    have hh := (A.subgroupOf V₃).card_mul_index
    rw [Nat.card_congr (subgroupOfEquivOfLe hAU).toEquiv,hcard,d.seed_card] at hh
    change 4*A.relIndex V₃=8 at hh
    omega
  have hc := commutator_le_of_normalized_index_two V₃ A (sourceOne L T V₁) hAU hi
    (point_residual_normalizes_seed d) (le_sup_left.trans hn)
  rw [seed_commutator_point_residual d] at hc
  exact hU (le_antisymm hAU hc)

@[expose] def pointSeedSetup (T : Sylow 2 G) (L V₁ V₃ : Subgroup G) :
    ChapterG.Section02.Setup G where
  V := V₃
  V₁ := V₁
  L := L
  T := T
  H := normalizer (V₁ : Set G)

theorem source_point_seed_g2 : (pointSeedSetup T L V₁ V₃).Hypothesis := by
  have hn : V₁ ≠ ⊥ := by
    intro he
    have hc:=d.line_card
    rw [he,card_bot] at hc
    contradiction
  have hp : IsPGroup 2 V₁ := T.isPGroup'.to_le
    (d.line_le_plane.trans (d.plane_le_seed.trans (d.seed_le.trans d.chosen.le_sylow)))
  have hc : generalizedFitting (normalizer (V₁:Set G))=pCore 2 (normalizer (V₁:Set G)) := by
    apply generalizedFitting_eq_pCore_of_selfCentralizing 2
    apply Chapter1.mem_He_iff.mp
    exact Chapter1.twoLocal_mem_He_of_sylow_le T
      (d.counterexample.qtke.evenCharacteristic T) ⟨V₁,hn,hp,rfl⟩ d.line_stable
  have hL1 : (pointSeedSetup T L V₁ V₃).L₁ = sourceOne L T V₁ := by
    exact (normalizer_residual_eq L V₁ (T : Subgroup G) T.isPGroup' d.normalizes_L).symm
  let := d.chosen.elementary
  change (⟨V₃,V₁,L,T,normalizer (V₁ : Set G)⟩ : ChapterG.Section02.Setup G).Hypothesis
  refine {
    elementary := IsElementaryAbelian.of_le d.seed_le
    point_ne_bot := hn
    point_le := d.line_le_plane.trans d.plane_le_seed
    residual := (pResidual_eq_top_iff 2 L).mpr d.counterexample.local_component.2.1.2.1
    V_le_T := d.seed_le.trans d.chosen.le_sylow
    T_normalizes_point := d.line_stable
    T_normalizes_V := d.seed_stable
    T_normalizes_L := d.normalizes_L
    sylow_LT := ⟨T.subtype (show (T:Subgroup G)≤L⊔T from le_sup_right),
      map_subgroupOf_eq_of_le (show (T:Subgroup G)≤L⊔T from le_sup_right)⟩
    H_le := le_rfl
    local_le := by
      change (pointSeedSetup T L V₁ V₃).L₁ ⊔ (T : Subgroup G) ≤ normalizer (V₁ : Set G)
      rw [hL1]
      exact sup_le ((one_le L T V₁).trans inf_le_right) d.line_stable
    sylow_H := ⟨T.subtype d.line_stable,map_subgroupOf_eq_of_le d.line_stable⟩
    characteristic_two := hc
    local_normalizes_V := by
      change (pointSeedSetup T L V₁ V₃).L₁ ⊔ (T : Subgroup G) ≤ normalizer (V₃ : Set G)
      rw [hL1]
      exact sup_le (point_residual_normalizes_seed d) d.seed_stable
    quotient_nonzero := ?_
    irreducible := by
      intro A hPA hAU hNA
      change (pointSeedSetup T L V₁ V₃).L₁ ⊔ (T : Subgroup G) ≤ normalizer (A : Set G) at hNA
      rw [hL1] at hNA
      exact source_seed_interval d A hPA hAU hNA }
  intro he
  have hh := congrArg (fun A : Subgroup G => Nat.card A) he
  rw [d.seed_card,d.line_card] at hh
  contradiction

theorem source_seed_closure_le_point_core (H : Subgroup G)
    (hH : H ≤ normalizer (V₁ : Set G)) :
    conjugateSpanBy V₃ H ≤ (normalizer (V₁ : Set G)).pCoreIn 2 := by
  have hb := source_point_seed_g2 d
  exact (conjugateSpanBy_mono le_rfl hH).trans
    (le_pCoreIn_of_normalizes hb.U_isPGroup hb.U_le_H (le_normalizer_conjugateSpanBy _ _))

theorem source_point_plane_noncentral (H : Subgroup G)
    (hH : H ≤ normalizer (V₁ : Set G))
    (hU : ¬IsMulCommutative (conjugateSpanBy V₃ H)) :
    ⁅(normalizer (V₁ : Set G)).pCoreIn 2,V₂⁆ ≠ ⊥ := by
  intro he
  have hC := commutator_eq_bot_iff_le_centralizer.mp he
  have hN : normalizer (V₁ : Set G) ≤
      normalizer ((normalizer (V₁ : Set G)).pCoreIn 2 : Set G) :=
    (normalizer (V₁ : Set G)).le_normalizer.trans
      (normalizer_le_normalizer_characteristic_image _ (pCore 2 _))
  have hseed := le_centralizer_conjugateSpanBy_of_normalizes
    ((normalizer (V₁ : Set G)).pCoreIn 2) V₂ (sourceOne L T V₁)
    (((one_le L T V₁).trans inf_le_right).trans hN) hC
  rw [plane_orbit_point_residual d] at hseed
  have hCU := le_centralizer_conjugateSpanBy_of_normalizes
    ((normalizer (V₁ : Set G)).pCoreIn 2) V₃ H (hH.trans hN) hseed
  exact hU (le_centralizer_iff_isMulCommutative.mp
    ((source_seed_closure_le_point_core d H hH).trans hCU))
end CFSG.Quasithin.Chapter13.Section05.ComponentReduction.OriginalSix
