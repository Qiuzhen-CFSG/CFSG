module

public import CFSG.Quasithin.Chapter13.Section05.PlaneGeometry.Marking
public import Theory.SpecificGroups.SymmetricSix.BinaryFlags.NondegeneratePlane.Orbit
/-!
# The actual transposition image of Q₀ in 13.5.6

For an actual four-subgroup W≤V whose natural image is nondegenerate,
let Q₀=C_T(W). Its literal image under the original LT permutation map
is either trivial or generated by a transposition. The trivial alternative
is exactly Q₀≤C_G(V). The proof uses the native nondegenerate-plane fixer
and the original conjugation formula, with no assumed transposition or
action-kernel identification.

Source: Aschbacher--Smith, 13.5.6, printed p.917. The separate source
normalizer escape excludes the trivial alternative before C.1.24(c).
-/

@[expose] public section
open Subgroup BinaryPermutation
namespace CFSG.Quasithin.Chapter13.Section05.PlaneGeometry
open Section08.SourceCompletion Section07.NaturalAction
open Theory.SpecificGroups.SymmetricSix.BinaryFlags
open NaturalGeometry NaturalPairing NondegeneratePlane
variable {G:Type*} [Group G] [Finite G] {T:Sylow 2 G}
  {L V V₁ V₂ V₃ M G₁:Subgroup G}
  (d:NaturalSetup T L V V₁ V₂ V₃ M G₁)
include d

def planeCentralizer (W:Subgroup G) : Subgroup G := (T:Subgroup G)⊓centralizer (W:Set G)

noncomputable def planeCentralizerImage (W:Subgroup G) : Subgroup (Equiv.Perm (Fin 6)) :=
  ((planeCentralizer (T:=T) W).subgroupOf (L⊔T)).map (permutation d)

theorem planeCentralizer_image_cases (W:Subgroup G) (hWV:W≤V)
    (hcard:Nat.card W=4)
    (hn:¬∀x∈image d W,∀y∈image d W,form x y=0) :
    planeCentralizerImage d W=⊥ ∨
      ∃r:Equiv.Perm (Fin 6),r.IsSwap ∧ planeCentralizerImage d W=zpowers r := by
  apply twoGroup_fixing_plane (image d W) (image_dim d W hWV 2 hcard) hn
    (planeCentralizerImage d W)
  · exact ((T.isPGroup'.to_le inf_le_left).comap_subtype).map (permutation d)
  · rintro _ ⟨x,hx,rfl⟩ w hw
    obtain ⟨v,hv,rfl⟩:=(mem_image d W w).mp hw
    rw [←conjugation d x v]
    apply congrArg (fun v:V=>(d.coordinate v).toAdd)
    apply Subtype.ext
    change x.val*v.val*x.val⁻¹=v.val
    have he:v.val*x.val=x.val*v.val:=mem_centralizer_iff.mp hx.2 v.val hv
    rw [←he,mul_inv_cancel_right]

theorem planeCentralizer_image_eq_bot_iff (W:Subgroup G) :
    planeCentralizerImage d W=⊥ ↔ planeCentralizer (T:=T) W≤centralizer (V:Set G) := by
  constructor
  · intro hb x hx
    let xH:(L⊔(T:Subgroup G):Subgroup G):=⟨x,mem_sup_right hx.1⟩
    have he:permutation d xH=1 := mem_bot.mp (hb ▸
      (mem_map_of_mem (permutation d) (show xH∈(planeCentralizer (T:=T) W).subgroupOf (L⊔T) from hx)))
    apply mem_centralizer_iff.mpr
    intro v hv
    have hh:=conjugation d xH ⟨v,hv⟩
    rw [he,map_one,Module.End.one_apply] at hh
    have hc:=congrArg Subtype.val (d.coordinate.injective hh)
    change x*v*x⁻¹=v at hc
    exact (mul_inv_eq_iff_eq_mul.mp hc).symm
  · intro hb
    apply eq_bot_iff.mpr
    rintro _ ⟨x,hx,rfl⟩
    apply naturalRepresentation_injective (Fin 6) (by decide)
    rw [map_one]
    ext w : 1
    obtain ⟨v,hv⟩:=d.coordinate.surjective (Multiplicative.ofAdd w)
    have hv':(d.coordinate v).toAdd=w:=hv
    rw [←hv',←conjugation d x v]
    apply congrArg (fun v:V=>(d.coordinate v).toAdd)
    apply Subtype.ext
    change x.val*v.val*x.val⁻¹=v.val
    have he:v.val*x.val=x.val*v.val:=mem_centralizer_iff.mp (hb hx) v.val v.property
    rw [←he,mul_inv_cancel_right]

theorem planeCentralizer_transposition_of_nontrivial_action
    (W:Subgroup G) (hWV:W≤V) (hcard:Nat.card W=4)
    (hn:¬∀x∈image d W,∀y∈image d W,form x y=0)
    (hmove:¬planeCentralizer (T:=T) W≤centralizer (V:Set G)) :
    ∃r:Equiv.Perm (Fin 6),r.IsSwap ∧ planeCentralizerImage d W=zpowers r :=
  (planeCentralizer_image_cases d W hWV hcard hn).resolve_left
    (fun hb=>hmove ((planeCentralizer_image_eq_bot_iff d W).mp hb))
end CFSG.Quasithin.Chapter13.Section05.PlaneGeometry
