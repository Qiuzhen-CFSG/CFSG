module
public import CFSG.Quasithin.Chapter13.Section05.A5Source.ThirdSpaceCoordinates
public import Theory.Representation.BinaryAlternatingFiveFlag.PlaneOrbit

/-!
# Simultaneous coordinates for the original A₅ flag

Retain the original plane vector when relabelling the Sylow flag. The
fixed line then places the regular four-group in the Sylow image, so the
unique invariant hyperplane is the original V₃. The plane of order four
is generated by that line and its marked vector. This supplies compatible
coordinates for all three original subgroups, including V₂≤V₃.
Source: Aschbacher–Smith13.5.13, printed p.919, using13.2–13.3.
-/
@[expose] public section
namespace CFSG.Quasithin.Chapter13.Section05.A5Source.Context
open Subgroup Section06.CentralizerReduction
open BinaryPermutation BinaryPermutation.FiveCentralizerGeometry
open A5Module A5Module.FlagCoordinates BinaryPermutation.AlternatingFiveFlag
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L V V₁ V₂ V₃ : Subgroup G}
  (d : Context T L V V₁ V₂ V₃)
include d

/-- A compatible marking of the original line, plane and three-space. -/
theorem plane_third_coordinates : ∃ s : Marking L V,
    (zpowers (Multiplicative.ofAdd z)).map s.map = V₁ ∧
      plane.map s.map = V₂ ∧ three.map s.map = V₃ := by
  obtain ⟨g,hz,hv,hvn,hN,hT⟩ := d.flag.exists_coordinate_witness
  let f := d.flag.relabel g
  have hline : (zpowers (Multiplicative.ofAdd z)).map f.module.map=V₁ := by
    have hh := congrArg (Subgroup.map d.flag.module.map) hz
    rw [MonoidHom.map_zpowers,d.flag.preimage_map V₁ (d.flag.one_le_two.trans d.flag.two_le_V)] at hh
    rw [MonoidHom.map_zpowers]
    exact hh
  have hpre : f.preimage V₁=zpowers (Multiplicative.ofAdd z) := by
    apply Subgroup.map_injective f.module.injective
    rw [f.preimage_map V₁ (d.flag.one_le_two.trans d.flag.two_le_V),hline]
  have hfix (p : f.image) (hp : p∈f.imageSylow) : FlagCoordinates.rho p.val z=z := by
    have hm := f.preimage_invariant V₁ f.one_invariant p hp (Multiplicative.ofAdd z)
      (hpre.symm ▸ mem_zpowers (Multiplicative.ofAdd z))
    rw [hpre] at hm
    have he : Multiplicative.ofAdd (FlagCoordinates.rho p.val z)=1 ∨
        Multiplicative.ofAdd (FlagCoordinates.rho p.val z)=Multiplicative.ofAdd z := by
      change Multiplicative.ofAdd (FlagCoordinates.rho p.val z) ∈ line
      rw [line_eq_zpowers]
      exact hm
    rcases he with he|he
    · have hh : coordinateEquiv p.val (Multiplicative.ofAdd z)=coordinateEquiv p.val 1 :=
        he.trans (map_one _).symm
      exact (z_ne_zero ((coordinateEquiv p.val).injective hh)).elim
    · exact he
  have hfour := four_le_sylow f.image f.alternating_le_image f.imageSylow hfix
  have hthree : f.preimage V₃=three := by
    apply three_eq_of_card_invariant
    · exact (f.preimage_card V₃ d.third_le).trans d.third_card
    · intro k hk x hx
      obtain ⟨p,hp,he⟩ := hfour hk
      rw [←he]
      exact f.preimage_invariant V₃ d.third_invariant p hp x hx
  have hplane : plane.map f.module.map=V₂ := by
    apply eq_of_le_of_card_ge
    · have hz₂ : f.module.map (Multiplicative.ofAdd z) ∈ V₂ := by
        apply d.flag.one_le_two
        exact hline.le (mem_map_of_mem f.module.map (mem_zpowers (Multiplicative.ofAdd z)))
      have hv₂ : f.module.map (Multiplicative.ofAdd v) ∈ V₂ := hv
      rintro y ⟨x,(rfl|rfl|rfl|rfl),rfl⟩
      · simpa only [map_one] using V₂.one_mem
      · exact hz₂
      · exact hv₂
      · rw [ofAdd_add,map_mul]
        exact V₂.mul_mem hz₂ hv₂
    · rw [card_map_of_injective f.module.injective,plane_card,d.flag.two_card]
  refine ⟨f.module,hline,hplane,?_⟩
  rw [←hthree,f.preimage_map V₃ d.third_le]

/-- The original invariant plane lies in the original invariant three-space. -/
theorem plane_le_third : V₂ ≤ V₃ := by
  obtain ⟨s,hline,hplane,hthree⟩ := d.plane_third_coordinates
  rw [←hplane,←hthree]
  exact map_mono plane_le_three

end CFSG.Quasithin.Chapter13.Section05.A5Source.Context
