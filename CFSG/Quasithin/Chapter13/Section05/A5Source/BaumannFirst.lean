module
public import CFSG.Quasithin.Chapter13.Section05.A5Source.BlockCore
public import CFSG.Quasithin.Chapter13.Section05.A5Source.BaumannPair
public import Theory.GroupTheory.GeneralizedFitting.SimpleSocleStructure
public import Theory.GroupTheory.PResidual.CommutatorImage

/-!
# The first Baumann member and the original Thompson commutator

A moving J(T) has nontrivial image in the actual S₅ action. The faithful
simple A₅ image is generated by its commutators with that image, and
two-perfectness lifts this to L=[L,J(T)] through the literal action kernel.
The first characteristic-pair member centralizes Baum(T), hence J(T).
If LT normalizes it, the commutator identity makes L centralize it.
When Ω₁Z(T) has order two, the original flag already gives C_T(L)=1,
contradicting this member's required nontriviality.

OriginalCentralization/BaumannBlocks applies this to both local groups on
the same pair, excluding both opposite-normalizer cases in the prime
omega-center branch. Source: Aschbacher--Smith C.1.18, C.1.21--24,
pp.126,128--131, and the Thompson identities preceding13.2.8, p.880.
-/

public section
open Subgroup Theory.GroupTheory Stellmacher
namespace CFSG.Quasithin.Chapter13.Section05.A5Source.Context
open ChapterB ChapterC
variable {G : Type*} [Group G] [Finite G]
  {T : Sylow 2 G} {L V V₁ V₂ V₃ : Subgroup G}
  (d : Context T L V V₁ V₂ V₃)
include d

/-- Original Thompson movement gives the full component commutator identity. -/
theorem eq_thompson_commutator_of_moves
    (hJ : ¬ elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (V : Set G)) :
    L = ⁅L,elementaryAbelianMaxJ (T : Subgroup G)⁆ := by
  let H := L ⊔ (T : Subgroup G)
  let A := L.subgroupOf H
  let R := T.subtype (show (T : Subgroup G) ≤ H from le_sup_right)
  let J := elementaryAbelianMaxJ (R : Subgroup H)
  let : A.Normal := normal_subgroupOf_of_le_normalizer (sup_le L.le_normalizer d.normalizes_L)
  let e : A ≃* L := subgroupOfEquivOfLe (show L ≤ H from le_sup_left)
  have hA : IsPPerfect 2 A := d.twoPerfect.of_surjective e.symm.toMonoidHom e.symm.surjective
  have hJne : J.map d.localActor ≠ ⊥ := by
    intro he
    apply Chapter5.A5Source.local_thompson_moves d hJ
    have hh : J ≤ d.localActor.ker := (Subgroup.map_eq_bot_iff _).mp he
    exact hh.trans_eq d.localActor_kernel
  have hcomm : A = ⁅A,J⁆ := by
    apply eq_commutator_of_isPPerfect_of_map_eq A J hA le_normalizer_of_normal
      d.localActor (d.localActor_kernel_isTwo d.normalizes_L)
    rw [d.localActor_component_image]
    let : IsSimpleGroup (alternatingGroup (Fin 5)) := alternatingGroup.isSimpleGroup (by simp)
    let : Group.IsPerfect (alternatingGroup (Fin 5)) :=
      ⟨commutator_alternatingGroup_eq_top (by simp)⟩
    exact SimpleSocle.commutator_eq _
      (GroupTheory.AutAlternating.centralizer_alternatingGroup_eq_bot 5 (by decide)) _ hJne
  have hh := congrArg (map H.subtype) hcomm
  rw [map_commutator,map_subgroupOf_eq_of_le (show L ≤ H from le_sup_left),
    Chapter5.A5Source.local_thompson_image] at hh
  exact hh

/-- A prime Sylow omega-center excludes normalization of the first pair member. -/
theorem first_baumann_not_normalized_of_omega_card_two
    (hJ : ¬ elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (V : Set G))
    (hz : Nat.card (omegaOneCenterAmbient (T : Subgroup G)) = 2)
    (D : GlaubermanNiles.CharacteristicPair (baumann (T : Subgroup G))) :
    ¬ L ⊔ (T : Subgroup G) ≤ normalizer
      (D.first.map (baumann (T : Subgroup G)).subtype : Set G) := by
  intro hn
  let C := D.first.map (baumann (T : Subgroup G)).subtype
  have hLC : L ≤ normalizer (C : Set G) := le_sup_left.trans hn
  have hBC := GlaubermanNiles.image_centralizes_of_le_omegaCenter
    (baumann (T : Subgroup G)).subtype D.first D.first_le_omegaCenter
  rw [range_subtype] at hBC
  have hJC : elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (C : Set G) :=
    (elementaryAbelianMaxJ_le_baumann _).trans hBC
  have hLN : L ≤ normalizer (centralizer (C : Set G) : Set G) :=
    hLC.trans (normalizer_le_normalizer_centralizer C)
  have hc : L ≤ centralizer (C : Set G) := by
    rw [d.eq_thompson_commutator_of_moves hJ]
    exact (commutator_mono le_rfl hJC).trans
      ((commutator_comm L (centralizer (C : Set G))).le.trans
        (le_normalizer_iff_commutator_le_left.mp hLN))
  have hzero : C = ⊥ := bot_unique ((le_inf ((map_subtype_le _).trans inf_le_left)
    (le_centralizer_iff.mp hc)).trans (d.sylow_centralizer_eq_bot_of_omega_card_two hz).le)
  exact D.first_ne_bot
    ((D.first.map_eq_bot_iff_of_injective (baumann (T : Subgroup G)).subtype_injective).mp hzero)
end CFSG.Quasithin.Chapter13.Section05.A5Source.Context
