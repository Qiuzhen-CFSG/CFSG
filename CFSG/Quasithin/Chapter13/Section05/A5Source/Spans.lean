module
public import CFSG.Quasithin.Chapter13.Section05.A5Source.Centralizers
public import CFSG.Quasithin.Chapter13.Section05.A5Source.Context
public import CFSG.Quasithin.Chapter13.Section06.TerminalContradiction.Ratio.SourceKernel
/-!
# The three equivalent conditions in original 13.5.10

The source flag makes N(V) ∩ C(V₃)=C(V) on the actual order-eight third
subgroup. This is precisely the centralizer hypothesis of the proved
F.9.4(3). Both conjugate spans are generated by elementary abelian groups,
so abelianness and elementary abelianness agree in that application.

The final export consumes the literal Chapter13 SourceF91 record from
13.5.7. It retains that earlier theorem explicitly; it has no independent
centralizer equality, prescribed V₃ coordinates, or span-equivalence input.

Source: Aschbacher–Smith 13.5.7 and 13.5.10, printed pp.917–918.
-/
@[expose] public section
open Subgroup
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter13.Section05.A5Source
open Section06.CentralizerReduction Section06.TerminalContradiction.Ratio
open A5Module
variable {G : Type*} [Group G] [Finite G]
  {T : Sylow 2 G} {L V V₁ V₂ V₃ H : Subgroup G}

/-- The three assertions of original 13.5.10 on the actual conjugate spans. -/
theorem span_equivalences (d : FlagSource T L V V₁ V₂)
    (hV₃ : V₃ ≤ V) (hc : Nat.card V₃ = 8)
    (hT : (T : Subgroup G) ≤ normalizer (V₃ : Set G))
    (h : (⟨T,L,V,V₃,V₁,H⟩ : ChapterF.Section09.Setup G).Hypothesis) :
    (IsMulCommutative (conjugateSpanBy V₃ H) ↔
      IsMulCommutative (conjugateSpanBy V H)) ∧
    (IsMulCommutative (conjugateSpanBy V₃ H) ↔ V ≤ H.pCoreIn 2) := by
  let D : ChapterF.Section09.Setup G := ⟨T,L,V,V₃,V₁,H⟩
  have heq : (H ⊓ centralizer (V₃ : Set G)) ⊓
      (H ⊓ normalizer (V : Set G)) = H ⊓ centralizer (V : Set G) := by
    apply le_antisymm
    · intro x hx
      exact ⟨hx.1.1, (centralizer_third d V₃ hV₃ hc hT).le ⟨hx.2.2,hx.1.2⟩⟩
    · exact le_inf (inf_le_inf_left H (centralizer_le hV₃))
        (inf_le_inf_left H (Subgroup.centralizer_le_normalizer _))
  have he := h.lemma_F_9_4_three heq
  have hu : IsMulCommutative D.UH ↔ IsElementaryAbelian 2 D.UH := by
    constructor
    · intro hU
      let : IsMulCommutative (conjugateSpanBy V₃ H) := hU
      let := h.elementary
      let : IsElementaryAbelian 2 V₃ := IsElementaryAbelian.of_le hV₃
      exact conjugateSpanBy_elementary_of_commutative V₃ H
    · exact fun hU => hU.toIsMulCommutative
  have hv : IsMulCommutative D.VH ↔ IsElementaryAbelian 2 D.VH := by
    constructor
    · intro hV
      let : IsMulCommutative (conjugateSpanBy V H) := hV
      let := h.elementary
      exact conjugateSpanBy_elementary_of_commutative V H
    · exact fun hV => hV.toIsMulCommutative
  exact ⟨hu.trans (he.2.trans hv.symm),hu.trans he.1.symm⟩

/-- The literal Chapter13 F.9.1 record suffices; no marking of V₃ or
independent span or centralizer conclusion remains. -/
theorem source_span_equivalences [IsElementaryAbelian 2 V]
    (d : Context T L V V₁ V₂ V₃) (h : SourceF91 T L V V₃ V₁ H) :
    (IsMulCommutative (conjugateSpanBy V₃ H) ↔
      IsMulCommutative (conjugateSpanBy V H)) ∧
    (IsMulCommutative (conjugateSpanBy V₃ H) ↔ V ≤ H.pCoreIn 2) :=
  span_equivalences d.flag d.third_le d.third_card d.third_invariant h.f9Hypothesis
end CFSG.Quasithin.Chapter13.Section05.A5Source
