public import CFSG.Quasithin.Chapter13.Section07.OrdinarySource.NoncontainedSL2Four
/-!
# The original noncontained semilinear normalizer escapes M

The faithful marked natural section embeds H-star into ΓL₂(4). The actual
point residual is generated by its commutators with T and remains outside
K-star, forcing the semilinear image to be full. Its literal local two-core
then has a marked Sylow-four image. Cubic rank survives the two-core
quotient, so the actual H-normalizer has rank at least two and escapes M.

The final source consumer preserves the earlier-source block and chief-count
inputs. The quotient, core and normalizer markings are derived here rather
than supplied as optional model hypotheses.
Source: Aschbacher–Smith 13.7.19, printed p.945.
-/

public noncomputable section
open Subgroup
namespace CFSG.Quasithin.Chapter13.Section07.OrdinarySource
open Section08.Source
open Section08.TransvectionRecognition.Component.ModelExtension
open Section08.ComponentSieve.FieldComponents.LinearThree.Geometry.CoveredProduct.ResidualPlacement
variable {G : Type*} [Group G] [Finite G]
  {T : Sylow 2 G} {L V₁ M G₁ H : Subgroup G}

theorem source_local_normalizer_rank_eq_star
    (hH : H ∈ Hz (sourceOne L T V₁) T G₁ M) :
    primeRank 3 (H ⊓ normalizer
      ((sourceOne L T V₁ ⊔ (T : Subgroup G)).pCoreIn 2 : Set G) : Subgroup G) =
    primeRank 3 (normalizer (starImage H
      ((sourceOne L T V₁ ⊔ (T : Subgroup G)).pCoreIn 2) : Set (Hstar H))) := by
  let R := (sourceOne L T V₁ ⊔ (T : Subgroup G)).pCoreIn 2
  have hRH : R ≤ H := (pCoreIn_le 2 _).trans hH.1.2
  let q := QuotientGroup.mk' (pCore 2 H)
  have hk : IsPGroup 2 q.ker := by rw [QuotientGroup.ker_mk']; exact pCore_isPGroup
  have hker : q.ker ≤ R.subgroupOf H := by
    rw [QuotientGroup.ker_mk']
    intro x hx
    exact source_twoCore_le_local_twoCore hH (mem_map_of_mem H.subtype hx)
  have he := primeRank_three_normalizer_eq_of_twoGroup_kernel q
    (QuotientGroup.mk'_surjective _) hk (R.subgroupOf H) hker
  have hn : (H ⊓ normalizer (R : Set G)).subgroupOf H =
      normalizer (R.subgroupOf H : Set H) := by
    rw [inf_subgroupOf_left, subgroupOf_normalizer_eq hRH]
  rw [←hn] at he
  rw [primeRank_congr 3 (subgroupOfEquivOfLe (show H ⊓ normalizer (R : Set G) ≤ H from inf_le_left))] at he
  exact he
end CFSG.Quasithin.Chapter13.Section07.OrdinarySource

namespace CFSG.Quasithin.Chapter13.Section07.OrdinarySource
open Section08.SourceCompletion Section08.Source
open Section08.TransvectionRecognition.Component.ModelExtension
open Section08.ComponentSieve.FieldComponents.LinearThree.Geometry.CoveredProduct.ResidualPlacement
open scoped IsMulCommutative
open Representation.SL2FourNatural.SemilinearNormalizer
variable {G : Type*} [Group G] [Finite G]
  {T : Sylow 2 G} {L V V₁ V₂ V₃ M G₁ H K : Subgroup G}

theorem source_noncontained_normalizer_rank_of_embedding
    (d : NaturalSetup T L V V₁ V₂ V₃ M G₁)
    (hH : H ∈ Hz (sourceOne L T V₁) T G₁ M)
    (h : (ConjugateIntersections.sourceSetup T L V V₃ V₁ H).Hypothesis)
    (hU : IsMulCommutative (UH H V₃)) (hV : ¬ IsMulCommutative (VH H V))
    (hKH : K ≤ H) (hKn : H ≤ normalizer (K : Set G))
    (hout : ¬ sourceOne L T V₁ ≤ K)
    (f : Hstar H →* Gamma) (hf : Function.Injective f)
    (hmap : (starImage H K).map f = special.range) :
    2 ≤ primeRank 3 (H ⊓ normalizer
      ((sourceOne L T V₁ ⊔ (T : Subgroup G)).pCoreIn 2 : Set G) : Subgroup G) := by
  let J := starImage H (sourceOne L T V₁)
  let S := starImage H (T : Subgroup G)
  have hJS : J = ⁅J,S⁆ := source_local_star_eq_commutator d hH h hU hV
  have hne : ¬ J ≤ starImage H K := source_noncontained_star_not_le hH hKH hKn hout
  have hsurj := surjective_of_marked_commutator f hf (starImage H K) J S hmap hJS hne
  let e : Hstar H ≃* Gamma := MulEquiv.ofBijective f ⟨hf,hsurj⟩
  let : Finite Gamma := Finite.of_surjective f hsurj
  have hTH : (T : Subgroup G) ≤ H := h.T_le_H
  let q := QuotientGroup.mk' (pCore 2 H)
  let SH := (T.subtype hTH).mapSurjective
    (f := q) (QuotientGroup.mk'_surjective _)
  let SG := SH.mapSurjective (f := e.toMonoidHom) e.surjective
  have hSG : (SG : Subgroup Gamma) = S.map e.toMonoidHom := rfl
  let JG := J.map e.toMonoidHom
  have hc : JG = ⁅JG,(SG : Subgroup Gamma)⁆ := by
    rw [hSG, ←map_commutator, ←hJS]
  have hn : (SG : Subgroup Gamma) ≤ normalizer (JG : Set Gamma) :=
    le_normalizer_iff_commutator_le_left.mpr hc.ge
  have hneG : ¬ JG ≤ special.range := by
    change ¬ J.map f ≤ special.range
    rw [←hmap, map_le_map_iff_of_injective hf]
    exact hne
  obtain ⟨h5,h9⟩ := source_local_star_card_constraints d hH h hU hV
  have h5G : ¬ 5 ∣ Nat.card JG := by
    change ¬ 5 ∣ Nat.card (J.map e.toMonoidHom)
    rw [card_map_of_injective (f := e.toMonoidHom) e.injective]
    exact h5
  have h9G : ¬ 9 ∣ Nat.card JG := by
    change ¬ 9 ∣ Nat.card (J.map e.toMonoidHom)
    rw [card_map_of_injective (f := e.toMonoidHom) e.injective]
    exact h9
  have hjoin : starImage H (sourceOne L T V₁ ⊔ (T : Subgroup G)) = J ⊔ S := by
    unfold starImage
    rw [subgroupOf_sup (le_sup_left.trans hH.1.2) hTH, Subgroup.map_sup]
    rfl
  let R := (sourceOne L T V₁ ⊔ (T : Subgroup G)).pCoreIn 2
  have hker : IsPGroup 2 e.toMonoidHom.ker := by
    rw [show e.toMonoidHom.ker = ⊥ from (MonoidHom.ker_eq_bot_iff e.toMonoidHom).mpr e.injective]
    exact IsPGroup.of_subsingleton 2 _
  have hR : (starImage H R).map e.toMonoidHom = (JG ⊔ (SG : Subgroup Gamma)).pCoreIn 2 := by
    rw [source_local_twoCore_star_eq hH, map_pCoreIn_of_ker_isPGroup e.toMonoidHom hker,
      hjoin, Subgroup.map_sup, ←hSG]
  have hr := two_le_primeRank_join_twoCore_normalizer SG JG hn hc hneG h5G h9G
  rw [source_local_normalizer_rank_eq_star hH]
  have he := primeRank_congr 3 ((normalizer (starImage H R : Set (Hstar H))).equivMapOfInjective
    e.toMonoidHom e.injective)
  rw [map_equiv_normalizer_eq, hR] at he
  exact he.ge.trans' hr
end CFSG.Quasithin.Chapter13.Section07.OrdinarySource

namespace CFSG.Quasithin.Chapter13.Section07.OrdinarySource
open Subgroup Representation Representation.BinaryOffender Theory.GroupTheory NoncentralChiefRefinement
open Section08.SourceCompletion ChapterF.Section09.Setup
open Section08.TransvectionRecognition
open Section08.TransvectionRecognition.Component.ModelExtension
open Section08.TransvectionRecognition.Component
open Section08.ComponentSieve.FieldComponents.LinearThree.Geometry.CoveredProduct.ResidualPlacement
open ChapterB.QuasisimpleSource
open scoped IsMulCommutative
variable {G : Type*} [Group G] [Finite G]
  {T : Sylow 2 G} {L V V₁ V₂ V₃ M G₁ H K : Subgroup G}

/-- Original 13.7.19: the noncontained natural component forces the full
marked semilinear quotient and an escaping actual local-core normalizer. -/
theorem source_noncontained_semilinear_and_escape
    [(V₁.subgroupOf (Section08.Source.UH H V₃)).Normal]
    [IsElementaryAbelian 2 (Section08.Source.Utilde H V₃ V₁)]
    (d : NaturalSetup T L V V₁ V₂ V₃ M G₁)
    (h1221 : Chapter12.Section02.Hypothesis1221 KnownSimple.IsKnownSimple T L)
    (hH : H ∈ Section08.Source.Hz (sourceOne L T V₁) T G₁ M)
    (h : (ConjugateIntersections.sourceSetup T L V V₃ V₁ H).Hypothesis)
    (hU : IsMulCommutative (Section08.Source.UH H V₃))
    (hV : ¬ IsMulCommutative (Section08.Source.VH H V))
    (hne : ⁅V₃,G₁.pCoreIn 2⁆ ≠ ⊥)
    (g : (L ⊔ (T : Subgroup G) : Subgroup G))
    (hsquare : (QuotientGroup.mk' (pCore 2 (L ⊔ (T : Subgroup G) : Subgroup G)) g)^2 = 1)
    (hout : ¬ conjugate V₁ (g : G) ≤ Section08.Source.UH H V₃)
    {W : Type*} [AddCommGroup W] [Module (ZMod 2) W] [FiniteDimensional (ZMod 2) W]
    (σ : Representation (ZMod 2) (H ⧸ pCore 2 H) W)
    (s : BinaryConjugationSection H (Section08.Source.UH H V₃)
      ((Section08.Source.UH H V₃) ⊓ centralizer (H.pCoreIn 2 : Set G))
      (σ.comp (QuotientGroup.mk' (pCore 2 H))))
    (B : Subgroup (H ⧸ pCore 2 H)) (hB : IsMinimalBestOffender σ B)
    (hBA : B ≤ ((conjugate (Section08.Source.VH H V) (g : G) ⊓
      (L ⊔ (T : Subgroup G) : Subgroup G).pCoreIn 2).subgroupOf H).map
        (QuotientGroup.mk' (pCore 2 H)))
    (hKH : K ≤ H) (hKC : (K.subgroupOf H).IsCComponent)
    (hKstar : IsComponent (Section08.Source.Hstar H) (Section08.Source.starImage H K))
    (hKn : H ≤ normalizer (K : Set G))
    (hk : PlusAction.kernel (ConjugateIntersections.sourceSetup T L V V₃ V₁ H) = H.pCoreIn 2)
    (hcomm : ⁅Section08.Source.starImage H K,B⁆ = Section08.Source.starImage H K)
    (ρ : Representation (ZMod 2) (Section08.Source.Hstar H)
      (Additive (Section08.Source.Utilde H V₃ V₁)))
    (hρ : IsConjugation H V₃ V₁ ρ)
    (eK : (K ⧸ pCore 2 K) ≃* Representation.SL2FourNatural.SL)
    (hs : HasSectionModel H V₃ V₁ ρ K hKH
      (SL2OrthogonalCover.binaryNatural (F := SL2FourNatural.F)) eK)
    (c : BinaryConjugationSection H (Section08.Source.UH H V₃) V₁
      (ρ.comp (QuotientGroup.mk' (pCore 2 H))))
    (hnot : ¬ sourceOne L T V₁ ≤ K) :
    ∃ e : Section08.Source.Hstar H ≃* SL2FourNatural.SemilinearNormalizer.Gamma,
      (Section08.Source.starImage H K).map e.toMonoidHom =
        SL2FourNatural.SemilinearNormalizer.special.range ∧
      2 ≤ primeRank 3 (H ⊓ normalizer
        ((sourceOne L T V₁ ⊔ (T : Subgroup G)).pCoreIn 2 : Set G) : Subgroup G) ∧
      ¬ H ⊓ normalizer
        ((sourceOne L T V₁ ⊔ (T : Subgroup G)).pCoreIn 2 : Set G) ≤ M := by
  obtain ⟨f,hf,_,hmap⟩ := source_component_semilinear_embedding d h hU hV hne g hsquare hout
    σ s B hB hBA hKH hKC hKstar hKn hk hcomm ρ hρ eK hs c
  have hJS := source_local_star_eq_commutator d hH h hU hV
  have hnotstar := source_noncontained_star_not_le hH hKH hKn hnot
  have hsurj := SL2FourNatural.SemilinearNormalizer.surjective_of_marked_commutator f hf
    (Section08.Source.starImage H K) (Section08.Source.starImage H (sourceOne L T V₁))
    (Section08.Source.starImage H (T : Subgroup G)) hmap hJS hnotstar
  let e := MulEquiv.ofBijective f ⟨hf,hsurj⟩
  have hr := source_noncontained_normalizer_rank_of_embedding d hH h hU hV hKH hKn hnot f hf hmap
  exact ⟨e,hmap,hr,source_local_normalizer_escape d h1221 hH h hU hV (by omega)⟩

/-- The literal 13.7.19 containment, retaining exactly the genuine earlier
normalizer-escape-to-block and block-to-chief-count source inputs. -/
theorem source_sl2Four_containment_of_block_bounds
    [(V₁.subgroupOf (Section08.Source.UH H V₃)).Normal]
    [IsElementaryAbelian 2 (Section08.Source.Utilde H V₃ V₁)]
    (d : NaturalSetup T L V V₁ V₂ V₃ M G₁)
    (h1221 : Chapter12.Section02.Hypothesis1221 KnownSimple.IsKnownSimple T L)
    (hH : H ∈ Section08.Source.Hz (sourceOne L T V₁) T G₁ M)
    (h : (ConjugateIntersections.sourceSetup T L V V₃ V₁ H).Hypothesis)
    (hU : IsMulCommutative (Section08.Source.UH H V₃))
    (hV : ¬ IsMulCommutative (Section08.Source.VH H V))
    (hne : ⁅V₃,G₁.pCoreIn 2⁆ ≠ ⊥)
    (g : (L ⊔ (T : Subgroup G) : Subgroup G))
    (hsquare : (QuotientGroup.mk' (pCore 2 (L ⊔ (T : Subgroup G) : Subgroup G)) g)^2 = 1)
    (hout : ¬ conjugate V₁ (g : G) ≤ Section08.Source.UH H V₃)
    {W : Type*} [AddCommGroup W] [Module (ZMod 2) W] [FiniteDimensional (ZMod 2) W]
    (σ : Representation (ZMod 2) (H ⧸ pCore 2 H) W)
    (s : BinaryConjugationSection H (Section08.Source.UH H V₃)
      ((Section08.Source.UH H V₃) ⊓ centralizer (H.pCoreIn 2 : Set G))
      (σ.comp (QuotientGroup.mk' (pCore 2 H))))
    (B : Subgroup (H ⧸ pCore 2 H)) (hB : IsMinimalBestOffender σ B)
    (hBA : B ≤ ((conjugate (Section08.Source.VH H V) (g : G) ⊓
      (L ⊔ (T : Subgroup G) : Subgroup G).pCoreIn 2).subgroupOf H).map
        (QuotientGroup.mk' (pCore 2 H)))
    (hKH : K ≤ H) (hKC : (K.subgroupOf H).IsCComponent)
    (hKstar : IsComponent (Section08.Source.Hstar H) (Section08.Source.starImage H K))
    (hKn : H ≤ normalizer (K : Set G))
    (hk : PlusAction.kernel (ConjugateIntersections.sourceSetup T L V V₃ V₁ H) = H.pCoreIn 2)
    (hcomm : ⁅Section08.Source.starImage H K,B⁆ = Section08.Source.starImage H K)
    (ρ : Representation (ZMod 2) (Section08.Source.Hstar H)
      (Additive (Section08.Source.Utilde H V₃ V₁)))
    (hρ : IsConjugation H V₃ V₁ ρ)
    (eK : (K ⧸ pCore 2 K) ≃* Representation.SL2FourNatural.SL)
    (hs : HasSectionModel H V₃ V₁ ρ K hKH
      (SL2OrthogonalCover.binaryNatural (F := SL2FourNatural.F)) eK)
    (c : BinaryConjugationSection H (Section08.Source.UH H V₃) V₁
      (ρ.comp (QuotientGroup.mk' (pCore 2 H))))
    (hblock : (¬ H ⊓ normalizer
      ((sourceOne L T V₁ ⊔ (T : Subgroup G)).pCoreIn 2 : Set G) ≤ M) →
      ChapterC.IsAlternatingBlock (L.subgroupOf (L ⊔ (T : Subgroup G))) 6)
    (hblockCount : ChapterC.IsAlternatingBlock (L.subgroupOf (L ⊔ (T : Subgroup G))) 6 →
      ∀ t : ChiefSeries (ConjugateIntersections.sourceSetup T L V V₃ V₁ H).L₁,
        t.head = ⊥ → t.last = ⊤ → t.noncentralTwoCount ≤ 2) :
    sourceOne L T V₁ ≤ K := by
  by_contra hnot
  obtain ⟨e,he,hr,hes⟩ := source_noncontained_semilinear_and_escape d h1221 hH h hU hV
    hne g hsquare hout σ s B hB hBA hKH hKC hKstar hKn hk hcomm ρ hρ eK hs c hnot
  exact source_L1_false_of_two_chief_bound d h hU hV (hblockCount (hblock hes))

end CFSG.Quasithin.Chapter13.Section07.OrdinarySource
