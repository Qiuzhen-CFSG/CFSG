module
public import Theory.Representation.BinaryOffender.MovedSectionAction
public import CFSG.Quasithin.Chapter13.Section07.ComponentTildeSource
public import CFSG.Quasithin.Chapter13.Section08.LocalAnalysis.TransvectionModules.Recognition.Component.ModelExtension.CoverProjection
public import Theory.Representation.SL2FourNaturalOrbits.SemilinearNormalizer.AmbientAction
public import Theory.Representation.SL2FourNaturalOrbits.NaturalCompatibility

/-!
# The actual natural component extends to the ambient semilinear group

The component-moved part of the literal tilde module is faithful: it maps
onto the faithful plus module, which the component generates. Perfectness
makes that moved part generated by the component, so its natural section
extends to a faithful ambient action. The marked binary natural normalizer
then embeds the actual H/O₂(H) into ΓL₂(4), preserving the component.

This is the ambient action step of original 13.7.19. It does not use the
later containment L₁ ≤ K or identify the entire tilde module with its natural
section. Source: Aschbacher–Smith, printed pp.944–945, 13.7.16 and 13.7.19.
-/

public noncomputable section
open Subgroup Representation Representation.BinaryOffender Theory.GroupTheory
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter13.Section07
open Section08.TransvectionRecognition Section08.TransvectionRecognition.Component
open Section08.TransvectionRecognition.Component.ModelExtension
open ChapterB.QuasisimpleSource
section NaturalSection
variable {G : Type*} [Group G] [Finite G] {H K V₃ V₁ : Subgroup G}
  [(V₁.subgroupOf (Section08.Source.UH H V₃)).Normal]
  [IsElementaryAbelian 2 (Section08.Source.Utilde H V₃ V₁)]

/-- Extend the actual natural component section through a faithful whole plus image. -/
theorem source_component_natural_action
    (hKH : K ≤ H) (hKC : (K.subgroupOf H).IsCComponent)
    (hKstar : IsComponent (Section08.Source.Hstar H) (Section08.Source.starImage H K))
    (hKn : H ≤ normalizer (K : Set G))
    (ρ : Representation (ZMod 2) (Section08.Source.Hstar H)
      (Additive (Section08.Source.Utilde H V₃ V₁)))
    (hρ : IsConjugation H V₃ V₁ ρ)
    {W : Type*} [AddCommGroup W] [Module (ZMod 2) W]
    (σ : Representation (ZMod 2) (Section08.Source.Hstar H) W)
    (f : Additive (Section08.Source.Utilde H V₃ V₁) →ₗ[ZMod 2] W)
    (hf : Function.Surjective f) (hfe : ∀ a v, f (ρ a v) = σ a (f v))
    (hσ : Function.Injective σ)
    (hwhole : subspaceCommutator σ ⊤ (Section08.Source.starImage H K) = ⊤)
    (eK : (K ⧸ pCore 2 K) ≃* Representation.SL2FourNatural.SL)
    (hm : HasSectionModel H V₃ V₁ ρ K hKH
      Representation.SL2FourNatural.PointCommutator.representation eK) :
    ∃ γ : Representation (ZMod 2) (Section08.Source.Hstar H) Representation.SL2FourNatural.V,
      Function.Injective γ ∧ ∀ (k : Section08.Source.starImage H K) v,
        γ k v = Representation.SL2FourNatural.PointCommutator.representation
          (eK ((Section08.Components.componentStarEquiv H K hKH hKC).symm k)) v := by
  let π := QuotientGroup.mk' (pCore 2 H)
  let J := Section08.Source.starImage H K
  let : (K.subgroupOf H).Normal := (normal_subgroupOf_iff_le_normalizer hKH).mpr hKn
  let : J.Normal := (inferInstance : (K.subgroupOf H).Normal).map π (QuotientGroup.mk'_surjective _)
  let : IsQuasisimple J := hKstar.2
  let e := (Section08.Components.componentStarEquiv H K hKH hKC).symm.trans eK
  let τ := Representation.SL2FourNatural.PointCommutator.representation.comp e.toMonoidHom
  have hτ : Function.Injective τ := by
    intro a b hab
    apply e.injective
    apply Representation.SL2FourNatural.action_faithful
    apply LinearEquiv.ext
    intro v
    exact LinearMap.congr_fun hab v
  have hI := commutatorImage_eq_subspaceCommutator K hKH ρ hρ
  unfold HasSectionModel ComponentSection fixedInCommutator at hm
  rw [hI] at hm
  obtain ⟨hs,ev,he⟩ := hm
  apply exists_faithful_action_of_moved_section ρ σ J f hf hfe hσ hwhole τ hτ ev
  rintro ⟨x,hx⟩ v
  obtain ⟨a,ha,rfl⟩ := hx
  let a' : K := ⟨a,ha⟩
  have hmk := Section08.Components.componentStarEquiv_mk H K hKH hKC a'
  have he' := he a'
  have hke : eK (QuotientGroup.mk' (pCore 2 K) a') =
      e ⟨π a,mem_map_of_mem π ha⟩ := by
    change eK _ = eK ((Section08.Components.componentStarEquiv H K hKH hKC).symm _)
    congr 1
    apply (Section08.Components.componentStarEquiv H K hKH hKC).injective
    rw [MulEquiv.apply_symm_apply]
    apply Subtype.ext
    exact hmk
  have hia : inclusion hKH a' = a := Subtype.ext rfl
  simp only [hia,hke] at he'
  simpa only [τ,MonoidHom.comp_apply,MulEquiv.coe_toMonoidHom] using he' v
end NaturalSection

open Section08.SourceCompletion ChapterF.Section09.Setup
variable {G : Type*} [Group G] [Finite G]
  {T : Sylow 2 G} {L V V₁ V₂ V₃ M G₁ H K : Subgroup G}

/-- The original selected packet embeds the literal ambient quotient into the
marked semilinear normalizer, without the later point-residual containment. -/
theorem source_component_semilinear_embedding
    [(V₁.subgroupOf (Section08.Source.UH H V₃)).Normal]
    [IsElementaryAbelian 2 (Section08.Source.Utilde H V₃ V₁)]
    (d : NaturalSetup T L V V₁ V₂ V₃ M G₁)
    (h : (ConjugateIntersections.sourceSetup T L V V₃ V₁ H).Hypothesis)
    (hU : IsMulCommutative (Section08.Source.UH H V₃))
    (hV : ¬ IsMulCommutative (Section08.Source.VH H V))
    (hne : ⁅V₃,G₁.pCoreIn 2⁆ ≠ ⊥)
    (g : (L ⊔ (T : Subgroup G) : Subgroup G))
    (hsquare : (QuotientGroup.mk' (pCore 2 (L ⊔ (T : Subgroup G) : Subgroup G)) g)^2 = 1)
    (hout : ¬ conjugate V₁ (g : G) ≤ Section08.Source.UH H V₃)
    {W : Type*} [AddCommGroup W] [Module (ZMod 2) W] [FiniteDimensional (ZMod 2) W]
    (σ : Representation (ZMod 2) (H ⧸ pCore 2 H) W)
    (s : BinaryConjugationSection H (Section08.Source.UH H V₃)
      ((Section08.Source.UH H V₃) ⊓ centralizer (H.pCoreIn 2 : Set G))
      (σ.comp (QuotientGroup.mk' (pCore 2 H))))
    (B : Subgroup (H ⧸ pCore 2 H)) (hB : IsMinimalBestOffender σ B)
    (hBA : B ≤ ((conjugate (Section08.Source.VH H V) (g : G) ⊓
      (L ⊔ (T : Subgroup G) : Subgroup G).pCoreIn 2).subgroupOf H).map
        (QuotientGroup.mk' (pCore 2 H)))
    (hKH : K ≤ H) (hKC : (K.subgroupOf H).IsCComponent)
    (hKstar : IsComponent (Section08.Source.Hstar H) (Section08.Source.starImage H K))
    (hKn : H ≤ normalizer (K : Set G))
    (hk : PlusAction.kernel (ConjugateIntersections.sourceSetup T L V V₃ V₁ H) = H.pCoreIn 2)
    (hcomm : ⁅Section08.Source.starImage H K,B⁆ = Section08.Source.starImage H K)
    (ρ : Representation (ZMod 2) (Section08.Source.Hstar H)
      (Additive (Section08.Source.Utilde H V₃ V₁)))
    (hρ : IsConjugation H V₃ V₁ ρ)
    (eK : (K ⧸ pCore 2 K) ≃* Representation.SL2FourNatural.SL)
    (hs : HasSectionModel H V₃ V₁ ρ K hKH
      (SL2OrthogonalCover.binaryNatural (F := SL2FourNatural.F)) eK)
    (c : BinaryConjugationSection H (Section08.Source.UH H V₃) V₁
      (ρ.comp (QuotientGroup.mk' (pCore 2 H)))) :
    ∃ f : Section08.Source.Hstar H →* SL2FourNatural.SemilinearNormalizer.Gamma,
      Function.Injective f ∧
      (∀ k : Section08.Source.starImage H K,
        f (k : Section08.Source.Hstar H) = SL2FourNatural.SemilinearNormalizer.special
          (eK ((Section08.Components.componentStarEquiv H K hKH hKC).symm k))) ∧
      (Section08.Source.starImage H K).map f =
        SL2FourNatural.SemilinearNormalizer.special.range := by
  let π := QuotientGroup.mk' (pCore 2 H)
  obtain ⟨p,hp,_,_⟩ := BinaryConjugationSection.exists_projection
    H H (Section08.Source.UH H V₃) V₁
    (PlusAction.fixedLayer (ConjugateIntersections.sourceSetup T L V V₃ V₁ H))
    le_rfl (PlusAction.point_le_fixedLayer h) π π
    (QuotientGroup.mk'_surjective _) (MonoidHom.id _) (by intro k; rfl) ρ σ c s
  have hm : HasSectionModel H V₃ V₁ ρ K hKH
      SL2FourNatural.PointCommutator.representation eK := by
    rw [SL2FourNatural.pointCommutator_eq_binaryNatural]
    exact hs
  have hwhole := source_plus_component_whole d h hU hV hne g hsquare hout
    σ s B hB hBA (K.subgroupOf H) hKC hKstar hk hcomm
  obtain ⟨γ,hγ,hres⟩ := source_component_natural_action hKH hKC hKstar hKn ρ hρ
    σ p.toLinearMap hp (fun a v => LinearMap.congr_fun (p.isIntertwining' a) v)
    (source_plus_faithful_of_kernel_eq σ s hk) hwhole eK hm
  let : (K.subgroupOf H).Normal := (normal_subgroupOf_iff_le_normalizer hKH).mpr hKn
  have hJ : (Section08.Source.starImage H K).Normal :=
    (inferInstance : (K.subgroupOf H).Normal).map π (QuotientGroup.mk'_surjective _)
  exact SL2FourNatural.SemilinearNormalizer.exists_injective_ambient_action_map
    (Section08.Source.starImage H K) hJ
    ((Section08.Components.componentStarEquiv H K hKH hKC).symm.trans eK) γ hγ hres

end CFSG.Quasithin.Chapter13.Section07


