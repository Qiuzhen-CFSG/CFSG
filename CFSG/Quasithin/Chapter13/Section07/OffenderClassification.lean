module
public import CFSG.Quasithin.Chapter13.Section07.ComponentSelection
public import CFSG.Quasithin.ChapterB.Section05.GeneralClassification.OffenderSubgroup

/-!
# Actual B.5 classification on the plus offender subgroup

The original H centralizes the order-two source point. Its point normalizer
is a genuine two-local subgroup, so the full simple-QTKE hypothesis gives
SQTK for H. The literal map H→H/O₂(H), followed by pullback of the normal
best-offender subgroup, constructs the SQTK cover used by complete B.5.
Faithfulness follows from the original13.7.4 kernel equality. The normal
best-offender subgroup has trivial two-core and is generated by its actual
best offenders, so no classification or actor-generation input remains.

The selected quotient component is retained as a normal ordinary component
of this classified actor. The five adequate alternatives are all retained;
their component/module comparison belongs to the next13.7.15 step.
Source: Aschbacher–Smith B.1.5(4), B.5.6 and13.7.15, printed pp.69,105,943.
-/

public section
open Subgroup Representation Representation.BinaryOffender Theory.GroupTheory
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter13.Section07
open Section08.SourceCompletion ChapterF.Section09.Setup
open ChapterB.SourceInduction
universe u v
variable {G : Type u} [Group G] [Finite G]
  {T : Sylow 2 G} {L V V₁ V₂ V₃ M G₁ H : Subgroup G}
  (d : NaturalSetup T L V V₁ V₂ V₃ M G₁)
include d

/-- The actual source H inherits SQTK from its original point normalizer. -/
theorem source_plus_local_sqtk
    (h : (ConjugateIntersections.sourceSetup T L V V₃ V₁ H).Hypothesis) :
    IsSQTK KnownSimple.IsKnownSimple H := by
  have hp : IsPGroup 2 V₁ := IsPGroup.of_card (n := 1) (by simpa using d.line_card)
  have hn : V₁ ≠ ⊥ := by
    intro he
    have hc := d.line_card
    rw [he, card_bot] at hc
    contradiction
  have hloc : IsTwoLocal (normalizer (V₁ : Set G)) := ⟨V₁,hn,hp,rfl⟩
  have hHN : H ≤ normalizer (V₁ : Set G) :=
    h.H_centralizes.trans (Subgroup.centralizer_le_normalizer _)
  exact (IsSQTK.equiv (subgroupOfEquivOfLe hHN)).mp
    ((d.counterexample.qtke.twoLocal_sqtk hloc).subgroup (H.subgroupOf (normalizer (V₁ : Set G))))

/-- The literal local two-core quotient has the original H as its SQTK cover. -/
noncomputable def source_plus_sqtk_cover
    (h : (ConjugateIntersections.sourceSetup T L V V₃ V₁ H).Hypothesis) :
    SQTKQuotient KnownSimple.IsKnownSimple (H ⧸ pCore 2 H) where
  Cover := H
  kernel := pCore 2 H
  sqtk := source_plus_local_sqtk d h
  equiv := MulEquiv.refl _

/-- Complete B.5 on the original plus action's normal offender subgroup.
The only faithfulness input is the original13.7.4 action-kernel equality. -/
theorem source_plus_offender_classification
    (h : (ConjugateIntersections.sourceSetup T L V V₃ V₁ H).Hypothesis)
    {W : Type v} [AddCommGroup W] [Module (ZMod 2) W] [FiniteDimensional (ZMod 2) W]
    (σ : Representation (ZMod 2) (H ⧸ pCore 2 H) W)
    (s : BinaryConjugationSection H (Section08.Source.UH H V₃)
      ((Section08.Source.UH H V₃) ⊓ centralizer (H.pCoreIn 2 : Set G))
      (σ.comp (QuotientGroup.mk' (pCore 2 H))))
    (hk : PlusAction.kernel (ConjugateIntersections.sourceSetup T L V V₃ V₁ H) = H.pCoreIn 2) :
    AdequateAlternative (σ.comp (offenderSubgroup σ).subtype) :=
  offenderSubgroup_adequateAlternative σ (source_plus_faithful_of_kernel_eq σ s hk)
    (pCore_quotient_pCore_eq_bot 2) (source_plus_sqtk_cover d h)

/-- The actually selected component survives inside the classified normal
actor, retaining its original quotient image. No B.5 action case is assumed. -/
theorem source_plus_selected_component_classification
    (h : (ConjugateIntersections.sourceSetup T L V V₃ V₁ H).Hypothesis)
    {W : Type v} [AddCommGroup W] [Module (ZMod 2) W] [FiniteDimensional (ZMod 2) W]
    (σ : Representation (ZMod 2) (H ⧸ pCore 2 H) W)
    (s : BinaryConjugationSection H (Section08.Source.UH H V₃)
      ((Section08.Source.UH H V₃) ⊓ centralizer (H.pCoreIn 2 : Set G))
      (σ.comp (QuotientGroup.mk' (pCore 2 H))))
    (hk : PlusAction.kernel (ConjugateIntersections.sourceSetup T L V V₃ V₁ H) = H.pCoreIn 2)
    (K : Subgroup H) (hK : IsComponent (H ⧸ pCore 2 H) (K.map (QuotientGroup.mk' (pCore 2 H))))
    (B : Subgroup (H ⧸ pCore 2 H)) (hB : IsBestOffender σ B)
    (hcomm : ⁅K.map (QuotientGroup.mk' (pCore 2 H)),B⁆ = K.map (QuotientGroup.mk' (pCore 2 H))) :
    NontrivialAdequateAlternative (σ.comp (offenderSubgroup σ).subtype) ∧
      K.map (QuotientGroup.mk' (pCore 2 H)) ≤ offenderSubgroup σ ∧
      ((K.map (QuotientGroup.mk' (pCore 2 H))).subgroupOf (offenderSubgroup σ)).Normal ∧
      IsComponent (offenderSubgroup σ)
        ((K.map (QuotientGroup.mk' (pCore 2 H))).subgroupOf (offenderSubgroup σ)) := by
  have hs := source_plus_offender_classification d h σ s hk
  have hf := source_plus_faithful_of_kernel_eq σ s hk
  have hBN := hB.le_offenderSubgroup σ
  have hff : IsFFModule (σ.comp (offenderSubgroup σ).subtype) :=
    ⟨B.subgroupOf (offenderSubgroup σ), (hB.isOffender σ).subgroupOf σ hBN⟩
  exact ⟨hs.of_ff _ hff, moved_component_in_offenderSubgroup σ hf hK hB hcomm⟩

end CFSG.Quasithin.Chapter13.Section07
