module

public import CFSG.Quasithin.Chapter13.Section07.CoreImage
public import Theory.SpecificGroups.SymmetricSix.BinaryFlags.NaturalResidualGeneration

/-!
# The actual local seed is generated by its point residual

The two-residual of the literal point normalizer maps onto the residual
of the natural point stabilizer. The full perpendicular calculation,
including the fixed line, therefore gives V₃=[V₃,L₁]. Normality of a
containing component then gives U_H=[U_H,K] by conjugate generation.
The natural action and the original Sylow flag suffice; abelianness of
the full V-span is not used.

Source: Aschbacher–Smith, 13.7.5(2), printed p.938.
-/

@[expose] public section
open Subgroup BinaryPermutation Representation.BinaryOffender
open scoped commutatorElement
namespace CFSG.Quasithin.Chapter13.Section07.ModelExclusions
open Section08.SourceCompletion NaturalAction
open Section08.TransvectionRecognition.Component.ModelExtension
open Section08.ComponentSieve.FieldComponents.LinearThree.Geometry.CoveredProduct.ResidualPlacement
open Theory.SpecificGroups.SymmetricSix.BinaryFlags.NaturalPairing
variable {G : Type*} [Group G] [Finite G]
  {T : Sylow 2 G} {L V V₁ V₂ V₃ M G₁ : Subgroup G}
  (d : NaturalSetup T L V V₁ V₂ V₃ M G₁)
include d

private theorem point_normalizer_image :
    (((L ⊔ (T : Subgroup G)) ⊓ normalizer (V₁ : Set G)).subgroupOf
      (L ⊔ (T : Subgroup G))).map (permutation d) =
      (permutation d).range ⊓ subspaceStabilizer (naturalRepresentation (Fin 6)) (image d V₁) := by
  ext a
  constructor
  · rintro ⟨g, hg, rfl⟩
    exact ⟨⟨g, rfl⟩, (permutation_stabilizes_iff d V₁
      (d.line_le_plane.trans (d.plane_le_seed.trans d.seed_le)) g).mpr hg.2⟩
  · rintro ⟨⟨g, rfl⟩, hg⟩
    exact ⟨g, ⟨g.property, (permutation_stabilizes_iff d V₁
      (d.line_le_plane.trans (d.plane_le_seed.trans d.seed_le)) g).mp hg⟩, rfl⟩

/-- The original L₁ maps onto the actual residual, without any nonabelian-span assumption. -/
theorem point_residual_image :
    ((sourceOne L T V₁).subgroupOf (L ⊔ (T : Subgroup G))).map (permutation d) =
      residual ((permutation d).range ⊓
        subspaceStabilizer (naturalRepresentation (Fin 6)) (image d V₁)) := by
  let P := (L ⊔ (T : Subgroup G)) ⊓ normalizer (V₁ : Set G)
  have he : (residual P).subgroupOf (L ⊔ (T : Subgroup G)) =
      residual (P.subgroupOf (L ⊔ (T : Subgroup G))) := by
    apply map_injective (L ⊔ (T : Subgroup G)).subtype_injective
    rw [map_subgroupOf_eq_of_le ((residual_le P).trans inf_le_left)]
    change residual P = ((pResidual 2 (P.subgroupOf (L ⊔ (T : Subgroup G)))).map
      (P.subgroupOf (L ⊔ (T : Subgroup G))).subtype).map (L ⊔ (T : Subgroup G)).subtype
    rw [map_embedded_pResidual, map_subgroupOf_eq_of_le (show P ≤ L ⊔ (T : Subgroup G) from inf_le_left)]
    rfl
  change ((residual P).subgroupOf _).map _ = _
  rw [he]
  change ((pResidual 2 (P.subgroupOf _)).map (P.subgroupOf _).subtype).map _ = _
  rw [map_embedded_pResidual]
  change Section08.ComponentSieve.FieldComponents.LinearThree.Geometry.CoveredProduct.ResidualPlacement.residual
    ((P.subgroupOf (L ⊔ (T : Subgroup G))).map (permutation d)) = _
  rw [point_normalizer_image d]

/-- L₁ preserves the original seed, by the invariant natural pairing. -/
theorem point_residual_normalizes_seed :
    sourceOne L T V₁ ≤ normalizer (V₃ : Set G) := by
  intro x hx
  let g : (L ⊔ (T : Subgroup G) : Subgroup G) :=
    ⟨x, ((one_le L T V₁).trans inf_le_left) hx⟩
  apply (permutation_stabilizes_iff d V₃ d.seed_le g).mp
  rw [seed_perpendicular d]
  apply stabilizer_le_orthogonal_stabilizer (image d V₁)
  exact (permutation_stabilizes_iff d V₁
    (d.line_le_plane.trans (d.plane_le_seed.trans d.seed_le)) g).mpr
      (((one_le L T V₁).trans inf_le_right) hx)

/-- Full generation includes the fixed line V₁, not just generation modulo it. -/
theorem seed_commutator_point_residual :
    ⁅V₃, sourceOne L T V₁⁆ = V₃ := by
  have hdisp : subspaceCommutator (naturalRepresentation (Fin 6)) (image d V₃)
      (((sourceOne L T V₁).subgroupOf (L ⊔ (T : Subgroup G))).map (permutation d)) ≤
      image d ⁅V₃, sourceOne L T V₁⁆ := by
    apply Submodule.span_le.mpr
    rintro _ ⟨a, ⟨g, hg, rfl⟩, w, hw, rfl⟩
    obtain ⟨v, hv, rfl⟩ := (mem_image d V₃ w).mp hw
    let c : V := V.normalizerMonoidHom ⟨g.val, d.normalizes_V g.property⟩ v * v⁻¹
    refine (mem_image d _ _).mpr ⟨c, ?_, ?_⟩
    · rw [commutator_comm]
      exact commutator_mem_commutator hg hv
    · change (d.coordinate
        (V.normalizerMonoidHom ⟨g.val, d.normalizes_V g.property⟩ v * v⁻¹)).toAdd = _
      rw [map_mul, map_inv, toAdd_mul, toAdd_inv, ← sub_eq_add_neg, conjugation d]
  have hgen := Theory.SpecificGroups.SymmetricSix.BinaryFlags.NaturalResidualGeneration.point_residual_generates
    (permutation d).range (alternating_le_range d) (image d V₁)
    (image_dim d V₁ (d.line_le_plane.trans (d.plane_le_seed.trans d.seed_le)) 1 d.line_card)
  change form.orthogonal (image d V₁) ≤
    subspaceCommutator (naturalRepresentation (Fin 6)) (form.orthogonal (image d V₁))
      (residual ((permutation d).range ⊓
        subspaceStabilizer (naturalRepresentation (Fin 6)) (image d V₁))) at hgen
  rw [← seed_perpendicular d, ← point_residual_image d] at hgen
  apply le_antisymm
    (le_normalizer_iff_commutator_le_left.mp (point_residual_normalizes_seed d))
  intro v hv
  obtain ⟨w, hw, he⟩ := (mem_image d _ _).mp
    ((hgen.trans hdisp) ((mem_image d V₃ _).mpr ⟨⟨v, d.seed_le hv⟩, hv, rfl⟩))
  have he' : w = ⟨v, d.seed_le hv⟩ := d.coordinate.injective he
  simpa only [he'] using hw

/-- The literal 13.7.5(2) consumer once the source component normality is supplied. -/
theorem span_commutator_of_containing_normal_component {H K : Subgroup G}
    (hKH : K ≤ H) (hKn : H ≤ normalizer (K : Set G))
    (hL₁K : sourceOne L T V₁ ≤ K) :
    ⁅Section08.Source.UH H V₃, K⁆ = Section08.Source.UH H V₃ := by
  have hUH : H ≤ normalizer (Section08.Source.UH H V₃ : Set G) :=
    le_normalizer_conjugateSpanBy V₃ H
  apply le_antisymm (le_normalizer_iff_commutator_le_left.mp (hKH.trans hUH))
  apply conjugateSpanBy_le
  · exact (seed_commutator_point_residual d).symm.le.trans
      (commutator_mono (le_conjugateSpanBy V₃ H) hL₁K)
  · intro x hx
    rw [mem_normalizer_iff_map_conj_eq, map_commutator,
      mem_normalizer_iff_map_conj_eq.mp (hUH hx),
      mem_normalizer_iff_map_conj_eq.mp (hKn hx)]

end CFSG.Quasithin.Chapter13.Section07.ModelExclusions
