module
public import CFSG.Quasithin.Chapter13.Section07.ModelExclusions.Theta
public import Theory.GroupTheory.PCoreRestriction
/-!
# Cubic generation of two-perfect local subgroups

Restricting O₂(L₁) to X lands in O₂(X). Thus every two-perfect subgroup
X≤L₁ retains an exponent-three quotient by its own two-core and is
generated by actual cubics. This includes the covered L₁,+ without
assuming a desired cubic-generation conclusion.

Source: Aschbacher–Smith, proof of13.7.5, printed p.938.
-/

@[expose] public section
open Subgroup
namespace CFSG.Quasithin.Chapter13.Section07.ModelExclusions
open Section08.SourceCompletion
open Section08.TransvectionRecognition.Component.ModelExtension
open Section08.ComponentSieve.FieldComponents.LinearThree.Geometry.CoveredProduct.ResidualPlacement
variable {G : Type*} [Group G] [Finite G]
  {T : Sylow 2 G} {L V V₁ V₂ V₃ M G₁ : Subgroup G}
  (d : NaturalSetup T L V V₁ V₂ V₃ M G₁)
include d

/-- Every two-perfect subgroup of the actual L₁ is generated by its cubics. -/
theorem point_subgroup_cubic_generated {X : Subgroup G}
    (hX : X ≤ sourceOne L T V₁) (hpX : IsPPerfect 2 X) :
    closure {x : G | x ∈ X ∧ orderOf x = 3} = X := by
  have hcube (x : X ⧸ pCore 2 X) : x ^ 3 = 1 := by
    obtain ⟨y, rfl⟩ := QuotientGroup.mk'_surjective (pCore 2 X) x
    rw [← map_pow]
    apply (QuotientGroup.eq_one_iff _).mpr
    have hq := point_residual_quotient_cube d
      (QuotientGroup.mk' (pCore 2 (sourceOne L T V₁)) (inclusion hX y))
    rw [← map_pow] at hq
    have hc := (QuotientGroup.eq_one_iff _).mp hq
    have hm := inf_pCoreIn_le_of_le 2 hX
      (show (y.val ^ 3) ∈ X ⊓ (sourceOne L T V₁).pCoreIn 2 from
        ⟨X.pow_mem y.property 3, ⟨(inclusion hX y) ^ 3, hc, rfl⟩⟩)
    obtain ⟨z, hz, he⟩ := hm
    have he' : z = y ^ 3 := Subtype.ext he
    exact he' ▸ hz
  have h := cubic_closure_eq_top_of_twoPerfect_of_quotient_cube hpX hcube
  have hm := congrArg (map X.subtype) h
  rw [MonoidHom.map_closure, ← MonoidHom.range_eq_map, range_subtype] at hm
  convert hm using 1
  congr 1
  ext x
  constructor
  · rintro ⟨hx, ho⟩
    exact ⟨⟨x,hx⟩, (X.orderOf_coe ⟨x,hx⟩).symm.trans ho, rfl⟩
  · rintro ⟨x, hx, rfl⟩
    exact ⟨x.property, (X.orderOf_coe x).trans hx⟩

end CFSG.Quasithin.Chapter13.Section07.ModelExclusions
