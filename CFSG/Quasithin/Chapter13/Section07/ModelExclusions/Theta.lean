module

public import CFSG.Quasithin.Chapter13.Section07.ModelExclusions.NaturalModels
public import CFSG.Quasithin.Chapter13.Section07.ModelExclusions.SeedGeneration
public import CFSG.Quasithin.Chapter13.Section08.SourceCompletion.NormalizerThetaSource
public import CFSG.Quasithin.ChapterA.Section02.SourceAssembly.Complete
public import Theory.GroupTheory.PResidual.CubicGenerationModuloTwoCore

/-!
# The original point-overlap theta identity

The local point residual has quotient of exponent three in both the
ordinary and covered cases. Two-perfectness makes it generated by its
cubic elements. Conversely, a cubic in H∩M lies in L by theta(M)=L and
normalizes V₁, so lies in the actual point residual. This proves the
13.7.3(9) theta identity without an added theta-intersection hypothesis.
The genuine earlier maximal-local hypothesis is retained explicitly.

Source: Aschbacher–Smith, 13.7.3(9), pp.936–937, used in 13.7.5, p.938.
-/

public section
open Subgroup BinaryPermutation
namespace CFSG.Quasithin.Chapter13.Section07.ModelExclusions
open Section08.SourceCompletion NaturalAction
open Section08.TransvectionRecognition.Component.ModelExtension
open Section08.ComponentSieve.FieldComponents.LinearThree.Geometry.CoveredProduct.ResidualPlacement
open Section08.ComponentSieve.AlternatingAndLinear.LinearReduction.Parabolics
open NaturalModels
universe u
variable {G : Type u} [Group G] [Finite G]
  {T : Sylow 2 G} {L V V₁ V₂ V₃ M G₁ : Subgroup G}
  (d : NaturalSetup T L V V₁ V₂ V₃ M G₁)
include d

/-- Both genuine local quotients have exponent three, including the covered nine. -/
theorem point_residual_quotient_cube (x : sourceOne L T V₁ ⧸ pCore 2 (sourceOne L T V₁)) :
    x ^ 3 = 1 := by
  rcases quotient_alternatives d with ⟨e, he⟩ | ⟨e, he⟩
  · obtain ⟨a⟩ := ordinary_natural d e he
    have hc := OrdinarySource.source_residual_quotient_card a (sourceOne L T V₁) rfl
    simpa only [hc] using (pow_card_eq_one' (x := x))
  · obtain ⟨a⟩ := covered_natural d e he
    exact a.one_quotient_cube (CoverFactorization.source_factorization a) x

/-- Cubic elements generate the actual local point residual in both source cases. -/
theorem point_residual_cubic_generated :
    closure {x : G | x ∈ sourceOne L T V₁ ∧ orderOf x = 3} = sourceOne L T V₁ := by
  have h : Subgroup.closure {x : sourceOne L T V₁ | orderOf x = 3} = ⊤ :=
    cubic_closure_eq_top_of_twoPerfect_of_quotient_cube
      (residual_isPPerfect (parabolic L T V₁)) (point_residual_quotient_cube d)
  have hm := congrArg (map (sourceOne L T V₁).subtype) h
  rw [MonoidHom.map_closure (sourceOne L T V₁).subtype {x | orderOf x = 3},
    ← MonoidHom.range_eq_map, range_subtype] at hm
  convert hm using 1
  congr 1
  ext x
  constructor
  · rintro ⟨hx, ho⟩
    exact ⟨⟨x, hx⟩, ((sourceOne L T V₁).orderOf_coe ⟨x, hx⟩).symm.trans ho, rfl⟩
  · rintro ⟨y, hy, rfl⟩
    exact ⟨y.property, ((sourceOne L T V₁).orderOf_coe y).trans hy⟩

/-- The exact theta(H∩M)=L₁ equality of 13.7.3(9), under its genuine source setup. -/
theorem theta_intersection
    (h : Chapter12.Section02.Hypothesis1221 KnownSimple.IsKnownSimple T L)
    {H : Subgroup G} (hH : H ∈ Section08.Source.Hz (sourceOne L T V₁) T G₁ M) :
    closure {x : G | x ∈ H ⊓ M ∧ orderOf x = 3} = sourceOne L T V₁ := by
  have htheta := d.source_theta_normalizer h
    (fun X _ _ => ChapterA.Section02.theoremA_knownSimple (G := X))
    (fun X _ _ => ChapterA.Section02.theoremC_knownSimple (G := X))
  have hL₁H : sourceOne L T V₁ ≤ H := le_sup_left.trans hH.1.2
  have hL₁M : sourceOne L T V₁ ≤ M := by
    apply ((one_le L T V₁).trans inf_le_left).trans
    rw [d.local_normalizer]
    exact sup_le L.le_normalizer d.normalizes_L
  apply le_antisymm
  · apply (closure_le _).mpr
    rintro x ⟨hx, ho⟩
    have hxL : x ∈ L := htheta ▸ subset_closure ⟨hx.2, ho⟩
    have hxN : x ∈ normalizer (V₁ : Set G) := d.first_normalizer ▸ hH.2.1 hx.1
    let y : parabolic L T V₁ := ⟨x, mem_sup_left hxL, hxN⟩
    exact ⟨y, mem_pResidual_of_orderOf_coprime (by
      have hy : orderOf y = 3 := ((parabolic L T V₁).orderOf_coe y).symm.trans ho
      rw [hy]
      decide), rfl⟩
  · rw [← point_residual_cubic_generated d]
    apply Subgroup.closure_mono
    rintro x ⟨hx, ho⟩
    exact ⟨⟨hL₁H hx, hL₁M hx⟩, ho⟩

end CFSG.Quasithin.Chapter13.Section07.ModelExclusions
