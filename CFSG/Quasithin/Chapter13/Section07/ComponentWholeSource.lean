module
public import CFSG.Quasithin.Chapter13.Section07.ComponentSeedNormality
public import Theory.Representation.BinaryConjugationSection.InvariantPreimage
/-!
# The selected component generates the entire original plus module

The selected component is H-normal by the original seed theorem. Its
moved subspace therefore has an H-invariant full preimage in U_H. A
minimal plane offender has nonzero displacement inside both that moved
space and the seed plane. F.9 seed irreducibility puts all of V₃ in the
preimage, and U_H=⟨V₃ᴴ⟩ then makes the moved space the whole plus module.

The final theorem constructs all four13.7.15 conclusions on the same
conjugator, section, offender and component. Its only unproved inputs are
the genuine earlier F.9, span and faithful-plus-kernel premises.
Source: Aschbacher–Smith13.7.15(4), printed p.944.
-/
public section
open Subgroup Representation Representation.BinaryOffender Theory.GroupTheory
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter13.Section07
open Section08.SourceCompletion ChapterF.Section09.Setup ChapterB.QuasisimpleSource
variable {G : Type*} [Group G] [Finite G]
private theorem whole_plus_of_normal_component
    {D : ChapterF.Section09.Setup G} (h : D.Hypothesis)
    {W : Type*} [AddCommGroup W] [Module (ZMod 2) W] [FiniteDimensional (ZMod 2) W]
    (σ : Representation (ZMod 2) (D.H ⧸ pCore 2 D.H) W)
    (s : BinaryConjugationSection D.H D.UH
      (D.UH ⊓ centralizer (D.QH : Set G))
      (σ.comp (QuotientGroup.mk' (pCore 2 D.H))))
    (hf : Function.Injective σ)
    {B : Subgroup (D.H ⧸ pCore 2 D.H)} (hB : IsMinimalBestOffender σ B)
    {K : Subgroup D.H} (hn : K.Normal)
    (hK : IsComponent (D.H ⧸ pCore 2 D.H) (K.map (QuotientGroup.mk' (pCore 2 D.H))))
    (hc : ⁅K.map (QuotientGroup.mk' (pCore 2 D.H)),B⁆ = K.map (QuotientGroup.mk' (pCore 2 D.H)))
    (hd : Module.finrank (ZMod 2) (s.imageSpace D.Vplus) = 2)
    (hm : subspaceCommutator σ ⊤ B ≤ s.imageSpace D.Vplus) :
    subspaceCommutator σ ⊤ (K.map (QuotientGroup.mk' (pCore 2 D.H))) = ⊤ := by
  let π := QuotientGroup.mk' (pCore 2 D.H)
  let J := K.map π
  let I := subspaceCommutator σ ⊤ J
  let : J.Normal := Subgroup.Normal.map hn π (QuotientGroup.mk'_surjective _)
  let : IsQuasisimple J := hK.2
  let : IsSimpleGroup (J ⧸ center J) := IsQuasisimple.simple
  let : Nontrivial J := (QuotientGroup.mk'_surjective (center J)).nontrivial
  have hJne : J≠⊥ := (Subgroup.nontrivial_iff_ne_bot J).mp inferInstance
  have hBI : subspaceCommutator σ ⊤ B ≤ I := hB.moved_le_moved_perfect σ hf hJne
    ((Submodule.finrank_mono hm).trans_eq hd) hc
  have hnot := moved_not_fixed_of_perfect_commutator σ hf hJne hc
  have hI : (⊤ : Subgroup (D.H ⧸ pCore 2 D.H)) ≤ subspaceStabilizer σ I :=
    subspaceCommutator_invariant_normalizer σ
      (le_subspaceStabilizer σ ⊤ (by intros; trivial)) (by rw [J.normalizer_eq_top])
  let P : Subrepresentation (σ.comp π) := {
    toSubmodule := I
    apply_mem_toSubmodule := fun a v hv => (hI (mem_top (π a)) v).2 hv }
  let R := s.invariantPreimage P
  have hHR : D.H ≤ normalizer (R:Set G) := s.invariantPreimage_normalized P
  have hz : D.V₁ ≤ D.UH ⊓ centralizer (D.QH:Set G) :=
    le_inf (h.point_lt.le.trans (le_conjugateSpanBy D.Vplus D.H))
      (le_centralizer_iff.mp ((pCoreIn_le 2 D.H).trans h.H_centralizes))
  have hp : D.V₁ ≤ R⊓D.Vplus :=
    le_inf (hz.trans (s.kernel_le_invariantPreimage P)) h.point_lt.le
  have hr : D.L₁⊔(D.T:Subgroup G) ≤ normalizer (R⊓D.Vplus:Set G) :=
    (le_inf (h.local_le.trans hHR) h.local_normalizes).trans inf_normalizer_le_normalizer_inf
  have hseed : D.Vplus ≤ R := by
    rcases h.irreducible (R⊓D.Vplus) hp inf_le_right hr with hzero | he
    · exfalso
      apply hnot
      intro v hv
      obtain ⟨u,hu,he⟩ := (s.mem_imageSpace_iff D.Vplus v).mp (hm hv)
      have hur : (u:G)∈R := (s.mem_invariantPreimage P u).mpr
        ⟨u.property, by change (s.coordinates u).toAdd∈I; rw [he]; exact hBI hv⟩
      have hup : (u:G)∈D.V₁ := hzero ▸ (show (u:G)∈R⊓D.Vplus from ⟨hur,hu⟩)
      have hcoord := (s.coordinates_eq_one_iff u).mpr (hz hup)
      have hv0 : v=0 := he.symm.trans (congrArg Multiplicative.toAdd hcoord)
      rw [hv0]
      exact (fixedSpace σ J).zero_mem
    · exact he.ge.trans inf_le_left
  have hUR : D.UH ≤ R := conjugateSpanBy_le hseed hHR
  apply top_unique
  intro v _
  obtain ⟨u,hu⟩ := s.onto (Multiplicative.ofAdd v)
  have huv := ((s.mem_invariantPreimage P u).mp (hUR u.property)).choose_spec
  change (s.coordinates u).toAdd∈I at huv
  rwa [hu] at huv

variable {T : Sylow 2 G} {L V V₁ V₂ V₃ M G₁ H : Subgroup G}
  (d : NaturalSetup T L V V₁ V₂ V₃ M G₁)
include d
/-- Original13.7.15(4): the literal plus module is generated by the
selected component, with its normality supplied by the source seed action. -/
theorem source_plus_component_whole
    (h : (ConjugateIntersections.sourceSetup T L V V₃ V₁ H).Hypothesis)
    (hU : IsMulCommutative (Section08.Source.UH H V₃))
    (hV : ¬ IsMulCommutative (Section08.Source.VH H V))
    (hne : ⁅V₃,G₁.pCoreIn 2⁆ ≠ ⊥)
    (g : (L ⊔ (T : Subgroup G) : Subgroup G))
    (hs : (QuotientGroup.mk' (pCore 2 (L ⊔ (T : Subgroup G) : Subgroup G)) g)^2 = 1)
    (hout : ¬ conjugate V₁ (g : G) ≤ Section08.Source.UH H V₃)
    {W : Type*} [AddCommGroup W] [Module (ZMod 2) W] [FiniteDimensional (ZMod 2) W]
    (σ : Representation (ZMod 2) (H ⧸ pCore 2 H) W)
    (s : Representation.BinaryConjugationSection H (Section08.Source.UH H V₃)
      ((Section08.Source.UH H V₃) ⊓ centralizer (H.pCoreIn 2 : Set G))
      (σ.comp (QuotientGroup.mk' (pCore 2 H))))
    (B : Subgroup (H ⧸ pCore 2 H)) (hB : IsMinimalBestOffender σ B)
    (hBA : B ≤ ((conjugate (Section08.Source.VH H V) (g : G) ⊓
      (L ⊔ (T : Subgroup G) : Subgroup G).pCoreIn 2).subgroupOf H).map
        (QuotientGroup.mk' (pCore 2 H)))
    (K : Subgroup H) (hKC : K.IsCComponent) (hK : IsComponent (H ⧸ pCore 2 H)
      (K.map (QuotientGroup.mk' (pCore 2 H))))
    (hk : PlusAction.kernel (ConjugateIntersections.sourceSetup T L V V₃ V₁ H) = H.pCoreIn 2)
    (hcomm : ⁅K.map (QuotientGroup.mk' (pCore 2 H)),B⁆ = K.map (QuotientGroup.mk' (pCore 2 H))) :
    subspaceCommutator σ ⊤ (K.map (QuotientGroup.mk' (pCore 2 H))) = ⊤ := by
  have hp := source_plus_seed_plane d h hU hV hne g hs hout σ s B hBA
  have hn := source_plus_component_normal d h hU hV hne g hs hout
    σ s B hB hBA K hKC hK hk hcomm
  exact whole_plus_of_normal_component h σ s
    (source_plus_faithful_of_kernel_eq σ s hk) hB hn hK hcomm hp.1 hp.2

/-- All four original13.7.15 clauses on the same constructed conjugator,
coordinates, offender and component. Only the genuine earlier inputs remain. -/
theorem exists_source_whole_component_irrPlus_and_actor
    (h : (ConjugateIntersections.sourceSetup T L V V₃ V₁ H).Hypothesis)
    (hU : IsMulCommutative (Section08.Source.UH H V₃))
    (hV : ¬ IsMulCommutative (Section08.Source.VH H V))
    (hne : ⁅V₃,G₁.pCoreIn 2⁆ ≠ ⊥)
    (hk : PlusAction.kernel (ConjugateIntersections.sourceSetup T L V V₃ V₁ H) = H.pCoreIn 2) :
    ∃ g : L,
      (QuotientGroup.mk' (pCore 2 (L ⊔ (T : Subgroup G) : Subgroup G))
        (inclusion le_sup_left g))^2 = 1 ∧
      V ≤ V₃ ⊔ conjugate V₁ (g : G) ∧
      ¬ conjugate V₁ (g : G) ≤ Section08.Source.UH H V₃ ∧
      let U := Section08.Source.UH H V₃
      let U₀ := U ⊓ centralizer (H.pCoreIn 2 : Set G)
      let Q := (L ⊔ (T : Subgroup G) : Subgroup G).pCoreIn 2
      let A := conjugate (Section08.Source.VH H V) (g : G) ⊓ Q
      let π := QuotientGroup.mk' (pCore 2 H)
      ∃ hE : IsElementaryAbelian 2 U, letI := hE;
        ∃ (σ : Representation (ZMod 2) (H ⧸ pCore 2 H) (Additive (U ⧸ U₀.subgroupOf U)))
          (s : Representation.BinaryConjugationSection H U U₀ (σ.comp π))
          (B : Subgroup (H ⧸ pCore 2 H)) (K : Subgroup H),
          Function.Injective σ ∧ IsMinimalBestOffender σ B ∧
          B ≤ (A.subgroupOf H).map π ∧
          B ≤ centralizer (fittingSubgroup (H ⧸ pCore 2 H) : Set (H ⧸ pCore 2 H)) ∧
          K.IsCComponent ∧ IsComponent (H ⧸ pCore 2 H) (K.map π) ∧
          B ≤ normalizer (K.map π : Set (H ⧸ pCore 2 H)) ∧
          ⁅K.map π,B⁆ = K.map π ∧
          Module.finrank (ZMod 2) (s.imageSpace V₃) = 2 ∧
          subspaceCommutator σ ⊤ B ≤ s.imageSpace V₃ ∧
          IsIrrPlus σ (K.map π) (subspaceCommutator σ ⊤ (K.map π)) ∧
          SmallMoved.ActorList (K.map π) ∧ K.Normal ∧
          subspaceCommutator σ ⊤ (K.map π) = ⊤ := by
  obtain ⟨g,hs,hspan,hout,hE,σ,s,B,K,hf,hB,hBA,hc,hK,hKs,hn,hcomm,hd,hm,hi,ha,hKn⟩ :=
    exists_source_normal_component_irrPlus_and_actor d h hU hV hne hk
  let := hE
  let : Finite (Additive (Section08.Source.UH H V₃ ⧸
      (Section08.Source.UH H V₃ ⊓ centralizer (H.pCoreIn 2 : Set G)).subgroupOf
        (Section08.Source.UH H V₃))) := inferInstance
  have hwhole := whole_plus_of_normal_component h σ s hf hB hKn hKs hcomm hd hm
  exact ⟨g,hs,hspan,hout,hE,σ,s,B,K,hf,hB,hBA,hc,hK,hKs,hn,hcomm,hd,hm,hi,ha,hKn,hwhole⟩
end CFSG.Quasithin.Chapter13.Section07
