omit [Finite G] in
private theorem simple_component_quotient_quasisimple
    (J : Subgroup H) (hJ : J.IsCComponent) (hs : IsSimpleGroup (J ⧸ pCore 2 J)) :
    IsQuasisimple (J ⧸ pCore 2 J) := by
  let := hs
  let : Group.IsPerfect J := hJ.perfect
  let : Group.IsPerfect (J ⧸ pCore 2 J) :=
    Group.IsPerfect.ofSurjective (QuotientGroup.mk'_surjective _)
  have hz : center (J ⧸ pCore 2 J) = ⊥ := by
    rcases (inferInstance : (center (J ⧸ pCore 2 J)).Normal).eq_bot_or_eq_top with hz | hz
    · exact hz
    · exact (Group.IsPerfect.not_isMulCommutative (J ⧸ pCore 2 J)
        (center_eq_top_iff.mp hz)).elim
  exact { toIsPerfect := inferInstance
          simple := ((QuotientGroup.quotientMulEquivOfEq hz).trans QuotientGroup.quotientBot).isSimpleGroup }

private theorem actual_component_offender_kind
    (h : (ConjugateIntersections.sourceSetup T L V V₃ V₁ H).Hypothesis)
    (J : Subgroup H) (hJ : J.IsCComponent) (hs : IsSimpleGroup (J ⧸ pCore 2 J)) :
    let K := J.map H.subtype
    let X := K ⊔ ((ConjugateIntersections.sourceSetup T L V V₃ V₁ H).L₁ ⊔ (T : Subgroup G))
    (K.subgroupOf X).IsCComponent ∧ IsQuasisimple (K ⧸ pCore 2 K) := by
  let K := J.map H.subtype
  let X := K ⊔ ((ConjugateIntersections.sourceSetup T L V V₃ V₁ H).L₁ ⊔ (T : Subgroup G))
  have hKH : K ≤ H := map_subtype_le J
  have hcomp : (K.subgroupOf H).IsCComponent := by
    change (J.map H.subtype).comap H.subtype |>.IsCComponent
    rw [comap_map_eq_self_of_injective H.subtype_injective]
    exact hJ
  let e := J.equivMapOfInjective H.subtype H.subtype_injective
  let eQ := QuotientGroup.congr _ _ e (pCore_map_iso 2 e)
  let : IsQuasisimple (J ⧸ pCore 2 J) := simple_component_quotient_quasisimple J hJ hs
  exact ⟨hcomp.subgroupOf_of_le le_sup_left (sup_le hKH h.local_le),
    IsQuasisimple.of_mulEquiv eQ⟩

