/-!
# Offenders on the original reduced kernel module

The point radical R₁=O₂(L₁T) is Sylow in KR₁: the intersection T∩K
is normalized by L₁T because [K,L₁]≤O₂(K), so it lies in R₁.
Apply B.2.10(2) to the reduced elementary module in KR₁. Its Baumann
alternative would put K in the bounded normalizer of B(R₁), contradicting
local escape. The remaining alternative gives nontrivial Thompson action and places K⁺
in the subgroup generated by best offenders. Equivariant restriction transports this containment to the
literal action of E=K⁺R₁⁺ on the selected module in K(L₁T).

The cubic and primitive C-component applications use the actual source
subgroups and quotient maps. The genuine earlier-source Baumann normalizer
bound remains explicit; no module-classification premise is used.

Source: Aschbacher--Smith B.2.10(2) and 13.7.4(1), printed pp.937--938.
-/

public section
open Subgroup Theory.GroupTheory Stellmacher Representation Representation.BinaryOffender
open CFSG.Quasithin.ChapterB
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter13.Section07.PlusAction.Original
variable {G D : Type*} [Group G] [Finite G] [Group D] [Finite D]

private theorem image_le_offenders_of_baumann_escape
    (U R : Subgroup G) [U.Normal] [IsElementaryAbelian 2 U]
    (q : G →* D) (hq : Function.Surjective q)
    (hker : q.ker = centralizer (U : Set G))
    (S : Sylow 2 G) (hR : R = (S : Subgroup G))
    (hcore : pCore 2 D = ⊥) (K : Subgroup G)
    (hK : (K.IsCComponent ∧ IsQuasisimple (K ⧸ pCore 2 K)) ∨
      Nonempty ((K ⧸ pCore 2 K) ≃* Multiplicative (ZMod 3)))
    (hmove : ⁅U,K⁆ ≠ ⊥)
    (hprod : ∀ g : G, ∃ k ∈ K, ∃ t ∈ (S : Subgroup G), k*t=g)
    (hescape : baumann R ≠ baumann (pCore 2 G)) :
    (¬ elementaryAbelianMaxJ R ≤ q.ker) ∧
      K.map q ≤ offenderSubgroup
        (NormalElementaryQuotient.representation U q hq hker) := by
  have hQR : pCore 2 G ≤ R := hR.symm ▸ (pCore_isPGroup (p := 2) (G := G)).le_sylow_of_normal S
  obtain ⟨_,hQeq,_,halt⟩ := ChapterB.lemma_B_2_10_two U R q hq hker S hQR
    hR.le hcore K hK hmove hprod
  rcases halt with hbad | hgen
  · exact (hescape hbad).elim
  have hJ : ¬ elementaryAbelianMaxJ R ≤ q.ker := by
    intro hJ
    have hVR : U ≤ R := (show U ≤ pCore 2 G from
      le_sSup ⟨inferInstance,IsElementaryAbelian.isPGroup 2 U⟩).trans hQR
    have hc := ChapterB.lemma_B_2_10_centralizing U R hVR hQR
      hQeq (by simpa only [thompsonJ_zero,hker] using hJ)
    exact hescape hc.2.1
  refine ⟨hJ,?_⟩
  have hs := (ChapterB.lemma_B_2_10_relative U R
    ((show U ≤ pCore 2 G from le_sSup
      ⟨inferInstance,IsElementaryAbelian.isPGroup 2 U⟩).trans hQR)
    q hq hker hJ).2.1
  rw [hgen]
  refine (map_subtype_le _).trans ?_
  unfold generatedBy offenderSubgroup
  exact iSup_le fun A => iSup_le fun hA =>
    le_iSup_of_le A (le_iSup_of_le ⟨hs.2.1 A hA.1,le_top⟩ le_rfl)


omit [Finite G] in
private theorem centralizer_restricted (U Y : Subgroup G) (hUY : U ≤ Y) :
    (centralizer (U : Set G)).subgroupOf Y = centralizer (U.subgroupOf Y : Set Y) := by
  ext g
  constructor
  · intro hg u hu
    exact Subtype.ext (hg u hu)
  · intro hg u hu
    exact congrArg Subtype.val (hg ⟨u,hUY hu⟩ hu)

omit [Finite D] in
private theorem restricted_representation_offenders
    (U Y : Subgroup G) [U.Normal] [IsElementaryAbelian 2 U]
    [IsElementaryAbelian 2 (U.subgroupOf Y)] (hUY : U ≤ Y)
    (q : G →* D) (hq : Function.Surjective q)
    (hker : q.ker = centralizer (U : Set G))
    (A : Subgroup (Y.map q))
    (hA : let qY := q.subgroupMap Y
      let hkY : qY.ker = centralizer (U.subgroupOf Y : Set Y) :=
        (ker_subgroupMap (f := q) (H := Y)).trans ((congrArg (fun N : Subgroup G => N.subgroupOf Y) hker).trans
          (centralizer_restricted U Y hUY))
      A ≤ offenderSubgroup (NormalElementaryQuotient.representation (U.subgroupOf Y)
        qY (q.subgroupMap_surjective Y) hkY)) :
    A ≤ offenderSubgroup
      ((NormalElementaryQuotient.representation U q hq hker).comp (Y.map q).subtype) := by
  let qY := q.subgroupMap Y
  have hkY : qY.ker = centralizer (U.subgroupOf Y : Set Y) :=
    (ker_subgroupMap (f := q) (H := Y)).trans ((congrArg (fun N : Subgroup G => N.subgroupOf Y) hker).trans
      (centralizer_restricted U Y hUY))
  let ρ := NormalElementaryQuotient.representation (U.subgroupOf Y) qY
    (q.subgroupMap_surjective Y) hkY
  let σ := (NormalElementaryQuotient.representation U q hq hker).comp (Y.map q).subtype
  let e := subgroupOfEquivOfLe hUY
  let b : Additive (U.subgroupOf Y) ≃ₗ[ZMod 2] Additive U :=
    LinearEquiv.ofBijective (e.toMonoidHom.toAdditive.toZModLinearMap 2) e.bijective
  have he : ∀ g v, b (ρ g v) = σ g (b v) := by
    intro g v
    obtain ⟨y,rfl⟩ := q.subgroupMap_surjective Y g
    apply Additive.toMul.injective
    apply Subtype.ext
    change (((ρ (qY y) v).toMul : Y) : G) =
      ((NormalElementaryQuotient.representation U q hq hker (q (y : G)) (b v)).toMul : G)
    have hh := congrArg Subtype.val
      (NormalElementaryQuotient.representation_apply (U.subgroupOf Y) qY
        (q.subgroupMap_surjective Y) hkY y v)
    exact hh.trans (NormalElementaryQuotient.representation_apply U q hq hker (y : G) (b v)).symm
  have hle : offenderSubgroup ρ ≤ offenderSubgroup σ := by
    unfold offenderSubgroup generatedBy
    refine iSup_le fun B => iSup_le fun hB => ?_
    have hb := hB.1.map_equivariant ρ σ (MulEquiv.refl _) b he
    have hi : (MulEquiv.refl (Y.map q)).toMonoidHom = MonoidHom.id _ := rfl
    rw [hi,Subgroup.map_id] at hb
    exact IsBestOffender.le_offenderSubgroup σ hb
  exact hA.trans hle

variable {T : Sylow 2 G} {L V V₁ V₃ H : Subgroup G}

/-- The actual point radical is Sylow in the kernel-radical join. -/
theorem source_normal_kernel_sylow_of_commutator
    (h : (ConjugateIntersections.sourceSetup T L V V₃ V₁ H).Hypothesis)
    {K : Subgroup G}
    (hKC : K ≤ kernel (ConjugateIntersections.sourceSetup T L V V₃ V₁ H))
    (hKn : H ≤ normalizer (K : Set G))
    (hcomm : ⁅K,(ConjugateIntersections.sourceSetup T L V V₃ V₁ H).L₁⁆ ≤ K.pCoreIn 2) :
    let F := ConjugateIntersections.sourceSetup T L V V₃ V₁ H
    let R := (F.L₁ ⊔ (T : Subgroup G)).pCoreIn 2
    Chapter1.IsSylowIn 2 R (K ⊔ R) := by
  let F := ConjugateIntersections.sourceSetup T L V V₃ V₁ H
  let P := F.L₁ ⊔ (T : Subgroup G)
  let R := P.pCoreIn 2
  let N := (T : Subgroup G) ⊓ K
  have hKR : K.pCoreIn 2 ≤ R := source_normal_kernel_core_le_point_radical h hKC hKn
  have hRT : R ≤ (T : Subgroup G) := by
    have ht := pCoreIn_le_sylow P (T.subtype (show (T : Subgroup G) ≤ P from le_sup_right))
    simpa only [Sylow.coe_subtype,map_subgroupOf_eq_of_le
      (show (T : Subgroup G) ≤ P from le_sup_right)] using ht
  have hQN : K.pCoreIn 2 ≤ N := le_inf (hKR.trans hRT) (pCoreIn_le 2 K)
  have hLN : F.L₁ ≤ normalizer (N : Set G) :=
    le_normalizer_iff_commutator_le_left.mpr
      ((commutator_mono inf_le_right le_rfl).trans (hcomm.trans hQN))
  have hTN : (T : Subgroup G) ≤ normalizer (N : Set G) :=
    (le_inf (T : Subgroup G).le_normalizer (h.T_le_H.trans hKn)).trans
      inf_normalizer_le_normalizer_inf
  have hNP : N ≤ P := inf_le_left.trans le_sup_right
  have hNR : N ≤ R := le_pCoreIn_of_normalizes
    (T.isPGroup'.to_le inf_le_left) hNP (sup_le hLN hTN)
  obtain ⟨S,hS⟩ := Subgroup.NormalSylowQuotientAction.intersection_sylow T K
    (h.T_le_H.trans hKn)
  have hSR : (S : Subgroup K).map K.subtype ≤ R := by
    rw [hS,subgroupOf_map_subtype,inf_comm]
    simpa only [N,inf_comm] using hNR
  exact IsPGroup.exists_sylow_sup_of_coprime_index K R (isPGroup_pCoreIn 2 P)
    (((pCoreIn_le 2 P).trans h.local_le).trans hKn)
    (S : Subgroup K) S.not_dvd_index hSR


/-- The image of the actual kernel actor is generated by offenders on the
restricted radical join. The Baumann bound is the genuine earlier-source input. -/
theorem source_reduced_kernel_offender_data_of_sylow
    (h : (ConjugateIntersections.sourceSetup T L V V₃ V₁ H).Hypothesis)
    {K M : Subgroup G}
    (hKC : K ≤ kernel (ConjugateIntersections.sourceSetup T L V V₃ V₁ H))
    (hKn : H ≤ normalizer (K : Set G))
    (hsylow : let F := ConjugateIntersections.sourceSetup T L V V₃ V₁ H
      let R := (F.L₁ ⊔ (T : Subgroup G)).pCoreIn 2
      Chapter1.IsSylowIn 2 R (K ⊔ R))
    (hout : ¬ K ≤ M)
    (hB : normalizer (baumann
      (((ConjugateIntersections.sourceSetup T L V V₃ V₁ H).L₁ ⊔
        (T : Subgroup G)).pCoreIn 2) : Set G) ≤ M)
    (hkind : ((K.subgroupOf (K ⊔
      ((ConjugateIntersections.sourceSetup T L V V₃ V₁ H).L₁ ⊔ (T : Subgroup G)))).IsCComponent ∧
      IsQuasisimple (K ⧸ pCore 2 K)) ∨
      Nonempty ((K ⧸ pCore 2 K) ≃* Multiplicative (ZMod 3)))
    (U : Subgroup ↥(K ⊔ ((ConjugateIntersections.sourceSetup T L V V₃ V₁ H).L₁ ⊔
      (T : Subgroup G)))) (hred : IsPReduced 2 U)
    (hU0 : U ≤ (fixedLayer (ConjugateIntersections.sourceSetup T L V V₃ V₁ H)).subgroupOf
      (K ⊔ ((ConjugateIntersections.sourceSetup T L V V₃ V₁ H).L₁ ⊔ (T : Subgroup G))))
    (hne : U ≠ ⊥)
    (hmove : ⁅U,K.subgroupOf (K ⊔
      ((ConjugateIntersections.sourceSetup T L V V₃ V₁ H).L₁ ⊔ (T : Subgroup G)))⁆ = U) :
    let F := ConjugateIntersections.sourceSetup T L V V₃ V₁ H
    let P := F.L₁ ⊔ (T : Subgroup G)
    let X := K ⊔ P
    let := hred.normal
    let := hred.elementary
    let q := QuotientGroup.mk' (centralizer (U : Set X))
    let C := (K.subgroupOf X).map q
    let E := C ⊔ ((P.pCoreIn 2).subgroupOf X).map q
    let ρ := NormalElementaryQuotient.representation U q
      (QuotientGroup.mk'_surjective _) (QuotientGroup.ker_mk' _)
    (¬ elementaryAbelianMaxJ ((P.pCoreIn 2).subgroupOf X) ≤ q.ker) ∧
      C.subgroupOf E ≤ offenderSubgroup (ρ.comp E.subtype) := by
  let F := ConjugateIntersections.sourceSetup T L V V₃ V₁ H
  let P := F.L₁ ⊔ (T : Subgroup G)
  let R := P.pCoreIn 2
  let X := K ⊔ P
  let Y := K ⊔ R
  have hYX : Y ≤ X := sup_le le_sup_left ((pCoreIn_le 2 P).trans le_sup_right)
  let YX := Y.subgroupOf X
  let KX := K.subgroupOf X
  let RX := R.subgroupOf X
  let := hred.normal
  let := hred.elementary
  let q := QuotientGroup.mk' (centralizer (U : Set X))
  let C := KX.map q
  let E := C ⊔ RX.map q
  have hE : E = YX.map q := by
    change (K.subgroupOf X).map q ⊔ (R.subgroupOf X).map q = ((K ⊔ R).subgroupOf X).map q
    rw [subgroupOf_sup (show K ≤ X from le_sup_left)
      (show R ≤ X from (pCoreIn_le 2 P).trans le_sup_right),Subgroup.map_sup]
  have hUY : U ≤ YX := by
    intro u hu
    exact mem_sup_right ((source_fixedLayer_le_point_radical h) (hU0 hu))
  let : IsElementaryAbelian 2 (U.subgroupOf YX) :=
    IsElementaryAbelian.of_injective (subgroupOfEquivOfLe hUY).toMonoidHom
      (subgroupOfEquivOfLe hUY).injective
  let qY := q.subgroupMap YX
  have hkY : qY.ker = centralizer (U.subgroupOf YX : Set YX) :=
    (ker_subgroupMap (f := q) (H := YX)).trans
      ((congrArg (fun N : Subgroup X => N.subgroupOf YX) (QuotientGroup.ker_mk' _)).trans
        (centralizer_restricted U YX hUY))
  have hKH : K ≤ H := hKC.trans (kernel_le_H (D := F))
  have hYn : Y ≤ normalizer (K : Set G) :=
    (sup_le hKH ((pCoreIn_le 2 P).trans h.local_le)).trans hKn
  let : (K.subgroupOf Y).Normal := normal_subgroupOf_of_le_normalizer hYn
  have hKY : KX ≤ YX := by intro k hk; exact mem_sup_left hk
  have hRY : RX ≤ YX := by intro r hr; exact mem_sup_right hr
  let KY := KX.subgroupOf YX
  let RY := RX.subgroupOf YX
  let eY := (subgroupOfEquivOfLe hYX).symm
  obtain ⟨S,hS⟩ := hsylow
  let SY := S.mapSurjective (f := eY.toMonoidHom) eY.surjective
  have hinj : Function.Injective (X.subtype.comp YX.subtype) := by
    intro a b hab
    exact YX.subtype_injective (X.subtype_injective hab)
  have hRYmap : RY.map (X.subtype.comp YX.subtype) = R := by
    rw [←map_map,map_subgroupOf_eq_of_le hRY,map_subgroupOf_eq_of_le
      (show R ≤ X from (pCoreIn_le 2 P).trans le_sup_right)]
  have hSY : RY = (SY : Subgroup YX) := by
    apply map_injective (f := X.subtype.comp YX.subtype) hinj
    change _ = ((S : Subgroup Y).map eY.toMonoidHom).map (X.subtype.comp YX.subtype)
    rw [hRYmap,map_map]
    change R = (S : Subgroup Y).map Y.subtype
    exact hS.symm
  have hcore : pCore 2 (YX.map q) = ⊥ := by
    rw [←hE]
    exact (source_kernel_reduced_actor_image h hKH hKn U hred).2.2.2.1
  have hgen : KY ⊔ RY = ⊤ := by
    rw [←subgroupOf_sup hKY hRY]
    have hs : KX ⊔ RX = YX := by
      rw [←subgroupOf_sup (show K ≤ X from le_sup_left)
        (show R ≤ X from (pCoreIn_le 2 P).trans le_sup_right)]
    rw [hs,subgroupOf_self]
  let : KX.Normal := normal_subgroupOf_of_le_normalizer
    ((sup_le hKH h.local_le).trans hKn)
  let : KY.Normal := normal_subgroupOf_of_le_normalizer le_normalizer_of_normal
  have hprod : ∀ g : YX, ∃ k ∈ KY, ∃ t ∈ (SY : Subgroup YX), k*t=g := by
    intro g
    rw [←hSY]
    exact mem_sup_of_normal_left.mp (hgen.symm ▸ mem_top g)
  let eK : KY ≃* K := (subgroupOfEquivOfLe hKY).trans
    (subgroupOfEquivOfLe (show K ≤ X from le_sup_left))
  let eQ := QuotientGroup.congr _ _ eK (pCore_map_iso 2 eK)
  have hkindY : (KY.IsCComponent ∧ IsQuasisimple (KY ⧸ pCore 2 KY)) ∨
      Nonempty ((KY ⧸ pCore 2 KY) ≃* Multiplicative (ZMod 3)) := by
    rcases hkind with hh | hh
    · obtain ⟨hc,hq⟩ := hh
      let := hq
      exact Or.inl ⟨hc.subgroupOf hKY,IsQuasisimple.of_mulEquiv eQ.symm⟩
    · obtain ⟨ec⟩ := hh
      exact Or.inr ⟨eQ.trans ec⟩
  have hmoveY : ⁅U.subgroupOf YX,KY⁆ ≠ ⊥ := by
    intro hz
    have hm := congrArg (Subgroup.map YX.subtype) hz
    rw [map_commutator,map_subgroupOf_eq_of_le hUY,map_subgroupOf_eq_of_le hKY,Subgroup.map_bot,
      hmove] at hm
    exact hne hm
  have hescape : baumann RY ≠ baumann (pCore 2 YX) := by
    intro hb
    have hm := congrArg (Subgroup.map (X.subtype.comp YX.subtype)) hb
    simp only [baumann,thompsonAlpha] at hm
    rw [baumann_map_injective (X.subtype.comp YX.subtype) hinj,
      baumann_map_injective (X.subtype.comp YX.subtype) hinj,hRYmap] at hm
    change baumann R = baumann ((pCore 2 YX).map (X.subtype.comp YX.subtype)) at hm
    have hQ : (pCore 2 YX).map (X.subtype.comp YX.subtype) = Y.pCoreIn 2 := by
      change (pCore 2 YX).map (Y.subtype.comp (subgroupOfEquivOfLe hYX).toMonoidHom) = Y.pCoreIn 2
      rw [←map_map,pCore_map_iso 2 (subgroupOfEquivOfLe hYX)]
      rfl
    rw [hQ] at hm
    apply hout
    apply (show K ≤ Y from le_sup_left).trans
    apply le_trans ?_ hB
    rw [hm]
    exact (Y.le_normalizer.trans
      (normalizer_le_normalizer_characteristic_image Y (pCore 2 Y))).trans
      (normalizer_le_normalizer_baumann _)
  obtain ⟨hJY,hle⟩ := image_le_offenders_of_baumann_escape (U.subgroupOf YX) RY qY
    (q.subgroupMap_surjective YX) hkY SY hSY hcore KY hkindY hmoveY hprod hescape
  have hJX : ¬ elementaryAbelianMaxJ RX ≤ q.ker := by
    intro hJ
    apply hJY
    change elementaryAbelianMaxJ RY ≤ (q.subgroupMap YX).ker
    rw [ker_subgroupMap]
    apply map_le_iff_le_comap.mp
    rw [←elementaryAbelianMaxJ_map_injective YX.subtype YX.subtype_injective,
      map_subgroupOf_eq_of_le hRY]
    exact hJ
  have hC : KY.map qY = C.subgroupOf (YX.map q) := by
    apply map_injective (YX.map q).subtype_injective
    rw [map_map,map_subgroupOf_eq_of_le (show C ≤ YX.map q from hE ▸ le_sup_left)]
    change KY.map (q.comp YX.subtype) = C
    rw [←map_map,map_subgroupOf_eq_of_le hKY]
  have hf := restricted_representation_offenders U YX hUY q
    (QuotientGroup.mk'_surjective _) (QuotientGroup.ker_mk' _)
    (C.subgroupOf (YX.map q)) (hC ▸ hle)
  refine ⟨hJX,?_⟩
  change C.subgroupOf E ≤ offenderSubgroup
    ((NormalElementaryQuotient.representation U q
      (QuotientGroup.mk'_surjective _) (QuotientGroup.ker_mk' _)).comp E.subtype)
  have ht : ∀ E' : Subgroup (X ⧸ centralizer (U : Set X)), E' = YX.map q →
      C.subgroupOf E' ≤ offenderSubgroup
        ((NormalElementaryQuotient.representation U q
          (QuotientGroup.mk'_surjective _) (QuotientGroup.ker_mk' _)).comp E'.subtype) := by
    intro E' he
    subst E'
    exact hf
  exact ht E hE


private theorem source_reduced_kernel_offender_data
    (h : (ConjugateIntersections.sourceSetup T L V V₃ V₁ H).Hypothesis)
    {K M : Subgroup G}
    (hKC : K ≤ kernel (ConjugateIntersections.sourceSetup T L V V₃ V₁ H))
    (hKn : H ≤ normalizer (K : Set G))
    (hcomm : ⁅K,(ConjugateIntersections.sourceSetup T L V V₃ V₁ H).L₁⁆ ≤ K.pCoreIn 2)
    (hout : ¬ K ≤ M)
    (hB : normalizer (baumann
      (((ConjugateIntersections.sourceSetup T L V V₃ V₁ H).L₁ ⊔
        (T : Subgroup G)).pCoreIn 2) : Set G) ≤ M)
    (hkind : ((K.subgroupOf (K ⊔
      ((ConjugateIntersections.sourceSetup T L V V₃ V₁ H).L₁ ⊔ (T : Subgroup G)))).IsCComponent ∧
      IsQuasisimple (K ⧸ pCore 2 K)) ∨
      Nonempty ((K ⧸ pCore 2 K) ≃* Multiplicative (ZMod 3)))
    (U : Subgroup ↥(K ⊔ ((ConjugateIntersections.sourceSetup T L V V₃ V₁ H).L₁ ⊔
      (T : Subgroup G)))) (hred : IsPReduced 2 U)
    (hU0 : U ≤ (fixedLayer (ConjugateIntersections.sourceSetup T L V V₃ V₁ H)).subgroupOf
      (K ⊔ ((ConjugateIntersections.sourceSetup T L V V₃ V₁ H).L₁ ⊔ (T : Subgroup G))))
    (hne : U ≠ ⊥)
    (hmove : ⁅U,K.subgroupOf (K ⊔
      ((ConjugateIntersections.sourceSetup T L V V₃ V₁ H).L₁ ⊔ (T : Subgroup G)))⁆ = U) :
    let F := ConjugateIntersections.sourceSetup T L V V₃ V₁ H
    let P := F.L₁ ⊔ (T : Subgroup G)
    let X := K ⊔ P
    let := hred.normal
    let := hred.elementary
    let q := QuotientGroup.mk' (centralizer (U : Set X))
    let C := (K.subgroupOf X).map q
    let E := C ⊔ ((P.pCoreIn 2).subgroupOf X).map q
    let ρ := NormalElementaryQuotient.representation U q
      (QuotientGroup.mk'_surjective _) (QuotientGroup.ker_mk' _)
    (¬ elementaryAbelianMaxJ ((P.pCoreIn 2).subgroupOf X) ≤ q.ker) ∧
      C.subgroupOf E ≤ offenderSubgroup (ρ.comp E.subtype) := by
  exact source_reduced_kernel_offender_data_of_sylow h hKC hKn
    (source_normal_kernel_sylow_of_commutator h hKC hKn hcomm)
    hout hB hkind U hred hU0 hne hmove

/-- The image of the actual kernel actor lies in the offender subgroup on E. -/
theorem source_reduced_kernel_le_restricted_offender
    (h : (ConjugateIntersections.sourceSetup T L V V₃ V₁ H).Hypothesis)
    {K M : Subgroup G}
    (hKC : K ≤ kernel (ConjugateIntersections.sourceSetup T L V V₃ V₁ H))
    (hKn : H ≤ normalizer (K : Set G))
    (hcomm : ⁅K,(ConjugateIntersections.sourceSetup T L V V₃ V₁ H).L₁⁆ ≤ K.pCoreIn 2)
    (hout : ¬ K ≤ M)
    (hB : normalizer (baumann
      (((ConjugateIntersections.sourceSetup T L V V₃ V₁ H).L₁ ⊔
        (T : Subgroup G)).pCoreIn 2) : Set G) ≤ M)
    (hkind : ((K.subgroupOf (K ⊔
      ((ConjugateIntersections.sourceSetup T L V V₃ V₁ H).L₁ ⊔ (T : Subgroup G)))).IsCComponent ∧
      IsQuasisimple (K ⧸ pCore 2 K)) ∨
      Nonempty ((K ⧸ pCore 2 K) ≃* Multiplicative (ZMod 3)))
    (U : Subgroup ↥(K ⊔ ((ConjugateIntersections.sourceSetup T L V V₃ V₁ H).L₁ ⊔
