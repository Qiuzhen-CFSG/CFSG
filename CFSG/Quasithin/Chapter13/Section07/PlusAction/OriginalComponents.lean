module
public import CFSG.Quasithin.Chapter13.Section07.PlusAction.PrimitiveRank
public import CFSG.Quasithin.Chapter13.Section07.PlusAction.LocalExclusion
public import CFSG.Quasithin.Chapter13.Section07.PlusAction.OriginalLocal
public import CFSG.Quasithin.Chapter13.Section07.ModelExclusions.Theta
public import CFSG.Quasithin.Chapter1.Section02.LocalComponents.SourceModels
public import CFSG.Quasithin.Chapter1.Section02.LocalComponents.ThreeResidualOrbit
public import Theory.SpecificGroups.PSL3.LinearThreeSylow.DefiningSylow

/-!
# Primitive components of the original plus kernel

A primitive C-component whose quotient order is divisible by three is normal
in the original point centralizer. If it were not normal, the two-conjugate
component theorem would identify its normal closure with the three-residual.
The plus kernel would then contain the point residual, since that residual is
generated by elements of order three, contradicting the original seed action.

The final theorem applies this normality to the ordinary local-escape theorem.
The A5 and PSL3(2) quotient models supply the explicit cubic divisibility input;
this module does not assert a classification of all primitive components.

Source: Aschbacher--Smith, 1.2.1 and 13.7.4(1), printed p.937.
-/

public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter13.Section07.PlusAction
open Section08.SourceCompletion
variable {G : Type*} [Group G] [Finite G]
  {T : Sylow 2 G} {L V V₁ V₂ V₃ M G₁ H : Subgroup G}
  (d : NaturalSetup T L V V₁ V₂ V₃ M G₁)
include d

private theorem source_local_twoCore_sqtk
    (h : (ConjugateIntersections.sourceSetup T L V V₃ V₁ H).Hypothesis) :
    IsSQTK KnownSimple.IsKnownSimple (H ⧸ pCore 2 H) := by
  have hp : IsPGroup 2 V₁ := IsPGroup.of_card (n := 1) (by simpa using d.line_card)
  have hn : V₁ ≠ ⊥ := by
    intro he
    have hc := d.line_card
    rw [he,card_bot] at hc
    contradiction
  have hloc : IsTwoLocal (normalizer (V₁ : Set G)) := ⟨V₁,hn,hp,rfl⟩
  have hHN : H ≤ normalizer (V₁ : Set G) :=
    h.H_centralizes.trans (Subgroup.centralizer_le_normalizer _)
  have hH := (IsSQTK.equiv (subgroupOfEquivOfLe hHN)).mp
    ((d.counterexample.qtke.twoLocal_sqtk hloc).subgroup (H.subgroupOf (normalizer (V₁ : Set G))))
  refine ⟨?_,hH.isKGroup.quotient _⟩
  intro p hp ho
  let : Fact p.Prime := ⟨hp⟩
  exact (primeRank_quotient_le_of_isTwoGroup p ho (pCore 2 H) pCore_isPGroup).trans
    (hH.stronglyQuasithin p hp ho)

omit d [Finite G] in
private theorem simple_component_quotient_quasisimple
    (J : Subgroup H) (hJ : J.IsCComponent) (hs : IsSimpleGroup (J ⧸ pCore 2 J)) :
    IsQuasisimple (J ⧸ pCore 2 J) := by
  let := hs
  let : Group.IsPerfect J := hJ.perfect
  let : Group.IsPerfect (J ⧸ pCore 2 J) :=
    Group.IsPerfect.ofSurjective (QuotientGroup.mk'_surjective _)
  have hz : center (J ⧸ pCore 2 J) = ⊥ := by
    rcases (inferInstance : (center (J ⧸ pCore 2 J)).Normal).eq_bot_or_eq_top with hz | hz
    · exact hz
    · exact (Group.IsPerfect.not_isMulCommutative (J ⧸ pCore 2 J)
        (center_eq_top_iff.mp hz)).elim
  exact { toIsPerfect := inferInstance
          simple := ((QuotientGroup.quotientMulEquivOfEq hz).trans QuotientGroup.quotientBot).isSimpleGroup }

/-- Cubic divisibility suffices for normality of the actual primitive kernel
component; the general mid-size component catalogue is not needed. -/
theorem source_primitive_kernel_normal_of_three_dvd
    (h : (ConjugateIntersections.sourceSetup T L V V₃ V₁ H).Hypothesis)
    (hne : ⁅V₃,G₁.pCoreIn 2⁆ ≠ ⊥)
    (J : Subgroup H) (hJ : J.IsCComponent) (hs : IsSimpleGroup (J ⧸ pCore 2 J))
    (hKC : J.map H.subtype ≤ kernel (ConjugateIntersections.sourceSetup T L V V₃ V₁ H))
    (hd : 3 ∣ Nat.card (J ⧸ pCore 2 J)) : J.Normal := by
  let := hs
  let : IsQuasisimple (J ⧸ pCore 2 J) := simple_component_quotient_quasisimple J hJ hs
  rcases Chapter1.Section02.proposition_1_2_1_three_index_knownSimple
    (source_local_twoCore_sqtk d h) hJ with hn | ⟨hi,hm⟩
  · exact hn
  let F := ConjugateIntersections.sourceSetup T L V V₃ V₁ H
  let C := (kernel F).subgroupOf H
  have hJC : J ≤ C := map_le_iff_le_comap.mp hKC
  let : C.Normal := kernel_normal
  have hres := Chapter1.Section02.nonnormal_component_threeResidual hJ hi hd
    (source_H_stronglyQuasithin d h 3 (by decide) (by decide)) hm
  have hresC : primeToResidual 3 H ≤ C := by
    rw [hres]
    apply conjugateSpanBy_le hJC
    rw [normalizer_eq_top]
  apply (local_residual_not_le_kernel d h hne).elim
  rw [source_local_residual_eq d h, ← ModelExclusions.point_residual_cubic_generated d]
  apply (closure_le _).mpr
  rintro x ⟨hx,horder⟩
  have hxH : x ∈ H := (le_sup_left.trans h.local_le)
    ((source_local_residual_eq d h).symm ▸ hx)
  have hxp : (⟨x,hxH⟩ : H) ∈ primeToResidual 3 H := by
    apply mem_primeToResidual_of_pow (n := 1)
    have ho : orderOf (⟨x,hxH⟩ : H) = 3 := (H.orderOf_coe _).symm.trans horder
    simpa only [pow_one,ho] using pow_orderOf_eq_one (⟨x,hxH⟩ : H)
  exact hresC hxp

/-- The same conclusion in the literal ambient form used in the source proof. -/
theorem source_primitive_kernel_normalizes_of_three_dvd
    (h : (ConjugateIntersections.sourceSetup T L V V₃ V₁ H).Hypothesis)
    (hne : ⁅V₃,G₁.pCoreIn 2⁆ ≠ ⊥)
    (J : Subgroup H) (hJ : J.IsCComponent) (hs : IsSimpleGroup (J ⧸ pCore 2 J))
    (hKC : J.map H.subtype ≤ kernel (ConjugateIntersections.sourceSetup T L V V₃ V₁ H))
    (hd : 3 ∣ Nat.card (J ⧸ pCore 2 J)) : H ≤ normalizer (J.map H.subtype : Set G) := by
  have hn := source_primitive_kernel_normal_of_three_dvd d h hne J hJ hs hKC hd
  apply (normal_subgroupOf_iff_le_normalizer (map_subtype_le J)).mp
  change ((J.map H.subtype).comap H.subtype).Normal
  rwa [comap_map_eq_self_of_injective H.subtype_injective]

/-- Both quotient models required by the remaining component branch supply
cubic divisibility and hence original H-normality. -/
theorem source_primitive_kernel_normal_of_small_model
    (h : (ConjugateIntersections.sourceSetup T L V V₃ V₁ H).Hypothesis)
    (hne : ⁅V₃,G₁.pCoreIn 2⁆ ≠ ⊥)
    (J : Subgroup H) (hJ : J.IsCComponent) (hs : IsSimpleGroup (J ⧸ pCore 2 J))
    (hKC : J.map H.subtype ≤ kernel (ConjugateIntersections.sourceSetup T L V V₃ V₁ H))
    (hm : Nonempty ((J ⧸ pCore 2 J) ≃* alternatingGroup (Fin 5)) ∨
      ClassicalGroup.IsPSL (J ⧸ pCore 2 J) 3 2) :
    J.Normal ∧ H ≤ normalizer (J.map H.subtype : Set G) := by
  have hd : 3 ∣ Nat.card (J ⧸ pCore 2 J) := by
    rcases hm with hm | hm
    · obtain ⟨e⟩ := hm
      rw [Nat.card_congr e.toEquiv,nat_card_alternatingGroup]
      norm_num
    · obtain ⟨F,_,_,hF,⟨e⟩⟩ := hm
      rw [Nat.card_congr e.toEquiv,Matrix.PSL3.LinearThree.card_projective,hF]
      norm_num
  exact ⟨source_primitive_kernel_normal_of_three_dvd d h hne J hJ hs hKC hd,
    source_primitive_kernel_normalizes_of_three_dvd d h hne J hJ hs hKC hd⟩

/-- The actual primitive kernel component escapes the original local subgroup.
Cubic divisibility discharges the normality premise of the ordinary source
13.7.4 escape theorem. -/
theorem source_primitive_kernel_not_le_local_of_three_dvd
    (h1221 : Chapter12.Section02.Hypothesis1221 KnownSimple.IsKnownSimple T L)
    (h : (ConjugateIntersections.sourceSetup T L V V₃ V₁ H).Hypothesis)
    (eL : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 6))
    (hne : ⁅V₃,G₁.pCoreIn 2⁆ ≠ ⊥)
    (J : Subgroup H) (hJ : J.IsCComponent) (hs : IsSimpleGroup (J ⧸ pCore 2 J))
    (hKC : J.map H.subtype ≤ kernel (ConjugateIntersections.sourceSetup T L V V₃ V₁ H))
    (hd : 3 ∣ Nat.card (J ⧸ pCore 2 J)) : ¬ J.map H.subtype ≤ M := by
  have hn := source_primitive_kernel_normalizes_of_three_dvd d h hne J hJ hs hKC hd
  have he : (J.map H.subtype).subgroupOf H = J :=
    comap_map_eq_self_of_injective H.subtype_injective J
  exact Original.ordinary_normal_component_not_le_local d h1221 h eL
    (map_subtype_le J) (he.symm ▸ hJ) hn

end CFSG.Quasithin.Chapter13.Section07.PlusAction
