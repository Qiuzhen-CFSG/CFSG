module
public import CFSG.Quasithin.Chapter13.Section07.PlusAction.OriginalMixed
public import Theory.GroupTheory.PResidual.SylowSupplement
/-!
# Invariant mixed module for the original cubic actor

The selected two-perfect kernel actor K normalizes the point residual L₁:
its commutator with L₁ lies in O₂(K), which is contained in the original
Sylow subgroup T; adjoining this normalizing two-group does not alter the
two-residual of L₁. The resulting group X=K(L₁T) stabilizes the literal
mixed subgroup U₂=[[U₀,L₁],K]. The module is elementary, nonzero under the
actual plane noncentrality, and generated by K-commutators.

Source: Aschbacher--Smith 13.7.4(1), printed p.938.
-/

public section
open Subgroup Theory.GroupTheory
open scoped IsMulCommutative commutatorElement
namespace CFSG.Quasithin.Chapter13.Section07.PlusAction.Original
open Section08.ComponentSieve.FieldComponents.LinearThree.Geometry.CoveredProduct.ResidualPlacement
variable {G : Type*} [Group G] [Finite G]
  {T : Sylow 2 G} {L V V₁ V₂ V₃ M G₁ H : Subgroup G}
theorem source_kernel_normalizes_point_residual
    (d : Section08.SourceCompletion.NaturalSetup T L V V₁ V₂ V₃ M G₁)
    (h : (ConjugateIntersections.sourceSetup T L V V₃ V₁ H).Hypothesis)
    {K : Subgroup G}
    (hKC : K ≤ kernel (ConjugateIntersections.sourceSetup T L V V₃ V₁ H))
    (hKn : H ≤ normalizer (K : Set G))
    (hcomm : ⁅K,(ConjugateIntersections.sourceSetup T L V V₃ V₁ H).L₁⁆ ≤ K.pCoreIn 2) :
    K ≤ normalizer ((ConjugateIntersections.sourceSetup T L V V₃ V₁ H).L₁ : Set G) := by
  let F := ConjugateIntersections.sourceSetup T L V V₃ V₁ H
  let Q := K.pCoreIn 2
  have hKH : K ≤ H := hKC.trans (kernel_le_H (D := F))
  have hTL : (T : Subgroup G) ≤ normalizer (F.L₁ : Set G) := by
    rw [source_local_residual_eq d h]
    exact T_normalizes_one L (T : Subgroup G) V₁ d.line_stable
  have hQT : Q ≤ (T : Subgroup G) :=
    (pCoreIn_mono_of_normalizes hKH hKn).trans h.QH_le_T
  have hKQ : K ≤ normalizer (Q : Set G) := K.le_normalizer.trans
    (normalizer_le_normalizer_characteristic_image K (pCore 2 K))
  have hKjoin : K ≤ normalizer ((F.L₁ ⊔ Q : Subgroup G) : Set G) := by
    apply le_normalizer_iff.mpr
    intro k hk
    change F.L₁ ⊔ Q ≤ (F.L₁ ⊔ Q).comap (MulAut.conj k).toMonoidHom
    apply sup_le
    · intro l hl
      have hc := hcomm (commutator_mem_commutator hk hl)
      have hm := (F.L₁ ⊔ Q).mul_mem (mem_sup_right hc) (mem_sup_left hl)
      change k * l * k⁻¹ ∈ F.L₁ ⊔ Q
      simpa only [commutatorElement_def, mul_assoc, inv_mul_cancel, mul_one] using hm
    · intro q hq
      exact mem_sup_right ((le_normalizer_iff.mp hKQ) k hk q hq)
  have he := embedded_pResidual_join_pGroup F.L₁ Q
    (isPPerfect_embedded_pResidual 2 _) (isPGroup_pCoreIn 2 K) (hQT.trans hTL)
  have hn := hKjoin.trans (normalizer_le_normalizer_characteristic_image (F.L₁ ⊔ Q)
    (pResidual 2 (F.L₁ ⊔ Q : Subgroup G)))
  rwa [he] at hn

theorem source_kernel_mixed_geometry
    (d : Section08.SourceCompletion.NaturalSetup T L V V₁ V₂ V₃ M G₁)
    (h : (ConjugateIntersections.sourceSetup T L V V₃ V₁ H).Hypothesis)
    {K : Subgroup G}
    (hKC : K ≤ kernel (ConjugateIntersections.sourceSetup T L V V₃ V₁ H))
    (hKn : H ≤ normalizer (K : Set G)) (hp : IsPPerfect 2 K)
    (hcomm : ⁅K,(ConjugateIntersections.sourceSetup T L V V₃ V₁ H).L₁⁆ ≤ K.pCoreIn 2) :
    let F := ConjugateIntersections.sourceSetup T L V V₃ V₁ H
    let X := K ⊔ (F.L₁ ⊔ (T : Subgroup G))
    let U₂ := ⁅⁅fixedLayer F,F.L₁⁆,K⁆
    X ≤ normalizer (F.L₁ : Set G) ∧ U₂ ≤ ⁅fixedLayer F,F.L₁⁆ ∧ U₂ ≤ fixedLayer F ∧
      X ≤ normalizer (U₂ : Set G) ∧ ⁅U₂,K⁆ = U₂ := by
  let F := ConjugateIntersections.sourceSetup T L V V₃ V₁ H
  let X := K ⊔ (F.L₁ ⊔ (T : Subgroup G))
  let D := ⁅fixedLayer F,F.L₁⁆
  let U₂ := ⁅D,K⁆
  have hKH : K ≤ H := hKC.trans (kernel_le_H (D := F))
  have hXH : X ≤ H := sup_le hKH h.local_le
  have hXL : X ≤ normalizer (F.L₁ : Set G) := by
    apply sup_le (source_kernel_normalizes_point_residual d h hKC hKn hcomm)
    apply sup_le F.L₁.le_normalizer
    rw [source_local_residual_eq d h]
    exact T_normalizes_one L (T : Subgroup G) V₁ d.line_stable
  have hXU : X ≤ normalizer (fixedLayer F : Set G) :=
    hXH.trans (fixedLayer_normalized (D := F))
  have hXD : X ≤ normalizer (D : Set G) := by
    intro x hx
    rw [mem_normalizer_iff_map_conj_eq, map_commutator,
      mem_normalizer_iff_map_conj_eq.mp (hXU hx), mem_normalizer_iff_map_conj_eq.mp (hXL hx)]
  have hXU₂ : X ≤ normalizer (U₂ : Set G) := by
    intro x hx
    rw [mem_normalizer_iff_map_conj_eq, map_commutator,
      mem_normalizer_iff_map_conj_eq.mp (hXD hx), mem_normalizer_iff_map_conj_eq.mp (hKn (hXH hx))]
  have hDU : D ≤ fixedLayer F := le_normalizer_iff_commutator_le_left.mp
    ((le_sup_left.trans h.local_le).trans (fixedLayer_normalized (D := F)))
  have hKU : K ≤ normalizer (D : Set G) := (show K ≤ X from le_sup_left).trans hXD
  have hU₂D : U₂ ≤ D := le_normalizer_iff_commutator_le_left.mp hKU
  have hDtwo : IsPGroup 2 D := h.g2_hypothesis.U_isPGroup.to_le (hDU.trans inf_le_left)
  exact ⟨hXL,hU₂D,hU₂D.trans hDU,hXU₂,commutator_isPPerfect_idempotent K D hp hDtwo hKU⟩

/-- The actual mixed subgroup, viewed inside KL1T, is an elementary normal
subgroup generated by its commutators with K. -/
theorem source_kernel_mixed_module
    (d : Section08.SourceCompletion.NaturalSetup T L V V₁ V₂ V₃ M G₁)
    (h1221 : Chapter12.Section02.Hypothesis1221 KnownSimple.IsKnownSimple T L)
    (h : (ConjugateIntersections.sourceSetup T L V V₃ V₁ H).Hypothesis)
    (hU : IsMulCommutative (Section08.Source.UH H V₃))
    (eL : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 6))
    (hm : ⁅(normalizer (V₁ : Set G)).pCoreIn 2,V₂⁆ ≠ ⊥)
    {K : Subgroup G}
    (hKC : K ≤ kernel (ConjugateIntersections.sourceSetup T L V V₃ V₁ H))
    (hKn : H ≤ normalizer (K : Set G)) (hp : IsPPerfect 2 K) (hout : ¬ K ≤ M)
    (hcomm : ⁅K,(ConjugateIntersections.sourceSetup T L V V₃ V₁ H).L₁⁆ ≤ K.pCoreIn 2) :
    let F := ConjugateIntersections.sourceSetup T L V V₃ V₁ H
    let X := K ⊔ (F.L₁ ⊔ (T : Subgroup G))
    let U₂ := ⁅⁅fixedLayer F,F.L₁⁆,K⁆
    U₂ ≤ fixedLayer F ∧ U₂ ≤ X ∧ (F.L₁.subgroupOf X).Normal ∧
      (U₂.subgroupOf X).Normal ∧ IsElementaryAbelian 2 (U₂.subgroupOf X) ∧
      U₂.subgroupOf X ≠ ⊥ ∧ ⁅U₂.subgroupOf X,K.subgroupOf X⁆ = U₂.subgroupOf X := by
  let F := ConjugateIntersections.sourceSetup T L V V₃ V₁ H
  let X := K ⊔ (F.L₁ ⊔ (T : Subgroup G))
  let U₂ := ⁅⁅fixedLayer F,F.L₁⁆,K⁆
  obtain ⟨hXL,hU₂D,hU₂,hXU₂,hgen⟩ := source_kernel_mixed_geometry d h hKC hKn hp hcomm
  have hU₂X : U₂ ≤ X := hU₂.trans ((source_fixedLayer_le_point_radical h).trans
    ((pCoreIn_le 2 _).trans le_sup_right))
  have hKH : K ≤ H := hKC.trans (kernel_le_H (D := F))
  have hnonzero : U₂ ≠ ⊥ := source_kernel_mixed_commutator_ne_bot d h1221 h eL hm
    hKC hp hout (hcomm.trans (pCoreIn_mono_of_normalizes hKH hKn))
  let : IsElementaryAbelian 2 F.V := h.elementary
  let : IsElementaryAbelian 2 F.Vplus := IsElementaryAbelian.of_le h.plus_le
  let : IsMulCommutative (conjugateSpanBy F.Vplus H) := hU
  let : IsElementaryAbelian 2 F.UH := conjugateSpanBy_elementary_of_commutative F.Vplus H
  let : IsElementaryAbelian 2 U₂ := IsElementaryAbelian.of_le (hU₂.trans inf_le_left)
  have hE : IsElementaryAbelian 2 (U₂.subgroupOf X) :=
    (inferInstance : IsElementaryAbelian 2 U₂).of_injective
      (subgroupOfEquivOfLe hU₂X).toMonoidHom (subgroupOfEquivOfLe hU₂X).injective
  refine ⟨hU₂,hU₂X,normal_subgroupOf_of_le_normalizer hXL,
    normal_subgroupOf_of_le_normalizer hXU₂,hE,?_,?_⟩
  · intro hz
    apply hnonzero
    have he := congrArg (fun B : Subgroup X => B.map X.subtype) hz
    change (U₂.subgroupOf X).map X.subtype = (⊥ : Subgroup X).map X.subtype at he
    rwa [map_subgroupOf_eq_of_le hU₂X,Subgroup.map_bot] at he
  · apply map_injective X.subtype_injective
    rw [map_commutator, map_subgroupOf_eq_of_le hU₂X,
      map_subgroupOf_eq_of_le (show K ≤ X from le_sup_left),hgen]

/-- A selected cubic actor supplies the quotient centralization used by the
literal mixed-module geometry. -/
theorem source_primitive_cubic_mixed_module
    (d : Section08.SourceCompletion.NaturalSetup T L V V₁ V₂ V₃ M G₁)
    (h1221 : Chapter12.Section02.Hypothesis1221 KnownSimple.IsKnownSimple T L)
    (h : (ConjugateIntersections.sourceSetup T L V V₃ V₁ H).Hypothesis)
    (hU : IsMulCommutative (Section08.Source.UH H V₃))
    (eL : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 6))
    (hm : ⁅(normalizer (V₁ : Set G)).pCoreIn 2,V₂⁆ ≠ ⊥)
    (J : Subgroup H)
    (hJC : J.map H.subtype ≤ kernel (ConjugateIntersections.sourceSetup T L V V₃ V₁ H))
    (hJn : H ≤ normalizer (J.map H.subtype : Set G))
    (hp : IsPPerfect 2 (J.map H.subtype)) (hout : ¬ J.map H.subtype ≤ M)
    (hcard : Nat.card (J ⧸ pCore 2 J) = 3) :
    let F := ConjugateIntersections.sourceSetup T L V V₃ V₁ H
    let K := J.map H.subtype
    let X := K ⊔ (F.L₁ ⊔ (T : Subgroup G))
    let U₂ := ⁅⁅fixedLayer F,F.L₁⁆,K⁆
    U₂ ≤ fixedLayer F ∧ U₂ ≤ X ∧ (F.L₁.subgroupOf X).Normal ∧
      (U₂.subgroupOf X).Normal ∧ IsElementaryAbelian 2 (U₂.subgroupOf X) ∧
      U₂.subgroupOf X ≠ ⊥ ∧ ⁅U₂.subgroupOf X,K.subgroupOf X⁆ = U₂.subgroupOf X :=
  source_kernel_mixed_module d h1221 h hU eL hm hJC hJn hp hout
    (source_primitive_cubic_centralized h J hJn hcard)

end CFSG.Quasithin.Chapter13.Section07.PlusAction.Original
