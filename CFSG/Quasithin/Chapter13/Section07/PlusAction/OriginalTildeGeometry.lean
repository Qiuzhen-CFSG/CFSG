module
public import CFSG.Quasithin.Chapter13.Section07.PlusAction.OriginalMixedGeometry
public import Theory.GroupTheory.IrreducibleSectionCore.Ambient
public import Theory.GroupTheory.CommutatorPreimageTransport

/-!
# The original tilde-one cubic displacement

The tilde-one section is the centralizer of O₂(L₁) on UH modulo V₁.
Its preimage W contains V₃ because the original irreducible section
V₃/V₁ is centralized by O₂(L₁T). Set R=[W,K] and D=[R,L₁]. Two rotations
of the three-subgroups lemma show that O₂(L₁) centralizes R; R and D are
normal in K(L₁T), lie in U₀, and D is generated by K-commutators. If D
vanished, another rotation would centralize V₃ and contradict K escaping M.
Thus cubic coprime displacement applies on R to invariant subgroups of D.

Source: Aschbacher--Smith 13.7.4(1), printed p.938. The quotient by V₁
is essential: O₂(L₁) need not centralize the original seed V₃.
-/

public section
open Subgroup Theory.GroupTheory
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter13.Section07.PlusAction.Original
open Section08.ComponentSieve.FieldComponents.LinearThree.Geometry.CoveredProduct.ResidualPlacement
variable {G : Type*} [Group G] [Finite G]
  {T : Sylow 2 G} {L V V₁ V₂ V₃ M G₁ H : Subgroup G}
theorem source_point_core_seed_commutator
    (d : Section08.SourceCompletion.NaturalSetup T L V V₁ V₂ V₃ M G₁)
    (h : (ConjugateIntersections.sourceSetup T L V V₃ V₁ H).Hypothesis) :
    let F := ConjugateIntersections.sourceSetup T L V V₃ V₁ H
    ⁅F.Vplus,F.L₁.pCoreIn 2⁆ ≤ F.V₁ := by
  let F := ConjugateIntersections.sourceSetup T L V V₃ V₁ H
  let Y := F.L₁ ⊔ (T : Subgroup G)
  have hTY : (T : Subgroup G) ≤ Y := le_sup_right
  have hYL : Y ≤ normalizer (F.L₁ : Set G) := by
    apply sup_le F.L₁.le_normalizer
    rw [source_local_residual_eq d h]
    exact T_normalizes_one L (T : Subgroup G) V₁ d.line_stable
  have hQY : F.L₁.pCoreIn 2 ≤ Y.pCoreIn 2 :=
    pCoreIn_mono_of_normalizes le_sup_left hYL
  have hYA : Y ≤ normalizer (F.V₁ : Set G) := h.local_le.trans
    (h.H_centralizes.trans (Subgroup.centralizer_le_normalizer _))
  have hVA : F.Vplus ≤ Y := (h.plus_le.trans h.V_le_T).trans hTY
  have hc := ambient_irreducible_section_core F.V₁ F.Vplus Y h.point_lt.le hVA
    hYA h.local_normalizes (h.g2_hypothesis.U_isPGroup.to_le (le_conjugateSpanBy F.Vplus H))
    h.irreducible
  exact (commutator_mono le_rfl hQY).trans hc

/-- The source tilde-one section is represented by the quotient-centralizer
preimage, followed first by K and then by the point residual. -/
theorem source_kernel_tilde_geometry
    (d : Section08.SourceCompletion.NaturalSetup T L V V₁ V₂ V₃ M G₁)
    (h : (ConjugateIntersections.sourceSetup T L V V₃ V₁ H).Hypothesis)
    {K : Subgroup G}
    (hKC : K ≤ kernel (ConjugateIntersections.sourceSetup T L V V₃ V₁ H))
    (hKn : H ≤ normalizer (K : Set G)) (hp : IsPPerfect 2 K)
    (hcomm : ⁅K,(ConjugateIntersections.sourceSetup T L V V₃ V₁ H).L₁⁆ ≤ K.pCoreIn 2) :
    let F := ConjugateIntersections.sourceSetup T L V V₃ V₁ H
    let X := K ⊔ (F.L₁ ⊔ (T : Subgroup G))
    let W := commutatorPreimage F.UH (F.L₁.pCoreIn 2) F.V₁
    let R := ⁅W,K⁆
    let D := ⁅R,F.L₁⁆
    F.Vplus ≤ W ∧ W ≤ F.UH ∧ X ≤ normalizer (W : Set G) ∧
      R ≤ fixedLayer F ∧ X ≤ normalizer (R : Set G) ∧
      F.L₁.pCoreIn 2 ≤ centralizer (R : Set G) ∧
      D ≤ R ∧ X ≤ normalizer (D : Set G) ∧ ⁅D,K⁆=D := by
  let F := ConjugateIntersections.sourceSetup T L V V₃ V₁ H
  let X := K ⊔ (F.L₁ ⊔ (T : Subgroup G))
  let Q := F.L₁.pCoreIn 2
  let W := commutatorPreimage F.UH Q F.V₁
  let R := ⁅W,K⁆
  let D := ⁅R,F.L₁⁆
  have hKH : K ≤ H := hKC.trans (kernel_le_H (D:=F))
  have hLH : F.L₁ ≤ H := le_sup_left.trans h.local_le
  have hXH : X ≤ H := sup_le hKH h.local_le
  have hKX : K ≤ X := le_sup_left
  have hLX : F.L₁ ≤ X := le_sup_left.trans le_sup_right
  have hTX : (T : Subgroup G) ≤ X := le_sup_right.trans le_sup_right
  obtain ⟨hXL,hU₂D,hU₂,hXU₂,hU₂gen⟩ := source_kernel_mixed_geometry d h hKC hKn hp hcomm
  have hXQ : X ≤ normalizer (Q : Set G) := hXL.trans
    (normalizer_le_normalizer_characteristic_image F.L₁ (pCore 2 F.L₁))
  have hHZ : H ≤ normalizer (F.V₁ : Set G) :=
    h.H_centralizes.trans (Subgroup.centralizer_le_normalizer _)
  have hUZ : F.UH ≤ normalizer (F.V₁ : Set G) := h.UH_le_H.trans hHZ
  have hXW : X ≤ normalizer (W : Set G) := commutatorPreimage_normalized _ _ _ _ hUZ
    (hXH.trans (le_normalizer_conjugateSpanBy F.Vplus H)) hXQ (hXH.trans hHZ)
  have hWU : W ≤ F.UH := commutatorPreimage_le _ _ _
  have hVW : F.Vplus ≤ W := le_commutatorPreimage (le_conjugateSpanBy F.Vplus H)
    (source_point_core_seed_commutator d h)
  have hRW : R ≤ W := le_normalizer_iff_commutator_le_left.mp
    ((show K ≤ X from le_sup_left).trans hXW)
  have hRU : R ≤ fixedLayer F := (commutator_mono hWU hKC).trans (kernel_commutator (D:=F))
  have hXR : X ≤ normalizer (R : Set G) := by
    intro x hx
    rw [mem_normalizer_iff_map_conj_eq,map_commutator,
      mem_normalizer_iff_map_conj_eq.mp (hXW hx),
      mem_normalizer_iff_map_conj_eq.mp (hKn (hXH hx))]
  have hWQ : ⁅W,Q⁆ ≤ F.V₁ := commutator_commutatorPreimage_le _ _ _ hUZ
  have hcore : K.pCoreIn 2 ≤ F.QH := pCoreIn_mono_of_normalizes hKH hKn
  have hKQ : ⁅K,Q⁆ ≤ F.QH :=
    (commutator_mono le_rfl (pCoreIn_le 2 F.L₁)).trans (hcomm.trans hcore)
  have hpointK : ⁅F.V₁,K⁆ = ⊥ := by
    rw [commutator_comm]
    exact commutator_eq_bot_iff_le_centralizer.mpr (hKH.trans h.H_centralizes)
  have hKQW : ⁅⁅K,Q⁆,W⁆ ≤ F.V₁ := by
    exact (commutator_mono hKQ hWU).trans (by
      rw [commutator_comm F.QH F.UH]
      exact h.commutator_UH_QH_le_point)
  have hRQZ : ⁅R,Q⁆ ≤ F.V₁ := by
    apply commutator_commutator_le_of_rotate_of_le_normalizer
      (hWU.trans (h.UH_le_H.trans hHZ)) (hKH.trans hHZ)
      ((pCoreIn_le 2 F.L₁).trans (hLH.trans hHZ)) hKQW
    rw [commutator_comm Q W]
    exact (commutator_mono hWQ le_rfl).trans (hpointK.le.trans bot_le)
  have hRgen : ⁅R,K⁆=R := commutator_isPPerfect_idempotent K W hp
    (h.g2_hypothesis.U_isPGroup.to_le hWU) ((show K ≤ X from le_sup_left).trans hXW)
  have hcoreR : K.pCoreIn 2 ≤ centralizer (R : Set G) :=
    hcore.trans (le_centralizer_iff.mp (hRU.trans inf_le_right))
  have hRQ : ⁅R,Q⁆=⊥ := by
    rw [← hRgen]
    apply commutator_commutator_eq_bot_of_rotate
    · exact commutator_eq_bot_iff_le_centralizer.mpr (hKQ.trans
        (le_centralizer_iff.mp (hRU.trans inf_le_right)))
    · rw [commutator_comm Q R]
      exact eq_bot_iff.mpr ((commutator_mono hRQZ le_rfl).trans hpointK.le)
  have hDR : D ≤ R := le_normalizer_iff_commutator_le_left.mp
    (hLX.trans hXR)
  have hXD : X ≤ normalizer (D : Set G) := by
    intro x hx
    rw [mem_normalizer_iff_map_conj_eq,map_commutator,
      mem_normalizer_iff_map_conj_eq.mp (hXR hx),mem_normalizer_iff_map_conj_eq.mp (hXL hx)]
  have hgen : ⁅D,K⁆=D := by
    apply le_antisymm (le_normalizer_iff_commutator_le_left.mp
      ((show K ≤ X from le_sup_left).trans hXD))
    change ⁅R,F.L₁⁆ ≤ ⁅D,K⁆
    rw [← hRgen]
    have hXDK : X ≤ normalizer ((⁅D,K⁆ : Subgroup G) : Set G) := by
      intro x hx
      rw [mem_normalizer_iff_map_conj_eq,map_commutator,
        mem_normalizer_iff_map_conj_eq.mp (hXD hx),
        mem_normalizer_iff_map_conj_eq.mp (hKn (hXH hx))]
    have hRX : R ≤ X := hRU.trans (inf_le_left.trans
      (h.UH_le_QH.trans (h.QH_le_T.trans hTX)))
    apply commutator_commutator_le_of_rotate_of_le_normalizer
      (hRX.trans hXDK) (hKX.trans hXDK) (hLX.trans hXDK)
    · exact (commutator_eq_bot_iff_le_centralizer.mpr (hcomm.trans hcoreR)).le.trans bot_le
    · rw [commutator_comm F.L₁ R]
  exact ⟨hVW,hWU,hXW,hRU,hXR,
    le_centralizer_iff.mp (commutator_eq_bot_iff_le_centralizer.mp hRQ),hDR,hXD,hgen⟩

/-- The corrected tilde-one displacement cannot vanish: otherwise the
original seed is centralized by the selected actor, contradicting escape. -/
theorem source_kernel_tilde_commutator_ne_bot
    (d : Section08.SourceCompletion.NaturalSetup T L V V₁ V₂ V₃ M G₁)
    (h1221 : Chapter12.Section02.Hypothesis1221 KnownSimple.IsKnownSimple T L)
    (h : (ConjugateIntersections.sourceSetup T L V V₃ V₁ H).Hypothesis)
    (eL : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 6))
    (hm : ⁅(normalizer (V₁ : Set G)).pCoreIn 2,V₂⁆ ≠ ⊥)
    {K : Subgroup G}
    (hKC : K ≤ kernel (ConjugateIntersections.sourceSetup T L V V₃ V₁ H))
    (hKn : H ≤ normalizer (K : Set G)) (hp : IsPPerfect 2 K) (hout : ¬ K ≤ M)
    (hcomm : ⁅K,(ConjugateIntersections.sourceSetup T L V V₃ V₁ H).L₁⁆ ≤ K.pCoreIn 2) :
    let F := ConjugateIntersections.sourceSetup T L V V₃ V₁ H
    let W := commutatorPreimage F.UH (F.L₁.pCoreIn 2) F.V₁
    ⁅⁅W,K⁆,F.L₁⁆ ≠ ⊥ := by
  let F := ConjugateIntersections.sourceSetup T L V V₃ V₁ H
  let X := K ⊔ (F.L₁ ⊔ (T : Subgroup G))
  let W := commutatorPreimage F.UH (F.L₁.pCoreIn 2) F.V₁
  obtain ⟨hVW,hWU,hXW,hRU,hXR,hcore,hDR,hXD,hgen⟩ :=
    source_kernel_tilde_geometry d h hKC hKn hp hcomm
  have hKH : K ≤ H := hKC.trans (kernel_le_H (D:=F))
  have hLH : F.L₁ ≤ H := le_sup_left.trans h.local_le
  have hHZ : H ≤ normalizer (F.V₁ : Set G) :=
    h.H_centralizes.trans (Subgroup.centralizer_le_normalizer _)
  have hKcore : K.pCoreIn 2 ≤ F.QH := pCoreIn_mono_of_normalizes hKH hKn
  have hKLW : ⁅⁅K,F.L₁⁆,W⁆ ≤ F.V₁ := by
    exact (commutator_mono (hcomm.trans hKcore) hWU).trans (by
      rw [commutator_comm F.QH F.UH]
      exact h.commutator_UH_QH_le_point)
  change ⁅⁅W,K⁆,F.L₁⁆ ≠ ⊥
  intro hz
  have hWLK : ⁅⁅W,F.L₁⁆,K⁆ ≤ F.V₁ := by
    apply commutator_commutator_le_of_rotate_of_le_normalizer
      (hWU.trans (h.UH_le_H.trans hHZ)) (hLH.trans hHZ) (hKH.trans hHZ)
    · rwa [commutator_comm F.L₁ K]
    rw [commutator_comm K W,hz]
    exact bot_le
  have hseed : ⁅F.Vplus,F.L₁⁆=F.Vplus := by
    rw [source_local_residual_eq d h]
    exact ModelExclusions.seed_commutator_point_residual d
  have hseedK : ⁅F.Vplus,K⁆ ≤ F.V₁ := by
    rw [← hseed]
    exact (commutator_mono (commutator_mono hVW le_rfl) le_rfl).trans hWLK
  have hKnseed : K ≤ normalizer (F.Vplus : Set G) :=
    le_normalizer_iff_commutator_le_left.mpr (hseedK.trans h.point_lt.le)
  have hpoint : ⁅F.V₁,K⁆=⊥ := by
    rw [commutator_comm]
    exact commutator_eq_bot_iff_le_centralizer.mpr (hKH.trans h.H_centralizes)
  have hi := commutator_isPPerfect_idempotent K F.Vplus hp
    (h.g2_hypothesis.U_isPGroup.to_le (le_conjugateSpanBy F.Vplus H)) hKnseed
  have hc : K ≤ centralizer (F.Vplus : Set G) := by
    apply le_centralizer_iff.mp
    apply commutator_eq_bot_iff_le_centralizer.mp
    apply eq_bot_iff.mpr
    rw [← hi]
    exact (commutator_mono hseedK le_rfl).trans hpoint.le
  apply hout
  exact hc.trans ((Section05.AmbientSource.source_parabolic_centralizer d eL h1221 hm).trans inf_le_left)

/-- The source quotient-centralizer displacement, inside its actual actor,
with the core acting trivially on the ambient moved section R. -/
theorem source_kernel_tilde_module
    (d : Section08.SourceCompletion.NaturalSetup T L V V₁ V₂ V₃ M G₁)
    (h1221 : Chapter12.Section02.Hypothesis1221 KnownSimple.IsKnownSimple T L)
    (h : (ConjugateIntersections.sourceSetup T L V V₃ V₁ H).Hypothesis)
    (hU : IsMulCommutative (Section08.Source.UH H V₃))
    (eL : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 6))
    (hm : ⁅(normalizer (V₁ : Set G)).pCoreIn 2,V₂⁆ ≠ ⊥)
    {K : Subgroup G}
    (hKC : K ≤ kernel (ConjugateIntersections.sourceSetup T L V V₃ V₁ H))
    (hKn : H ≤ normalizer (K : Set G)) (hp : IsPPerfect 2 K) (hout : ¬ K ≤ M)
    (hcomm : ⁅K,(ConjugateIntersections.sourceSetup T L V V₃ V₁ H).L₁⁆ ≤ K.pCoreIn 2) :
    let F := ConjugateIntersections.sourceSetup T L V V₃ V₁ H
    let X := K ⊔ (F.L₁ ⊔ (T : Subgroup G))
    let W := commutatorPreimage F.UH (F.L₁.pCoreIn 2) F.V₁
    let R := ⁅W,K⁆
    let D := ⁅R,F.L₁⁆
    R ≤ fixedLayer F ∧ D ≤ R ∧ R ≤ X ∧ D ≤ X ∧
      (R.subgroupOf X).Normal ∧ (D.subgroupOf X).Normal ∧
      IsElementaryAbelian 2 (R.subgroupOf X) ∧
      IsElementaryAbelian 2 (D.subgroupOf X) ∧ D.subgroupOf X ≠ ⊥ ∧
      F.L₁.pCoreIn 2 ≤ centralizer (R : Set G) ∧
      ⁅D.subgroupOf X,K.subgroupOf X⁆=D.subgroupOf X := by
  let F := ConjugateIntersections.sourceSetup T L V V₃ V₁ H
  let X := K ⊔ (F.L₁ ⊔ (T : Subgroup G))
  let W := commutatorPreimage F.UH (F.L₁.pCoreIn 2) F.V₁
  let R := ⁅W,K⁆
  let D := ⁅R,F.L₁⁆
  obtain ⟨hVW,hWU,hXW,hRU,hXR,hcore,hDR,hXD,hgen⟩ :=
    source_kernel_tilde_geometry d h hKC hKn hp hcomm
  have hRX : R ≤ X := hRU.trans (inf_le_left.trans
    (h.UH_le_QH.trans (h.QH_le_T.trans (le_sup_right.trans le_sup_right))))
  have hDX : D ≤ X := hDR.trans hRX
  have hnonzero : D ≠ ⊥ := source_kernel_tilde_commutator_ne_bot d h1221 h eL hm
    hKC hKn hp hout hcomm
  let : IsElementaryAbelian 2 F.V := h.elementary
  let : IsElementaryAbelian 2 F.Vplus := IsElementaryAbelian.of_le h.plus_le
  let : IsMulCommutative (conjugateSpanBy F.Vplus H) := hU
  let : IsElementaryAbelian 2 F.UH := conjugateSpanBy_elementary_of_commutative F.Vplus H
  let : IsElementaryAbelian 2 R := IsElementaryAbelian.of_le (hRU.trans inf_le_left)
  let : IsElementaryAbelian 2 D := IsElementaryAbelian.of_le hDR
  have hER : IsElementaryAbelian 2 (R.subgroupOf X) :=
    (inferInstance : IsElementaryAbelian 2 R).of_injective
      (subgroupOfEquivOfLe hRX).toMonoidHom (subgroupOfEquivOfLe hRX).injective
  have hED : IsElementaryAbelian 2 (D.subgroupOf X) :=
    (inferInstance : IsElementaryAbelian 2 D).of_injective
      (subgroupOfEquivOfLe hDX).toMonoidHom (subgroupOfEquivOfLe hDX).injective
  refine ⟨hRU,hDR,hRX,hDX,normal_subgroupOf_of_le_normalizer hXR,
    normal_subgroupOf_of_le_normalizer hXD,hER,hED,?_,hcore,?_⟩
  · intro hz
    apply hnonzero
    have he := congrArg (fun B : Subgroup X => B.map X.subtype) hz
    change (D.subgroupOf X).map X.subtype=(⊥ : Subgroup X).map X.subtype at he
    rwa [map_subgroupOf_eq_of_le hDX,Subgroup.map_bot] at he
  · apply map_injective X.subtype_injective
    rw [map_commutator,map_subgroupOf_eq_of_le hDX,
      map_subgroupOf_eq_of_le (show K ≤ X from le_sup_left),hgen]

/-- The literal selected cubic actor supplies all the hypotheses of the
corrected tilde-one module. -/
theorem source_primitive_cubic_tilde_module
    (d : Section08.SourceCompletion.NaturalSetup T L V V₁ V₂ V₃ M G₁)
    (h1221 : Chapter12.Section02.Hypothesis1221 KnownSimple.IsKnownSimple T L)
    (h : (ConjugateIntersections.sourceSetup T L V V₃ V₁ H).Hypothesis)
    (hU : IsMulCommutative (Section08.Source.UH H V₃))
    (eL : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 6))
    (hm : ⁅(normalizer (V₁ : Set G)).pCoreIn 2,V₂⁆ ≠ ⊥)
    (J : Subgroup H)
    (hJC : J.map H.subtype ≤ kernel (ConjugateIntersections.sourceSetup T L V V₃ V₁ H))
    (hJn : H ≤ normalizer (J.map H.subtype : Set G))
    (hp : IsPPerfect 2 (J.map H.subtype)) (hout : ¬ J.map H.subtype ≤ M)
    (hcard : Nat.card (J ⧸ pCore 2 J)=3) :
    let F := ConjugateIntersections.sourceSetup T L V V₃ V₁ H
    let K := J.map H.subtype
    let X := K ⊔ (F.L₁ ⊔ (T : Subgroup G))
    let W := commutatorPreimage F.UH (F.L₁.pCoreIn 2) F.V₁
    let R := ⁅W,K⁆
    let D := ⁅R,F.L₁⁆
    R ≤ fixedLayer F ∧ D ≤ R ∧ R ≤ X ∧ D ≤ X ∧
      (R.subgroupOf X).Normal ∧ (D.subgroupOf X).Normal ∧
      IsElementaryAbelian 2 (R.subgroupOf X) ∧
      IsElementaryAbelian 2 (D.subgroupOf X) ∧ D.subgroupOf X ≠ ⊥ ∧
      F.L₁.pCoreIn 2 ≤ centralizer (R : Set G) ∧
      ⁅D.subgroupOf X,K.subgroupOf X⁆=D.subgroupOf X :=
  source_kernel_tilde_module d h1221 h hU eL hm hJC hJn hp hout
    (source_primitive_cubic_centralized h J hJn hcard)

/-- Literal identification of the preimage W with the centralizer on the
original quotient H/V₁; this records the printed tilde convention. -/
theorem source_tilde_centralizer_preimage
    (h : (ConjugateIntersections.sourceSetup T L V V₃ V₁ H).Hypothesis) :
    let F := ConjugateIntersections.sourceSetup T L V V₃ V₁ H
    let _ : (F.V₁.subgroupOf H).Normal := normal_subgroupOf_of_le_normalizer
      (h.H_centralizes.trans (Subgroup.centralizer_le_normalizer _))
    let π := QuotientGroup.mk' (F.V₁.subgroupOf H)
    (commutatorPreimage F.UH (F.L₁.pCoreIn 2) F.V₁).subgroupOf H =
      F.UH.subgroupOf H ⊓
        (centralizer (((F.L₁.pCoreIn 2).subgroupOf H).map π :
          Set (H ⧸ F.V₁.subgroupOf H))).comap π := by
  let F := ConjugateIntersections.sourceSetup T L V V₃ V₁ H
  have hHZ : H ≤ normalizer (F.V₁ : Set G) :=
    h.H_centralizes.trans (Subgroup.centralizer_le_normalizer _)
  let : (F.V₁.subgroupOf H).Normal := normal_subgroupOf_of_le_normalizer hHZ
  exact (commutatorPreimage_subgroupOf F.UH (F.L₁.pCoreIn 2) F.V₁ H
    (show F.UH ≤ H from h.UH_le_H)
    ((pCoreIn_le 2 _).trans (le_sup_left.trans h.local_le)) hHZ).trans
      (commutatorPreimage_eq_inf_comap_centralizer _ _ _)

/-- The corrected cubic displacement lies in the literal mixed subgroup
used for the source minimal-module choice. -/
theorem source_tilde_displacement_le_mixed
    (d : Section08.SourceCompletion.NaturalSetup T L V V₁ V₂ V₃ M G₁)
    (h : (ConjugateIntersections.sourceSetup T L V V₃ V₁ H).Hypothesis)
    {K : Subgroup G}
    (hKC : K ≤ kernel (ConjugateIntersections.sourceSetup T L V V₃ V₁ H))
    (hKn : H ≤ normalizer (K : Set G)) (hp : IsPPerfect 2 K)
    (hcomm : ⁅K,(ConjugateIntersections.sourceSetup T L V V₃ V₁ H).L₁⁆ ≤ K.pCoreIn 2) :
    let F := ConjugateIntersections.sourceSetup T L V V₃ V₁ H
    let W := commutatorPreimage F.UH (F.L₁.pCoreIn 2) F.V₁
    ⁅⁅W,K⁆,F.L₁⁆ ≤ ⁅⁅fixedLayer F,F.L₁⁆,K⁆ := by
  let F := ConjugateIntersections.sourceSetup T L V V₃ V₁ H
  let X := K ⊔ (F.L₁ ⊔ (T : Subgroup G))
  let W := commutatorPreimage F.UH (F.L₁.pCoreIn 2) F.V₁
  let U₂ := ⁅⁅fixedLayer F,F.L₁⁆,K⁆
  have hKH : K ≤ H := hKC.trans (kernel_le_H (D:=F))
  have hcore : K.pCoreIn 2 ≤ F.QH := pCoreIn_mono_of_normalizes hKH hKn
  obtain ⟨hXL,hUD,hU,hXU,hgen⟩ := source_kernel_mixed_geometry d h hKC hKn hp hcomm
  have hU₀X : fixedLayer F ≤ X := inf_le_left.trans
    (h.UH_le_QH.trans (h.QH_le_T.trans (le_sup_right.trans le_sup_right)))
  have hKU : K ≤ normalizer (U₂ : Set G) := (show K ≤ X from le_sup_left).trans hXU
  have hLU : F.L₁ ≤ normalizer (U₂ : Set G) :=
    (show F.L₁ ≤ X from le_sup_left.trans le_sup_right).trans hXU
  have hrot : ⁅⁅fixedLayer F,K⁆,F.L₁⁆ ≤ U₂ := by
    apply commutator_commutator_le_of_rotate_of_le_normalizer (hU₀X.trans hXU) hKU hLU
    · have he : ⁅⁅K,F.L₁⁆,fixedLayer F⁆=⊥ :=
        commutator_eq_bot_iff_le_centralizer.mpr ((hcomm.trans hcore).trans
          (le_centralizer_iff.mp (show fixedLayer F ≤ centralizer (F.QH : Set G) from inf_le_right)))
      exact he.le.trans bot_le
    · rw [commutator_comm F.L₁ (fixedLayer F)]
  have hR : ⁅W,K⁆ ≤ ⁅fixedLayer F,K⁆ := by
    rw [← residual_kernel_commutator h hKC hp]
    exact commutator_mono (commutatorPreimage_le _ _ _) le_rfl
  exact (commutator_mono hR le_rfl).trans hrot

end CFSG.Quasithin.Chapter13.Section07.PlusAction.Original
