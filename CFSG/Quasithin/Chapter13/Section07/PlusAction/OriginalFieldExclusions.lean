module
public import CFSG.Quasithin.Chapter13.Section07.PlusAction.OriginalSelectedModels
public import CFSG.Quasithin.ChapterA.Section03.OddPrime.SourceModels.G2CubicResidual
public import CFSG.Quasithin.ChapterA.Section03.OddPrime.SourceModels.SymplecticCubicResidual

/-!
# Larger rank-two field models in the selected plus kernel

The genuine G₂ and Sp₄ cubic-residual theorems apply to the selected
component image in H/O₂(H), over every characteristic-two field of order
larger than two. That image contains every cubic element of the quotient.
The point residual is generated by cubic elements, while both the selected
component and O₂(H) lie in the plus kernel. Pullback would put the point
residual in that kernel, contradicting its original nontrivial seed action.

The two exclusions use the literal intrinsic and ambient two-core quotient
maps. Neither component normality nor the five-model source list is assumed.
They discharge the larger Sp₄ and G₂ rows of the selected FF classification.

Source: Aschbacher--Smith A.3.18 and 13.7.4(1), printed pp.51--53 and 937.
-/

public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter13.Section07.PlusAction
open Section08.SourceCompletion
variable {G : Type*} [Group G] [Finite G]
  {T : Sylow 2 G} {L V V₁ V₂ V₃ M G₁ H : Subgroup G}
  (d : NaturalSetup T L V V₁ V₂ V₃ M G₁)
include d

private theorem source_Hbar_sqtk
    (h : (ConjugateIntersections.sourceSetup T L V V₃ V₁ H).Hypothesis) :
    IsSQTK KnownSimple.IsKnownSimple (H ⧸ pCore 2 H) := by
  have hp : IsPGroup 2 V₁ := IsPGroup.of_card (n := 1) (by simpa using d.line_card)
  have hn : V₁ ≠ ⊥ := by
    intro he
    have hc := d.line_card
    rw [he,card_bot] at hc
    contradiction
  have hloc : IsTwoLocal (normalizer (V₁ : Set G)) := ⟨V₁,hn,hp,rfl⟩
  have hHN : H ≤ normalizer (V₁ : Set G) :=
    h.H_centralizes.trans (Subgroup.centralizer_le_normalizer _)
  have hH := (IsSQTK.equiv (subgroupOfEquivOfLe hHN)).mp
    ((d.counterexample.qtke.twoLocal_sqtk hloc).subgroup (H.subgroupOf (normalizer (V₁ : Set G))))
  refine ⟨?_,hH.isKGroup.quotient _⟩
  intro p hp ho
  let : Fact p.Prime := ⟨hp⟩
  exact (primeRank_quotient_le_of_isTwoGroup p ho (pCore 2 H) pCore_isPGroup).trans
    (hH.stronglyQuasithin p hp ho)

private theorem source_kernel_component_residual_image_false
    (h : (ConjugateIntersections.sourceSetup T L V V₃ V₁ H).Hypothesis)
    (hne : ⁅V₃,G₁.pCoreIn 2⁆ ≠ ⊥)
    (J : Subgroup H)
    (hJC : J.map H.subtype ≤ kernel (ConjugateIntersections.sourceSetup T L V V₃ V₁ H))
    (he : J.map (QuotientGroup.mk' (pCore 2 H)) = primeToResidual 3 (H ⧸ pCore 2 H)) : False := by
  let F := ConjugateIntersections.sourceSetup T L V V₃ V₁ H
  let C := (kernel F).subgroupOf H
  let q := QuotientGroup.mk' (pCore 2 H)
  have hJC' : J ≤ C := map_le_iff_le_comap.mp hJC
  have hQC : pCore 2 H ≤ C := by
    intro x hx
    exact core_le_kernel h (mem_map_of_mem H.subtype hx)
  have hCQ : (C.map q).comap q = C := by
    rw [comap_map_eq,QuotientGroup.ker_mk',sup_eq_left.mpr hQC]
  apply (local_residual_not_le_kernel d h hne)
  rw [source_local_residual_eq d h, ←ModelExclusions.point_residual_cubic_generated d]
  apply (closure_le _).mpr
  rintro x ⟨hx,horder⟩
  have hxH : x ∈ H := (le_sup_left.trans h.local_le)
    ((source_local_residual_eq d h).symm ▸ hx)
  let xH : H := ⟨x,hxH⟩
  have hxp : q xH ∈ primeToResidual 3 (H ⧸ pCore 2 H) := by
    apply mem_primeToResidual_of_pow (n := 1)
    have ho : orderOf xH = 3 := (H.orderOf_coe xH).symm.trans horder
    rw [pow_one,←map_pow,←ho,pow_orderOf_eq_one,map_one]
  have hxc : xH ∈ (C.map q).comap q := (map_mono hJC') (he.symm ▸ hxp)
  have hxc' : xH ∈ C := hCQ ▸ hxc
  exact hxc'

omit d [Finite G] in
private theorem source_component_quotient_quasisimple
    (J : Subgroup H) (hJ : J.IsCComponent) (hs : IsSimpleGroup (J ⧸ pCore 2 J)) :
    IsQuasisimple (J ⧸ pCore 2 J) := by
  let := hs
  let : Group.IsPerfect J := hJ.perfect
  let : Group.IsPerfect (J ⧸ pCore 2 J) :=
    Group.IsPerfect.ofSurjective (QuotientGroup.mk'_surjective _)
  have hz : center (J ⧸ pCore 2 J) = ⊥ := center_eq_bot_of_simple_perfect
  exact { toIsPerfect := inferInstance
          simple := ((QuotientGroup.quotientMulEquivOfEq hz).trans QuotientGroup.quotientBot).isSimpleGroup }

/-- A larger binary symplectic quotient cannot occur in the original plus kernel. -/
theorem source_kernel_component_symplectic_large_false
    (h : (ConjugateIntersections.sourceSetup T L V V₃ V₁ H).Hypothesis)
    (hne : ⁅V₃,G₁.pCoreIn 2⁆ ≠ ⊥)
    (J : Subgroup H) (hJ : J.IsCComponent) (hs : IsSimpleGroup (J ⧸ pCore 2 J))
    (hJC : J.map H.subtype ≤ kernel (ConjugateIntersections.sourceSetup T L V V₃ V₁ H))
    {F : Type*} [Field F] [Finite F] [CharP F 2] (hF : 2 < Nat.card F)
    (e : (J ⧸ pCore 2 J) ≃* Matrix.symplecticGroup (Fin 2) F) : False := by
  let := hs
  let := pCore_isNilpotent (p := 2) (G := H)
  let q := QuotientGroup.mk' (pCore 2 H)
  let B := J.map q
  let : IsQuasisimple (J ⧸ pCore 2 J) := source_component_quotient_quasisimple J hJ hs
  let eB : (J ⧸ pCore 2 J) ≃* B := cComponentTwoCoreQuotientEquiv hJ
  let : IsQuasisimple B := IsQuasisimple.of_mulEquiv eB
  let : IsSimpleGroup B := eB.symm.isSimpleGroup
  have hB : IsComponent (H ⧸ pCore 2 H) B := ⟨(hJ.map_quotient _).subnormal,inferInstance⟩
  have hz : center B = ⊥ := center_eq_bot_of_simple_perfect
  let eZ : (B ⧸ center B) ≃* Matrix.symplecticGroup (Fin 2) F :=
    ((QuotientGroup.quotientMulEquivOfEq hz).trans QuotientGroup.quotientBot).trans (eB.symm.trans e)
  have hres := (ChapterA.Section03.OddPrime.SourceModels.SymplecticCubicResidual.component_eq_primeClosure_and_residual
    (source_Hbar_sqtk d h) hB (hz.symm ▸ IsPGroup.of_bot) hF eZ).2
  exact source_kernel_component_residual_image_false d h hne J hJC hres

/-- A larger binary G₂ quotient cannot occur in the original plus kernel. -/
theorem source_kernel_component_g2_large_false
    (h : (ConjugateIntersections.sourceSetup T L V V₃ V₁ H).Hypothesis)
    (hne : ⁅V₃,G₁.pCoreIn 2⁆ ≠ ⊥)
    (J : Subgroup H) (hJ : J.IsCComponent) (hs : IsSimpleGroup (J ⧸ pCore 2 J))
    (hJC : J.map H.subtype ≤ kernel (ConjugateIntersections.sourceSetup T L V V₃ V₁ H))
    {F : Type*} [Field F] [Finite F] [CharP F 2] (hF : 2 < Nat.card F)
    (e : (J ⧸ pCore 2 J) ≃* Atlas.G2.Model F) : False := by
  let := hs
  let := pCore_isNilpotent (p := 2) (G := H)
  let q := QuotientGroup.mk' (pCore 2 H)
  let B := J.map q
  let : IsQuasisimple (J ⧸ pCore 2 J) := source_component_quotient_quasisimple J hJ hs
  let eB : (J ⧸ pCore 2 J) ≃* B := cComponentTwoCoreQuotientEquiv hJ
  let : IsQuasisimple B := IsQuasisimple.of_mulEquiv eB
  let : IsSimpleGroup B := eB.symm.isSimpleGroup
  have hB : IsComponent (H ⧸ pCore 2 H) B := ⟨(hJ.map_quotient _).subnormal,inferInstance⟩
  have hz : center B = ⊥ := center_eq_bot_of_simple_perfect
  let eZ : (B ⧸ center B) ≃* Atlas.G2.Model F :=
    ((QuotientGroup.quotientMulEquivOfEq hz).trans QuotientGroup.quotientBot).trans (eB.symm.trans e)
  have hres := (ChapterA.Section03.OddPrime.SourceModels.G2CubicResidual.component_eq_primeClosure_and_residual
    (source_Hbar_sqtk d h) hB (hz.symm ▸ IsPGroup.of_bot) hF eZ).2
  exact source_kernel_component_residual_image_false d h hne J hJC hres

end CFSG.Quasithin.Chapter13.Section07.PlusAction
