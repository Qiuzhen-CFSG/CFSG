module
public import CFSG.Quasithin.Chapter13.Section05.AmbientSource.ParabolicCentralizer
public import CFSG.Quasithin.Chapter13.Section07.PlusAction.MixedCentralizer
public import CFSG.Quasithin.Chapter13.Section07.PlusAction.OriginalCubicShape

/-!
# The nonzero original mixed commutator

The original natural seed is generated by the point residual. If the
mixed commutator `[U0,L1,K]` vanished, the seed-centralizer test would put
K in `C_G(V3)`, and the original plane noncentrality bounds that centralizer
by M. This contradicts the selected actor's escape from M. The cubic
consumer supplies the quotient-centralization premise from its actual
order-three quotient and its original relative normality.

Source: Aschbacher--Smith 13.7.4(1), printed p.938. This proves the mixed
movement used by the later minimal-module choice without constructing
the auxiliary tilde-one section.
-/

public section
open Subgroup
namespace CFSG.Quasithin.Chapter13.Section07.PlusAction
variable {G : Type*} [Group G] [Finite G]

namespace Original
variable {T : Sylow 2 G} {L V V₁ V₂ V₃ M G₁ H : Subgroup G}

/-- The original plane hypothesis forces nonzero mixed movement. -/
theorem source_kernel_mixed_commutator_ne_bot
    (d : Section08.SourceCompletion.NaturalSetup T L V V₁ V₂ V₃ M G₁)
    (h1221 : Chapter12.Section02.Hypothesis1221 KnownSimple.IsKnownSimple T L)
    (h : (ConjugateIntersections.sourceSetup T L V V₃ V₁ H).Hypothesis)
    (eL : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 6))
    (hm : ⁅(normalizer (V₁ : Set G)).pCoreIn 2,V₂⁆ ≠ ⊥)
    {K : Subgroup G}
    (hKC : K ≤ kernel (ConjugateIntersections.sourceSetup T L V V₃ V₁ H))
    (hp : IsPPerfect 2 K) (hout : ¬ K ≤ M)
    (hKA : ⁅K,(ConjugateIntersections.sourceSetup T L V V₃ V₁ H).L₁⁆ ≤ H.pCoreIn 2) :
    ⁅⁅fixedLayer (ConjugateIntersections.sourceSetup T L V V₃ V₁ H),
      (ConjugateIntersections.sourceSetup T L V V₃ V₁ H).L₁⁆,K⁆ ≠ ⊥ := by
  let F := ConjugateIntersections.sourceSetup T L V V₃ V₁ H
  change ⁅⁅fixedLayer F,F.L₁⁆,K⁆ ≠ ⊥
  have hKA' : ⁅K,F.L₁⁆ ≤ F.QH := by
    exact hKA
  intro hmix
  apply hout
  have hseed : ⁅F.Vplus,F.L₁⁆ = F.Vplus := by
    change ⁅V₃,F.L₁⁆ = V₃
    rw [source_local_residual_eq d h]
    exact ModelExclusions.seed_commutator_point_residual d
  have hc : K ≤ centralizer (F.Vplus : Set G) :=
    kernel_seed_centralization_of_mixed_trivial (F := F) h
      (A := F.L₁) (le_sup_left.trans h.local_le) hKC hp hKA'
      hseed hmix
  exact hc.trans ((Section05.AmbientSource.source_parabolic_centralizer d eL h1221 hm).trans inf_le_left)

/-- The actual selected cubic actor supplies the required quotient centralization. -/
theorem source_primitive_cubic_mixed_commutator_ne_bot
    (d : Section08.SourceCompletion.NaturalSetup T L V V₁ V₂ V₃ M G₁)
    (h1221 : Chapter12.Section02.Hypothesis1221 KnownSimple.IsKnownSimple T L)
    (h : (ConjugateIntersections.sourceSetup T L V V₃ V₁ H).Hypothesis)
    (eL : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 6))
    (hm : ⁅(normalizer (V₁ : Set G)).pCoreIn 2,V₂⁆ ≠ ⊥)
    (J : Subgroup H)
    (hJC : J.map H.subtype ≤ kernel (ConjugateIntersections.sourceSetup T L V V₃ V₁ H))
    (hJn : H ≤ normalizer (J.map H.subtype : Set G))
    (hp : IsPPerfect 2 (J.map H.subtype)) (hout : ¬ J.map H.subtype ≤ M)
    (hcard : Nat.card (J ⧸ pCore 2 J) = 3) :
    let F := ConjugateIntersections.sourceSetup T L V V₃ V₁ H
    ⁅⁅fixedLayer F,F.L₁⁆,J.map H.subtype⁆ ≠ ⊥ := by
  apply source_kernel_mixed_commutator_ne_bot d h1221 h eL hm hJC hp hout
  exact (source_primitive_cubic_centralized h J hJn hcard).trans
    (subnormal_core_le (D := ConjugateIntersections.sourceSetup T L V V₃ V₁ H) (map_subtype_le J)
      (normal_subgroupOf_of_le_normalizer hJn).isSubnormal)

end Original
end CFSG.Quasithin.Chapter13.Section07.PlusAction
