module
public import Theory.Representation.BinaryOffender.MinimalPlane
public import CFSG.Quasithin.Chapter13.Section07.ComponentSelection

/-!
# The selected component contains the original offender displacement

The whole original seed-plane bound and minimality imply that every invariant
noncentral subspace contains the offender displacement. The chosen component
is perfect and generated by its commutators with the offender, so its moved
space is noncentral for that offender. Thus the literal plus action satisfies
[U+,B*] ≤ [U+,K*], with no irreducibility or model premise.

Source: Aschbacher–Smith13.7.15, printed pp.943–944. The genuine earlier
F.9 applicability, seed geometry and13.7.4 kernel equality remain explicit.
-/

public section
open Subgroup Representation Representation.BinaryOffender Theory.GroupTheory
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter13.Section07
open Section08.SourceCompletion ChapterF.Section09.Setup
variable {G : Type*} [Group G] [Finite G]
  {T : Sylow 2 G} {L V V₁ V₂ V₃ M G₁ H : Subgroup G}
  (d : NaturalSetup T L V V₁ V₂ V₃ M G₁)
include d
theorem source_plus_component_contains_offender_displacement
    (h : (ConjugateIntersections.sourceSetup T L V V₃ V₁ H).Hypothesis)
    (hU : IsMulCommutative (Section08.Source.UH H V₃))
    (hV : ¬ IsMulCommutative (Section08.Source.VH H V))
    (hne : ⁅V₃,G₁.pCoreIn 2⁆ ≠ ⊥)
    (g : (L ⊔ (T : Subgroup G) : Subgroup G))
    (hs : (QuotientGroup.mk' (pCore 2 (L ⊔ (T : Subgroup G) : Subgroup G)) g)^2 = 1)
    (hout : ¬ conjugate V₁ (g : G) ≤ Section08.Source.UH H V₃)
    {W : Type*} [AddCommGroup W] [Module (ZMod 2) W] [FiniteDimensional (ZMod 2) W]
    (σ : Representation (ZMod 2) (H ⧸ pCore 2 H) W)
    (s : Representation.BinaryConjugationSection H (Section08.Source.UH H V₃)
      ((Section08.Source.UH H V₃) ⊓ centralizer (H.pCoreIn 2 : Set G))
      (σ.comp (QuotientGroup.mk' (pCore 2 H))))
    (B : Subgroup (H ⧸ pCore 2 H)) (hB : IsMinimalBestOffender σ B)
    (hBA : B ≤ ((conjugate (Section08.Source.VH H V) (g : G) ⊓
      (L ⊔ (T : Subgroup G) : Subgroup G).pCoreIn 2).subgroupOf H).map
        (QuotientGroup.mk' (pCore 2 H)))
    (K : Subgroup H) (hK : IsComponent (H ⧸ pCore 2 H)
      (K.map (QuotientGroup.mk' (pCore 2 H))))
    (hk : PlusAction.kernel (ConjugateIntersections.sourceSetup T L V V₃ V₁ H) = H.pCoreIn 2)
    (hcomm : ⁅K.map (QuotientGroup.mk' (pCore 2 H)),B⁆ = K.map (QuotientGroup.mk' (pCore 2 H))) :
    subspaceCommutator σ ⊤ B ≤ subspaceCommutator σ ⊤ (K.map (QuotientGroup.mk' (pCore 2 H))) := by
  let J := K.map (QuotientGroup.mk' (pCore 2 H))
  let : IsQuasisimple J := hK.2
  let : IsSimpleGroup (J ⧸ center J) := IsQuasisimple.simple
  let : Nontrivial J := (QuotientGroup.mk'_surjective (center J)).nontrivial
  have hJ : J ≠ ⊥ := (Subgroup.nontrivial_iff_ne_bot J).mp inferInstance
  have hp := source_plus_seed_plane d h hU hV hne g hs hout σ s B hBA
  exact hB.moved_le_moved_perfect σ (source_plus_faithful_of_kernel_eq σ s hk) hJ
    ((Submodule.finrank_mono hp.2).trans_eq hp.1) hcomm

end CFSG.Quasithin.Chapter13.Section07
