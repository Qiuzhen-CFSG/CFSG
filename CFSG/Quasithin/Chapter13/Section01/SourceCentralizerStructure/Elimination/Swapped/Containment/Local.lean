/-!
# The literal Sylow complement in the exchanged centralizer orbit

Every Sylow p-subgroup of the canonical radical supplements its two-core.
That core lies in T_u, so the products P T_u and T_u P are the same subgroup.
Frattini factorization of T_u then adjusts a component exchanger into
N_{T_u}(P), since the entire radical normalizes K. These arguments require
no irreducibility of T_u on the odd Frattini quotient. The irreducible actor
retained below is the actual local point centralizer.

Source: Aschbacher--Smith, 13.1.12(3), printed p.874.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
open scoped Pointwise
namespace CFSG.Quasithin.Chapter13.Section01.SourceCentralizerStructure.Elimination
open Chapter1 Chapter1.Section02 Chapter1.XiEmbedding Chapter1.RadicalActions
open SourceNonquasisimple Chapter1.RadicalNormalizers
variable {G : Type*} [Group G] [Finite G]
variable {T : Sylow 2 G} {L K : Subgroup G} {p : ℕ} [Fact p.Prime] {u : G}

/-- The two-core of the original radical is contained in the point Sylow. -/
theorem Context.radical_core_le_point_sylow (h : Context T L p)
    (s : Selected T L u) :
    (XiP p L).pCoreIn 2 ≤ (T : Subgroup G) ⊓ centralizer ({u} : Set G) := by
  let M := normalizer (L : Set G) ⊓ centralizer ({u} : Set G)
  have hXM : XiP p L ≤ M := XiP_le_moved_centralizer h.hypothesis h.many
    h.maximal.1 h.nonquasisimple p s.mem
  have hc : (XiP p L).pCoreIn 2 ≤ M.pCoreIn 2 :=
    pCoreIn_mono_of_normalizes hXM (XiP_invariant p inf_le_left)
  obtain ⟨S,hS⟩ := s.local_sylow
  exact hc.trans ((pCoreIn_le_sylow M S).trans_eq hS)

/-- The actual complement has the source elementary/extraspecial quotient type. -/
theorem Context.swapped_complement_shape (h : Context T L p)
    (P : Sylow p (XiP p L)) :
    XiOddQuotient p ((P : Subgroup (XiP p L)).map (XiP p L).subtype) := by
  have hq := (XiP_oddQuotient_of_A36
    (ChapterA.SQTKStructure.a36Input_of_theoremsAC
      (fun _ _ _ => ChapterA.Section02.theoremA_knownSimple)
      (fun _ _ _ => ChapterA.Section02.theoremC_knownSimple))
    h.maximal.1.1 (uniqueness_local_quotient_sqtk h.hypothesis.simpleQTKE h.maximal.1.1.2.2)
    h.nonquasisimple h.odd h.divides).2
  exact hq.of_mulEquiv (ambientSylowQuotientEquiv h.odd hq.isPGroup P).symm

/-- Frattini factorization holds for T_u independently of its irreducibility. -/
theorem Context.point_sylow_normalizer_factor (h : Context T L p)
    (s : Selected T L u) (P : Sylow p (XiP p L)) :
    (T : Subgroup G) ⊓ centralizer ({u} : Set G) =
      (XiP p L).pCoreIn 2 ⊔
        (((T : Subgroup G) ⊓ centralizer ({u} : Set G)) ⊓
          normalizer ((P : Subgroup (XiP p L)).map (XiP p L).subtype : Set G)) := by
  exact normalizer_factor (inf_le_left.trans (XiP_invariant p h.sylow_normalizes))
    (h.radical_core_le_point_sylow s) (XiP_quotient_isPGroup p h.odd L) P

/-- P T_u is literally the subgroup generated by X and T_u. -/
theorem Context.complement_point_sylow_product (h : Context T L p)
    (s : Selected T L u) (P : Sylow p (XiP p L)) :
    ((XiP p L ⊔ ((T : Subgroup G) ⊓ centralizer ({u} : Set G)) : Subgroup G) : Set G) =
      (((P : Subgroup (XiP p L)).map (XiP p L).subtype) : Set G) *
        (((T : Subgroup G) ⊓ centralizer ({u} : Set G)) : Set G) := by
  let X := XiP p L
  let S := (T : Subgroup G) ⊓ centralizer ({u} : Set G)
  let P₀ := (P : Subgroup X).map X.subtype
  have hPS : P₀ ≤ X := map_subtype_le _
  have hPQ : P₀ ≤ normalizer (X.pCoreIn 2 : Set G) := hPS.trans
    (X.le_normalizer.trans (normalizer_le_normalizer_characteristic_image X (pCore 2 X)))
  have hX : (X : Set G) = (P₀ : Set G) * X.pCoreIn 2 := by
    rw [← coe_mul_of_left_le_normalizer_right P₀ _ hPQ, sup_comm,
      sylow_sup (XiP_quotient_isPGroup p h.odd L) P]
  have hSX : S ≤ normalizer (X : Set G) :=
    inf_le_left.trans (XiP_invariant p h.sylow_normalizes)
  change ((X ⊔ S : Subgroup G) : Set G) = (P₀ : Set G) * S
  rw [coe_mul_of_right_le_normalizer_left X S hSX, hX, mul_assoc]
  congr 1
  apply Set.Subset.antisymm
  · exact Subgroup.mul_subset (h.radical_core_le_point_sylow s) le_rfl
  · intro t ht
    exact ⟨1, one_mem _, t, ht, one_mul _⟩

/-- The source equality P T_u = T_u P, with no Sylow-action premise. -/
theorem Context.complement_point_sylow_permutable (h : Context T L p)
    (s : Selected T L u) (P : Sylow p (XiP p L)) :
    (((P : Subgroup (XiP p L)).map (XiP p L).subtype) : Set G) *
        (((T : Subgroup G) ⊓ centralizer ({u} : Set G)) : Set G) =
      (((T : Subgroup G) ⊓ centralizer ({u} : Set G)) : Set G) *
        (((P : Subgroup (XiP p L)).map (XiP p L).subtype) : Set G) := by
  let X := XiP p L
  let S := (T : Subgroup G) ⊓ centralizer ({u} : Set G)
  let P₀ := (P : Subgroup X).map X.subtype
  have he := h.complement_point_sylow_product s P
  change ((X ⊔ S : Subgroup G) : Set G) = (P₀ : Set G) * S at he
  change (P₀ : Set G) * S = (S : Set G) * P₀
  rw [← he]
  apply Set.Subset.antisymm
  · intro g hg
    have hgi : g⁻¹ ∈ ((X ⊔ S : Subgroup G) : Set G) := inv_mem hg
    rw [he] at hgi
    obtain ⟨a,ha,t,ht,hat⟩ := hgi
    refine ⟨t⁻¹,inv_mem ht,a⁻¹,inv_mem ha,?_⟩
    simpa only [mul_inv_rev,inv_inv] using congrArg Inv.inv hat
  · exact Subgroup.mul_subset (show S ≤ X ⊔ S from le_sup_right)
      ((map_subtype_le _).trans (show X ≤ X ⊔ S from le_sup_left))

/-- The component exchanger can be chosen in the normalizer of any chosen P. -/
theorem Context.exists_point_sylow_complement_exchange (h : Context T L p)
    (o : OrbitFacts T L p) (s : Selected T L u) (e : Escape T L p u K)
    (hr : ¬ ComponentNormalizerIrreducible L K p u) (P : Sylow p (XiP p L)) :
    ∃ t ∈ ((T : Subgroup G) ⊓ centralizer ({u} : Set G)) ⊓
        normalizer ((P : Subgroup (XiP p L)).map (XiP p L).subtype : Set G),
      t ∉ normalizer (K : Set G) := by
  have hH := h.hypothesis.simpleQTKE.involution_centralizer_sqtk
    (h.involution s.mem s.ne_one)
  have hmove := h.component_moved_of_reducible o s e hH hr
  have hc : (XiP p L).pCoreIn 2 ≤ normalizer (K : Set G) :=
    (pCoreIn_le 2 _).trans e.normalized
  by_contra! hn
  apply hmove
  rw [h.point_sylow_normalizer_factor s P]
  exact sup_le hc hn

/-- Irreducibility transfers to N_{M_u}(P), with the original quotient action. -/
theorem Context.point_normalizer_complement_irreducible (h : Context T L p)
    (o : OrbitFacts T L p) (s : Selected T L u) (P : Sylow p (XiP p L)) :
    let P₀ := (P : Subgroup (XiP p L)).map (XiP p L).subtype
    let N := (normalizer (L : Set G) ⊓ centralizer ({u} : Set G)) ⊓ normalizer (P₀ : Set G)
    ∀ A : Subgroup (P₀ ⧸ frattini P₀),
      (∀ n : N, ∀ a ∈ A, frattiniConjugationAction N P₀ inf_le_right n a ∈ A) →
        A = ⊥ ∨ A = ⊤ := by
  have hXM := XiP_le_moved_centralizer h.hypothesis h.many h.maximal.1
    h.nonquasisimple p s.mem
  exact normalizer_irreducible (XiP_invariant p inf_le_left)
    ((pCoreIn_le 2 _).trans hXM) (h.selected_irreducible o s) h.odd
    (XiP_quotient_isPGroup p h.odd L) P

/-- The actual local product is solvable, for the later Borel restrictions. -/
theorem Context.point_radical_join_solvable (h : Context T L p) {u : G} :
    Group.IsSolvable
      (XiP p L ⊔ ((T : Subgroup G) ⊓ centralizer ({u} : Set G)) : Subgroup G) := by
  let X := XiP p L
  let S := (T : Subgroup G) ⊓ centralizer ({u} : Set G)
  let A := X.subgroupOf (X ⊔ S)
  let B := S.subgroupOf (X ⊔ S)
  let : Group.IsNilpotent (XiQuotient X) := (XiP_quotient_isPGroup p h.odd L).isNilpotent
  let : Group.IsNilpotent (pCore 2 X) := pCore_isPGroup.isNilpotent
  let : Group.IsSolvable X := (Group.isSolvable_iff_subgroup_quotient (pCore 2 X)).mpr
    ⟨inferInstance,inferInstance⟩
  let := (T.isPGroup'.to_le (show S ≤ (T : Subgroup G) from inf_le_left)).isNilpotent
  let : A.Normal := normal_subgroupOf_of_le_normalizer
    (sup_le X.le_normalizer (inf_le_left.trans (XiP_invariant p h.sylow_normalizes)))
  let : Group.IsSolvable A := Group.isSolvable_of_isSolvable_injective
    (f := (subgroupOfEquivOfLe (show X ≤ X ⊔ S from le_sup_left)).toMonoidHom)
    (subgroupOfEquivOfLe (show X ≤ X ⊔ S from le_sup_left)).injective
  let : Group.IsSolvable B := Group.isSolvable_of_isSolvable_injective
    (f := (subgroupOfEquivOfLe (show S ≤ X ⊔ S from le_sup_right)).toMonoidHom)
    (subgroupOfEquivOfLe (show S ≤ X ⊔ S from le_sup_right)).injective
  apply Group.isSolvable_of_normal_sup_eq_top A B
  apply map_injective (X ⊔ S).subtype_injective
  simp only [A,B,Subgroup.map_sup,map_subgroupOf_eq_of_le le_sup_left,
    map_subgroupOf_eq_of_le le_sup_right,← MonoidHom.range_eq_map,range_subtype]

omit [Fact p.Prime] in
/-- The full centralizer Sylow restricts to the relatively normal orbit. -/
theorem Context.swapped_orbit_sylow (h : Context T L p)
    (s : Selected T L u) (e : Escape T L p u K) :
    IsSylowIn 2 (((T : Subgroup G) ⊓ centralizer ({u} : Set G)) ⊓
      componentOrbit K ((T : Subgroup G) ⊓ centralizer ({u} : Set G)))
      (componentOrbit K ((T : Subgroup G) ⊓ centralizer ({u} : Set G))) := by
  have hH := h.hypothesis.simpleQTKE.involution_centralizer_sqtk
    (h.involution s.mem s.ne_one)
  exact IndexTwo.isSylowIn_inf_of_subnormal e.full_sylow
    ((componentOrbit_le_sup _ _).trans (sup_le e.component.1 inf_le_right))
    (e.orbit_normal hH).isSubnormal

/-- The literal odd complement embeds through the ambient centralizer two-core;
the full normalizer of its image acts irreducibly. -/
theorem Context.swapped_quotient_complement (h : Context T L p)
    (o : OrbitFacts T L p) (s : Selected T L u) (P : Sylow p (XiP p L)) :
    let P₀ := (P : Subgroup (XiP p L)).map (XiP p L).subtype
    let R := quotientImage (centralizer ({u} : Set G)) P₀
    XiOddQuotient p R ∧ IsNormalizerFrattiniIrreducible R := by
  let H := centralizer ({u} : Set G)
  let P₀ := (P : Subgroup (XiP p L)).map (XiP p L).subtype
  let N := (normalizer (L : Set G) ⊓ H) ⊓ normalizer (P₀ : Set G)
  let R := P₀.subgroupOf H
  let q := QuotientGroup.mk' (pCore 2 H)
  have hPH : P₀ ≤ H := (map_subtype_le _).trans
    ((XiP_le_moved_centralizer h.hypothesis h.many h.maximal.1
      h.nonquasisimple p s.mem).trans inf_le_right)
  have hshape : XiOddQuotient p R :=
    (h.swapped_complement_shape P).of_mulEquiv (subgroupOfEquivOfLe hPH).symm
  have hi : Function.Injective (q.subgroupMap R) := by
    apply (MonoidHom.ker_eq_bot_iff _).mp
    rw [Subgroup.ker_subgroupMap,QuotientGroup.ker_mk']
    apply bot_unique
    intro a ha
    exact Subtype.ext ((pCore_isPGroup.disjoint_of_coprime hshape.isPGroup
      (Nat.coprime_two_left.mpr h.odd)).le_bot ⟨ha,a.property⟩)
  have hirr : IsNormalizerFrattiniIrreducible R :=
    normalizerFrattiniIrreducible_subgroupOf P₀ N H hPH
      (inf_le_left.trans inf_le_right) inf_le_right
      (h.point_normalizer_complement_irreducible o s P)
  exact ⟨hshape.of_mulEquiv (MulEquiv.ofBijective (q.subgroupMap R)
      ⟨hi,q.subgroupMap_surjective R⟩),
    normalizerFrattiniIrreducible_map q R (normalizer (R : Set H)) le_rfl hi hirr⟩

/-- A normal subgroup of the centralizer containing the complement contains X.
Two-perfectness removes the two-core supplement. -/
theorem Context.radical_le_of_complement_le (h : Context T L p)
    (s : Selected T L u) (P : Sylow p (XiP p L)) (D : Subgroup G)
    (hDH : D ≤ centralizer ({u} : Set G))
    (hD : (D.subgroupOf (centralizer ({u} : Set G))).Normal)
    (hPD : (P : Subgroup (XiP p L)).map (XiP p L).subtype ≤ D) : XiP p L ≤ D := by
  have hXH := (XiP_le_moved_centralizer h.hypothesis h.many h.maximal.1
    h.nonquasisimple p s.mem).trans inf_le_right
  apply le_of_isPPerfect_of_le_sup_of_normalizes (XiP p L) D ((XiP p L).pCoreIn 2)
    (XiP_isPPerfect p L) (isPGroup_pCoreIn 2 _)
    (((pCoreIn_le 2 _).trans hXH).trans ((normal_subgroupOf_iff_le_normalizer hDH).mp hD))
  exact (sylow_sup (XiP_quotient_isPGroup p h.odd L) P).symm.le.trans
    (sup_le le_sup_right (hPD.trans le_sup_left))

