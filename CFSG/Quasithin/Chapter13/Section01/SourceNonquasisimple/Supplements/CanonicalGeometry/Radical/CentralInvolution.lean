module
public import CFSG.Quasithin.Chapter13.Section01.SourceNonquasisimple.Supplements.CanonicalGeometry.Radical.Inversion

/-!
# The distinguished central radical involution in 13.1.9

The image of the literal R intersect L in L/O₂(L) is a two-group inside
its solvable radical. The Fitting subgroup has odd order and index two
in that radical, so the image has order two. Nontriviality comes from
the already constructed original inverter.

Thus every original lift in R intersect L has the same nontrivial image.
Conjugating by any element of R preserves this intersection, so the
involution is central in the whole R/O₂(LT), and its original action
inverts the full mixed-prime Fitting/Frattini section.

This does not prove that the whole radical image is cyclic or that its
entire first omega subgroup is generated by this central involution.
Those remain the source cyclicity obligation; no single-prime or
exponent-one assumption is introduced here.

Source: Aschbacher--Smith, first paragraph of the proof of 13.1.9,
printed p.869, using the full A.3.6 alternatives, pp.43--45.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter13.Section01.SourceNonquasisimple.Supplements
open Chapter1 Chapter1.Section02
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L : Subgroup G}

/-- The actual image of R intersect L in L/O₂(L). -/
@[expose] def radicalLocalTwoCoreImage (T L : Subgroup G) : Subgroup (XiQuotient L) :=
  ((radicalSylowCentralizer T L).subgroupOf L).map (QuotientGroup.mk' (pCore 2 L))

private theorem radicalSylowCentralizer_subgroupOf_le_radical
    (hTL : (T : Subgroup G) ≤ normalizer (L : Set G)) :
    (radicalSylowCentralizer T L).subgroupOf L ≤ solvableRadical L := by
  let W := L ⊔ (T : Subgroup G)
  let E := (solvableRadical W).map W.subtype
  have hWE : W ≤ normalizer (E : Set G) := W.le_normalizer.trans
    (normalizer_le_normalizer_characteristic_image W (solvableRadical W))
  let : (E.subgroupOf L).Normal :=
    normal_subgroupOf_of_le_normalizer (le_sup_left.trans hWE)
  let : Group.IsSolvable E := Group.isSolvable_of_surjective
    (W.subtype.subgroupMap_surjective (solvableRadical W))
  let f := L.subtype.subgroupComap E
  let : Group.IsSolvable (E.subgroupOf L) :=
    Group.isSolvable_of_isSolvable_injective (f := f)
      (fun a b he => Subtype.ext (Subtype.ext
        (congrArg (fun z : E => (z : G)) he)))
  exact (comap_mono ((radicalSylowCentralizer_eq_inf_radical T hTL).le.trans
    inf_le_right)).trans (le_solvableRadical (E.subgroupOf L) inferInstance inferInstance)

/-- Only the intersection with L is used: its actual quotient image has order two. -/
theorem radicalLocalTwoCoreImage_card_source
    (h : Hypothesis1311 T) (hL : Chapter12.Section02.FaithfulMaximalLocal T L)
    (hn : ¬ IsQuasisimple (XiQuotient L)) :
    Nat.card (radicalLocalTwoCoreImage T L) = 2 := by
  let P := radicalLocalTwoCoreImage (T : Subgroup G) L
  let K := XiQuotient L
  let q := QuotientGroup.mk' (pCore 2 L)
  let f := QuotientGroup.mk' (fittingSubgroup K)
  let A := (solvableRadical K).map f
  have hTL := radicalLocal_invariant_source hL.1.1
    (uniqueness_local_quotient_sqtk h.simpleQTKE hL.1.1.2.2) hn
  have hP : IsPGroup 2 P :=
    ((T.isPGroup'.to_le (radicalSylowCentralizer_le _ _)).comap_subtype).map q
  have hPr : P ≤ solvableRadical K :=
    (map_mono (radicalSylowCentralizer_subgroupOf_le_radical hTL)).trans
      (map_solvableRadical_le_of_surjective q (QuotientGroup.mk'_surjective _))
  have hA : Nat.card A = 2 := by
    rw [← relIndex_ker, QuotientGroup.ker_mk']
    exact radical_fitting_index_source h hL hn
  have hcop : Nat.Coprime 2 (Nat.card f.ker) := by
    rw [QuotientGroup.ker_mk']
    exact local_fitting_odd_source h hL
  let j : P →* A := (f.comp P.subtype).codRestrict A
    (fun x => mem_map_of_mem f (hPr x.property))
  have hji : Function.Injective j := fun x y he =>
    injective_comp_subtype_of_coprime_ker f hcop P hP
      (congrArg (fun a : A => (a : K ⧸ fittingSubgroup K)) he)
  have hle : Nat.card P ≤ 2 := (Nat.card_le_card_of_injective j hji).trans_eq hA
  obtain ⟨t, htR, ht⟩ := radical_fitting_involution_source h hL hn
  have htP : q t ∈ P := ⟨t, htR, rfl⟩
  have ht2 : orderOf (⟨q t, htP⟩ : P) = 2 := by
    have hjt : orderOf (j ⟨q t, htP⟩) = 2 :=
      (Subgroup.orderOf_coe _).symm.trans ht
    exact (orderOf_injective j hji _).symm.trans hjt
  have hd : 2 ∣ Nat.card P := by
    exact ht2.symm.dvd.trans (orderOf_dvd_natCard (x := (⟨q t, htP⟩ : P)))
  exact Nat.le_antisymm hle (Nat.le_of_dvd Nat.card_pos hd)

/-- The involution furnished by L is independent of its original lift inside R intersect L. -/
theorem radical_local_involution_eq_source
    (h : Hypothesis1311 T) (hL : Chapter12.Section02.FaithfulMaximalLocal T L)
    (hn : ¬ IsQuasisimple (XiQuotient L))
    (s t : L) (hs : (s : G) ∈ radicalSylowCentralizer T L)
    (ht : (t : G) ∈ radicalSylowCentralizer T L)
    (hso : orderOf (QuotientGroup.mk' (pCore 2 L) s) = 2)
    (hto : orderOf (QuotientGroup.mk' (pCore 2 L) t) = 2) :
    QuotientGroup.mk' (pCore 2 L) s = QuotientGroup.mk' (pCore 2 L) t := by
  let P := radicalLocalTwoCoreImage (T : Subgroup G) L
  let : IsCyclic P := isCyclic_of_prime_card (radicalLocalTwoCoreImage_card_source h hL hn)
  let a : P := ⟨QuotientGroup.mk' (pCore 2 L) s, ⟨s, hs, rfl⟩⟩
  let b : P := ⟨QuotientGroup.mk' (pCore 2 L) t, ⟨t, ht, rfl⟩⟩
  exact congrArg Subtype.val (IsCyclic.eq_of_orderOf_eq_two
    ((Subgroup.orderOf_coe a).symm.trans hso)
    ((Subgroup.orderOf_coe b).symm.trans hto))

/-- The distinguished involution coming from L is central in the whole radical image.
This does not assume cyclicity of that larger image. -/
theorem radical_local_involution_central_source
    (h : Hypothesis1311 T) (hL : Chapter12.Section02.FaithfulMaximalLocal T L)
    (hn : ¬ IsQuasisimple (XiQuotient L))
    (t : L) (ht : (t : G) ∈ radicalSylowCentralizer T L)
    (hto : orderOf (QuotientGroup.mk' (pCore 2 L) t) = 2) :
    radicalImageOfLocal (T := (T : Subgroup G)) (L := L) t ht ∈
      center (radicalTwoCoreImage T L) := by
  have hTL := radicalLocal_invariant_source hL.1.1
    (uniqueness_local_quotient_sqtk h.simpleQTKE hL.1.1.2.2) hn
  let R := radicalSylowCentralizer (T : Subgroup G) L
  let W := L ⊔ (T : Subgroup G)
  let q := QuotientGroup.mk' (pCore 2 L)
  let f := QuotientGroup.mk' (pCore 2 W)
  let e := radicalLocalQuotientEquiv hL.1.1
  apply mem_center_iff.mpr
  intro r
  obtain ⟨rW, hr, he⟩ := r.property
  let rN : normalizer (L : Set G) :=
    ⟨rW, hTL (radicalSylowCentralizer_le _ _ hr)⟩
  let s : L := L.normalizerMonoidHom rN t
  have hs : (s : G) ∈ R := R.mul_mem (R.mul_mem hr ht) (R.inv_mem hr)
  have hso : orderOf (q s) = 2 := by
    have hh := (quotientAut (pCore 2 L) (L.normalizerMonoidHom rN)).orderOf_eq (q t)
    rw [quotientAut_apply_mk] at hh
    exact hh.trans hto
  have hsame := radical_local_involution_eq_source h hL hn s t hs ht hso hto
  have hconj := congrArg (fun z : XiQuotient L => (e z : XiQuotient W)) hsame
  change f (rW * inclusion (show L ≤ W from le_sup_left) t * rW⁻¹) =
    f (inclusion (show L ≤ W from le_sup_left) t) at hconj
  simp only [map_mul, map_inv] at hconj
  apply Subtype.ext
  change (r : XiQuotient W) * f (inclusion le_sup_left t) =
    f (inclusion le_sup_left t) * (r : XiQuotient W)
  rw [← he]
  exact mul_inv_eq_iff_eq_mul.mp hconj

/-- A canonical central involution in the literal radical quotient, with its
original lift in L and its original action on the whole mixed-prime section. -/
theorem radical_central_involution_full_inversion_source
    (h : Hypothesis1311 T) (hL : Chapter12.Section02.FaithfulMaximalLocal T L)
    (hn : ¬ IsQuasisimple (XiQuotient L)) :
    ∃ (t : L) (ht : (t : G) ∈ radicalSylowCentralizer T L),
      orderOf (radicalImageOfLocal (T := (T : Subgroup G)) (L := L) t ht) = 2 ∧
      radicalImageOfLocal (T := (T : Subgroup G)) (L := L) t ht ∈
        center (radicalTwoCoreImage T L) ∧
      ∀ x : LocalFittingSection L,
        localFittingSectionAction L (inclusion L.le_normalizer t) x = x⁻¹ := by
  obtain ⟨t, ht, hto, hi⟩ := radical_involution_full_inversion_source h hL hn
  let e := radicalLocalQuotientEquiv hL.1.1
  have hqt : orderOf (QuotientGroup.mk' (pCore 2 L) t) = 2 :=
    (e.orderOf_eq _).symm.trans ((Subgroup.orderOf_coe _).symm.trans hto)
  exact ⟨t, ht, (Subgroup.orderOf_coe _).symm.trans hto,
    radical_local_involution_central_source h hL hn t ht hqt, hi⟩

end CFSG.Quasithin.Chapter13.Section01.SourceNonquasisimple.Supplements
