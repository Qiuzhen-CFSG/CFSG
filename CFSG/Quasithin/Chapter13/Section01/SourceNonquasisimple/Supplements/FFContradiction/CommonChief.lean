/-!
# A common chief section in the component and cubic branches

The double moved subgroup [[D,L_R],K] is nonzero in the actual candidate.
When K=Y, the refined source alternatives make K two-perfect. The two
normal factors commute on D, so commutator idempotence and the
three-subgroups lemma make this subgroup generated by each factor's
commutators. A maximal invariant quotient for the smaller group L_R K A
therefore carries both factors nontrivially.

The section is constructed inside the literal hat representation, with the
original quotient map and subgroup inclusions. The marked PSL₂(p) first
factor acts faithfully by simplicity. If the K-image is simple, the existing
faithful radical action gives zero actor rank loss on this constructed
section. The literal outside-candidate application retains the original
larger odd-prime alternative instead of assuming its section exists.

This closes the common-chief-section construction for the component and
cubic branches, not source 13.1.9. The controlled-index factorization,
larger odd-prime actor construction, tensor identification and final
generation remain with qt-d-1319-ff-contradiction. Earlier canonical
geometry remains with qt-d-1317-supplements and qt-d-1317-source.
Source: Aschbacher--Smith 13.1.9, printed pp.870--871.
-/

public noncomputable section
open Subgroup Stellmacher Theory.GroupTheory Representation Representation.BinaryOffender
open scoped IsMulCommutative
open CFSG.Quasithin ChapterB
namespace CFSG.Quasithin.Chapter13.Section01.SourceNonquasisimple.Supplements.FFContradiction


open Chapter1 Chapter1.Section02 Chapter1.Section02.Adequate
open Chapter12.Section02 ChapterA.Section04 Escape
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G}

/-- The literal double moved subgroup, viewed in the original binary module. -/
@[expose] def commonDoubleSpace (T L Y : Subgroup G) (j : ℕ)
    [(commonModule T L Y j).Normal] [IsElementaryAbelian 2 (commonModule T L Y j)] :
    Submodule (ZMod 2) (Additive (commonModule T L Y j)) :=
  NormalElementaryQuotient.subspace (commonModule T L Y j)
    ((⁅⁅commonModule T L Y j,(canonicalSupplement T L).subgroupOf (commonGroup T L Y j)⁆,
      (thompsonCommutator T L Y j).subgroupOf (commonGroup T L Y j)⁆).subgroupOf
        (commonModule T L Y j))

/-- A common chief section of the original hat action, for L_R K A. -/
abbrev CommonHatChief (T L Y A : Subgroup G) (j : ℕ)
    [(commonModule T L Y j).Normal] [IsElementaryAbelian 2 (commonModule T L Y j)] :=
  CommonChief.Data (hatRepresentation T L Y j)
    (hatImage T L Y j (canonicalSupplement T L))
    (hatImage T L Y j (thompsonCommutator T L Y j)) (hatImage T L Y j A)
    (commonDoubleSpace T L Y j)

private theorem witness_twoPerfect {L H C Y : Subgroup G}
    (w : RefinedWitness T L H C Y) : IsPPerfect 2 Y := by
  rcases w.refined with hY | hY | hY
  · exact mem_L_isPPerfect hY.2.2.1.1.1
  · exact hY.1
  · exact hY.1

private theorem commonGroup_normalizes_canonical {T L Y : Subgroup G} {j : ℕ}
    (hK : thompsonCommutator T L Y j ≤ normalizer (canonicalSupplement T L : Set G))
    (hR : radicalSylowCentralizer T L ≤ normalizer (canonicalSupplement T L : Set G)) :
    commonGroup T L Y j ≤ normalizer (canonicalSupplement T L : Set G) := by
  change canonicalSupplement T L ⊔ (thompsonCommutator T L Y j ⊔ radicalSylowCentralizer T L) ≤ _
  exact sup_le (canonicalSupplement T L).le_normalizer (sup_le hK hR)

private theorem commonGroup_normalizes_commutator {T L Y : Subgroup G} {j : ℕ}
    (hi : canonicalSupplement T L ⊔ T ≤ normalizer (thompsonCommutator T L Y j : Set G)) :
    commonGroup T L Y j ≤ normalizer (thompsonCommutator T L Y j : Set G) := by
  let K := thompsonCommutator T L Y j
  change canonicalSupplement T L ⊔ (K ⊔ radicalSylowCentralizer T L) ≤ normalizer (K : Set G)
  exact sup_le (le_sup_left.trans hi)
    (sup_le K.le_normalizer ((radicalSylowCentralizer_le T L).trans (le_sup_right.trans hi)))

private theorem common_chief_of_geometry {T L Y A : Subgroup G} {j : ℕ}
    [n : (commonModule T L Y j).Normal] [e : IsElementaryAbelian 2 (commonModule T L Y j)]
    (hD : omegaClosure T L Y j ≤ commonGroup T L Y j)
    (hS : commonGroup T L Y j ≤ normalizer (canonicalSupplement T L : Set G))
    (hK : commonGroup T L Y j ≤ normalizer (thompsonCommutator T L Y j : Set G))
    (hpS : IsPPerfect 2 (canonicalSupplement T L))
    (hpK : IsPPerfect 2 (thompsonCommutator T L Y j))
    (hc : ⁅canonicalSupplement T L,thompsonCommutator T L Y j ⊔ radicalSylowCentralizer T L⁆ ≤
      centralizer (omegaClosure T L Y j : Set G))
    (hm : ⁅⁅omegaClosure T L Y j,canonicalSupplement T L⁆,thompsonCommutator T L Y j⁆ ≠ ⊥) :
    Nonempty (CommonHatChief T L Y A j) := by
  exact @CommonChief.exists_of_ambient_double_movement G (HatGroup T L Y j)
    _ _ _ (commonGroup T L Y j)
    (omegaClosure T L Y j) (canonicalSupplement T L) (thompsonCommutator T L Y j) n e
    (hatMap T L Y j) (QuotientGroup.mk'_surjective _) (hatMap_ker T L Y j)
    (hatImage T L Y j A) hD le_sup_left (le_sup_left.trans le_sup_right) hS hK hpS hpK
    ((commutator_mono le_rfl le_sup_left).trans hc) hm

private theorem common_chief_of_twoPerfect (h : Hypothesis1311 T)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    {L H C Y A : Subgroup G} (hL : FaithfulMaximalLocal T L)
    (hn : ¬ IsQuasisimple (XiQuotient L))
    (w : RefinedWitness T L H C Y) (hH : IsMaximalTwoLocal H)
    (hTH : (T : Subgroup G) ≤ H) (hAH : canonicalSupplement T L ≤ H)
    (hAC : canonicalSupplement T L ≤ C)
    (hTL : (T : Subgroup G) ≤ normalizer (L : Set G)) {j : ℕ}
    [(commonModule T L Y j).Normal] [IsElementaryAbelian 2 (commonModule T L Y j)]
    (hpK : IsPPerfect 2 (thompsonCommutator T L Y j))
    (hm : ⁅⁅omegaClosure T L Y j,canonicalSupplement T L⁆,thompsonCommutator T L Y j⁆ ≠ ⊥) :
    Nonempty (CommonHatChief (T : Subgroup G) L Y A j) := by
  have hi := thompson_commutator_invariance w hTH hAH hTL j
  have hcan := canonical_frattini_geometry h hmany hL hn
  apply common_chief_of_geometry
    ((omegaClosure_geometry w hTH hAH hTL j).2.1.trans le_sup_right)
    (commonGroup_normalizes_canonical (hi.1.trans w.normalizes)
      ((radicalSylowCentralizer_le T L).trans (sylow_normalizes_canonicalSupplement hTL)))
    (commonGroup_normalizes_commutator hi.2.2.1)
    (mem_L_isPPerfect hcan.1.1) hpK
    (common_commutator_centralizes h w hH hTH hAH hAC hTL hcan.2.1 j) hm

/-- The actual component/cubic branch constructs a common chief section
for L_R K A, inside the original double moved module. -/
theorem common_chief_section_of_commutator_eq (h : Hypothesis1311 T)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    {L H C Y A : Subgroup G} (hL : FaithfulMaximalLocal T L)
    (hn : ¬ IsQuasisimple (XiQuotient L))
    (w : RefinedWitness T L H C Y) (hH : IsMaximalTwoLocal H)
    (hTH : (T : Subgroup G) ≤ H) (hAH : canonicalSupplement T L ≤ H)
    (hAC : canonicalSupplement T L ≤ C)
    (hTL : (T : Subgroup G) ≤ normalizer (L : Set G)) {j : ℕ}
    [(commonModule T L Y j).Normal] [IsElementaryAbelian 2 (commonModule T L Y j)]
    (he : thompsonCommutator T L Y j = Y)
    (hm : ⁅⁅omegaClosure T L Y j,canonicalSupplement T L⁆,thompsonCommutator T L Y j⁆ ≠ ⊥) :
    Nonempty (CommonHatChief (T : Subgroup G) L Y A j) := by
  apply common_chief_of_twoPerfect h hmany hL hn w hH hTH hAH hAC hTL _ hm
  rw [he]
  exact witness_twoPerfect w

/-- On this constructed section the simple branch has zero rank loss. -/
theorem common_chief_section_epsilon {L H C Y A : Subgroup G}
    (w : RefinedWitness T L H C Y) (hTH : (T : Subgroup G) ≤ H)
    (hAH : canonicalSupplement T L ≤ H)
    (hTL : (T : Subgroup G) ≤ normalizer (L : Set G)) {j : ℕ}
    [(commonModule T L Y j).Normal] [IsElementaryAbelian 2 (commonModule T L Y j)]
    [IsSimpleGroup (hatImage T L Y j (thompsonCommutator T L Y j))]
    (ha : CommonActionProperties (T : Subgroup G) L Y j)
    (hA : A ∈ thompsonFamily (radicalSylowCentralizer T L) j)
    (d : CommonHatChief (T : Subgroup G) L Y A j) : d.movedSection.rankLoss = 0 :=
  common_simple_section_epsilon w hTH hAH hTL ha hA d.movedSection


private theorem pslTwo_simple {Q : Type*} [Group Q] {p : ℕ}
    (hp : 3 < p) (hq : ClassicalGroup.IsPSL Q 2 p) : IsSimpleGroup Q := by
  obtain ⟨F,hF,hfin,hcard,⟨e⟩⟩ := hq
  let := hF
  let := hfin
  let : IsSimpleGroup (GorensteinWalter.PSL2 F) :=
    Matrix.ProjectiveSpecialLinearGroup.rank_two_simple (hcard ▸ hp)
  exact e.isSimpleGroup

/-- Simplicity makes the constructed first-factor section action faithful. -/
theorem common_chief_canonical_faithful {T L Y A : Subgroup G} {j : ℕ}
    [(commonModule T L Y j).Normal] [IsElementaryAbelian 2 (commonModule T L Y j)]
    (ha : CommonActionProperties T L Y j) (d : CommonHatChief T L Y A j) :
    Function.Injective ((sectionRepresentation
      ((hatRepresentation T L Y j).comp
        (CommonChief.actorGroup (hatImage T L Y j (canonicalSupplement T L))
          (hatImage T L Y j (thompsonCommutator T L Y j)) (hatImage T L Y j A)).subtype)
      d.lower d.upper).comp (inclusion (show hatImage T L Y j (canonicalSupplement T L) ≤
        CommonChief.actorGroup (hatImage T L Y j (canonicalSupplement T L))
          (hatImage T L Y j (thompsonCommutator T L Y j)) (hatImage T L Y j A) from le_sup_left))) := by
  obtain ⟨p,_,hp,hpS⟩ := ha.canonical_model
  let := pslTwo_simple hp hpS
  exact d.first_faithful

/-- The literal candidate now has a common chief section in the component
and cubic branches, or retains precisely the original larger odd-prime branch. -/
theorem candidate_common_chief_or_large_odd (h : Hypothesis1311 T)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hs : CanonicalStars T) (hrig : QuasisimpleRigidity T)
    (hclass : QuasisimpleClassification T) {L H C : Subgroup G}
    (hL : FaithfulMaximalLocal T L) (hn : ¬ IsQuasisimple (XiQuotient L))
    (hH : IsMaximalTwoLocal H) (hTH : (T : Subgroup G) ≤ H)
    (hne : H ≠ normalizer (L : Set G))
    (hC : C ∈ cComponentsIn H) (hAC : canonicalSupplement T L ≤ C)
    {j : ℕ}
    (hN : normalizer (thompsonJ (radicalSylowCentralizer T L) j : Set G) ≤
      normalizer (L : Set G)) :
    ∃ Y : Subgroup G, RefinedWitness T L H C Y ∧
      ∃ n : (commonModule T L Y j).Normal,
        let := n
        ∃ e : IsElementaryAbelian 2 (commonModule T L Y j),
          let := e
          CommonActionProperties (T : Subgroup G) L Y j ∧
          ((thompsonCommutator T L Y j = Y ∧
            ∃ A ∈ thompsonFamily (radicalSylowCentralizer T L) j,
              hatImage T L Y j A ≠ ⊥ ∧ HatActorBound (T : Subgroup G) L Y A j ∧
              Nonempty (CommonHatChief (T : Subgroup G) L Y A j)) ∨
           (IsPPerfect 2 Y ∧ ∃ d : ℕ, d.Prime ∧ 3 < d ∧ IsPGroup d (XiQuotient Y) ∧
             Monoid.exponent (XiQuotient Y) = d ∧ Group.nilpotencyClass (XiQuotient Y) ≤ 2)) := by
  obtain ⟨Y,w,hm,n,he⟩ := candidate_common_action_with_actor_alternative h hmany hs hrig hclass
    hL hn hH hTH hne hC hAC hN
  let := n
  obtain ⟨e,ha,hactor⟩ := he
  let := e
  refine ⟨Y,w,n,e,ha,?_⟩
  rcases hactor with ⟨hKY,_,A,hA,hAn,hAb⟩ | ho
  · refine Or.inl ⟨hKY,A,hA,hAn,hAb,?_⟩
    have hTL := radicalLocal_invariant_source hL.1.1
      (uniqueness_local_quotient_sqtk h.simpleQTKE hL.1.1.2.2) hn
    exact common_chief_section_of_commutator_eq h hmany hL hn w hH hTH
      (hAC.trans hC.1) hAC hTL hKY hm
  · exact Or.inr ho
end CFSG.Quasithin.Chapter13.Section01.SourceNonquasisimple.Supplements.FFContradiction
