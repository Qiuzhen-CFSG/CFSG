variable {G : Type*} [Group G] [Finite G]

variable {T : Sylow 2 G}

/-- In every refined branch the Thompson commutator is idempotent modulo O₂(Y). -/
theorem thompson_commutator_mod_core {L H C Y : Subgroup G}
    (w : RefinedWitness T L H C Y) (hTH : (T : Subgroup G) ≤ H) {j : ℕ}
    (hN : normalizer (thompsonJ (radicalSylowCentralizer (T : Subgroup G) L) j : Set G) ≤
      normalizer (L : Set G)) :
    thompsonCommutator (T : Subgroup G) L Y j ≤
      ⁅thompsonCommutator (T : Subgroup G) L Y j,thompsonJ (radicalSylowCentralizer (T : Subgroup G) L) j⁆ ⊔
        Y.pCoreIn 2 := by
  rcases thompson_commutator_eq_or_large_odd w hTH hN with he | ⟨_,d,hd,hd3,hY,_,_⟩
  · have hid : thompsonCommutator (T : Subgroup G) L Y j =
        ⁅thompsonCommutator (T : Subgroup G) L Y j,thompsonJ (radicalSylowCentralizer (T : Subgroup G) L) j⁆ := by
      conv_rhs => rw [he]
      rfl
    exact hid.le.trans le_sup_left
  · have hHY := (normal_subgroupOf_iff_le_normalizer w.witness.le_overgroup).mp w.witness.normal
    exact commutator_le_iterated_sup_twoCore Y _
      ((thompsonJ_le _ _).trans ((radicalSylowCentralizer_le _ _).trans (hTH.trans hHY)))
      (T.isPGroup'.to_le ((thompsonJ_le _ _).trans (radicalSylowCentralizer_le _ _)))
      hd (by omega) hY

/-- The two-core of the original escaping Y acts trivially on the actual D. -/
theorem escaping_core_centralizes_omegaClosure (h : Hypothesis1311 T)
    {L H C Y : Subgroup G} (w : RefinedWitness T L H C Y)
    (hH : IsMaximalTwoLocal H) (hTH : (T : Subgroup G) ≤ H)
    (hAH : canonicalSupplement (T : Subgroup G) L ≤ H)
    (hTL : (T : Subgroup G) ≤ normalizer (L : Set G))
    (hcore : (canonicalSupplement (T : Subgroup G) L ⊔ (T : Subgroup G)).pCoreIn 2 =
      radicalSylowCentralizer (T : Subgroup G) L) (j : ℕ) :
    Y.pCoreIn 2 ≤ centralizer (omegaClosure (T : Subgroup G) L Y j : Set G) := by
  have hi := thompson_commutator_invariance w hTH hAH hTL j
  have hHY := (normal_subgroupOf_iff_le_normalizer w.witness.le_overgroup).mp w.witness.normal
  have hBN : thompsonCommutator (T : Subgroup G) L Y j ⊔ radicalSylowCentralizer (T : Subgroup G) L ≤
      normalizer (Y.pCoreIn 2 : Set G) :=
    ((sup_le (hi.1.trans w.witness.le_overgroup)
      ((radicalSylowCentralizer_le _ _).trans hTH)).trans hHY).trans
      (normalizer_le_normalizer_characteristic_image Y (pCore 2 Y))
  exact (le_pCoreIn_of_normalizes (isPGroup_pCoreIn 2 Y)
    (w.core_le.trans le_sup_right) hBN).trans
      (omegaClosure_core_centralizes h w hH hTH hAH hTL hcore j)

omit [Finite G] in
private theorem normalizes_commutator_pair (Q U V : Subgroup G)
    (hU : Q ≤ normalizer (U : Set G)) (hV : Q ≤ normalizer (V : Set G)) :
    Q ≤ normalizer ((⁅U,V⁆ : Subgroup G) : Set G) := by
  intro q hq
  apply mem_normalizer_iff_map_conj_eq.mpr
  rw [map_commutator,mem_normalizer_iff_map_conj_eq.mp (hU hq),
    mem_normalizer_iff_map_conj_eq.mp (hV hq)]

private theorem family_moves_of_mod_core (K R U N : Subgroup G) (j : ℕ)
    (hRU : R ≤ normalizer (U : Set G)) (hNU : N ≤ centralizer (U : Set G))
    (hb : K ≤ ⁅K,thompsonJ R j⁆ ⊔ N) (hm : ⁅U,K⁆ ≠ ⊥) :
    ∃ A ∈ thompsonFamily R j, ⁅U,⁅K,A⁆⁆ ≠ ⊥ := by
  by_contra! hall
  have hc : ⁅K,thompsonJ R j⁆ ≤ centralizer (U : Set G) := by
    rw [commutator_comm]
    change ⁅sSup (thompsonFamily R j),K⁆ ≤ _
    rw [sSup_eq_iSup']
    apply commutator_iSup_le_of_relative_normal R K _
      (fun a : thompsonFamily R j => a.val)
      (hRU.trans (normalizer_le_normalizer_centralizer U)) (fun a => a.property.1)
    intro a
    rw [commutator_comm]
    exact le_centralizer_iff.mp (commutator_eq_bot_iff_le_centralizer.mp (hall a a.property))
  apply hm
  rw [commutator_comm]
  exact commutator_eq_bot_iff_le_centralizer.mpr (hb.trans (sup_le hc hNU))

/-- Select an actual Thompson-family member whose K-commutator moves [D,L_R],
including the larger odd-prime branch. -/
theorem common_moving_thompson_actor (h : Hypothesis1311 T)
    {L H C Y : Subgroup G} (w : RefinedWitness T L H C Y)
    (hH : IsMaximalTwoLocal H) (hTH : (T : Subgroup G) ≤ H)
    (hAH : canonicalSupplement (T : Subgroup G) L ≤ H)
    (hTL : (T : Subgroup G) ≤ normalizer (L : Set G))
    (hcore : (canonicalSupplement (T : Subgroup G) L ⊔ (T : Subgroup G)).pCoreIn 2 =
      radicalSylowCentralizer (T : Subgroup G) L) {j : ℕ}
    [n : (commonModule (T : Subgroup G) L Y j).Normal] [IsElementaryAbelian 2 (commonModule (T : Subgroup G) L Y j)]
    (hN : normalizer (thompsonJ (radicalSylowCentralizer (T : Subgroup G) L) j : Set G) ≤
      normalizer (L : Set G))
    (ha : CommonActionProperties (T : Subgroup G) L Y j)
    (hm : ⁅⁅omegaClosure (T : Subgroup G) L Y j,canonicalSupplement (T : Subgroup G) L⁆,thompsonCommutator (T : Subgroup G) L Y j⁆ ≠ ⊥) :
    ∃ A ∈ thompsonFamily (radicalSylowCentralizer (T : Subgroup G) L) j,
      ⁅⁅omegaClosure (T : Subgroup G) L Y j,canonicalSupplement (T : Subgroup G) L⁆,⁅thompsonCommutator (T : Subgroup G) L Y j,A⁆⁆ ≠ ⊥ ∧
      hatImage (T : Subgroup G) L Y j A ≠ ⊥ ∧ HatActorBound (T : Subgroup G) L Y A j := by
  let D := omegaClosure (T : Subgroup G) L Y j
  let S := canonicalSupplement (T : Subgroup G) L
  let K := thompsonCommutator (T : Subgroup G) L Y j
  let R := radicalSylowCentralizer (T : Subgroup G) L
  let U := ⁅D,S⁆
  have hd := omegaClosure_geometry w hTH hAH hTL j
  have hUD : U ≤ D := le_normalizer_iff_commutator_le_left.mp (le_sup_left.trans hd.2.2.2)
  have hRU : R ≤ normalizer (U : Set G) := normalizes_commutator_pair R D S
    (le_sup_right.trans hd.2.2.1)
    ((radicalSylowCentralizer_le _ _).trans (sylow_normalizes_canonicalSupplement hTL))
  obtain ⟨A,hA,hmA⟩ := family_moves_of_mod_core K R U (Y.pCoreIn 2) j hRU
    ((escaping_core_centralizes_omegaClosure h w hH hTH hAH hTL hcore j).trans
      (centralizer_le hUD)) (thompson_commutator_mod_core w hTH hN) hm
  have hnA : hatImage (T : Subgroup G) L Y j A ≠ ⊥ := by
    intro hz
    have hc := (hat_image_eq_bot_iff (T : Subgroup G) L Y A j
      (hd.2.1.trans le_sup_right) (hA.1.trans (le_sup_right.trans le_sup_right))).mp hz
    have haC := le_centralizer_iff.mp (commutator_eq_bot_iff_le_centralizer.mp hc)
    have hkC : ⁅K,A⁆ ≤ centralizer (D : Set G) :=
      (commutator_mono le_rfl haC).trans
        (le_normalizer_iff_commutator_le_right.mp
          ((le_sup_left.trans hd.2.2.1).trans (normalizer_le_normalizer_centralizer D)))
    apply hmA
    rw [commutator_comm]
    exact commutator_eq_bot_iff_le_centralizer.mpr (hkC.trans (centralizer_le hUD))
  exact ⟨A,hA,hmA,hnA,ha.actor_bound A hA hnA⟩

/-- The literal K-image is a d-group in the source's larger odd-prime branch. -/
theorem odd_hat_commutator_isPGroup (h : Hypothesis1311 T)
    {L H C Y : Subgroup G} (w : RefinedWitness T L H C Y)
    (hH : IsMaximalTwoLocal H) (hTH : (T : Subgroup G) ≤ H)
    (hAH : canonicalSupplement (T : Subgroup G) L ≤ H)
    (hTL : (T : Subgroup G) ≤ normalizer (L : Set G))
    (hcore : (canonicalSupplement (T : Subgroup G) L ⊔ (T : Subgroup G)).pCoreIn 2 =
      radicalSylowCentralizer (T : Subgroup G) L) (j : ℕ) [n : (commonModule (T : Subgroup G) L Y j).Normal]
    {d : ℕ} (hY : IsPGroup d (XiQuotient Y)) :
    IsPGroup d (hatImage (T : Subgroup G) L Y j (thompsonCommutator (T : Subgroup G) L Y j)) := by
  have hKY := (thompson_commutator_invariance w hTH hAH hTL j).1
  have hc := escaping_core_centralizes_omegaClosure h w hH hTH hAH hTL hcore j
  rintro ⟨_,k,hk,rfl⟩
  obtain ⟨n,hn⟩ := hY (QuotientGroup.mk' (pCore 2 Y) ⟨k.val,hKY hk⟩)
  refine ⟨n,Subtype.ext ?_⟩
  change hatMap (T : Subgroup G) L Y j k ^ d ^ n = 1
  rw [← map_pow]
  apply (QuotientGroup.eq_one_iff _).mpr
  have hycore : (⟨k.val,hKY hk⟩ : Y) ^ d ^ n ∈ pCore 2 Y :=
    (QuotientGroup.eq_one_iff _).mp (by
      change QuotientGroup.mk' (pCore 2 Y) ((⟨k.val,hKY hk⟩ : Y) ^ d ^ n) = 1
      rw [map_pow]
      exact hn)
  intro x hx
  exact Subtype.ext (hc (mem_map_of_mem Y.subtype hycore) x hx)


/-- Commutators retain their literal inclusions when mapped to the hat group. -/
theorem hat_image_commutator {T L Y X Z : Subgroup G} {j : ℕ}
    [n : (commonModule (T : Subgroup G) L Y j).Normal]
    (hX : X ≤ commonGroup (T : Subgroup G) L Y j) (hZ : Z ≤ commonGroup (T : Subgroup G) L Y j) :
    hatImage (T : Subgroup G) L Y j ⁅X,Z⁆ = ⁅hatImage (T : Subgroup G) L Y j X,hatImage (T : Subgroup G) L Y j Z⁆ := by
  have he : (⁅X,Z⁆).subgroupOf (commonGroup (T : Subgroup G) L Y j) =
      ⁅X.subgroupOf (commonGroup (T : Subgroup G) L Y j),Z.subgroupOf (commonGroup (T : Subgroup G) L Y j)⁆ := by
    apply map_injective (commonGroup (T : Subgroup G) L Y j).subtype_injective
    rw [map_commutator,map_subgroupOf_eq_of_le hX,map_subgroupOf_eq_of_le hZ,
      map_subgroupOf_eq_of_le ((Subgroup.commutator_le_sup X Z).trans (sup_le hX hZ))]
  simp only [hatImage,he,map_commutator]

omit [Finite G] in
private theorem mapped_idempotence {Q : Type*} [Group Q]
    (E K J N : Subgroup G) (f : E →* Q)
    (hK : K ≤ E) (hJ : J ≤ E) (hN : N ≤ E)
    (hi : ⁅K,J⁆ ≤ K) (hb : K ≤ ⁅K,J⁆ ⊔ N)
    (hz : (N.subgroupOf E).map f = ⊥) :
    (K.subgroupOf E).map f = ⁅(K.subgroupOf E).map f,(J.subgroupOf E).map f⁆ := by
  have he : (⁅K,J⁆).subgroupOf E = ⁅K.subgroupOf E,J.subgroupOf E⁆ := by
    apply map_injective E.subtype_injective
    rw [map_commutator,map_subgroupOf_eq_of_le hK,map_subgroupOf_eq_of_le hJ,
      map_subgroupOf_eq_of_le (hi.trans hK)]
  rw [← map_commutator,←he]
  apply le_antisymm
  · have hh := map_mono (f := f) (subgroupOf_mono E hb)
    rw [subgroupOf_sup (hi.trans hK) hN,Subgroup.map_sup,hz,sup_bot_eq] at hh
    exact hh
  · exact map_mono (subgroupOf_mono E hi)

/-- Coprime idempotence modulo O₂(Y) becomes exact on the literal hat-image. -/
theorem hat_commutator_idempotent (h : Hypothesis1311 T)
    {L H C Y : Subgroup G} (w : RefinedWitness T L H C Y)
    (hH : IsMaximalTwoLocal H) (hTH : (T : Subgroup G) ≤ H)
    (hAH : canonicalSupplement (T : Subgroup G) L ≤ H)
    (hTL : (T : Subgroup G) ≤ normalizer (L : Set G))
    (hcore : (canonicalSupplement (T : Subgroup G) L ⊔ (T : Subgroup G)).pCoreIn 2 =
      radicalSylowCentralizer (T : Subgroup G) L) {j : ℕ} [n : (commonModule (T : Subgroup G) L Y j).Normal]
    (hN : normalizer (thompsonJ (radicalSylowCentralizer (T : Subgroup G) L) j : Set G) ≤
      normalizer (L : Set G)) :
    hatImage (T : Subgroup G) L Y j (thompsonCommutator (T : Subgroup G) L Y j) =
      ⁅hatImage (T : Subgroup G) L Y j (thompsonCommutator (T : Subgroup G) L Y j),
        hatImage (T : Subgroup G) L Y j (thompsonJ (radicalSylowCentralizer (T : Subgroup G) L) j)⁆ := by
  let K := thompsonCommutator (T : Subgroup G) L Y j
  let J := thompsonJ (radicalSylowCentralizer (T : Subgroup G) L) j
  let E := commonGroup (T : Subgroup G) L Y j
  have hK : K ≤ E := le_sup_left.trans le_sup_right
  have hJ : J ≤ E := (thompsonJ_le _ _).trans (le_sup_right.trans le_sup_right)
  have hQ : Y.pCoreIn 2 ≤ E := w.core_le.trans (le_sup_right.trans le_sup_right)
  have hi : ⁅K,J⁆ ≤ K := le_normalizer_iff_commutator_le_left.mp (normalizer_commutator_ge_right Y J)
  have hz : hatImage (T : Subgroup G) L Y j (Y.pCoreIn 2) = ⊥ := by
    apply (hat_image_eq_bot_iff (T : Subgroup G) L Y _ j
      ((omegaClosure_geometry w hTH hAH hTL j).2.1.trans le_sup_right) hQ).mpr
    rw [commutator_comm]
    exact commutator_eq_bot_iff_le_centralizer.mpr
      (escaping_core_centralizes_omegaClosure h w hH hTH hAH hTL hcore j)
  have hb : K ≤ ⁅K,J⁆ ⊔ Y.pCoreIn 2 := thompson_commutator_mod_core w hTH hN
  exact @mapped_idempotence G inferInstance (HatGroup (T : Subgroup G) L Y j) inferInstance
    E K J (Y.pCoreIn 2) (hatMap (T : Subgroup G) L Y j) hK hJ hQ hi hb hz

/-- Centralization of a submodule of D can be tested in the same hat quotient. -/
theorem hat_image_le_centralizer_image_iff {T L Y U X : Subgroup G} {j : ℕ}
    [n : (commonModule (T : Subgroup G) L Y j).Normal]
    (hD : omegaClosure (T : Subgroup G) L Y j ≤ commonGroup (T : Subgroup G) L Y j)
    (hU : U ≤ omegaClosure (T : Subgroup G) L Y j) (hX : X ≤ commonGroup (T : Subgroup G) L Y j) :
    hatImage (T : Subgroup G) L Y j X ≤ hatImage (T : Subgroup G) L Y j (centralizer (U : Set G)) ↔
      X ≤ centralizer (U : Set G) := by
  have hk : (hatMap (T : Subgroup G) L Y j).ker ≤
      (centralizer (U : Set G)).subgroupOf (commonGroup (T : Subgroup G) L Y j) := by
    rw [hatMap_ker]
    intro x hx u hu
    exact congrArg Subtype.val (hx ⟨u,hD (hU hu)⟩ (hU hu))
  change (X.subgroupOf _).map _ ≤ ((centralizer (U : Set G)).subgroupOf _).map _ ↔ _
  rw [map_le_iff_le_comap,comap_map_eq,sup_of_le_left hk]
  constructor
  · intro hh x hx
    exact hh (show (⟨x,hX hx⟩ : commonGroup (T : Subgroup G) L Y j) ∈ X.subgroupOf _ from hx)
  · exact subgroupOf_mono _


/-- Prime exponent descends to the nontrivial literal K-image. -/
theorem odd_hat_commutator_exponent (h : Hypothesis1311 T)
    {L H C Y : Subgroup G} (w : RefinedWitness T L H C Y)
    (hH : IsMaximalTwoLocal H) (hTH : (T : Subgroup G) ≤ H)
    (hAH : canonicalSupplement (T : Subgroup G) L ≤ H)
    (hTL : (T : Subgroup G) ≤ normalizer (L : Set G))
    (hcore : (canonicalSupplement (T : Subgroup G) L ⊔ (T : Subgroup G)).pCoreIn 2 =
      radicalSylowCentralizer (T : Subgroup G) L) (j : ℕ) [n : (commonModule (T : Subgroup G) L Y j).Normal]
    {d : ℕ} (hd : d.Prime) (he : Monoid.exponent (XiQuotient Y) = d)
    (hne : hatImage (T : Subgroup G) L Y j (thompsonCommutator (T : Subgroup G) L Y j) ≠ ⊥) :
    Monoid.exponent (hatImage (T : Subgroup G) L Y j (thompsonCommutator (T : Subgroup G) L Y j)) = d := by
  let : Fact d.Prime := ⟨hd⟩
  let : Nontrivial (hatImage (T : Subgroup G) L Y j (thompsonCommutator (T : Subgroup G) L Y j)) :=
    (nontrivial_iff_ne_bot _).mpr hne
  have hKY := (thompson_commutator_invariance w hTH hAH hTL j).1
  have hc := escaping_core_centralizes_omegaClosure h w hH hTH hAH hTL hcore j
  have hp : ∀ k : hatImage (T : Subgroup G) L Y j (thompsonCommutator (T : Subgroup G) L Y j), k ^ d = 1 := by
    rintro ⟨_,k,hk,rfl⟩
    apply Subtype.ext
    change hatMap (T : Subgroup G) L Y j k ^ d = 1
    rw [← map_pow]
    apply (QuotientGroup.eq_one_iff _).mpr
    have hycore : (⟨k.val,hKY hk⟩ : Y) ^ d ∈ pCore 2 Y := by
      apply (QuotientGroup.eq_one_iff _).mp
      change QuotientGroup.mk' (pCore 2 Y) ((⟨k.val,hKY hk⟩ : Y) ^ d) = 1
      rw [map_pow,←he]
      exact Monoid.pow_exponent_eq_one _
    intro x hx
    exact Subtype.ext (hc (mem_map_of_mem Y.subtype hycore) x hx)
  exact (Monoid.exponent_eq_prime_iff hd).mpr (fun k hk => orderOf_eq_prime (hp k) hk)

/-- The actual subgroup K_B in the hat quotient, including its marking and
movement on [D,L_R]. Its original preimage and chief section are later steps. -/
structure OddHatPrimeLine (T L Y A : Subgroup G) (j d : ℕ)
    [n : (commonModule (T : Subgroup G) L Y j).Normal] where
  hyperplane : Subgroup (hatImage (T : Subgroup G) L Y j A)
  subgroup : Subgroup (HatGroup (T : Subgroup G) L Y j)
  index_two : hyperplane.index = 2
  contained : subgroup ≤
    ⁅hatImage (T : Subgroup G) L Y j (thompsonCommutator (T : Subgroup G) L Y j),hatImage (T : Subgroup G) L Y j A⁆
  card : Nat.card subgroup = d
  normalized : hatImage (T : Subgroup G) L Y j A ≤ normalizer (subgroup : Set (HatGroup (T : Subgroup G) L Y j))
  generated : ⁅subgroup,hatImage (T : Subgroup G) L Y j A⁆ = subgroup
  fixed : subgroup ≤ centralizer (hyperplane.map (hatImage (T : Subgroup G) L Y j A).subtype :
    Set (HatGroup (T : Subgroup G) L Y j))
  moves : ¬ subgroup ≤ hatImage (T : Subgroup G) L Y j
    (centralizer ((⁅omegaClosure (T : Subgroup G) L Y j,canonicalSupplement (T : Subgroup G) L⁆ : Subgroup G) : Set G))

private theorem odd_hat_prime_line_of_data {T L Y A : Subgroup G} {j d : ℕ}
    [n : (commonModule (T : Subgroup G) L Y j).Normal]
    (hd : d.Prime) (hd2 : d ≠ 2)
    (hp : IsPGroup d (hatImage (T : Subgroup G) L Y j (thompsonCommutator (T : Subgroup G) L Y j)))
    (he : Monoid.exponent (hatImage (T : Subgroup G) L Y j (thompsonCommutator (T : Subgroup G) L Y j)) = d)
    (hAe : IsElementaryAbelian 2 (hatImage (T : Subgroup G) L Y j A))
    (hAN : hatImage (T : Subgroup G) L Y j A ≤
      normalizer (hatImage (T : Subgroup G) L Y j (thompsonCommutator (T : Subgroup G) L Y j) : Set (HatGroup (T : Subgroup G) L Y j)))
    (hm : ¬ ⁅hatImage (T : Subgroup G) L Y j (thompsonCommutator (T : Subgroup G) L Y j),hatImage (T : Subgroup G) L Y j A⁆ ≤
      hatImage (T : Subgroup G) L Y j (centralizer
        ((⁅omegaClosure (T : Subgroup G) L Y j,canonicalSupplement (T : Subgroup G) L⁆ : Subgroup G) : Set G))) :
    Nonempty (OddHatPrimeLine (T : Subgroup G) L Y A j d) := by
  let : Fact d.Prime := ⟨hd⟩
  let := hAe
  obtain ⟨B,Q,hB,hQ,hcard,hN,hgen,hfix,hmov⟩ :=
    Theory.GroupAction.exists_prime_subgroup_outside_of_elementary_action hd2
      (hatImage (T : Subgroup G) L Y j (thompsonCommutator (T : Subgroup G) L Y j)) (hatImage (T : Subgroup G) L Y j A)
      (hatImage (T : Subgroup G) L Y j (centralizer
        ((⁅omegaClosure (T : Subgroup G) L Y j,canonicalSupplement (T : Subgroup G) L⁆ : Subgroup G) : Set G)))
      hp he hAN hm
  exact ⟨⟨B,Q,hB,hQ,hcard,hN,hgen,hfix,hmov⟩⟩

/-- Construct the source's moving order-d subgroup fixed by an actor hyperplane,
in the original hat quotient and with no section-existence assumption. -/
theorem odd_hat_prime_line (h : Hypothesis1311 T)
    {L H C Y A : Subgroup G} (w : RefinedWitness T L H C Y)
    (hH : IsMaximalTwoLocal H) (hTH : (T : Subgroup G) ≤ H)
    (hAH : canonicalSupplement (T : Subgroup G) L ≤ H)
    (hTL : (T : Subgroup G) ≤ normalizer (L : Set G))
    (hcore : (canonicalSupplement (T : Subgroup G) L ⊔ (T : Subgroup G)).pCoreIn 2 =
      radicalSylowCentralizer (T : Subgroup G) L) {j : ℕ}
    [n : (commonModule (T : Subgroup G) L Y j).Normal] [IsElementaryAbelian 2 (commonModule (T : Subgroup G) L Y j)]
    (ha : CommonActionProperties (T : Subgroup G) L Y j)
    (hA : A ∈ thompsonFamily (radicalSylowCentralizer (T : Subgroup G) L) j)
    (hm : ⁅⁅omegaClosure (T : Subgroup G) L Y j,canonicalSupplement (T : Subgroup G) L⁆,⁅thompsonCommutator (T : Subgroup G) L Y j,A⁆⁆ ≠ ⊥)
    {d : ℕ} (hd : d.Prime) (hd3 : 3 < d) (hp : IsPGroup d (XiQuotient Y))
    (he : Monoid.exponent (XiQuotient Y) = d) :
    Nonempty (OddHatPrimeLine (T : Subgroup G) L Y A j d) := by
  let : Fact d.Prime := ⟨hd⟩
  let E := commonGroup (T : Subgroup G) L Y j
  let D := omegaClosure (T : Subgroup G) L Y j
  let U := ⁅D,canonicalSupplement (T : Subgroup G) L⁆
  let K := thompsonCommutator (T : Subgroup G) L Y j
  have hdg := omegaClosure_geometry w hTH hAH hTL j
  have hDE : D ≤ E := hdg.2.1.trans le_sup_right
  have hUD : U ≤ D := le_normalizer_iff_commutator_le_left.mp (le_sup_left.trans hdg.2.2.2)
  have hKE : K ≤ E := le_sup_left.trans le_sup_right
  have hAE : A ≤ E := hA.1.trans (le_sup_right.trans le_sup_right)
  let : IsElementaryAbelian 2 A := hA.2.1
  let : IsElementaryAbelian 2 (A.subgroupOf E) := IsElementaryAbelian.subgroupOf hAE
  let : IsElementaryAbelian 2 (hatImage (T : Subgroup G) L Y j A) := IsElementaryAbelian.map (hatMap (T : Subgroup G) L Y j)
  let := hat_commutator_normal w hTH hAH hTL j
  have hmove : ¬ ⁅hatImage (T : Subgroup G) L Y j K,hatImage (T : Subgroup G) L Y j A⁆ ≤
      hatImage (T : Subgroup G) L Y j (centralizer (U : Set G)) := by
    intro hc
    rw [← hat_image_commutator (T := (T : Subgroup G)) (L := L) (Y := Y) (j := j) hKE hAE] at hc
    have hh := (hat_image_le_centralizer_image_iff (T := (T : Subgroup G)) (L := L) (Y := Y) (j := j) hDE hUD
      ((Subgroup.commutator_le_sup K A).trans (sup_le hKE hAE))).mp hc
    exact hm (by rw [commutator_comm]; exact commutator_eq_bot_iff_le_centralizer.mpr hh)
  have hpk : IsPGroup d (hatImage (T : Subgroup G) L Y j K) :=
    odd_hat_commutator_isPGroup h w hH hTH hAH hTL hcore j hp
  have hek : Monoid.exponent (hatImage (T : Subgroup G) L Y j K) = d :=
    odd_hat_commutator_exponent h w hH hTH hAH hTL hcore j hd he ha.commutator_nontrivial
  exact @odd_hat_prime_line_of_data G inferInstance inferInstance
    (T : Subgroup G) L Y A j d n hd (by omega) hpk hek
    (inferInstance : IsElementaryAbelian 2 (hatImage (T : Subgroup G) L Y j A))
    le_normalizer_of_normal hmove

/-- The same original outside candidate has a moving Thompson actor in every
refined alternative; the larger odd-prime alternative retains its actual image. -/
theorem candidate_common_moving_actor (h : Hypothesis1311 T)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hs : CanonicalStars T) (hrig : QuasisimpleRigidity T)
    (hclass : QuasisimpleClassification T) {L H C : Subgroup G}
    (hL : FaithfulMaximalLocal T L) (hn : ¬ IsQuasisimple (XiQuotient L))
    (hH : IsMaximalTwoLocal H) (hTH : (T : Subgroup G) ≤ H)
    (hne : H ≠ normalizer (L : Set G))
    (hC : C ∈ cComponentsIn H) (hAC : canonicalSupplement (T : Subgroup G) L ≤ C)
    {j : ℕ}
    (hN : normalizer (thompsonJ (radicalSylowCentralizer (T : Subgroup G) L) j : Set G) ≤
      normalizer (L : Set G)) :
    ∃ Y : Subgroup G, RefinedWitness T L H C Y ∧
      ∃ n : (commonModule (T : Subgroup G) L Y j).Normal,
        let := n
        ∃ e : IsElementaryAbelian 2 (commonModule (T : Subgroup G) L Y j),
          let := e
          CommonActionProperties (T : Subgroup G) L Y j ∧
          hatImage (T : Subgroup G) L Y j (thompsonCommutator (T : Subgroup G) L Y j) =
            ⁅hatImage (T : Subgroup G) L Y j (thompsonCommutator (T : Subgroup G) L Y j),
              hatImage (T : Subgroup G) L Y j (thompsonJ (radicalSylowCentralizer (T : Subgroup G) L) j)⁆ ∧
          ∃ A ∈ thompsonFamily (radicalSylowCentralizer (T : Subgroup G) L) j,
            ⁅⁅omegaClosure (T : Subgroup G) L Y j,canonicalSupplement (T : Subgroup G) L⁆,⁅thompsonCommutator (T : Subgroup G) L Y j,A⁆⁆ ≠ ⊥ ∧
            hatImage (T : Subgroup G) L Y j A ≠ ⊥ ∧ HatActorBound (T : Subgroup G) L Y A j ∧
            ((thompsonCommutator (T : Subgroup G) L Y j = Y ∧
                Nonempty (CommonHatChief (T : Subgroup G) L Y A j)) ∨
              (IsPPerfect 2 Y ∧ ∃ d : ℕ, d.Prime ∧ 3 < d ∧
                IsPGroup d (XiQuotient Y) ∧ Monoid.exponent (XiQuotient Y) = d ∧
                Group.nilpotencyClass (XiQuotient Y) ≤ 2 ∧
                IsPGroup d (hatImage (T : Subgroup G) L Y j (thompsonCommutator (T : Subgroup G) L Y j)) ∧
                Nonempty (OddHatPrimeLine (T : Subgroup G) L Y A j d))) := by
  obtain ⟨Y,w,hm,n,he⟩ := candidate_common_action h hmany hs hrig hclass
    hL hn hH hTH hne hC hAC hN
  let := n
  obtain ⟨e,ha⟩ := he
  let := e
  have hTL := radicalLocal_invariant_source hL.1.1
    (uniqueness_local_quotient_sqtk h.simpleQTKE hL.1.1.2.2) hn
  have hcore := (canonical_frattini_geometry h hmany hL hn).2.1
  obtain ⟨A,hA,hmove,hAn,hAb⟩ := common_moving_thompson_actor h w hH hTH
    (hAC.trans hC.1) hTL hcore hN ha hm
  refine ⟨Y,w,n,e,ha,
    hat_commutator_idempotent h w hH hTH (hAC.trans hC.1) hTL hcore hN,
    A,hA,hmove,hAn,hAb,?_⟩
  rcases thompson_commutator_eq_or_large_odd w hTH hN with hKY | ⟨hp,d,hd,hd3,hY,he,hc⟩
  · exact Or.inl ⟨hKY,common_chief_section_of_commutator_eq h hmany hL hn w hH hTH
      (hAC.trans hC.1) hAC hTL hKY hm⟩
  · exact Or.inr ⟨hp,d,hd,hd3,hY,he,hc,
      odd_hat_commutator_isPGroup h w hH hTH (hAC.trans hC.1) hTL hcore j hY,
      odd_hat_prime_line h w hH hTH (hAC.trans hC.1) hTL hcore ha hA hmove hd hd3 hY he⟩
end CFSG.Quasithin.Chapter13.Section01.SourceNonquasisimple.Supplements.FFContradiction
