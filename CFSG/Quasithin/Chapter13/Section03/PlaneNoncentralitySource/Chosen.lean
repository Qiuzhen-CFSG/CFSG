module

public import CFSG.Quasithin.Chapter12.Section02.SourceHypotheses
public import Theory.Representation.BinaryOffender.Homogeneous.Existence

/-!
# Constructing the literal chosen module from reduced subgroup data

A reduced elementary subgroup U of KT, generated by its K-commutators and
minimal among noncentral K-invariant subgroups, defines an Irr⁺ subspace
of the actual R₂(KT). T-invariance makes its homogeneous selection equal
to that same subspace. This constructs ChosenModule without changing U.

Source: Aschbacher–Smith, A.1.40–42 and the use of 13.3.2(3) in 13.3.14.
-/

public section
open Subgroup Representation Theory.GroupTheory
open scoped IsMulCommutative
open Representation.BinaryOffender Representation.BinaryOffender.Homogeneous
namespace CFSG.Quasithin.Chapter13.Section03.PlaneNoncentralitySource
open Chapter12.Section02
universe u
variable {G : Type u} [Group G] [Finite G]
  {T : Sylow 2 G} {K U : Subgroup G}

omit [Finite G] in
private theorem reduced_action_val (H : Subgroup G) (h : H)
    (v : Additive (ReducedModule H)) :
    (((reducedRepresentation H h v).toMul : H) : G) =
      (h : G) * v.toMul * (h : G)⁻¹ := by
  change (((ReducedModule H).normalizerMonoidHom _ v.toMul : H) : G) = _
  rw [normalizerMonoidHom_apply_apply_coe]
  rfl

/-- A reduced invariant subgroup with the literal Irr⁺ minimality property
produces the canonical source choice in R₂(KT). -/
theorem exists_chosenModuleOfMinimal
    (hred : IsPReduced 2 (U.subgroupOf (K ⊔ (T : Subgroup G))))
    (hUH : U ≤ K ⊔ (T : Subgroup G))
    (hTK : (T : Subgroup G) ≤ normalizer (K : Set G))
    (hUn : K ⊔ (T : Subgroup G) ≤ normalizer (U : Set G))
    (hgen : ⁅U, K⁆ = U) (hne : U ≠ ⊥)
    (hmin : ∀ A : Subgroup G, A ≤ U → K ≤ normalizer (A : Set G) →
      A = U ∨ A ≤ centralizer (K : Set G)) : Nonempty (ChosenModule T K U) := by
  let H := K ⊔ (T : Subgroup G)
  let ρ := reducedRepresentation H
  let I : Submodule (ZMod 2) (Additive (ReducedModule H)) :=
    ((U.subgroupOf H).subgroupOf (ReducedModule H)).toAddSubgroup.toZModSubmodule 2
  have hUR : U.subgroupOf H ≤ ReducedModule H := hred.le_reducedPSubgroup
  have himage : subspaceImage H I = U := by
    change (((U.subgroupOf H).subgroupOf (ReducedModule H)).map
      (ReducedModule H).subtype).map H.subtype = U
    rw [map_subgroupOf_eq_of_le hUR, map_subgroupOf_eq_of_le hUH]
  have hmap (J : Submodule (ZMod 2) (Additive (ReducedModule H)))
      (w : Additive (ReducedModule H)) (hw : w ∈ J) :
      (w.toMul.val : G) ∈ subspaceImage H J := ⟨_, ⟨w.toMul, hw, rfl⟩, rfl⟩
  have hI (X : Subgroup G) :
      X.subgroupOf H ≤ subspaceStabilizer ρ I := by
    apply le_subspaceStabilizer
    intro x hx v hv
    change (((ρ x v).toMul : H) : G) ∈ U
    rw [reduced_action_val]
    exact (mem_normalizer_iff.mp (hUn x.property) _).mp hv
  have hIs := hI K
  have hTs := hI (T : Subgroup G)
  have hfull : subspaceCommutator ρ I (K.subgroupOf H) = I := by
    let C := subspaceCommutator ρ I (K.subgroupOf H)
    have hCI : C ≤ I := by
      apply Submodule.span_le.mpr
      rintro _ ⟨k, hk, v, hv, rfl⟩
      exact I.sub_mem ((hIs hk v).mpr hv) hv
    have hcomm : ⁅U, K⁆ ≤ subspaceImage H C := by
      rw [commutator_comm]
      apply commutator_le.mpr
      intro k hk v hv
      let vH : H := ⟨v, hUH hv⟩
      let vR : Additive (ReducedModule H) := Additive.ofMul ⟨vH, hUR hv⟩
      let kH : H := ⟨k, (le_sup_left : K ≤ H) hk⟩
      have hC : ρ kH vR - vR ∈ C := Submodule.subset_span ⟨kH, hk, vR, hv, rfl⟩
      have hm := hmap C _ hC
      change (((ρ kH vR - vR).toMul : H) : G) ∈ subspaceImage H C at hm
      simp only [toMul_sub, div_eq_mul_inv, Subgroup.coe_mul, Subgroup.coe_inv] at hm
      rw [reduced_action_val] at hm
      exact hm
    apply le_antisymm hCI
    intro v hv
    have hm : (v.toMul.val : G) ∈ subspaceImage H C := hcomm (hgen.symm ▸ hv)
    obtain ⟨x, ⟨y, hy, rfl⟩, he⟩ := hm
    have hy' : Additive.ofMul y = v := by
      apply Additive.toMul.injective
      exact Subtype.ext (Subtype.ext he)
    exact hy' ▸ hy
  have hirr : IsIrrPlus ρ (K.subgroupOf H) I := by
    apply isIrrPlus_of_minimal ρ hIs hfull
    · intro hfix
      apply hne
      have hz : subspaceCommutator ρ I (K.subgroupOf H) = ⊥ := by
        apply bot_unique
        apply Submodule.span_le.mpr
        rintro _ ⟨k, hk, v, hv, rfl⟩
        change ρ k v - v = 0
        exact sub_eq_zero.mpr (hfix hv ⟨k,hk⟩)
      rw [hfull] at hz
      rw [← himage, hz]
      simp [subspaceImage]
    · intro J hJs hJI
      let A := subspaceImage H J
      have hAU : A ≤ U := by
        rw [← himage]
        exact map_mono (map_mono (show J.toAddSubgroup.toSubgroup' ≤ I.toAddSubgroup.toSubgroup' from hJI))
      have hAn : K ≤ normalizer (A : Set G) := by
        apply le_normalizer_iff.mpr
        intro k hk a ha
        obtain ⟨aH, ⟨aR, haR, rfl⟩, rfl⟩ := ha
        let kH : H := ⟨k, (le_sup_left : K ≤ H) hk⟩
        have hj := (hJs (show kH ∈ K.subgroupOf H from hk) (Additive.ofMul aR)).mpr haR
        have hm := hmap J _ hj
        change (((ρ kH (Additive.ofMul aR)).toMul : H) : G) ∈ A at hm
        rwa [reduced_action_val] at hm
      rcases hmin A hAU hAn with he | hc
      · left
        apply le_antisymm hJI
        intro v hv
        have hm : (v.toMul.val : G) ∈ A := he.symm ▸ hv
        obtain ⟨x, ⟨y, hy, rfl⟩, he⟩ := hm
        have hy' : Additive.ofMul y = v := by
          apply Additive.toMul.injective
          exact Subtype.ext (Subtype.ext he)
        exact hy' ▸ hy
      · right
        intro v hv k
        have hvA : (v.toMul.val : G) ∈ A :=
          hmap J v hv
        apply Additive.toMul.injective
        apply Subtype.ext
        apply Subtype.ext
        change (((ρ k.val v).toMul : H) : G) = (v.toMul.val : G)
        rw [reduced_action_val]
        have he := hc hvA k.val.val k.property
        change (k.val.val : G) * v.toMul.val * (k.val.val : G)⁻¹ = _
        rw [he, mul_inv_cancel_right]
  have hTK' : (T : Subgroup G).subgroupOf H ≤ normalizer (K.subgroupOf H : Set H) := by
    apply le_normalizer_iff.mpr
    intro t ht k hk
    exact (mem_normalizer_iff.mp (hTK ht) k.val).mp hk
  obtain ⟨J, hJI, hJ⟩ := exists_isIrrPlusWith_le_orbitSpan ρ hTK'
    (T.isPGroup'.of_injective (subgroupOfEquivOfLe (show (T : Subgroup G) ≤ H from le_sup_right)).toMonoidHom
      (subgroupOfEquivOfLe le_sup_right).injective) hirr
  rw [orbitSpan_eq_self ρ hTs] at hJI
  have he : J = I := (hirr.eq_or_le_fixedSpace ρ hJ.invariant hJI).resolve_right
    (hJ.isIrrPlus.not_le_fixedSpace ρ)
  exact ⟨⟨J, hJ, he ▸ himage⟩⟩

end CFSG.Quasithin.Chapter13.Section03.PlaneNoncentralitySource
