module
public import CFSG.Quasithin.Chapter13.Section03.SourceCompletion.OriginalUnitaryNoncentrality.MovedComponent
public import CFSG.Quasithin.Chapter13.Section03.Noncentrality.Components.OrdinaryDiagonalModels
public import CFSG.Quasithin.Chapter13.Section03.Noncentrality.Components.OrdinaryLinearThreeExclusion

/-!
# The selected A₅ quotient after unitary noncontainment

The literal point residual is generated by cubic elements. With three-rank
two in the original point normalizer, its escape from the selected component
removes the rank-two quotient rows. Sylow invariance rules out PSL₃(2),
leaving an actual equivalence of K/O₂(K) with A₅. The original-source
application is in SourceEscape; no module marking or block is assumed.
Source: Aschbacher--Smith 13.3.14 after (g), printed p.893.
-/

public section
open Subgroup Theory.GroupTheory
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter13.Section03.SourceCompletion
open Noncentrality Chapter1.Section02.LocalModels
variable {G : Type*} [Group G] [Finite G]

/-- Three-rank two and Sylow invariance leave precisely A₅ on the selected
component after original reduction (g). -/
theorem unitary_selected_five_quotient
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G) (T : Sylow 2 G)
    (H A : Subgroup G) (hH : IsTwoLocal H) (hTH : (T : Subgroup G) ≤ H)
    (hAH : A ≤ H) (hA : IsPPerfect 2 A)
    (hA3 : Nat.card (A ⧸ pCore 2 A) = 3)
    (hTA : (T : Subgroup G) ≤ normalizer (A : Set G))
    (h1332 : SupercriticalSource.Source1332OneTwo T)
    (K : Subgroup H) (hK : K.IsCComponent) (hq : IsQuasisimple (K ⧸ pCore 2 K))
    (hf : K.map H.subtype ∈ MainForward.faithfulLocalComponents T)
    (hHN : H ≤ normalizer (K.map H.subtype : Set G))
    (hgen : ⁅K,A.subgroupOf H⁆ = K)
    (hne : ¬ A ≤ K.map H.subtype) :
    Nonempty ((K.map H.subtype ⧸ pCore 2 (K.map H.subtype)) ≃*
      alternatingGroup (Fin 5)) := by
  let B := K.map H.subtype
  let A₀ := A.subgroupOf H
  let eA : A₀ ≃* A := subgroupOfEquivOfLe hAH
  let eK : K ≃* B := K.equivMapOfInjective H.subtype H.subtype_injective
  let eQ := QuotientGroup.congr _ _ eK (pCore_map_iso 2 eK)
  let := hq
  let : K.Normal := by
    have hn : (B.subgroupOf H).Normal :=
      normal_subgroupOf_of_le_normalizer hHN
    change ((K.map H.subtype).comap H.subtype).Normal at hn
    rwa [comap_map_eq_self_of_injective H.subtype_injective] at hn
  have hSQ := hG.twoLocal_sqtk hH
  have hAg : closure {a : A₀ | orderOf a = 3} = ⊤ := by
    apply cubic_closure_eq_top_of_twoPerfect_of_quotient_cube
      (hA.of_surjective eA.symm.toMonoidHom eA.symm.surjective)
    intro a
    have hc : Nat.card (A₀ ⧸ pCore 2 A₀) = 3 :=
      (Nat.card_congr (QuotientGroup.congr _ _ eA (pCore_map_iso 2 eA)).toEquiv).trans hA3
    rw [←hc]
    exact pow_card_eq_one'
  have hsmall : IsAlternating (B ⧸ pCore 2 B) 5 ∨
      ClassicalGroup.IsPSL (B ⧸ pCore 2 B) 3 2 := by
    apply midSize_small_of_cubic_actor_escape K A₀ hK eQ (h1332 B hf).2
      (hSQ.stronglyQuasithin 3 Nat.prime_three (by decide)) hAg
    intro hAK
    apply hne
    have hh := map_mono hAK (f := H.subtype)
    simpa only [A₀,map_subgroupOf_eq_of_le hAH] using hh
  rcases hsmall with hfive | ⟨F,_,_,hc,⟨e⟩⟩
  · exact hfive
  let := Fintype.ofFinite F
  let eF : F ≃+* ZMod 2 := FiniteField.ringEquivOfCardEq (by
    simpa only [←Nat.card_eq_fintype_card,Nat.card_zmod] using hc)
  have hgenG := congrArg (map H.subtype) hgen
  rw [map_commutator,map_subgroupOf_eq_of_le hAH] at hgenG
  exact (hne (Diagonal.actor_le_of_linearThree_quotient B A T (hAH.trans hHN)
    hTA (hTH.trans hHN) hA hA3 hgenG (e.trans (Atlas.fieldEquivPSL 3 eF)))).elim

end CFSG.Quasithin.Chapter13.Section03.SourceCompletion
