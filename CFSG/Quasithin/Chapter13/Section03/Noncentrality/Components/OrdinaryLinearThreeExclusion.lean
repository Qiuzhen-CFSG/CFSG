/-!
# Excluding the linear-three component in source 13.3.14

For a two-perfect actor with cubic quotient by its two-core, the unique
inner projection onto a centerless component quotient is equivariant for
T intersect K. In the binary linear-three case the projected actor is
generated by its commutators with that Sylow image. Its two-group kernel
then lifts this generation to containment of the original actor in K.
The actual ordinary source application contradicts reduction (g).

All actions use the literal K/O₂(K) map. No containment is inferred merely
from equality of quotient images, and no premise about an ambient quotient
kernel is used.

Source: Aschbacher--Smith, combined manuscript (1 March 2004), the final
paragraph of Lemma 13.3.14, printed p.893.
-/

public section
open Subgroup
namespace CFSG.Quasithin.Chapter13.Section03.Noncentrality.Diagonal
variable {G : Type*} [Group G] [Finite G]

omit [Finite G] in
private theorem cubic_kernel_le_core {C : Type*} [Group C]
    (A : Subgroup G) (hp : IsPPerfect 2 A)
    (hc : Nat.card (A ⧸ pCore 2 A) = 3)
    (f : A →* C) (hf : f.range ≠ ⊥) : f.ker ≤ pCore 2 A := by
  let : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  let : IsSimpleGroup (A ⧸ pCore 2 A) := isSimpleGroup_of_prime_card hc
  let q := QuotientGroup.mk' (pCore 2 A)
  have hn := (inferInstance : f.ker.Normal).map q (QuotientGroup.mk'_surjective _)
  rcases hn.eq_bot_or_eq_top with h | h
  · have hh := (map_eq_bot_iff f.ker).mp h
    simpa only [q, QuotientGroup.ker_mk'] using hh
  · have hs : f.ker ⊔ pCore 2 A = ⊤ := by
      have hh := congrArg (comap q) h
      simpa only [comap_map_eq, q, QuotientGroup.ker_mk', comap_top] using hh
    have hk := hp f.ker inferInstance
      (isPGroup_quotient_of_sup_eq_top f.ker (pCore 2 A) pCore_isPGroup hs)
    apply (hf _).elim
    apply le_bot_iff.mp
    rintro _ ⟨d, rfl⟩
    exact MonoidHom.mem_ker.mp (hk.symm ▸ mem_top d)

omit [Finite G] in
private theorem quotient_projection_equivariant (K A S : Subgroup G)
    (hn : A ≤ normalizer K) (hSA : S ≤ normalizer A) (hSK : S ≤ K)
    (hc : center (K ⧸ pCore 2 K) = ⊥)
    (f : A →* K ⧸ pCore 2 K)
    (hf : (MulAut.conj : (K ⧸ pCore 2 K) →* MulAut (K ⧸ pCore 2 K)).comp f =
      (pCoreJoinAction 2 hn).comp (inclusion le_sup_right))
    (s : S) (a : A) :
    f ⟨(s : G) * a * (s : G)⁻¹,
      (mem_normalizer_iff.mp (hSA s.property) a).mp a.property⟩ =
      QuotientGroup.mk' (pCore 2 K) ⟨s,hSK s.property⟩ * f a *
      (QuotientGroup.mk' (pCore 2 K) ⟨s,hSK s.property⟩)⁻¹ := by
  apply Theory.GroupTheory.conj_injective_of_center_eq_bot hc
  let sk : K := ⟨s,hSK s.property⟩
  let sj : (K ⊔ A : Subgroup G) := inclusion le_sup_left sk
  let aj : (K ⊔ A : Subgroup G) := inclusion le_sup_right a
  calc
    _ = pCoreJoinAction 2 hn (sj * aj * sj⁻¹) := DFunLike.congr_fun hf _
    _ = _ := by
      rw [map_mul, map_mul, map_inv]
      change pCoreJoinAction 2 hn (inclusion le_sup_left sk) *
        pCoreJoinAction 2 hn (inclusion le_sup_right a) *
        (pCoreJoinAction 2 hn (inclusion le_sup_left sk))⁻¹ = _
      have hfa := DFunLike.congr_fun hf a
      simp only [MonoidHom.comp_apply] at hfa
      rw [pCoreJoinAction_on_component, ← hfa]
      simp only [map_mul, map_inv]
      rfl

omit [Finite G] in
private theorem quotient_projection_nontrivial (K A : Subgroup G)
    (hn : A ≤ normalizer K) (hgen : ⁅K,A⁆ = K)
    (e : (K ⧸ pCore 2 K) ≃* Matrix.PSL3Two.SL)
    (f : A →* K ⧸ pCore 2 K)
    (hf : (MulAut.conj : (K ⧸ pCore 2 K) →* MulAut (K ⧸ pCore 2 K)).comp f =
      (pCoreJoinAction 2 hn).comp (inclusion le_sup_right)) : f.range ≠ ⊥ := by
  intro hb
  have hAC : A ≤ quotientCentralizer K A hn := by
    intro a ha
    refine mem_map.mpr ⟨inclusion le_sup_right ⟨a,ha⟩,?_,rfl⟩
    change pCoreJoinAction 2 hn (inclusion le_sup_right ⟨a,ha⟩) = 1
    have hfa := DFunLike.congr_fun hf ⟨a,ha⟩
    simp only [MonoidHom.comp_apply] at hfa
    rw [← hfa]
    have hz : f ⟨a,ha⟩ = 1 := mem_bot.mp (hb ▸ (show f ⟨a,ha⟩ ∈ f.range from ⟨_,rfl⟩))
    simp only [hz, map_one]
  have hKC : K ≤ K.pCoreIn 2 := by
    conv_lhs => rw [←hgen, commutator_comm]
    exact (commutator_mono hAC le_rfl).trans
      (quotientCentralizer_commutator_le_core K A hn)
  have htop : pCore 2 K = ⊤ := by
    apply top_unique
    intro k _
    obtain ⟨x,hx,hxk⟩ := hKC k.property
    exact (Subtype.ext hxk : x = k) ▸ hx
  have hcard := Nat.card_congr e.toEquiv
  rw [htop, Matrix.PSL3Two.card_SL] at hcard
  have h1 : Nat.card (K ⧸ (⊤ : Subgroup K)) = 1 :=
    Nat.card_eq_one_iff_unique.mpr ⟨QuotientGroup.subsingleton_quotient_top, ⟨1⟩⟩
  rw [h1] at hcard
  omega

/-- A Sylow-invariant cubic residual generating a binary linear-three
component by commutators is contained in that component. -/
theorem actor_le_of_linearThree_quotient (K A : Subgroup G) (T : Sylow 2 G)
    (hn : A ≤ normalizer K) (hTA : (T : Subgroup G) ≤ normalizer A)
    (hTK : (T : Subgroup G) ≤ normalizer K)
    (hp : IsPPerfect 2 A) (hcA : Nat.card (A ⧸ pCore 2 A) = 3)
    (hgen : ⁅K,A⁆ = K) (e : (K ⧸ pCore 2 K) ≃* Matrix.PSL3Two.PSL) : A ≤ K := by
  let es := e.trans Matrix.PSL3Two.equiv.symm
  have hc : center (K ⧸ pCore 2 K) = ⊥ := by
    apply eq_bot_iff.mpr
    intro x hx
    apply mem_bot.mpr
    apply es.injective
    rw [map_one]
    exact mem_bot.mp (Matrix.PSL3Two.center_eq_bot ▸
      (centerCongr es ⟨x,hx⟩).property)
  have ho : IsPGroup 2 (MulAut.Outer (K ⧸ pCore 2 K)) :=
    Matrix.PSL3Two.Automorphisms.outer_sl_isTwoGroup.of_equiv (MulAut.outerCongr es).symm
  obtain ⟨f,hf⟩ := exists_quotient_projection K A hn hp hc ho
  have hne := quotient_projection_nontrivial K A hn hgen es f hf
  have hk := cubic_kernel_le_core A hp hcA f hne
  let S := (T : Subgroup G) ⊓ K
  let g : S →* K ⧸ pCore 2 K :=
    (QuotientGroup.mk' (pCore 2 K)).comp (inclusion inf_le_right)
  have he : ∀ (s : S) (a : A),
      f ⟨(s : G) * a * (s : G)⁻¹,
        (mem_normalizer_iff.mp ((inf_le_left.trans hTA) s.property) a).mp a.property⟩ =
          g s * f a * (g s)⁻¹ :=
    quotient_projection_equivariant K A S hn (inf_le_left.trans hTA) inf_le_right hc f hf
  have hgn : g.range ≤ normalizer (f.range : Set (K ⧸ pCore 2 K)) := by
    apply le_normalizer_iff.mpr
    rintro _ ⟨s,rfl⟩ _ ⟨a,rfl⟩
    rw [←he s a]
    exact ⟨_,rfl⟩
  obtain ⟨R,hR⟩ := (T.subtype (show (T : Subgroup G) ≤ K ⊔ (T : Subgroup G) from le_sup_right)).exists_map_subtype_eq_inf_of_normalizes
    (show K ≤ K ⊔ (T : Subgroup G) from le_sup_left) (sup_le K.le_normalizer hTK)
  have hR' : (R : Subgroup K) = (T : Subgroup G).subgroupOf K := by
    apply map_injective K.subtype_injective
    rw [hR, Sylow.coe_subtype, map_subgroupOf_eq_of_le le_sup_right, subgroupOf_map_subtype]
  let Q := R.mapSurjective (QuotientGroup.mk'_surjective (pCore 2 K))
  have hQ : (Q : Subgroup (K ⧸ pCore 2 K)) = g.range := by
    change (R : Subgroup K).map (QuotientGroup.mk' (pCore 2 K)) = _
    rw [hR']
    ext x
    constructor
    · rintro ⟨k,hk,rfl⟩
      exact ⟨⟨k,hk,k.property⟩,rfl⟩
    · rintro ⟨s,rfl⟩
      exact ⟨⟨s,s.property.2⟩,s.property.1,rfl⟩
  let B := f.range.map es.toMonoidHom
  let Q' := Q.mapSurjective (f := es.toMonoidHom) es.surjective
  have hB : IsPPerfect 2 B :=
    (hp.of_surjective f.rangeRestrict f.rangeRestrict_surjective).of_surjective
      (es.subgroupMap f.range).toMonoidHom (es.subgroupMap f.range).surjective
  have hfc : Nat.card (f.range ⧸ pCore 2 f.range) = 3 := by
    have hker : IsPGroup 2 f.rangeRestrict.ker := by
      rw [MonoidHom.ker_rangeRestrict]
      exact pCore_isPGroup.to_le hk
    let i := f.rangeRestrict.pCoreQuotientEquiv f.rangeRestrict_surjective hker
    exact (Nat.card_congr i.toEquiv).symm.trans hcA
  have hBc : Nat.card (B ⧸ pCore 2 B) = 3 := by
    let i := es.subgroupMap f.range
    let j := QuotientGroup.congr (pCore 2 f.range) (pCore 2 B) i (pCore_map_iso 2 i)
    exact (Nat.card_congr j.toEquiv).symm.trans hfc
  have hQn : (Q' : Subgroup Matrix.PSL3Two.SL) ≤ normalizer (B : Set Matrix.PSL3Two.SL) := by
    exact (map_mono (f := es.toMonoidHom) (hQ ▸ hgn)).trans (le_normalizer_map _)
  have hcomm : ⁅f.range,g.range⁆ = f.range := by
    apply map_injective (f := es.toMonoidHom) es.injective
    rw [map_commutator, ←hQ]
    exact Matrix.PSL3Two.ResidualRecognition.commutator_sylow_eq B Q' hB hBc hQn
  exact le_of_equivariant_projection A K S hp (inf_le_left.trans hTA) inf_le_right hn
    f g (pCore_isPGroup.to_le hk) he hcomm

end CFSG.Quasithin.Chapter13.Section03.Noncentrality.Diagonal

open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter13.Section03.Noncentrality
open Section08.SourceCompletion
open Section08.TransvectionRecognition.Component.ModelExtension
open Section08.ComponentSieve.FieldComponents.LinearThree.Geometry.CoveredProduct.ResidualPlacement
variable {G : Type*} [Group G] [Finite G]

/-- The final paragraph of 13.3.14 excludes the binary linear-three row
on the actual selected component, using the original noncontainment (g). -/
theorem ordinary_component_not_linearThree
    {T : Sylow 2 G} {L V P E U M H : Subgroup G}
    (d : NaturalSetup T L V P E U M H)
    (eL : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 6))
    (h1332 : SupercriticalSource.Source1332OneTwo T)
    (K : Subgroup H)
    (hf : K.map H.subtype ∈ MainForward.faithfulLocalComponents T)
    (hn : (sourceOne L T P).subgroupOf H ≤ normalizer (K : Set H))
    (hgen : ⁅K,(sourceOne L T P).subgroupOf H⁆ = K)
    (hnot : ¬sourceOne L T P ≤ K.map H.subtype) :
    ¬ Nonempty ((K ⧸ pCore 2 K) ≃* Matrix.PSL3Two.PSL) := by
  rintro ⟨e⟩
  apply hnot
  have hnG : sourceOne L T P ≤ normalizer (K.map H.subtype : Set G) := by
    have hh := (map_mono hn).trans (K.le_normalizer_map H.subtype)
    rwa [map_subgroupOf_eq_of_le (ordinary_point_residual_le_point d)] at hh
  have hgenG := congrArg (map H.subtype) hgen
  rw [map_commutator, map_subgroupOf_eq_of_le (ordinary_point_residual_le_point d)] at hgenG
  let i := equivMapOfInjective K H.subtype H.subtype_injective
  let q := QuotientGroup.congr (pCore 2 K) (pCore 2 (K.map H.subtype)) i (pCore_map_iso 2 i)
  exact Diagonal.actor_le_of_linearThree_quotient (K.map H.subtype) (sourceOne L T P) T
    hnG (T_normalizes_one L T P d.line_stable) (h1332 _ hf).1
    ordinary_point_residual_twoPerfect (ordinary_point_residual_quotient_card d eL)
    hgenG (q.symm.trans e)

end CFSG.Quasithin.Chapter13.Section03.Noncentrality
