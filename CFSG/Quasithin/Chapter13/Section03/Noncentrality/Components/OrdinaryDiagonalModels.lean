module
public import CFSG.Quasithin.Chapter13.Section03.Noncentrality.Components.OrdinaryDiagonalModels.Core
public import CFSG.Quasithin.Chapter13.Section03.Noncentrality.Components.OrdinaryNormalizers
public import CFSG.Quasithin.Chapter13.Section03.Noncentrality.OrdinaryDiagonal
/-!
# The quotient models in the original ordinary diagonal argument

The point residual has quotient of order three by its two-core and is
two-perfect, hence is generated by its actual cubic elements. The original
point normalizer supplies the three-rank bound and normality of the selected
faithful component. Source noncontainment therefore removes A₆, its triple
cover and PSU₃(3), leaving A₅ or PSL₃(2) on the literal ambient two-core quotient.

The final constructor applies those facts directly to OrdinaryDiagonalData.
Only noncontainment and the remaining module/core geometry stay explicit;
the centerless and outer-two model conditions are proved here. The earlier
13.3.2 input is unchanged. No plane noncentrality or F.9 conclusion is assumed.

Source: Aschbacher–Smith, 13.3.14 after (g), printed p.893.
-/

public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter13.Section03.Noncentrality
open SupercriticalSource Chapter1.Section02.LocalModels
open Section08.SourceCompletion
open Section08.TransvectionRecognition.Component.ModelExtension
universe u
variable {G : Type u} [Group G] [Finite G]
variable {T : Sylow 2 G} {L V P E U M H : Subgroup G}
  (d : NaturalSetup T L V P E U M H)
include d

/-- The original source actor is generated by its actual order-three elements. -/
theorem ordinary_point_cubic_generation
    (e : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 6)) :
    closure {x : sourceOne L T P | orderOf x = 3} = ⊤ := by
  apply cubic_closure_eq_top_of_twoPerfect_of_quotient_cube ordinary_point_residual_twoPerfect
  intro x
  rw [←ordinary_point_residual_quotient_card d e]
  exact pow_card_eq_one'

/-- Source 13.3.14 after (g), on the literal ambient selected component.
The earlier 13.3.2 input and the genuine noncontainment remain explicit. -/
theorem ordinary_selected_small_quotient
    (e : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 6))
    (h1332 : Source1332OneTwo T) (K : Subgroup H) (hK : K.IsCComponent)
    (hq : IsQuasisimple (K ⧸ pCore 2 K))
    (hf : K.map H.subtype ∈ MainForward.faithfulLocalComponents T)
    (hne : ¬ sourceOne L T P ≤ K.map H.subtype) :
    IsAlternating (K.map H.subtype ⧸ pCore 2 (K.map H.subtype)) 5 ∨
      ClassicalGroup.IsPSL (K.map H.subtype ⧸ pCore 2 (K.map H.subtype)) 3 2 := by
  let B := K.map H.subtype
  let A := (sourceOne L T P).subgroupOf H
  let eA : A ≃* sourceOne L T P := subgroupOfEquivOfLe (ordinary_point_residual_le_point d)
  let eK : K ≃* B := K.equivMapOfInjective H.subtype H.subtype_injective
  let eQ := QuotientGroup.congr _ _ eK (pCore_map_iso 2 eK)
  let := hq
  let := ordinary_component_normal d h1332 K hK hf
  have hP : P ≠ ⊥ := by intro he; have hc := d.line_card; simp [he] at hc
  have htwo : IsTwoLocal H := by
    rw [d.first_normalizer]
    exact ⟨P,hP,IsPGroup.of_card (n := 1) (by simpa using d.line_card),rfl⟩
  have hH := d.counterexample.qtke.twoLocal_sqtk htwo
  have hA : closure {a : A | orderOf a = 3} = ⊤ := by
    apply cubic_closure_eq_top_of_twoPerfect_of_quotient_cube
      (ordinary_point_residual_twoPerfect.of_surjective eA.symm.toMonoidHom eA.symm.surjective)
    intro a
    have hc : Nat.card (A ⧸ pCore 2 A) = 3 :=
      (Nat.card_congr (QuotientGroup.congr _ _ eA (pCore_map_iso 2 eA)).toEquiv).trans
        (ordinary_point_residual_quotient_card d e)
    rw [←hc]
    exact pow_card_eq_one'
  apply midSize_small_of_cubic_actor_escape K A hK eQ (h1332 B hf).2
    (hH.stronglyQuasithin 3 Nat.prime_three (by decide)) hA
  intro hAK
  apply hne
  have hh := map_mono hAK (f := H.subtype)
  simpa only [A,map_subgroupOf_eq_of_le (ordinary_point_residual_le_point d)] using hh

/-- The center and outer hypotheses of `OrdinaryDiagonalData` follow from the
source quotient list and noncontainment; they are not extra model assumptions. -/
theorem ordinary_selected_diagonal_model_facts
    (e : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 6))
    (h1332 : Source1332OneTwo T) (K : Subgroup H) (hK : K.IsCComponent)
    (hq : IsQuasisimple (K ⧸ pCore 2 K))
    (hf : K.map H.subtype ∈ MainForward.faithfulLocalComponents T)
    (hne : ¬ sourceOne L T P ≤ K.map H.subtype) :
    center (K.map H.subtype ⧸ pCore 2 (K.map H.subtype)) = ⊥ ∧
      IsPGroup 2 (MulAut.Outer (K.map H.subtype ⧸ pCore 2 (K.map H.subtype))) :=
  small_diagonal_model_facts (ordinary_selected_small_quotient d e h1332 K hK hq hf hne)

/-- The literal ordinary diagonal datum needs only its remaining geometry;
its center and outer-group fields are supplied by the selected-component sieve. -/
theorem ordinary_diagonalData_of_geometry
    (e : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 6))
    (h1332 : Source1332OneTwo T) (K : Subgroup H) (hK : K.IsCComponent)
    (hq : IsQuasisimple (K ⧸ pCore 2 K))
    (hf : K.map H.subtype ∈ MainForward.faithfulLocalComponents T)
    (hne : ¬ sourceOne L T P ≤ K.map H.subtype)
    (hfix : ∀ hn : sourceOne L T P ≤ normalizer (K.map H.subtype : Set G),
      Diagonal.centralizerResidual (K.map H.subtype) (sourceOne L T P) hn ≤
        centralizer (Diagonal.movedModule (K.map H.subtype) (sourceOne L T P) T : Set G))
    (hdec :
      ((Diagonal.localGroup (K.map H.subtype) (sourceOne L T P) T).pCoreIn 2 ⊓
          centralizer (K.map H.subtype : Set G)) ⊔
        Diagonal.movedModule (K.map H.subtype) (sourceOne L T P) T =
          (Diagonal.localGroup (K.map H.subtype) (sourceOne L T P) T).pCoreIn 2)
    (hdis : Disjoint
      ((Diagonal.localGroup (K.map H.subtype) (sourceOne L T P) T).pCoreIn 2 ⊓
        centralizer (K.map H.subtype : Set G))
      (Diagonal.movedModule (K.map H.subtype) (sourceOne L T P) T))
    (hcom : ⁅(Diagonal.localGroup (K.map H.subtype) (sourceOne L T P) T).pCoreIn 2,
        sourceOne L T P⁆ ≤ Diagonal.movedModule (K.map H.subtype) (sourceOne L T P) T) :
    OrdinaryDiagonalData (K.map H.subtype) (sourceOne L T P) T := by
  obtain ⟨hz,ho⟩ := ordinary_selected_diagonal_model_facts d e h1332 K hK hq hf hne
  exact ⟨hne,hz,ho,hfix,hdec,hdis,hcom⟩

end CFSG.Quasithin.Chapter13.Section03.Noncentrality
