/-- H and its literal two-residual move the same omega orbit. -/
theorem omegaOrbit_commutator_eq_residual
    (hH : H ∈ Chapter3.HStar (T : Subgroup G) (normalizer (L : Set G))) :
    ⁅omegaOrbit T H,H⁆ = ⁅omegaOrbit T H,(pResidual 2 H).map H.subtype⁆ := by
  let S := T.subtype hH.1.1.2
  let U := (omegaOrbit T H).subgroupOf H
  have hZH : omegaOneCenterAmbient (T : Subgroup G) ≤ H :=
    fun _ hz => hH.1.1.2 ((mem_omegaOneCenterAmbient_iff _ _).mp hz).1
  have hUH : omegaOrbit T H ≤ H := conjugateSpanBy_le hZH H.le_normalizer
  have hz : omegaOneCenterAmbient (S : Subgroup H) =
      (omegaOneCenterAmbient (T : Subgroup G)).subgroupOf H := by
    apply map_injective H.subtype_injective
    rw [←omegaOneCenterAmbient_map_injective H.subtype H.subtype_injective,
      map_subgroupOf_eq_of_le hZH]
    congr 1
    exact map_subgroupOf_eq_of_le hH.1.1.2
  have hu : U = normalClosure (omegaOneCenterAmbient (S : Subgroup H) : Set H) := by
    rw [hz,normalClosure_subgroupOf_eq_conjugateSpanBy _ H hZH]
  have hh := congrArg (map H.subtype) (omegaCenter_span_commutator S U hu)
  have hum : U.map H.subtype = omegaOrbit T H := map_subgroupOf_eq_of_le hUH
  simpa only [map_commutator, hum, ←MonoidHom.range_eq_map, range_subtype] using hh

/-- A paired original outside group supplies coordinates on its literal moved
subgroup and the actual image of its embedded residual. -/
theorem paired_residual_coordinates
    (hH : H ∈ Chapter3.HStar (T : Subgroup G) (normalizer (L : Set G)))
    (hB : normalizer (ChapterB.baumann (T : Subgroup G) : Set G) ≤ normalizer (L : Set G))
    (hZ : ¬ H ≤ centralizer (omegaOneCenterAmbient (T : Subgroup G) : Set G))
    (hs : Group.IsSolvable H)
    (hpair : Nonempty ((H ⧸ pCore 2 H) ≃* WreathTwoResidual.Actor)) :
    let W := ⁅omegaOrbit T H, (pResidual 2 H).map H.subtype⁆
    ∃ hW : IsElementaryAbelian 2 W,
      let := hW
      ∃ c : Additive W ≃ₗ[ZMod 2] Space,
        (((pResidual 2 H).map H.subtype).subgroupOf (normalizer (W : Set G))).map
          (coordinateAction W c) = linearRotations := by
  let U := (omegaOrbit T H).subgroupOf H
  let hU := omegaOrbit_reduced d.hypothesis.qtke T hH
  let := hU.normal
  let := hU.elementary
  let C := centralizer (U : Set H)
  let q := QuotientGroup.mk' C
  let ρ := NormalElementaryQuotient.representation U q
    (QuotientGroup.mk'_surjective C) (QuotientGroup.ker_mk' C)
  obtain ⟨D,_,_,_,_,_,_⟩ := source_solvable_omega_action d hH hB hZ hs
  obtain ⟨_,_,hp,_,hj⟩ := e23_hypotheses d.hypothesis.qtke T d.normalizes_L hH hB hZ
  have hne : q.ker ≠ ⊤ := by
    intro he
    apply hj
    rw [QuotientGroup.ker_mk'] at he
    exact le_top.trans he.ge
  have hpq := (ChapterB.minimalParabolic_reduced_image (T.subtype hH.1.1.2) hp q
    (QuotientGroup.mk'_surjective C) hU.quotient_pCore_eq_bot hne).2
  have hr := (ChapterB.offender_generation
    ((T.subtype hH.1.1.2).mapSurjective (QuotientGroup.mk'_surjective C)) hpq ρ
    ((isFFModule_iff_quadraticRatio_le_one ρ).mpr D.ratio_one.le)
    hU.quotient_pCore_eq_bot).1
  have hf := NormalElementaryQuotient.representation_injective U q
    (QuotientGroup.mk'_surjective C) (QuotientGroup.ker_mk' C)
  have hnat := source_solvable_whole_omega_action d hH hB hZ hs
  have hc : C = pCore 2 H := source_omega_centralizer_eq_twoCore d hH hB hZ hs
  have hQ : Nat.card (H ⧸ C) = 72 := by
    obtain ⟨e⟩ := hpair
    rw [Nat.card_congr ((QuotientGroup.quotientMulEquivOfEq hc).trans e).toEquiv,
      RegularWreathProduct.card]
    have hSL : Nat.card (Matrix.SpecialLinearGroup (Fin 2) (ZMod 2)) = 6 := by
      obtain ⟨eS⟩ := SLTwoPermThree.sl2Two_equiv_perm_three
      rw [Nat.card_congr eS.toEquiv,Nat.card_perm,Nat.card_fin]
      decide
    rw [hSL]
    norm_num [Nat.card_eq_fintype_card]
  obtain ⟨c,e,he⟩ :
      ∃ (c : subspaceCommutator ρ ⊤ (offenderSubgroup ρ) ≃ₗ[ZMod 2] Space)
        (e : (H ⧸ C) ≃* TerminalLines.IsometryGroup),
        ∀ g v, c ((ChapterB.SolvableFFFactors.naturalMovedSubrepresentation (ρ := ρ)).toRepresentation g v) =
          (e g).val (c v) := by
    change ChapterB.SmallNaturalMovedAction ρ at hnat
    unfold ChapterB.SmallNaturalMovedAction at hnat
    rcases hnat with ⟨c,e,_⟩ | hnat
    · obtain ⟨eS⟩ := SLTwoPermThree.sl2Two_equiv_perm_three
      have hh := Nat.card_congr (e.trans eS).toEquiv
      rw [hQ,Nat.card_perm,Nat.card_fin] at hh
      norm_num [Nat.factorial] at hh
    · exact hnat
  let R := pResidual 2 H
  let W₀ := ⁅U,R⁆
  let W := W₀.map H.subtype
  have hUH : omegaOrbit T H ≤ H := conjugateSpanBy_le
    (fun _ hz => hH.1.1.2 ((mem_omegaOneCenterAmbient_iff _ _).mp hz).1) H.le_normalizer
  have hW : W = ⁅omegaOrbit T H,R.map H.subtype⁆ := by
    change (⁅U,R⁆).map H.subtype = _
    rw [map_commutator, show U.map H.subtype = omegaOrbit T H from
      map_subgroupOf_eq_of_le hUH]
  let : IsElementaryAbelian 2 W₀ := IsElementaryAbelian.of_le (commutator_le_left U R)
  let : IsElementaryAbelian 2 W := IsElementaryAbelian.map H.subtype
  have hHW : H ≤ normalizer (W : Set G) := by
    have hh := W₀.le_normalizer_map H.subtype
    rw [normalizer_eq_top,←MonoidHom.range_eq_map,range_subtype] at hh
    exact hh
  let e₀ := W₀.equivMapOfInjective H.subtype H.subtype_injective
  let f₀ : Additive W ≃ₗ[ZMod 2] Additive W₀ := e₀.symm.toAdditive.toLinearEquiv
    (fun t v => ZMod.map_smul e₀.symm.toAdditive.toAddMonoidHom t v)
  have hspace : subspaceCommutator ρ ⊤ (R.map q) =
      subspaceCommutator ρ ⊤ (offenderSubgroup ρ) := by
    rw [map_pResidual_of_surjective 2 q (QuotientGroup.mk'_surjective C)]
    exact D.toSolvableFFFactors.residual_moved_eq hf hr
  let f := f₀.trans ((NormalElementaryQuotient.movedEquiv U q
    (QuotientGroup.mk'_surjective C) (QuotientGroup.ker_mk' C) R).trans
      (LinearEquiv.ofEq _ _ hspace))
  let cW := f.trans c
  have hfe (w : W) : ((f (Additive.ofMul w)).val.toMul : G) = w := by
    change (((e₀.symm w : W₀) : H) : G) = w
    exact congrArg Subtype.val (e₀.apply_symm_apply w)
  have heq (h : H) (w : W) :
      coordinateAction W cW ⟨h,hHW h.property⟩ (cW (Additive.ofMul w)) =
        (e (q h)).val (cW (Additive.ofMul w)) := by
    rw [coordinateAction_apply]
    change c (f (Additive.ofMul (W.normalizerMonoidHom ⟨h,hHW h.property⟩ w))) =
      (e (q h)).val (c (f (Additive.ofMul w)))
    rw [← he (q h) (f (Additive.ofMul w))]
    apply congrArg c
    apply Subtype.ext
    apply Additive.toMul.injective
    apply Subtype.ext
    apply H.subtype_injective
    change ((f (Additive.ofMul (W.normalizerMonoidHom ⟨h,hHW h.property⟩ w))).val.toMul : G) = _
    rw [hfe]
    change (h:G)*(w:G)*(h:G)⁻¹ =
      H.subtype ((ρ (q h) (f (Additive.ofMul w)).val).toMul)
    rw [NormalElementaryQuotient.representation_apply]
    simp only [map_mul,map_inv]
    change (h:G)*(w:G)*(h:G)⁻¹ =
      (h:G)*((f (Additive.ofMul w)).val.toMul : G)*(h:G)⁻¹
    rw [hfe]
  have him := embedded_residual_image W cW H hHW
    (e.toMonoidHom.comp q) (e.surjective.comp (QuotientGroup.mk'_surjective C)) heq
  rw [← hW]
  exact ⟨inferInstance,cW,him⟩


