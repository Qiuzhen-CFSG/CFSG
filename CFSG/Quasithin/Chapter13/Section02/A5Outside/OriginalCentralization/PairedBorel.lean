/-- The literal Borel residual is two-perfect, including both ambient maps. -/
theorem borelResidual_twoPerfect : IsPPerfect 2 (borelResidual T L) := by
  let N := normalizer ((T : Subgroup G).subgroupOf L : Set L)
  exact (isPPerfect_embedded_pResidual 2 N).of_surjective
    (L.subtype.subgroupMap ((pResidual 2 N).map N.subtype))
    (L.subtype.subgroupMap_surjective _)

/-- The paired case of the original calculation in 13.2.14: normalizing the
literal residual forces L₁ to centralize the whole omega orbit. -/
theorem paired_borelResidual_centralizes_omegaOrbit_of_normalizes
    (hH : H ∈ Chapter3.HStar (T : Subgroup G) (normalizer (L : Set G)))
    (hB : normalizer (ChapterB.baumann (T : Subgroup G) : Set G) ≤ normalizer (L : Set G))
    (hZ : ¬ H ≤ centralizer (omegaOneCenterAmbient (T : Subgroup G) : Set G))
    (hs : Group.IsSolvable H)
    (hpair : Nonempty ((H ⧸ pCore 2 H) ≃* WreathTwoResidual.Actor))
    (hn : borelResidual T L ≤ normalizer (((pResidual 2 H).map H.subtype) : Set G)) :
    borelResidual T L ≤ centralizer (omegaOrbit T H : Set G) := by
  let A := borelResidual T L
  let R := (pResidual 2 H).map H.subtype
  let U := omegaOrbit T H
  let Z := omegaOneCenterAmbient (T : Subgroup G)
  let W := ⁅U,R⁆
  have hAZ : A ≤ centralizer (Z : Set G) :=
    borelResidual_centralizes_omega_of_omega_movement d hH hZ
  have hspan : U = conjugateSpanBy Z R := omegaOrbit_eq_residual_span hH
  have hAU : A ≤ normalizer (U : Set G) := by
    rw [hspan]
    exact normalizes_conjugateSpanBy Z R A
      (hAZ.trans (Subgroup.centralizer_le_normalizer _)) hn
  have hAW : A ≤ normalizer (W : Set G) := by
    intro a ha
    change a ∈ normalizer ((⁅U,R⁆ : Subgroup G) : Set G)
    rw [mem_normalizer_iff_map_conj_eq,map_commutator,
      mem_normalizer_iff_map_conj_eq.mp (hAU ha),
      mem_normalizer_iff_map_conj_eq.mp (hn ha)]
  obtain ⟨hW,c,himage⟩ := paired_residual_coordinates d hH hB hZ hs hpair
  let := hW
  have hcW : ⁅A,R⁆ ≤ centralizer (W : Set G) :=
    commutator_centralizes_of_rotations W c A R borelResidual_twoPerfect
      hAW (normalizer_commutator_ge_right U R) hn himage
  have hfixed : A ⊔ R ≤ centralizer ((Z ⊓ centralizer (H : Set G) : Subgroup G) : Set G) := by
    apply sup_le (hAZ.trans (centralizer_le inf_le_left))
    intro r hr z hz
    exact (hz.2 r ((map_subtype_le _) hr)).symm
  have hsplit : W ⊔ (Z ⊓ centralizer (H : Set G)) = U := by
    have hh := (source_omegaOrbit_splitting d hH hB hZ hs).1
    rw [omegaOrbit_commutator_eq_residual hH] at hh
    exact hh
  have hcU : ⁅A,R⁆ ≤ centralizer (U : Set G) := by
    apply le_centralizer_iff.mpr
    rw [← hsplit]
    exact sup_le (le_centralizer_iff.mp hcW)
      (le_centralizer_iff.mp ((Subgroup.commutator_le_sup A R).trans hfixed))
  change A ≤ centralizer (U : Set G)
  rw [hspan] at hcU ⊢
  exact centralizes_conjugateSpan_of_commutator_centralizes A R Z hAZ hcU

/-- Source 13.2.10 and a nontrivial core in the original Borel join supply
residual normalization. The core premise is the independent 13.2.12 step. -/
theorem paired_borelResidual_normalizes_residual_of_join_core
    (hn : ∀ K ∈ MainForward.faithfulLocalComponents T,
      (T : Subgroup G) ≤ normalizer (K : Set G))
    (hH : H ∈ Chapter3.HStar (T : Subgroup G) (normalizer (L : Set G)))
    (hB : normalizer (ChapterB.baumann (T : Subgroup G) : Set G) ≤ normalizer (L : Set G))
    (hZ : ¬ H ≤ centralizer (omegaOneCenterAmbient (T : Subgroup G) : Set G))
    (hs : Group.IsSolvable H)
    (hpair : Nonempty ((H ⧸ pCore 2 H) ≃* WreathTwoResidual.Actor))
    (hcore : (H ⊔ borelResidual T L).pCoreIn 2 ≠ ⊥) :
    borelResidual T L ≤ normalizer (((pResidual 2 H).map H.subtype) : Set G) := by
  obtain ⟨e⟩ := hpair
  have hu := source_wreath_residual_normalizer_unique_of_normalizes_faithful
    d hn hH hB hZ hs e
  obtain ⟨M,hM,hjoin⟩ := exists_maximalTwoLocal_overgroup_of_twoCore_ne_bot
    (H ⊔ borelResidual T L) (by
      intro hz
      apply hcore
      simp only [pCoreIn,hz,Subgroup.map_bot])
  have he : M = normalizer (((pResidual 2 H).map H.subtype) : Set G) := by
    have hm : M ∈ {M : Subgroup G | IsMaximalTwoLocal M ∧ H ≤ M} :=
      ⟨hM,le_sup_left.trans hjoin⟩
    rw [hu.2] at hm
    exact Set.mem_singleton_iff.mp hm
  exact he ▸ le_sup_right.trans hjoin

/-- The actual paired Borel calculation, with its independent earlier source
premises retained and no extra action or centrality callback. -/
theorem paired_borelResidual_centralizes_omegaOrbit_of_join_core
    (hn : ∀ K ∈ MainForward.faithfulLocalComponents T,
      (T : Subgroup G) ≤ normalizer (K : Set G))
    (hH : H ∈ Chapter3.HStar (T : Subgroup G) (normalizer (L : Set G)))
    (hB : normalizer (ChapterB.baumann (T : Subgroup G) : Set G) ≤ normalizer (L : Set G))
    (hZ : ¬ H ≤ centralizer (omegaOneCenterAmbient (T : Subgroup G) : Set G))
    (hs : Group.IsSolvable H)
    (hpair : Nonempty ((H ⧸ pCore 2 H) ≃* WreathTwoResidual.Actor))
    (hcore : (H ⊔ borelResidual T L).pCoreIn 2 ≠ ⊥) :
    borelResidual T L ≤ centralizer (omegaOrbit T H : Set G) :=
  paired_borelResidual_centralizes_omegaOrbit_of_normalizes d hH hB hZ hs hpair
    (paired_borelResidual_normalizes_residual_of_join_core d hn hH hB hZ hs hpair hcore)

/-- Under the paired source hypotheses, passing from H to its literal Borel
join does not enlarge the omega orbit, and the Borel/residual commutator
lies in the actual two-core of O²(H). These are the centrality consequences
used in the last paragraph of 13.2.14. -/
theorem paired_borel_join_control
    (hn : ∀ K ∈ MainForward.faithfulLocalComponents T,
      (T : Subgroup G) ≤ normalizer (K : Set G))
    (hH : H ∈ Chapter3.HStar (T : Subgroup G) (normalizer (L : Set G)))
    (hB : normalizer (ChapterB.baumann (T : Subgroup G) : Set G) ≤ normalizer (L : Set G))
    (hZ : ¬ H ≤ centralizer (omegaOneCenterAmbient (T : Subgroup G) : Set G))
    (hs : Group.IsSolvable H)
    (hpair : Nonempty ((H ⧸ pCore 2 H) ≃* WreathTwoResidual.Actor))
    (hcore : (H ⊔ borelResidual T L).pCoreIn 2 ≠ ⊥) :
    borelResidual T L ≤ centralizer (omegaOrbit T H : Set G) ∧
      omegaOrbit T (H ⊔ borelResidual T L) = omegaOrbit T H ∧
      ⁅borelResidual T L,(pResidual 2 H).map H.subtype⁆ ≤
        ((pResidual 2 H).map H.subtype).pCoreIn 2 := by
  let A := borelResidual T L
  let R := (pResidual 2 H).map H.subtype
  let U := omegaOrbit T H
  have hAR : A ≤ normalizer (R : Set G) :=
    paired_borelResidual_normalizes_residual_of_join_core d hn hH hB hZ hs hpair hcore
  have hAU : A ≤ centralizer (U : Set G) :=
    paired_borelResidual_centralizes_omegaOrbit_of_normalizes d hH hB hZ hs hpair hAR
  have hHU : H ≤ normalizer (U : Set G) := le_normalizer_conjugateSpanBy _ _
  refine ⟨hAU,?_,?_⟩
  · exact le_antisymm
      (conjugateSpanBy_le (le_conjugateSpanBy _ _)
        (sup_le hHU (hAU.trans (Subgroup.centralizer_le_normalizer _))))
      (conjugateSpanBy_mono le_rfl le_sup_left)
  · have hCH : ⁅A,R⁆ ≤ H :=
      (le_normalizer_iff_commutator_le_right.mp hAR).trans (map_subtype_le _)
    have hRC : R ≤ normalizer (centralizer (U : Set G) : Set G) :=
      (map_subtype_le _).trans (hHU.trans (normalizer_le_normalizer_centralizer U))
    have hCU : ⁅A,R⁆ ≤ centralizer (U : Set G) :=
      (commutator_mono hAU le_rfl).trans
        (le_normalizer_iff_commutator_le_left.mp hRC)
    have hker := source_omega_centralizer_eq_twoCore d hH hB hZ hs
    have hcoreH : ⁅A,R⁆ ≤ H.pCoreIn 2 := by
      intro x hx
      have hxker : (⟨x,hCH hx⟩ : H) ∈ centralizer (U.subgroupOf H : Set H) := by
        intro u hu
        exact Subtype.ext (hCU hx u hu)
      rw [hker] at hxker
      exact mem_map_of_mem H.subtype hxker
    exact le_pCoreIn_of_normalizes ((isPGroup_pCoreIn 2 H).to_le hcoreH)
      (le_normalizer_iff_commutator_le_right.mp hAR)
      (normalizer_commutator_ge_right A R)

end CFSG.Quasithin.Chapter13.Section02.A5Outside.OriginalCentralization
