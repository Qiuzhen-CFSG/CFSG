/-- The literal omega orbit is generated by the same seed under O²(H). -/
theorem omegaOrbit_eq_residual_span
    (hH : H ∈ Chapter3.HStar (T : Subgroup G) (normalizer (L : Set G))) :
    omegaOrbit T H = conjugateSpanBy (omegaOneCenterAmbient (T : Subgroup G))
      ((pResidual 2 H).map H.subtype) := by
  have hTH : (T : Subgroup G) ≤ H := hH.1.1.2
  have hgen : (pResidual 2 H).map H.subtype ⊔ (T : Subgroup G) = H := by
    have hh := congrArg (map H.subtype) (pResidual_sup_sylow_eq_top (T.subtype hTH))
    rw [Subgroup.map_sup, ← MonoidHom.range_eq_map, range_subtype] at hh
    change (pResidual 2 H).map H.subtype ⊔
      ((T : Subgroup G).subgroupOf H).map H.subtype = H at hh
    rwa [map_subgroupOf_eq_of_le hTH] at hh
  change conjugateSpanBy _ H = _
  conv_lhs => rw [← hgen]
  apply conjugateSpanBy_sup_of_normalizes_seed
  · apply (le_centralizer_iff.mp ?_).trans (Subgroup.centralizer_le_normalizer _)
    exact fun _ hz => ((mem_omegaOneCenterAmbient_iff _ _).mp hz).2.2
  · have hn : H ≤ normalizer (((pResidual 2 H).map H.subtype) : Set G) := by
      have h := (pResidual 2 H).le_normalizer_map H.subtype
      rw [normalizer_eq_top,←MonoidHom.range_eq_map,range_subtype] at h
      exact h
    exact hH.1.1.2.trans hn

