module
public import CFSG.Quasithin.Chapter13.Section02.A5Outside.FaithfulResidual
public import CFSG.Quasithin.ChapterE.Section02.Structure.OriginalNormal
public import CFSG.Quasithin.ChapterE.Section06.FixedPointBounds.ParabolicCartan.Localization
public import CFSG.Quasithin.ChapterC.Section05.CounterexampleCharacteristic.ReducedGroup
public import FeitThompson.FinalTheorem

/-!
# The original nonsolvable outside residual and its omega-action kernel

A nonsolvable H-star member has a nonnormal Sylow subgroup and is therefore
minimal parabolic, independently of Baumann control. The original E.2.2
component construction gives H=KT. Its Sylow orbit is O²(H); movement of
Ω₁Z(T) makes that orbit faithful, and A.4.8 descends faithfulness to K.

With the earlier normalization of faithful components, the orbit collapses
to K. The uniform A5 hypothesis identifies its literal two-core quotient;
local-component rigidity makes it maximal in the original local family.
The center identity in E.2.2 then kills the image of the maximal-overgroup
core modulo O₂(H). The reduced omega action has proper kernel in that core,
so its kernel is exactly O₂(H).

These facts are the nonsolvable structural step in original 13.2.8(1), not
its solvability conclusion. Earlier faithful-component normalization remains
with qt-d-1332-source. The generation-parameter argument and the solvable
Borel-join/amalgam argument remain with qt-d-1367-assembly; neither a Baumann
bound nor outside-centralization is assumed here.

Source: Aschbacher--Smith 13.2.8(1), p.880; E.2.2, pp.215--216;
B.6.8, pp.114--115; A.4.8, p.59; and 13.1.2(5), p.866.
-/

public section
open Subgroup Theory.GroupTheory Stellmacher
namespace CFSG.Quasithin.Chapter13.Section02.A5Outside.OriginalCentralization
variable {G : Type*} [Group G] [Finite G]
  {T : Sylow 2 G} {L V V₁ V₂ V₃ H : Subgroup G}
  (d : Section05.A5Source.Context T L V V₁ V₂ V₃)
include d

private theorem nonsolvable_minimalParabolic
    (hH : H ∈ Chapter3.HStar (T : Subgroup G) (normalizer (L : Set G)))
    (hs : ¬ Group.IsSolvable H) :
    ChapterB.IsMinimalParabolicOver (T.subtype hH.1.1.2) ⊤ := by
  let S := T.subtype hH.1.1.2
  have hn : ¬ (S : Subgroup H).Normal := by
    intro hn
    let := hn
    let : Group.IsNilpotent S := S.isPGroup'.isNilpotent
    have hodd : Odd (Nat.card (H ⧸ (S : Subgroup H))) := by
      rw [← index_eq_card]
      exact Nat.not_even_iff_odd.mp (fun h => S.not_dvd_index h.two_dvd)
    exact hs ((Group.isSolvable_iff_subgroup_quotient (S : Subgroup H)).mpr
      ⟨inferInstance, odd_order_theorem _ hodd⟩)
  exact ChapterE.Section06.FixedPointBounds.ParabolicCartan.minimalParabolic_subtype T H
    (Chapter3.HStar.minimalParabolic T d.normalizes_L hH (Or.inr hn))

/-- A nonsolvable original outside member is generated by a faithful local
component and the prescribed Sylow, without any Baumann bound. -/
theorem exists_faithful_component_of_nonsolvable
    (hH : H ∈ Chapter3.HStar (T : Subgroup G) (normalizer (L : Set G)))
    (hZ : ¬ H ≤ centralizer (omegaOneCenterAmbient (T : Subgroup G) : Set G))
    (hs : ¬ Group.IsSolvable H) :
    ∃ K : Subgroup G, K ∈ MainForward.faithfulLocalComponents T ∧
      K ⊔ (T : Subgroup G) = H ∧
      componentOrbit K (T : Subgroup G) = (pResidual 2 H).map H.subtype := by
  let S := T.subtype hH.1.1.2
  obtain ⟨B,hB,_,hgen,_⟩ := ChapterE.Structure.source_original_component
    (Chapter3.sqtk_of_mem_H d.hypothesis.qtke hH.1.1.1) S
    (nonsolvable_minimalParabolic d hH hs) hs
  let K := B.map H.subtype
  have hKH : K ≤ H := map_subtype_le _
  have hgenG : K ⊔ (T : Subgroup G) = H := by
    have hh := congrArg (map H.subtype) hgen
    rw [Subgroup.map_sup, ← MonoidHom.range_eq_map, range_subtype] at hh
    change K ⊔ ((T : Subgroup G).subgroupOf H).map H.subtype = H at hh
    rwa [map_subgroupOf_eq_of_le hH.1.1.2] at hh
  have hlocal : K ∈ Chapter1.L G (T : Subgroup G) := by
    refine ⟨?_, ⟨T.subtype le_sup_right, by
      simp only [Sylow.coe_subtype, map_subgroupOf_eq_of_le le_sup_right]⟩, ?_⟩
    · rw [hgenG]
      have he : K.subgroupOf H = B := comap_map_eq_self (by rw [H.ker_subtype]; exact bot_le)
      rwa [he]
    · rw [hgenG]
      exact hH.1.1.1
  let O := componentOrbit K (T : Subgroup G)
  let : Group.IsPerfect K := Chapter1.mem_L_isPerfect hlocal
  let : Group.IsPerfect O := isPerfect_iSup_conjugates K (T : Subgroup G)
  have hOT : O ⊔ (T : Subgroup G) = H := le_antisymm
    (sup_le ((componentOrbit_le_sup K (T : Subgroup G)).trans hgenG.le) hH.1.1.2)
    (hgenG.ge.trans (sup_le_sup_right (le_componentOrbit K (T : Subgroup G)) _))
  have hO : O = (pResidual 2 H).map H.subtype := by
    have hh := ChapterC.Section05.CounterexampleCharacteristic.normal_extension_residual
      O (T : Subgroup G) (by
        intro N hN hQ
        let := hN
        let := hQ.isNilpotent
        exact top_unique (le_of_isPerfect_of_solvable_quotient ⊤ N))
      T.isPGroup' (le_normalizer_componentOrbit K (T : Subgroup G))
    rw [hOT] at hh
    exact hh.symm
  have hfaith := source_residual_faithful d hH hZ
  have hmodule : ChapterA.Section04.intrinsicSignalizerModule O ≠ ⊥ := by
    rw [hO]
    exact hfaith.2
  refine ⟨K, ?_, hgenG, hO⟩
  exact (Chapter1.Section02.Adequate.mem_faithfulLocalComponents_iff_module T
    (d.hypothesis.qtke.evenCharacteristic T)).mpr
    ⟨hlocal,Chapter1.Terminal.intrinsicModule_ne_bot_of_orbit hlocal hmodule⟩

/-- Earlier normalization identifies the actual residual with a faithful
A5 component; its literal two-core quotient is retained. -/
theorem nonsolvable_residual_faithful_A5
    (hn : ∀ K ∈ MainForward.faithfulLocalComponents T,
      (T : Subgroup G) ≤ normalizer (K : Set G))
    (hH : H ∈ Chapter3.HStar (T : Subgroup G) (normalizer (L : Set G)))
    (hZ : ¬ H ≤ centralizer (omegaOneCenterAmbient (T : Subgroup G) : Set G))
    (hs : ¬ Group.IsSolvable H) :
    (pResidual 2 H).map H.subtype ∈ MainForward.faithfulLocalComponents T ∧
      Nonempty ((pResidual 2 H ⧸ pCore 2 (pResidual 2 H)) ≃*
        alternatingGroup (Fin 5)) := by
  obtain ⟨K,hK,_,horbit⟩ := exists_faithful_component_of_nonsolvable d hH hZ hs
  have he : componentOrbit K (T : Subgroup G) = K :=
    le_antisymm (iSup_conjugates_le_of_le_normalizer K _ K le_rfl (hn K hK))
      (le_componentOrbit K _)
  have hR : K = (pResidual 2 H).map H.subtype := he.symm.trans horbit
  rw [hR] at hK
  refine ⟨hK, ?_⟩
  obtain ⟨e⟩ := d.uniform_A5 _ hK
  let f := (pResidual 2 H).equivMapOfInjective H.subtype H.subtype_injective
  exact ⟨(QuotientGroup.congr _ _ f (pCore_map_iso 2 f)).trans e⟩

/-- The faithful residual is maximal in the original local-component family. -/
theorem nonsolvable_residual_mem_LStar
    (hn : ∀ K ∈ MainForward.faithfulLocalComponents T,
      (T : Subgroup G) ≤ normalizer (K : Set G))
    (hH : H ∈ Chapter3.HStar (T : Subgroup G) (normalizer (L : Set G)))
    (hZ : ¬ H ≤ centralizer (omegaOneCenterAmbient (T : Subgroup G) : Set G))
    (hs : ¬ Group.IsSolvable H) :
    (pResidual 2 H).map H.subtype ∈ Chapter1.LStar G (T : Subgroup G) := by
  have hR := (nonsolvable_residual_faithful_A5 d hn hH hZ hs).1
  have hr := (Chapter1.Section02.Adequate.mem_faithfulLocalComponents_iff T _).mp hR
  refine ⟨hr.1, ?_⟩
  intro K hK hRK
  have hTK := Chapter1.Section02.Adequate.local_chain_normalizes hr.1 hK hRK (hn _ hR)
  have hN : (T : Subgroup G) ⊓ normalizer
      (((pResidual 2 H).map H.subtype) : Set G) =
      (T : Subgroup G) ⊓ normalizer (K : Set G) := by
    rw [inf_of_le_left (hn _ hR),inf_of_le_left hTK]
  have hf := (Chapter1.Section02.Adequate.faithful_chain_of_A410_of_normalizer_eq T
    (d.hypothesis.qtke.evenCharacteristic T)
    ChapterA.Section04.SourceChains.adequate_source hR hK hRK hN).2
  obtain ⟨e⟩ := d.uniform_A5 K hf
  exact (Section01.LocalModelRigidity.local_eq_of_solvableSylowOvergroups hK hr.1 hRK
    (SolvableSylowOvergroups.of_equiv e (fun _ P _ hP =>
      alternatingGroup.isSolvable_subgroup_five_of_ne_top P hP))).symm

/-- In the nonsolvable branch the core of the unique maximal overgroup is
already O₂(H): its quotient image is the center of the A5 residual image. -/
theorem nonsolvable_core_eq_twoCore
    (hn : ∀ K ∈ MainForward.faithfulLocalComponents T,
      (T : Subgroup G) ≤ normalizer (K : Set G))
    (hH : H ∈ Chapter3.HStar (T : Subgroup G) (normalizer (L : Set G)))
    (hZ : ¬ H ≤ centralizer (omegaOneCenterAmbient (T : Subgroup G) : Set G))
    (hs : ¬ Group.IsSolvable H)
    (hp : ChapterB.IsMinimalParabolicOver (T.subtype hH.1.1.2) ⊤) :
    ChapterB.minimalParabolicCore (T.subtype hH.1.1.2) hp = pCore 2 H := by
  obtain ⟨hR,⟨eR⟩⟩ := nonsolvable_residual_faithful_A5 d hn hH hZ hs
  let S := T.subtype hH.1.1.2
  let R := pResidual 2 H
  let q := QuotientGroup.mk' (pCore 2 H)
  let D := R.map q
  have hgen : R.map H.subtype ⊔ (T : Subgroup G) = H := by
    have hh := congrArg (map H.subtype) (pResidual_sup_sylow_eq_top S)
    rw [Subgroup.map_sup, ← MonoidHom.range_eq_map, range_subtype] at hh
    change R.map H.subtype ⊔ ((T : Subgroup G).subgroupOf H).map H.subtype = H at hh
    rwa [map_subgroupOf_eq_of_le hH.1.1.2] at hh
  have hRc : R.IsCComponent := by
    have hh := ((Chapter1.Section02.Adequate.mem_faithfulLocalComponents_iff T _).mp hR).1.1
    rw [hgen] at hh
    have he : (R.map H.subtype).subgroupOf H = R :=
      comap_map_eq_self (by rw [H.ker_subtype]; exact bot_le)
    rwa [he] at hh
  let eD : D ≃* alternatingGroup (Fin 5) := (cComponentTwoCoreQuotientEquiv hRc).symm.trans eR
  let : IsSimpleGroup D := eD.isSimpleGroup
  let : Group.IsPerfect D := Group.IsPerfect.ofSurjective
    (f := eD.symm.toMonoidHom) eD.symm.surjective
  have hcenter : center D = ⊥ := by
    rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal (center D) inferInstance with hh | hh
    · exact hh
    · exact (Group.IsPerfect.not_isMulCommutative D (center_eq_top_iff.mp hh)).elim
  let : IsQuasisimple (R ⧸ pCore 2 R) := IsQuasisimple.of_mulEquiv eR.symm
  have hm := (ChapterE.Structure.source_original_normal_clauses S hp hs R hRc
    inferInstance (pResidual_sup_sylow_eq_top S)).2
  change (ChapterB.minimalParabolicCore S hp).map q = (center D).map D.subtype at hm
  rw [hcenter,Subgroup.map_bot] at hm
  apply le_antisymm ?_ (ChapterB.minimalParabolicTwoCore_le_core S hp)
  have hh := map_le_iff_le_comap.mp hm.le
  change ChapterB.minimalParabolicCore S hp ≤ q.ker at hh
  rwa [QuotientGroup.ker_mk'] at hh

/-- The literal omega-action kernel in the nonsolvable branch, independently
of the Baumann normalizer bound and of the solvable 13.2.9 calculation. -/
theorem nonsolvable_omega_centralizer_eq_twoCore
    (hn : ∀ K ∈ MainForward.faithfulLocalComponents T,
      (T : Subgroup G) ≤ normalizer (K : Set G))
    (hH : H ∈ Chapter3.HStar (T : Subgroup G) (normalizer (L : Set G)))
    (hZ : ¬ H ≤ centralizer (omegaOneCenterAmbient (T : Subgroup G) : Set G))
    (hs : ¬ Group.IsSolvable H) :
    centralizer ((omegaOrbit T H).subgroupOf H : Set H) = pCore 2 H := by
  let U := (omegaOrbit T H).subgroupOf H
  let hU := omegaOrbit_reduced d.hypothesis.qtke T hH
  let := hU.normal
  let C := centralizer (U : Set H)
  let q := QuotientGroup.mk' C
  have hp := nonsolvable_minimalParabolic d hH hs
  have hne : q.ker ≠ ⊤ := by
    rw [QuotientGroup.ker_mk']
    intro he
    apply hZ
    intro x hx z hz
    have hzH : z ∈ H := hH.1.1.2 ((mem_omegaOneCenterAmbient_iff _ _).mp hz).1
    have hxC : (⟨x,hx⟩ : H) ∈ C := he.symm ▸ mem_top _
    exact congrArg H.subtype (hxC ⟨z,hzH⟩ (le_conjugateSpanBy _ _ hz))
  have hk := (ChapterB.minimalParabolic_reduced_image (T.subtype hH.1.1.2) hp
    q (QuotientGroup.mk'_surjective C) hU.quotient_pCore_eq_bot hne).1
  rw [QuotientGroup.ker_mk', nonsolvable_core_eq_twoCore d hn hH hZ hs hp] at hk
  exact le_antisymm hk (le_centralizer_iff.mp hU.le_centralizer_pCore)

end CFSG.Quasithin.Chapter13.Section02.A5Outside.OriginalCentralization
