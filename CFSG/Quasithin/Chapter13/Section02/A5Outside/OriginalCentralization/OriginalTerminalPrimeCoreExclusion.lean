module
public import CFSG.Quasithin.Chapter13.Section02.A5Outside.OriginalCentralization.OriginalTerminalRightCenter
public import CFSG.Quasithin.Chapter6.SourceReduction.RankOneModuleGenericExceptionalCartanGlobalPrimeLocal

/-!
# The terminal central line excludes a zero-core prime pair

In the original terminal branch H centralizes V₁. The left Cartan also
centralizes V₁, since its full local Borel is the original point centralizer.
The source Sylow intersection contains V₁. Consequently every source prime
pair generated by D, S and R has V₁ as a nontrivial central normal two-subgroup.

This contradicts the genuine prime-pair zero-core conclusion directly. It
requires no marking on the right residual and no amalgam classification.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter13.Section02.A5Outside.OriginalCentralization
open Section05.A5Source Chapter6.Source.RankOneGeneric
variable {G : Type*} [Group G] [Finite G]
  {T : Sylow 2 G} {L V V₁ V₂ V₃ H A B D R : Subgroup G}

/-- The original terminal line forces a nontrivial core in every literal
prime pair constructed from a subgroup of its compatible left Cartan. -/
theorem original_terminal_prime_core_ne_bot
    (d : Context T L V V₁ V₂ V₃)
    (hH : H ∈ Chapter3.HStar (T : Subgroup G) (normalizer (L : Set G)))
    (hHC : H ≤ centralizer (V₁ : Set G))
    (c : CartanPair T L H A B)
    (s : Prime.LocalData T L H B D R) (hDA : D ≤ A) :
    (Prime.generated L H D R).pCoreIn 2 ≠ ⊥ := by
  let N := Prime.generated L H D R
  have hline : V₁ ≤ V := d.flag.one_le_two.trans d.flag.two_le_V
  have hVT : V₁ ≤ (T : Subgroup G) := hline.trans d.chosen.le_sylow
  have hVL : V₁ ≤ L := hline.trans (d.chosen.le_componentCore.trans (pCoreIn_le 2 L))
  have hVS : V₁ ≤ Global.sourceS L H :=
    (le_inf hVT hVL).trans (s.S_intersection_left.symm.le.trans inf_le_left)
  have hTC : (T : Subgroup G) ≤ centralizer (V₁ : Set G) :=
    d.flag.one_invariant.trans (normalizer_le_centralizer_of_card_two _ d.flag.one_card)
  have hBC : localBorel T L ≤ centralizer (V₁ : Set G) := by
    change ChapterF.Source.borel L (T : Subgroup G) ≤ _
    rw [d.borel_eq_point_centralizer]
    exact inf_le_right
  have hNC : N ≤ centralizer (V₁ : Set G) := by
    exact sup_le (hDA.trans (c.left_le.trans hBC))
      (sup_le (s.right_le_residual.trans ((map_subtype_le _).trans hHC))
        ((Global.sourceS_le_sylow d.normalizes_L hH.1.1.2).trans hTC))
  have hVN : V₁ ≤ N := hVS.trans (le_sup_right.trans le_sup_right)
  have hVcore : V₁ ≤ N.pCoreIn 2 :=
    le_pCoreIn_of_normalizes (T.isPGroup'.to_le hVT) hVN
      (hNC.trans (Subgroup.centralizer_le_normalizer _))
  intro he
  have hv : V₁ = ⊥ := bot_unique (hVcore.trans_eq he)
  have hc := d.flag.one_card
  rw [hv] at hc
  norm_num at hc

end CFSG.Quasithin.Chapter13.Section02.A5Outside.OriginalCentralization
