module
public import CFSG.Quasithin.Chapter13.Section02.A5Outside.OriginalCentralization.NonsolvableCenters
public import CFSG.Quasithin.ChapterC.Section01.BlockStructure.RelativeCoreAction
public import CFSG.Quasithin.ChapterC.Section01.BlockCoreCentralConjugation

/-!
# Two original blocks cannot have commuting natural modules

The original chosen module is nonzero, generated by its component
commutators and contained in its component core. Short-group
irreducibility therefore identifies it with the actual block U-layer.

If both original components are blocks and their natural modules commute,
each module lies in the opposite local core. Relative block displacement
then puts both component actions on their joined module inside that join.
Both local groups normalize this nontrivial subgroup of T, contradicting
the original unique maximal two-local overgroup. This uses the separate
relative block placements, without assuming that the blocks commute or
are subnormal in their join.

SourceAssembly/NonsolvableTwoBlocks applies the resulting noncommutation
to obtain the actual residual four-group lift and the original 5.2.3
conclusion. Source: Aschbacher--Smith C.1.7--11, pp.123--124;
1.2.7, pp.506--507; and 13.2.8(1), p.880.
-/

public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter13.Section05.A5Source.Context
open ChapterC
variable {G : Type*} [Group G] [Finite G]
  {T : Sylow 2 G} {L V V₁ V₂ V₃ : Subgroup G}
  (d : Context T L V V₁ V₂ V₃)
include d
theorem blockU_eq_module_of_short (hs : IsShort L) :
    (blockU L).map L.subtype = V := by
  have hVU : V ≤ (blockU L).map L.subtype := by
    rw [blockU,map_commutator,←MonoidHom.range_eq_map,range_subtype]
    exact d.chosen.eq_commutator.le.trans
      (commutator_mono d.chosen.le_componentCore le_rfl)
  let A := V.subgroupOf L
  let : A.Normal := normal_subgroupOf_of_le_normalizer d.chosen.normalizes
  have hAU : A ≤ blockU L := by
    intro x hx
    obtain ⟨y,hy,he⟩ := hVU hx
    exact (show y=x from Subtype.ext he) ▸ hy
  rcases hs.normal_core_dichotomy A hAU with hc | hu
  · have hz : V ≤ centralizer (L : Set G) := by
      intro v hv l hl
      exact congrArg L.subtype (mem_center_iff.mp (hc (show (⟨v,d.chosen.le_component hv⟩ : L) ∈ A from hv)) ⟨l,hl⟩)
    exact (d.chosen.ne_bot (bot_unique (fun x hx =>
      d.flag.module.fixed_eq_bot.le ⟨hx,hz hx⟩))).elim
  · exact le_antisymm ((map_mono hu).trans_eq
      (map_subgroupOf_eq_of_le d.chosen.le_component)) hVU

private theorem local_blockU_eq_module
    (hb : IsBlock (L.subgroupOf (L ⊔ (T : Subgroup G)))) :
    (blockU L).map L.subtype = V :=
  d.blockU_eq_module_of_short (RankOne.Solvable.isShort_of_equiv
    (subgroupOfEquivOfLe (show L ≤ L ⊔ (T : Subgroup G) from le_sup_left)) hb.short)
end CFSG.Quasithin.Chapter13.Section05.A5Source.Context

namespace CFSG.Quasithin.Chapter13.Section02.A5Outside.OriginalCentralization
open Section05.A5Source ChapterC
variable {G : Type*} [Group G] [Finite G]
  {T : Sylow 2 G} {L V V₁ V₂ V₃ H K W W₁ W₂ W₃ : Subgroup G}

omit [Finite G] in
private theorem normalizes_join_of_displacement (A B C : Subgroup G)
    (ha : ⁅A,C⁆ ≤ A ⊔ B) (hb : ⁅B,C⁆ ≤ A ⊔ B) :
    C ≤ normalizer ((A ⊔ B : Subgroup G) : Set G) := by
  apply le_normalizer_iff_commutator_le_left.mpr
  have h : A ⊔ B ≤ commutatorPreimage (A ⊔ B) C (A ⊔ B) :=
    sup_le (le_commutatorPreimage le_sup_left ha) (le_commutatorPreimage le_sup_right hb)
  exact (commutator_mono h le_rfl).trans
    (commutator_commutatorPreimage_le _ _ _ (A ⊔ B).le_normalizer)

theorem original_block_pair_noncommuting
    (d : Context T L V V₁ V₂ V₃) (e : Context T K W W₁ W₂ W₃)
    (hjoin : K ⊔ (T : Subgroup G) = H)
    (hH : H ∈ Chapter3.HStar (T : Subgroup G) (normalizer (L : Set G)))
    (hbL : IsBlock (L.subgroupOf (L ⊔ (T : Subgroup G))))
    (hbK : IsBlock (K.subgroupOf H)) :
    ¬ V ≤ centralizer (W : Set G) := by
  intro hVW
  have hVL := d.local_blockU_eq_module hbL
  have hWK := e.blockU_eq_module_of_short (RankOne.Solvable.isShort_of_equiv
    (subgroupOfEquivOfLe (le_sup_left.trans hjoin.le)) hbK.short)
  let Q := (L ⊔ (T : Subgroup G)).pCoreIn 2
  let P := H.pCoreIn 2
  have hVP : V ≤ P := by
    change V ≤ H.pCoreIn 2
    rw [←hjoin,←e.sylow_centralizer e.normalizes_L]
    exact le_inf d.chosen.le_sylow hVW
  have hWQ : W ≤ Q := by
    rw [show Q = (T : Subgroup G) ⊓ centralizer (V : Set G) from
      (d.sylow_centralizer d.normalizes_L).symm]
    exact le_inf e.chosen.le_sylow (le_centralizer_iff.mp hVW)
  have hWL : ⁅W,L⁆ ≤ V := by
    rw [←hVL]
    exact (commutator_mono hWQ le_rfl).trans
      (relative_core_commutator_le_blockU le_sup_left hbL)
  have hVK : ⁅V,K⁆ ≤ W := by
    rw [←hWK]
    exact (commutator_mono hVP le_rfl).trans
      (relative_core_commutator_le_blockU (le_sup_left.trans hjoin.le) hbK)
  have hLN : L ≤ normalizer ((V ⊔ W : Subgroup G) : Set G) :=
    normalizes_join_of_displacement V W L
      ((le_normalizer_iff_commutator_le_left.mp d.chosen.normalizes).trans le_sup_left)
      (hWL.trans le_sup_left)
  have hKN : K ≤ normalizer ((V ⊔ W : Subgroup G) : Set G) :=
    normalizes_join_of_displacement V W K (hVK.trans le_sup_right)
      ((le_normalizer_iff_commutator_le_left.mp e.chosen.normalizes).trans le_sup_right)
  have hTN : (T : Subgroup G) ≤ normalizer ((V ⊔ W : Subgroup G) : Set G) :=
    (le_inf d.flag.T_normalizes e.flag.T_normalizes).trans
      (normalizer_inf_normalizer_le_normalizer_sup V W)
  have hN := normalizer_le_of_unique_maximalTwoLocal d.unique_maximal_overgroup
    (T.isPGroup'.to_le (sup_le d.chosen.le_sylow e.chosen.le_sylow))
    (show V ⊔ W ≠ ⊥ from fun hh => d.chosen.ne_bot
      (bot_unique (le_sup_left.trans hh.le))) (sup_le hLN hTN)
  exact hH.1.2 ((hjoin.ge.trans (sup_le hKN hTN)).trans hN)
end CFSG.Quasithin.Chapter13.Section02.A5Outside.OriginalCentralization
