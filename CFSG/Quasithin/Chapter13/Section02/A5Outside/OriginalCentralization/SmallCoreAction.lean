module

public import CFSG.Quasithin.Chapter13.Section02.A5Outside.OriginalCentralization.NonsolvableCores
public import Theory.GroupTheory.SimpleFiveSmallSectionAction

/-!
# The actual residual action on a small original A₅ core

The original natural sixteen is normal in LT and contained in its two-core.
If that core has order at most 128, the quotient by the sixteen has order
dividing eight. The original two-perfect A₅ component is generated by its
five-elements, so acts trivially on this literal quotient. Its commutator
with the whole local core is consequently exactly the original chosen V.

Source application: Aschbacher--Smith 13.2.8(1), printed p.880.
-/

public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter13.Section05.A5Source.Context
variable {G : Type*} [Group G] [Finite G]
  {T : Sylow 2 G} {L V V₁ V₂ V₃ : Subgroup G}

theorem core_commutator_eq_module_of_card_le_oneTwentyEight
    (d : Context T L V V₁ V₂ V₃)
    (hsmall : Nat.card (pCore 2 (L ⊔ (T : Subgroup G) : Subgroup G)) ≤ 128) :
    ⁅(L ⊔ (T : Subgroup G)).pCoreIn 2,L⁆ = V := by
  let H := L ⊔ (T : Subgroup G)
  let U := V.subgroupOf H
  let Q := pCore 2 H
  have hVH : V ≤ H := d.chosen.le_sylow.trans le_sup_right
  let : U.Normal := normal_subgroupOf_of_le_normalizer
    (sup_le d.chosen.normalizes d.flag.T_normalizes)
  let q := QuotientGroup.mk' U
  have hUQ : U ≤ Q := by
    intro v hv
    obtain ⟨x,hx,he⟩ := d.chosen.le_core hv
    exact (show x=v from Subtype.ext he) ▸ hx
  have hcardU : Nat.card U = 16 :=
    (Nat.card_congr (subgroupOfEquivOfLe hVH).toEquiv).trans d.module_card
  have hcard : Nat.card (Q.map q) ≤ 8 := by
    have hh := IsElementaryAbelian.card_inf_ker_mul_card_map Q q
    rw [QuotientGroup.ker_mk', inf_of_le_right hUQ, hcardU] at hh
    change Nat.card Q ≤ 128 at hsmall
    omega
  have hdiv : Nat.card (Q.map q) ∣ 8 := by
    obtain ⟨n,hn⟩ := (pCore_isPGroup (p := 2) (G := H)).map q |>.exists_card_eq
    have hn3 : n ≤ 3 := (Nat.pow_le_pow_iff_right (by decide : 1 < 2)).mp (by
      simpa only [← hn] using hcard)
    rw [hn]
    exact pow_dvd_pow 2 hn3
  let : IsSimpleGroup (L ⧸ pCore 2 L) := d.quotient.isSimpleGroup
  have hfive : 5 ∣ Nat.card (L ⧸ pCore 2 L) := by
    rw [Nat.card_congr d.quotient.toEquiv, nat_card_alternatingGroup]
    norm_num [Nat.factorial]
  let f : L →* H := inclusion le_sup_left
  have hf : f.range = L.subgroupOf H := by
    ext x
    constructor
    · rintro ⟨y, rfl⟩
      exact y.property
    · intro hx
      exact ⟨⟨x.val, hx⟩, Subtype.ext rfl⟩
  have hcomm := commutator_le_of_simple_five_small_section d.twoPerfect hfive f Q U hdiv
  have hm := map_mono (f := H.subtype) hcomm
  rw [map_commutator, hf, map_subgroupOf_eq_of_le hVH,
    map_subgroupOf_eq_of_le (show L ≤ H from le_sup_left)] at hm
  apply le_antisymm hm
  rw [d.chosen.eq_commutator]
  exact commutator_mono d.chosen.le_core le_rfl

end CFSG.Quasithin.Chapter13.Section05.A5Source.Context
