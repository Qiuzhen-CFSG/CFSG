module

public import CFSG.Quasithin.Chapter13.Section08.ComponentSieve.SixAndG2.NaturalSix.Marked.ChiefFactors
public import Theory.GroupAction.NoncentralTwoChiefLength.Native
import Mathlib.Tactic

/-!
# The common cubic marking for the final filtration comparison

The actor is the cyclic subgroup generated by the actual pair cycle in
the syntheme residual. On the duad side its image is taken under the
constructed pentad outer automorphism. In particular, the two restrictions
of the natural module must retain this marking.

These definitions are shared by the module and two-core fixed-index
calculations for Aschbacher–Smith 13.8.33, printed p.968.
-/

@[expose] public section

open Subgroup
open Theory.SpecificGroups.SymmetricSix.BinaryFlags
open CFSG.Quasithin.Chapter13.Section08.ComponentSieve.SixAndG2.NaturalSix

namespace CFSG.Quasithin.Chapter13.Section08.A6Endgame.ActionAnalysis33.ChiefModels

/-- The common cubic actor in the marked syntheme residual. -/
def cubicActor : Subgroup Symmetric := zpowers Marked.pairCycle

/-- Its literal outer image, acting on the duad parabolic. -/
noncomputable def duadCubicActor : Subgroup Symmetric :=
  cubicActor.map Marked.outer.toMonoidHom

/-- The actual actor isomorphism, rather than an identification of the two
natural representations with their markings fixed. -/
noncomputable def cubicActorEquiv : cubicActor ≃* duadCubicActor :=
  cubicActor.equivMapOfInjective Marked.outer.toMonoidHom Marked.outer.injective

@[simp] theorem cubicActorEquiv_coe (a : cubicActor) :
    (cubicActorEquiv a : Symmetric) = Marked.outer a := rfl

theorem cubicActor_le_residual : cubicActor ≤ Marked.residual :=
  zpowers_le.mpr Marked.pairCycle_mem_residual

theorem cubicActor_le_H2 : cubicActor ≤ H2 :=
  cubicActor_le_residual.trans Marked.residual_le_H2

theorem duadCubicActor_le_K : duadCubicActor ≤ K := by
  rw [← Marked.outer_residual]
  exact map_mono cubicActor_le_residual

theorem cubicActor_card : Nat.card cubicActor = 3 := by
  let _ : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  rw [cubicActor, Nat.card_zpowers]
  exact orderOf_eq_prime (by decide : Marked.pairCycle ^ 3 = 1)
    (by decide : Marked.pairCycle ≠ 1)

theorem cubicActor_isPGroup : IsPGroup 3 cubicActor := by
  apply isPGroup_iff_card_dvd_pow.mpr
  exact ⟨1, by rw [cubicActor_card]; simp⟩

theorem duadCubicActor_isPGroup : IsPGroup 3 duadCubicActor :=
  cubicActor_isPGroup.map Marked.outer.toMonoidHom

end CFSG.Quasithin.Chapter13.Section08.A6Endgame.ActionAnalysis33.ChiefModels
