module

public import CFSG.Quasithin.Chapter13.Section08.A6Endgame.ActionAnalysis33.ChiefFiltrations.ModelDefs
public import Theory.GroupAction.NoncentralTwoChiefLength.BinaryRepresentation
import Mathlib.Tactic

/-!
# Cubic fixed indices for the two marked natural modules

The actor is the actual cyclic subgroup generated by `(0 2 4)(1 3 5)`.
Its standard action fixes two augmentation vectors. Under the chosen pentad
outer automorphism its generator becomes `(0 1 3)`, which fixes eight
augmentation vectors. Since the augmentation module has 32 elements, the
fixed indices are 16 and 4. The constant-line kernel is fixed pointwise,
so the same indices hold on the four-dimensional natural quotients.
Contragredient duality preserves these cyclic fixed indices.

Every action below is on the literal multiplicative additive group of the
specified binary representation. The action formulas retain the outer
marking and the inverse in the dual action. The general transport statements
in `Representation.BinaryFixedPoints` accept actual equivariant module
identifications and surjective actor maps; they do not assume source local
modules have already been identified.

Source: Aschbacher–Smith 13.8.33, printed p.968 (PDF p.985). The use of
13.7.4(2) in the source concerns the dual of `UH/C_UH(QH)`; no identification
of that denominator with `V1` is made here. The source filtration assembly
and its local module identifications remain with the parent theorem.
-/

@[expose] public section

open Subgroup BinaryPermutation
open CFSG.Quasithin.Chapter13.Section08.ComponentSieve.SixAndG2.NaturalSix
open Representation.BinaryFixedPoints
namespace CFSG.Quasithin.Chapter13.Section08.A6Endgame.ActionAnalysis33.ChiefModels

/-- The distinguished generator of the common cubic actor. -/
def cubicGenerator : cubicActor := ⟨Marked.pairCycle, mem_zpowers _⟩

theorem cubicGenerator_generates (a : cubicActor) : a ∈ zpowers cubicGenerator := by
  obtain ⟨n, hn⟩ := a.property
  exact ⟨n, Subtype.ext hn⟩

theorem cubicGenerator_cube : cubicGenerator ^ 3 = 1 := by
  apply Subtype.ext
  change Marked.pairCycle ^ 3 = 1
  decide

/-- Restriction of the standard four-dimensional action with its marking. -/
abbrev standardNatural : Representation (ZMod 2) cubicActor Natural :=
  symmetricAction.comp cubicActor.subtype

/-- Restriction of the actual outer-twisted four-dimensional action. -/
noncomputable def oppositeNatural : Representation (ZMod 2) cubicActor Natural :=
  Marked.oppositeAction.comp cubicActor.subtype

/-- The actual five-dimensional augmentation cover. -/
abbrev standardAugmentation : Representation (ZMod 2) cubicActor Augmentation :=
  (coreRepresentation (Fin 6)).comp cubicActor.subtype

/-- Its cover with the same outer twist as the natural quotient. -/
noncomputable def oppositeAugmentation : Representation (ZMod 2) cubicActor Augmentation :=
  (coreRepresentation (Fin 6)).comp (Marked.outer.toMonoidHom.comp cubicActor.subtype)

/-- The opposite action is literally the standard action of the outer image,
with the published actor isomorphism retained. -/
theorem oppositeNatural_eq_comp_cubicActorEquiv : oppositeNatural =
    (symmetricAction.comp duadCubicActor.subtype).comp cubicActorEquiv.toMonoidHom := rfl

theorem oppositeAugmentation_eq_comp_cubicActorEquiv : oppositeAugmentation =
    ((coreRepresentation (Fin 6)).comp duadCubicActor.subtype).comp
      cubicActorEquiv.toMonoidHom := rfl

abbrev standardNaturalDual := standardNatural.dual
noncomputable abbrev oppositeNaturalDual := oppositeNatural.dual
abbrev standardAugmentationDual := standardAugmentation.dual
noncomputable abbrev oppositeAugmentationDual := oppositeAugmentation.dual

abbrev standardNaturalAction := action standardNatural
abbrev standardNaturalDualAction := action standardNaturalDual
noncomputable abbrev oppositeNaturalAction := action oppositeNatural
noncomputable abbrev oppositeNaturalDualAction := action oppositeNaturalDual
abbrev standardAugmentationAction := action standardAugmentation
abbrev standardAugmentationDualAction := action standardAugmentationDual
noncomputable abbrev oppositeAugmentationAction := action oppositeAugmentation
noncomputable abbrev oppositeAugmentationDualAction := action oppositeAugmentationDual

theorem standardNatural_smul (a : cubicActor) (v : Natural) :
    letI := standardNaturalAction
    (a • Multiplicative.ofAdd v).toAdd = symmetricAction a.val v := rfl

theorem standardNaturalDual_smul (a : cubicActor) (f : Module.Dual (ZMod 2) Natural)
    (v : Natural) :
    letI := standardNaturalDualAction
    (a • Multiplicative.ofAdd f).toAdd v = f (symmetricAction a.val⁻¹ v) := rfl

theorem oppositeNatural_smul (a : cubicActor) (v : Natural) :
    letI := oppositeNaturalAction
    (a • Multiplicative.ofAdd v).toAdd = symmetricAction (Marked.outer a.val) v := rfl

theorem oppositeNaturalDual_smul (a : cubicActor) (f : Module.Dual (ZMod 2) Natural)
    (v : Natural) :
    letI := oppositeNaturalDualAction
    (a • Multiplicative.ofAdd f).toAdd v = f (symmetricAction (Marked.outer a.val⁻¹) v) := rfl

theorem standardAugmentation_smul (a : cubicActor) (v : Augmentation) :
    letI := standardAugmentationAction
    (a • Multiplicative.ofAdd v).toAdd = coreRepresentation (Fin 6) a.val v := rfl

theorem standardAugmentationDual_smul (a : cubicActor) (f : Module.Dual (ZMod 2) Augmentation)
    (v : Augmentation) :
    letI := standardAugmentationDualAction
    (a • Multiplicative.ofAdd f).toAdd v = f (coreRepresentation (Fin 6) a.val⁻¹ v) := rfl

theorem oppositeAugmentation_smul (a : cubicActor) (v : Augmentation) :
    letI := oppositeAugmentationAction
    (a • Multiplicative.ofAdd v).toAdd = coreRepresentation (Fin 6) (Marked.outer a.val) v := rfl

theorem oppositeAugmentationDual_smul (a : cubicActor) (f : Module.Dual (ZMod 2) Augmentation)
    (v : Augmentation) :
    letI := oppositeAugmentationDualAction
    (a • Multiplicative.ofAdd f).toAdd v = f (coreRepresentation (Fin 6) (Marked.outer a.val⁻¹) v) := rfl

/-- The marked double three-cycle becomes the literal cycle `(0 1 3)`. -/
theorem outer_pairCycle : Marked.outer Marked.pairCycle =
    Equiv.swap 0 1 * Equiv.swap 1 3 := by
  have h : GLS3.Chapter5.outerHom Marked.pairCycle =
      Equiv.swap 0 1 * Equiv.swap 1 3 := by
    apply Equiv.ext
    intro i
    change GLS3.Chapter5.outerAct Marked.pairCycle i = _
    apply GLS3.Chapter5.pentadAt_injective
    rw [GLS3.Chapter5.outerAct_spec]
    fin_cases i <;> decide +kernel
  rw [Marked.outer_apply, h]
  decide

private def coreFixedEquiv (f : cubicActor →* Symmetric) :
    Representation.invariants ((coreRepresentation (Fin 6)).comp f) ≃
      {v : Full (Fin 6) // (∑ i, v i) = 0 ∧ ∀ i, v ((f cubicGenerator).symm i) = v i} where
  toFun v := ⟨v.val.val, v.val.property,
    fun i => congrFun (congrArg Subtype.val (v.property cubicGenerator)) i⟩
  invFun v := ⟨⟨v.val, v.property.1⟩,
    (Representation.mem_invariants_iff_of_forall_mem_zpowers _ cubicGenerator
      cubicGenerator_generates _).mpr (Subtype.ext (funext v.property.2))⟩
  left_inv _ := rfl
  right_inv _ := rfl

private theorem standardAugmentation_fixed_card : Nat.card standardAugmentation.invariants = 2 := by
  rw [Nat.card_congr (coreFixedEquiv cubicActor.subtype)]
  change Nat.card {v : Full (Fin 6) // (∑ i, v i) = 0 ∧
    ∀ i, v (Marked.pairCycle.symm i) = v i} = 2
  rw [Nat.card_eq_fintype_card]
  decide +kernel

private theorem oppositeAugmentation_fixed_card : Nat.card oppositeAugmentation.invariants = 8 := by
  unfold oppositeAugmentation
  rw [Nat.card_congr (coreFixedEquiv (Marked.outer.toMonoidHom.comp cubicActor.subtype))]
  change Nat.card {v : Full (Fin 6) // (∑ i, v i) = 0 ∧
    ∀ i, v ((Marked.outer Marked.pairCycle).symm i) = v i} = 8
  rw [outer_pairCycle, Nat.card_eq_fintype_card]
  decide +kernel

private theorem augmentation_card : Nat.card Augmentation = 32 := by
  rw [Module.natCard_eq_pow_finrank (K := ZMod 2), augmentation_finrank]
  norm_num

theorem standardAugmentation_fixedIndex : fixedIndex standardAugmentation = 16 := by
  have h := fixedIndex_mul_card standardAugmentation
  rw [standardAugmentation_fixed_card, augmentation_card] at h
  omega

theorem oppositeAugmentation_fixedIndex : fixedIndex oppositeAugmentation = 4 := by
  have h := fixedIndex_mul_card oppositeAugmentation
  rw [oppositeAugmentation_fixed_card, augmentation_card] at h
  omega

private theorem coreToNatural_kernel_fixed (g : Symmetric) (v : Augmentation)
    (hv : coreToNatural (Fin 6) v = 0) : coreRepresentation (Fin 6) g v = v := by
  have hc : v.val ∈ constants (Fin 6) := by
    apply (Submodule.Quotient.mk_eq_zero _).mp
    exact congrArg Subtype.val hv
  obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp hc
  apply Subtype.ext
  change representation (Fin 6) g v.val = v.val
  rw [← hc, map_smul, permute_allOne]

theorem standardNatural_fixedIndex : fixedIndex standardNatural = 16 := by
  rw [← fixedIndex_eq_of_surjective_trivial_kernel standardAugmentation standardNatural
    cubicGenerator cubicGenerator_generates cubicGenerator_cube (coreToNatural (Fin 6))
    coreToNatural_surjective
    (fun a v => coreToNatural_equivariant a.val v)
    (coreToNatural_kernel_fixed Marked.pairCycle)]
  exact standardAugmentation_fixedIndex

theorem oppositeNatural_fixedIndex : fixedIndex oppositeNatural = 4 := by
  rw [← fixedIndex_eq_of_surjective_trivial_kernel oppositeAugmentation oppositeNatural
    cubicGenerator cubicGenerator_generates cubicGenerator_cube (coreToNatural (Fin 6))
    coreToNatural_surjective
    (fun a v => coreToNatural_equivariant (Marked.outer a.val) v)
    (coreToNatural_kernel_fixed (Marked.outer Marked.pairCycle))]
  exact oppositeAugmentation_fixedIndex

/-- Fixed-point freeness on the standard natural module also follows directly
from the checked polynomial of the pair cycle. -/
theorem standardNatural_invariants_eq_bot : standardNatural.invariants = ⊥ := by
  ext v
  constructor
  · intro hv
    change v = 0
    have h := Marked.pairCycle_polynomial v
    have hf : symmetricAction Marked.pairCycle v = v := hv cubicGenerator
    rw [hf, hf] at h
    have htwo : v + v = 0 := by
      rw [← two_smul (ZMod 2), show (2 : ZMod 2) = 0 from rfl, zero_smul]
    simpa only [htwo, zero_add] using h
  · intro hv
    have hz : v = 0 := hv
    subst v
    exact standardNatural.invariants.zero_mem


theorem standardNaturalDual_fixedIndex : fixedIndex standardNaturalDual = 16 := by
  rw [fixedIndex_dual standardNatural cubicGenerator cubicGenerator_generates,
    standardNatural_fixedIndex]

theorem oppositeNaturalDual_fixedIndex : fixedIndex oppositeNaturalDual = 4 := by
  rw [fixedIndex_dual oppositeNatural cubicGenerator cubicGenerator_generates,
    oppositeNatural_fixedIndex]

theorem standardAugmentationDual_fixedIndex : fixedIndex standardAugmentationDual = 16 := by
  rw [fixedIndex_dual standardAugmentation cubicGenerator cubicGenerator_generates,
    standardAugmentation_fixedIndex]

theorem oppositeAugmentationDual_fixedIndex : fixedIndex oppositeAugmentationDual = 4 := by
  rw [fixedIndex_dual oppositeAugmentation cubicGenerator cubicGenerator_generates,
    oppositeAugmentation_fixedIndex]

theorem standardNatural_cubicLength :
    letI := standardNaturalAction
    FixedPoints.cubicLength cubicActor (Multiplicative Natural) = 2 := by
  change Nat.log 4 (fixedIndex standardNatural) = 2
  rw [standardNatural_fixedIndex]
  decide

theorem standardNaturalDual_cubicLength :
    letI := standardNaturalDualAction
    FixedPoints.cubicLength cubicActor (Multiplicative (Module.Dual (ZMod 2) Natural)) = 2 := by
  change Nat.log 4 (fixedIndex standardNaturalDual) = 2
  rw [standardNaturalDual_fixedIndex]
  decide

theorem oppositeNatural_cubicLength :
    letI := oppositeNaturalAction
    FixedPoints.cubicLength cubicActor (Multiplicative Natural) = 1 := by
  change Nat.log 4 (fixedIndex oppositeNatural) = 1
  rw [oppositeNatural_fixedIndex]
  decide

theorem oppositeNaturalDual_cubicLength :
    letI := oppositeNaturalDualAction
    FixedPoints.cubicLength cubicActor (Multiplicative (Module.Dual (ZMod 2) Natural)) = 1 := by
  change Nat.log 4 (fixedIndex oppositeNaturalDual) = 1
  rw [oppositeNaturalDual_fixedIndex]
  decide

theorem standardAugmentation_cubicLength :
    letI := standardAugmentationAction
    FixedPoints.cubicLength cubicActor (Multiplicative Augmentation) = 2 := by
  change Nat.log 4 (fixedIndex standardAugmentation) = 2
  rw [standardAugmentation_fixedIndex]
  decide

theorem standardAugmentationDual_cubicLength :
    letI := standardAugmentationDualAction
    FixedPoints.cubicLength cubicActor (Multiplicative (Module.Dual (ZMod 2) Augmentation)) = 2 := by
  change Nat.log 4 (fixedIndex standardAugmentationDual) = 2
  rw [standardAugmentationDual_fixedIndex]
  decide

theorem oppositeAugmentation_cubicLength :
    letI := oppositeAugmentationAction
    FixedPoints.cubicLength cubicActor (Multiplicative Augmentation) = 1 := by
  change Nat.log 4 (fixedIndex oppositeAugmentation) = 1
  rw [oppositeAugmentation_fixedIndex]
  decide

theorem oppositeAugmentationDual_cubicLength :
    letI := oppositeAugmentationDualAction
    FixedPoints.cubicLength cubicActor (Multiplicative (Module.Dual (ZMod 2) Augmentation)) = 1 := by
  change Nat.log 4 (fixedIndex oppositeAugmentationDual) = 1
  rw [oppositeAugmentationDual_fixedIndex]
  decide

end CFSG.Quasithin.Chapter13.Section08.A6Endgame.ActionAnalysis33.ChiefModels
