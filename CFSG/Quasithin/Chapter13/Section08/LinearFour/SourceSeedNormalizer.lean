/-- Cubic generation and the original Sylow subgroup determine the full seed normalizer. -/
theorem source_seed_normalizer_eq
    (s : NaturalSetup T L V V₁ V₂ V₃ M G₁)
    (h : Chapter12.Section02.Hypothesis1221 KnownSimple.IsKnownSimple T L)
    (hH : H ∈ Source.Hz (sourceOne L T V₁) T G₁ M)
    (hcentral : centralizer (V₃:Set G) ≤ M ⊓ normalizer (V:Set G))
    (ρ : Representation (ZMod 2) H (Fin 4 → ZMod 2))
    (d : BinaryConjugationSection H (Source.UH H V₃) V₁ ρ)
    (π : H →* SL(4,ZMod 2)) (hker : π.ker = (Source.QH H).subgroupOf H)
    (hnatural : ∀ h w, ρ h w = Matrix.mulVec (π h).val w) :
    H ⊓ normalizer (V₃:Set G) = sourceOne L T V₁ ⊔ (T:Subgroup G) := by
  let P := H ⊓ normalizer (V₃:Set G)
  let φ := (slEquivLinear 4).toMonoidHom.comp π
  have hk : IsPGroup 2 φ.ker := by
    dsimp only [φ]
    rw [MonoidHom.ker_comp_of_injective _ _ (slEquivLinear 4).injective,hker]
    exact (isPGroup_pCoreIn 2 H).comap_subtype
  have h13 : V₁ ≤ V₃ := s.line_le_plane.trans s.plane_le_seed
  have h3U : V₃ ≤ Source.UH H V₃ := le_conjugateSpanBy _ _
  have hi : V₁.relIndex V₃ = 4 := by
    have hh := (V₁.subgroupOf V₃).card_mul_index
    rw [Nat.card_congr (subgroupOfEquivOfLe h13).toEquiv,s.line_card,s.seed_card] at hh
    change 2 * V₁.relIndex V₃ = 8 at hh
    omega
  have hd : Module.finrank (ZMod 2) (d.imageSpace V₃) = 2 :=
    d.imageSpace_finrank_of_index V₃ h3U 2 (by simpa using hi)
  have hc := d.natural_plane_normalizer_cubic_closure φ hnatural hk V₃ h3U h13 hd
  have ht := Section07.ModelExclusions.seed_normalizer_theta_le s h hH hcentral
    (K:=H) le_rfl
  have hr : (pResidual 2 P).map P.subtype ≤ sourceOne L T V₁ := by
    rw [←hc,MonoidHom.map_closure]
    apply (closure_le _).mpr
    rintro _ ⟨x,hx,rfl⟩
    exact ht (subset_closure ⟨x.property,(P.orderOf_coe x).trans hx⟩)
  have hTP : (T:Subgroup G) ≤ P := le_inf (le_sup_right.trans hH.1.2) s.seed_stable
  have hs := congrArg (map P.subtype) (pResidual_sup_sylow_eq_top (T.subtype hTP))
  rw [Subgroup.map_sup,Sylow.coe_subtype,map_subgroupOf_eq_of_le hTP,
    ←MonoidHom.range_eq_map,range_subtype] at hs
  apply le_antisymm
  · change P ≤ _
    rw [←hs]
    exact sup_le_sup_right hr _
  · exact sup_le (le_inf (le_sup_left.trans hH.1.2)
      (Section07.ModelExclusions.point_residual_normalizes_seed s)) hTP

/-- The original source data supply the bound used by the critical edge-core calculation. -/
theorem source_seed_normalizer_le_LT
    (s : NaturalSetup T L V V₁ V₂ V₃ M G₁)
    (h : Chapter12.Section02.Hypothesis1221 KnownSimple.IsKnownSimple T L)
    (hH : H ∈ Source.Hz (sourceOne L T V₁) T G₁ M)
    (hcentral : centralizer (V₃:Set G) ≤ M ⊓ normalizer (V:Set G))
    (ρ : Representation (ZMod 2) H (Fin 4 → ZMod 2))
    (d : BinaryConjugationSection H (Source.UH H V₃) V₁ ρ)
    (π : H →* SL(4,ZMod 2)) (hker : π.ker = (Source.QH H).subgroupOf H)
    (hnatural : ∀ h w, ρ h w = Matrix.mulVec (π h).val w) :
    H ⊓ normalizer (V₃:Set G) ≤ L ⊔ (T:Subgroup G) := by
  rw [source_seed_normalizer_eq s h hH hcentral ρ d π hker hnatural]
  exact sup_le ((one_le L T V₁).trans inf_le_left) le_sup_right

open CriticalGeometry NoncentralChiefRefinement
open Atlas.Order20160A8.Bivectors (exteriorMap)

/-- Original theta and Sylow data remove the seed-normalizer premise from
all three critical-geometry conclusions, on the same critical pair. -/
theorem source_critical_pair_geometry_of_original_seed
    (F : ChapterF.Section09.Setup G) (hF : F.Hypothesis)
    (V₂ M G₁ : Subgroup G)
    (s : NaturalSetup F.T F.L F.V F.V₁ V₂ F.Vplus M G₁)
    (h : Chapter12.Section02.Hypothesis1221 KnownSimple.IsKnownSimple F.T F.L)
    (hHz : F.H ∈ Source.Hz (sourceOne F.L F.T F.V₁) F.T G₁ M)
    (hcentral : centralizer (F.Vplus:Set G) ≤ M ⊓ normalizer (F.V:Set G))
    (c : CriticalPair F.L (F.T:Subgroup G) F.H F.V) (hb : 3 ≤ c.path.length)
    [IsElementaryAbelian 2 (Source.VH F.H F.V)]
    (ρ : Representation (ZMod 2) F.H (Fin 4 → ZMod 2))
    (d : BinaryConjugationSection F.H (Source.UH F.H F.Vplus) F.V₁ ρ)
    (π : F.H →* SL(4,ZMod 2)) (hker : π.ker = (Source.QH F.H).subgroupOf F.H)
    (honto : Function.Surjective π)
    (hnatural : ∀ h w, ρ h w = Matrix.mulVec (π h).val w)
    (ξ : Representation (ZMod 2) F.H (Fin 6 → ZMod 2))
    (dx : BinaryConjugationSection F.H (Source.VH F.H F.V) (Source.UH F.H F.Vplus) ξ)
    (hexterior : ∀ h w, ξ h w = exteriorMap (π h).val w)
    (hseed : ⁅centralizer (F.Vplus:Set G),F.V⁆ ≤ F.V₁)
    (houtside : ¬ c.Ugamma F.Vplus ≤ Source.QH F.H)
    (hline : ¬ c.Aone F.V₁ ≤ Source.UH F.H F.Vplus)
    (hbackline : ¬ F.V₁ ≤ c.Ugamma F.Vplus) :
    (Source.QH F.H).relIndex (c.Ugamma F.Vplus) = 2 ∧
      8 ≤ Nat.card (c.Ugamma F.Vplus ⊓ Source.VH F.H F.V : Subgroup G) ∧
      c.Aone F.V₁ ≤ Source.VH F.H F.V := by
  have hcontrol := source_seed_normalizer_le_LT s h hHz hcentral ρ d π hker hnatural
  exact source_critical_pair_geometry_of_seed_normalizer F hF c hb
    ρ d π hker honto hnatural ξ dx hexterior hseed s.seed_card hcontrol
    houtside hline hbackline

/-- The terminal application uses the proved source seed-normalizer control.
The natural/exterior markings and the 13.8.31 obstruction remain explicit. -/
theorem source_linear_four_exclusion_of_original_seed
    (F : ChapterF.Section09.Setup G) (hF : F.Hypothesis)
    (V₂ M G₁ : Subgroup G)
    (s : NaturalSetup F.T F.L F.V F.V₁ V₂ F.Vplus M G₁)
    (h : Chapter12.Section02.Hypothesis1221 KnownSimple.IsKnownSimple F.T F.L)
    (hHz : F.H ∈ Source.Hz (sourceOne F.L F.T F.V₁) F.T G₁ M)
    (hcentral : centralizer (F.Vplus:Set G) ≤ M ⊓ normalizer (F.V:Set G))
    (c : CriticalPair F.L (F.T:Subgroup G) F.H F.V) (hb : 3 ≤ c.path.length)
    (Q R K : Subgroup G)
    [IsElementaryAbelian 2 (Source.VH F.H F.V)]
    (ρ : Representation (ZMod 2) F.H (Fin 4 → ZMod 2))
    (d : BinaryConjugationSection F.H (Source.UH F.H F.Vplus) F.V₁ ρ)
    (π : F.H →* SL(4,ZMod 2)) (hker : π.ker = (Source.QH F.H).subgroupOf F.H)
    (honto : Function.Surjective π)
    (hnatural : ∀ h w, ρ h w = Matrix.mulVec (π h).val w)
    (ξ : Representation (ZMod 2) F.H (Fin 6 → ZMod 2))
    (dx : BinaryConjugationSection F.H (Source.VH F.H F.V) (Source.UH F.H F.Vplus) ξ)
    (hexterior : ∀ h w, ξ h w = exteriorMap (π h).val w)
    (hH : F.H = normalizer (F.V₁:Set G))
    (hseed : ⁅centralizer (F.Vplus:Set G),F.V⁆ ≤ F.V₁)
    (hseedQ : ⁅F.Vplus,Source.QH F.H⁆ ≠ ⊥)
    (houtside : ¬ c.Ugamma F.Vplus ≤ Source.QH F.H)
    (hline : ¬ c.Aone F.V₁ ≤ Source.UH F.H F.Vplus) (hbackline : ¬ F.V₁ ≤ c.Ugamma F.Vplus)
    (hQR : Source.QH F.H ≤ R) (hindex : Q.relIndex R = 4)
    (hcent : Q ⊓ Source.QH F.H ≤ centralizer (F.Vplus:Set G))
    (hQV : Q ≤ centralizer (F.V:Set G))
    (hcover : IsSQTK KnownSimple.IsKnownSimple F.H)
    (e : (F.H ⧸ pCore 2 F.H) ≃* LinearGroup 4)
    (hKH : K ≤ F.H) (hK : IsPPerfect 2 K)
    (hmove : ¬ ⁅Source.HC F.H F.Vplus,K⁆ ≤ Source.VH F.H F.V)
    (hKonto : Function.Surjective
      ((QuotientGroup.mk' (pCore 2 F.H)).comp (K.subgroupOf F.H).subtype))
    (hnotfour : ∀ s : ChiefSeries F.H,
      s.head.val.map F.H.subtype = Source.VH F.H F.V → s.last.val.map F.H.subtype = Source.HC F.H F.Vplus →
      (∀ i : Fin s.length, ∀ D : Subgroup (Section (s i.castSucc) (s i.succ)),
        (∀ k : K.subgroupOf F.H, ∀ x, x ∈ D →
          sectionAction (s i.castSucc) (s i.succ) k x ∈ D) → D = ⊥ ∨ D = ⊤) →
      s.restrictedNoncentralCount (K.subgroupOf F.H) = 1 → ∀ i : Fin s.length,
        (¬ ∀ k : K.subgroupOf F.H, ∀ x,
          sectionAction (s i.castSucc) (s i.succ) k x = x) →
          Nat.card (Section (s i.castSucc) (s i.succ)) ≠ 16) : False := by
  have hcontrol := source_seed_normalizer_le_LT s h hHz hcentral ρ d π hker hnatural
  exact source_linear_four_exclusion_of_natural_duality F hF c hb Q R K
    ρ d π hker honto hnatural ξ dx hexterior hH hseed s.seed_card hseedQ hcontrol
    houtside hline hbackline hQR hindex hcent hQV hcover e hKH hK hmove hKonto hnotfour

end CFSG.Quasithin.Chapter13.Section08.LinearFour
