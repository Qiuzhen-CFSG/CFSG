/-!
# The original seed and its two-core centralizer

The recognized five-dimensional U_L/V is generated by the L-orbit of a
single element u₁ of the original U₁ outside V. Select a basis from that
orbit and lift it through the literal quotient: five conjugates of the
same u₁, together with V, generate all of U_L.

The earlier local commutator bound puts [Q,u₁] in the central line V₁.
Its centralizer therefore has index at most two in Q = O₂(LT), and index
one holds exactly when U₁ centralizes Q. Since L normalizes Q and U₀=U_L,
that central case makes the entire original U_L centralize Q. Otherwise
the five conjugates have index-two centralizers. Their intersection is
C_Q(U_L), giving its relative normality and an elementary abelian quotient
Q/C_Q(U_L) of order at most 32.

This constructs the source generators, indices and quotient used on
printed pp.967--968 of Aschbacher--Smith, proof of 13.8.33. Applying
13.4.1 in the central case, recognizing the noncentral quotient for the
chief-factor comparison, and the strict-denominator/13.8.34 assembly
remain required. The earlier ordinary markings and source inputs are
unchanged; no central-case exclusion or final chief-factor count is assumed.
-/

public section
open Subgroup Representation
open scoped IsMulCommutative Pointwise commutatorElement
namespace CFSG.Quasithin.Chapter13.Section08.SourceCompletion.CaseOne
open TransvectionRecognition.Component.ModelExtension A6Endgame.IntersectionBalance
open TransvectionQuotients TransvectionQuotients.FourLocalFactors TransvectionParabolic FiveSeed
variable {G : Type*} [Group G] [Finite G]
  {T : Sylow 2 G} {L V V₁ V₂ V₃ M G₁ H K : Subgroup G}
  [IsElementaryAbelian 2 (Source.UH H V₃)]

/-- Five actual L-conjugates of one original seed generate U_L modulo V. -/
theorem full_denominators_seed_generators
    (d : LocalSetup T L V V₁ V₂ V₃ M G₁)
    (h : (Section07.ConjugateIntersections.sourceSetup T L V V₃ V₁ H).Hypothesis)
    (c : CriticalGeometry.CriticalPair L (T : Subgroup G) H V)
    (hDH : Source.DH (Source.UH H V₃) (c.Ugamma V₃) (c.Aone V₁) = Source.UH H V₃)
    (hDg : Source.Dgamma (c.Ugamma V₃) (Source.UH H V₃) V₁ = c.Ugamma V₃)
    (hH : H = G₁)
    (hcentral : centralizer (V₃ : Set G) ≤ M ⊓ normalizer (V : Set G))
    (hHz : H ∈ Source.Hz (sourceOne L T V₁) (T : Subgroup G) G₁ M)
    (K : Subgroup G) (hK : (K.subgroupOf H).IsCComponent)
    (hprod : (H : Set G) = (K : Set G) * (T : Set G))
    (eL : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 6))
    (a : SolvableExclusion.Five.StarAction H (Source.UH H V₃) V₁)
    (e : Source.Hstar H ≃* Equiv.Perm (Fin 6))
    (model : CompatibleModel H V₃ V₁ a e)
    (earlier1354 : EarlierCore.Earlier1354 T L V)
    (earlier1376 : Marking.NaturalSection.Earlier1376 L (EarlierCore.localResidual L V₁)
      T (normalizer (V₁ : Set G)) M V₂ V₃ V₁)
    (chief : ChiefGeneration.Earlier1376ChiefFactors (sourceOne L T V₁) T G₁ M V₃ V₁) :
    ∃ u : Source.U1 H K V₃, (u : G) ∉ V ∧
      ∃ g : Fin 5 → L, Source.UL L H V₃ =
        V ⊔ closure (Set.range fun i => MulAut.conj (g i : G) (u : G)) := by
  obtain ⟨_,_,hn,hN,hE,hA,_,_,ρ,hρ,_,_,hd⟩ :=
    full_denominators_whole_cover d h c hDH hDg hH hcentral hHz K hK hprod
      eL a e model earlier1354 earlier1376 chief
  let _ := hN
  let _ := hE
  let _ := hA
  have heq := full_denominators_U0_eq_UL d h c hDH hDg hH hcentral hHz K hK hprod
    eL a e model earlier1354 earlier1376 chief
  obtain ⟨_,F,hF,hp⟩ := full_denominators_abelian_cover d h c hDH hDg hH hcentral hHz
    K hK hprod eL a e model earlier1354 earlier1376 chief
  obtain ⟨_,hi,hcomm,_,_⟩ := original_cover_seed d h c hDH hDg hHz K hK hprod a e F hF hp
  have hVUL : V ≤ Source.UL L H V₃ :=
    (full_denominators_whole_permutation d h c hDH hDg hH hcentral hHz K hK hprod
      eL a e model earlier1354 earlier1376 chief).2.1.le
  let R := Source.UL L H V₃
  let π := (QuotientGroup.mk' (actorKernel (L ⊔ (T : Subgroup G)) V)).comp
    (inclusion (show L ≤ L ⊔ (T : Subgroup G) from le_sup_left))
  let σ := ρ.comp π
  have hσ : SectionConjugationAlong L R V (MonoidHom.id L) (le_sup_left.trans hn) σ := by
    intro l u
    exact hρ (inclusion le_sup_left l) u
  obtain ⟨u,hu,_,hs⟩ := exists_fixed_spanning_seed L R (Source.U1 H K V₃) L
    (sourceOne L T V₁ ⊔ (T : Subgroup G)) V (MonoidHom.id L) (le_sup_left.trans hn)
    le_rfl heq.symm hi (hcomm.trans (d.line_le_plane.trans (d.plane_le_seed.trans d.seed_le))) σ hσ
  have huR : (u : G) ∈ R := (show Source.U1 H K V₃ ≤ R from
    inf_le_left.trans (le_conjugateSpanBy _ _)) u.property
  let q := QuotientGroup.mk' (V.subgroupOf R)
  let f := MulEquiv.toMultiplicative_toAdditive.symm.toMonoidHom.comp q
  let x : L → R := fun l => ⟨MulAut.conj (l : G) (u : G),
    (mem_normalizer_iff.mp ((le_sup_left.trans hn) l.property) u).mp huR⟩
  have hs' : Submodule.span (ZMod 2) (Set.range fun l => (f (x l)).toAdd) = ⊤ := by
    convert hs using 2
    ext y
    constructor
    · rintro ⟨l,rfl⟩
      exact ⟨l,hσ l ⟨u,huR⟩⟩
    · rintro ⟨l,rfl⟩
      exact ⟨l,(hσ l ⟨u,huR⟩).symm⟩
  have hk : f.ker = V.subgroupOf R := by
    ext r
    exact QuotientGroup.eq_one_iff r
  obtain ⟨g,hg⟩ := exists_generators_of_spanning_binary_section R V f hVUL hk x hs' 5 hd
  exact ⟨u,hu,g,hg⟩

/-- The seed centralizer has index at most two, with equality to one
precisely in the source central-seed case. -/
theorem original_cover_seed_core_index
    (d : LocalSetup T L V V₁ V₂ V₃ M G₁)
    (h : (Section07.ConjugateIntersections.sourceSetup T L V V₃ V₁ H).Hypothesis)
    (c : CriticalGeometry.CriticalPair L (T : Subgroup G) H V)
    (hDH : Source.DH (Source.UH H V₃) (c.Ugamma V₃) (c.Aone V₁) = Source.UH H V₃)
    (hDg : Source.Dgamma (c.Ugamma V₃) (Source.UH H V₃) V₁ = c.Ugamma V₃)
    (hHz : H ∈ Source.Hz (sourceOne L T V₁) (T : Subgroup G) G₁ M)
    (K : Subgroup G) (hK : (K.subgroupOf H).IsCComponent)
    (hprod : (H : Set G) = (K : Set G) * (T : Set G))
    (a : SolvableExclusion.Five.StarAction H (Source.UH H V₃) V₁)
    (e : Source.Hstar H ≃* Equiv.Perm (Fin 6))
    (F : Additive (Source.Utilde H V₃ V₁) ≃ₗ[ZMod 2] BinaryPermutation.core (Fin 6))
    (hF : ∀ g v, F (tildeRepresentation H _ V₁ a g v) =
      BinaryPermutation.coreRepresentation (Fin 6) (e g) (F v))
    (hp : (quotientSpace (Source.UH H V₃) V₁ V₃).map F.toLinearMap =
      Representation.SixLetterRadicalDisplacement.W)
    (u : Source.U1 H K V₃) (hu : (u : G) ∉ V) :
    (centralizer ({(u : G)} : Set G)).relIndex ((L ⊔ (T : Subgroup G)).pCoreIn 2) ≤ 2 ∧
      ((centralizer ({(u : G)} : Set G)).relIndex ((L ⊔ (T : Subgroup G)).pCoreIn 2) = 1 ↔
        Source.U1 H K V₃ ≤ centralizer ((L ⊔ (T : Subgroup G)).pCoreIn 2 : Set G)) := by
  let Q := (L ⊔ (T : Subgroup G)).pCoreIn 2
  obtain ⟨_,hi,hcomm,_,_⟩ := original_cover_seed d h c hDH hDg hHz K hK hprod a e F hF hp
  have hQT : Q ≤ (T : Subgroup G) :=
    (pCoreIn_le_sylow _ (T.subtype le_sup_right)).trans_eq (map_subgroupOf_eq_of_le le_sup_right)
  have hQV : Q ≤ centralizer (V : Set G) := (localNaturalSetup d).chosen.core_centralizes
  have hVC : V ≤ centralizer (Q : Set G) := le_centralizer_iff.mp hQV
  have hULQ : Source.UL L H V₃ ≤ Q := Section07.span_UH_L_le_core (localNaturalSetup d) h
    (show IsMulCommutative (Source.UH H V₃) from inferInstance)
  have huH : (u : G) ∈ Source.UH H V₃ := u.property.1
  have huQ : (u : G) ∈ Q := hULQ ((le_conjugateSpanBy _ _) huH)
  let _ : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hcard : Nat.card (zpowers (u : G)) = 2 := by
    rw [Nat.card_zpowers]
    exact orderOf_eq_prime (elemPow_eq_one_of_isElementaryAbelian (u : G) huH)
      (fun he => hu (he ▸ V.one_mem))
  have hindex := line_centralizer_index_le_two Q V₁ (zpowers (u : G)) d.line_card hcard
    (zpowers_le.mpr huQ)
    ((commutator_mono (hQT.trans le_sup_right) (zpowers_le.mpr u.property)).trans hcomm)
    (le_centralizer_iff.mp ((hQT.trans h.T_le_H).trans h.H_centralizes))
  have hsmall : (centralizer ({(u : G)} : Set G)).relIndex Q ≤ 2 := by
    simpa only [inf_relIndex_left,zpowers_eq_closure,centralizer_closure] using hindex
  refine ⟨hsmall,?_⟩
  constructor
  · intro he
    have huc : (u : G) ∈ centralizer (Q : Set G) :=
      fun q hq => mem_centralizer_singleton_iff.mp ((relIndex_eq_one.mp he) hq)
    obtain ⟨v,hv,hvV,hcos⟩ := relIndex_eq_two_iff_exists_notMem_and.mp hi
    have hvc : v ∈ centralizer (Q : Set G) :=
      ((centralizer (Q : Set G)).mul_mem_cancel_left huc).mp
        (hVC ((hcos u u.property).resolve_right hu))
    intro w hw
    rcases hcos w hw with hwV | hwV
    · exact ((centralizer (Q : Set G)).mul_mem_cancel_right hvc).mp (hVC hwV)
    · exact hVC hwV
  · intro hc
    apply relIndex_eq_one.mpr
    intro q hq
    exact mem_centralizer_singleton_iff.mpr (hc u.property q hq)

/-- The source central/noncentral split, with five actual generators and
all structure of the small centralizer quotient constructed. -/
theorem full_denominators_seed_core_alternatives
    (d : LocalSetup T L V V₁ V₂ V₃ M G₁)
    (h : (Section07.ConjugateIntersections.sourceSetup T L V V₃ V₁ H).Hypothesis)
    (c : CriticalGeometry.CriticalPair L (T : Subgroup G) H V)
    (hDH : Source.DH (Source.UH H V₃) (c.Ugamma V₃) (c.Aone V₁) = Source.UH H V₃)
    (hDg : Source.Dgamma (c.Ugamma V₃) (Source.UH H V₃) V₁ = c.Ugamma V₃)
    (hH : H = G₁)
    (hcentral : centralizer (V₃ : Set G) ≤ M ⊓ normalizer (V : Set G))
    (hHz : H ∈ Source.Hz (sourceOne L T V₁) (T : Subgroup G) G₁ M)
    (K : Subgroup G) (hK : (K.subgroupOf H).IsCComponent)
    (hprod : (H : Set G) = (K : Set G) * (T : Set G))
    (eL : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 6))
    (a : SolvableExclusion.Five.StarAction H (Source.UH H V₃) V₁)
    (e : Source.Hstar H ≃* Equiv.Perm (Fin 6))
    (model : CompatibleModel H V₃ V₁ a e)
    (earlier1354 : EarlierCore.Earlier1354 T L V)
    (earlier1376 : Marking.NaturalSection.Earlier1376 L (EarlierCore.localResidual L V₁)
      T (normalizer (V₁ : Set G)) M V₂ V₃ V₁)
    (chief : ChiefGeneration.Earlier1376ChiefFactors (sourceOne L T V₁) T G₁ M V₃ V₁) :
    ∃ u : Source.U1 H K V₃, (u : G) ∉ V ∧
      ∃ g : Fin 5 → L,
        Source.UL L H V₃ = V ⊔ closure (Set.range fun i => MulAut.conj (g i : G) (u : G)) ∧
        (Source.U1 H K V₃ ≤ centralizer ((L ⊔ (T : Subgroup G)).pCoreIn 2 : Set G) ↔
          Source.UL L H V₃ ≤ centralizer ((L ⊔ (T : Subgroup G)).pCoreIn 2 : Set G)) ∧
        (Source.UL L H V₃ ≤ centralizer ((L ⊔ (T : Subgroup G)).pCoreIn 2 : Set G) ∨
          (centralizer ({(u : G)} : Set G)).relIndex ((L ⊔ (T : Subgroup G)).pCoreIn 2) = 2 ∧
          ∃ hN : ((A6Endgame.ActionAnalysis33.CQUL ((L ⊔ (T : Subgroup G)).pCoreIn 2)
            L H V₃).subgroupOf ((L ⊔ (T : Subgroup G)).pCoreIn 2)).Normal,
            let _ := hN
            IsElementaryAbelian 2 (((L ⊔ (T : Subgroup G)).pCoreIn 2) ⧸
              (A6Endgame.ActionAnalysis33.CQUL ((L ⊔ (T : Subgroup G)).pCoreIn 2) L H V₃).subgroupOf
                ((L ⊔ (T : Subgroup G)).pCoreIn 2)) ∧
            Nat.card (((L ⊔ (T : Subgroup G)).pCoreIn 2) ⧸
              (A6Endgame.ActionAnalysis33.CQUL ((L ⊔ (T : Subgroup G)).pCoreIn 2) L H V₃).subgroupOf
                ((L ⊔ (T : Subgroup G)).pCoreIn 2)) ≤ 32) := by
  obtain ⟨u,hu,g,hg⟩ := full_denominators_seed_generators d h c hDH hDg hH hcentral hHz K hK hprod
    eL a e model earlier1354 earlier1376 chief
  let Q := (L ⊔ (T : Subgroup G)).pCoreIn 2
  have hLN : L ≤ normalizer (Q : Set G) := le_sup_left.trans
    ((L ⊔ (T : Subgroup G)).le_normalizer.trans
      (normalizer_le_normalizer_characteristic_image _ (pCore 2 (L ⊔ (T : Subgroup G) : Subgroup G))))
  have heq := full_denominators_U0_eq_UL d h c hDH hDg hH hcentral hHz K hK hprod
    eL a e model earlier1354 earlier1376 chief
  have hc : Source.U1 H K V₃ ≤ centralizer (Q : Set G) ↔
      Source.UL L H V₃ ≤ centralizer (Q : Set G) := by
    constructor
    · intro hc
      rw [← heq]
      exact conjugateSpanBy_le hc (centralizer_normalized Q L hLN)
    · intro hc
      exact (inf_le_left.trans (le_conjugateSpanBy _ _)).trans hc
  refine ⟨u,hu,g,hg,hc,?_⟩
  by_cases hz : Source.U1 H K V₃ ≤ centralizer (Q : Set G)
  · exact Or.inl (hc.mp hz)
  obtain ⟨_,F,hF,hp⟩ := full_denominators_abelian_cover d h c hDH hDg hH hcentral hHz
    K hK hprod eL a e model earlier1354 earlier1376 chief
  obtain ⟨hsmall,hiff⟩ := original_cover_seed_core_index d h c hDH hDg hHz K hK hprod a e F hF hp u hu
  have hne : (centralizer ({(u : G)} : Set G)).relIndex Q ≠ 1 := fun he => hz (hiff.mp he)
  have hpos : 0 < (centralizer ({(u : G)} : Set G)).relIndex Q := Nat.pos_of_ne_zero index_ne_zero_of_finite
  change (centralizer ({(u : G)} : Set G)).relIndex Q ≤ 2 at hsmall
  have hi : (centralizer ({(u : G)} : Set G)).relIndex Q = 2 := by omega
  refine Or.inr ⟨hi,?_⟩
  exact A6Endgame.ActionAnalysis33.centralizer_quotient_elementary_and_card V Q L H V₃ u
    (fun i => (g i : G)) hg (localNaturalSetup d).chosen.core_centralizes hLN
    (fun i => (g i).property) hi

