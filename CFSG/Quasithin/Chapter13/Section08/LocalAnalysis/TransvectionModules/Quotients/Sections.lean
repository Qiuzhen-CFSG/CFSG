module

public import CFSG.Quasithin.Chapter13.Section08.LocalAnalysis.TransvectionModules.Basic
public import Theory.GroupAction.SubgroupQuotientFullAction

/-!
# Literal quotient actions and the seed for 13.8.6(5)

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*, combined
manuscript of 1 March 2004, printed p.948, Lemma 13.8.6.

We define U₁ = C_{U_H}(K), U₀ = ⟨U₁^L⟩ and the literal quotients U₀/V
and U_L/V. Monotonicity gives U₀ ≤ U_L; the earlier generation of V by
V₁ and centralization of V₁ give V ≤ U₀.

For the permutation assertion, normalization constructs the conjugation
action on the quotient, and a commutator bound descends it through the
specified actor kernel. An index-two seed image and the local commutator
bound yield a stabilizer-fixed vector. Subgroup conjugate generation proves
that its orbit spans, so Basic's orbit-sum map is surjective. Only the
quotient is assumed elementary abelian; its numerator need not be abelian.
The source-specific local module calculations supplying these premises are
separate obligations, not conclusions asserted here.
-/

@[expose] public section

open Subgroup Representation Module
open scoped IsMulCommutative commutatorElement
namespace CFSG.Quasithin.Chapter13.Section08
namespace Source
variable {G : Type*} [Group G]
/-- The relative centralizer C_{U_H}(K). -/
def U1 (H K V₃ : Subgroup G) : Subgroup G := UH H V₃ ⊓ centralizer (K : Set G)
/-- The subgroup generated by the L-conjugates of the relative centralizer. -/
def U0 (L H K V₃ : Subgroup G) : Subgroup G := conjugateSpanBy (U1 H K V₃) L
/-- The literal U₀/V carrier; containment and relative normality are separate. -/
abbrev U0section (L H K V₃ V : Subgroup G) :=
  U0 L H K V₃ ⧸ V.subgroupOf (U0 L H K V₃)
/-- The literal U_L/V carrier; no abelianness of U_L is imposed. -/
abbrev ULsection (L H V₃ V : Subgroup G) := UL L H V₃ ⧸ V.subgroupOf (UL L H V₃)

/-- The centralizer seed lies in U_H, hence its L-span lies in U_L. -/
theorem U0_le_UL (L H K V₃ : Subgroup G) : U0 L H K V₃ ≤ UL L H V₃ :=
  conjugateSpanBy_mono inf_le_left le_rfl

/-- The earlier V₁-generation and centralization put V in U₀. -/
theorem V_le_U0 (L H K V₃ V V₁ : Subgroup G)
    (hV : V = conjugateSpanBy V₁ L) (hV₁ : V₁ ≤ UH H V₃)
    (hK : V₁ ≤ centralizer (K : Set G)) : V ≤ U0 L H K V₃ := by
  rw [hV]
  exact conjugateSpanBy_mono (le_inf hV₁ hK) le_rfl
end Source

namespace TransvectionQuotients
variable {G A : Type*} [Group G] [Group A]

/-- Conjugation on an actual elementary abelian section, along the specified actor map. -/
def SectionConjugationAlong (P B Z : Subgroup G) [(Z.subgroupOf B).Normal]
    [IsElementaryAbelian 2 (B ⧸ Z.subgroupOf B)] (π : P →* A)
    (hPB : P ≤ normalizer (B : Set G))
    (ρ : Representation (ZMod 2) A (Additive (B ⧸ Z.subgroupOf B))) : Prop :=
  ∀ (p : P) (b : B),
    ρ (π p) (Additive.ofMul (QuotientGroup.mk' (Z.subgroupOf B) b)) =
      Additive.ofMul (QuotientGroup.mk' (Z.subgroupOf B)
        ⟨(p : G) * (b : G) * (p : G)⁻¹,
          (mem_normalizer_iff.mp (hPB p.property) b).mp b.property⟩)

/-- Normalization and the kernel commutator bound construct the binary action. -/
theorem exists_section_representation (P B Z : Subgroup G)
    [(Z.subgroupOf B).Normal] [IsElementaryAbelian 2 (B ⧸ Z.subgroupOf B)]
    (N : Subgroup P) [N.Normal]
    (hPB : P ≤ normalizer (B : Set G)) (hPZ : P ≤ normalizer (Z : Set G))
    (hkill : ⁅B, N.map P.subtype⁆ ≤ Z) :
    ∃ ρ : Representation (ZMod 2) (P ⧸ N) (Additive (B ⧸ Z.subgroupOf B)),
      SectionConjugationAlong P B Z (QuotientGroup.mk' N) hPB ρ := by
  obtain ⟨action, haction⟩ := exists_quotient_conjugation_action P B Z hPB hPZ inferInstance
  let τ : Representation (ZMod 2) P (Additive (B ⧸ Z.subgroupOf B)) :=
    { toFun := fun p => (MonoidHom.toAdditive (action p).toMonoidHom).toZModLinearMap 2
      map_one' := by ext x; exact DFunLike.congr_fun (action.map_one) x.toMul
      map_mul' := by intro p q; ext x; exact DFunLike.congr_fun (action.map_mul p q) x.toMul }
  have hk := quotient_conjugation_action_kills_commutator_layer P B Z
    (N.map P.subtype) inferInstance hPB hkill action haction
  have hNτ : N ≤ τ.ker := by
    intro n hn
    have hn' : n ∈ (N.map P.subtype).subgroupOf P := mem_map.mpr ⟨n, hn, rfl⟩
    have he : action n = 1 := hk hn'
    apply LinearMap.ext
    intro x
    change Additive.ofMul (action n x.toMul) = x
    rw [he]
    rfl
  refine ⟨QuotientGroup.lift N τ hNτ, ?_⟩
  intro p b
  change Additive.ofMul (action p (QuotientGroup.mk' (Z.subgroupOf B) b)) = _
  rw [haction]

/-- The section's seed orbit spans: this is deduced from subgroup generation,
not imposed as a module-generation assumption. -/
theorem exists_fixed_spanning_seed (P B D L R Z : Subgroup G)
    [(Z.subgroupOf B).Normal] [IsElementaryAbelian 2 (B ⧸ Z.subgroupOf B)]
    (π : P →* A) (hPB : P ≤ normalizer (B : Set G)) (hLP : L ≤ P)
    (hB : B = conjugateSpanBy D L) (hindex : Z.relIndex D = 2)
    (hcomm : ⁅R, D⁆ ≤ Z)
    (ρ : Representation (ZMod 2) A (Additive (B ⧸ Z.subgroupOf B)))
    (hρ : SectionConjugationAlong P B Z π hPB ρ) :
    ∃ a : D, (a : G) ∉ Z ∧
      let v := Additive.ofMul (QuotientGroup.mk' (Z.subgroupOf B)
        ⟨(a : G), hB.symm ▸ le_conjugateSpanBy D L a.property⟩)
      (∀ p ∈ (R.subgroupOf P).map π, ρ p v = v) ∧
        Submodule.span (ZMod 2) (Set.range fun p => ρ p v) = ⊤ := by
  classical
  let q : B →* B ⧸ Z.subgroupOf B := QuotientGroup.mk' (Z.subgroupOf B)
  have hDB : D ≤ B := hB.symm ▸ le_conjugateSpanBy D L
  obtain ⟨a, haD, haZ, hcoset⟩ := relIndex_eq_two_iff_exists_notMem_and.mp hindex
  let aB : B := ⟨a, hDB haD⟩
  let v := Additive.ofMul (q aB)
  refine ⟨⟨a, haD⟩, haZ, ?_⟩
  change (∀ p ∈ (R.subgroupOf P).map π, ρ p v = v) ∧ _
  have hseed (b : G) (hb : b ∈ D) :
      Additive.ofMul (q ⟨b, hDB hb⟩) = 0 ∨ Additive.ofMul (q ⟨b, hDB hb⟩) = v := by
    rcases hcoset b hb with hba | hbZ
    · right
      have hqba : q (⟨b, hDB hb⟩ * aB) = 1 := (QuotientGroup.eq_one_iff _).mpr hba
      have he : Additive.ofMul (q ⟨b, hDB hb⟩) + v = 0 := hqba
      have hvv : v + v = 0 := by
        simpa only [add_smul, one_smul, zero_smul] using
          (congrArg (fun c : ZMod 2 => c • v) (show 1 + 1 = (0 : ZMod 2) from rfl))
      exact add_right_cancel (he.trans hvv.symm)
    · left
      exact (QuotientGroup.eq_one_iff _).mpr hbZ
  constructor
  · rintro p ⟨r, hr, rfl⟩
    rw [hρ r aB]
    apply congrArg Additive.ofMul
    apply QuotientGroup.eq_iff_div_mem.mpr
    change (r : G) * a * (r : G)⁻¹ / a ∈ Z
    have hr' : (r : G) ∈ R := hr
    simpa only [commutatorElement_def, div_eq_mul_inv] using
      hcomm (commutator_mem_commutator hr' haD)
  · let S := Submodule.span (ZMod 2) (Set.range fun p => ρ p v)
    let C := ((S.toAddSubgroup.toSubgroup').comap q).map B.subtype
    have hBC : B ≤ C := by
      rw [hB]
      apply (Subgroup.closure_le C).mpr
      rintro x ⟨l, hl, b, hb, rfl⟩
      let x : B := ⟨l * b * l⁻¹,
        (mem_normalizer_iff.mp (hPB (hLP hl)) b).mp (hDB hb)⟩
      refine ⟨x, ?_, rfl⟩
      change Additive.ofMul (q x) ∈ S
      rw [show Additive.ofMul (q x) = ρ (π ⟨l, hLP hl⟩)
        (Additive.ofMul (q ⟨b, hDB hb⟩)) from (hρ ⟨l, hLP hl⟩ ⟨b, hDB hb⟩).symm]
      rcases hseed b hb with hz | hv
      · rw [hz, map_zero]
        exact S.zero_mem
      · rw [hv]
        exact Submodule.subset_span ⟨_, rfl⟩
    apply top_unique
    intro x _
    obtain ⟨b, hb⟩ := QuotientGroup.mk'_surjective (Z.subgroupOf B) x.toMul
    obtain ⟨b', hb', heq⟩ := hBC b.property
    have he : b' = b := Subtype.ext heq
    subst b'
    change Additive.ofMul (q b) ∈ S at hb'
    change q b = x.toMul at hb
    simpa only [hb, ofMul_toMul] using hb'

/-- The orbit-sum map from the actual actor cosets onto the literal section. -/
theorem permutation_surjection_of_conjugate_span (P B D L R Z : Subgroup G)
    [(Z.subgroupOf B).Normal] [IsElementaryAbelian 2 (B ⧸ Z.subgroupOf B)]
    (π : P →* A) [Fintype (A ⧸ (R.subgroupOf P).map π)]
    (hPB : P ≤ normalizer (B : Set G)) (hLP : L ≤ P)
    (hB : B = conjugateSpanBy D L) (hindex : Z.relIndex D = 2)
    (hcomm : ⁅R, D⁆ ≤ Z)
    (ρ : Representation (ZMod 2) A (Additive (B ⧸ Z.subgroupOf B)))
    (hρ : SectionConjugationAlong P B Z π hPB ρ) :
    ∃ f : Representation.IntertwiningMap
      ((BinaryPermutation.representation (A ⧸ (R.subgroupOf P).map π)).comp
        (MulAction.toPermHom A (A ⧸ (R.subgroupOf P).map π))) ρ,
      Function.Surjective f := by
  classical
  obtain ⟨a, ha, hv, hspan⟩ := exists_fixed_spanning_seed P B D L R Z π hPB hLP hB hindex hcomm ρ hρ
  let d := cosetPermutationSectionData ρ _ _ hv hspan
  exact ⟨d.intertwiningMap, d.intertwiningMap_surjective⟩
end TransvectionQuotients
end CFSG.Quasithin.Chapter13.Section08

end
