module

public import CFSG.Quasithin.Chapter13.Section08.LocalAnalysis.TransvectionModules.Quotients.FourLocalFactors.Dimensions
public import CFSG.Quasithin.Chapter13.Section08.LocalAnalysis.TransvectionModules.Quotients.FourLocalFactors.BinaryPlanes

/-!
# Natural actions on the literal commutator-generated local planes

Commutator generation by Lᵢ passes to the action-difference space of the
actual image of LᵢT in the full actor. A binary plane generated by these
differences is irreducible. Recognition using the specified S₃ quotient
then constructs its natural equivalence and identifies its exact kernel.

This is a conditional transfer used by the source assembly for
Aschbacher–Smith 13.8.6(4), printed p.948 (PDF p.965). The local group
quotient identifications and U_H=[U_H,L₁] must still be supplied from the
standing source setup; they are not asserted by this lemma.
-/

@[expose] public section

open Subgroup Representation
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter13.Section08.TransvectionQuotients.FourLocalFactors
variable {G A X : Type*} [Group G] [Group A] [AddCommGroup X] [Module (ZMod 2) X]

/-- An actual natural plane, retaining the specified quotient isomorphism. -/
def NaturalPlane (σ : Representation (ZMod 2) A X)
    (e : (A ⧸ pCore 2 A) ≃* Equiv.Perm (Fin 3)) : Prop :=
  Module.finrank (ZMod 2) X = 2 ∧ σ.IsIrreducible ∧ σ.ker = pCore 2 A ∧
    Nonempty (σ.Equiv ((BinaryPermutation.coreRepresentation (Fin 3)).comp
      (e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 A)))))

variable (B Z P : Subgroup G) [(Z.subgroupOf B).Normal]
  [IsElementaryAbelian 2 (B ⧸ Z.subgroupOf B)]
  (π : P →* A) (hPB : P ≤ normalizer (B : Set G))
  (ρ : Representation (ZMod 2) A (Additive (B ⧸ Z.subgroupOf B)))
  (hρ : SectionConjugationAlong P B Z π hPB ρ)

/-- Generation by a subgroup of the local actor suffices; the action is
restricted through the actual subgroup image under π. -/
theorem localImage_natural [Finite G] (R D J : Subgroup G)
    (hRD : R ≤ normalizer (D : Set G)) (hJR : J ≤ R)
    (hRP : R ≤ P) (hDB : D ≤ B) (hcomm : D = ⁅D, J⁆)
    (hdim : Module.finrank (ZMod 2) (sectionImage B Z D) = 2)
    (e : (((R.subgroupOf P).map π) ⧸ pCore 2 ((R.subgroupOf P).map π)) ≃*
      Equiv.Perm (Fin 3)) :
    NaturalPlane (localImage B Z P π hPB ρ hρ R D hRD).toRepresentation e := by
  let : Finite ((R.subgroupOf P).map π) := Finite.of_surjective
    (π.subgroupMap (R.subgroupOf P)) (π.subgroupMap_surjective (R.subgroupOf P))
  have hgen : D = ⁅D, R⁆ := le_antisymm
    (hcomm.le.trans (commutator_mono le_rfl hJR))
    (le_normalizer_iff_commutator_le_left.mp hRD)
  exact ⟨hdim, BinaryPlaneRecognition.recognize _ hdim
    (localImage_coinvariants_eq_top B Z P π hPB ρ hρ R D hRD hRP hDB hgen) e⟩
end CFSG.Quasithin.Chapter13.Section08.TransvectionQuotients.FourLocalFactors

end
