module

public import Mathlib.Algebra.Field.ZMod
public import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas
public import Theory.Representation.SubspaceQuotient
public import Mathlib.RepresentationTheory.Coinvariants

/-!
# Irreducibility of generating binary planes

A proper nonzero subspace of a binary plane has a one-dimensional quotient.
Every group acts trivially on a binary line, so all action differences would
lie in that proper subspace. This contradicts generation of the whole plane.

This is the elementary representation argument used for the two local planes
in Aschbacher–Smith, combined manuscript (1 March 2004), proof of 13.8.6(4),
printed p.948. No quotient-group identification is needed for this step.
-/

public section

open Representation Module
namespace Representation.BinaryPlaneRecognition

private theorem binary_line_trivial {K V : Type*} [Group K]
    [AddCommGroup V] [Module (ZMod 2) V]
    (σ : Representation (ZMod 2) K V) (hd : Module.finrank (ZMod 2) V = 1)
    (g : K) (v : V) : σ g v = v := by
  by_cases hv : v = 0
  · simp [hv]
  obtain ⟨c, hc⟩ := (finrank_eq_one_iff_of_nonzero' v hv).mp hd (σ g v)
  have hcne : c ≠ 0 := by
    intro h
    have hh : σ g v = 0 := by simpa [h] using hc.symm
    have hh' := congrArg (σ g⁻¹) hh
    simp only [← Module.End.mul_apply, ← map_mul, inv_mul_cancel, map_one,
      Module.End.one_apply, map_zero] at hh'
    exact hv hh'
  have hc1 : c = 1 := by
    exact (show ∀ c : ZMod 2, c ≠ 0 → c = 1 from by decide) c hcne
  simpa [hc1] using hc.symm

/-- A binary plane generated by its action differences is irreducible.
A proper nonzero subspace would give a trivial one-dimensional quotient. -/
theorem irreducible_of_generating_plane {K V : Type*} [Group K] [AddCommGroup V] [Module (ZMod 2) V]
    (σ : Representation (ZMod 2) K V) (hd : Module.finrank (ZMod 2) V = 2)
    (hgen : Coinvariants.ker σ = ⊤) : σ.IsIrreducible := by
  let := Module.finite_of_finrank_pos (R := ZMod 2) (M := V) (by omega)
  let : Nontrivial V := Module.nontrivial_of_finrank_pos (by omega : 0 < Module.finrank (ZMod 2) V)
  refine { exists_pair_ne := ⟨⊥, ⊤, ?_⟩, eq_bot_or_eq_top := ?_ }
  · intro h
    exact bot_ne_top (congrArg Subrepresentation.toSubmodule h)
  · intro W
    by_cases hW : W = ⊥
    · exact Or.inl hW
    right
    by_contra htop
    have hbot : W.toSubmodule ≠ ⊥ := fun he => hW (Subrepresentation.toSubmodule_injective he)
    have htop' : W.toSubmodule ≠ ⊤ := fun he => htop (Subrepresentation.toSubmodule_injective he)
    have hlo : 0 < Module.finrank (ZMod 2) W.toSubmodule :=
      Nat.pos_of_ne_zero (fun he => hbot (Submodule.finrank_eq_zero.mp he))
    have hup := Submodule.finrank_lt (s := W.toSubmodule) htop'
    have hq := Submodule.finrank_quotient_add_finrank W.toSubmodule
    have hqdim : Module.finrank (ZMod 2) (V ⧸ W.toSubmodule) = 1 := by omega
    have hle : Coinvariants.ker σ ≤ W.toSubmodule := by
      apply Submodule.span_le.mpr
      rintro _ ⟨⟨g,v⟩, rfl⟩
      apply (Submodule.Quotient.mk_eq_zero W.toSubmodule).mp
      have hfix := binary_line_trivial W.quotientRepresentation hqdim g
        (Submodule.Quotient.mk v)
      change Submodule.Quotient.mk (σ g v - v) = 0
      rw [Submodule.Quotient.mk_sub, sub_eq_zero]
      exact hfix
    exact htop' (top_unique (hgen ▸ hle))

end Representation.BinaryPlaneRecognition
