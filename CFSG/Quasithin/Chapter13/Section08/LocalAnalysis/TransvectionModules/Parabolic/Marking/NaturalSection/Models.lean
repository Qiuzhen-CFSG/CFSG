module
public import CFSG.Quasithin.Chapter13.Section08.ComponentSieve.SixAndG2.Cover
public import Theory.Representation.CubicClifford.ActionTransfer

/-!
# The fixed spaces of the two six-letter modules

The augmentation module is commutator-generated. Its natural quotient inherits
this property, and irreducibility removes all fixed vectors from the quotient.
Thus the cover's fixed space is precisely the kernel of the canonical projection.
These are the model calculations for the literal section in 13.7.6(3).

Source: Aschbacher–Smith, combined manuscript of 1 March 2004, §B.3,
printed pp.83–84, and 13.7.6(3), printed pp.938–939.
-/

@[expose] public section
open Module Representation Representation.BinaryOffender BinaryPermutation
namespace CFSG.Quasithin.Chapter13.Section08.TransvectionParabolic.Marking.NaturalSection

/-- Commutator generation descends along a surjective module map. -/
private theorem generated_quotient {A E F : Type*} [Group A]
    [AddCommGroup E] [Module (ZMod 2) E] [AddCommGroup F] [Module (ZMod 2) F]
    (ρ : Representation (ZMod 2) A E) (σ : Representation (ZMod 2) A F)
    (p : E →ₗ[ZMod 2] F) (hp : Function.Surjective p)
    (he : ∀ a v, p (ρ a v) = σ a (p v)) (hg : Coinvariants.ker ρ = ⊤) :
    Coinvariants.ker σ = ⊤ := by
  apply top_unique
  intro v _
  obtain ⟨w, rfl⟩ := hp v
  have h : Coinvariants.ker ρ ≤ (Coinvariants.ker σ).comap p := by
    apply Submodule.span_le.mpr
    rintro _ ⟨⟨a, x⟩, rfl⟩
    change p (ρ a x - x) ∈ Coinvariants.ker σ
    rw [map_sub, he]
    exact Coinvariants.sub_mem_ker a (p x)
  exact h (hg.symm ▸ Submodule.mem_top)

/-- The four-dimensional A₆ module is generated by commutators. -/
theorem natural_generated :
    Coinvariants.ker (alternatingNaturalRepresentation (Fin 6)) = ⊤ :=
  generated_quotient _ _ (coreToNatural (Fin 6)) coreToNatural_surjective
    (fun a v => coreToNatural_equivariant a.val v)
    ComponentSieve.SixAndG2.alternatingSix_core_generated

private theorem commutator_top_eq_coinvariants {A E : Type*} [Group A]
    [AddCommGroup E] [Module (ZMod 2) E] (ρ : Representation (ZMod 2) A E) :
    subspaceCommutator ρ ⊤ ⊤ = Coinvariants.ker ρ := by
  apply congrArg (Submodule.span (ZMod 2))
  ext v
  constructor
  · rintro ⟨a, _, x, _, rfl⟩; exact ⟨⟨a, x⟩, rfl⟩
  · rintro ⟨⟨a, x⟩, rfl⟩; exact ⟨a, trivial, x, trivial, rfl⟩

/-- There are no fixed vectors in the four-dimensional natural module. -/
theorem natural_fixed_eq_bot :
    invariants (alternatingNaturalRepresentation (Fin 6)) = ⊥ := by
  let ρ := alternatingNaturalRepresentation (Fin 6)
  let : IsIrreducible ρ := alternatingNatural_isIrreducible (by decide)
  have h := CubicClifford.invariants_eq_bot_of_commutator_eq_top ρ ⊤ (by
    rw [commutator_top_eq_coinvariants]; exact natural_generated)
  apply le_bot_iff.mp
  intro v hv
  have hh : v ∈ invariants (ρ.comp (⊤ : Subgroup (alternatingGroup (Fin 6))).subtype) :=
    fun a => hv a
  exact h.le hh

/-- In the five-dimensional cover the fixed space is precisely the kernel
of the actual map onto the natural module. -/
theorem core_fixed_eq_kernel :
    invariants (alternatingCoreRepresentation (Fin 6)) =
      LinearMap.ker (coreToNatural (Fin 6)) := by
  ext v
  constructor
  · intro hv
    have hf : coreToNatural (Fin 6) v ∈
        invariants (alternatingNaturalRepresentation (Fin 6)) := by
      intro a
      change naturalRepresentation (Fin 6) a.val (coreToNatural (Fin 6) v) = _
      rw [← coreToNatural_equivariant]
      exact congrArg (coreToNatural (Fin 6)) (hv a)
    exact natural_fixed_eq_bot.le hf
  · intro hv
    exact ComponentSieve.SixAndG2.alternatingSix_coreProjection_isCover.2.1 hv

end CFSG.Quasithin.Chapter13.Section08.TransvectionParabolic.Marking.NaturalSection
