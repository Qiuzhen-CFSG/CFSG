module

public import CFSG.Quasithin.Chapter13.Section08.LocalAnalysis.TransvectionModules.Basic
public import Theory.Representation.BinaryPermutationNaturalStructure
public import Theory.SpecificGroups.SymmetricSix.BinaryFlags
public import Mathlib.FieldTheory.Finiteness
import Mathlib.Tactic

/-!
# The marked A₄ orbit in the natural A₆ module and its cover

In the actual six-letter augmentation module, mark the point e₁₂₃₄ and
the plane generated by it and e₁₂₅₆. All three nonzero plane vectors have
weight four. The subgroup `BinaryFlags.K` is the even permutations fixing
the last two letters; its residual-parabolic description is proved in
`BinaryFlags`. Four explicit orbit vectors span exactly the even-weight
vectors with equal last two coordinates. Kernel-checked finite calculations
verify this spanning identity and its cardinality.

The orbit span has dimension four. Quotienting by the marked point gives
dimension three in the five-dimensional augmentation cover. The actual
projection `coreToNatural` has the constant line as its kernel, and sends
the orbit to a three-dimensional subspace of the natural module. Quotienting
that subspace by the image of the point gives dimension two.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004, §B.3 and
the rank calculation in 13.8.6, printed p.948. These are intrinsic model
calculations. Identifying the literal source orbit and proving the doubling
of dimension in U₂/V₂ remain separate obligations of the source assembly.
-/

@[expose] public section

namespace CFSG.Quasithin.Chapter13.Section08.TransvectionParabolic.OrbitModels

open Module BinaryPermutation
open Theory.SpecificGroups.SymmetricSix.BinaryFlags
open scoped BigOperators

abbrev F := ZMod 2
abbrev Ω := Fin 6
abbrev C := core Ω

private local instance : DecidablePred (fun v : Full Ω => v ∈ core Ω) :=
  fun v => inferInstanceAs (Decidable ((augmentation Ω) v = 0))

private local instance : Fintype C :=
  Fintype.ofFinset (Finset.univ.filter (fun v => v ∈ core Ω)) (by simp)

/-- The source weight-four representative e₁₂₃₄, with zero-based indices. -/
def point : C := ⟨![1,1,1,1,0,0], by decide⟩
/-- A second vector in the marked plane, also of weight four. -/
def seed : C := ⟨![1,1,0,0,1,1], by decide⟩
/-- The fixed vector killed by the natural-module projection. -/
def constant : C := ⟨![1,1,1,1,1,1], by decide⟩

private theorem constant_val : constant.val = allOne Ω := by
  ext i
  fin_cases i <;> rfl

/-- The even-weight vectors whose last two coordinates agree. -/
def coordSpace : Submodule F C where
  carrier := {v | v.val 4 = v.val 5}
  zero_mem' := rfl
  add_mem' hv hw := congrArg₂ (· + ·) hv hw
  smul_mem' c _v hv := congrArg (c * ·) hv

private local instance : DecidablePred (fun v : C => v ∈ coordSpace) :=
  fun v => inferInstanceAs (Decidable (v.val 4 = v.val 5))

private local instance : Fintype coordSpace :=
  Fintype.ofFinset (Finset.univ.filter (fun v => v ∈ coordSpace)) (by simp)

/-- The actual A₄-orbit span of the marked seed in the five-dimensional cover. -/
def orbit : Submodule F C :=
  Submodule.span F {v | ∃ k ∈ K, coreRepresentation Ω k seed = v}

private def gen : Fin 4 → C := ![seed, coreRepresentation Ω cycle012⁻¹ seed,
  coreRepresentation Ω cycle013⁻¹ seed, coreRepresentation Ω cycle012 seed]

private theorem actors_mem :
    cycle012 ∈ K ∧ cycle012⁻¹ ∈ K ∧ cycle013⁻¹ ∈ K := by decide

private theorem gen_mem (i : Fin 4) : gen i ∈ orbit := by
  apply Submodule.subset_span
  fin_cases i
  · exact ⟨1, K.one_mem, rfl⟩
  · exact ⟨_, actors_mem.2.1, rfl⟩
  · exact ⟨_, actors_mem.2.2, rfl⟩
  · exact ⟨_, actors_mem.1, rfl⟩

private theorem decomposition : ∀ v : C, v.val 4 = v.val 5 →
    v = (v.val 1 + v.val 0 + v.val 4) • gen 0 +
      (v.val 2 + v.val 0 + v.val 4) • gen 1 + v.val 3 • gen 2 +
      (v.val 0 + v.val 4) • gen 3 := by decide +kernel

/-- Four explicit even permutations generate the entire coordinate subspace. -/
theorem orbit_eq_coordSpace : orbit = coordSpace := by
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro _ ⟨k, hk, rfl⟩
    have hh := (mem_K.mp (K.inv_mem hk)).1
    change seed.val (k⁻¹ 4) = seed.val (k⁻¹ 5)
    rw [hh.1, hh.2]
    rfl
  · intro v hv
    rw [decomposition v hv]
    exact orbit.add_mem (orbit.add_mem (orbit.add_mem
      (orbit.smul_mem _ (gen_mem 0)) (orbit.smul_mem _ (gen_mem 1)))
      (orbit.smul_mem _ (gen_mem 2))) (orbit.smul_mem _ (gen_mem 3))

private theorem coordSpace_card : Fintype.card coordSpace = 16 := by decide +kernel

/-- The orbit has dimension four before quotienting by the marked point. -/
theorem orbit_finrank : finrank F orbit = 4 := by
  rw [orbit_eq_coordSpace]
  have hc := Module.card_eq_pow_finrank (K := F) (V := coordSpace)
  rw [coordSpace_card, ZMod.card] at hc
  exact Nat.pow_right_injective (by decide : 1 < 2) hc.symm

/-- The marked point in the augmentation cover. -/
def pointSpace : Submodule F C := Submodule.span F {point}

theorem pointSpace_le_orbit : pointSpace ≤ orbit := by
  rw [orbit_eq_coordSpace, pointSpace, Submodule.span_le, Set.singleton_subset_iff]
  rfl

theorem pointSpace_finrank : finrank F pointSpace = 1 :=
  finrank_span_singleton (by decide : point ≠ 0)

private theorem map_finrank {X Y : Type*} [AddCommGroup X] [Module F X]
    [FiniteDimensional F X] [AddCommGroup Y] [Module F Y]
    (f : X →ₗ[F] Y) (P : Submodule F X) (hker : f.ker ≤ P) :
    finrank F (P.map f) + finrank F f.ker = finrank F P := by
  have h := (f.domRestrict P).finrank_range_add_finrank_ker
  rw [LinearMap.range_domRestrict] at h
  change finrank F (P.map f) + finrank F (f.ker.comap P.subtype) = _ at h
  rwa [(Submodule.comapSubtypeEquivOfLe hker).finrank_eq] at h

/-- The orbit span in the literal cover modulo the marked point. -/
def coverOrbit : Submodule F (C ⧸ pointSpace) := orbit.map pointSpace.mkQ

/-- The cover orbit modulo the point has dimension three. -/
theorem coverOrbit_finrank : finrank F coverOrbit = 3 := by
  have h := map_finrank pointSpace.mkQ orbit (by
    rw [Submodule.ker_mkQ]; exact pointSpace_le_orbit)
  rw [Submodule.ker_mkQ, pointSpace_finrank, orbit_finrank] at h
  change finrank F coverOrbit + 1 = 4 at h
  omega

/-- The image of the same weight-four vector in the actual natural module. -/
def naturalPoint : natural Ω := coreToNatural Ω point
/-- The marked point after quotienting the cover by its constant line. -/
def naturalPointSpace : Submodule F (natural Ω) := Submodule.span F {naturalPoint}
/-- The image of the actual orbit under the canonical natural-module projection. -/
def naturalOrbit : Submodule F (natural Ω) := orbit.map (coreToNatural Ω)
/-- The natural orbit modulo its marked point. -/
def naturalQuotientOrbit : Submodule F ((natural Ω) ⧸ naturalPointSpace) :=
  naturalOrbit.map naturalPointSpace.mkQ

/-- The kernel is the actual constant line, with its coordinates retained. -/
theorem natural_kernel : (coreToNatural Ω).ker = Submodule.span F {constant} := by
  ext v
  change coreToNatural Ω v = 0 ↔ _
  rw [← Subtype.val_inj]
  change (constants Ω).mkQ v.val = 0 ↔ _
  rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero, constants, Submodule.mem_span_singleton,
    Submodule.mem_span_singleton]
  constructor
  · rintro ⟨a, ha⟩
    refine ⟨a, Subtype.ext ?_⟩
    change a • constant.val = v.val
    rwa [constant_val]
  · rintro ⟨a, ha⟩
    refine ⟨a, ?_⟩
    have he := congrArg Subtype.val ha
    change a • constant.val = v.val at he
    rwa [constant_val] at he

theorem natural_kernel_le_orbit : (coreToNatural Ω).ker ≤ orbit := by
  rw [natural_kernel, orbit_eq_coordSpace, Submodule.span_le, Set.singleton_subset_iff]
  rfl

theorem naturalOrbit_finrank : finrank F naturalOrbit = 3 := by
  have h := map_finrank (coreToNatural Ω) orbit natural_kernel_le_orbit
  rw [natural_kernel, finrank_span_singleton (by decide : constant ≠ 0), orbit_finrank] at h
  change finrank F naturalOrbit + 1 = 4 at h
  omega

theorem naturalPoint_ne_zero : naturalPoint ≠ 0 := by
  intro h
  have hk : point ∈ (coreToNatural Ω).ker := h
  rw [natural_kernel, Submodule.mem_span_singleton] at hk
  obtain ⟨c, hc⟩ := hk
  have hnot : ∀ c : F, c • constant ≠ point := by decide
  exact hnot c hc

theorem naturalPointSpace_le_orbit : naturalPointSpace ≤ naturalOrbit := by
  rw [naturalPointSpace, Submodule.span_le, Set.singleton_subset_iff]
  exact Submodule.mem_map_of_mem (pointSpace_le_orbit (Submodule.subset_span (by simp)))

/-- The natural-module orbit modulo the point has dimension two. -/
theorem naturalQuotientOrbit_finrank : finrank F naturalQuotientOrbit = 2 := by
  have h := map_finrank naturalPointSpace.mkQ naturalOrbit (by
    rw [Submodule.ker_mkQ]; exact naturalPointSpace_le_orbit)
  rw [Submodule.ker_mkQ,
    show finrank F naturalPointSpace = 1 from finrank_span_singleton naturalPoint_ne_zero,
    naturalOrbit_finrank] at h
  change finrank F naturalQuotientOrbit + 1 = 3 at h
  omega

/-- Hamming weight of an augmentation vector. -/
def weight (v : C) : ℕ := (Finset.univ.filter (fun i => v.val i ≠ 0)).card

theorem point_weight : weight point = 4 := by decide

/-- The marked plane containing the point and the chosen seed. -/
def plane : Submodule F C := Submodule.span F {point, seed}

/-- The marked plane is two-dimensional. -/
theorem plane_finrank : finrank F plane = 2 := by
  have hn : seed ∉ pointSpace := by
    intro h
    obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp h
    have hh : ∀ c : F, c • point ≠ seed := by decide
    exact hh c hc
  have hd := Submodule.finrank_sup_span_singleton hn
  rw [pointSpace_finrank] at hd
  change finrank F (Submodule.span F (insert point ({seed} : Set C))) = 2
  rw [Submodule.span_insert]
  exact hd

/-- The residual parabolic fixes the marked point pointwise. -/
theorem point_fixed (k : S) (hk : k ∈ K) : coreRepresentation Ω k point = point := by
  have hh := (mem_K.mp hk).1
  have hp : ∀ i : Ω, point.val i = if i = 4 ∨ i = 5 then 0 else 1 := by decide
  apply Subtype.ext
  ext i
  change point.val (k.symm i) = point.val i
  simp only [hp, Equiv.symm_apply_eq, hh.1, hh.2]

/-- Every nonzero vector of the marked plane has weight four. -/
theorem plane_weight (v : C) (hv : v ∈ plane) (hne : v ≠ 0) : weight v = 4 := by
  obtain ⟨a, b, hab⟩ := Submodule.mem_span_pair.mp hv
  have hw : ∀ a b : F, a • point + b • seed ≠ 0 → weight (a • point + b • seed) = 4 := by
    decide
  rw [← hab] at hne ⊢
  exact hw a b hne

/-- The computed quotient subspace is generated by the actual quotient orbit. -/
theorem coverOrbit_eq_span : coverOrbit =
    Submodule.span F {v | ∃ k ∈ K, pointSpace.mkQ (coreRepresentation Ω k seed) = v} := by
  rw [coverOrbit, orbit, Submodule.map_span]
  congr 1
  ext v
  simp only [Set.mem_image, Set.mem_ofPred_eq]
  constructor
  · rintro ⟨_, ⟨k, hk, rfl⟩, rfl⟩
    exact ⟨k, hk, rfl⟩
  · rintro ⟨k, hk, rfl⟩
    exact ⟨_, ⟨k, hk, rfl⟩, rfl⟩

/-- The natural quotient calculation respects the canonical equivariant projection. -/
theorem naturalQuotientOrbit_eq_span : naturalQuotientOrbit =
    Submodule.span F {v | ∃ k ∈ K, naturalPointSpace.mkQ
      (naturalRepresentation Ω k (coreToNatural Ω seed)) = v} := by
  rw [naturalQuotientOrbit, naturalOrbit, orbit, Submodule.map_span, Submodule.map_span]
  congr 1
  ext v
  simp only [Set.mem_image, Set.mem_ofPred_eq]
  constructor
  · rintro ⟨_, ⟨_, ⟨k, hk, rfl⟩, rfl⟩, rfl⟩
    exact ⟨k, hk, congrArg naturalPointSpace.mkQ (coreToNatural_equivariant k seed).symm⟩
  · rintro ⟨k, hk, rfl⟩
    exact ⟨_, ⟨_, ⟨k, hk, rfl⟩, rfl⟩,
      congrArg naturalPointSpace.mkQ (coreToNatural_equivariant k seed)⟩

end CFSG.Quasithin.Chapter13.Section08.TransvectionParabolic.OrbitModels
