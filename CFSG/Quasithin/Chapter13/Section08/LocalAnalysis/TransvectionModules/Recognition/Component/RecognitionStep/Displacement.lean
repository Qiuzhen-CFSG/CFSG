module

public import CFSG.Quasithin.Chapter13.Section08.LocalAnalysis.TransvectionModules.Recognition.Action
public import Mathlib.RepresentationTheory.Subrepresentation

/-!
# The displacement-orbit module for G.6.1

For a faithful binary action with trivial two-core, generated by the conjugates
of t, the span of the conjugates of [E,t] is faithful. Its kernel acts trivially
on both this span and the quotient, hence has exponent two and lies in O₂.
If t is a transvection, its restriction is still a transvection, and the
restricted displacement orbit spans the entire restricted module.

This constructs the generation hypothesis of G.6.1 on the appropriate submodule;
it does not identify that submodule with the original source module Ũ_H.
Source: Aschbacher–Smith, combined manuscript of 1 March 2004, G.6.1,
printed p.345, applied in the proof of 13.8.5 on printed p.947.
-/

@[expose] public section

open Subgroup Representation
namespace CFSG.Quasithin.Chapter13.Section08.TransvectionRecognition.Component.RecognitionStep
variable {A E : Type*} [Group A] [AddCommGroup E] [Module (ZMod 2) E]

def displacementOrbit (ρ : Representation (ZMod 2) A E) (t : A) :
    Submodule (ZMod 2) E :=
  Submodule.span (ZMod 2) {w | ∃ a v, w = ρ a (ρ t v - v)}

def displacementRepresentation (ρ : Representation (ZMod 2) A E) (t : A) :
    Subrepresentation ρ where
  toSubmodule := displacementOrbit ρ t
  apply_mem_toSubmodule a v hv := by
    induction hv using Submodule.span_induction with
    | mem v hv =>
      obtain ⟨g, x, rfl⟩ := hv
      exact Submodule.subset_span ⟨a * g, x, by rw [map_mul, Module.End.mul_apply]⟩
    | zero => simp
    | add v w _ _ hv hw => simpa using (displacementOrbit ρ t).add_mem hv hw
    | smul c v _ hv => simpa using (displacementOrbit ρ t).smul_mem c hv

private def quotientKernel (ρ : Representation (ZMod 2) A E) (t : A) : Subgroup A where
  carrier := {a | ∀ v, ρ a v - v ∈ displacementOrbit ρ t}
  one_mem' := by intro v; simp
  mul_mem' := by
    intro a b ha hb v
    have h := (displacementOrbit ρ t).add_mem
      ((displacementRepresentation ρ t).apply_mem_toSubmodule a (hb v)) (ha v)
    simpa only [map_sub, sub_add_sub_cancel, map_mul, Module.End.mul_apply] using h
  inv_mem' := by
    intro a ha v
    have h := (displacementOrbit ρ t).neg_mem (ha (ρ a⁻¹ v))
    simpa only [← Module.End.mul_apply, ← map_mul, mul_inv_cancel, map_one,
      Module.End.one_apply, neg_sub] using h

private instance quotientKernel_normal (ρ : Representation (ZMod 2) A E) (t : A) :
    (quotientKernel ρ t).Normal where
  conj_mem a ha g := by
    intro v
    have h := (displacementRepresentation ρ t).apply_mem_toSubmodule g (ha (ρ g⁻¹ v))
    simpa only [map_sub, ← Module.End.mul_apply, ← map_mul, mul_inv_cancel,
      map_one, Module.End.one_apply, mul_assoc, displacementRepresentation] using h

theorem displacement_mem_of_normalClosure_eq_top
    (ρ : Representation (ZMod 2) A E) (t : A)
    (hgen : normalClosure ({t} : Set A) = ⊤) (a : A) (v : E) :
    ρ a v - v ∈ displacementOrbit ρ t := by
  have hle : normalClosure ({t} : Set A) ≤ quotientKernel ρ t := by
    apply normalClosure_le_normal
    rintro x rfl v
    exact Submodule.subset_span ⟨1, v, by rw [map_one, Module.End.one_apply]⟩
  rw [hgen] at hle
  exact hle (Subgroup.mem_top _) v

theorem displacement_faithful
    (ρ : Representation (ZMod 2) A E) (hρ : Function.Injective ρ) (t : A)
    (hgen : normalClosure ({t} : Set A) = ⊤) (hcore : pCore 2 A = ⊥) :
    Function.Injective (displacementRepresentation ρ t).toRepresentation := by
  let σ := (displacementRepresentation ρ t).toRepresentation
  have hp : IsPGroup 2 σ.ker := by
    intro a
    refine ⟨1, ?_⟩
    apply Subtype.ext
    change (a : A) ^ (2 ^ 1) = 1
    simp only [pow_one]
    apply hρ
    ext v
    have hd := displacement_mem_of_normalClosure_eq_top ρ t hgen a v
    have hf := congrArg (fun f : Module.End (ZMod 2) (displacementOrbit ρ t) =>
      (f ⟨ρ a v - v, hd⟩ : E)) a.property
    change ρ a (ρ a v - v) = ρ a v - v at hf
    simp only [map_sub] at hf
    have he : ρ a (ρ a v) - v = 0 := by
      calc
        ρ a (ρ a v) - v = (ρ a (ρ a v) - ρ a v) + (ρ a v - v) := by abel
        _ = 0 := by rw [hf, ZModModule.add_self]
    simpa only [pow_two, map_mul, Module.End.mul_apply, map_one,
      Module.End.one_apply] using sub_eq_zero.mp he
  have hk : σ.ker ≤ pCore 2 A := le_sSup ⟨inferInstance, hp⟩
  apply σ.ker_eq_bot_iff.mp
  exact le_bot_iff.mp (hcore ▸ hk)

open CFSG.Quasithin.Chapter13.Section08.TransvectionRecognition

private theorem center_mem (ρ : Representation (ZMod 2) A E) (t : A)
    (f : Module.Dual (ZMod 2) E) (v : E) (hf : f ≠ 0)
    (he : ∀ w, ρ t w = w + f w • v) : v ∈ displacementOrbit ρ t := by
  obtain ⟨w, hw⟩ : ∃ w, f w ≠ 0 := by
    by_contra! h
    apply hf
    ext w
    exact h w
  have hw1 : f w = 1 := by
    have hbin : ∀ c : ZMod 2, c = 0 ∨ c = 1 := by decide
    exact (hbin (f w)).resolve_left hw
  exact Submodule.subset_span ⟨1, w, by simp [he, hw1]⟩

theorem displacement_isTransvection
    (ρ : Representation (ZMod 2) A E) (t : A)
    (hf : Function.Injective (displacementRepresentation ρ t).toRepresentation)
    (ht : IsTransvection ρ t) :
    IsTransvection (displacementRepresentation ρ t).toRepresentation t := by
  have htne := ht.ne_one
  obtain ⟨f, v, hfne, hvne, hfv, he⟩ := ht
  let S := displacementOrbit ρ t
  let σ : Representation (ZMod 2) A S := (displacementRepresentation ρ t).toRepresentation
  let fS : Module.Dual (ZMod 2) S := f.comp S.subtype
  let vS : S := ⟨v, center_mem ρ t f v hfne he⟩
  have hact (w : S) : σ t w = w + fS w • vS := by
    apply Subtype.ext
    exact he w
  refine ⟨fS, vS, ?_, ?_, hfv, hact⟩
  · intro hz
    apply htne
    change Function.Injective σ at hf
    apply hf
    apply LinearMap.ext
    intro w
    have hw : fS w = 0 := by rw [hz]; rfl
    calc
      σ t w = w + fS w • vS := hact w
      _ = σ 1 w := by rw [hw]; simp
  · intro hz
    exact hvne (congrArg Subtype.val hz)

theorem restricted_displacement_orbit_spans
    (ρ : Representation (ZMod 2) A E) (t : A)
    (hf : Function.Injective (displacementRepresentation ρ t).toRepresentation)
    (ht : IsTransvection ρ t) :
    displacementOrbit (displacementRepresentation ρ t).toRepresentation t = ⊤ := by
  obtain ⟨f, v, hfne, hvne, hfv, he⟩ := ht
  let S := displacementOrbit ρ t
  let σ : Representation (ZMod 2) A S := (displacementRepresentation ρ t).toRepresentation
  let fS : Module.Dual (ZMod 2) S := f.comp S.subtype
  let vS : S := ⟨v, center_mem ρ t f v hfne he⟩
  have hact (w : S) : σ t w = w + fS w • vS := by
    apply Subtype.ext
    exact he w
  have hfS : fS ≠ 0 := by
    intro hz
    have ht1 : t = 1 := by
      change Function.Injective σ at hf
      apply hf
      apply LinearMap.ext
      intro w
      have hw : fS w = 0 := by rw [hz]; rfl
      calc
        σ t w = w + fS w • vS := hact w
        _ = σ 1 w := by rw [hw]; simp
    exact (IsTransvection.ne_one ⟨f, v, hfne, hvne, hfv, he⟩) ht1
  have hvS : vS ∈ displacementOrbit σ t := center_mem σ t fS vS hfS hact
  have hle : S ≤ (displacementOrbit σ t).map S.subtype := by
    apply Submodule.span_le.mpr
    rintro x ⟨a, w, rfl⟩
    refine ⟨f w • σ a vS, (displacementOrbit σ t).smul_mem _
      ((displacementRepresentation σ t).apply_mem_toSubmodule a hvS), ?_⟩
    change f w • ρ a v = ρ a (ρ t w - w)
    rw [he, add_sub_cancel_left, map_smul]
  apply top_unique
  intro x _
  obtain ⟨y, hy, he⟩ := hle x.property
  have hyx : y = x := Subtype.ext he
  exact hyx ▸ hy


end CFSG.Quasithin.Chapter13.Section08.TransvectionRecognition.Component.RecognitionStep

end
