module

public import CFSG.Quasithin.Chapter13.Section08.LocalAnalysis.TransvectionModules.Recognition.Component.RecognitionStep.Models
public import Mathlib.RepresentationTheory.Irreducible
public import Mathlib.GroupTheory.IsPerfect

/-!
# Transport of intrinsic component sections

Surjective equivariant maps carry displacement spans onto displacement spans.
When the original space is generated by displacements and the kernel is exactly
the fixed space, the first isomorphism theorem identifies the literal central
section. Pulling a simple perfect normal subgroup back through the actual actor
equivalence preserves both its group structure and this quotient action.

These are the transport steps in the intrinsic model calculation for
Aschbacher–Smith G.6.4(2), printed pp.345–346, applied in 13.8.5, p.947.
-/

@[expose] public section

open Subgroup Representation Representation.BinaryOffender
namespace CFSG.Quasithin.Chapter13.Section08.TransvectionRecognition.Component.RecognitionStep.ModelComponents
variable {A E B F H U : Type*} [Group A] [AddCommGroup E] [Module (ZMod 2) E]
  [Group B] [AddCommGroup F] [Module (ZMod 2) F]
  [Group H] [AddCommGroup U] [Module (ZMod 2) U]

theorem commutator_map (ρ : Representation (ZMod 2) A E)
    (σ : Representation (ZMod 2) B F) (C : Subgroup A) (D : Subgroup B)
    (eC : C ≃* D) (f : E →ₗ[ZMod 2] F) (hf : Function.Surjective f)
    (he : ∀ (c : C) v, f (ρ c v) = σ (eC c) (f v)) :
    (subspaceCommutator ρ ⊤ C).map f = subspaceCommutator σ ⊤ D := by
  apply le_antisymm
  · apply Submodule.map_le_iff_le_comap.mpr
    apply Submodule.span_le.mpr
    rintro _ ⟨c, hc, v, _, rfl⟩
    change f (ρ c v - v) ∈ subspaceCommutator σ ⊤ D
    rw [map_sub, he ⟨c, hc⟩]
    exact Submodule.subset_span ⟨eC ⟨c,hc⟩, (eC ⟨c,hc⟩).property,
      f v, Submodule.mem_top, rfl⟩
  · apply Submodule.span_le.mpr
    rintro _ ⟨d, hd, v, _, rfl⟩
    obtain ⟨c, hc⟩ := eC.surjective ⟨d, hd⟩
    obtain ⟨w, rfl⟩ := hf v
    refine ⟨ρ c w - w, Submodule.subset_span ⟨c, c.property, w, Submodule.mem_top, rfl⟩, ?_⟩
    rw [map_sub, he, hc]

theorem section_of_surjective (ρ : Representation (ZMod 2) A E) (C : Subgroup A)
    (σ : Representation (ZMod 2) B F) (eC : C ≃* B)
    (f : E →ₗ[ZMod 2] F) (hf : Function.Surjective f)
    (hgen : subspaceCommutator ρ ⊤ C = ⊤) (hker : f.ker = fixedSpace ρ C)
    (he : ∀ (c : C) v, f (ρ c v) = σ (eC c) (f v)) :
    HasCentralSectionModel ρ C σ eC := by
  let I := subspaceCommutator ρ ⊤ C
  let q := f.comp I.subtype
  have hq : Function.Surjective q := by
    intro v
    obtain ⟨w, hw⟩ := hf v
    exact ⟨⟨w, hgen.ge Submodule.mem_top⟩, hw⟩
  have hk : (fixedSpace ρ C).comap I.subtype = q.ker := by
    rw [← hker, LinearMap.ker_comp]
  let e := (Submodule.quotEquivOfEq _ _ hk).trans (q.quotKerEquivOfSurjective hq)
  refine ⟨fun _ _ => hgen.ge Submodule.mem_top, e, ?_⟩
  intro c v
  simpa only [e, LinearEquiv.trans_apply, Submodule.quotEquivOfEq_mk,
    LinearMap.quotKerEquivOfSurjective_apply_mk, q, LinearMap.comp_apply,
    Submodule.subtype_apply] using he c v

/-- The component subgroup pulled back along the actual actor equivalence. -/
def pullbackEquiv (e : A ≃* B) (D : Subgroup B) : D.comap e.toMonoidHom ≃* D where
  toFun a := ⟨e a, a.property⟩
  invFun b := ⟨e.symm b, by change e (e.symm b) ∈ D; rw [e.apply_symm_apply]; exact b.property⟩
  left_inv a := Subtype.ext (e.symm_apply_apply a)
  right_inv b := Subtype.ext (e.apply_symm_apply b)
  map_mul' _ _ := Subtype.ext (e.map_mul _ _)

theorem pullback_generated (ρ : Representation (ZMod 2) A E)
    (σ : Representation (ZMod 2) B F) (eA : A ≃* B) (eE : E ≃ₗ[ZMod 2] F)
    (he : ∀ a v, eE (ρ a v) = σ (eA a) (eE v)) (D : Subgroup B)
    (hgen : subspaceCommutator σ ⊤ D = ⊤) :
    subspaceCommutator ρ ⊤ (D.comap eA.toMonoidHom) = ⊤ := by
  have hm := commutator_map ρ σ _ D (pullbackEquiv eA D) eE.toLinearMap
    eE.surjective (fun c v => he c v)
  rw [hgen] at hm
  apply top_unique
  intro v _
  obtain ⟨w, hw, hwv⟩ := hm.symm ▸ (show eE v ∈ (⊤ : Submodule (ZMod 2) F) from Submodule.mem_top)
  exact eE.injective hwv ▸ hw

theorem pullback_fixed (ρ : Representation (ZMod 2) A E)
    (σ : Representation (ZMod 2) B F) (eA : A ≃* B) (eE : E ≃ₗ[ZMod 2] F)
    (he : ∀ a v, eE (ρ a v) = σ (eA a) (eE v)) (D : Subgroup B) :
    fixedSpace ρ (D.comap eA.toMonoidHom) = (fixedSpace σ D).comap eE.toLinearMap := by
  ext v
  change (∀ c : D.comap eA.toMonoidHom, ρ c v = v) ↔
    (∀ d : D, σ d (eE v) = eE v)
  constructor
  · intro hv d
    have h := congrArg eE (hv ((pullbackEquiv eA D).symm d))
    change eE (ρ (eA.symm d) v) = eE v at h
    rw [he, eA.apply_symm_apply] at h
    exact h
  · intro hv c
    apply eE.injective
    rw [he]
    exact hv (pullbackEquiv eA D c)

theorem irreducible_fixed_eq_bot (ρ : Representation (ZMod 2) A E) (C : Subgroup A)
    [IsIrreducible (ρ.comp C.subtype)]
    (hgen : subspaceCommutator ρ ⊤ C = ⊤) : fixedSpace ρ C = ⊥ := by
  let S : Subrepresentation (ρ.comp C.subtype) :=
    ⟨fixedSpace ρ C, fun g v hv => by simpa only [hv g] using hv⟩
  rcases eq_bot_or_eq_top S with h | h
  · exact congrArg Subrepresentation.toSubmodule h
  · have hfix : fixedSpace ρ C = ⊤ := congrArg Subrepresentation.toSubmodule h
    have hz := (subspaceCommutator_eq_bot_iff ρ ⊤ C).mpr hfix.ge
    have he : (⊤ : Submodule (ZMod 2) E) = ⊥ := hgen.symm.trans hz
    have hs : (⊤ : Subrepresentation (ρ.comp C.subtype)) = ⊥ :=
      Subrepresentation.toSubmodule_injective he
    exact (top_ne_bot hs).elim
end CFSG.Quasithin.Chapter13.Section08.TransvectionRecognition.Component.RecognitionStep.ModelComponents

namespace CFSG.Quasithin.Chapter13.Section08.TransvectionRecognition.Component.RecognitionStep.ModelComponents
open Subgroup Representation Representation.BinaryOffender
open scoped IsMulCommutative
variable {A E B F H U : Type*} [Group A] [AddCommGroup E] [Module (ZMod 2) E]
  [Group B] [AddCommGroup F] [Module (ZMod 2) F]
  [Group H] [AddCommGroup U] [Module (ZMod 2) U]

/-- Pull a concrete simple normal component and its quotient map back to the original action. -/
theorem component_of_model (ρ : Representation (ZMod 2) A E)
    (σ : Representation (ZMod 2) B F) (τ : Representation (ZMod 2) H U)
    (hm : HasActionModel ρ σ) (D : Subgroup B)
    [D.Normal] [IsSimpleGroup D] [Group.IsPerfect D]
    (eD : D ≃* H) (f : F →ₗ[ZMod 2] U) (hf : Function.Surjective f)
    (hgen : subspaceCommutator σ ⊤ D = ⊤) (hker : f.ker = fixedSpace σ D)
    (he : ∀ (d : D) v, f (σ d v) = τ (eD d) (f v)) :
    ∃ C : Subgroup A, C.Normal ∧ IsSimpleGroup C ∧ Group.IsPerfect C ∧
      ¬ IsMulCommutative C ∧ ∃ eC : C ≃* H, HasCentralSectionModel ρ C τ eC := by
  obtain ⟨eA, eE, hact⟩ := hm
  let C := D.comap eA.toMonoidHom
  let e := pullbackEquiv eA D
  let : C.Normal := (inferInstance : D.Normal).comap eA.toMonoidHom
  let : IsSimpleGroup C := e.isSimpleGroup
  let : Group.IsPerfect C := Group.IsPerfect.ofSurjective (f := e.symm.toMonoidHom) e.symm.surjective
  refine ⟨C, inferInstance, inferInstance, inferInstance,
    Group.IsPerfect.not_isMulCommutative C, e.trans eD, ?_⟩
  apply section_of_surjective ρ C τ (e.trans eD) (f.comp eE.toLinearMap)
    (hf.comp eE.surjective) (pullback_generated ρ σ eA eE hact D hgen)
  · rw [LinearMap.ker_comp, hker]
    exact (pullback_fixed ρ σ eA eE hact D).symm
  · intro c v
    change f (eE (ρ c v)) = τ (eD (e c)) (f (eE v))
    rw [hact]
    exact he (e c) (eE v)

end CFSG.Quasithin.Chapter13.Section08.TransvectionRecognition.Component.RecognitionStep.ModelComponents

end
