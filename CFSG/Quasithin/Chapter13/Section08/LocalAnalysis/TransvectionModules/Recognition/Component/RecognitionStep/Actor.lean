module

public import CFSG.Quasithin.Chapter13.Section08.LocalAnalysis.TransvectionModules.Recognition.Component.Selection
public import CFSG.Quasithin.Defs
public import Theory.GroupTheory.SolvableRadical.Transport

/-!
# A subnormal actor generated by the transvection

A minimal subnormal overgroup of t in its nonsolvable normal closure is itself
nonsolvable and generated by its own t-conjugates. Solvability would put t in the
ambient solvable radical. Subnormality preserves the trivial two-core.

For the source H*, every subgroup has an explicit SQTK cover: its inverse image
in H, itself a subgroup of the actual two-local G₁. No identification of a
component or of its natural module is assumed or concluded by this reduction.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004, G.6.1–4,
printed pp.345–346, and the component branch of 13.8.5, printed p.947.
-/

@[expose] public section

open Subgroup
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter13.Section08.TransvectionRecognition.Component.RecognitionStep

/-- A minimal subnormal overgroup of t is generated by its own t-conjugates. -/
theorem exists_self_generated_subnormal {A : Type*} [Group A] [Finite A] (t : A)
    (hns : ¬ Group.IsSolvable (normalClosure ({t} : Set A))) :
    ∃ J : Subgroup A, ∃ htJ : t ∈ J,
      J.IsSubnormal ∧ J ≤ normalClosure ({t} : Set A) ∧
      ¬ Group.IsSolvable J ∧ normalClosure ({⟨t, htJ⟩} : Set J) = ⊤ := by
  let N := normalClosure ({t} : Set A)
  obtain ⟨J, ⟨hJsub, hJN, htJ⟩, hmin⟩ := exists_minimal_of_wellFoundedLT
    (fun J : Subgroup A => J.IsSubnormal ∧ J ≤ N ∧ t ∈ J)
    ⟨N, (inferInstance : N.Normal).isSubnormal, le_rfl,
      subset_normalClosure (Set.mem_singleton t)⟩
  have hsol : ¬ Group.IsSolvable J := by
    intro hs
    let := hs
    have htR : t ∈ solvableRadical A := by
      apply map_solvableRadical_subtype_le_of_isSubnormal hJsub
      refine ⟨⟨t, htJ⟩, ?_, rfl⟩
      exact le_solvableRadical ⊤ inferInstance inferInstance (Subgroup.mem_top _)
    have hNR : N ≤ solvableRadical A := normalClosure_le_normal
      (Set.singleton_subset_iff.mpr htR)
    exact hns (Group.isSolvable_of_isSolvable_injective
      (f := inclusion hNR) (inclusion_injective hNR))
  refine ⟨J, htJ, hJsub, hJN, hsol, ?_⟩
  let C := normalClosure ({⟨t, htJ⟩} : Set J)
  have hCJ : C.map J.subtype ≤ J := map_subtype_le C
  have hCsub : (C.map J.subtype).IsSubnormal :=
    (inferInstance : C.Normal).isSubnormal.trans' hJsub
  have htC : t ∈ C.map J.subtype :=
    ⟨⟨t, htJ⟩, subset_normalClosure (Set.mem_singleton _), rfl⟩
  have hJC : J ≤ C.map J.subtype := hmin ⟨hCsub, hCJ.trans hJN, htC⟩ hCJ
  apply top_unique
  intro j _
  obtain ⟨c, hc, he⟩ := hJC j.property
  have he' : c = j := Subtype.ext he
  exact he' ▸ hc

/-- In a group generated by conjugates of t, each nonabelian simple normal subgroup equals its t-commutator. -/
theorem simple_normal_self_commutator {A : Type*} [Group A] (C : Subgroup A) [C.Normal] [IsSimpleGroup C]
    (hnc : ¬ IsMulCommutative C) (t : A)
    (hgen : normalClosure ({t} : Set A) = ⊤) : ⁅C, zpowers t⁆ = C := by
  have hn : zpowers t ≤ normalizer (C : Set A) := by rw [normalizer_eq_top]; exact le_top
  have hle : ⁅C, zpowers t⁆ ≤ C := le_normalizer_iff_commutator_le_left.mp hn
  let D := ⁅C, zpowers t⁆.subgroupOf C
  let : D.Normal := normal_subgroupOf_of_le_normalizer
    (normalizer_commutator_ge_left C (zpowers t))
  rcases (inferInstance : D.Normal).eq_bot_or_eq_top with hb | ht
  · have hbot : ⁅C, zpowers t⁆ = ⊥ := by
      have he := congrArg (map C.subtype) hb
      simpa only [D, map_subgroupOf_eq_of_le hle, Subgroup.map_bot] using he
    have htC : t ∈ centralizer (C : Set A) :=
      (le_centralizer_iff.mp (commutator_eq_bot_iff_le_centralizer.mp hbot)) (mem_zpowers t)
    have hall : (⊤ : Subgroup A) ≤ centralizer (C : Set A) := by
      rw [← hgen]
      exact normalClosure_le_normal (Set.singleton_subset_iff.mpr htC)
    exact (hnc (le_centralizer_iff_isMulCommutative.mp (le_top.trans hall))).elim
  · have he := congrArg (map C.subtype) ht
    simpa only [D, map_subgroupOf_eq_of_le hle, ← MonoidHom.range_eq_map,
      range_subtype] using he

/-- A subnormal subgroup of a group with trivial p-core has trivial p-core. -/
theorem subnormal_pCore_eq_bot {A : Type*} [Group A] [Finite A]
    (p : ℕ) (hcore : pCore p A = ⊥) {J : Subgroup A} (hJ : J.IsSubnormal) :
    pCore p J = ⊥ := by
  rw [pCore_subnormal_eq_comap p hJ, hcore]
  exact J.subtype.ker_eq_bot_iff.mpr J.subtype_injective

universe u
variable {G : Type u} [Group G] [Finite G]

/-- The inverse image in H is an explicit SQTK group surjecting onto J ≤ H*. -/
theorem star_subgroup_sqtk_cover {κ : GroupClass.{u}} (hG : IsSimpleQTKE κ G)
    (H L₁ T G₁ M Z : Subgroup G) (hH : H ∈ Source.Hz L₁ T G₁ M)
    (hZ : Z ≠ ⊥) (hpZ : IsPGroup 2 Z) (hG₁ : G₁ = normalizer (Z : Set G))
    (J : Subgroup (Source.Hstar H)) :
    IsSQTK κ (J.comap (QuotientGroup.mk' (pCore 2 H))) ∧
      Function.Surjective ((QuotientGroup.mk' (pCore 2 H)).subgroupComap J) := by
  have hs₁ : IsSQTK κ G₁ := hG.twoLocal_sqtk ⟨Z, hZ, hpZ, hG₁⟩
  have hsH : IsSQTK κ H := (IsSQTK.equiv (subgroupOfEquivOfLe hH.2.1)).mp
    (hs₁.subgroup (H.subgroupOf G₁))
  exact ⟨hsH.subgroup _, (QuotientGroup.mk' (pCore 2 H)).subgroupComap_surjective_of_surjective
    J (QuotientGroup.mk'_surjective _)⟩

end CFSG.Quasithin.Chapter13.Section08.TransvectionRecognition.Component.RecognitionStep

end
