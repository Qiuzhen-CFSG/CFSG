module

public import CFSG.Quasithin.Chapter13.Section08.LocalAnalysis.TransvectionModules.Recognition.Component.RecognitionStep.Models
public import CFSG.Quasithin.Chapter13.Section08.LocalAnalysis.TransvectionModules.Recognition.Component.RecognitionStep.ModelComponents.Common
public import Theory.Representation.BinaryPermutationNaturalStructure
public import Theory.Representation.BinaryOffender.IrreducibleMovedGeneration

/-!
# Alternating commutators on the permutation models

For every degree at least five, alternating commutators generate the entire
augmentation core. An explicit three-cycle produces a nonconstant displacement;
the invariant-submodule theorem then gives the whole core. The actual core
projection transfers generation to the natural module. Irreducibility shows
that the natural module has no fixed vectors, and consequently the kernel of
`coreToNatural` is exactly the core's alternating fixed space.

This includes both permutation-core alternatives of Aschbacher–Smith G.6.4(2c),
printed pp.345–346, and the section used in 13.8.5, p.947.
-/

@[expose] public section

namespace CFSG.Quasithin.Chapter13.Section08.TransvectionRecognition.Component.RecognitionStep.ModelComponents
open Subgroup Representation Representation.BinaryOffender BinaryPermutation Equiv

/-- Alternating commutators generate the entire augmentation core. -/
theorem core_generated (n : ℕ) (hn : 5 ≤ n) :
    subspaceCommutator (coreRepresentation (Fin n)) ⊤ (alternatingGroup (Fin n)) = ⊤ := by
  let ρ := coreRepresentation (Fin n)
  let C := subspaceCommutator ρ ⊤ (alternatingGroup (Fin n))
  let D := C.map (core (Fin n)).subtype
  have hD : ∀ g : alternatingGroup (Fin n), ∀ v ∈ D,
      representation (Fin n) g.val v ∈ D := by
    intro g v hv
    obtain ⟨u, hu, rfl⟩ := hv
    refine ⟨ρ g u, ?_, rfl⟩
    exact (subspaceCommutator_invariant ρ ⊤ (alternatingGroup (Fin n)) g.property u).2 hu
  rcases invariant_le_constants_or_core_le (by simpa using hn) D hD with h | h
  · let a : Fin n := ⟨0, by omega⟩
    let b : Fin n := ⟨1, by omega⟩
    let c : Fin n := ⟨2, by omega⟩
    let d : Fin n := ⟨3, by omega⟩
    let e : Fin n := ⟨4, by omega⟩
    have hab : a ≠ b := by simp [a, b, Fin.ext_iff]
    have hbc : b ≠ c := by simp [b, c, Fin.ext_iff]
    let g : alternatingGroup (Fin n) := ⟨swap a b * swap b c, by
      simp [Perm.mem_alternatingGroup, Perm.sign_swap hab, Perm.sign_swap hbc]⟩
    let v : core (Fin n) := ⟨Pi.single a 1 + Pi.single d 1, by
      simp [mem_core, Finset.sum_add_distrib, CharTwo.add_self_eq_zero]⟩
    have hv : ρ g v - v ∈ C :=
      Submodule.subset_span ⟨g, g.property, v, Submodule.mem_top, rfl⟩
    obtain ⟨k, hk⟩ := Submodule.mem_span_singleton.mp (h ⟨ρ g v - v, hv, rfl⟩)
    have hconst : (ρ g v - v).val a = (ρ g v - v).val e :=
      (congrFun hk.symm a).trans (congrFun hk e)
    have hbad : (ρ g v - v).val a ≠ (ρ g v - v).val e := by
      simp [ρ, g, v, Perm.mul_def, swap_apply_def,
        a, b, c, d, e, Fin.ext_iff]
    exact (hbad hconst).elim
  · apply top_unique
    intro v _
    obtain ⟨u, hu, he⟩ := h v.property
    exact (Subtype.ext he : u = v) ▸ hu

/-- The natural section is also generated by alternating commutators. -/
theorem natural_generated (n : ℕ) (hn : 5 ≤ n) :
    subspaceCommutator (naturalRepresentation (Fin n)) ⊤ (alternatingGroup (Fin n)) = ⊤ := by
  have h := commutator_map (coreRepresentation (Fin n)) (naturalRepresentation (Fin n))
    (alternatingGroup (Fin n)) (alternatingGroup (Fin n)) (MulEquiv.refl _)
    (coreToNatural (Fin n)) coreToNatural_surjective
    (fun g v => coreToNatural_equivariant g.val v)
  rw [core_generated n hn, Submodule.map_top, LinearMap.range_eq_top.mpr coreToNatural_surjective] at h
  exact h.symm

/-- The alternating natural module has no fixed vectors. -/
theorem natural_fixed (n : ℕ) (hn : 5 ≤ n) :
    fixedSpace (naturalRepresentation (Fin n)) (alternatingGroup (Fin n)) = ⊥ := by
  let : IsIrreducible (alternatingNaturalRepresentation (Fin n)) :=
    alternatingNatural_isIrreducible (by simpa using hn)
  exact irreducible_fixed_eq_bot _ _ (natural_generated n hn)

/-- The kernel of the actual core projection is exactly its fixed-vector space. -/
theorem core_projection_kernel (n : ℕ) (hn : 5 ≤ n) :
    (coreToNatural (Fin n)).ker =
      fixedSpace (coreRepresentation (Fin n)) (alternatingGroup (Fin n)) := by
  apply le_antisymm
  · intro v hv g
    have hv' : v.val ∈ constants (Fin n) := by
      apply (Submodule.Quotient.mk_eq_zero _).mp
      exact congrArg Subtype.val hv
    obtain ⟨k, hk⟩ := Submodule.mem_span_singleton.mp hv'
    apply Subtype.ext
    change representation (Fin n) g.val v.val = v.val
    rw [← hk, map_smul, permute_allOne]
  · intro v hv
    have hf : coreToNatural (Fin n) v ∈
        fixedSpace (naturalRepresentation (Fin n)) (alternatingGroup (Fin n)) := by
      intro g
      change naturalRepresentation (Fin n) g.val (coreToNatural (Fin n) v) = _
      rw [← coreToNatural_equivariant]
      exact congrArg (coreToNatural (Fin n)) (hv g)
    change coreToNatural (Fin n) v = 0
    simpa only [natural_fixed n hn, Submodule.mem_bot] using hf
end CFSG.Quasithin.Chapter13.Section08.TransvectionRecognition.Component.RecognitionStep.ModelComponents

end
