/-!
# The component-section step in transvection recognition

Starting with the literal nonsolvable normal closure of t in H*, we construct
a nonsolvable subnormal J generated by its own t-conjugates. Its two-core is
trivial. On the span of the J-conjugates of the displacement, its actual action
is faithful, t remains a transvection, and the displacement orbit spans.
The inverse image of J in H supplies the SQTK quotient provenance from the
genuine two-local G₁. Thus the hypotheses of G.6.1 are constructed on a precise
actor and submodule, without identifying that submodule with all of Ũ_H.

The perfect-component commutator space is unchanged under this restriction.
A simple normal component of J lifts with its full t-commutator identity, and
a model of its section in H* transfers through the canonical component-star
equivalence to the literal Ũ_K/C_{Ũ_K}(K).

The universal earlier theorem G.6.4 and the source centralizer identity are
explicit inputs. Its application witnesses and the intrinsic model components
are constructed here. The resulting relative C-component is normalized by the
original transvection, has nontrivial full self-commutator, and has an actual
natural section with the source parameter bounds. This proves the component-
section step; the later application of 13.7.6 belongs to the parent assembly.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004, G.6.1–4,
printed pp.345–346, and 13.8.5, printed pp.947–948.
-/

@[expose] public section

open Subgroup Representation
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter13.Section08.TransvectionRecognition.Component.RecognitionStep

universe u
variable {G : Type u} [Group G] [Finite G]

/-- All G.6.1 application hypotheses on a nonsolvable subnormal actor and its
displacement module, including the explicit SQTK covering group. The earlier
source centralizer bound is used to prove faithfulness, not assumed as an
arbitrary property of the restricted representation. -/
theorem exists_source_recognition_actor {κ : GroupClass.{u}} (hG : IsSimpleQTKE κ G)
    (H L₁ T G₁ M Z V₃ V₁ : Subgroup G)
    (hH : H ∈ Source.Hz L₁ T G₁ M)
    (hZ : Z ≠ ⊥) (hpZ : IsPGroup 2 Z) (hG₁ : G₁ = normalizer (Z : Set G))
    [(V₁.subgroupOf (Source.UH H V₃)).Normal]
    [IsElementaryAbelian 2 (Source.Utilde H V₃ V₁)]
    (ρ : Representation (ZMod 2) (Source.Hstar H) (Additive (Source.Utilde H V₃ V₁)))
    (hρ : IsConjugation H V₃ V₁ ρ)
    (hc : commutatorPreimage H (Source.UH H V₃) V₁ ≤ Source.QH H)
    (t : Source.Hstar H) (ht : IsTransvection ρ t)
    (hns : ¬ Group.IsSolvable (normalClosure ({t} : Set (Source.Hstar H)))) :
    ∃ (J : Subgroup (Source.Hstar H)) (htJ : t ∈ J),
      J.IsSubnormal ∧ J ≤ normalClosure ({t} : Set (Source.Hstar H)) ∧
      ¬ Group.IsSolvable J ∧ pCore 2 J = ⊥ ∧
      normalClosure ({⟨t, htJ⟩} : Set J) = ⊤ ∧
      IsSQTK κ (J.comap (QuotientGroup.mk' (pCore 2 H))) ∧
      Function.Surjective ((QuotientGroup.mk' (pCore 2 H)).subgroupComap J) ∧
      let σ := (displacementRepresentation (ρ.comp J.subtype) ⟨t, htJ⟩).toRepresentation
      Function.Injective σ ∧ IsTransvection σ ⟨t, htJ⟩ ∧
      (⟨t, htJ⟩ : J) ^ 2 = 1 ∧ (⟨t, htJ⟩ : J) ≠ 1 ∧
      Module.finrank (ZMod 2) (LinearMap.range (σ ⟨t, htJ⟩ - LinearMap.id)) = 1 ∧
      displacementOrbit σ ⟨t, htJ⟩ = ⊤ := by
  obtain ⟨J, htJ, hJ, hJN, hJns, hgen⟩ := exists_self_generated_subnormal t hns
  have hcore : pCore 2 J = ⊥ :=
    subnormal_pCore_eq_bot 2 (pCore_quotient_pCore_eq_bot 2) hJ
  have hf : Function.Injective (ρ.comp J.subtype) :=
    (faithful_of_centralizer_le_core ρ hρ hc).comp J.subtype_injective
  have ht' : IsTransvection (ρ.comp J.subtype) (⟨t, htJ⟩ : J) := ht
  have hs := displacement_faithful (ρ.comp J.subtype) hf ⟨t, htJ⟩ hgen hcore
  have hst := displacement_isTransvection (ρ.comp J.subtype) ⟨t, htJ⟩ hs ht'
  obtain ⟨hcover, hsurj⟩ := star_subgroup_sqtk_cover hG H L₁ T G₁ M Z hH hZ hpZ hG₁ J
  exact ⟨J, htJ, hJ, hJN, hJns, hcore, hgen, hcover, hsurj, hs, hst,
    transvection_square hs hst, hst.ne_one, transvection_displacement_rank hst,
    restricted_displacement_orbit_spans (ρ.comp J.subtype) ⟨t, htJ⟩ hs ht'⟩

/-- The component-section conclusion of the nonsolvable closure branch of
13.8.5. Only the earlier universal G.6.4 and the earlier source centralizer
bound remain inputs; every component, actor and module witness is constructed.
No conjugation of the given transvection is necessary. -/
theorem exists_component_natural_section {κ : GroupClass.{u}} (hG : IsSimpleQTKE κ G)
    (hG64 : G64SourceTheorem κ)
    (H L₁ T G₁ M Z V₃ V₁ : Subgroup G)
    (hH : H ∈ Source.Hz L₁ T G₁ M)
    (hZ : Z ≠ ⊥) (hpZ : IsPGroup 2 Z) (hG₁ : G₁ = normalizer (Z : Set G))
    [(V₁.subgroupOf (Source.UH H V₃)).Normal]
    [IsElementaryAbelian 2 (Source.Utilde H V₃ V₁)]
    (ρ : Representation (ZMod 2) (Source.Hstar H) (Additive (Source.Utilde H V₃ V₁)))
    (hρ : IsConjugation H V₃ V₁ ρ)
    (hc : commutatorPreimage H (Source.UH H V₃) V₁ ≤ Source.QH H)
    (t : Source.Hstar H) (ht : IsTransvection ρ t)
    (hns : ¬ Group.IsSolvable (normalClosure ({t} : Set (Source.Hstar H)))) :
    ∃ (K : Subgroup G) (hKH : K ≤ H) (hK : (K.subgroupOf H).IsCComponent),
      Source.starImage H K ≤ normalClosure ({t} : Set (Source.Hstar H)) ∧
      zpowers t ≤ normalizer (Source.starImage H K : Set (Source.Hstar H)) ∧
      ⁅Source.starImage H K, zpowers t⁆ = Source.starImage H K ∧
      Source.starImage H K ≠ ⊥ ∧
      ((∃ n, 3 ≤ n ∧ n ≤ 5 ∧
        ∃ eC : Source.starImage H K ≃* BinaryLinear.GL (Fin n → ZMod 2),
          HasSectionModel H V₃ V₁ ρ K hKH (linearRepresentation n)
            ((Components.componentStarEquiv H K hKH hK).trans eC)) ∨
      (∃ n, 5 ≤ n ∧ n ≤ 8 ∧
        ∃ eC : Source.starImage H K ≃* alternatingGroup (Fin n),
          HasSectionModel H V₃ V₁ ρ K hKH
            (BinaryPermutation.alternatingNaturalRepresentation (Fin n))
            ((Components.componentStarEquiv H K hKH hK).trans eC))) := by
  obtain ⟨J, htJ, hJ, hJN, hJns, hcore, hgen, hcover, hsurj,
    hf, hst, _, _, _, horbit⟩ :=
    exists_source_recognition_actor hG H L₁ T G₁ M Z V₃ V₁ hH hZ hpZ hG₁ ρ hρ hc t ht hns
  let s : J := ⟨t, htJ⟩
  let σ := (displacementRepresentation (ρ.comp J.subtype) s).toRepresentation
  have hmodel : ActorModel σ := actorModel_of_self_generated_g64 σ
    ((QuotientGroup.mk' (pCore 2 H)).subgroupComap J) hcover hsurj hcore hf hst hgen horbit
    (g64Universal_of_source hG64 σ s hst)
  obtain ⟨C, hn, hsimple, hperfect, hnoncomm, hm⟩ :=
    exists_simple_normal_naturalSection σ hJns hmodel
  let := hn
  let := hsimple
  let := hperfect
  obtain ⟨K, hKH, hK, he, hcomm, hne⟩ :=
    lift_simple_normal_self_commutator H J hJ s hgen C hnoncomm
  have hmK : NaturalSection ρ (Source.starImage H K) := by
    rw [he]
    exact naturalSection_of_displacement ρ J s hgen C hm
  refine ⟨K, hKH, hK, ?_, ?_, hcomm, hne, ?_⟩
  · rw [he]
    exact (map_subtype_le C).trans hJN
  · exact le_normalizer_iff_commutator_le_left.mpr hcomm.le
  · rcases hmK with ⟨n, hn, hn5, eC, hm⟩ | ⟨n, hn, hn8, eC, hm⟩
    · exact Or.inl ⟨n, hn, hn5, eC, hasSectionModel_of_star_model K hKH hK ρ hρ _ eC hm⟩
    · exact Or.inr ⟨n, hn, hn8, eC, hasSectionModel_of_star_model K hKH hK ρ hρ _ eC hm⟩


/-- The component-section step in the genuine §13.8 setting. The two-core
centralizer identity is the uniform earlier result of F.9.2(3), recalled in
Notation 13.5.8. The actual flag supplies its two-local application witness.
Both quotient models use the same canonical component-star identification. -/
theorem source_component_natural_section {κ : GroupClass.{u}}
    (hG64 : G64SourceTheorem κ) (T : Sylow 2 G)
    (L V V₁ V₂ V₃ G₁ M : Subgroup G)
    (d : SourceContext κ T L V V₁ V₂ V₃ G₁ M)
    (hkernel : ∀ H ∈ Source.Hz
      (TransvectionParabolic.EarlierCore.residual ((L ⊔ T) ⊓ normalizer (V₁ : Set G))) T G₁ M,
      Source.QH H = commutatorPreimage H (Source.UH H V₃) V₁)
    (H : Subgroup G)
    (hH : H ∈ Source.Hz
      (TransvectionParabolic.EarlierCore.residual ((L ⊔ T) ⊓ normalizer (V₁ : Set G))) T G₁ M)
    [(V₁.subgroupOf (Source.UH H V₃)).Normal]
    [IsElementaryAbelian 2 (Source.Utilde H V₃ V₁)]
    (ρ : Representation (ZMod 2) (Source.Hstar H) (Additive (Source.Utilde H V₃ V₁)))
    (hρ : IsConjugation H V₃ V₁ ρ)
    (t : Source.Hstar H) (ht : IsTransvection ρ t)
    (hns : ¬ Group.IsSolvable (normalClosure ({t} : Set (Source.Hstar H)))) :
    ∃ (K : Subgroup G) (hKH : K ≤ H) (hK : (K.subgroupOf H).IsCComponent),
      Source.starImage H K ≤ normalClosure ({t} : Set (Source.Hstar H)) ∧
      zpowers t ≤ normalizer (Source.starImage H K : Set (Source.Hstar H)) ∧
      ⁅Source.starImage H K, zpowers t⁆ = Source.starImage H K ∧
      Source.starImage H K ≠ ⊥ ∧
      ((∃ n, 3 ≤ n ∧ n ≤ 5 ∧
        ∃ eC : Source.starImage H K ≃* BinaryLinear.GL (Fin n → ZMod 2),
          HasSectionModel H V₃ V₁ ρ K hKH (linearRepresentation n)
            ((Components.componentStarEquiv H K hKH hK).trans eC)) ∨
      (∃ n, 5 ≤ n ∧ n ≤ 8 ∧
        ∃ eC : Source.starImage H K ≃* alternatingGroup (Fin n),
          HasSectionModel H V₃ V₁ ρ K hKH
            (BinaryPermutation.alternatingNaturalRepresentation (Fin n))
            ((Components.componentStarEquiv H K hKH hK).trans eC))) := by
  obtain ⟨hV₁, hpV₁⟩ := d.flag.line_two_local
  exact exists_component_natural_section d.qtke hG64 H _ T G₁ M V₁ V₃ V₁ hH
    hV₁ hpV₁ d.point_normalizer ρ hρ (hkernel H hH).ge t ht hns

end CFSG.Quasithin.Chapter13.Section08.TransvectionRecognition.Component.RecognitionStep

