module

public import CFSG.Quasithin.Chapter13.Section08.LocalAnalysis.TransvectionModules.Recognition.Action
public import CFSG.Quasithin.Chapter13.Section08.LocalAnalysis.TransvectionModules.Basic
public import CFSG.Quasithin.Chapter13.Section08.LocalAnalysis.TransvectionModules.Recognition.Component.Sections
public import CFSG.Quasithin.Chapter13.Section08.LocalAnalysis.Components.Basic
public import Theory.Representation.FirstCohomologyDuality

/-!
# A covering projection from the actual component section

If U_H=[U_H,K], the literal image of U_K in U_H/V₁ is the whole module.
An equivariant identification of Ũ_K/C_{Ũ_K}(K) therefore gives an actual
surjective map from U_H/V₁ to the specified model. Its kernel is fixed by K,
and its source is generated by K-commutators. These are the three covering
conditions of I.1.5, proved here on the actual source quotient.

The model actor is transported through the intrinsic equivalence
K/O₂(K) ≃ K*; its representative formula retains the specified identification
of K/O₂(K) throughout. No full-module recognition is assumed in this map.
The generation identity is supplied by the later application of universal
13.7.6(3), whose source hypotheses remain the responsibility of assembly.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004,
13.7.6(3), printed pp.938–939; I.1.5–6, printed p.408; 13.8.5, p.947.
-/

@[expose] public section

open Subgroup Representation Representation.BinaryOffender
open Representation.OneCohomology
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter13.Section08.TransvectionRecognition.Component.ModelExtension

variable {G : Type*} [Group G] [Finite G]
  {H V₃ V₁ K : Subgroup G}
  [(V₁.subgroupOf (Source.UH H V₃)).Normal]
  [IsElementaryAbelian 2 (Source.Utilde H V₃ V₁)]

omit [Finite G] in
/-- Group commutator generation makes the literal component image the whole module. -/
theorem commutatorImage_eq_top
    (hgen : Source.UH H V₃ = ⁅Source.UH H V₃, K⁆) :
    commutatorImage H V₃ V₁ K = ⊤ := by
  apply top_unique
  intro v _
  obtain ⟨u, hu⟩ := QuotientGroup.mk'_surjective (V₁.subgroupOf (Source.UH H V₃)) v.toMul
  exact ⟨u, hgen ▸ u.property, hu⟩

variable {A E : Type*} [Group A] [AddCommGroup E] [Module (ZMod 2) E]

/-- The model group acts through the specified intrinsic component quotient. -/
noncomputable def modelActor (hKH : K ≤ H) (hK : (K.subgroupOf H).IsCComponent)
    (eK : (K ⧸ pCore 2 K) ≃* A) : A →* Source.Hstar H :=
  (Source.starImage H K).subtype.comp
    ((Components.componentStarEquiv H K hKH hK).toMonoidHom.comp eK.symm.toMonoidHom)

/-- The transported actor agrees with the actual H*-image on each K representative. -/
theorem modelActor_mk (hKH : K ≤ H) (hK : (K.subgroupOf H).IsCComponent)
    (eK : (K ⧸ pCore 2 K) ≃* A) (k : K) :
    modelActor hKH hK eK (eK (QuotientGroup.mk' (pCore 2 K) k)) =
      QuotientGroup.mk' (pCore 2 H) (inclusion hKH k) := by
  simp only [modelActor, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom,
    MulEquiv.symm_apply_apply]
  exact Components.componentStarEquiv_mk H K hKH hK k

/-- Construct a genuine covering projection; surjectivity, fixed kernel and
commutator generation are conclusions rather than additional premises. -/
theorem exists_cover_of_section
    (hKH : K ≤ H) (hK : (K.subgroupOf H).IsCComponent)
    (ρ : Representation (ZMod 2) (Source.Hstar H) (Additive (Source.Utilde H V₃ V₁)))
    (hρ : IsConjugation H V₃ V₁ ρ)
    (hgen : Source.UH H V₃ = ⁅Source.UH H V₃, K⁆)
    (σ : Representation (ZMod 2) A E) (eK : (K ⧸ pCore 2 K) ≃* A)
    (hs : HasSectionModel H V₃ V₁ ρ K hKH σ eK) :
    ∃ p : Representation.IntertwiningMap (ρ.comp (modelActor hKH hK eK)) σ, IsCover p := by
  obtain ⟨hs, e, he⟩ := hs
  let S := commutatorImage H V₃ V₁ K
  let F := fixedInCommutator H V₃ V₁ ρ K
  let j : Additive (Source.Utilde H V₃ V₁) ≃ₗ[ZMod 2] S :=
    (LinearEquiv.ofTop S (commutatorImage_eq_top hgen)).symm
  let p : Additive (Source.Utilde H V₃ V₁) →ₗ[ZMod 2] E :=
    e.toLinearMap.comp (F.mkQ.comp j.toLinearMap)
  have hp (v) : p v = e (Submodule.Quotient.mk (j v)) := rfl
  have hj (v) : (j v).val = v := LinearEquiv.coe_ofTop_symm_apply _ _
  have hpe (a : A) (v) :
      p (ρ (modelActor hKH hK eK a) v) = σ a (p v) := by
    obtain ⟨k, hk⟩ := QuotientGroup.mk'_surjective (pCore 2 K) (eK.symm a)
    have hka : eK (QuotientGroup.mk' (pCore 2 K) k) = a := by rw [hk]; simp
    rw [← hka, modelActor_mk, hp, hp]
    convert he k (j v) using 2
    congr 2
  let P : Representation.IntertwiningMap (ρ.comp (modelActor hKH hK eK)) σ :=
    p.intertwiningMap_of_isIntertwiningMap _ _ hpe
  refine ⟨P, ?_, ?_, ?_⟩
  · intro v
    obtain ⟨u, hu⟩ := Submodule.mkQ_surjective F (e.symm v)
    refine ⟨j.symm u, ?_⟩
    change e (F.mkQ (j (j.symm u))) = v
    rw [j.apply_symm_apply, hu, e.apply_symm_apply]
  · intro v hv a
    have hz : F.mkQ (j v) = 0 := e.injective (by
      change p v = e 0
      rw [map_zero]
      exact hv)
    have hf : (j v) ∈ F := (Submodule.Quotient.mk_eq_zero _).mp hz
    have hfix : ∀ k : Source.starImage H K, ρ k ((j v).val) = (j v).val := hf
    change ρ ((Components.componentStarEquiv H K hKH hK (eK.symm a)) : Source.Hstar H) v = v
    rw [← hj v]
    exact hfix (Components.componentStarEquiv H K hKH hK (eK.symm a))
  · have htop : subspaceCommutator ρ ⊤ (Source.starImage H K) = ⊤ :=
      (commutatorImage_eq_subspaceCommutator K hKH ρ hρ).symm.trans
        (commutatorImage_eq_top hgen)
    apply top_unique
    rw [← htop]
    apply Submodule.span_le.mpr
    rintro _ ⟨a, ⟨k, hk, rfl⟩, v, _, rfl⟩
    let k' : K := ⟨k, hk⟩
    have hc := Coinvariants.sub_mem_ker
      (ρ := ρ.comp (modelActor hKH hK eK)) (eK (QuotientGroup.mk' (pCore 2 K) k')) v
    have hk' : inclusion hKH k' = k := Subtype.ext rfl
    rw [MonoidHom.comp_apply, modelActor_mk, hk'] at hc
    exact hc

end CFSG.Quasithin.Chapter13.Section08.TransvectionRecognition.Component.ModelExtension

end
