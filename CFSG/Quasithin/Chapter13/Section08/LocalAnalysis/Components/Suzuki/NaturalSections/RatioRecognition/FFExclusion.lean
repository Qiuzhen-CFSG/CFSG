module

public import CFSG.Quasithin.Chapter15.Section04.Configuration.LocalSetup.TwoFactors.FFBranch.Recognition.ClassificationComparison.FFAlternatives.SourceAlternatives
public import Theory.SpecificGroups.FFG2PrimeCore


/-!
# Faithful FF exclusion in groups of order prime to three

Restriction to the actual offender-generated subgroup J(D,V) satisfies B.5.3:
J is normal, so its two-core vanishes; best offenders remain best offenders;
and the inverse image of J in a finite SQTK cover supplies its cover. The
restricted action remains faithful and retains a nontrivial FF witness.

Every nontrivial alternative in the complete B.5.6 conclusion has order
divisible by three, using the actual model equivalences and subgroup inclusions.
This contradicts three-free order in D. The full universal B.5 input remains
explicit, with exactly its published hypotheses and all its alternatives.
No equality D=J(D,V) is assumed and no universal classification is asserted.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), B.5.1 and
B.5.3–6, printed pp.99 and 104–105, used in 13.8.16, pp.952–953.
-/

@[expose] public section

open Subgroup Representation Representation.BinaryOffender Theory.GroupTheory
open CFSG.Quasithin
open CFSG.Quasithin.Chapter15.Section04.LocalSetup.TwoFactors.FFBranch.ClassificationComparison
open CFSG.Quasithin.Chapter15.Section04.LocalSetup.TwoFactors.FFBranch.ClassificationComparison.FFAlternatives
namespace CFSG.Quasithin.Chapter13.Section08.Components.Suzuki.NaturalSections.RatioRecognition
universe u v
variable {D : Type u} [Group D] {V : Type v} [AddCommGroup V] [Module (ZMod 2) V]
    (ρ : Representation (ZMod 2) D V)

/-- Restriction to J(D,V) is generated by its own best offenders. -/
theorem offender_restriction_generated :
    offenderSubgroup (ρ.comp (offenderSubgroup ρ).subtype) = ⊤ := by
  apply map_injective (offenderSubgroup ρ).subtype_injective
  apply le_antisymm (by simp)
  have htop : (⊤ : Subgroup (offenderSubgroup ρ)).map (offenderSubgroup ρ).subtype =
      offenderSubgroup ρ := by ext x; simp
  rw [htop]
  unfold offenderSubgroup generatedBy
  refine iSup_le fun A => iSup_le fun hA => ?_
  have hAJ : A ≤ offenderSubgroup ρ :=
    le_iSup_of_le A (le_iSup_of_le hA le_rfl)
  rw [← map_subgroupOf_eq_of_le hAJ]
  exact map_mono (le_iSup_of_le (A.subgroupOf (offenderSubgroup ρ))
    (le_iSup_of_le ⟨hA.1.subgroupOf _ hAJ, le_top⟩ le_rfl))

/-- A best offender supplies an FF witness on the restricted module. -/
theorem offender_restriction_ff [Finite D] [Module.Finite (ZMod 2) V]
    (hff : IsFFModule ρ) : IsFFModule (ρ.comp (offenderSubgroup ρ).subtype) := by
  obtain ⟨A, hA⟩ := (isFFModule_iff_exists_bestOffender ρ).mp hff
  have hAJ : A ≤ offenderSubgroup ρ :=
    le_iSup_of_le A (le_iSup_of_le ⟨hA, le_top⟩ le_rfl)
  exact ⟨A.subgroupOf (offenderSubgroup ρ), (hA.subgroupOf _ hAJ).isOffender _⟩

/-- Normality of J carries its characteristic two-core into O₂(D). -/
theorem offender_restriction_twoCore [Finite D] (h₂ : pCore 2 D = ⊥) :
    pCore 2 (offenderSubgroup ρ) = ⊥ := by
  let := offenderSubgroup_normal ρ
  have hn : ((pCore 2 (offenderSubgroup ρ)).map (offenderSubgroup ρ).subtype).Normal :=
    ConjAct.normal_of_characteristic_of_normal
  have hl : (pCore 2 (offenderSubgroup ρ)).map (offenderSubgroup ρ).subtype ≤ pCore 2 D :=
    le_sSup ⟨hn, pCore_isPGroup.map _⟩
  rw [h₂] at hl
  exact ((pCore 2 (offenderSubgroup ρ)).map_eq_bot_iff_of_injective
    (offenderSubgroup ρ).subtype_injective).mp (le_bot_iff.mp hl)

/-- Pull back a subgroup to the given finite cover and apply the first isomorphism theorem. -/
noncomputable def subgroupSQTKQuotient {K : GroupClass.{u}}
    (c : SQTKQuotient K D) (S : Subgroup D) : SQTKQuotient K S := by
  letI := c.coverGroup
  letI := c.coverFinite
  letI := c.kernelNormal
  let π : c.Cover →* D := c.equiv.toMonoidHom.comp (QuotientGroup.mk' c.kernel)
  have hπ : Function.Surjective π := c.equiv.surjective.comp (QuotientGroup.mk'_surjective _)
  let f : S.comap π →* S := π.subgroupComap S
  have hf : Function.Surjective f := π.subgroupComap_surjective_of_surjective S hπ
  exact {
    Cover := S.comap π
    kernel := f.ker
    sqtk := c.sqtk.subgroup _
    equiv := QuotientGroup.quotientKerEquivOfSurjective f hf }

/-- All B.5.3 hypotheses hold on the actual offender subgroup. -/
theorem offender_restriction_hypothesis [Finite D] [Module.Finite (ZMod 2) V]
    {K : GroupClass.{u}} (hfaith : Function.Injective ρ) (h₂ : pCore 2 D = ⊥)
    (hcover : Nonempty (SQTKQuotient K D)) :
    FFHypothesis K (ρ.comp (offenderSubgroup ρ).subtype) := by
  obtain ⟨c⟩ := hcover
  exact {
    finite_module := inferInstance
    faithful := hfaith.comp (offenderSubgroup ρ).subtype_injective
    twoCore := offender_restriction_twoCore ρ h₂
    generated := offender_restriction_generated ρ
    quotient := ⟨subgroupSQTKQuotient c _⟩ }

private theorem three_dvd_of_core_eq_bot {L : Type*} [Group L] [Finite L] [Nontrivial L]
    (hcore : pPrimeCore 3 L = ⊥) : 3 ∣ Nat.card L := by
  by_contra h
  have ht : (⊤ : Subgroup L) = ⊥ := pPrimeCore_eq_bot_iff.mp hcore _ inferInstance
    (by simpa only [Nat.card_congr Subgroup.topEquiv.toEquiv] using
      Nat.prime_three.coprime_iff_not_dvd.mpr h)
  exact top_ne_bot ht

/-- The alternating group contains three in its order once its degree is at least three. -/
theorem three_dvd_card_alternating (n : ℕ) (hn : 3 ≤ n) :
    3 ∣ Nat.card (alternatingGroup (Fin n)) := by
  let : Nontrivial (Fin n) := Fin.nontrivial_iff_two_le.mpr (by omega)
  rw [nat_card_alternatingGroup]
  simp only [Nat.card_eq_fintype_card, Fintype.card_fin]
  exact Nat.dvd_div_of_mul_dvd (show 2 * 3 ∣ n.factorial from
    (by decide : 2 * 3 = (3 : ℕ).factorial) ▸ Nat.factorial_dvd_factorial hn)

/-- Every actual generalized-Fitting model in B.5.1 has order divisible by three. -/
theorem three_dvd_card_quasisimpleModel {L : Type*} [Group L] [Finite L]
    [IsQuasisimple L] (h : QuasisimpleModel L) : 3 ∣ Nat.card L := by
  let : IsSimpleGroup (L ⧸ center L) := IsQuasisimple.simple
  have : Nontrivial L := (QuotientGroup.mk'_surjective (center L)).nontrivial
  cases h with
  | linearTwo F e =>
    rw [Nat.card_congr e.toEquiv]
    exact Theory.SpecificGroups.three_dvd_card_sl_two F.Carrier
  | linearThree F e =>
    rw [Nat.card_congr e.toEquiv]
    exact Theory.SpecificGroups.three_dvd_card_sl_three F.Carrier
  | symplecticFour F e =>
    rw [Nat.card_congr e.toEquiv, Theory.SpecificGroups.SymplecticFour.card_sp, F.card_eq]
    exact dvd_mul_of_dvd_left (dvd_mul_of_dvd_right
      (Theory.SpecificGroups.three_dvd_even_square_sub_one F.degree) _) _
  | g2 F e =>
    rw [Nat.card_congr e.toEquiv, Atlas.G2.card_Model, F.card_eq]
    exact dvd_mul_of_dvd_right (Theory.SpecificGroups.three_dvd_even_square_sub_one F.degree) _
  | alternatingSix e =>
    rw [Nat.card_congr e.toEquiv]
    exact three_dvd_card_alternating 6 (by decide)
  | alternatingSeven e =>
    rw [Nat.card_congr e.toEquiv]
    exact three_dvd_card_alternating 7 (by decide)
  | tripleSix e _ =>
    have hc : Nat.card (center L) = 3 := (Nat.card_congr e.toEquiv).trans (Nat.card_zmod 3)
    exact hc ▸ (center L).card_subgroup_dvd_card
  | g2DerivedTwo e =>
    rw [Nat.card_congr e.toEquiv]
    exact Theory.SpecificGroups.three_dvd_card_g2_derived_two
  | linearFourTwo e =>
    exact three_dvd_of_core_eq_bot (pPrimeCore_eq_bot_of_equiv e
      (Theory.SpecificGroups.binary_linear_threePrimeCore 4 (Or.inl rfl)))
  | linearFiveTwo e =>
    exact three_dvd_of_core_eq_bot (pPrimeCore_eq_bot_of_equiv e
      (Theory.SpecificGroups.binary_linear_threePrimeCore 5 (Or.inr rfl)))

/-- Every model of a direct factor in B.5.6 has order divisible by three. -/
theorem three_dvd_card_factorModel {L : Type*} [Group L] (h : FactorModel L) :
    3 ∣ Nat.card L := by
  cases h with
  | linearTwo F e =>
    rw [Nat.card_congr e.toEquiv]
    exact Theory.SpecificGroups.three_dvd_card_sl_two F.Carrier
  | symmetricFive e =>
    rw [Nat.card_congr e.toEquiv, Nat.card_eq_fintype_card, Fintype.card_perm]
    decide
  | linearThree F _ e =>
    rw [Nat.card_congr e.toEquiv]
    exact Theory.SpecificGroups.three_dvd_card_sl_three F.Carrier

/-- All four nonquasisimple B.5.6 alternatives force three into the actor order. -/
theorem three_dvd_card_nonQuasisimple [Finite D] (h : NonQuasisimpleAlternative ρ) :
    3 ∣ Nat.card D := by
  cases h with
  | symmetricThree c =>
    rw [Nat.card_congr c.equiv.toEquiv, Nat.card_eq_fintype_card, Fintype.card_perm]
    decide
  | twoFactors c =>
    exact (three_dvd_card_factorModel c.firstModel).trans c.first.card_subgroup_dvd_card
  | outerSixThree c =>
    have hc : Nat.card c.second = 3 :=
      (Nat.card_congr c.secondEquiv.toEquiv).trans (Nat.card_zmod 3)
    exact hc ▸ c.second.card_subgroup_dvd_card
  | hyperplane c =>
    have hc : 3 ∣ Nat.card c.first := by
      rw [Nat.card_congr c.firstEquiv.toEquiv]
      exact Theory.SpecificGroups.three_dvd_card_sl_three (ZMod 2)
    exact hc.trans c.first.card_subgroup_dvd_card

/-- An FF witness excludes the trivial case of the complete B.5.6 conclusion. -/
theorem three_dvd_card_sourceAlternative [Finite D]
    (h : SourceAlternative ρ) (hff : IsFFModule ρ) : 3 ∣ Nat.card D := by
  rcases h.groupCases_of_ff ρ hff with ⟨hq, hm⟩ | h
  · let := hq
    exact (three_dvd_card_quasisimpleModel hm).trans
      (generalizedFitting D).card_subgroup_dvd_card
  · exact three_dvd_card_nonQuasisimple ρ h

/-- Conditional on the full universal B.5 classification, three-free actors with trivial two-core have no faithful FF modules. -/
theorem not_ff_of_three_free [Finite D] [Module.Finite (ZMod 2) V]
    {K : GroupClass.{u}} (classification : CompleteClassificationInput.{u,v} K)
    (hfaith : Function.Injective ρ) (h₂ : pCore 2 D = ⊥)
    (hcover : Nonempty (SQTKQuotient K D)) (hthree : ¬ 3 ∣ Nat.card D) :
    ¬ IsFFModule ρ := by
  intro hff
  have h := classification.general (offenderSubgroup ρ) V
    (ρ.comp (offenderSubgroup ρ).subtype)
    (offender_restriction_hypothesis ρ hfaith h₂ hcover)
  exact hthree ((three_dvd_card_sourceAlternative _ h (offender_restriction_ff ρ hff)).trans
    (offenderSubgroup ρ).card_subgroup_dvd_card)

/-- The same hypotheses exclude strong FF modules. -/
theorem not_strongFF_of_three_free [Finite D] [Module.Finite (ZMod 2) V]
    {K : GroupClass.{u}} (classification : CompleteClassificationInput.{u,v} K)
    (hfaith : Function.Injective ρ) (h₂ : pCore 2 D = ⊥)
    (hcover : Nonempty (SQTKQuotient K D)) (hthree : ¬ 3 ∣ Nat.card D) :
    ¬ IsStrongFFModule ρ := by
  rintro ⟨A, hA, hlt⟩
  exact not_ff_of_three_free ρ classification hfaith h₂ hcover hthree ⟨A, hA, hlt.le⟩

end CFSG.Quasithin.Chapter13.Section08.Components.Suzuki.NaturalSections.RatioRecognition
