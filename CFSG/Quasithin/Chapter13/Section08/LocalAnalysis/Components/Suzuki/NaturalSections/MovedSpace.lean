module

public import CFSG.Quasithin.Chapter13.Section08.LocalAnalysis.Components.Basic
public import CFSG.Quasithin.Chapter13.Section08.LocalAnalysis.Components.Suzuki.Reduction
public import Theory.Representation.BinaryOffender.IrreducibleExistence

/-!
# The entire component-orbit commutator space

The actual star map takes ⟨K^T⟩ to ⟨(K*)^(T*)⟩. Quasisimplicity of K*
therefore makes this whole actor perfect, in both the single and swapped
cases. For a perfect actor, the quotient by second commutators has central
first commutators and hence trivial action; consequently [V,K₀*] equals
[[V,K₀*],K₀*]. Faithfulness supplies nontrivial component action.

An irreducible seed of dimension greater than one is also generated by its
action commutators: otherwise its action is trivial and every line is
invariant. These arguments assume no splitting over central submodules.

Source: the module-generation steps of Aschbacher–Smith 13.8.16, printed
pp.952–953 (combined manuscript of 1 March 2004). The F.9.18 classification
of the central quotients remains a separate obligation.
-/

@[expose] public section

open Subgroup Representation Representation.BinaryOffender
open scoped IsMulCommutative commutatorElement
namespace CFSG.Quasithin.Chapter13.Section08.Components.Suzuki.NaturalSections
variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]

/-- Perfect actors generate their entire moved space by second commutators. -/
theorem perfect_movedSpace_generated (ρ : Representation (ZMod 2) G V)
    (K : Subgroup G) [Group.IsPerfect K] :
    subspaceCommutator ρ (subspaceCommutator ρ ⊤ K) K = subspaceCommutator ρ ⊤ K := by
  let W := subspaceCommutator ρ ⊤ K
  let D := subspaceCommutator ρ W K
  have hWK : K ≤ subspaceStabilizer ρ W := subspaceCommutator_invariant_normalizer ρ (le_subspaceStabilizer ρ ⊤ (by simp)) K.le_normalizer
  have hDK : K ≤ subspaceStabilizer ρ D := subspaceCommutator_invariant_normalizer ρ hWK K.le_normalizer
  have hDW : D ≤ W := by
    apply Submodule.span_le.mpr
    rintro _ ⟨k, hk, w, hw, rfl⟩
    exact W.sub_mem ((hWK hk w).2 hw) hw
  let S : Subrepresentation (ρ.comp K.subtype) := ⟨D, fun k v hv => (hDK k.property v).2 hv⟩
  let τ := S.quotientRepresentation
  have hc : subspaceCommutator τ ⊤ ⊤ ≤ fixedSpace τ ⊤ := by
    apply Submodule.span_le.mpr
    rintro _ ⟨k, _, v, _, rfl⟩ l
    obtain ⟨v, rfl⟩ := D.mkQ_surjective v
    change D.mkQ (ρ l (ρ k v - v)) = D.mkQ (ρ k v - v)
    apply sub_eq_zero.mp
    rw [← map_sub]
    apply (Submodule.Quotient.mk_eq_zero D).mpr
    exact Submodule.subset_span ⟨l, l.val.property, _,
      Submodule.subset_span ⟨k, k.property, v, Submodule.mem_top, rfl⟩, rfl⟩
  have hf := le_fixedSpace_of_commutator_le_fixedSpace τ ⊤ ⊤
    (le_subspaceStabilizer τ ⊤ (by simp)) hc
  apply le_antisymm hDW
  apply Submodule.span_le.mpr
  rintro _ ⟨k, hk, v, _, rfl⟩
  apply (Submodule.Quotient.mk_eq_zero D).mp
  change D.mkQ (ρ k v - v) = 0
  rw [map_sub]
  exact sub_eq_zero.mpr (hf (show D.mkQ v ∈ (⊤ : Submodule (ZMod 2) (V ⧸ D)) from
    Submodule.mem_top) ⟨⟨k, hk⟩, Subgroup.mem_top _⟩)
end CFSG.Quasithin.Chapter13.Section08.Components.Suzuki.NaturalSections

namespace CFSG.Quasithin.Chapter13.Section08.Components.Suzuki.NaturalSections
open Theory.GroupTheory
variable {G : Type*} [Group G]

/-- The star map preserves the actual T-orbit of K. -/
theorem starImage_conjugateSpan (H K T : Subgroup G) (hKH : K ≤ H) (hTH : T ≤ H) :
    Source.starImage H (conjugateSpanBy K T) =
      conjugateSpanBy (Source.starImage H K) (Source.starImage H T) := by
  have hspan : conjugateSpanBy K T ≤ H := conjugateSpanBy_le hKH (hTH.trans H.le_normalizer)
  have he : (conjugateSpanBy K T).subgroupOf H =
      conjugateSpanBy (K.subgroupOf H) (T.subgroupOf H) := by
    apply map_injective H.subtype_injective
    rw [map_subgroupOf_eq_of_le hspan, map_conjugateSpan,
      map_subgroupOf_eq_of_le hKH, map_subgroupOf_eq_of_le hTH]
  change ((conjugateSpanBy K T).subgroupOf H).map _ = _
  rw [he, map_conjugateSpan]
  rfl

/-- Perfectness survives taking the full conjugate span. -/
theorem conjugateSpan_perfect (K T : Subgroup G) [Group.IsPerfect K] :
    Group.IsPerfect (conjugateSpanBy K T) := by
  have he : conjugateSpanBy K T =
      ⨆ t : T, K.map (MulAut.conj (t : G)).toMonoidHom := by
    apply le_antisymm
    · apply (closure_le _).mpr
      rintro _ ⟨t, ht, k, hk, rfl⟩
      exact (le_iSup (fun t : T => K.map (MulAut.conj (t : G)).toMonoidHom) ⟨t, ht⟩)
        (mem_map_of_mem _ hk)
    · apply iSup_le
      intro t
      rintro _ ⟨k, hk, rfl⟩
      exact subset_closure ⟨t, t.property, k, hk, rfl⟩
  rw [he]
  exact isPerfect_iSup_conjugates K T

/-- Both orbit cases have a perfect actual actor, using only quasisimplicity
of K*; no simplicity theorem for a model is required. -/
theorem componentOrbitStar_perfect (H K T : Subgroup G) (hKH : K ≤ H) (hTH : T ≤ H)
    [IsQuasisimple (Source.starImage H K)] :
    Group.IsPerfect (Source.starImage H (conjugateSpanBy K T)) := by
  rw [starImage_conjugateSpan H K T hKH hTH]
  exact conjugateSpan_perfect _ _

/-- A faithful source action is nontrivial on the complete component orbit. -/
theorem componentOrbitStar_not_fixed (H K T : Subgroup G)
    [IsQuasisimple (Source.starImage H K)]
    {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]
    (ρ : Representation (ZMod 2) (Source.Hstar H) V) (hρ : Function.Injective ρ) :
    ¬ (⊤ : Submodule (ZMod 2) V) ≤
      fixedSpace ρ (Source.starImage H (conjugateSpanBy K T)) := by
  let : IsSimpleGroup ((Source.starImage H K) ⧸ center (Source.starImage H K)) :=
    IsQuasisimple.simple
  let : Nontrivial (Source.starImage H K) :=
    Function.Surjective.nontrivial (QuotientGroup.mk'_surjective (center (Source.starImage H K)))
  have hK : Source.starImage H K ≠ ⊥ := (nontrivial_iff_ne_bot _).mp inferInstance
  intro hf
  apply hK
  apply bot_unique
  intro k hk
  apply hρ
  ext v
  simpa using hf (show v ∈ (⊤ : Submodule (ZMod 2) V) from Submodule.mem_top)
    ⟨k, map_mono (subgroupOf_mono H (le_conjugateSpanBy K T)) hk⟩
end CFSG.Quasithin.Chapter13.Section08.Components.Suzuki.NaturalSections

namespace CFSG.Quasithin.Chapter13.Section08.Components.Suzuki.NaturalSections
variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]

/-- An irreducible submodule of dimension greater than one is its own moved
space: the zero-commutator alternative would leave every line invariant. -/
theorem irreducible_seed_generated (ρ : Representation (ZMod 2) G V)
    (K : Subgroup G) (A : Submodule (ZMod 2) V)
    (hA : K ≤ subspaceStabilizer ρ A)
    (hi : IsAtom (invariantSubspace ρ K A hA))
    (hdim : 1 < Module.finrank (ZMod 2) A) : subspaceCommutator ρ A K = A := by
  let C := subspaceCommutator ρ A K
  have hC : K ≤ subspaceStabilizer ρ C :=
    subspaceCommutator_invariant_normalizer ρ hA K.le_normalizer
  have hCA : C ≤ A := by
    apply Submodule.span_le.mpr
    rintro _ ⟨k, hk, v, hv, rfl⟩
    exact A.sub_mem ((hA hk v).2 hv) hv
  have hc : C = ⊥ ∨ C = A := by
    rcases hi.le_iff.mp (show invariantSubspace ρ K C hC ≤ invariantSubspace ρ K A hA from hCA)
      with h | h
    · exact Or.inl (congrArg Subrepresentation.toSubmodule h)
    · exact Or.inr (congrArg Subrepresentation.toSubmodule h)
  rcases hc with hc | hc
  · have hf : ∀ k ∈ K, ∀ v ∈ A, ρ k v = v := by
      intro k hk v hv
      have hmem : ρ k v - v ∈ C := Submodule.subset_span ⟨k, hk, v, hv, rfl⟩
      rw [hc, Submodule.mem_bot] at hmem
      exact sub_eq_zero.mp hmem
    have hAbot : A ≠ ⊥ := by
      intro he
      have : Module.finrank (ZMod 2) A = 0 := by rw [he]; simp
      omega
    obtain ⟨v, hv, hv0⟩ := (Submodule.ne_bot_iff A).mp hAbot
    let E := Submodule.span (ZMod 2) {v}
    have hEA : E ≤ A := (Submodule.span_singleton_le_iff_mem v A).mpr hv
    have hE : K ≤ subspaceStabilizer ρ E := by
      apply le_subspaceStabilizer
      intro k hk w hw
      rw [hf k hk w (hEA hw)]
      exact hw
    have hEbot : invariantSubspace ρ K E hE ≠ ⊥ := by
      intro he
      have he' : E = ⊥ := congrArg Subrepresentation.toSubmodule he
      have hm : v ∈ E := Submodule.subset_span (by simp : v ∈ ({v} : Set V))
      rw [he'] at hm
      exact hv0 hm
    have he : E = A := congrArg Subrepresentation.toSubmodule ((hi.le_iff_eq hEbot).mp hEA)
    have hdimE : Module.finrank (ZMod 2) E = 1 := finrank_span_singleton hv0
    have : Module.finrank (ZMod 2) A = 1 := he ▸ hdimE
    omega
  · exact hc
end CFSG.Quasithin.Chapter13.Section08.Components.Suzuki.NaturalSections

end
