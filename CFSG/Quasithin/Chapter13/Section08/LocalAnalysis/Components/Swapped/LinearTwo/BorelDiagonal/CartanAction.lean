module

public import Mathlib.GroupTheory.PGroup
public import Mathlib.GroupTheory.Commutator.Basic

/-!
# Marked cyclic Cartan actions on a product

Let `C` be finite cyclic, and let an automorphism `τ` exchange the two
coordinate factors of `C × C`. Every `τ`-invariant subgroup of order three
projects injectively to both coordinates. Cyclicity then makes the projected
images of any two such markings equal. If `α` permutes the factors, fixes one
marking pointwise and inverts the other, it must exchange the factors.

The actual displacement subgroup generated by `α x * x⁻¹` projects onto
both copies of `C`. Consequently, when `C` has odd order and displacement has
only the primes two and three, `C` is a three-group. Surjective equivariant
maps transport displacement, and an ambient conjugation action puts its
image inside the actual subgroup `⁅B, zpowers s⁆`.

These are intrinsic conditional helpers for the Cartan argument in
Aschbacher–Smith, proof of 13.8.16(1), printed p.952 / PDF p.969, with the
markings of Notation 13.2.1, printed p.877 (1 March 2004 manuscript).
The source assembly must construct the automorphisms and both marked
quotient images, and establish their compatibility with the torus map.
Neither automorphism is assumed to have order two.
-/

@[expose] public section

open Subgroup
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter13.Section08.Components.Swapped.LinearTwo.CartanAction
variable {C : Type*} [Group C]

/-- The actual first coordinate subgroup `C × 1`. -/
def firstFactor (C : Type*) [Group C] : Subgroup (C × C) :=
  (⊤ : Subgroup C).prod ⊥
/-- The actual second coordinate subgroup `1 × C`. -/
def secondFactor (C : Type*) [Group C] : Subgroup (C × C) :=
  (⊥ : Subgroup C).prod ⊤

/-- Membership in the first coordinate subgroup. -/
@[simp] theorem mem_firstFactor (x : C × C) : x ∈ firstFactor C ↔ x.2 = 1 := by
  simp [firstFactor, mem_prod]
/-- Membership in the second coordinate subgroup. -/
@[simp] theorem mem_secondFactor (x : C × C) : x ∈ secondFactor C ↔ x.1 = 1 := by
  simp [secondFactor, mem_prod]

/-- The automorphism interchanges the two actual coordinate subgroups. -/
def ExchangesFactors (a : MulAut (C × C)) : Prop :=
  (firstFactor C).map a.toMonoidHom = secondFactor C ∧
  (secondFactor C).map a.toMonoidHom = firstFactor C

/-- The automorphism preserves each actual coordinate subgroup. -/
def PreservesFactors (a : MulAut (C × C)) : Prop :=
  (firstFactor C).map a.toMonoidHom = firstFactor C ∧
  (secondFactor C).map a.toMonoidHom = secondFactor C

/-- A swap-invariant subgroup of order three has an injective first projection.
If the projection were trivial, swapping would force the whole subgroup to be trivial. -/
theorem fst_injective (τ : MulAut (C × C)) (hτ : ExchangesFactors τ)
    (D : Subgroup (C × C)) (hD : Nat.card D = 3)
    (hτD : D.map τ.toMonoidHom = D) :
    Function.Injective (fun x : D => (x : C × C).1) := by
  let f : D →* C := (MonoidHom.fst C C).comp D.subtype
  let : Fact (Nat.card D).Prime := ⟨hD ▸ Nat.prime_three⟩
  apply f.ker_eq_bot_iff.mp
  rcases f.ker.eq_bot_or_eq_top_of_prime_card with h | h
  · exact h
  have hfst (x : D) : (x : C × C).1 = 1 := by
    exact (show x ∈ f.ker from h ▸ mem_top x)
  have hall (x : D) : x = 1 := by
    have hright : (x : C × C) ∈ secondFactor C := (mem_secondFactor _).mpr (hfst x)
    have hleft : τ x ∈ firstFactor C := hτ.2 ▸ mem_map_of_mem τ.toMonoidHom hright
    have hmem : τ x ∈ D := hτD.le (mem_map_of_mem τ.toMonoidHom x.property)
    have he : τ x = 1 := Prod.ext (hfst ⟨τ x, hmem⟩) ((mem_firstFactor _).mp hleft)
    exact Subtype.ext (τ.injective (he.trans (map_one τ).symm))
  have hbot : D = ⊥ := eq_bot_iff.mpr fun x hx => congrArg Subtype.val (hall ⟨x, hx⟩)
  have hc := D.eq_bot_iff_card.mp hbot
  omega

/-- A swap-invariant subgroup of order three has an injective second projection. -/
theorem snd_injective (τ : MulAut (C × C)) (hτ : ExchangesFactors τ)
    (D : Subgroup (C × C)) (hD : Nat.card D = 3)
    (hτD : D.map τ.toMonoidHom = D) :
    Function.Injective (fun x : D => (x : C × C).2) := by
  let f : D →* C := (MonoidHom.snd C C).comp D.subtype
  let : Fact (Nat.card D).Prime := ⟨hD ▸ Nat.prime_three⟩
  apply f.ker_eq_bot_iff.mp
  rcases f.ker.eq_bot_or_eq_top_of_prime_card with h | h
  · exact h
  have hsnd (x : D) : (x : C × C).2 = 1 := by
    exact (show x ∈ f.ker from h ▸ mem_top x)
  have hall (x : D) : x = 1 := by
    have hleft : (x : C × C) ∈ firstFactor C := (mem_firstFactor _).mpr (hsnd x)
    have hright : τ x ∈ secondFactor C := hτ.1 ▸ mem_map_of_mem τ.toMonoidHom hleft
    have hmem : τ x ∈ D := hτD.le (mem_map_of_mem τ.toMonoidHom x.property)
    have he : τ x = 1 := Prod.ext ((mem_secondFactor _).mp hright) (hsnd ⟨τ x, hmem⟩)
    exact Subtype.ext (τ.injective (he.trans (map_one τ).symm))
  have hbot : D = ⊥ := eq_bot_iff.mpr fun x hx => congrArg Subtype.val (hall ⟨x, hx⟩)
  have hc := D.eq_bot_iff_card.mp hbot
  omega

private theorem card_map_of_restrict_injective {G H : Type*} [Group G] [Group H]
    (D : Subgroup G) (f : G →* H)
    (hf : Function.Injective (fun x : D => f x)) : Nat.card (D.map f) = Nat.card D := by
  exact Nat.card_image_of_injOn (fun x hx y hy h =>
    congrArg Subtype.val (hf (show f (⟨x, hx⟩ : D) = f (⟨y, hy⟩ : D) from h)))

private theorem cyclic_three_subgroups_eq [Finite C] [IsCyclic C] (A B : Subgroup C)
    (hA : Nat.card A = 3) (hB : Nat.card B = 3) : A = B := by
  classical
  let := Fintype.ofFinite C
  let R : Subgroup C := (powMonoidHom 3).ker
  have hR : Nat.card R ≤ 3 := by
    simpa [R, Nat.card_eq_fintype_card, Fintype.card_subtype] using
      (IsCyclic.card_pow_eq_one_le (α := C) (n := 3) (by decide))
  have hle (D : Subgroup C) (hD : Nat.card D = 3) : D ≤ R := by
    intro x hx
    have he := pow_card_eq_one' (x := (⟨x, hx⟩ : D))
    rw [hD] at he
    exact congrArg Subtype.val he
  exact (eq_of_le_of_card_ge (hle A hA) (hA ▸ hR)).trans
    (eq_of_le_of_card_ge (hle B hB) (hB ▸ hR)).symm

/-- Each coordinate image of a swap-invariant marking has order three. -/
theorem projection_cards (τ : MulAut (C × C)) (hτ : ExchangesFactors τ)
    (D : Subgroup (C × C)) (hD : Nat.card D = 3)
    (hτD : D.map τ.toMonoidHom = D) :
    Nat.card (D.map (MonoidHom.fst C C)) = 3 ∧
    Nat.card (D.map (MonoidHom.snd C C)) = 3 :=
  ⟨(card_map_of_restrict_injective _ _ (fst_injective τ hτ D hD hτD)).trans hD,
    (card_map_of_restrict_injective _ _ (snd_injective τ hτ D hD hτD)).trans hD⟩

/-- Two swap-invariant order-three markings have equal images in each cyclic coordinate.
The images are derived from the actual projections, without chosen diagonal embeddings. -/
theorem projected_images_eq [Finite C] [IsCyclic C]
    (τ : MulAut (C × C)) (hτ : ExchangesFactors τ)
    (D₀ Dplus : Subgroup (C × C)) (hD₀ : Nat.card D₀ = 3) (hDplus : Nat.card Dplus = 3)
    (hτ₀ : D₀.map τ.toMonoidHom = D₀) (hτplus : Dplus.map τ.toMonoidHom = Dplus) :
    D₀.map (MonoidHom.fst C C) = Dplus.map (MonoidHom.fst C C) ∧
    D₀.map (MonoidHom.snd C C) = Dplus.map (MonoidHom.snd C C) := by
  obtain ⟨hf₀, hs₀⟩ := projection_cards τ hτ D₀ hD₀ hτ₀
  obtain ⟨hfplus, hsplus⟩ := projection_cards τ hτ Dplus hDplus hτplus
  exact ⟨cyclic_three_subgroups_eq _ _ hf₀ hfplus,
    cyclic_three_subgroups_eq _ _ hs₀ hsplus⟩

private theorem fst_preserving (α : MulAut (C × C)) (hα : PreservesFactors α)
    (x : C × C) : (α x).1 = (α (x.1, 1)).1 := by
  have h : (α (1, x.2)).1 = 1 := (mem_secondFactor _).mp
    (hα.2.le (mem_map_of_mem α.toMonoidHom (by simp)))
  have he : x = (x.1, 1) * (1, x.2) := by ext <;> simp
  simpa only [map_mul, Prod.fst_mul, h, mul_one] using
    congrArg (fun z => (α z).1) he

private theorem snd_preserving (α : MulAut (C × C)) (hα : PreservesFactors α)
    (x : C × C) : (α x).2 = (α (1, x.2)).2 := by
  have h : (α (x.1, 1)).2 = 1 := (mem_firstFactor _).mp
    (hα.1.le (mem_map_of_mem α.toMonoidHom (by simp)))
  have he : x = (x.1, 1) * (1, x.2) := by ext <;> simp
  simpa only [map_mul, Prod.snd_mul, h, one_mul] using
    congrArg (fun z => (α z).2) he

/-- Fixing one marking and inverting the other rules out factor preservation.
Preservation would fix both projections of the second marking, forcing its
elements to have orders dividing both two and three. -/
theorem exchanges_of_markings [Finite C] [IsCyclic C]
    (τ α : MulAut (C × C)) (hτ : ExchangesFactors τ)
    (hα : PreservesFactors α ∨ ExchangesFactors α)
    (D₀ Dplus : Subgroup (C × C)) (hD₀ : Nat.card D₀ = 3) (hDplus : Nat.card Dplus = 3)
    (hτ₀ : D₀.map τ.toMonoidHom = D₀) (hτplus : Dplus.map τ.toMonoidHom = Dplus)
    (hfix : ∀ x ∈ D₀, α x = x) (hinv : ∀ x ∈ Dplus, α x = x⁻¹) :
    ExchangesFactors α := by
  rcases hα with hp | he
  · exfalso
    obtain ⟨hfst, hsnd⟩ := projected_images_eq τ hτ D₀ Dplus hD₀ hDplus hτ₀ hτplus
    have hfixplus (x : C × C) (hx : x ∈ Dplus) : α x = x := by
      apply Prod.ext
      · obtain ⟨y, hy, hey⟩ := mem_map.mp
          (hfst.ge (mem_map_of_mem (MonoidHom.fst C C) hx))
        change y.1 = x.1 at hey
        calc
          (α x).1 = (α (x.1, 1)).1 := fst_preserving α hp x
          _ = (α (y.1, 1)).1 := by rw [hey]
          _ = (α y).1 := (fst_preserving α hp y).symm
          _ = x.1 := by rw [hfix y hy, hey]
      · obtain ⟨y, hy, hey⟩ := mem_map.mp
          (hsnd.ge (mem_map_of_mem (MonoidHom.snd C C) hx))
        change y.2 = x.2 at hey
        calc
          (α x).2 = (α (1, x.2)).2 := snd_preserving α hp x
          _ = (α (1, y.2)).2 := by rw [hey]
          _ = (α y).2 := (snd_preserving α hp y).symm
          _ = x.2 := by rw [hfix y hy, hey]
    have hbot : Dplus = ⊥ := eq_bot_iff.mpr fun x hx => by
      have htwo : x ^ 2 = 1 := by
        calc
          x ^ 2 = α x * x := by rw [hfixplus x hx, pow_two]
          _ = 1 := by rw [hinv x hx, inv_mul_cancel]
      have hthree : x ^ 3 = 1 := by
        have h := pow_card_eq_one' (x := (⟨x, hx⟩ : Dplus))
        rw [hDplus] at h
        exact congrArg Subtype.val h
      simpa [pow_succ, htwo] using hthree
    have hc := Dplus.eq_bot_iff_card.mp hbot
    omega
  · exact he

/-- The subgroup generated by the actual displacements `α x * x⁻¹`. -/
def displacement {H : Type*} [Group H] (α : MulAut H) : Subgroup H :=
  closure (Set.range (fun x => α x * x⁻¹))

/-- Every displacement belongs to the displacement subgroup. -/
theorem displacement_mem {H : Type*} [Group H] (α : MulAut H) (x : H) :
    α x * x⁻¹ ∈ displacement α := subset_closure ⟨x, rfl⟩

/-- Factor exchange makes the first displacement projection surjective.
The displacement of `(c⁻¹, 1)` has first coordinate `c`. -/
theorem fst_displacement_surjective (α : MulAut (C × C)) (hα : ExchangesFactors α) :
    Function.Surjective ((MonoidHom.fst C C).comp (displacement α).subtype) := by
  intro c
  have h : (α (c⁻¹, 1)).1 = 1 := (mem_secondFactor _).mp
    (hα.1.le (mem_map_of_mem α.toMonoidHom (by simp)))
  refine ⟨⟨α (c⁻¹, 1) * (c⁻¹, 1)⁻¹, displacement_mem α _⟩, ?_⟩
  change (α (c⁻¹, 1)).1 * (c⁻¹)⁻¹ = c
  rw [h, one_mul, inv_inv]

/-- Factor exchange makes the second displacement projection surjective.
The displacement of `(1, c⁻¹)` has second coordinate `c`. -/
theorem snd_displacement_surjective (α : MulAut (C × C)) (hα : ExchangesFactors α) :
    Function.Surjective ((MonoidHom.snd C C).comp (displacement α).subtype) := by
  intro c
  have h : (α (1, c⁻¹)).2 = 1 := (mem_firstFactor _).mp
    (hα.2.le (mem_map_of_mem α.toMonoidHom (by simp)))
  refine ⟨⟨α (1, c⁻¹) * (1, c⁻¹)⁻¹, displacement_mem α _⟩, ?_⟩
  change (α (1, c⁻¹)).2 * (c⁻¹)⁻¹ = c
  rw [h, one_mul, inv_inv]

/-- Both coordinate images of displacement are the full cyclic factors. -/
theorem displacement_projection_maps (α : MulAut (C × C)) (hα : ExchangesFactors α) :
    (displacement α).map (MonoidHom.fst C C) = ⊤ ∧
    (displacement α).map (MonoidHom.snd C C) = ⊤ := by
  constructor
  · rw [← Subgroup.range_subtype (displacement α), ← MonoidHom.range_comp]
    exact MonoidHom.range_eq_top.mpr (fst_displacement_surjective α hα)
  · rw [← Subgroup.range_subtype (displacement α), ← MonoidHom.range_comp]
    exact MonoidHom.range_eq_top.mpr (snd_displacement_surjective α hα)

/-- Both displacement projections are onto under the original marking hypotheses. -/
theorem displacement_projection_maps_of_markings [Finite C] [IsCyclic C]
    (τ α : MulAut (C × C)) (hτ : ExchangesFactors τ)
    (hα : PreservesFactors α ∨ ExchangesFactors α)
    (D₀ Dplus : Subgroup (C × C)) (hD₀ : Nat.card D₀ = 3) (hDplus : Nat.card Dplus = 3)
    (hτ₀ : D₀.map τ.toMonoidHom = D₀) (hτplus : Dplus.map τ.toMonoidHom = Dplus)
    (hfix : ∀ x ∈ D₀, α x = x) (hinv : ∀ x ∈ Dplus, α x = x⁻¹) :
    (displacement α).map (MonoidHom.fst C C) = ⊤ ∧
    (displacement α).map (MonoidHom.snd C C) = ⊤ :=
  displacement_projection_maps α
    (exchanges_of_markings τ α hτ hα D₀ Dplus hD₀ hDplus hτ₀ hτplus hfix hinv)

/-- An odd factor of a displacement group with primes only two and three is a three-group. -/
theorem isPGroup_of_displacement_primes [Finite C]
    (α : MulAut (C × C)) (hα : ExchangesFactors α) (hodd : Odd (Nat.card C))
    (hprime : ∀ p : ℕ, p.Prime → p ∣ Nat.card (displacement α) → p = 2 ∨ p = 3) :
    IsPGroup 3 C := by
  have hcard : Nat.card C ∣ Nat.card (displacement α) :=
    card_dvd_of_surjective _ (fst_displacement_surjective α hα)
  apply (isPGroup_iff_primeFactors_card_subset (p := 3) (G := C) (by decide)).mpr
  intro p hp
  obtain ⟨hpr, hpdvd, _⟩ := Nat.mem_primeFactors.mp hp
  have hp3 : p = 3 := (hprime p hpr (hpdvd.trans hcard)).resolve_left
    (fun hp2 => hodd.not_two_dvd_nat (hp2 ▸ hpdvd))
  subst p
  exact Nat.mem_primeFactors.mpr ⟨Nat.prime_three, dvd_rfl, by decide⟩

/-- The full marked-action hypotheses and the displacement prime restriction
force the cyclic factor to be a three-group; factor exchange is proved internally. -/
theorem isPGroup_of_markings [Finite C] [IsCyclic C]
    (τ α : MulAut (C × C)) (hτ : ExchangesFactors τ)
    (hα : PreservesFactors α ∨ ExchangesFactors α)
    (D₀ Dplus : Subgroup (C × C)) (hD₀ : Nat.card D₀ = 3) (hDplus : Nat.card Dplus = 3)
    (hτ₀ : D₀.map τ.toMonoidHom = D₀) (hτplus : Dplus.map τ.toMonoidHom = Dplus)
    (hfix : ∀ x ∈ D₀, α x = x) (hinv : ∀ x ∈ Dplus, α x = x⁻¹)
    (hodd : Odd (Nat.card C))
    (hprime : ∀ p : ℕ, p.Prime → p ∣ Nat.card (displacement α) → p = 2 ∨ p = 3) :
    IsPGroup 3 C :=
  isPGroup_of_displacement_primes α
    (exchanges_of_markings τ α hτ hα D₀ Dplus hD₀ hDplus hτ₀ hτplus hfix hinv) hodd hprime

/-- Under the marked-action hypotheses, the cyclic factor has three-power order. -/
theorem three_power_of_markings [Finite C] [IsCyclic C]
    (τ α : MulAut (C × C)) (hτ : ExchangesFactors τ)
    (hα : PreservesFactors α ∨ ExchangesFactors α)
    (D₀ Dplus : Subgroup (C × C)) (hD₀ : Nat.card D₀ = 3) (hDplus : Nat.card Dplus = 3)
    (hτ₀ : D₀.map τ.toMonoidHom = D₀) (hτplus : Dplus.map τ.toMonoidHom = Dplus)
    (hfix : ∀ x ∈ D₀, α x = x) (hinv : ∀ x ∈ Dplus, α x = x⁻¹)
    (hodd : Odd (Nat.card C))
    (hprime : ∀ p : ℕ, p.Prime → p ∣ Nat.card (displacement α) → p = 2 ∨ p = 3) :
    ∃ a : ℕ, Nat.card C = 3 ^ a :=
  (isPGroup_of_markings τ α hτ hα D₀ Dplus hD₀ hDplus hτ₀ hτplus hfix hinv hodd hprime).exists_card_eq

section Transport
variable {H K : Type*} [Group H] [Group K]

/-- A surjective equivariant homomorphism maps displacement onto displacement.
This holds for arbitrary groups, before passing to the abelian torus. -/
theorem map_displacement (β : MulAut H) (α : MulAut K)
    (q : H →* K) (hq : Function.Surjective q)
    (heq : ∀ x, q (β x) = α (q x)) :
    (displacement β).map q = displacement α := by
  rw [displacement, MonoidHom.map_closure, displacement]
  congr 1
  ext y
  constructor
  · rintro ⟨_, ⟨x, rfl⟩, rfl⟩
    exact ⟨q x, by simp [heq]⟩
  · rintro ⟨x, rfl⟩
    obtain ⟨z, rfl⟩ := hq x
    exact ⟨β z * z⁻¹, ⟨z, rfl⟩, by simp [heq]⟩

/-- Displacement cardinality divides the cardinality of displacement upstairs. -/
theorem displacement_card_dvd (β : MulAut H) (α : MulAut K)
    (q : H →* K) (hq : Function.Surjective q)
    (heq : ∀ x, q (β x) = α (q x)) :
    Nat.card (displacement α) ∣ Nat.card (displacement β) := by
  rw [← map_displacement β α q hq heq]
  exact card_map_dvd _ _

/-- Every restriction on prime divisors of displacement descends through a
surjective equivariant map. -/
theorem displacement_prime_restriction (β : MulAut H) (α : MulAut K)
    (q : H →* K) (hq : Function.Surjective q)
    (heq : ∀ x, q (β x) = α (q x)) (P : ℕ → Prop)
    (hP : ∀ p : ℕ, p.Prime → p ∣ Nat.card (displacement β) → P p) :
    ∀ p : ℕ, p.Prime → p ∣ Nat.card (displacement α) → P p := by
  intro p hp hpdvd
  exact hP p hp (hpdvd.trans (displacement_card_dvd β α q hq heq))

end Transport
section AmbientTransport
variable {G H : Type*} [Group G] [Group H]

/-- If the actual action on `B` is conjugation by `s`, its displacements lie
in the ambient subgroup `⁅B, zpowers s⁆`. No ambient normality of `B` is assumed. -/
theorem displacement_map_le_commutator (B : Subgroup G) (s : G) (β : MulAut B)
    (hconj : ∀ b : B, (β b : G) = s * b * s⁻¹) :
    (displacement β).map B.subtype ≤ ⁅B, zpowers s⁆ := by
  rw [map_le_iff_le_comap, displacement, closure_le]
  rintro _ ⟨b, rfl⟩
  change (β b : G) * (b : G)⁻¹ ∈ ⁅B, zpowers s⁆
  rw [hconj, commutator_comm B (zpowers s)]
  exact commutator_mem_commutator (mem_zpowers s) b.property

/-- A surjective equivariant image of the conjugation action on `B` has
displacement cardinality dividing the actual ambient commutator cardinality. -/
theorem displacement_card_dvd_commutator (B : Subgroup G) (s : G) (β : MulAut B)
    (hconj : ∀ b : B, (β b : G) = s * b * s⁻¹)
    (α : MulAut H) (q : B →* H) (hq : Function.Surjective q)
    (heq : ∀ b, q (β b) = α (q b)) :
    Nat.card (displacement α) ∣ Nat.card (⁅B, zpowers s⁆ : Subgroup G) := by
  have hcard := card_dvd_of_le (displacement_map_le_commutator B s β hconj)
  rw [card_map_of_injective B.subtype_injective] at hcard
  exact (displacement_card_dvd β α q hq heq).trans hcard

/-- Transport prime restrictions from the actual ambient `⁅B, zpowers s⁆`
through the torus map. For the Cartan argument take `P p := p = 2 ∨ p = 3`. -/
theorem displacement_prime_restriction_of_commutator
    (B : Subgroup G) (s : G) (β : MulAut B)
    (hconj : ∀ b : B, (β b : G) = s * b * s⁻¹)
    (α : MulAut H) (q : B →* H) (hq : Function.Surjective q)
    (heq : ∀ b, q (β b) = α (q b)) (P : ℕ → Prop)
    (hP : ∀ p : ℕ, p.Prime → p ∣ Nat.card (⁅B, zpowers s⁆ : Subgroup G) → P p) :
    ∀ p : ℕ, p.Prime → p ∣ Nat.card (displacement α) → P p := by
  intro p hp hpdvd
  exact hP p hp (hpdvd.trans (displacement_card_dvd_commutator B s β hconj α q hq heq))

end AmbientTransport
end CFSG.Quasithin.Chapter13.Section08.Components.Swapped.LinearTwo.CartanAction

