module

public import CFSG.Quasithin.Chapter13.Section08.LocalAnalysis.Components.Swapped.LinearTwo.BorelDiagonal.BinaryBorel
public import Theory.GroupTheory.PResidual.PerfectCover
public import Theory.GroupTheory.PResidual.NormalSubgroup
public import Theory.GroupTheory.PrimeOrderLift

/-!
# Recovering L₁ as the lifted Borel's two-residual

At field order four, every odd-order element in the binary product Borel
has order dividing three. The same holds in any group mapping to that
Borel with two-group kernel. Its two-residual is generated by these
odd-order elements, so 13.7.3(9), L₁ = θ(H ∩ M), puts the residual of a
Borel lift inside L₁. Two-perfectness gives the reverse inclusion.

This proves the terminal residual equality once the Cartan argument has
established n = 2. It does not assume that the entire lifted Borel is
two-perfect or replace its two-residual by its two-core.

Source: Aschbacher–Smith, proof of 13.8.16(1), printed p.952/PDF p.969,
combined manuscript of 1 March 2004.
-/

@[expose] public section

open Subgroup
namespace CFSG.Quasithin.Chapter13.Section08.Components.Swapped.LinearTwo.BorelResiduals
variable {Q : Type*} [Group Q] [Finite Q]

private theorem factor_odd_order_dvd_three (hmodel : ClassicalGroup.IsPSL Q 2 4)
    (S : Sylow 2 Q) (x : BinaryBorel.borel S) (hx : Nat.Coprime 2 (orderOf x)) :
    orderOf x ∣ 3 := by
  have hc : orderOf x ∣ 4 * 3 := by
    simpa [(BinaryBorel.factor_facts (n := 2) (by decide) hmodel S).2.2.2.2] using
      orderOf_dvd_natCard x
  exact (hx.symm.pow_right 2).dvd_of_dvd_mul_left hc

theorem odd_order_dvd_three {X : Type*} [Group X]
    (hmodel : ClassicalGroup.IsPSL Q 2 4) (S : Sylow 2 (Q × Q))
    (f : X →* BinaryBorel.borel S) (hk : IsPGroup 2 f.ker)
    (x : X) (hx : Nat.Coprime 2 (orderOf x)) : orderOf x ∣ 3 := by
  rw [← f.orderOf_map_eq_of_coprime_of_isPGroup_ker hk x hx,
    ← MulEquiv.orderOf_eq (BinaryBorel.coordinates S), Prod.orderOf]
  apply Nat.lcm_dvd
  · apply factor_odd_order_dvd_three hmodel
    exact hx.coprime_dvd_right (orderOf_map_dvd
      ((MonoidHom.fst _ _).comp ((BinaryBorel.coordinates S).toMonoidHom.comp f)) x)
  · apply factor_odd_order_dvd_three hmodel
    exact hx.coprime_dvd_right (orderOf_map_dvd
      ((MonoidHom.snd _ _).comp ((BinaryBorel.coordinates S).toMonoidHom.comp f)) x)

variable {G : Type*} [Group G] [Finite G]

theorem residual_le_marked (H M B₀ L₁ : Subgroup G)
    (hBH : B₀ ≤ H) (hBM : B₀ ≤ M)
    (htheta : L₁ = closure {x : G | x ∈ H ⊓ M ∧ orderOf x = 3})
    (hmodel : ClassicalGroup.IsPSL Q 2 4) (S : Sylow 2 (Q × Q))
    (f : B₀ →* BinaryBorel.borel S) (hk : IsPGroup 2 f.ker) :
    (pResidual 2 B₀).map B₀.subtype ≤ L₁ := by
  let R := pResidual 2 B₀
  have hgen := closure_coprime_order_eq_top_of_pResidual_eq_top 2
    ((pResidual_eq_top_iff 2 R).mpr (isPPerfect_pResidual 2))
  let j : R →* G := B₀.subtype.comp R.subtype
  have hle : closure {x : R | Nat.Coprime 2 (orderOf x)} ≤ L₁.comap j := by
    rw [closure_le]
    intro x hx
    change Nat.Coprime 2 (orderOf x) at hx
    have hodd : Nat.Coprime 2 (orderOf (x : B₀)) := by
      simpa only [Subgroup.orderOf_coe] using hx
    have hd : orderOf x ∣ 3 := by
      simpa only [Subgroup.orderOf_coe] using odd_order_dvd_three hmodel S f hk (x : B₀) hodd
    rcases (Nat.dvd_prime Nat.prime_three).mp hd with ho | ho
    · have he : x = 1 := orderOf_eq_one_iff.mp ho
      simp [he]
    · rw [htheta]
      apply Subgroup.subset_closure
      exact ⟨⟨hBH x.val.property, hBM x.val.property⟩,
        (orderOf_injective j (B₀.subtype_injective.comp R.subtype_injective) x).trans ho⟩
  rw [hgen] at hle
  rintro _ ⟨x, hx, rfl⟩
  exact hle (show (⟨x, hx⟩ : R) ∈ ⊤ from trivial)

theorem marked_eq_residual (H M B₀ L₁ : Subgroup G)
    (hBH : B₀ ≤ H) (hBM : B₀ ≤ M) (hLB : L₁ ≤ B₀) (hL : IsPPerfect 2 L₁)
    (htheta : L₁ = closure {x : G | x ∈ H ⊓ M ∧ orderOf x = 3})
    (hmodel : ClassicalGroup.IsPSL Q 2 4) (S : Sylow 2 (Q × Q))
    (f : B₀ →* BinaryBorel.borel S) (hk : IsPGroup 2 f.ker) :
    L₁ = (pResidual 2 B₀).map B₀.subtype := by
  apply le_antisymm
  · have he : (pResidual 2 L₁).map L₁.subtype = L₁ := by
      rw [(pResidual_eq_top_iff 2 L₁).mpr hL, ← MonoidHom.range_eq_map, range_subtype]
    rw [← he]
    exact embedded_pResidual_mono 2 hLB
  · exact residual_le_marked H M B₀ L₁ hBH hBM htheta hmodel S f hk

end CFSG.Quasithin.Chapter13.Section08.Components.Swapped.LinearTwo.BorelResiduals

end
