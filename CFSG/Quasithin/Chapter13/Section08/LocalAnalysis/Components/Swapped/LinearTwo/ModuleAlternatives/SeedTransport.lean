module

public import CFSG.Quasithin.Chapter13.Section08.LocalAnalysis.Components.Swapped.LinearTwo.ModuleAlternatives.SourceSeed
public import CFSG.Quasithin.Chapter13.Section08.LocalAnalysis.Components.Swapped.LinearTwo.MaximalSection
public import CFSG.Quasithin.Chapter13.Section08.LocalAnalysis.Components.Swapped.LinearTwo.SeedProjection

/-!
# The source seed in invariant sections

The literal H-conjugate span supplies the orbit-span hypothesis for the
maximal-section construction. The quotient projection is equivariant,
retains the seed's commutator generation and fixation, and commutes with
the actual operator induced by the moving element. Its seed image is
nonzero, and irreducibility of the marked seed makes the projection
injective. These are the seed inputs to cases (a) and (b1) of 13.8.16.

If L₁ ≤ K₀ and the seed is generated by its L₁-commutators, every invariant
subspace containing [Ũ_H,K₀] contains the whole source module. This is
the generation step identifying the module in case (b2) with Ũ_H.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004,
proof of 13.8.16(1), printed p.952 (PDF p.969).
-/

@[expose] public noncomputable section

open Subgroup Representation Representation.BinaryOffender
open scoped IsMulCommutative commutatorElement
namespace CFSG.Quasithin.Chapter13.Section08.Components.Swapped.LinearTwo.ModuleAlternatives
open ComponentSieve.AlternatingAndLinear.FourStructure

section Linear
variable {D U V : Type*} [Group D] [AddCommGroup U] [Module (ZMod 2) U]
  [AddCommGroup V] [Module (ZMod 2) V]

/-- The operator is the given group element acting on the actual module. -/
def operator (ρ : Representation (ZMod 2) D U) (t : D) : U ≃ₗ[ZMod 2] U where
  toLinearMap := ρ t
  invFun := ρ t⁻¹
  left_inv := ρ.inv_self_apply t
  right_inv := ρ.self_inv_apply t

@[simp] theorem operator_apply (ρ : Representation (ZMod 2) D U) (t : D) (u : U) :
    operator ρ t u = ρ t u := rfl

/-- Setwise invariance gives equality under the actual operator, including
surjectivity on the subspace, by applying the inverse group element. -/
theorem map_operator_eq (ρ : Representation (ZMod 2) D U)
    (X : Submodule (ZMod 2) U) (A : Subgroup D)
    (hX : A ≤ subspaceStabilizer ρ X) {t : D} (ht : t ∈ A) :
    X.map (operator ρ t).toLinearMap = X := by
  apply le_antisymm
  · rintro _ ⟨u, hu, rfl⟩
    exact (hX ht u).mpr hu
  · intro u hu
    exact ⟨ρ t⁻¹ u, (hX (A.inv_mem ht) u).mpr hu, ρ.self_inv_apply t u⟩

/-- Equivariance transports the entire commutator subspace through a linear map;
neither injectivity nor a direct-sum decomposition is required. -/
theorem commutator_map (ρ : Representation (ZMod 2) D U)
    (σ : Representation (ZMod 2) D V) (f : U →ₗ[ZMod 2] V)
    (hf : ∀ g u, f (ρ g u) = σ g (f u)) (X : Submodule (ZMod 2) U) (A : Subgroup D) :
    (subspaceCommutator ρ X A).map f = subspaceCommutator σ (X.map f) A := by
  apply le_antisymm
  · rw [Submodule.map_le_iff_le_comap]
    apply Submodule.span_le.mpr
    rintro _ ⟨a, ha, u, hu, rfl⟩
    change f (ρ a u - u) ∈ subspaceCommutator σ (X.map f) A
    rw [map_sub, hf]
    exact Submodule.subset_span ⟨a, ha, f u, ⟨u, hu, rfl⟩, rfl⟩
  · apply Submodule.span_le.mpr
    rintro _ ⟨a, ha, _, ⟨u, hu, rfl⟩, rfl⟩
    exact ⟨ρ a u - u, Submodule.subset_span ⟨a, ha, u, hu, rfl⟩,
      by rw [map_sub, hf]⟩

/-- Quotient seed images retain their marked commutator generation. -/
theorem quotient_seed_commutator (ρ : Representation (ZMod 2) D U)
    (W : Subrepresentation ρ) (X : Submodule (ZMod 2) U) (A : Subgroup D)
    (hX : subspaceCommutator ρ X A = X) :
    subspaceCommutator W.quotientRepresentation (X.map W.toSubmodule.mkQ) A =
      X.map W.toSubmodule.mkQ := by
  rw [← commutator_map ρ W.quotientRepresentation W.toSubmodule.mkQ
    (fun g u => (W.quotientRepresentation_mk g u).symm), hX]

/-- Quotient seed images retain fixation by the marked L₀ image. -/
theorem quotient_seed_fixed (ρ : Representation (ZMod 2) D U)
    (W : Subrepresentation ρ) (X : Submodule (ZMod 2) U) (A : Subgroup D)
    (hX : X ≤ fixedSpace ρ A) :
    X.map W.toSubmodule.mkQ ≤ fixedSpace W.quotientRepresentation A := by
  rintro _ ⟨u, hu, rfl⟩ a
  change W.quotientRepresentation (a : D) (W.toSubmodule.mkQ u) = W.toSubmodule.mkQ u
  rw [W.quotientRepresentation_mk]
  exact congrArg W.toSubmodule.mkQ (hX hu a)

/-- The actual quotient operator preserves the projected seed. -/
theorem quotient_seed_swap (ρ : Representation (ZMod 2) D U)
    (W : Subrepresentation ρ) (X : Submodule (ZMod 2) U) (t : D)
    (hX : X.map (operator ρ t).toLinearMap = X) :
    (X.map W.toSubmodule.mkQ).map (operator W.quotientRepresentation t).toLinearMap =
      X.map W.toSubmodule.mkQ := by
  rw [← Submodule.map_comp]
  have he : (operator W.quotientRepresentation t).toLinearMap.comp W.toSubmodule.mkQ =
      W.toSubmodule.mkQ.comp (operator ρ t).toLinearMap := by
    ext u
    exact W.quotientRepresentation_mk t u
  rw [he, Submodule.map_comp, hX]

/-- The linear span of an entire seed orbit, with its invariance proved. -/
def seedSpan (ρ : Representation (ZMod 2) D U) (X : Submodule (ZMod 2) U) :
    Subrepresentation ρ where
  toSubmodule := Submodule.span (ZMod 2) {u | ∃ g : D, ∃ x ∈ X, u = ρ g x}
  apply_mem_toSubmodule g := by
    intro u hu
    induction hu using Submodule.span_induction with
    | mem u hu =>
      obtain ⟨h, x, hx, rfl⟩ := hu
      exact Submodule.subset_span ⟨g * h, x, hx, by rw [map_mul]; rfl⟩
    | zero => simpa only [map_zero] using (Submodule.zero_mem _)
    | add u v _ _ hu hv => simpa only [map_add] using Submodule.add_mem _ hu hv
    | smul a u _ hu => simpa only [map_smul] using Submodule.smul_mem _ a hu

/-- Normality of the acting subgroup makes its whole commutator an ambient
subrepresentation. In the source this is normality of K₀* inside H*. -/
def movedSubrepresentation (ρ : Representation (ZMod 2) D U) (A : Subgroup D)
    [A.Normal] : Subrepresentation ρ where
  toSubmodule := subspaceCommutator ρ ⊤ A
  apply_mem_toSubmodule g := by
    intro u hu
    induction hu using Submodule.span_induction with
    | mem u hu =>
      obtain ⟨a, ha, x, _, rfl⟩ := hu
      rw [map_sub]
      have he : ρ g (ρ a x) = ρ (g * a * g⁻¹) (ρ g x) := by
        simp only [map_mul, Module.End.mul_apply, inv_self_apply]
      rw [he]
      exact Submodule.subset_span
        ⟨g * a * g⁻¹, (inferInstance : A.Normal).conj_mem a ha g,
          ρ g x, Submodule.mem_top, rfl⟩
    | zero => simpa only [map_zero] using (Submodule.zero_mem _)
    | add u v _ _ hu hv => simpa only [map_add] using Submodule.add_mem _ hu hv
    | smul a u _ hu => simpa only [map_smul] using Submodule.smul_mem _ a hu

end Linear

/-- L₁ ≤ K₀ and H = K₀L₁T give the required relative normality of K₀,
using the actual T-conjugate span. -/
theorem orbit_normal {G : Type*} [Group G] (H K L₁ T : Subgroup G)
    (hH : H = conjugateSpanBy K T ⊔ (L₁ ⊔ T))
    (hL : L₁ ≤ conjugateSpanBy K T) :
    ((conjugateSpanBy K T).subgroupOf H).Normal := by
  have hKH : conjugateSpanBy K T ≤ H := by rw [hH]; exact le_sup_left
  apply (normal_subgroupOf_iff_le_normalizer hKH).mpr
  rw [hH]
  exact sup_le (conjugateSpanBy K T).le_normalizer
    (sup_le (hL.trans (conjugateSpanBy K T).le_normalizer)
      (le_normalizer_conjugateSpanBy K T))

/-- The literal component-orbit image is normal in H*. -/
theorem orbit_star_normal {G : Type*} [Group G] (H K L₁ T : Subgroup G)
    (hH : H = conjugateSpanBy K T ⊔ (L₁ ⊔ T))
    (hL : L₁ ≤ conjugateSpanBy K T) :
    (Source.starImage H (conjugateSpanBy K T)).Normal :=
  (orbit_normal H K L₁ T hH hL).map (QuotientGroup.mk' (pCore 2 H))
    (QuotientGroup.mk'_surjective _)

section Source
variable {G : Type*} [Group G] (H V₃ V₁ : Subgroup G)
  [(V₁.subgroupOf (Source.UH H V₃)).Normal]
  [IsElementaryAbelian 2 (Source.Utilde H V₃ V₁)]
  (ρ : Representation (ZMod 2) (Source.Hstar H) (ChiefFactors.SourceSpace H V₃ V₁))
  (hρ : ChiefFactors.IsSourceAction H V₃ V₁ ρ)

include hρ

/-- The existing group generation theorem gives the literal linear orbit span. -/
theorem source_seed_span :
    Submodule.span (ZMod 2)
      {u | ∃ g : Source.Hstar H, ∃ x ∈ ChiefFactors.sourceSeedSpace H V₃ V₁, u = ρ g x} = ⊤ := by
  apply congrArg Subrepresentation.toSubmodule
    (ChiefFactors.sourceSeedSpace_generates H V₃ V₁ ρ hρ
      (seedSpan ρ (ChiefFactors.sourceSeedSpace H V₃ V₁)) ?_)
  intro x hx
  exact Submodule.subset_span ⟨1, x, hx, by simp⟩

/-- The actual element of T preserves the source seed, hence also its image
in every invariant quotient. -/
theorem source_seed_swap (T : Subgroup G) (hT : T ≤ normalizer (V₃ : Set G))
    (t : H) (ht : (t : G) ∈ T) :
    (ChiefFactors.sourceSeedSpace H V₃ V₁).map
      (operator ρ (QuotientGroup.mk' (pCore 2 H) t)).toLinearMap =
        ChiefFactors.sourceSeedSpace H V₃ V₁ :=
  map_operator_eq ρ _ (Source.starImage H T)
    (image_stable H V₃ V₁ ρ hρ T V₃ hT) ⟨t, ht, rfl⟩

/-- The literal quotient map on the marked source seed is injective.
Its equivariance is `seedQuotientMap.isIntertwining`; no arbitrary
isomorphism between equal-dimensional spaces is used. -/
theorem source_seed_projection_injective (L : Subgroup G) (hLH : L ≤ H)
    (hL : L ≤ normalizer (V₃ : Set G)) (hline : V₁ < V₃)
    (hirr : ∀ X : Subgroup G, V₁ ≤ X → X ≤ V₃ →
      L ≤ normalizer (X : Set G) → X = V₁ ∨ X = V₃)
    (W : Subrepresentation ρ) (hW : W ≠ ⊤) :
    Function.Injective (seedQuotientMap ρ (Source.starImage H L)
      (markedSeed H V₃ V₁ ρ hρ L hL) W) := by
  let := markedSeed_irreducible H V₃ V₁ ρ hρ L hLH hL hline hirr
  apply seedQuotientMap_injective
  exact seed_not_le_proper ρ _ (source_seed_span H V₃ V₁ ρ hρ) W hW

/-- Select W in the actual source representation and construct its nonzero
seed projection. Only H*-maximality is asserted. -/
theorem exists_source_maximal_section [Finite G]
    (D : Submodule (ZMod 2) (ChiefFactors.SourceSpace H V₃ V₁)) (hD : D ≠ ⊥) :
    ∃ W : Subrepresentation ρ, ¬ D ≤ W.toSubmodule ∧
      (∀ Y : Subrepresentation ρ, W ≤ Y → ¬ D ≤ Y.toSubmodule → Y = W) ∧
      (ChiefFactors.sourceSeedSpace H V₃ V₁).map W.toSubmodule.mkQ ≠ ⊥ := by
  obtain ⟨W, hW, hmax⟩ := exists_maximal_avoiding ρ D hD
  refine ⟨W, hW, hmax, seed_image_ne_bot_of_generates ρ _
    (source_seed_span H V₃ V₁ ρ hρ) W ?_⟩
  intro he
  apply hW
  rw [he]
  exact le_top

/-- Containment of L₁ in K₀ and seed commutator generation force every
invariant overmodule of [Ũ_H,K₀] to be the full source module. -/
theorem source_section_eq_top (L₁ K₀ : Subgroup G) (hLK : L₁ ≤ K₀)
    (hgen : subspaceCommutator ρ (ChiefFactors.sourceSeedSpace H V₃ V₁)
      (Source.starImage H L₁) = ChiefFactors.sourceSeedSpace H V₃ V₁)
    (U : Subrepresentation ρ)
    (hU : subspaceCommutator ρ ⊤ (Source.starImage H K₀) ≤ U.toSubmodule) : U = ⊤ := by
  apply ChiefFactors.sourceSeedSpace_generates H V₃ V₁ ρ hρ
  rw [← hgen]
  apply Submodule.span_le.mpr
  rintro _ ⟨a, ha, x, _, rfl⟩
  exact hU (Submodule.subset_span ⟨a,
    Subgroup.map_mono (Subgroup.subgroupOf_mono H hLK) ha, x, Submodule.mem_top, rfl⟩)

/-- The actual source module is its K₀-commutator. This follows from
L₁ ≤ K₀ and seed generation, before any module-classification alternative. -/
theorem source_moved_eq_top (K L₁ T : Subgroup G)
    (hH : H = conjugateSpanBy K T ⊔ (L₁ ⊔ T))
    (hL : L₁ ≤ conjugateSpanBy K T)
    (hLN : L₁ ≤ normalizer (V₃ : Set G)) (hline : V₁ ≤ V₃)
    (hseed : V₃ ≤ ⁅L₁, V₃⁆ ⊔ V₁) :
    subspaceCommutator ρ ⊤ (Source.starImage H (conjugateSpanBy K T)) = ⊤ := by
  let := orbit_star_normal H K L₁ T hH hL
  have hLH : L₁ ≤ H := by rw [hH]; exact le_sup_left.trans le_sup_right
  have hgen := image_commutator_eq H V₃ V₁ ρ hρ L₁ V₃ hLH
    (le_conjugateSpanBy V₃ H) hLN (hline.trans (le_conjugateSpanBy V₃ H)) hseed
  exact congrArg Subrepresentation.toSubmodule
    (source_section_eq_top H V₃ V₁ ρ hρ L₁ (conjugateSpanBy K T) hL hgen
      (movedSubrepresentation ρ (Source.starImage H (conjugateSpanBy K T))) le_rfl)

end Source
end CFSG.Quasithin.Chapter13.Section08.Components.Swapped.LinearTwo.ModuleAlternatives
