/-!
# Excluding the source factor-module alternatives in 13.8.16

The original Borel theorem gives the equality of the two marked cosets.
The actual seed is fixed by L₀, generated by L₁,+ commutators, stable under
the moving element, and spans U_H/V₁ under H*. These properties descend
through every proper H*-quotient with nonzero seed image. Restriction to
K₀* makes its two factors normal; their canonical commutator spaces and
actual exchange operator give the projection contradiction, even when the
sum is not direct.

Consequently the independent source module dichotomy forces an actual
orthogonal identification. That dichotomy is an explicit remaining input,
not a theorem asserted by this module. The orthogonal critical-pair
argument and final contradiction remain separate source steps.
Source: Aschbacher--Smith, 13.8.16(1), printed pp.952--953.
-/

public noncomputable section
open scoped IsMulCommutative
open Subgroup Representation Representation.BinaryOffender Theory.GroupTheory
namespace CFSG.Quasithin.Chapter13.Section08.Components.Swapped.LinearTwo.Original
open ModuleAlternatives
section Linear
variable {D U : Type*} [Group D] [AddCommGroup U] [Module (ZMod 2) U]

private theorem fixedSpace_restrict (ρ : Representation (ZMod 2) D U)
    (N A : Subgroup D) (hAN : A ≤ N) :
    fixedSpace (ρ.comp N.subtype) (A.subgroupOf N) = fixedSpace ρ A := by
  ext u
  constructor
  · intro hu a
    exact hu ⟨⟨a, hAN a.property⟩, a.property⟩
  · intro hu a
    exact hu ⟨a, a.property⟩

private theorem cross_factor_contradiction (ρ : Representation (ZMod 2) D U)
    (N A B Z P : Subgroup D)
    (hAN : A ≤ N) (hBN : B ≤ N) (hZN : Z ≤ N) (hPN : P ≤ N)
    [(A.subgroupOf N).Normal] [(B.subgroupOf N).Normal]
    (hAB : A ⊔ B = N) (hfull : subspaceCommutator ρ ⊤ N = ⊤)
    (t : D) (hswap : B.conjBy t = A)
    (hcrossA : subspaceCommutator ρ ⊤ A ≤ fixedSpace ρ B)
    (hcrossB : subspaceCommutator ρ ⊤ B ≤ fixedSpace ρ A)
    (X : Submodule (ZMod 2) U) (hne : X ≠ ⊥)
    (hgen : subspaceCommutator ρ X P = X)
    (hfix : X ≤ fixedSpace ρ Z)
    (hstable : X.map (operator ρ t).toLinearMap = X)
    (hcoset : P ≤ Z ⊔ B) : False := by
  let σ := ρ.comp N.subtype
  let A' := A.subgroupOf N
  let B' := B.subgroupOf N
  have hrel : A' ⊔ B' = ⊤ := by
    rw [← subgroupOf_sup hAN hBN, hAB, subgroupOf_self]
  have hc (Y : Submodule (ZMod 2) U) (C : Subgroup D) (hCN : C ≤ N) :
      subspaceCommutator σ Y (C.subgroupOf N) = subspaceCommutator ρ Y C := by
    rw [subspaceCommutator_comp_map, map_subgroupOf_eq_of_le hCN]
  have hfull' : subspaceCommutator σ ⊤ ⊤ = ⊤ := by
    change subspaceCommutator (ρ.comp N.subtype) ⊤ ⊤ = ⊤
    rw [subspaceCommutator_comp_map, ← MonoidHom.range_eq_map, range_subtype, hfull]
  apply not_sum_of_diagonal_seed σ (movedSubrepresentation σ A')
    (movedSubrepresentation σ B') X A' B' (Z.subgroupOf N) (P.subgroupOf N)
    (operator ρ t) (factor_spaces_sum σ A' B' hrel hfull') hne
  · rw [hc X P hPN]
    exact hgen
  · rw [hrel]
    exact le_top
  · change subspaceCommutator σ ⊤ B' ≤ fixedSpace σ A'
    rw [hc ⊤ B hBN, fixedSpace_restrict ρ N A hAN]
    exact hcrossB
  · change subspaceCommutator σ ⊤ A' ≤ fixedSpace σ B'
    rw [hc ⊤ A hAN, fixedSpace_restrict ρ N B hBN]
    exact hcrossA
  · exact hstable
  · change (subspaceCommutator σ ⊤ B').map (operator ρ t).toLinearMap ≤
      subspaceCommutator σ ⊤ A'
    rw [hc ⊤ B hBN, hc ⊤ A hAN,
      moved_map_automorphism ρ (MulAut.conj t) (operator ρ t) ?_ B]
    · change subspaceCommutator ρ ⊤ (B.conjBy t) ≤ subspaceCommutator ρ ⊤ A
      rw [hswap]
    · intro g u
      change ρ t (ρ g u) = ρ (t * g * t⁻¹) (ρ t u)
      simp only [map_mul, Module.End.mul_apply, inv_self_apply]
  · rw [← subgroupOf_sup hZN hBN]
    exact subgroupOf_mono N hcoset
  · rw [fixedSpace_restrict ρ N Z hZN]
    exact hfix
end Linear

open SourceCompletion TransvectionRecognition.Component.ModelExtension
open ComponentSieve.FieldComponents.LinearThree.Geometry.CoveredProduct.ResidualPlacement
open ComponentSieve.AlternatingAndLinear.FourStructure.ChiefFactors
variable {G : Type*} [Group G] [Finite G]
  {T : Sylow 2 G} {L V V₁ V₂ V₃ M G₁ H K : Subgroup G}
  (d : LocalSetup T L V V₁ V₂ V₃ M G₁)
  (h : Chapter12.Section02.Hypothesis1221 KnownSimple.IsKnownSimple T L)
  (hF9all : ∀ J ∈ Source.Hz (one L T V₁) T G₁ M,
    (Section07.ConjugateIntersections.sourceSetup T L V V₃ V₁ J).Hypothesis)
  (hcentral : centralizer (V₃ : Set G) ≤ M ⊓ normalizer (V : Set G))
  (hcomm : ⁅V₃, G₁.pCoreIn 2⁆ ≠ ⊥)
  (hsource : SolvableExclusion.Residual.Source1339 L (one L T V₁) (plus L T V₁) T M V V₁)
  (hH : H ∈ Source.Hz (one L T V₁) T G₁ M)
  (hKH : K ≤ H) (hK : (K.subgroupOf H).IsCComponent)
  (hgen : conjugateSpanBy K (T : Subgroup G) ⊔ (one L T V₁ ⊔ (T : Subgroup G)) = H)
  (hmoving : conjugateSpanBy K (T : Subgroup G) ≠ K)
include d h hF9all hcentral hcomm hsource hH hKH hK hgen hmoving

/-- Source cases (a) and (b1) are impossible. The sole additional input is
their cross-factor conclusion on an actual proper H*-quotient; every marked
seed, coset, exchange and whole-commutator premise is proved here. -/
theorem false_of_cross_factor_quotient {n : ℕ} (hn : 2 ≤ n)
    (hmodel : ClassicalGroup.IsPSL (Source.starImage H K) 2 (2 ^ n))
    [IsElementaryAbelian 2 (Source.UH H V₃)]
    (ρ : Representation (ZMod 2) (Source.Hstar H) (SourceSpace H V₃ V₁))
    (hρ : IsSourceAction H V₃ V₁ ρ)
    {t : G} (ht : t ∈ T) (htn : t ∉ normalizer (K : Set G))
    (halternative : HasCrossFactorQuotient ρ (Source.starImage H K)
      (Source.starImage H (K.conjBy t))) : False := by
  have hi := moving_index d h hF9all hcentral hcomm hsource hH hKH hK hmoving
  have hTH : (T : Subgroup G) ≤ H := le_sup_right.trans hH.1.2
  have horbit := orbit_eq_two_conjugates H K T hKH hTH hi ht htn
  have hone := one_le_orbit d h hF9all hcentral hcomm hsource hH hKH hK hmoving hn hmodel
  obtain ⟨_, hcover, hz, hp, hcosets⟩ :=
    diagonal_cosets d h hF9all hcentral hcomm hsource hH hKH hK hgen hmoving hn hmodel ht htn
  obtain ⟨hJH, hJ⟩ := conjugate_isCComponent H K hKH hK (hTH ht)
  let N := Source.starImage H (conjugateSpanBy K (T : Subgroup G))
  let A := Source.starImage H K
  let B := Source.starImage H (K.conjBy t)
  have hAB : A ⊔ B = N := by
    rw [show N = Source.starImage H (K ⊔ K.conjBy t) from congrArg (Source.starImage H) horbit,
      starImage_sup H K _ hKH hJH]
  have hAN : A ≤ N := hAB ▸ le_sup_left
  have hBN : B ≤ N := hAB ▸ le_sup_right
  have hZN : Source.starImage H (zero L) ≤ N := map_mono (subgroupOf_mono H (hz.trans hone))
  have hPN : Source.starImage H (plus L T V₁) ≤ N := map_mono (subgroupOf_mono H (hp.trans hone))
  have hA := starImage_isCComponent H K hK
  have hB := starImage_isCComponent H (K.conjBy t) hJ
  let : (A.subgroupOf N).Normal := normal_subgroupOf_of_le_normalizer (by
    rw [← hAB]
    exact sup_le A.le_normalizer ((le_cComponentLayer hB).trans (cComponentLayer_le_normalizer hA)))
  let : (B.subgroupOf N).Normal := normal_subgroupOf_of_le_normalizer (by
    rw [← hAB]
    exact sup_le ((le_cComponentLayer hA).trans (cComponentLayer_le_normalizer hB)) B.le_normalizer)
  let tH : H := ⟨t, hTH ht⟩
  let ts := QuotientGroup.mk' (pCore 2 H) tH
  have hswap : B.conjBy ts = A := by
    have ht2 := (normalizer (K.subgroupOf H : Set H)).sq_mem_of_index_two hi tH
    rw [← subgroupOf_normalizer_eq hKH] at ht2
    change t ^ 2 ∈ normalizer (K : Set G) at ht2
    have heq : (K.conjBy t).conjBy t = K := by
      rw [← conjBy_mul]
      apply mem_normalizer_iff_map_conj_eq.mp
      simpa only [pow_two] using ht2
    change (Source.starImage H (K.conjBy t)).map
      (MulAut.conj (QuotientGroup.mk' (pCore 2 H) ⟨t, hTH ht⟩)).toMonoidHom = A
    rw [starImage_conjBy H _ hJH (hTH ht), heq]
  let X := sourceSeedSpace H V₃ V₁
  have hXgen : subspaceCommutator ρ X (Source.starImage H (plus L T V₁)) = X := by
    apply image_commutator_eq H V₃ V₁ ρ hρ _ V₃ (hp.trans (le_sup_left.trans hH.1.2))
      (le_conjugateSpanBy V₃ H)
      (hp.trans (Section07.ModelExclusions.point_residual_normalizes_seed (localNaturalSetup d)))
      (d.line_le_uh H)
    rw [commutator_comm, Section07.ModelExclusions.seed_commutator_plus (localNaturalSetup d) hcover]
    exact le_sup_left
  have hXfix : X ≤ fixedSpace ρ (Source.starImage H (zero L)) := by
    apply image_fixed H V₃ V₁ ρ hρ (zero L) V₃
    apply le_trans _ bot_le
    exact (commutator_eq_bot_iff_le_centralizer.mpr
      ((residual_le (centralPreimage L)).trans
        ((local_centralPreimage_centralizes d).trans (centralizer_le d.seed_le)))).le
  obtain ⟨W, hW, hcrossA, hcrossB⟩ := halternative
  have hfull := moved_eq_top d h hF9all hcentral hcomm hsource hH hKH hK hmoving
    hn hmodel hgen ρ hρ
  have hqfull : subspaceCommutator W.quotientRepresentation ⊤ N = ⊤ := by
    have hh := quotient_seed_commutator ρ W ⊤ N hfull
    simpa only [Submodule.map_top, Submodule.range_mkQ] using hh
  apply cross_factor_contradiction W.quotientRepresentation N A B
    (Source.starImage H (zero L)) (Source.starImage H (plus L T V₁))
    hAN hBN hZN hPN hAB hqfull ts hswap hcrossA hcrossB
    (X.map W.toSubmodule.mkQ)
    (seed_image_ne_bot_of_generates ρ X (source_seed_span H V₃ V₁ ρ hρ) W hW)
    (quotient_seed_commutator ρ W X _ hXgen) (quotient_seed_fixed ρ W X _ hXfix)
    (quotient_seed_swap ρ W X ts (source_seed_swap H V₃ V₁ ρ hρ T d.seed_stable tH ht))
  rw [hcosets]
  exact le_sup_left

/-- The independently proved module dichotomy will force the actual
orthogonal orbit, since both factor-module cases have been excluded above.
The orthogonal critical-pair contradiction remains a separate source step. -/
theorem orthogonal_of_module_alternatives {n : ℕ} (hn : 2 ≤ n)
    (hmodel : ClassicalGroup.IsPSL (Source.starImage H K) 2 (2 ^ n))
    [IsElementaryAbelian 2 (Source.UH H V₃)]
    (ρ : Representation (ZMod 2) (Source.Hstar H) (SourceSpace H V₃ V₁))
    (hρ : IsSourceAction H V₃ V₁ ρ)
    {t : G} (ht : t ∈ T) (htn : t ∉ normalizer (K : Set G))
    (halternative : HasCrossFactorQuotient ρ (Source.starImage H K)
        (Source.starImage H (K.conjBy t)) ∨
      HasOrthogonalFourOrbit ρ (Source.starImage H (conjugateSpanBy K (T : Subgroup G)))) :
    HasOrthogonalFourOrbit ρ (Source.starImage H (conjugateSpanBy K (T : Subgroup G))) := by
  exact halternative.resolve_left (fun hcross =>
    false_of_cross_factor_quotient d h hF9all hcentral hcomm hsource hH hKH hK hgen hmoving
      hn hmodel ρ hρ ht htn hcross)

end CFSG.Quasithin.Chapter13.Section08.Components.Swapped.LinearTwo.Original
