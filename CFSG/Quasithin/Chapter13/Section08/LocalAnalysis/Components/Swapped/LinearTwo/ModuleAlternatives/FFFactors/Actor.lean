module

public import CFSG.Quasithin.Chapter15.Section04.Configuration.LocalSetup.TwoFactors.FFBranch.Recognition.ClassificationComparison.FFAlternatives.SourceAlternatives
public import Theory.Representation.NormalPSubgroupKernel
public import Theory.Representation.Quotient

/-!
# Faithful images and the offender actor for 13.8.16(a)

Restriction to J(D,U) preserves faithfulness and makes offender generation
literal. Normality transfers a trivial two-core from D to J(D,U). Taking
an inverse image in a specified SQTK cover supplies the actual quotient
presentation required by B.5.3. The full universal classification contract
can then be applied, without assuming D itself is generated by offenders.

The marked fixed and commutator spaces are unchanged under the actual
action-image map and restriction to J. Irreducibility of the section kills
the two-core of its faithful image. Containment of the component images
in J remains explicit here; these lemmas do not select B.5.6(3).

Source: Aschbacher–Smith, combined manuscript (1 March 2004), B.5.3,
printed p.104, and the proof of 13.8.16(1), p.952 (PDF p.969).
-/

@[expose] public noncomputable section
open Subgroup Representation Representation.BinaryOffender
namespace CFSG.Quasithin.Chapter13.Section08.Components.Swapped.LinearTwo.ModuleAlternatives.FFFactors
open CFSG.Quasithin.Chapter15.Section04.LocalSetup.TwoFactors.FFBranch.ClassificationComparison
open FFAlternatives
universe u v
variable {D : Type u} [Group D] {V : Type v} [AddCommGroup V] [Module (ZMod 2) V]
    (ρ : Representation (ZMod 2) D V)

abbrev offenderActor := offenderSubgroup ρ

def offenderRepresentation : Representation (ZMod 2) (offenderActor ρ) V :=
  ρ.comp (offenderActor ρ).subtype

instance offenderActor_normal : (offenderActor ρ).Normal := offenderSubgroup_normal ρ

theorem offender_generated : offenderSubgroup (offenderRepresentation ρ) = ⊤ := by
  apply map_injective (offenderActor ρ).subtype_injective
  apply le_antisymm (by simp)
  have ht : (⊤ : Subgroup (offenderActor ρ)).map (offenderActor ρ).subtype =
      offenderActor ρ := by ext x; simp
  rw [ht]
  unfold offenderActor offenderSubgroup generatedBy
  refine iSup_le fun A => iSup_le fun hA => ?_
  have hAJ : A ≤ offenderActor ρ := le_iSup_of_le A (le_iSup_of_le hA le_rfl)
  rw [← map_subgroupOf_eq_of_le hAJ]
  apply map_mono
  exact le_iSup_of_le (A.subgroupOf (offenderActor ρ))
    (le_iSup_of_le ⟨hA.1.subgroupOf ρ hAJ, le_top⟩ le_rfl)

theorem offender_faithful (hf : Function.Injective ρ) :
    Function.Injective (offenderRepresentation ρ) :=
  hf.comp (offenderActor ρ).subtype_injective

/-- An actual FF witness survives restriction to the offender actor. -/
theorem offender_isFFModule [Finite D] [Module.Finite (ZMod 2) V]
    (hff : IsFFModule ρ) : IsFFModule (offenderRepresentation ρ) := by
  obtain ⟨A, hA⟩ := (isFFModule_iff_exists_bestOffender ρ).mp hff
  have hAJ : A ≤ offenderActor ρ :=
    le_iSup_of_le A (le_iSup_of_le ⟨hA, le_top⟩ le_rfl)
  exact ⟨A.subgroupOf (offenderActor ρ), (hA.subgroupOf ρ hAJ).isOffender _⟩

theorem offender_twoCore (hcore : pCore 2 D = ⊥) :
    pCore 2 (offenderActor ρ) = ⊥ := by
  have hn : ((pCore 2 (offenderActor ρ)).map (offenderActor ρ).subtype).Normal :=
    ConjAct.normal_of_characteristic_of_normal
  have hl : (pCore 2 (offenderActor ρ)).map (offenderActor ρ).subtype ≤ pCore 2 D :=
    le_sSup ⟨hn, pCore_isPGroup.map _⟩
  rw [hcore] at hl
  exact ((pCore 2 (offenderActor ρ)).map_eq_bot_iff_of_injective
    (offenderActor ρ).subtype_injective).mp (le_bot_iff.mp hl)

def offenderCover {C : Type u} [Group C] [Finite C] {K : GroupClass.{u}}
    (f : C →* D) (hf : Function.Surjective f) (hC : IsSQTK K C) :
    SQTKQuotient K (offenderActor ρ) where
  Cover := (offenderActor ρ).comap f
  kernel := (f.subgroupComap (offenderActor ρ)).ker
  sqtk := hC.subgroup _
  equiv := QuotientGroup.quotientKerEquivOfSurjective _
    (f.subgroupComap_surjective_of_surjective _ hf)

theorem offender_hypothesis [Finite D] [Module.Finite (ZMod 2) V]
    {C : Type u} [Group C] [Finite C] {K : GroupClass.{u}}
    (f : C →* D) (hf : Function.Surjective f) (hC : IsSQTK K C)
    (hfaith : Function.Injective ρ) (hcore : pCore 2 D = ⊥) :
    FFHypothesis K (offenderRepresentation ρ) where
  finite_module := inferInstance
  faithful := offender_faithful ρ hfaith
  twoCore := offender_twoCore ρ hcore
  generated := offender_generated ρ
  quotient := ⟨offenderCover ρ f hf hC⟩

theorem classify_offender [Finite D] [Module.Finite (ZMod 2) V]
    {C : Type u} [Group C] [Finite C] {K : GroupClass.{u}}
    (classification : CompleteClassificationInput.{u,v} K)
    (f : C →* D) (hf : Function.Surjective f) (hC : IsSQTK K C)
    (hfaith : Function.Injective ρ) (hcore : pCore 2 D = ⊥) :
    SourceAlternative (offenderRepresentation ρ) :=
  classification.general _ _ _ (offender_hypothesis ρ f hf hC hfaith hcore)

theorem marked_subgroup_map (A : Subgroup D) (hA : A ≤ offenderActor ρ) :
    (A.subgroupOf (offenderActor ρ)).map (offenderActor ρ).subtype = A :=
  map_subgroupOf_eq_of_le hA

theorem marked_fixedSpace (A : Subgroup D) (hA : A ≤ offenderActor ρ) :
    fixedSpace (offenderRepresentation ρ) (A.subgroupOf (offenderActor ρ)) =
      fixedSpace ρ A := by
  rw [offenderRepresentation, fixedSpace_comp_map, marked_subgroup_map ρ A hA]

theorem marked_commutator (A : Subgroup D) (hA : A ≤ offenderActor ρ)
    (W : Submodule (ZMod 2) V) :
    subspaceCommutator (offenderRepresentation ρ) W (A.subgroupOf (offenderActor ρ)) =
      subspaceCommutator ρ W A := by
  unfold subspaceCommutator
  congr 1
  ext v
  constructor
  · rintro ⟨a, ha, w, hw, rfl⟩
    exact ⟨a, ha, w, hw, rfl⟩
  · rintro ⟨a, ha, w, hw, rfl⟩
    exact ⟨⟨a, hA ha⟩, ha, w, hw, rfl⟩

theorem actionImage_commutator (A : Subgroup D) (W : Submodule (ZMod 2) V) :
    subspaceCommutator (imageRepresentation ρ) W (actionSubgroup ρ A) =
      subspaceCommutator ρ W A := by
  unfold subspaceCommutator
  congr 1
  ext v
  constructor
  · rintro ⟨_, ⟨a, ha, rfl⟩, w, hw, rfl⟩
    exact ⟨a, ha, w, hw, rfl⟩
  · rintro ⟨a, ha, w, hw, rfl⟩
    exact ⟨actionHom ρ a, mem_map_of_mem _ ha, w, hw, rfl⟩

theorem actionImage_marked_commutator (A : Subgroup D)
    (hA : actionSubgroup ρ A ≤ offenderActor (imageRepresentation ρ))
    (W : Submodule (ZMod 2) V) :
    subspaceCommutator (offenderRepresentation (imageRepresentation ρ)) W
      ((actionSubgroup ρ A).subgroupOf (offenderActor (imageRepresentation ρ))) =
        subspaceCommutator ρ W A := by
  rw [marked_commutator _ _ hA, actionImage_commutator]

theorem actionImage_marked_fixedSpace (A : Subgroup D)
    (hA : actionSubgroup ρ A ≤ offenderActor (imageRepresentation ρ)) :
    fixedSpace (offenderRepresentation (imageRepresentation ρ))
      ((actionSubgroup ρ A).subgroupOf (offenderActor (imageRepresentation ρ))) =
        fixedSpace ρ A := by
  rw [marked_fixedSpace _ _ hA, fixedSpace_actionSubgroup]

/-- Irreducibility descends along the genuine surjection to the action image. -/
theorem actionImage_irreducible [ρ.IsIrreducible] :
    (imageRepresentation ρ).IsIrreducible :=
  (irreducible_comp_surjective_iff (actionHom ρ)
    ρ.asGroupHom.rangeRestrict_surjective (imageRepresentation ρ)).mp
      (show ρ.IsIrreducible from inferInstance)

/-- A normal binary two-core fixes a nonzero vector; irreducibility and the
tautological faithful image action force that two-core to vanish. -/
theorem actionImage_twoCore [Finite D] [Module.Finite (ZMod 2) V] [ρ.IsIrreducible] :
    pCore 2 (actionImage ρ) = ⊥ := by
  let : (imageRepresentation ρ).IsIrreducible := actionImage_irreducible ρ
  have hk := normal_p_subgroup_le_ker (imageRepresentation ρ)
    (pCore 2 (actionImage ρ)) pCore_isPGroup
  exact le_bot_iff.mp (hk.trans
    ((imageRepresentation ρ).ker_eq_bot_iff.mpr (imageRepresentation_injective ρ)).le)

section Image
variable {C W : Type u} [Group C] [Finite C]
    [AddCommGroup W] [Module (ZMod 2) W] [Module.Finite (ZMod 2) W]
    (σ : Representation (ZMod 2) C W)

/-- This is the actual action image of the section, rather than the original
actor with an assumed faithful action. Its two-core is still an explicit input. -/
theorem actionImage_offender_hypothesis {K : GroupClass.{u}} (hC : IsSQTK K C)
    (hcore : pCore 2 (actionImage σ) = ⊥) :
    FFHypothesis K (offenderRepresentation (imageRepresentation σ)) :=
  offender_hypothesis (imageRepresentation σ) (actionHom σ)
    σ.asGroupHom.rangeRestrict_surjective hC (imageRepresentation_injective σ) hcore

end Image

section Cover
variable {E W : Type u} [Group E] [Finite E]
    [AddCommGroup W] [Module (ZMod 2) W] [Module.Finite (ZMod 2) W]
    (σ : Representation (ZMod 2) E W) [σ.IsIrreducible]

/-- Every B.5.3 hypothesis follows for the actual offender image of an
irreducible section of a finite SQTK quotient. -/
theorem irreducible_offender_hypothesis
    {C : Type u} [Group C] [Finite C] {K : GroupClass.{u}}
    (f : C →* E) (hf : Function.Surjective f) (hC : IsSQTK K C) :
    FFHypothesis K (offenderRepresentation (imageRepresentation σ)) :=
  offender_hypothesis (imageRepresentation σ) ((actionHom σ).comp f)
    (σ.asGroupHom.rangeRestrict_surjective.comp hf) hC
    (imageRepresentation_injective σ) (actionImage_twoCore σ)

end Cover

end CFSG.Quasithin.Chapter13.Section08.Components.Swapped.LinearTwo.ModuleAlternatives.FFFactors
