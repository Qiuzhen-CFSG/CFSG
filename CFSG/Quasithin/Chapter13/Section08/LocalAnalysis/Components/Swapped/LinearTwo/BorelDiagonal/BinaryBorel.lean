module

public import CFSG.Quasithin.Chapter13.Section08.LocalAnalysis.Components.Swapped.LinearTwo.BorelDiagonal.BinaryBorel.Actions
public import Theory.GroupTheory.PrimeRankProduct
public import Theory.GroupTheory.PrimeRankZero
public import Theory.GroupTheory.CentralPChiefCore

/-!
# The intrinsic binary product-Borel geometry for 13.8.16(1)

For finite Q ≅ PSL₂(2ⁿ), n ≥ 2, and any Sylow two-subgroup S of Q × Q,
the imported leaves construct N = N(Q × Q)(S), its two Sylow factors,
marked product coordinates, and compatible coordinates on N/O₂(N).
The two torus factors are finite cyclic groups of order 2ⁿ − 1; the
construction retains the quotient maps and the descent of ambient actions.

Here the odd-rank bound follows from the two-group kernel and cyclic torus.
For even n, three divides the torus order, so each factor has three-rank one
and N has three-rank two. Each factor Borel is two-perfect. At n = 2 its
torus has order three and is simple. A factor Borel has order twelve;
two-perfectness makes its elements of order three generate it. The marked
product inclusions then prove the corresponding generation statement for N.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004,
proof of 13.8.16(1), printed p.952/PDF p.969. These intrinsic facts are
a prerequisite for the source argument: the parent still supplies the
ambient Sylow placement, normalizing conjugations and diagonal conclusions.
-/

@[expose] public section

open Subgroup
open Matrix.ProjectiveSpecialLinearGroup
namespace CFSG.Quasithin.Chapter13.Section08.Components.Swapped.LinearTwo.BinaryBorel
variable {Q : Type*} [Group Q] [Finite Q]

/-- Each factor Borel equals its two-residual for field order at least four. -/
theorem factor_twoPerfect {n : ℕ} (hn : 2 ≤ n)
    (hmodel : ClassicalGroup.IsPSL Q 2 (2 ^ n)) (S : Sylow 2 Q) :
    IsPPerfect 2 (borel S) := (factor_facts hn hmodel S).2.1

/-- Even field degree gives three-rank exactly one in each factor Borel. -/
theorem factor_threeRank {n : ℕ} (hn : 2 ≤ n)
    (hmodel : ClassicalGroup.IsPSL Q 2 (2 ^ n)) (heven : Even n) (S : Sylow 2 Q) :
    primeRank 3 (borel S) = 1 := by
  let _ : Fact (Nat.Prime 3) := ⟨by decide⟩
  let _ := torus_cyclic hn hmodel S
  let P : Sylow 3 (Torus S) := Classical.choice inferInstance
  have ht : primeRank 3 (Torus S) ≤ 1 := P.primeRank_le_one_of_isCyclic inferInstance
  have hk : primeRank 3 (torusMap S).ker = 0 := by
    apply PrimeRank.eq_zero_iff_not_dvd_card.mpr
    rw [torusMap_ker]
    obtain ⟨a, ha⟩ := (pCore_isPGroup (p := 2) (G := borel S)).exists_card_eq
    rw [ha]
    exact fun h => (by decide : ¬ 3 ∣ 2) (Nat.Prime.dvd_of_dvd_pow (by decide) h)
  have hu := Theory.GroupTheory.primeRank_le_ker_add (p := 3) (torusMap S)
  have hp : primeRank 3 (borel S) ≠ 0 := by
    intro hz
    apply PrimeRank.eq_zero_iff_not_dvd_card.mp hz
    rw [(factor_facts hn hmodel S).2.2.2.2]
    exact dvd_mul_of_dvd_right ((Nat.BinaryTorusParity.three_dvd_sub_one_iff n).mpr heven) _
  omega

/-- The two actual factor Borels contribute independent three-ranks. -/
theorem threeRank {n : ℕ} (hn : 2 ≤ n)
    (hmodel : ClassicalGroup.IsPSL Q 2 (2 ^ n)) (heven : Even n)
    (S : Sylow 2 (Q × Q)) : primeRank 3 (borel S) = 2 := by
  let _ : Fact (Nat.Prime 3) := ⟨by decide⟩
  rw [Theory.GroupTheory.primeRank_equiv 3 (coordinates S), primeRank_prod_eq_add,
    factor_threeRank hn hmodel heven, factor_threeRank hn hmodel heven]

theorem torus_four_card (hmodel : ClassicalGroup.IsPSL Q 2 4) (S : Sylow 2 Q) :
    Nat.card (Torus S) = 3 := torus_card (n := 2) (by decide) hmodel S

/-- At field order four the factor torus is the simple cyclic group of order three. -/
theorem torus_four_simple (hmodel : ClassicalGroup.IsPSL Q 2 4) (S : Sylow 2 Q) :
    IsSimpleGroup (Torus S) := by
  let _ : Fact (Nat.Prime 3) := ⟨by decide⟩
  exact isSimpleGroup_of_prime_card (torus_four_card hmodel S)

/-- At field order four, the elements of order exactly three generate a factor Borel. -/
theorem factor_generated_by_threes (hmodel : ClassicalGroup.IsPSL Q 2 4) (S : Sylow 2 Q) :
    closure {x : borel S | orderOf x = 3} = ⊤ := by
  have hgen := closure_coprime_order_eq_top_of_pResidual_eq_top 2
    ((pResidual_eq_top_iff _ _).mpr (factor_twoPerfect (n := 2) (by decide) hmodel S))
  apply top_unique
  rw [← hgen, closure_le]
  intro x hx
  have hd : orderOf x ∣ 4 * 3 := by
    simpa [(factor_facts (n := 2) (by decide) hmodel S).2.2.2.2] using
      orderOf_dvd_natCard x
  have hd3 : orderOf x ∣ 3 := (hx.symm.pow_right 2).dvd_of_dvd_mul_left hd
  rcases (Nat.dvd_prime (by decide : Nat.Prime 3)).mp hd3 with h | h
  · have hx1 : x = 1 := orderOf_eq_one_iff.mp h
    rw [hx1]
    exact one_mem _
  · exact subset_closure h

/-- At field order four, the product Borel is generated by elements of order exactly three. -/
theorem generated_by_threes (hmodel : ClassicalGroup.IsPSL Q 2 4)
    (S : Sylow 2 (Q × Q)) : closure {x : borel S | orderOf x = 3} = ⊤ := by
  let C := closure {x : borel S | orderOf x = 3}
  let f₁ : borel (firstSylow S) →* borel S :=
    (coordinates S).symm.toMonoidHom.comp (MonoidHom.inl _ _)
  let f₂ : borel (secondSylow S) →* borel S :=
    (coordinates S).symm.toMonoidHom.comp (MonoidHom.inr _ _)
  have h₁ : ∀ x, f₁ x ∈ C := by
    suffices (⊤ : Subgroup (borel (firstSylow S))) ≤ C.comap f₁ from
      fun x => this (mem_top x)
    rw [← factor_generated_by_threes hmodel (firstSylow S), closure_le]
    intro x hx
    apply Subgroup.subset_closure
    change orderOf (f₁ x) = 3
    change orderOf ((coordinates S).symm (x, 1)) = 3
    rw [MulEquiv.orderOf_eq]
    simpa only [Prod.orderOf, orderOf_one, Nat.lcm_one_right, Set.mem_ofPred_eq] using hx
  have h₂ : ∀ y, f₂ y ∈ C := by
    suffices (⊤ : Subgroup (borel (secondSylow S))) ≤ C.comap f₂ from
      fun y => this (mem_top y)
    rw [← factor_generated_by_threes hmodel (secondSylow S), closure_le]
    intro y hy
    apply Subgroup.subset_closure
    change orderOf (f₂ y) = 3
    change orderOf ((coordinates S).symm (1, y)) = 3
    rw [MulEquiv.orderOf_eq]
    simpa only [Prod.orderOf, orderOf_one, Nat.lcm_one_left, Set.mem_ofPred_eq] using hy
  apply top_unique
  intro x _
  have he : x = f₁ (coordinates S x).1 * f₂ (coordinates S x).2 := by
    apply (coordinates S).injective
    simp [f₁, f₂]
  rw [he]
  exact C.mul_mem (h₁ _) (h₂ _)


end CFSG.Quasithin.Chapter13.Section08.Components.Swapped.LinearTwo.BinaryBorel

end
