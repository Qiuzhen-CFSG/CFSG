module

public import CFSG.Quasithin.Chapter13.Section08.LocalAnalysis.Components.Swapped.LinearThree.ResidualAction
public import Theory.GroupTheory.CentralPChiefCore
public import Theory.GroupTheory.PrimeOrderLift
public import Theory.GroupTheory.PResidual.PerfectCover

/-!
# Theta comparison for the moving linear-three branch

For a group with two-core quotient S₃ wr C₂, its two-residual is generated
by its elements of order three. Indeed its residual quotient is elementary
of order nine, and the two-core quotient preserves odd element orders.
The usual generation of a two-perfect group by odd-order elements then
gives the assertion, without assuming a splitting of the two-core.

Consequently an overgroup of L₁ inside H ∩ M with this wreath quotient has
two-residual L₁, using the genuine earlier identity L₁ = θ(H ∩ M).
Here theta is the closure of the elements of order three, as in A.3.17.
The construction of the overgroup remains a separate obligation.

Source: Aschbacher–Smith 13.7.3(9) and the proof of 13.8.16(1), printed
pp.936 and 952 (combined manuscript of 1 March 2004).
-/

@[expose] public section
open Subgroup
namespace CFSG.Quasithin.Chapter13.Section08.Components.Swapped.LinearThree.WreathOvergroup

/-- The wreath quotient forces the two-residual to be generated by actual
elements of order three, including in nonsplit extensions by the two-core. -/
theorem residual_eq_threeClosure {X : Type*} [Group X] [Finite X]
    (e : X ⧸ pCore 2 X ≃* WreathModel.W) :
    pResidual 2 X = closure {x : X | orderOf x = 3} := by
  let R := pResidual 2 X
  let q := QuotientGroup.mk' (pCore 2 R)
  have hk : IsPGroup 2 q.ker := by
    change IsPGroup 2 (QuotientGroup.mk' (pCore 2 R)).ker
    rw [QuotientGroup.ker_mk']
    exact pCore_isPGroup
  have hcube (r : R) : (q r)^3 = 1 := by
    apply (ResidualAction.residualQuotientEquiv e).injective
    rw [map_pow, map_one]
    exact Monoid.exponent_dvd_iff_forall_pow_eq_one.mp
      (IsElementaryAbelian.exponent_dvd_p 3 WreathModel.cubicBase) _
  have hgen := closure_coprime_order_eq_top_of_pResidual_eq_top 2
    ((pResidual_eq_top_iff 2 R).mpr (isPPerfect_pResidual 2))
  apply le_antisymm
  · suffices hh : ∀ r : R, (r : X) ∈ closure {x : X | orderOf x = 3} from
      fun x hx => hh ⟨x, hx⟩
    intro r
    have hm : r ∈ closure {r : R | Nat.Coprime 2 (orderOf r)} := by
      rw [hgen]
      trivial
    induction hm using closure_induction with
    | mem r hr =>
      have hd : orderOf r ∣ 3 := by
        rw [← q.orderOf_map_eq_of_coprime_of_isPGroup_ker hk r hr]
        exact orderOf_dvd_of_pow_eq_one (hcube r)
      rcases (Nat.dvd_prime (by decide : Nat.Prime 3)).mp hd with ho | ho
      · have he : r = 1 := orderOf_eq_one_iff.mp ho
        simpa only [he, coe_one] using (closure {x : X | orderOf x = 3}).one_mem
      · exact subset_closure ((orderOf_coe r).trans ho)
    | one => exact (closure _).one_mem
    | mul a b ha hb hia hib => exact (closure _).mul_mem hia hib
    | inv a ha hia => exact (closure _).inv_mem hia
  · apply (closure_le _).mpr
    intro x hx
    exact mem_pResidual_of_orderOf_coprime (by rw [hx]; decide)

variable {G : Type*} [Group G] [Finite G]

/-- Ambient version of the theta calculation; no identification of intrinsic
and ambient subgroups is left implicit. -/
theorem embedded_residual_eq_threeClosure (H₁ : Subgroup G)
    (e : H₁ ⧸ pCore 2 H₁ ≃* WreathModel.W) :
    (pResidual 2 H₁).map H₁.subtype =
      closure {x : G | x ∈ H₁ ∧ orderOf x = 3} := by
  rw [residual_eq_threeClosure e]
  apply le_antisymm
  · apply map_le_iff_le_comap.mpr
    apply (closure_le _).mpr
    intro x hx
    exact subset_closure ⟨x.property, (orderOf_coe x).trans hx⟩
  · apply (closure_le _).mpr
    rintro x ⟨hx, ho⟩
    exact ⟨⟨x, hx⟩, subset_closure ((orderOf_coe ⟨x, hx⟩).symm.trans ho), rfl⟩

/-- The earlier theta identity identifies the constructed wreath residual
with L₁ in the original ambient subgroup lattice. -/
theorem residual_eq_of_theta (L₁ H₁ J : Subgroup G)
    (hL : L₁ ≤ H₁) (hJ : H₁ ≤ J)
    (htheta : L₁ = closure {x : G | x ∈ J ∧ orderOf x = 3})
    (e : H₁ ⧸ pCore 2 H₁ ≃* WreathModel.W) :
    L₁ = (pResidual 2 H₁).map H₁.subtype := by
  rw [embedded_residual_eq_threeClosure H₁ e]
  apply le_antisymm
  · rw [htheta]
    apply (closure_le _).mpr
    intro x hx
    have hxL : x ∈ L₁ := htheta.symm ▸ subset_closure hx
    exact subset_closure ⟨hL hxL, hx.2⟩
  · rw [htheta]
    exact closure_mono (fun _ hx => ⟨hJ hx.1, hx.2⟩)

end CFSG.Quasithin.Chapter13.Section08.Components.Swapped.LinearThree.WreathOvergroup
end
