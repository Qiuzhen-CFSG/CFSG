module

public import CFSG.Quasithin.Chapter13.Section08.LocalAnalysis.CriticalGeometry.AsymmetricPair.Actions
public import CFSG.Quasithin.Chapter13.Section08.LocalAnalysis.CriticalGeometry.AsymmetricPair.Interchange
public import Mathlib.RepresentationTheory.Basic
public import Mathlib.LinearAlgebra.FiniteDimensional.Basic

/-!
# Lifting center orbits from the actual quotient module

The quotient here is literally U/Z, and the action equation is ambient left
conjugation. A model consists of an equivalence of its actual action image
with the model group and an intertwining linear equivalence. A model vector
transporter lifts to h in H; equality modulo Z implies containment in V₂
because Z ≤ V₂. An order-two center is generated by its nonidentity element.

For source use U=U_H and Z=V₁. The earlier inputs are normalization and
containments from 13.7.3/F.9, the order and disjointness supplied by the endpoint
transport, and the actual module alternatives of 13.8.5. The marked vector in
V₂ comes from Notation 13.2.1 and 13.7.6(3). These are explicit inputs, not
claims that the earlier source results have been assembled here.

Source: Aschbacher–Smith, 13.8.7, printed pp.948–949, condition (*).
-/

@[expose] public section

open Subgroup
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter13.Section08.CriticalGeometry.AsymmetricPair

variable {G : Type*} [Group G]

/-- The conjugation action on the literal quotient, with its ambient lift. -/
structure CenterQuotientAction (H U Z : Subgroup G) [(Z.subgroupOf U).Normal] where
  normalizes : H ≤ normalizer (U : Set G)
  action : H →* MulAut (U ⧸ Z.subgroupOf U)
  apply_mk : ∀ h : H, ∀ u : U,
    action h (QuotientGroup.mk' (Z.subgroupOf U) u) =
      QuotientGroup.mk' (Z.subgroupOf U)
        ⟨(h : G) * (u : G) * (h : G)⁻¹,
          (mem_normalizer_iff.mp (normalizes h.property) u).mp u.property⟩

/-- Normalization supplies the actual quotient action used in the model inputs. -/
theorem exists_centerQuotientAction {H U Z : Subgroup G} [(Z.subgroupOf U).Normal]
    (hU : H ≤ normalizer (U : Set G))
    (hZ : H ≤ normalizer (Z : Set G)) : Nonempty (CenterQuotientAction H U Z) := by
  obtain ⟨act, he⟩ := exists_quotient_conjugation_action H U Z hU hZ inferInstance
  exact ⟨⟨hU, act, he⟩⟩

namespace CenterQuotientAction
variable {H U Z : Subgroup G} [(Z.subgroupOf U).Normal]
  [IsElementaryAbelian 2 U]

abbrev vector (u : U) : Additive (U ⧸ Z.subgroupOf U) :=
  Additive.ofMul (QuotientGroup.mk' (Z.subgroupOf U) u)

theorem vector_ne_zero (u : U) (hu : (u : G) ∉ Z) : vector (Z := Z) u ≠ 0 := by
  intro hz
  exact hu ((QuotientGroup.eq_one_iff u).mp hz)

/-- A model of the actual action image, including the intertwining map. -/
structure Model (Q : CenterQuotientAction H U Z)
    {K E : Type*} [Group K] [AddCommGroup E] [Module (ZMod 2) E]
    (ρ : Representation (ZMod 2) K E) where
  groupEquiv : Q.action.range ≃* K
  moduleEquiv : Additive (U ⧸ Z.subgroupOf U) ≃ₗ[ZMod 2] E
  intertwines : ∀ a : Q.action.range, ∀ w : U ⧸ Z.subgroupOf U,
    moduleEquiv (Additive.ofMul (a.val w)) =
      ρ (groupEquiv a) (moduleEquiv (Additive.ofMul w))

omit [IsElementaryAbelian 2 U] in
/-- Lifting a vector equality in U/Z to containment in a subgroup containing Z. -/
theorem conjugate_mem_of_vector_eq (Q : CenterQuotientAction H U Z)
    (V₂ : Subgroup G) (hZ : Z ≤ V₂) (h : H) (a b : U) (hb : (b : G) ∈ V₂)
    (he : Additive.ofMul (Q.action h (QuotientGroup.mk' (Z.subgroupOf U) a)) =
      vector (Z := Z) b) : (h : G) * (a : G) * (h : G)⁻¹ ∈ V₂ := by
  have he' : Q.action h (QuotientGroup.mk' (Z.subgroupOf U) a) =
      QuotientGroup.mk' (Z.subgroupOf U) b := he
  rw [Q.apply_mk] at he'
  have hd := QuotientGroup.eq_iff_div_mem.mp he'
  have hm := V₂.mul_mem (hZ hd) hb
  change (((h : G) * (a : G) * (h : G)⁻¹) / (b : G)) * (b : G) ∈ V₂ at hm
  simpa only [div_mul_cancel] using hm

/-- An order-two subgroup is determined by any of its nonidentity elements. -/
theorem line_eq_zpowers (A : Subgroup G) (hcard : Nat.card A = 2)
    (a : A) (ha : (a : G) ≠ 1) : A = zpowers (a : G) := by
  obtain ⟨c, hc, hlast⟩ := (Nat.card_eq_two_iff' (1 : A)).mp hcard
  apply le_antisymm
  · intro x hx
    by_cases hx1 : x = 1
    · simp [hx1]
    · have he := (hlast ⟨x, hx⟩ (fun hh => hx1 (congrArg Subtype.val hh))).trans
        (hlast a (fun hh => ha (congrArg Subtype.val hh))).symm
      rw [show x = (a : G) from congrArg Subtype.val he]
      exact mem_zpowers (a : G)
  · exact zpowers_le.mpr a.property

/-- Model transporters place the entire actual center, not merely its quotient line. -/
theorem place_of_model (Q : CenterQuotientAction H U Z)
    {K E : Type*} [Group K] [AddCommGroup E] [Module (ZMod 2) E]
    {ρ : Representation (ZMod 2) K E} (M : Q.Model ρ)
    (A V₂ : Subgroup G) (hA : A ≤ U) (hcard : Nat.card A = 2)
    (hZ : Z ≤ V₂) (a : A) (ha : (a : G) ≠ 1)
    (b : U) (hb : (b : G) ∈ V₂)
    (m : K) (hm : ρ m (M.moduleEquiv (vector (Z := Z) ⟨a, hA a.property⟩)) =
      M.moduleEquiv (vector (Z := Z) b)) :
    ∃ h ∈ H, A.conjBy h ≤ V₂ := by
  obtain ⟨h, hh⟩ := (M.groupEquiv.symm m).property
  have he : (⟨Q.action h, ⟨h, rfl⟩⟩ : Q.action.range) = M.groupEquiv.symm m :=
    Subtype.ext hh
  have hv : Additive.ofMul (Q.action h
        (QuotientGroup.mk' (Z.subgroupOf U) ⟨a, hA a.property⟩)) =
      vector (Z := Z) b := by
    apply M.moduleEquiv.injective
    rw [M.intertwines ⟨Q.action h, ⟨h, rfl⟩⟩, he, M.groupEquiv.apply_symm_apply]
    exact hm
  refine ⟨h, h.property, ?_⟩
  rw [line_eq_zpowers A hcard a ha]
  change (zpowers (a : G)).map (MulAut.conj (h : G)).toMonoidHom ≤ V₂
  rw [MonoidHom.map_zpowers]
  apply zpowers_le.mpr
  exact Q.conjugate_mem_of_vector_eq V₂ hZ h ⟨a, hA a.property⟩ b hb hv

/-- General linear automorphisms move any nonzero vector to any other. -/
theorem linear_nonzero_transitive {E : Type*} [AddCommGroup E] [Module (ZMod 2) E]
    [FiniteDimensional (ZMod 2) E] (x y : E) (hx : x ≠ 0) (hy : y ≠ 0) :
    ∃ g : E ≃ₗ[ZMod 2] E, g x = y := by
  let ex := LinearEquiv.toSpanNonzeroSingleton (ZMod 2) E x hx
  let ey := LinearEquiv.toSpanNonzeroSingleton (ZMod 2) E y hy
  obtain ⟨g, hg⟩ := Submodule.exists_linearEquiv_restrict_eq (ex.symm.trans ey)
  refine ⟨g, ?_⟩
  have h := hg (ex 1)
  simp only [LinearEquiv.trans_apply, LinearEquiv.symm_apply_apply] at h
  simpa [ex, ey] using h.symm

/-- Nonzero-vector transitivity suffices after genuine model identification. -/
theorem place_of_nonzero_transitive (Q : CenterQuotientAction H U Z)
    {K E : Type*} [Group K] [AddCommGroup E] [Module (ZMod 2) E]
    {ρ : Representation (ZMod 2) K E} (M : Q.Model ρ)
    (horbit : ∀ x y : E, x ≠ 0 → y ≠ 0 → ∃ m : K, ρ m x = y)
    (A V₂ : Subgroup G) (hA : A ≤ U) (hcard : Nat.card A = 2)
    (hdisj : A ⊓ Z = ⊥) (hZ : Z ≤ V₂)
    (b : U) (hb : (b : G) ∈ V₂) (hbZ : (b : G) ∉ Z) :
    ∃ h ∈ H, A.conjBy h ≤ V₂ := by
  obtain ⟨a, ha, _⟩ := (Nat.card_eq_two_iff' (1 : A)).mp hcard
  have ha1 : (a : G) ≠ 1 := fun he => ha (Subtype.ext he)
  have haZ : (a : G) ∉ Z := by
    intro hm
    exact ha1 (mem_bot.mp (hdisj ▸ (show (a : G) ∈ A ⊓ Z from ⟨a.property, hm⟩)))
  have hxa := vector_ne_zero (Z := Z) (⟨a, hA a.property⟩ : U) haZ
  have hxb := vector_ne_zero (Z := Z) b hbZ
  obtain ⟨m, hm⟩ := horbit
    (M.moduleEquiv (vector (Z := Z) ⟨a, hA a.property⟩))
    (M.moduleEquiv (vector (Z := Z) b))
    (fun h => hxa (M.moduleEquiv.injective (h.trans (map_zero _).symm)))
    (fun h => hxb (M.moduleEquiv.injective (h.trans (map_zero _).symm)))
  exact Q.place_of_model M A V₂ hA hcard hZ a ha1 b hb m hm

/-- A nonidentity actor whose entire displacement is contained in the actual
image of A. For a center of order two this is a genuine transvection center;
no orbit or permutation shape is stipulated. -/
def IsNontrivialCenter (Q : CenterQuotientAction H U Z) (A : Subgroup G) : Prop :=
  ∃ t : H, Q.action t ≠ 1 ∧ ∀ w : U ⧸ Z.subgroupOf U,
    w⁻¹ * Q.action t w ∈
      (A.subgroupOf U).map (QuotientGroup.mk' (Z.subgroupOf U))

/-- A nontrivial group with the specified commutator image supplies a
nonidentity transvection actor. This is the input provided by endpoint transport. -/
theorem isNontrivialCenter_of_displacement (Q : CenterQuotientAction H U Z)
    (P : Subgroup H) (A : Subgroup G) (hne : P.map Q.action ≠ ⊥)
    (hd : commutatorAction (P.map Q.action) (U ⧸ Z.subgroupOf U) ≤
      (A.subgroupOf U).map (QuotientGroup.mk' (Z.subgroupOf U))) :
    Q.IsNontrivialCenter A := by
  obtain ⟨a, ha, hna⟩ : ∃ a ∈ P.map Q.action, a ≠ 1 := by
    by_contra! h
    exact hne (eq_bot_iff.mpr h)
  obtain ⟨t, ht, rfl⟩ := ha
  refine ⟨t, hna, fun w => hd ?_⟩
  exact subset_closure ⟨⟨Q.action t, mem_map_of_mem Q.action ht⟩, w, mem_top w, rfl⟩

end CenterQuotientAction
end CFSG.Quasithin.Chapter13.Section08.CriticalGeometry.AsymmetricPair

end
