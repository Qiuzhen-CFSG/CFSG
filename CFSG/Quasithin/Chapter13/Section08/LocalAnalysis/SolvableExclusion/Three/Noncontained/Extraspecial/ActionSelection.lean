/-!
# Selecting the extraspecial action alternative

Cubic residuals normal in L₁T generate L₁. If one of their two-cores
moves P*, it supplies the first action alternative. Otherwise the residual
action images are normal three-subgroups of the L₁ action image, so that
image is a three-group. The two-core of L₁ consequently centralizes P*;
parabolic-core faithfulness kills its image in H/O₂(H). The elementary
quotient in `CubicGeneration` then makes L₁* elementary abelian.

Pass to H*/Z(P*). The literal Frattini interval makes the image of P*
minimal normal. The normal three-subgroup generated by P* and L₁*
centralizes that image. An element of L₁* outside P* therefore has order
three and acts trivially on P*/Z(P*), giving the second alternative.

This proves the conditional action selection used by the parent's rank
construction. The independent earlier-source construction of
`CubicGeneration` remains with its producer. No rank bound, chosen cubic
actor, or nontrivial two-core action is assumed.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), proof of
13.8.13, printed p.951 (PDF p.968).
-/

public section

open Subgroup
namespace CFSG.Quasithin.Chapter13.Section08.SolvableExclusion.Three.Extraspecial
variable {G : Type*} [Group G]

private theorem range_three_of_core_killed {K A : Type*} [Group K] [Group A]
    (f : K →* A) (hc : Nat.card (K ⧸ pCore 2 K) = 3)
    (hk : (pCore 2 K).map f = ⊥) : IsPGroup 3 f.range := by
  have hker : pCore 2 K ≤ f.rangeRestrict.ker := by
    intro x hx
    apply Subtype.ext
    exact ((Subgroup.map_eq_bot_iff (pCore 2 K)).mp hk) hx
  let q := QuotientGroup.lift (pCore 2 K) f.rangeRestrict hker
  have hq : Function.Surjective q := by
    intro y
    obtain ⟨x, hx⟩ := f.rangeRestrict_surjective y
    exact ⟨QuotientGroup.mk' (pCore 2 K) x, hx⟩
  exact (IsPGroup.of_card (p := 3) (n := 1) (by simpa using hc)).of_surjective q hq

private theorem range_restrict_eq {L X : Subgroup G} (hXL : X ≤ L)
    {A : Type*} [Group A] (f : L →* A) :
    (X.subgroupOf L).map f = (f.comp (inclusion hXL)).range := by
  ext y
  constructor
  · rintro ⟨x, hx, rfl⟩
    exact ⟨⟨x, hx⟩, rfl⟩
  · rintro ⟨x, rfl⟩
    exact ⟨inclusion hXL x, x.property, rfl⟩

private theorem generated_action_three {L T : Subgroup G}
    (d : CubicGeneration L T) {A : Type*} [Group A] (f : L →* A)
    (hk : ∀ X (hX : X ∈ d.generators),
      (pCore 2 X).map (f.comp (inclusion (d.generated ▸ le_sSup hX))) = ⊥) :
    IsPGroup 3 f.range := by
  let b := f.rangeRestrict
  have himage (X : Subgroup G) (hX : X ∈ d.generators) :
      (X.subgroupOf L).map b ≤ pCore 3 f.range := by
    have hXL : X ≤ L := d.generated ▸ le_sSup hX
    let : (X.subgroupOf L).Normal := normal_subgroupOf_of_le_normalizer
      (le_sup_left.trans (d.normalizes X hX))
    have hn : ((X.subgroupOf L).map b).Normal :=
      Normal.map inferInstance b f.rangeRestrict_surjective
    have hkill : (pCore 2 X).map (b.comp (inclusion hXL)) = ⊥ := by
      apply map_injective f.range.subtype_injective
      rw [map_map, Subgroup.map_bot]
      exact hk X hX
    have hp := range_three_of_core_killed (b.comp (inclusion hXL)) (d.cubic X hX) hkill
    rw [← range_restrict_eq hXL b] at hp
    exact le_sSup ⟨hn, hp⟩
  have hL : L ≤ ((pCore 3 f.range).comap b).map L.subtype := by
    refine d.generated.symm.le.trans (sSup_le ?_)
    intro X hX x hx
    have hXL : X ≤ L := d.generated ▸ le_sSup hX
    refine ⟨⟨x, hXL hx⟩, ?_, rfl⟩
    exact himage X hX (mem_map_of_mem b (show (⟨x, hXL hx⟩ : L) ∈ X.subgroupOf L from hx))
  have htop : pCore 3 f.range = ⊤ := by
    apply top_unique
    intro y _
    obtain ⟨x, rfl⟩ := f.rangeRestrict_surjective y
    obtain ⟨z, hz, he⟩ := hL x.property
    have he' : z = x := Subtype.ext he
    exact he' ▸ hz
  exact fun x => by
    have h := pCore_isPGroup (p := 3) (G := f.range) (⟨x, htop ▸ mem_top x⟩ : pCore 3 f.range)
    obtain ⟨n, hn⟩ := h
    exact ⟨n, congrArg Subtype.val hn⟩

private theorem generation_normalizes {L T : Subgroup G} (d : CubicGeneration L T) :
    L ⊔ T ≤ normalizer (L : Set G) := by
  have h : L ⊔ T ≤ normalizer ((sSup d.generators : Subgroup G) : Set G) := by
    rw [sSup_eq_iSup]
    apply le_trans _ (iInf_normalizer_le_normalizer_iSup _)
    refine le_iInf fun X => ?_
    exact (le_iInf fun hX => d.normalizes X hX).trans
      (iInf_normalizer_le_normalizer_iSup _)
  simpa only [d.generated] using h

private theorem starMap_range {H X : Subgroup G} (hXH : X ≤ H) :
    (starMap H X hXH).range = Source.starImage H X :=
  (range_restrict_eq hXH (QuotientGroup.mk' (pCore 2 H))).symm

private theorem starMap_core_image {H X : Subgroup G} (hXH : X ≤ H) :
    (pCore 2 X).map (starMap H X hXH) = Source.starImage H (X.pCoreIn 2) := by
  ext y
  constructor
  · rintro ⟨x, hx, rfl⟩
    exact ⟨inclusion hXH x, ⟨x, hx, rfl⟩, rfl⟩
  · rintro ⟨x, ⟨z, hz, he⟩, rfl⟩
    refine ⟨z, hz, ?_⟩
    exact congrArg (QuotientGroup.mk' (pCore 2 H)) (Subtype.ext he)

private theorem star_core_killed [Finite G] {H L T M V : Subgroup G}
    (r : ReducedOdd 3 H L T M V) (d : CubicGeneration L T)
    (hk : let _ := r.Pstar_normal
      ∀ X (hX : X ∈ d.generators), (pCore 2 X).map
        (starAction H r.P X ((d.generated ▸ le_sSup hX).trans
          (le_sup_left.trans (r.generated ▸ le_sup_right)))) = ⊥) :
    Source.starImage H (L.pCoreIn 2) = ⊥ := by
  let := r.Pstar_normal
  have hLH : L ≤ H := le_sup_left.trans (r.generated ▸ le_sup_right)
  let a := starAction H r.P L hLH
  have ha3 : IsPGroup 3 a.range := generated_action_three d a hk
  have hdis := (pCore_isPGroup (p := 2) (G := L)).map a |>.disjoint_of_coprime ha3
    (by decide : Nat.Coprime 2 3)
  have hkill : (pCore 2 L).map a = ⊥ := by
    apply bot_unique
    intro x hx
    exact hdis.le_bot ⟨hx, by obtain ⟨l, hl, rfl⟩ := hx; exact ⟨l, rfl⟩⟩
  have hcent : Source.starImage H (L.pCoreIn 2) ≤
      centralizer (Source.starImage H r.P : Set (Source.Hstar H)) := by
    rw [← starMap_core_image hLH]
    rintro x ⟨l, hl, rfl⟩ y hy
    have hfix : a l = 1 := (Subgroup.map_eq_bot_iff (pCore 2 L)).mp hkill hl
    have he := congrArg Subtype.val (DFunLike.congr_fun hfix
      (⟨y, hy⟩ : Source.starImage H r.P))
    change starMap H L hLH l * y * (starMap H L hLH l)⁻¹ = y at he
    exact (mul_inv_eq_iff_eq_mul.mp he).symm
  apply bot_unique
  rw [← RankOne.parabolic_core_star_centralizer r]
  exact le_inf (starImage_mono H (pCoreIn_mono_of_normalizes le_sup_left
    (generation_normalizes d))) hcent

private theorem elementary_range_of_core_killed {K A : Type*} [Group K] [Group A]
    [IsElementaryAbelian 3 (K ⧸ pCore 2 K)]
    (f : K →* A) (hk : (pCore 2 K).map f = ⊥) :
    IsElementaryAbelian 3 f.range := by
  have hker : pCore 2 K ≤ f.rangeRestrict.ker := by
    intro x hx
    apply Subtype.ext
    exact (Subgroup.map_eq_bot_iff (pCore 2 K)).mp hk hx
  let q := QuotientGroup.lift (pCore 2 K) f.rangeRestrict hker
  apply IsElementaryAbelian.of_surjective q
  intro y
  obtain ⟨x, hx⟩ := f.rangeRestrict_surjective y
  exact ⟨QuotientGroup.mk' (pCore 2 K) x, hx⟩

private theorem central_quotient_action_trivial [Finite G]
    (P J L : Subgroup G) [P.Normal] [IsExtraspecial 3 P]
    (hPJ : P ⊔ J = ⊤) (hLP : IsPGroup 3 L)
    (hn : J ≤ normalizer (L : Set G))
    (hirr : ∀ E : Subgroup G, (frattini P).map P.subtype ≤ E → E ≤ P →
      J ≤ normalizer (E : Set G) → E = (frattini P).map P.subtype ∨ E = P) :
    ∀ x ∈ L, quotientAut (center P) (MulAut.conjNormal x) = 1 := by
  let Z := (center P).map P.subtype
  let : Z.Normal := ConjAct.normal_of_characteristic_of_normal
  let q := QuotientGroup.mk' Z
  let D := P.map q
  let R := P ⊔ L
  have hZR : Z ≤ P := map_subtype_le _
  have hRnormal : R.Normal := by
    apply normalizer_eq_top_iff.mp
    apply top_unique
    rw [← hPJ]
    exact sup_le (le_sup_left.trans R.le_normalizer)
      ((le_inf le_normalizer_of_normal hn).trans
        (normalizer_inf_normalizer_le_normalizer_sup P L))
  let := hRnormal
  have hRp : IsPGroup 3 R := (IsExtraspecial.isPGroup 3 P).to_sup_of_normal_left'
    hLP le_normalizer_of_normal
  have hminimal (E : Subgroup (G ⧸ Z)) (hED : E ≤ D) (hEn : E.Normal) :
      E = ⊥ ∨ E = D := by
    let := hEn
    have hZ : Z ≤ E.comap q := by
      intro z hz
      change q z ∈ E
      have he : q z = 1 := (QuotientGroup.eq_one_iff _).mpr hz
      exact he ▸ E.one_mem
    have hP : E.comap q ≤ P := by
      have ht := comap_mono (f := q) hED
      have hpre : D.comap q = P := by
        change (P.map q).comap q = P
        rw [comap_map_eq, QuotientGroup.ker_mk', sup_eq_left.mpr hZR]
      exact ht.trans_eq hpre
    have hPhi : (frattini P).map P.subtype = Z := by
      rw [IsExtraspecial.frattini_eq_center (p := 3)]
    rcases hirr (E.comap q) (hPhi.le.trans hZ) hP le_normalizer_of_normal with he | he
    · left
      have hm := congrArg (map q) he
      rw [map_comap_eq_self_of_surjective (QuotientGroup.mk'_surjective _), hPhi,
        QuotientGroup.map_mk'_self] at hm
      exact hm
    · right
      have hm := congrArg (map q) he
      rw [map_comap_eq_self_of_surjective (QuotientGroup.mk'_surjective _)] at hm
      exact hm
  have hc := pCore_le_centralizer_of_minimal_normal_pSubgroup D
    ((IsExtraspecial.isPGroup 3 P).map q) hminimal
  have hRcore : R.map q ≤ pCore 3 (G ⧸ Z) :=
    le_sSup ⟨Normal.map inferInstance q (QuotientGroup.mk'_surjective _), hRp.map q⟩
  intro x hx
  have hxc := hc (hRcore (mem_map_of_mem q (show x ∈ R from (le_sup_right : L ≤ R) hx)))
  ext v
  obtain ⟨y, rfl⟩ := QuotientGroup.mk'_surjective (center P) v
  rw [quotientAut_apply_mk]
  change QuotientGroup.mk' (center P) (MulAut.conjNormal x y) =
    QuotientGroup.mk' (center P) y
  apply QuotientGroup.eq_iff_div_mem.mpr
  have hcomm := hxc (q y) (mem_map_of_mem q y.property)
  have he : q (x * y * x⁻¹) = q y := by
    rw [map_mul, map_mul, map_inv, ← hcomm, mul_assoc, mul_inv_cancel, mul_one]
  have hz : x * y * x⁻¹ / y ∈ Z := QuotientGroup.eq_iff_div_mem.mp he
  obtain ⟨z, hz, hez⟩ := hz
  have hez' : z = MulAut.conjNormal x y / y := Subtype.ext hez
  exact hez' ▸ hz

/-- The noncontained extraspecial action alternative follows from the earlier
cubic residual generation and the literal Frattini irreducibility.
The order-27 and exponent-three assumptions are needed only by the subsequent
rank construction, not by this selection step. -/
theorem actionAlternative_of_cubicGeneration [Finite G]
    {H L₁ T M Vα : Subgroup G} (r : ReducedOdd 3 H L₁ T M Vα)
    (d : CubicGeneration L₁ T) [IsExtraspecial 3 (Source.starImage H r.P)]
    (hnot : ¬ Source.starImage H L₁ ≤ Source.starImage H r.P) :
    ActionAlternative r := by
  classical
  let := r.Pstar_normal
  have hLH : L₁ ≤ H := le_sup_left.trans (r.generated ▸ le_sup_right)
  by_cases hm : ∃ (X : Subgroup G) (hX : X ∈ d.generators), (pCore 2 X).map
      (starAction H r.P X ((d.generated ▸ le_sSup hX).trans hLH)) ≠ ⊥
  · obtain ⟨X, hX, hmove⟩ := hm
    exact Or.inl ⟨X, d.generated ▸ le_sSup hX, d.perfect X hX, d.cubic X hX, hmove⟩
  have hkill := star_core_killed r d (fun X hX => by
    by_contra h
    exact hm ⟨X, hX, h⟩)
  let := d.elementary
  have hstar : IsElementaryAbelian 3 (Source.starImage H L₁) := by
    rw [← starMap_range hLH]
    apply elementary_range_of_core_killed
    rw [starMap_core_image, hkill]
  let := hstar
  have hJH : L₁ ⊔ T ≤ H := r.generated ▸ le_sup_right
  have hgen : Source.starImage H r.P ⊔ Source.starImage H (L₁ ⊔ T) = ⊤ := by
    unfold Source.starImage
    rw [← Subgroup.map_sup, ← subgroupOf_sup r.P_le hJH, ← r.generated,
      subgroupOf_self, map_top_of_surjective _ (QuotientGroup.mk'_surjective _)]
  have hact := central_quotient_action_trivial (Source.starImage H r.P)
    (Source.starImage H (L₁ ⊔ T)) (Source.starImage H L₁) hgen
    (IsElementaryAbelian.isPGroup 3 _)
    (starImage_normalizes H (generation_normalizes d)) r.irreducible
  obtain ⟨x, hxL, hxP⟩ := Set.not_subset.mp hnot
  have hx3 : x ^ 3 = 1 := congrArg Subtype.val
    (Monoid.exponent_dvd_iff_forall_pow_eq_one.mp
      (IsElementaryAbelian.exponent_dvd_p 3 (Source.starImage H L₁)) ⟨x, hxL⟩)
  have hxne : x ≠ 1 := fun he => hxP (he ▸ (Source.starImage H r.P).one_mem)
  exact Or.inr ⟨x, hxL, orderOf_eq_prime hx3 hxne, hxP, hact x hxL⟩

end CFSG.Quasithin.Chapter13.Section08.SolvableExclusion.Three.Extraspecial

