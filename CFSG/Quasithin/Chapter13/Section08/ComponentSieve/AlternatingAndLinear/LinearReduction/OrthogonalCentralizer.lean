module

public import CFSG.Quasithin.Chapter13.Section08.ComponentSieve.AlternatingAndLinear.LinearReduction.OrthogonalBounds
public import Theory.Representation.BinaryPermutation.OffenderFixedSpace

/-!
# Transposition fixed-space rigidity for the S₈ branch

A permutation fixing the transposition-fixed space on the natural module
fixes every weight-two vector supported outside the transposed pair, modulo
constants. A weight-two vector cannot acquire a nonzero constant displacement:
one can choose a coordinate outside its support and the permuted support.
Preserving all those pairs fixes each of the other six letters. Only the
identity and the marked transposition remain. The same argument works on
the augmentation cover, before quotienting by constants.

We transport this calculation through actual equivariant identifications and
combine it with the critical-line centralizer sieve for a faithful submodule
and quotient. This proves the terminal rank-one contradiction after their
orthogonal models and the critical actor are supplied.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*, combined
manuscript of 1 March 2004, 13.8.25, printed p.960, PDF p.977. No recognition
of arbitrary six- or seven-dimensional modules is assumed from dimension alone.
-/

public section

open Representation.BinaryOffender BinaryPermutation
namespace CFSG.Quasithin.Chapter13.Section08.ComponentSieve.AlternatingAndLinear.LinearReduction
private def pair (i j : Fin 8) : Full (Fin 8) := Pi.single i 1 + Pi.single j 1

private theorem pair_fixed (g : Equiv.Perm (Fin 8)) (i j : Fin 8) (hij : i ≠ j)
    (h : deletedRepresentation (Fin 8) g ((constants (Fin 8)).mkQ (pair i j)) =
      (constants (Fin 8)).mkQ (pair i j)) : g i = i ∨ g i = j := by
  obtain ⟨c, hc⟩ := (deleted_fixed_iff g (pair i j)).mp h
  have hx : ∃ k : Fin 8, k ≠ i ∧ k ≠ j ∧ k ≠ g i ∧ k ≠ g j := by
    by_contra hn
    push Not at hn
    have h0 := hn 0
    have h1 := hn 1
    have h2 := hn 2
    have h3 := hn 3
    have h4 := hn 4
    omega
  obtain ⟨k, hki, hkj, hkgi, hkgj⟩ := hx
  have hkii : g.symm k ≠ i := fun h => hkgi ((g.apply_symm_apply k).symm.trans (congrArg g h))
  have hkji : g.symm k ≠ j := fun h => hkgj ((g.apply_symm_apply k).symm.trans (congrArg g h))
  have hc0 : c = 0 := by
    simpa [pair, Pi.single_apply, hki, hkj, hkii, hkji, Ne.symm hki, Ne.symm hkj,
      Ne.symm hkii, Ne.symm hkji] using (hc k).symm
  have he := hc (g i)
  rw [g.symm_apply_apply, hc0] at he
  by_contra hn
  push Not at hn
  simp [pair, hij, hn.1, hn.2] at he

private def corePair (i j : Fin 8) : core (Fin 8) := ⟨pair i j, by
  simp [pair, mem_core, Finset.sum_add_distrib, CharTwo.add_self_eq_zero]⟩

private def naturalPair (i j : Fin 8) : natural (Fin 8) :=
  ⟨(constants (Fin 8)).mkQ (pair i j), ⟨pair i j, (corePair i j).property, rfl⟩⟩

/-- The subgroup generated by the marked transposition `(0 1)` in S₈. -/
abbrev transpositionGroup : Subgroup (Equiv.Perm (Fin 8)) := Subgroup.closure {Equiv.swap 0 1}

private theorem corePair_fixed (i j : Fin 8) (hi0 : i ≠ 0) (hi1 : i ≠ 1)
    (hj0 : j ≠ 0) (hj1 : j ≠ 1) :
    corePair i j ∈ fixedSpace (coreRepresentation (Fin 8)) transpositionGroup := by
  rw [mem_fixedSpace_closure_iff]
  intro a ha
  have ha' : a = Equiv.swap 0 1 := ha
  subst a
  apply Subtype.ext
  change representation (Fin 8) (Equiv.swap 0 1) (pair i j) = pair i j
  rw [swap_fixed_iff]
  simp [pair, hi0, hi1, hj0, hj1]

private theorem naturalPair_fixed (i j : Fin 8) (hi0 : i ≠ 0) (hi1 : i ≠ 1)
    (hj0 : j ≠ 0) (hj1 : j ≠ 1) :
    naturalPair i j ∈ fixedSpace (naturalRepresentation (Fin 8)) transpositionGroup := by
  intro a
  apply Subtype.ext
  exact congrArg ((constants (Fin 8)).mkQ)
    (congrArg Subtype.val (corePair_fixed i j hi0 hi1 hj0 hj1 a))

private theorem permutation_test (g : Equiv.Perm (Fin 8))
    (h : ∀ i j : Fin 8, i ≠ 0 → i ≠ 1 → j ≠ 0 → j ≠ 1 → i ≠ j →
      deletedRepresentation (Fin 8) g ((constants (Fin 8)).mkQ (pair i j)) =
        (constants (Fin 8)).mkQ (pair i j)) :
    g = 1 ∨ g = Equiv.swap 0 1 := by
  have hrest (i : Fin 8) (hi0 : i ≠ 0) (hi1 : i ≠ 1) : g i = i := by
    have hex : ∀ i : Fin 8, i ≠ 0 → i ≠ 1 → ∃ j k : Fin 8,
        j ≠ 0 ∧ j ≠ 1 ∧ k ≠ 0 ∧ k ≠ 1 ∧ i ≠ j ∧ i ≠ k ∧ j ≠ k := by decide
    obtain ⟨j, k, hj0, hj1, hk0, hk1, hij, hik, hjk⟩ := hex i hi0 hi1
    have hj := pair_fixed g i j hij (h i j hi0 hi1 hj0 hj1 hij)
    have hk := pair_fixed g i k hik (h i k hi0 hi1 hk0 hk1 hik)
    rcases hj with he | he
    · exact he
    · exact hk.resolve_right (fun he' => hjk (he.symm.trans he'))
  have h01 (i : Fin 8) (hi : i = 0 ∨ i = 1) : g i = 0 ∨ g i = 1 := by
    by_contra hn
    push Not at hn
    have he := g.injective (hrest (g i) hn.1 hn.2)
    rcases hi with rfl | rfl
    · exact hn.1 he
    · exact hn.2 he
  have h0 := h01 0 (Or.inl rfl)
  have h1 := h01 1 (Or.inr rfl)
  have hne : g 0 ≠ g 1 := g.injective.ne (by decide)
  rcases h0 with h0 | h0
  · left
    have h1 : g 1 = 1 := h1.resolve_left (fun he => hne (h0.trans he.symm))
    apply Equiv.ext
    intro i
    by_cases hi0 : i = 0
    · simpa [hi0] using h0
    by_cases hi1 : i = 1
    · simpa [hi1] using h1
    exact hrest i hi0 hi1
  · right
    have h1 : g 1 = 0 := h1.resolve_right (fun he => hne (h0.trans he.symm))
    apply Equiv.ext
    intro i
    by_cases hi0 : i = 0
    · simpa [hi0] using h0
    by_cases hi1 : i = 1
    · simpa [hi1] using h1
    simpa [Equiv.swap_apply_of_ne_of_ne hi0 hi1] using hrest i hi0 hi1

/-- The pointwise centralizer of the fixed space of `(0 1)` on the actual
six-dimensional natural S₈ module is precisely its cyclic subgroup. -/
theorem natural_transposition_centralizer :
    subspaceKernel (naturalRepresentation (Fin 8))
      (fixedSpace (naturalRepresentation (Fin 8)) transpositionGroup) ⊤ = transpositionGroup := by
  apply le_antisymm
  · intro g hg
    have he := permutation_test g (fun i j hi0 hi1 hj0 hj1 _ =>
      congrArg Subtype.val (hg.2 (naturalPair i j) (naturalPair_fixed i j hi0 hi1 hj0 hj1)))
    rcases he with rfl | rfl
    · exact Subgroup.one_mem _
    · exact Subgroup.subset_closure rfl
  · intro g hg
    exact ⟨Subgroup.mem_top _, fun v hv => hv ⟨g, hg⟩⟩

/-- The same rigidity for the seven-dimensional augmentation cover. -/
theorem core_transposition_centralizer :
    subspaceKernel (coreRepresentation (Fin 8))
      (fixedSpace (coreRepresentation (Fin 8)) transpositionGroup) ⊤ = transpositionGroup := by
  apply le_antisymm
  · intro g hg
    have he := permutation_test g (fun i j hi0 hi1 hj0 hj1 _ =>
      congrArg ((constants (Fin 8)).mkQ)
        (congrArg Subtype.val (hg.2 (corePair i j) (corePair_fixed i j hi0 hi1 hj0 hj1))))
    rcases he with rfl | rfl
    · exact Subgroup.one_mem _
    · exact Subgroup.subset_closure rfl
  · intro g hg
    exact ⟨Subgroup.mem_top _, fun v hv => hv ⟨g, hg⟩⟩

variable {H U E : Type*} [Group H] [AddCommGroup U] [Module (ZMod 2) U]
  [AddCommGroup E] [Module (ZMod 2) E]

private theorem kernel_transport (ρ : Representation (ZMod 2) H U)
    (σ : Representation (ZMod 2) (Equiv.Perm (Fin 8)) E)
    (eH : H ≃* Equiv.Perm (Fin 8)) (e : U ≃ₗ[ZMod 2] E)
    (he : ∀ g u, e (ρ g u) = σ (eH g) (e u))
    (A : Subgroup H) (B : Subgroup (Equiv.Perm (Fin 8))) (hAB : A.map eH.toMonoidHom = B)
    (hB : subspaceKernel σ (fixedSpace σ B) ⊤ = B) :
    subspaceKernel ρ (fixedSpace ρ A) ⊤ = A := by
  apply le_antisymm
  · intro g hg
    have him : eH g ∈ subspaceKernel σ (fixedSpace σ B) ⊤ := by
      refine ⟨Subgroup.mem_top _, ?_⟩
      intro w hw
      rw [← hAB, ← fixedSpace_map_equivariant ρ σ eH.toMonoidHom e he A] at hw
      obtain ⟨u, hu, rfl⟩ := hw
      exact (he g u).symm.trans (congrArg e (hg.2 u hu))
    rw [hB, ← hAB] at him
    obtain ⟨a, ha, hag⟩ := him
    have : a = g := eH.injective hag
    exact this ▸ ha
  · intro g hg
    exact ⟨Subgroup.mem_top _, fun v hv => hv ⟨g, hg⟩⟩


/-- Rigidity transported along actual group and module equivalences.
The actor must map to the same marked transposition used by the model. -/
theorem eightNaturalOrCover_transposition_centralizer (ρ : Representation (ZMod 2) H U)
    (eH : H ≃* Equiv.Perm (Fin 8)) (hmodel : IsEightNaturalOrCover ρ eH)
    (A : Subgroup H) (hA : A.map eH.toMonoidHom = transpositionGroup) :
    subspaceKernel ρ (fixedSpace ρ A) ⊤ = A := by
  rcases hmodel with ⟨e, he⟩ | ⟨e, he⟩
  · exact kernel_transport ρ (naturalRepresentation (Fin 8)) eH e he A
      transpositionGroup hA natural_transposition_centralizer
  · exact kernel_transport ρ (coreRepresentation (Fin 8)) eH e he A
      transpositionGroup hA core_transposition_centralizer

private theorem submodule_centralizer (ρ : Representation (ZMod 2) H U)
    (J : Subrepresentation ρ) (A : Subgroup H)
    (hJ : subspaceKernel J.toRepresentation (fixedSpace J.toRepresentation A) ⊤ = A) :
    subspaceKernel ρ (fixedSpace ρ A) ⊤ = A := by
  apply le_antisymm
  · intro g hg
    apply hJ.le
    refine ⟨Subgroup.mem_top _, ?_⟩
    intro j hj
    apply Subtype.ext
    exact hg.2 j (fun a => congrArg Subtype.val (hj a))
  · intro g hg
    exact ⟨Subgroup.mem_top _, fun v hv => hv ⟨g, hg⟩⟩

variable [FiniteDimensional (ZMod 2) U]
/-- The rank-one terminal contradiction of the orthogonal branch, with
the pointwise centralizers proved for the concrete models. It suffices that
W contains a natural or augmentation submodule, for example `[W,H]`.
Recognition of those submodules and of the marked transposition, together
with the larger critical actor, is required from the source application. -/
theorem rank_one_orthogonal_contradiction (ρ : Representation (ZMod 2) H U)
    (W : Subrepresentation ρ) (J : Subrepresentation W.toRepresentation)
    (eH : H ≃* Equiv.Perm (Fin 8))
    (hJ : IsEightNaturalOrCover J.toRepresentation eH)
    (hQ : IsEightNaturalOrCover W.quotientRepresentation eH)
    (hWfaith : Function.Injective W.toRepresentation)
    (hQfaith : Function.Injective W.quotientRepresentation)
    (A B : Subgroup H) (hA : A ≠ ⊥) (hAB : A < B)
    (hAm : A.map eH.toMonoidHom = transpositionGroup)
    (hsmall : fixedCodim ρ A ≤ 2)
    (S : Submodule (ZMod 2) U) (hS : IsAtom S)
    (hcomm : ∀ b ∈ B, ∀ c ∈ fixedSpace ρ A, ρ b c - c ∈ S) : False := by
  have hw := submodule_centralizer W.toRepresentation J A
    (eightNaturalOrCover_transposition_centralizer J.toRepresentation eH hJ A hAm)
  have hq := eightNaturalOrCover_transposition_centralizer W.quotientRepresentation eH hQ A hAm
  rcases faithful_sections_centralizer_sieve ρ W S hS hWfaith hQfaith hA hAB
      hsmall hcomm with ⟨_, _, hlt⟩ | ⟨_, _, hlt⟩
  · rw [hq] at hlt
    exact (lt_irrefl _ hlt)
  · rw [hw] at hlt
    exact (lt_irrefl _ hlt)
end CFSG.Quasithin.Chapter13.Section08.ComponentSieve.AlternatingAndLinear.LinearReduction
