module

public import CFSG.Quasithin.Chapter13.Section08.ComponentSieve.AlternatingAndLinear.Seven.PointwiseCentralizer
public import CFSG.Quasithin.ChapterB.Section03.Offenders.Odd.FullClassification.OrbitBound
public import Theory.Representation.BinaryPermutation.OddOffenderTransport
public import Theory.Representation.BinaryOffender.SectionLinear
public import Theory.Representation.BinaryOffender.EquivariantOffender
public import Mathlib.GroupTheory.Perm.Cycle.Type
import Mathlib.Tactic

/-!
# Transvection actors on modules containing the seven-point natural module

The existing odd permutation offender bound applies to an embedded core:
restriction cannot increase fixed codimension. At codimension one equality
forces a cyclic group generated by one actual transposition. Its pointwise
centralizer is then computed by `PointwiseCentralizer`. If every nonidentity
element of an elementary actor is a transvection, the sign map embeds the
actor in the group of order two, so its binary rank is one.

All natural-module inputs are injective equivariant maps for the very same
seven-point group action. Producing those maps from the alternatives in B.4
remains a separate source obligation; no alternative is discarded here.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*,
B.3.2 and the last paragraph of 13.8.24, printed pp.83–84, 959.
-/

public section
namespace CFSG.Quasithin.Chapter13.Section08.ComponentSieve.Seven
open BinaryPermutation Representation.BinaryOffender Subgroup
variable {H E : Type*} [Group H] [Finite H] [AddCommGroup E] [Module (ZMod 2) E]
  [FiniteDimensional (ZMod 2) E]
  (ρ : Representation (ZMod 2) H E)
  (φ : H →* Equiv.Perm (Fin 7)) (hφ : Function.Injective φ)
  (j : core (Fin 7) →ₗ[ZMod 2] E) (hj : Function.Injective j)
  (heq : ∀ g v, j (coreRepresentation _ (φ g) v) = ρ g (j v))

/-- A literal equivariant copy of the six-dimensional natural module in `E`.
This is a consequence, rather than a substitute, for a source identification
of `[E,H]` with the natural module. -/
@[expose] def HasNaturalSubmodule : Prop :=
  ∃ j : core (Fin 7) →ₗ[ZMod 2] E, Function.Injective j ∧
    ∀ g v, j (coreRepresentation _ (φ g) v) = ρ g (j v)

include hj heq in
omit [Finite H] in
private theorem full_fixedCodim_le_embedded (A : Subgroup H) :
    fixedCodim (representation (Fin 7)) (A.map φ) ≤ fixedCodim ρ A := by
  let R : Subrepresentation ρ := {
    toSubmodule := LinearMap.range j
    apply_mem_toSubmodule := by
      rintro g v ⟨u, rfl⟩
      exact ⟨coreRepresentation _ (φ g) u, heq g u⟩ }
  let e : core (Fin 7) ≃ₗ[ZMod 2] R.toSubmodule := LinearEquiv.ofInjective j hj
  have he : ∀ g v, e ((coreRepresentation (Fin 7)).comp φ g v) =
      R.toRepresentation g (e v) := fun g v => Subtype.ext (heq g v)
  have hc := Representation.BinaryOffender.OddTransport.fixedCodim_eq_of_equivariant
    ((coreRepresentation (Fin 7)).comp φ) R.toRepresentation e he A
  have hb := fixedCodim_subrepresentation_le ρ R A
  have ho := fixedCodim_core_eq_full_odd (Fin 7) (by decide) (A.map φ)
  have ht : fixedCodim ((coreRepresentation (Fin 7)).comp φ) A =
      fixedCodim (coreRepresentation (Fin 7)) (A.map φ) := by
    unfold fixedCodim
    rw [fixedSpace_comp_map]
  omega

include hφ in
omit [Finite H] in
private theorem elementary_map {A : Subgroup H} (hA : IsElementaryTwo A) :
    IsElementaryTwo (A.map φ) := by
  let : IsElementaryAbelian 2 A := hA.2
  refine ⟨?_, IsElementaryAbelian.map φ⟩
  intro hz
  apply hA.1
  apply Subgroup.map_injective hφ
  simpa only [Subgroup.map_bot] using hz

include hφ hj heq in
omit [Finite H] in
/-- The ordinary offender bound persists in every module containing the natural core. -/
theorem rank_le_fixedCodim_of_embedded_core {A : Subgroup H} (hA : IsElementaryTwo A) :
    rank A ≤ fixedCodim ρ A := by
  have hb := ChapterB.Offenders.Odd.rank_le_fixedCodim_full_of_elementary
    (Or.inr rfl) (A.map φ) (elementary_map φ hφ hA)
  rw [rank_map_injective φ hφ] at hb
  exact hb.trans (full_fixedCodim_le_embedded ρ φ j hj heq A)

include hφ hj heq in
/-- An elementary actor of fixed codimension one is generated by an actual transposition. -/
theorem cyclic_swap_of_fixedCodim_one {A : Subgroup H} (hA : IsElementaryTwo A)
    (hc : fixedCodim ρ A = 1) :
    rank A = 1 ∧ ∃ a : H, A = zpowers a ∧ (φ a).IsSwap := by
  have hr := rank_le_fixedCodim_of_embedded_core ρ φ hφ j hj heq hA
  have hp := hA.rank_pos
  have hr1 : rank A = 1 := by omega
  refine ⟨hr1, ?_⟩
  let B := A.map φ
  have hB : IsElementaryTwo B := elementary_map φ hφ hA
  have hrB : rank B = 1 := (rank_map_injective φ hφ A).trans hr1
  have hf : fixedCodim (representation (Fin 7)) B = rank B := by
    have hle := full_fixedCodim_le_embedded ρ φ j hj heq A
    have hge := ChapterB.Offenders.Odd.rank_le_fixedCodim_full_of_elementary
      (Or.inr rfl) B hB
    change fixedCodim (representation (Fin 7)) B ≤ fixedCodim ρ A at hle
    omega
  obtain ⟨_, hsw⟩ := ChapterB.Offenders.Odd.pair_orbits_of_fixedCodim_full_eq_rank
    (Or.inr rfl) B hB hf
  obtain ⟨g, hg, hgne⟩ : ∃ g ∈ B, g ≠ 1 := by
    by_contra! h
    exact hB.1 (eq_bot_iff.mpr (fun g hg => h g hg))
  obtain ⟨i, hi⟩ : ∃ i, g i ≠ i := by
    by_contra! h
    exact hgne (Equiv.ext h)
  have hswap : (Equiv.swap i (g i)).IsSwap := ⟨i, g i, hi.symm, rfl⟩
  have hsB := hsw i (g i) (MulAction.mem_orbit i (⟨g, hg⟩ : B))
  have hgen : zpowers (Equiv.swap i (g i)) = B := by
    apply Subgroup.eq_of_le_of_card_ge ((zpowers_le).mpr hsB)
    rw [hB.card_eq_two_pow_rank, hrB, pow_one, Nat.card_zpowers, hswap.orderOf]
  obtain ⟨a, ha, he⟩ := hsB
  refine ⟨a, ?_, he ▸ hswap⟩
  apply Subgroup.map_injective hφ
  rw [MonoidHom.map_zpowers, he]
  exact hgen.symm

include hφ hj heq in
/-- The actual pointwise centralizer of the fixed hyperplane equals the actor. -/
theorem pointwiseCentralizer_of_fixedCodim_one {A : Subgroup H} (hA : IsElementaryTwo A)
    (hc : fixedCodim ρ A = 1) :
    subspaceKernel ρ (fixedSpace ρ A) ⊤ = A := by
  obtain ⟨_, a, rfl, ha⟩ := cyclic_swap_of_fixedCodim_one ρ φ hφ j hj heq hA hc
  exact embedded_core_fixed_centralizer ρ φ hφ j hj heq a ha


include hφ hj heq in
/-- A transvection involution has transposition image in the same seven-point action. -/
theorem swap_of_involution_fixedCodim_one (a : H) (hne : a ≠ 1) (hpow : a ^ 2 = 1)
    (hc : fixedCodim ρ (zpowers a) = 1) : (φ a).IsSwap := by
  have hA : IsElementaryTwo (zpowers a) :=
    ⟨by simpa using hne, IsElementaryAbelian.zpowers_of_pow_eq_one hpow⟩
  obtain ⟨_, b, hgen, hb⟩ := cyclic_swap_of_fixedCodim_one ρ φ hφ j hj heq hA hc
  have hm : φ a ∈ zpowers (φ b) := by
    rw [← MonoidHom.map_zpowers, ← hgen]
    exact mem_map_of_mem φ (mem_zpowers a)
  rw [mem_zpowers_iff_mem_range_orderOf, hb.orderOf] at hm
  have htwo : φ a = 1 ∨ φ a = φ b := by
    obtain ⟨n, hn, hnval⟩ := Finset.mem_image.mp hm
    have hnlt : n < 2 := Finset.mem_range.mp hn
    interval_cases n <;> simp_all
  rcases htwo with h | h
  · exact False.elim (hne (hφ (h.trans φ.map_one.symm)))
  · exact h ▸ hb

include hφ hj heq in
/-- A nontrivial elementary group of transvections has binary rank one. -/
theorem rank_one_of_transvections {A : Subgroup H} (hA : IsElementaryTwo A)
    (ht : ∀ a ∈ A, a ≠ 1 → fixedCodim ρ (zpowers a) = 1) : rank A = 1 := by
  let : IsElementaryAbelian 2 A := hA.2
  have hs (a : H) (ha : a ∈ A) (hne : a ≠ 1) : (φ a).IsSwap :=
    swap_of_involution_fixedCodim_one ρ φ hφ j hj heq a hne
      (elemPow_eq_one_of_isElementaryAbelian a ha) (ht a ha hne)
  let f : A →* ℤˣ := Equiv.Perm.sign.comp (φ.comp A.subtype)
  have hf : f.ker = ⊥ := by
    apply eq_bot_iff.mpr
    intro a ha
    apply Subtype.ext
    by_contra hn
    have hsign := (hs a a.property hn).sign_eq
    have ha' : (φ a).sign = 1 := ha
    rw [ha'] at hsign
    norm_num at hsign
  have hc := Nat.card_le_card_of_injective f ((MonoidHom.ker_eq_bot_iff f).mp hf)
  have htwo : Nat.card ℤˣ = 2 := by
    rw [Nat.card_eq_fintype_card]
    decide
  rw [htwo] at hc
  have hl := Nat.log_monotone (b := 2) hc
  have hp := hA.rank_pos
  change rank A ≤ Nat.log 2 2 at hl
  norm_num at hl
  omega

include hφ hj heq in
omit [Finite H] in
/-- A module containing the natural core has no strong FF offender. -/
theorem no_strongOffender_of_embedded_core : ¬ IsStrongFFModule ρ := by
  rintro ⟨A, hA, hlt⟩
  exact (Nat.not_lt_of_ge (rank_le_fixedCodim_of_embedded_core ρ φ hφ j hj heq hA)) hlt

end CFSG.Quasithin.Chapter13.Section08.ComponentSieve.Seven
