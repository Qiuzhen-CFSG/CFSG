private def factors : List (Fin 8 × Fin 98 × Fin 8) :=
  factors0 ++ factors1 ++ factors2 ++ factors3 ++ factors4 ++ factors5 ++ factors6

set_option maxRecDepth 100000 in
set_option maxHeartbeats 64000000 in
private theorem factor_certificate : List.Forall₂
    (fun g (t : Fin 8 × Fin 98 × Fin 8) => g = upper t.1 * rep t.2.1 * upper t.2.2)
    (permsOfList [0, 1, 2, 3, 4, 5, 6]) factors := by
  decide +kernel

private theorem left_exists {α β : Type*} {R : α → β → Prop} {l : List α} {m : List β}
    (h : List.Forall₂ R l m) {a : α} (ha : a ∈ l) : ∃ b, R a b := by
  induction h with
  | nil => simp at ha
  | @cons x y xs ys hxy h ih =>
    rcases List.mem_cons.mp ha with rfl | ha
    · exact ⟨y, hxy⟩
    · exact ih ha

/-- Every permutation has a factorization using the displayed double cosets. -/
theorem decomposition (g : S7) : ∃ i j k, g = upper i * rep j * upper k := by
  have hg : g ∈ permsOfList [0, 1, 2, 3, 4, 5, 6] := by
    apply mem_permsOfList_of_mem
    intro x _
    fin_cases x <;> simp
  obtain ⟨⟨i, j, k⟩, h⟩ := left_exists factor_certificate hg
  exact ⟨i, j, k, h⟩

