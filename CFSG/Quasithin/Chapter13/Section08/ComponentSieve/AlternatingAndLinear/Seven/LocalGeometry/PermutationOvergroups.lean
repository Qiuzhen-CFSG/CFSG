module

public import CFSG.Quasithin.Chapter13.Section08.ComponentSieve.AlternatingAndLinear.Seven.LocalGeometry.PermutationOvergroups.Placement
public import CFSG.Quasithin.Chapter13.Section08.ComponentSieve.AlternatingAndLinear.Seven.LocalGeometry.PermutationOvergroups.Stabilizers

/-!
# Solvable Sylow overgroups in the seven-point action

For any A₇ ≤ B ≤ S₇, a solvable subgroup of B containing a Sylow two-subgroup
lies in the inverse image of one of the two actual partition stabilizers.
That inverse image is solvable and generated by its elements of order three
together with the original Sylow subgroup. The same conjugation gives the
source's four-point, two-point, and singleton orbits.

Sylow conjugacy first normalizes the supplied subgroup inside B. The placement
and stabilizer modules supply the dichotomy and generation in those coordinates.
Transport along the inverse automorphism preserves element orders and subgroup
generation. The coordinate module also proves that the pair stabilizer has
order 48, excluding a factor of nine in that alternative.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*,
13.8.24, printed pp.958–959 (1 March 2004 manuscript).
-/

public section
open Equiv Subgroup
namespace CFSG.Quasithin.Chapter13.Section08.ComponentSieve.Seven.LocalGeometry.PermutationOvergroups

private theorem transport_generation {G : Type*} [Group G] (e : G ≃* G)
    (D S T : Subgroup G) (hS : S.map e.toMonoidHom = T)
    (hD : D = Subgroup.closure {g : G | g ∈ D ∧ orderOf g = 3} ⊔ T) :
    D.comap e.toMonoidHom =
      Subgroup.closure {g : G | g ∈ D.comap e.toMonoidHom ∧ orderOf g = 3} ⊔ S := by
  apply Subgroup.map_injective (f := e.toMonoidHom) e.injective
  rw [Subgroup.map_comap_eq_self_of_surjective e.surjective, Subgroup.map_sup,
    MonoidHom.map_closure, hS]
  have he : e.toMonoidHom '' {g : G | g ∈ D.comap e.toMonoidHom ∧ orderOf g = 3} =
      {g : G | g ∈ D ∧ orderOf g = 3} := by
    ext g
    constructor
    · rintro ⟨x, ⟨hx, ho⟩, rfl⟩
      exact ⟨hx, (e.orderOf_eq x).trans ho⟩
    · rintro ⟨hg, ho⟩
      refine ⟨e.symm g, ⟨?_, (e.symm.orderOf_eq g).trans ho⟩, e.apply_symm_apply g⟩
      change e (e.symm g) ∈ D
      simpa only [e.apply_symm_apply] using hg
  rw [he]
  exact hD


/-- A solvable overgroup of a Sylow two-subgroup admits a source partition
stabilizer in the same coordinates as its four-, two-, and one-point orbits.
The inverse image of that stabilizer is solvable and is generated by the
original Sylow subgroup and its own elements of order three. -/
theorem solvable_sylow_overgroup_compatible_placement (B : Subgroup S7)
    (hB : alternatingGroup (Fin 7) ≤ B) (S : Sylow 2 B) (P : Subgroup B)
    [Group.IsSolvable P] (hP : (S : Subgroup B) ≤ P) :
    ∃ (σ : S7) (R : Subgroup S7),
      (R = fourThreeStabilizer ∨ R = pairStabilizer) ∧
      let ψ := (MulAut.conj σ).toMonoidHom.comp B.subtype
      let D := R.comap ψ
      σ ∈ B ∧ P ≤ D ∧ Group.IsSolvable D ∧
      D = Subgroup.closure {b : B | b ∈ D ∧ orderOf b = 3} ⊔ (S : Subgroup B) ∧
      (S : Subgroup B).map ψ = (standardTwoIn B).map B.subtype ∧
      {y : Fin 7 | ∃ s : S, ψ s.val 0 = y} = {0, 1, 2, 3} ∧
      {y : Fin 7 | ∃ s : S, ψ s.val 4 = y} = {4, 5} ∧
      {y : Fin 7 | ∃ s : S, ψ s.val 6 = y} = {6} := by
  obtain ⟨σ, hσ, ho⟩ := sylow_compatible_coordinates B hB S
  let e := MulAut.conj σ
  let Q : Subgroup B := P.map e.toMonoidHom
  have : Group.IsSolvable Q :=
    Group.isSolvable_of_surjective (f := e.toMonoidHom.subgroupMap P)
      (e.toMonoidHom.subgroupMap_surjective P)
  have hQ : standardTwoIn B ≤ Q := by
    rw [← hσ]
    exact Subgroup.map_mono hP
  have hex : ∃ R : Subgroup S7,
      (R = fourThreeStabilizer ∨ R = pairStabilizer) ∧
      Q ≤ R.comap B.subtype ∧ Group.IsSolvable (R.comap B.subtype) ∧
      R.comap B.subtype =
        Subgroup.closure {b : B | b ∈ R.comap B.subtype ∧ orderOf b = 3} ⊔
          standardTwoIn B := by
    rcases solvable_overgroup_placement B hB Q hQ with h | h
    · exact ⟨fourThreeStabilizer, Or.inl rfl, h,
        fourThreeStabilizer_comap_isSolvable B,
        fourThreeStabilizer_comap_eq_closure_three_sup_standardTwo B hB⟩
    · exact ⟨pairStabilizer, Or.inr rfl, h,
        pairStabilizer_comap_isSolvable B,
        pairStabilizer_comap_eq_closure_three_sup_standardTwo B hB⟩
  obtain ⟨R, hR, hQR, hsolv, hgen⟩ := hex
  let := hsolv
  refine ⟨σ.val, R, hR, σ.property, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · change P ≤ (R.comap B.subtype).comap e.toMonoidHom
    exact Subgroup.map_le_iff_le_comap.mp hQR
  · apply Group.isSolvable_of_isSolvable_injective
      (f := e.toMonoidHom.subgroupComap (R.comap B.subtype))
    intro x y h
    exact Subtype.ext (e.injective (congrArg Subtype.val h))
  · exact transport_generation e (R.comap B.subtype) S (standardTwoIn B) hσ hgen
  · change (S : Subgroup B).map (B.subtype.comp e.toMonoidHom) = _
    rw [← Subgroup.map_map, hσ]
  · change {y : Fin 7 | ∃ s : S, ((MulAut.conj (σ : S7)) (s.val : S7)) 0 = y} = _
    simp only [ho]
    ext y; fin_cases y <;> decide
  · change {y : Fin 7 | ∃ s : S, ((MulAut.conj (σ : S7)) (s.val : S7)) 4 = y} = _
    simp only [ho]
    ext y; fin_cases y <;> decide
  · change {y : Fin 7 | ∃ s : S, ((MulAut.conj (σ : S7)) (s.val : S7)) 6 = y} = _
    simp only [ho]
    ext y; fin_cases y <;> decide

end CFSG.Quasithin.Chapter13.Section08.ComponentSieve.Seven.LocalGeometry.PermutationOvergroups
