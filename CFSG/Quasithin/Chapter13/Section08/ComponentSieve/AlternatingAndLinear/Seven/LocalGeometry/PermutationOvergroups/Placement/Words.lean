theorem upper_mem (i : Fin 8) :
    upper i ∈ standardTwo ∧ upper i ∈ alternatingGroup (Fin 7) := by
  revert i
  decide +kernel

private def generators (j : Fin 98) (i : Fin 10) : S7 :=
  if h : i.val < 8 then upper ⟨i.val, h⟩ else if i.val = 8 then rep j else (rep j)⁻¹

private def word (j : Fin 98) (w : List (Fin 10)) : S7 :=
  (w.map (generators j)).prod

