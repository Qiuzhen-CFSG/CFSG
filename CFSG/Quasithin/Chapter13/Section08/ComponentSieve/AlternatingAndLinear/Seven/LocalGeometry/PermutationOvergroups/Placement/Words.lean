set_option maxRecDepth 100000 in
set_option maxHeartbeats 8000000 in
private theorem word_certificate : ∀ j : Fin 98,
    rep j ∈ fourThreeStabilizer ∨ rep j ∈ pairStabilizer ∨
      (word j (xWords j) ≠ 1 ∧
        word j (xWords j) = word j (zWords j) *
          ⁅word j (xWords j), word j (yWords j) * word j (xWords j) *
            (word j (yWords j))⁻¹⁆ * (word j (zWords j))⁻¹) := by
  decide +kernel

private theorem word_mem (H : Subgroup S7) (hT : ∀ i, upper i ∈ H)
    (j : Fin 98) (hj : rep j ∈ H) (w : List (Fin 10)) : word j w ∈ H := by
  apply H.list_prod_mem
  intro g hg
  obtain ⟨i, _, rfl⟩ := List.mem_map.mp hg
  dsimp [generators]
  split
  · exact hT _
  · split
    · exact hj
    · exact H.inv_mem hj

/-- An excluded representative forces a nontrivial element into every
term of the derived series of its overgroup. -/
theorem rep_alternative (H : Subgroup S7) (hT : ∀ i, upper i ∈ H)
    (j : Fin 98) (hj : rep j ∈ H) :
    rep j ∈ fourThreeStabilizer ∨ rep j ∈ pairStabilizer ∨ ¬ Group.IsSolvable H := by
  rcases word_certificate j with h | h | ⟨hne, heq⟩
  · exact Or.inl h
  · exact Or.inr (Or.inl h)
  right; right
  let x : H := ⟨word j (xWords j), word_mem H hT j hj _⟩
  let y : H := ⟨word j (yWords j), word_mem H hT j hj _⟩
  let z : H := ⟨word j (zWords j), word_mem H hT j hj _⟩
  have hx : x ≠ 1 := fun h => hne (congrArg Subtype.val h)
  have he : x = z * ⁅x, y * x * y⁻¹⁆ * z⁻¹ := Subtype.ext heq
  apply not_isSolvable_of_mem_derivedSeries hx
  intro n
  induction n with
  | zero => exact mem_top x
  | succ n ih =>
    rw [he, (derivedSeries_normal _ _).mem_comm_iff, inv_mul_cancel_left]
    exact commutator_mem_commutator ih ((derivedSeries_normal _ _).conj_mem _ ih _)

