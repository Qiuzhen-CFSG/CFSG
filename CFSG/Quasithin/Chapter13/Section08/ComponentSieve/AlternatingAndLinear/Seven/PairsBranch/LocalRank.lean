module

public import CFSG.Quasithin.Chapter13.Section08.ComponentSieve.AlternatingAndLinear.Seven.PairsBranch.LocalRank.Stabilizer
public import CFSG.Quasithin.Chapter13.Section08.SourceDefs
public import Theory.GroupTheory.PrimeRankHom
public import Theory.Representation.HexacodeAction.Cover

/-!
# The local rank and A₆ quotient in the three-pairs branch

A faithful, compatible seven-point action places `L₁* T*` in the relative
stabilizer of `{{0,1},{2,3},{4,5},{6}}`. Its full symmetric stabilizer has
three-rank one. The kernel of the actual map from `L₁` to `H/O₂(H)` is
the pullback of `O₂(H)`, hence is a two-group; the kernel rank inequality
therefore gives `m₃(L₁) ≤ 1`.

For positivity we use the genuine identity `L₁ = θ(H ∩ M)` from 13.7.3(9),
where theta is generated by elements of order three (A.3.17). If `L₁` had
three-rank zero, theta would be trivial. This contradicts the earlier
local identity `[V₃,L₁] = V₃ ≠ 1`, recalled on printed p.891. The earlier
covered-A₆ rank calculation then excludes that alternative and leaves an
actual equivalence `L/O₂(L) ≃ A₆`.

This is a conditional local helper for 13.8.24, printed p.959, PDF p.976,
in Aschbacher–Smith, *The Classification of Quasithin Groups* (1 March
2004 manuscript). The source assembly must supply the theta and commutator
identities, the two actual quotient-model alternatives, and the covered
case's rank-two implication, stated explicitly in the proof of 13.7.5
on printed p.938. Neither rank one nor the A₆ quotient is an input.
The covered carrier is the concrete even hexacode automorphism group,
certified as the triple cover in `Theory.Representation.HexacodeAction.Cover`.
No two-residual is replaced by a two-core, and no ambient normality or
surjectivity onto `S₇` is imposed.
-/

@[expose] public section
namespace CFSG.Quasithin.Chapter13.Section08.ComponentSieve.Seven.PairsBranch.LocalRank
open Equiv Subgroup Theory.GroupTheory

variable {G : Type*} [Group G]

/-- The actual order-three generated subgroup, in the convention of A.3.17. -/
def theta (X : Subgroup G) : Subgroup G :=
  closure {x | x ∈ X ∧ orderOf x = 3}

/-- Theta is formed within its specified local overgroup. -/
theorem theta_le (X : Subgroup G) : theta X ≤ X :=
  (closure_le X).mpr (fun _ hx => hx.1)

/-- One action of the actual `H*`, identifying the actual component image
with A₇. In particular this does not assert that the action fills S₇. -/
structure CompatibleAction (H K : Subgroup G) where
  component_le : K ≤ H
  φ : Source.Hstar H →* S7
  faithful : Function.Injective φ
  component_image : (Source.starImage H K).map φ = alternatingGroup (Fin 7)

/-- The compatibility gives an actual A₇ equivalence for `K*`. -/
noncomputable def CompatibleAction.componentEquiv {H K : Subgroup G}
    (a : CompatibleAction H K) : Source.starImage H K ≃* alternatingGroup (Fin 7) :=
  ((Source.starImage H K).equivMapOfInjective a.φ a.faithful).trans
    (MulEquiv.subgroupCongr a.component_image)

/-- Restrict the genuine quotient map `H → H/O₂(H)` to the given subgroup. -/
def starRestriction (H X : Subgroup G) (hle : X ≤ H) : X →* Source.Hstar H :=
  (QuotientGroup.mk' (pCore 2 H)).comp (inclusion hle)

/-- This restriction has precisely the source's star image. -/
theorem starRestriction_range (H X : Subgroup G) (hle : X ≤ H) :
    (starRestriction H X hle).range = Source.starImage H X := by
  ext y
  constructor
  · rintro ⟨x, rfl⟩
    exact ⟨inclusion hle x, x.property, rfl⟩
  · rintro ⟨x, hx, rfl⟩
    exact ⟨⟨x.val, hx⟩, rfl⟩

/-- The kernel is the intersection with the two-core of H, pulled back to X.
It is not identified with `O₂(X)`. -/
theorem starRestriction_ker (H X : Subgroup G) (hle : X ≤ H) :
    (starRestriction H X hle).ker = (pCore 2 H).comap (inclusion hle) := by
  ext x
  simp only [MonoidHom.mem_ker, starRestriction, MonoidHom.comp_apply, mem_comap]
  exact QuotientGroup.eq_one_iff _

/-- The actual star kernel is a two-group, with no ambient normality premise. -/
theorem starRestriction_ker_isTwoGroup (H X : Subgroup G) (hle : X ≤ H) :
    IsPGroup 2 (starRestriction H X hle).ker := by
  rw [starRestriction_ker]
  exact pCore_isPGroup.comap_of_injective _ (inclusion_injective hle)

variable [Finite G]

/-- Rank transport through the actual star kernel into the relative stabilizer. -/
theorem local_threeRank_le_one (H L₁ T : Subgroup G) (hle : L₁ ≤ H)
    (φ : Source.Hstar H →* S7) (hφ : Function.Injective φ)
    (hplacement : Source.starImage H L₁ ⊔ Source.starImage H T = pairStabilizer.comap φ) :
    primeRank 3 L₁ ≤ 1 := by
  let q := starRestriction H L₁ hle
  have hmem (x : L₁) : φ (q x) ∈ pairStabilizer := by
    change q x ∈ pairStabilizer.comap φ
    rw [← hplacement]
    apply (le_sup_left : Source.starImage H L₁ ≤ Source.starImage H L₁ ⊔ Source.starImage H T)
    exact ⟨inclusion hle x, x.property, rfl⟩
  let f : L₁ →* pairStabilizer := (φ.comp q).codRestrict pairStabilizer hmem
  have hk : f.ker = q.ker := by
    ext x
    change (⟨φ (q x), hmem x⟩ : pairStabilizer) = 1 ↔ q x = 1
    rw [Subtype.ext_iff]
    change φ (q x) = 1 ↔ q x = 1
    rw [← φ.map_one, hφ.eq_iff]
  have hkp : IsPGroup 2 f.ker := hk ▸ starRestriction_ker_isTwoGroup H L₁ hle
  have hk0 : primeRank 3 f.ker = 0 := by
    apply PrimeRank.eq_zero_iff_not_dvd_card.mpr
    obtain ⟨n, hn⟩ := hkp.exists_card_dvd_pow
    intro hd
    exact (by decide : ¬ 3 ∣ 2) ((by decide : Nat.Prime 3).dvd_of_dvd_pow (hd.trans hn))
  have h := primeRank_le_ker_add (p := 3) f
  simpa only [hk0, pairStabilizer_threeRank, zero_add] using h

/-- Nonzero three-rank follows from theta and the nontrivial earlier local action. -/
theorem local_threeRank_pos (H M L₁ V₃ : Subgroup G) (htheta : L₁ = theta (H ⊓ M))
    (hV : V₃ ≠ ⊥) (hgen : ⁅V₃, L₁⁆ = V₃) : 0 < primeRank 3 L₁ := by
  by_contra! hz
  have hz' : primeRank 3 L₁ = 0 := Nat.eq_zero_of_le_zero hz
  have hn : ¬ 3 ∣ Nat.card L₁ := PrimeRank.eq_zero_iff_not_dvd_card.mp hz'
  have hbot : L₁ = ⊥ := by
    rw [htheta]
    apply le_antisymm _ bot_le
    apply (closure_le _).mpr
    intro x hx
    have hxL : x ∈ L₁ := htheta.symm ▸ subset_closure hx
    have hxord : orderOf (⟨x, hxL⟩ : L₁) = 3 := (orderOf_coe _).symm.trans hx.2
    exact (hn (hxord ▸ orderOf_dvd_natCard (⟨x, hxL⟩ : L₁))).elim
  rw [hbot, commutator_bot_right] at hgen
  exact hV hgen.symm

/-- The local rank-one conclusion in the compatible three-pairs branch. -/
theorem local_threeRank_eq_one (H M K L₁ T V₃ : Subgroup G)
    (a : CompatibleAction H K)
    (hplacement : Source.starImage H L₁ ⊔ Source.starImage H T = pairStabilizer.comap a.φ)
    (htheta : L₁ = theta (H ⊓ M)) (hV : V₃ ≠ ⊥) (hgen : ⁅V₃, L₁⁆ = V₃) :
    primeRank 3 L₁ = 1 := by
  have hle : L₁ ≤ H := by
    rw [htheta]
    exact (theta_le (H ⊓ M)).trans inf_le_left
  have hu := local_threeRank_le_one H L₁ T hle a.φ a.faithful hplacement
  have hp := local_threeRank_pos H M L₁ V₃ htheta hV hgen
  omega

/-- Both local conclusions, eliminating the actual covered-A₆ alternative by
its earlier rank-two calculation. The source assembly supplies that implication. -/
theorem rank_and_quotient (H M K L L₁ T V₃ : Subgroup G)
    (a : CompatibleAction H K)
    (hplacement : Source.starImage H L₁ ⊔ Source.starImage H T = pairStabilizer.comap a.φ)
    (htheta : L₁ = theta (H ⊓ M)) (hV : V₃ ≠ ⊥) (hgen : ⁅V₃, L₁⁆ = V₃)
    (hmodels : Nonempty ((L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 6)) ∨
      Nonempty ((L ⧸ pCore 2 L) ≃* Atlas.Codes.HexEvenAutomorphisms))
    (hcovered : Nonempty ((L ⧸ pCore 2 L) ≃* Atlas.Codes.HexEvenAutomorphisms) →
      primeRank 3 L₁ = 2) :
    primeRank 3 L₁ = 1 ∧ Nonempty ((L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 6)) := by
  have hr := local_threeRank_eq_one H M K L₁ T V₃ a hplacement htheta hV hgen
  refine ⟨hr, ?_⟩
  rcases hmodels with h | h
  · exact h
  · have hc := hcovered h
    omega

/-- A chosen multiplicative equivalence for the actual quotient, obtained by
excluding the covered alternative rather than postulating an A₆ identification. -/
noncomputable def quotientEquiv (H M K L L₁ T V₃ : Subgroup G)
    (a : CompatibleAction H K)
    (hplacement : Source.starImage H L₁ ⊔ Source.starImage H T = pairStabilizer.comap a.φ)
    (htheta : L₁ = theta (H ⊓ M)) (hV : V₃ ≠ ⊥) (hgen : ⁅V₃, L₁⁆ = V₃)
    (hmodels : Nonempty ((L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 6)) ∨
      Nonempty ((L ⧸ pCore 2 L) ≃* Atlas.Codes.HexEvenAutomorphisms))
    (hcovered : Nonempty ((L ⧸ pCore 2 L) ≃* Atlas.Codes.HexEvenAutomorphisms) →
      primeRank 3 L₁ = 2) : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 6) :=
  Classical.choice (rank_and_quotient H M K L L₁ T V₃ a hplacement htheta hV hgen
    hmodels hcovered).2

end CFSG.Quasithin.Chapter13.Section08.ComponentSieve.Seven.PairsBranch.LocalRank
