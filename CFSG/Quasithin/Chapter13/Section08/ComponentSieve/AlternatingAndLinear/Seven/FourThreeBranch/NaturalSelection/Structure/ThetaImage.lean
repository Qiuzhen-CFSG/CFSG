module
public import CFSG.Quasithin.Chapter13.Section08.ComponentSieve.AlternatingAndLinear.Seven.FourThreeBranch.NaturalSelection.Structure.Theta

/-!
# The actual permutation image of the local theta subgroup

The source theta identity bounds the image of L₁ by the subgroup generated
by cubic elements in the partition stabilizer. Conversely every such element
is even, hence is in the ambient image containing A₇, and its order-three
lift belongs to L₁ by 13.8.13. Thus the image is exactly the literal cubic
closure, before any surjectivity or residual-factor marking is assumed.

This common interface separates the source lifting argument from the remaining
intrinsic calculations in S₄ × S₃: its elementary-nine quotient action and its
Sylow-invariant two-perfect factors.

Source: Aschbacher–Smith, 13.7.3(9), 13.8.13 and 13.8.24,
printed pp.936, 950–951 and 958 (1 March 2004 manuscript).
-/

@[expose] public section
open Equiv Subgroup
namespace CFSG.Quasithin.Chapter13.Section08.ComponentSieve.Seven.FourThreeBranch.NaturalSelection
open LocalGeometry

/-- The literal subgroup generated by all cubic elements of the partition stabilizer. -/
def fourThreeTheta : Subgroup S7 :=
  closure {x : S7 | x ∈ fourThreeStabilizer ∧ orderOf x = 3}

private theorem cubic_even (c : S7) (hc : orderOf c = 3) : c ∈ alternatingGroup (Fin 7) := by
  apply Equiv.Perm.mem_alternatingGroup.mpr
  have hpow : c ^ 3 = 1 := hc ▸ pow_orderOf_eq_one c
  have h : c.sign ^ 3 = 1 := by rw [← map_pow, hpow, map_one]
  rw [show (3 : ℕ) = 2 + 1 from rfl, pow_succ, Int.units_sq, one_mul] at h
  exact h

variable {G : Type*} [Group G] [Finite G]

/-- The image of the source theta is exactly the literal cubic-generated
subgroup, before surjectivity or either factor identification is known. -/
theorem local_image_eq_fourThreeTheta
    (H L₁ T G₁ M : Subgroup G)
    (hbase : L₁ ⊔ T ≤ H) (hHG : H ≤ G₁)
    (htheta : L₁ = closure {x : G | x ∈ H ⊓ M ∧ orderOf x = 3})
    (h13 : ∀ J : Subgroup G, L₁ ⊔ T ≤ J → J ≤ G₁ →
      Group.IsSolvable J → J ≤ M)
    (φ : Source.Hstar H →* S7) (hφ : Function.Injective φ)
    (hAlt : alternatingGroup (Fin 7) ≤ φ.range)
    (hP : Source.starImage H (L₁ ⊔ T) ≤ fourThreeStabilizer.comap φ) :
    (Source.starImage H L₁).map φ = fourThreeTheta := by
  let : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  let q : H →* Source.Hstar H := QuotientGroup.mk' (pCore 2 H)
  let f := φ.comp q
  apply le_antisymm
  · have hL : L₁ ≤ (fourThreeTheta.comap f).map H.subtype := by
      rw [htheta]
      apply (closure_le _).mpr
      intro x hx
      let xH : H := ⟨x, hx.1.1⟩
      refine ⟨xH, ?_, rfl⟩
      change f xH ∈ fourThreeTheta
      by_cases he : f xH = 1
      · rw [he]; exact one_mem _
      · apply Subgroup.subset_closure
        have hLx : x ∈ L₁ := htheta.symm ▸ Subgroup.subset_closure hx
        have hq : q xH ∈ Source.starImage H (L₁ ⊔ T) :=
          ⟨xH, (show L₁ ≤ L₁ ⊔ T from le_sup_left) hLx, rfl⟩
        refine ⟨hP hq, orderOf_eq_prime ?_ he⟩
        rw [← map_pow, show xH ^ 3 = 1 from Subtype.ext (hx.2 ▸ pow_orderOf_eq_one x), map_one]
    rintro _ ⟨a, ⟨x, hx, rfl⟩, rfl⟩
    obtain ⟨y, hy, he⟩ := hL hx
    have hyx : y = x := Subtype.ext he
    subst y
    exact hy
  · apply (closure_le _).mpr
    intro c hc
    exact even_order_three_mem_local_image H L₁ T G₁ M hbase hHG htheta h13
      φ hφ hAlt hP c hc.1 (cubic_even c hc.2) hc.2

end CFSG.Quasithin.Chapter13.Section08.ComponentSieve.Seven.FourThreeBranch.NaturalSelection
