module

public import CFSG.Quasithin.Chapter13.Section08.ComponentSieve.AlternatingAndLinear.FourStructure.CriticalTransfer.PairConsequences.DualLowerBound.PlanePermutation.Relations
public import CFSG.Quasithin.Chapter13.Section08.ComponentSieve.AlternatingAndLinear.FourStructure.CriticalTransfer.PairConsequences.DualLowerBound.PlanePermutation.Model
public import CFSG.Quasithin.Chapter13.Section08.ComponentSieve.AlternatingAndLinear.FourStructure.CriticalTransfer.PairConsequences.DualLowerBound.PlanePermutation.FiniteRelations
public import CFSG.Quasithin.Chapter13.Section08.ComponentSieve.AlternatingAndLinear.FourStructure.CriticalTransfer.PairConsequences.DualLowerBound.PlanePermutation.InvolutionClasses
public import Theory.AtlasPort.ExceptionalIsomorphisms.Simplicity

/-!
# No transvections in plane-permutation quotients

A hypothetical rank-one displacement makes the binary representation
nontrivial, hence faithful because GL₄(2) is simple. Its actor is therefore
a nonidentity involution. The plane-parabolic cyclic vector gives an
equivariant generating family on the actual two-planes. Centralizer double
displacements vanish in every rank-one image, so it suffices to express the
involution's permutation displacements as sums of their translates.

The two involution-class calculations and their conjugacy coverage discharge
all finite geometric premises in `finrank_ne_one`. Thus every binary
representation generated by the orbit of a plane-parabolic fixed vector
has no rank-one displacement. The vector may be zero; faithfulness and
irreducibility are not assumptions. Application to the actual source
section and the remaining implications of 13.8.11 belong to its assembly.

The general representation argument, the actual model definitions and the
parabolic-to-plane construction are in `Relations` and `Model`. This module
imports `PlaneSeed` through `Model`, never the `DualLowerBound` assembly.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*, combined
manuscript (1 March 2004), 13.8.4(5), printed p.947; 13.8.11(1), p.950;
and 13.8.25, pp.960–962. This direct permutation-module reduction avoids
assuming G.6.4 or a cohomological splitting theorem.
-/

public section

namespace CFSG.Quasithin.Chapter13.Section08.ComponentSieve.AlternatingAndLinear.FourStructure.CriticalTransfer.PairConsequences.PlanePermutation

private theorem actor_isSimpleGroup : IsSimpleGroup Actor := by
  let : IsSimpleGroup (Matrix.ProjectiveSpecialLinearGroup (Fin 4) (ZMod 2)) :=
    Atlas.psl_simple_high_rank 4 (by decide)
  exact (BinaryLinear.OuterCyclic.projectiveEquivLinear (by decide : 0 < 4)).symm.isSimpleGroup

variable {K V : Type*} [Group K] [AddCommGroup V] [Module (ZMod 2) V]

/-- Reduction to an intrinsic calculation in the permutation module on actual
planes. The conjugacy coverage and two relation calculations are finite-model
premises, discharged in `finrank_ne_one` below. -/
theorem finrank_ne_one_of_involution_certificates
    (hclasses : ∀ t : Actor, t ≠ 1 → t ^ 2 = 1 →
      IsConj firstInvolution t ∨ IsConj secondInvolution t)
    (hfirst : DisplacementRelations (X := Plane) firstInvolution)
    (hsecond : DisplacementRelations (X := Plane) secondInvolution)
    (τ : Representation (ZMod 2) K V) (eK : K ≃* Actor)
    (hgen : IsPlaneParabolicGenerated τ eK) (g : K) :
    Module.finrank (ZMod 2) (LinearMap.range (τ g - 1)) ≠ 1 := by
  intro hr
  let σ := τ.comp eK.symm.toMonoidHom
  have hr' : Module.finrank (ZMod 2) (LinearMap.range (σ (eK g) - 1)) = 1 := by
    have he : σ (eK g) = τ g := congrArg τ (eK.symm_apply_apply g)
    exact (congrArg (fun f : Module.End (ZMod 2) V =>
      Module.finrank (ZMod 2) (LinearMap.range (f - 1))) he).trans hr
  let : IsSimpleGroup Actor := actor_isSimpleGroup
  have hinj := faithful_of_rank_one σ (eK g) hr'
  have ht : eK g ≠ 1 := by
    intro he
    rw [he, map_one, sub_self, LinearMap.range_zero, finrank_bot] at hr'
    exact Nat.zero_ne_one hr'
  have ht2 : eK g ^ 2 = 1 := by
    apply hinj
    rw [map_one]
    exact square_eq_one_of_rank_one σ (eK g) hr'
  obtain ⟨f, hf, hs⟩ := exists_equivariant_generating_family τ eK hgen
  rcases hclasses (eK g) ht ht2 with h | h
  · exact finrank_ne_one_of_relations σ f hf hs (eK g) (hfirst.of_isConj h) hr'
  · exact finrank_ne_one_of_relations σ f hf hs (eK g) (hsecond.of_isConj h) hr'

/-- No element has displacement rank one in a binary representation generated
by the orbit of a vector fixed by an actual plane parabolic of GL₄(2).
This includes the zero representation and requires neither faithfulness nor
irreducibility. -/
theorem finrank_ne_one
    (τ : Representation (ZMod 2) K V)
    (eK : K ≃* BinaryLinear.GL ChiefFactors.NaturalSpace)
    (hgen : IsPlaneParabolicGenerated τ eK) (g : K) :
    Module.finrank (ZMod 2) (LinearMap.range (τ g - 1)) ≠ 1 :=
  finrank_ne_one_of_involution_certificates involution_classes
    first_displacementRelations second_displacementRelations τ eK hgen g

end CFSG.Quasithin.Chapter13.Section08.ComponentSieve.AlternatingAndLinear.FourStructure.CriticalTransfer.PairConsequences.PlanePermutation
