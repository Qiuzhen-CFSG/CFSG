module

public import CFSG.Quasithin.Chapter13.Section08.ComponentSieve.AlternatingAndLinear.FourStructure.ChiefFactors.CentralExclusion.Sections
public import CFSG.Quasithin.Chapter13.Section08.ComponentSieve.AlternatingAndLinear.FourStructure.ChiefFactors.CentralExclusion.Natural

/-!
# Elimination of central L₄(2) chief factors

Suppose a finite-dimensional binary module has compatible natural heads,
a unique maximal submodule, and every noncentral chief factor is natural
or dual for the same specified isomorphism H ≃ GL₄(2). Then every chief
factor is noncentral and natural or dual; in particular it has dimension four.

The natural heads force the module to be generated by commutators.
Descending induction through the subrepresentation lattice proves vanishing
of H¹ for the dual of every quotient. A noncentral chief layer preserves
that vanishing by the exact-sequence lemma and I.1.6(6), including its proved
dual transport. A central layer would give a perfect central cover with
vanishing dual H¹, whose projection is injective by Remark I.1.5, a
contradiction. All sections are the literal quotients in `ChiefFactors.Basic`.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*, combined
manuscript (1 March 2004), 13.8.25, printed p.961 (PDF p.978), and
Remark I.1.5 and I.1.6(6), printed p.408. This proves the independent
cohomological step. The parent source assembly supplies the three module
hypotheses; no additional cohomology or splitting premise is required.
-/

public section

open Representation Representation.OneCohomology Representation.BinaryOffender
namespace CFSG.Quasithin.Chapter13.Section08.ComponentSieve.AlternatingAndLinear.FourStructure.ChiefFactors
open CentralExclusion
variable {H U : Type*} [Group H] [AddCommGroup U] [Module (ZMod 2) U]
  [FiniteDimensional (ZMod 2) U] (ρ : Representation (ZMod 2) H U)

lemma commutator_top_of_natural_heads (eH : H ≃* BinaryLinear.GL NaturalSpace)
    (hheads : AllNaturalHeads ρ eH) : Coinvariants.ker ρ = ⊤ := by
  let : Finite U := Module.finite_of_finite (ZMod 2)
  let : Finite (Subrepresentation ρ) := Finite.of_injective
    (fun W : Subrepresentation ρ => (W : Set U)) SetLike.coe_injective
  by_contra hgen
  have hC : commutatorSubrepresentation ρ ≠ ⊤ :=
    fun h => hgen (congrArg Subrepresentation.toSubmodule h)
  obtain ⟨W, hW, hCW⟩ :=
    (eq_top_or_exists_le_coatom (commutatorSubrepresentation ρ)).resolve_left hC
  apply natural_not_trivial W.quotientRepresentation eH (hheads W hW)
  intro g v
  induction v using Submodule.Quotient.induction_on with | _ v =>
  exact (Submodule.Quotient.eq _).mpr (hCW (Coinvariants.sub_mem_ker g v))

lemma quotient_dual_H1_vanish (eH : H ≃* BinaryLinear.GL NaturalSpace)
    (hheads : AllNaturalHeads ρ eH)
    (hfactors : NoncentralChiefFactorsNaturalOrDual ρ eH)
    (A : Subrepresentation ρ) :
    Module.finrank (ZMod 2) (H1 A.quotientRepresentation.dual) = 0 := by
  let : Finite (BinaryLinear.GL NaturalSpace) := finite_GL
  let : Finite H := Finite.of_injective eH eH.injective
  let : Finite U := Module.finite_of_finite (ZMod 2)
  let : Finite (Subrepresentation ρ) := Finite.of_injective
    (fun W : Subrepresentation ρ => (W : Set U)) SetLike.coe_injective
  have hgen := commutator_top_of_natural_heads ρ eH hheads
  induction A using (wellFounded_gt (α := Subrepresentation ρ)).induction with
  | h A ih =>
    by_cases hAtop : A = ⊤
    · subst A
      have : Subsingleton (U ⧸ (⊤ : Subrepresentation ρ).toSubmodule) :=
        inferInstanceAs (Subsingleton (U ⧸ (⊤ : Submodule (ZMod 2) U)))
      exact Module.finrank_zero_of_subsingleton
    obtain ⟨B, hAB, _⟩ := exists_covBy_le_of_lt (lt_top_iff_ne_top.mpr hAtop)
    have hB := ih B hAB.lt
    have hc : ¬ IsCentralSection ρ A B := by
      intro hc
      exact hAB.ne (central_section_eq ρ A B hgen hAB.le hc hB)
    exact quotient_dual_H1_step ρ A B hAB.le
      (naturalOrDual_dual_H1 _ eH (hfactors A B hAB hc)) hB

/-- The cohomological step of 13.8.25: compatible natural heads and the
noncentral classification eliminate all central chief factors. -/
theorem central_chief_exclusion (eH : H ≃* BinaryLinear.GL NaturalSpace)
    (hheads : AllNaturalHeads ρ eH) (W : Subrepresentation ρ) (hW : IsCoatom W)
    (hunique : ∀ X : Subrepresentation ρ, IsCoatom X → X = W)
    (hfactors : NoncentralChiefFactorsNaturalOrDual ρ eH) :
    ChiefFactorsNaturalOrDual ρ eH := by
  let : Finite (BinaryLinear.GL NaturalSpace) := finite_GL
  let : Finite H := Finite.of_injective eH eH.injective
  have hh : AllNaturalHeads ρ eH := by
    intro X hX
    rw [hunique X hX]
    exact hheads W hW
  have hgen := commutator_top_of_natural_heads ρ eH hh
  intro A B hAB
  have hc : ¬ IsCentralSection ρ A B := by
    intro hc
    exact hAB.ne (central_section_eq ρ A B hgen hAB.le hc
      (quotient_dual_H1_vanish ρ eH hh hfactors B))
  exact ⟨hfactors A B hAB hc, hc⟩

omit [FiniteDimensional (ZMod 2) U] in
/-- The identifications in the chief-factor conclusion give the source's
four-dimensional assertion for every literal chief quotient. -/
theorem ChiefFactorsNaturalOrDual.finrank_eq_four
    (eH : H ≃* BinaryLinear.GL NaturalSpace) (h : ChiefFactorsNaturalOrDual ρ eH)
    (A B : Subrepresentation ρ) (hAB : A ⋖ B) :
    Module.finrank (ZMod 2) (B.toSubmodule ⧸ (sectionLower ρ A B).toSubmodule) = 4 :=
  naturalOrDual_finrank _ eH (h A B hAB).1

end CFSG.Quasithin.Chapter13.Section08.ComponentSieve.AlternatingAndLinear.FourStructure.ChiefFactors
