/-!
# Local witnesses and transport for the small central covers

The witness uses the genuine family L(KT,T) and the literal quotient by
O₂,Z. In the covered-A₆ case K itself supplies this witness. Uniqueness of
the maximal two-local containing LT rules out any member of Hz containing L:
its nontrivial two-core supplies a two-local overgroup to which uniqueness
applies. Thus an identification K₁ = L gives the required contradiction.

A local witness containing L₁ and escaping M supplies a new member K₁T
of Hz. The universal earlier 13.8.16 then gives relative normality, and
component calculus identifies its actual star image with K₁/O₂(K₁).
The source conjugate span and its quotient are recomputed for the new group;
the quotient inclusion proved here does not identify the two modules.

Finally a normal nontrivial two-perfect subgroup of a two-perfect L₁ with
|L₁/O₂(L₁)| = 3 is all of L₁. Consequently a proper residual excludes the
ordinary-A₆ branch of the earlier local alternatives.

These are partial deductions for Aschbacher--Smith 13.8.21(2), combined
manuscript (1 March 2004), printed p.956, PDF p.973. The M̂₂₂ witness,
its solvable-overgroup comparison, the K₁ = L identification, the Dynkin
exclusion and the reduced parabolic identification remain to be proved.
No such conclusion is included in the hypotheses of a claimed source theorem.
-/

@[expose] public section

open Subgroup
namespace CFSG.Quasithin.Chapter13.Section08.ComponentSieve.FieldComponents.SmallCovers.Reduction.LocalGeometry
variable {G : Type*} [Group G]

/-- An actual member of L(KT,T), with its actual central two-core quotient.
This is witness data, not an assertion of existence in either cover branch. -/
structure LocalSix (K T : Subgroup G) where
  subgroup : Subgroup G
  local_mem : subgroup ∈ Chapter1.LIn (K ⊔ T) T
  centralQuotient :
    (subgroup ⧸ centralPreimage (pCore 2 subgroup)) ≃* alternatingGroup (Fin 6)

/-- The subgroup generated by all solvable overgroups of YT inside H.
This construction lets intrinsic geometry use universal 13.8.13 without
assuming the resulting K₁ dichotomy. -/
def solvableOvergroupSpan (H Y T : Subgroup G) : Subgroup G :=
  sSup {J : Subgroup G | Y ⊔ T ≤ J ∧ J ≤ H ∧ Group.IsSolvable J}

/-- Under Y = L₁, the universal earlier result places the entire solvable
overgroup span in the overlap. The finite-cover comparison is separate. -/
theorem solvableOvergroupSpan_le_overlap (H K L₁ T G₁ M : Subgroup G)
    (hHG : H ≤ G₁) (he : coverResidualIn K = L₁)
    (h13 : ∀ J : Subgroup G, L₁ ⊔ T ≤ J → J ≤ G₁ →
      Group.IsSolvable J → J ≤ M) :
    solvableOvergroupSpan H (coverResidualIn K) T ≤ H ⊓ M := by
  apply sSup_le
  rintro J ⟨hbase, hJH, hsol⟩
  rw [he] at hbase
  exact le_inf hJH (h13 J hbase (hJH.trans hHG) hsol)

/-- In the covered-A₆ branch the original component is the required K₁.
The central quotient is supplied as a genuine quotient isomorphism. -/
noncomputable def localSix_self (H K L₁ T G₁ M : Subgroup G)
    (hH : H ∈ Source.Hz L₁ T G₁ M)
    (hT : Chapter1.IsSylowIn 2 T H) (hKH : K ≤ H)
    (hK : (K.subgroupOf H).IsCComponent)
    (e : ((K ⧸ pCore 2 K) ⧸ center (K ⧸ pCore 2 K)) ≃*
      alternatingGroup (Fin 6)) : LocalSix K T where
  subgroup := K
  local_mem := ⟨le_sup_left, Chapter1.mem_L_of_cComponent hH.1.1 hT hKH hK⟩
  centralQuotient := (centralPreimageQuotientEquiv (pCore 2 K)).trans e

variable [Finite G]

/-- A subgroup with nontrivial two-core is contained in a maximal two-local.
The two-local is the normalizer of its actual two-core. -/
theorem exists_maximalTwoLocal_overgroup (H : Subgroup G)
    (hH : H.pCoreIn 2 ≠ ⊥) :
    ∃ N : Subgroup G, IsMaximalTwoLocal N ∧ H ≤ N := by
  have hn : H ≤ normalizer (H.pCoreIn 2 : Set G) :=
    H.le_normalizer.trans (normalizer_le_normalizer_characteristic_image H (pCore 2 H))
  have hl : IsTwoLocal (normalizer (H.pCoreIn 2 : Set G)) :=
    ⟨H.pCoreIn 2, hH, isPGroup_pCoreIn 2 H, rfl⟩
  obtain ⟨N, hle, hmax⟩ := Finite.exists_le_maximal hl
  exact ⟨N, hmax, hn.trans hle⟩

/-- The meaning of M = !M(LT) applies to all overgroups with nontrivial
 two-core, by extending their normalizers to maximal two-locals. -/
theorem le_M_of_unique_maximalTwoLocal (H L T M : Subgroup G)
    (hH : H.pCoreIn 2 ≠ ⊥) (hLT : L ⊔ T ≤ H)
    (hunique : ∀ N : Subgroup G, IsMaximalTwoLocal N → L ⊔ T ≤ N → N = M) :
    H ≤ M := by
  obtain ⟨N, hN, hHN⟩ := exists_maximalTwoLocal_overgroup H hH
  exact hunique N hN (hLT.trans hHN) ▸ hHN

/-- The uniqueness contradiction after the geometric identification K₁ = L. -/
theorem localSix_ne_L (H K L L₁ T G₁ M : Subgroup G)
    (hH : H ∈ Source.Hz L₁ T G₁ M) (hKH : K ≤ H)
    (s : LocalSix K T)
    (hunique : ∀ N : Subgroup G, IsMaximalTwoLocal N → L ⊔ T ≤ N → N = M) :
    s.subgroup ≠ L := by
  intro he
  have hKH' : K ⊔ T ≤ H := sup_le hKH (le_sup_right.trans hH.1.2)
  have hLH : L ≤ H := he ▸ s.local_mem.1.trans hKH'
  exact hH.2.2 (le_M_of_unique_maximalTwoLocal H L T M hH.1.1
    (sup_le hLH (le_sup_right.trans hH.1.2)) hunique)

omit [Finite G] in
/-- The local-family condition itself supplies the nontrivial two-core of
the replacement. No two-core containment in the old H is assumed. -/
theorem replacement_mem_Hz (H K L₁ T G₁ M : Subgroup G)
    (hH : H ∈ Source.Hz L₁ T G₁ M) (hKH : K ≤ H)
    (s : LocalSix K T) (hL₁ : L₁ ≤ s.subgroup) (hout : ¬ s.subgroup ≤ M) :
    s.subgroup ⊔ T ∈ Source.Hz L₁ T G₁ M := by
  have hTH : T ≤ H := le_sup_right.trans hH.1.2
  refine ⟨⟨s.local_mem.2.2.2, sup_le_sup_right hL₁ T⟩, ?_, ?_⟩
  · exact (sup_le (s.local_mem.1.trans (sup_le hKH hTH)) hTH).trans hH.2.1
  · exact fun h => hout (le_sup_left.trans h)

omit [Finite G] in
/-- Universal 13.8.16 is reapplied to the new member of Hz and its own
C-component. This is relative normality in K₁T. -/
theorem replacement_normal (H K L₁ T G₁ M : Subgroup G)
    (hH : H ∈ Source.Hz L₁ T G₁ M) (hKH : K ≤ H)
    (s : LocalSix K T) (hL₁ : L₁ ≤ s.subgroup) (hout : ¬ s.subgroup ≤ M)
    (h16 : ∀ J ∈ Source.Hz L₁ T G₁ M, ∀ B : Subgroup G,
      B ≤ J → (B.subgroupOf J).IsCComponent → (B.subgroupOf J).Normal) :
    (s.subgroup.subgroupOf (s.subgroup ⊔ T)).Normal :=
  h16 _ (replacement_mem_Hz H K L₁ T G₁ M hH hKH s hL₁ hout)
    _ le_sup_left s.local_mem.2.1

/-- The quotient after replacement is the intrinsic two-core quotient of
K₁, with its source the actual star image inside the new overgroup. -/
noncomputable def replacementStarEquiv (K T : Subgroup G) (s : LocalSix K T) :
    (s.subgroup ⧸ pCore 2 s.subgroup) ≃* Source.starImage (s.subgroup ⊔ T) s.subgroup :=
  Components.componentStarEquiv _ _ le_sup_left s.local_mem.2.1

theorem replacementStarEquiv_mk (K T : Subgroup G) (s : LocalSix K T) (k : s.subgroup) :
    (replacementStarEquiv K T s (QuotientGroup.mk' (pCore 2 s.subgroup) k) :
        Source.Hstar (s.subgroup ⊔ T)) =
      QuotientGroup.mk' (pCore 2 (s.subgroup ⊔ T : Subgroup G))
        ⟨k.val, (show s.subgroup ≤ s.subgroup ⊔ T from le_sup_left) k.property⟩ := rfl

private theorem normal_twoPerfect_eq_top_of_prime_quotient
    {A : Type*} [Group A] [Finite A] (B : Subgroup A) [B.Normal]
    (hA : IsPPerfect 2 A) (hB : IsPPerfect 2 B) (hne : B ≠ ⊥)
    (hcard : Nat.card (A ⧸ pCore 2 A) = 3) : B = ⊤ := by
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  let : Fact (Nat.card (A ⧸ pCore 2 A)).Prime := ⟨hcard ▸ Nat.prime_three⟩
  let q := QuotientGroup.mk' (pCore 2 A)
  have hm : B.map q = ⊤ := by
    rcases (B.map q).eq_bot_or_eq_top_of_prime_card with hb | ht
    · have hle : B ≤ pCore 2 A := by
        simpa only [q, QuotientGroup.ker_mk'] using ((B.map_eq_bot_iff).mp hb)
      have hf := hB.hom_eq_one_of_isPGroup (pCore_isPGroup (p := 2) (G := A))
        (inclusion hle)
      apply (hne ?_).elim
      apply eq_bot_iff.mpr
      intro b hb
      exact congrArg (fun f : B →* pCore 2 A => (f ⟨b, hb⟩ : A)) hf
    · exact ht
  have hgen : B ⊔ pCore 2 A = ⊤ := by
    have he := congrArg (comap q) hm
    simpa only [comap_map_eq, q, QuotientGroup.ker_mk', comap_top] using he
  have hle := le_normal_of_isPPerfect_of_le_sup_pGroup
    (⊤ : Subgroup A) B (pCore 2 A)
    (hA.of_surjective (topEquiv (G := A)).symm.toMonoidHom
      (topEquiv (G := A)).symm.surjective)
    pCore_isPGroup hgen.ge
  exact top_unique hle

/-- In the ordinary local case the residual cannot be a proper nontrivial
subgroup of L₁. Normality is obtained from K normal in H. -/
theorem coverResidualIn_eq_of_prime_L1 (H K L₁ : Subgroup G)
    (hKH : K ≤ H) [(K.subgroupOf H).Normal] (hL₁H : L₁ ≤ H)
    (hYL : coverResidualIn K ≤ L₁) (hcenter : Nat.card (center (K ⧸ pCore 2 K)) = 3)
    (hL₁ : IsPPerfect 2 L₁) (hcard : Nat.card (L₁ ⧸ pCore 2 L₁) = 3) :
    coverResidualIn K = L₁ := by
  let Y := coverResidualIn K
  let B := Y.subgroupOf L₁
  let : B.Normal := normal_subgroupOf_of_le_normalizer
    (hL₁H.trans (normalizes_coverResidualIn H K hKH))
  have hp : IsPPerfect 2 B := (coverResidualIn_isPPerfect K).of_surjective
    (subgroupOfEquivOfLe hYL).symm.toMonoidHom (subgroupOfEquivOfLe hYL).symm.surjective
  have hn : B ≠ ⊥ := by
    intro hb
    have he := congrArg (map L₁.subtype) hb
    change (Y.subgroupOf L₁).map L₁.subtype = (⊥ : Subgroup L₁).map L₁.subtype at he
    rw [map_subgroupOf_eq_of_le hYL, Subgroup.map_bot] at he
    exact coverResidualIn_ne_bot K hcenter he
  have he := normal_twoPerfect_eq_top_of_prime_quotient B hL₁ hp hn hcard
  have hm := congrArg (map L₁.subtype) he
  change (Y.subgroupOf L₁).map L₁.subtype = (⊤ : Subgroup L₁).map L₁.subtype at hm
  rw [map_subgroupOf_eq_of_le hYL, ← MonoidHom.range_eq_map, range_subtype] at hm
  exact hm

/-- The earlier two local alternatives now select the genuine triple cover
of A₆. The ordinary branch uses its actual cubic L₁/two-core quotient. -/
theorem covered_local_alternative (H K L L₁ : Subgroup G)
    (hKH : K ≤ H) [(K.subgroupOf H).Normal] (hL₁H : L₁ ≤ H)
    (hYL : coverResidualIn K < L₁) (hcenter : Nat.card (center (K ⧸ pCore 2 K)) = 3)
    (hL₁ : IsPPerfect 2 L₁)
    (halternatives : Nonempty ((L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 6)) ∨
      SolvableExclusion.IsTripleCoverSix (L ⧸ pCore 2 L))
    (hordinary : Nonempty ((L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 6)) →
      Nat.card (L₁ ⧸ pCore 2 L₁) = 3) :
    SolvableExclusion.IsTripleCoverSix (L ⧸ pCore 2 L) := by
  rcases halternatives with ha | hc
  · exact (hYL.ne (coverResidualIn_eq_of_prime_L1 H K L₁ hKH hL₁H hYL.le
      hcenter hL₁ (hordinary ha))).elim
  · exact hc

end CFSG.Quasithin.Chapter13.Section08.ComponentSieve.FieldComponents.SmallCovers.Reduction.LocalGeometry
