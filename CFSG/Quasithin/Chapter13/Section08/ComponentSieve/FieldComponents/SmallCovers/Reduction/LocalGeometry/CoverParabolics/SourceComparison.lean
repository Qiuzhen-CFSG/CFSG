module

public import CFSG.Quasithin.Chapter13.Section08.ComponentSieve.FieldComponents.SmallCovers.Reduction.LocalGeometry.CoverParabolics.NativeWitness
public import CFSG.Quasithin.Chapter13.Section08.ComponentSieve.FieldComponents.SmallCovers.Reduction.LocalGeometry.CoverParabolics.SixDiagramSpan

/-!
# Solvable-overgroup comparison in the actual cover overlap

The conjugation action of H = KT on K/O₂,Z(K) has solvable kernel.
Its kernel joined with T is a solvable overgroup of the literal cover
residual Y and T, so every proper overlap containing that span contains
the action kernel and has proper action image. Solvable overgroups in
the model lift to solvable overgroups of YT in H.

For M̂₂₂ the native hexad comparison therefore identifies that image,
normalizes the hexad pullback, and places its canonical C-component in
the overlap. For Â₆ the natural actor groups are generated by their
solvable Sylow overgroups, so T contains an actual non-natural actor.
The native normalizer coordinates identify this failure with moving the
two source parabolic types. The last theorem applies both deductions to
H ∩ M, using the genuine central quotient and cubic center.

Source: Aschbacher–Smith 13.8.21(2), printed p.956 (PDF p.973), the
Y = L₁ branch. The parent supplies the span containment via universal
13.8.13, identifies the overlap component with L, and excludes the
actual diagram action by the separate representation argument. The
marked replacement geometry under Y < L₁ is a separate branch.
-/

public section
open Subgroup
open Theory.GroupAction.PCoreCentralModelAction
namespace CFSG.Quasithin.Chapter13.Section08.ComponentSieve.FieldComponents.SmallCovers.Reduction.LocalGeometry.CoverParabolics
variable {G D : Type*} [Group G] [Group D] [Finite G]

/-- The solvable action kernel joined with T is one of the generating overgroups. -/
theorem action_kernel_le_span (H Y T : Subgroup G) (f : H →* D)
    [Group.IsSolvable f.ker] (hYH : Y ≤ H) (hTH : T ≤ H)
    (hY : Y.subgroupOf H ≤ f.ker) (hT : IsPGroup 2 T) :
    f.ker ≤ (solvableOvergroupSpan H Y T).subgroupOf H := by
  let : Group.IsNilpotent (T.subgroupOf H) := hT.comap_subtype.isNilpotent
  let : Group.IsSolvable (f.ker ⊔ T.subgroupOf H : Subgroup H) :=
    Group.isSolvable_sup_of_normal_left _ _
  have hs : (f.ker ⊔ T.subgroupOf H).map H.subtype ≤
      solvableOvergroupSpan H Y T := by
    apply le_sSup
    refine ⟨sup_le ?_ ?_, map_subtype_le _,
      Group.isSolvable_of_surjective (H.subtype.subgroupMap_surjective _)⟩
    · intro y hy
      exact ⟨⟨y, hYH hy⟩,
        (show f.ker ≤ f.ker ⊔ T.subgroupOf H from le_sup_left) (hY hy), rfl⟩
    · intro t ht
      exact ⟨⟨t, hTH ht⟩,
        (show T.subgroupOf H ≤ f.ker ⊔ T.subgroupOf H from le_sup_right) ht, rfl⟩
  intro x hx
  exact hs (mem_map.mpr ⟨x, (show f.ker ≤ f.ker ⊔ T.subgroupOf H from le_sup_left) hx, rfl⟩)

omit [Finite G] in
/-- Solvable model overgroups lift through the solvable source kernel. -/
theorem model_span_le_source_image (H Y T : Subgroup G) (f : H →* D)
    [Group.IsSolvable f.ker] (hYH : Y ≤ H) (hTH : T ≤ H)
    (hY : Y.subgroupOf H ≤ f.ker) :
    solvableOvergroupSpan f.range ⊥ ((T.subgroupOf H).map f) ≤
      ((solvableOvergroupSpan H Y T).subgroupOf H).map f := by
  apply sSup_le
  rintro V ⟨hTV, hVr, hVs⟩
  let := hVs
  let := isSolvable_comap_of_solvable_ker f V
  have hW : (V.comap f).map H.subtype ≤ solvableOvergroupSpan H Y T := by
    apply le_sSup
    refine ⟨sup_le ?_ ?_, map_subtype_le _,
      Group.isSolvable_of_surjective (H.subtype.subgroupMap_surjective _)⟩
    · intro y hy
      refine ⟨⟨y, hYH hy⟩, ?_, rfl⟩
      change f ⟨y, hYH hy⟩ ∈ V
      rw [show f ⟨y, hYH hy⟩ = 1 from hY hy]
      exact V.one_mem
    · intro t ht
      exact ⟨⟨t, hTH ht⟩, hTV (by
        rw [bot_sup_eq]
        exact mem_map.mpr ⟨⟨t, hTH ht⟩, ht, rfl⟩), rfl⟩
  intro v hv
  obtain ⟨x, rfl⟩ := hVr hv
  exact ⟨x, hW (mem_map.mpr ⟨x, hv, rfl⟩), rfl⟩

omit [Finite G] in
/-- Retaining the kernel makes a proper source overlap have proper action image. -/
theorem proper_action_image (H J : Subgroup G) (f : H →* D)
    (hJ : J < H) (hk : f.ker ≤ J.subgroupOf H) :
    (J.subgroupOf H).map f < f.range := by
  refine lt_of_le_of_ne (map_le_range _ _) ?_
  intro he
  have h := congrArg (comap f) he
  rw [comap_map_eq_self hk] at h
  have hr : f.range.comap f = ⊤ := by ext x; simp
  rw [hr] at h
  exact hJ.not_ge (subgroupOf_eq_top.mp h)

/-- The actual image of the source Sylow subgroup is Sylow in the action range. -/
theorem exists_sylow_action_image (H T : Subgroup G) (hT : Chapter1.IsSylowIn 2 T H)
    (f : H →* D) :
    ∃ P : Sylow 2 f.range,
      (P : Subgroup f.range).map f.range.subtype = (T.subgroupOf H).map f := by
  obtain ⟨Q, hQ⟩ := hT
  refine ⟨Q.mapSurjective f.rangeRestrict_surjective, ?_⟩
  have he : T.subgroupOf H = (Q : Subgroup H) := by
    rw [← hQ]
    exact comap_map_eq_self (by simp [H.subtype.ker_eq_bot H.subtype_injective])
  rw [he]
  change ((Q : Subgroup H).map f.rangeRestrict).map f.range.subtype = _
  rw [map_map]
  rfl

omit [Finite G] in
/-- The literal cover residual acts trivially on the central quotient. -/
theorem coverResidual_le_action_kernel (H K : Subgroup G)
    (hn : H ≤ normalizer (K : Set G)) (hKH : K ≤ H)
    (e : (K ⧸ centralPreimage (pCore 2 K)) ≃* D) :
    (coverResidualIn K).subgroupOf H ≤ (centralModelAction H K hn e).ker := by
  intro y hy
  obtain ⟨k, hk, he⟩ := hy
  have hc : k ∈ centralPreimage (pCore 2 K) := coverResidual_le_centralPreimage hk
  have hey : inclusion hKH k = y := Subtype.ext he
  rw [← hey]
  exact centralModelAction_centralPreimage H K hn hKH e ⟨k, hc⟩

/-- A proper overlap containing the source span forces an actual non-natural actor in T. -/
theorem six_source_diagram_actor (H K T J : Subgroup G)
    (hKH : K ≤ H) [(K.subgroupOf H).Normal]
    (hgen : H = K ⊔ T) (hT : Chapter1.IsSylowIn 2 T H)
    (e : (K ⧸ centralPreimage (pCore 2 K)) ≃* alternatingGroup (Fin 6))
    (hJ : J < H)
    (hspan : solvableOvergroupSpan H (coverResidualIn K) T ≤ J) :
    ∃ t : T, centralModelAction H K (le_normalizer_of_normal_subgroupOf hKH) e
      ⟨t.val, (hgen ▸ (show T ≤ K ⊔ T from le_sup_right)) t.property⟩ ∉
        AlternatingSix.ShadowLocal.natural := by
  let hn := le_normalizer_of_normal_subgroupOf hKH
  let a := centralModelAction H K hn e
  have ht := Chapter1.isSylowIn_iff.mp hT
  let := centralModelAction_ker_solvable H K T hKH hgen ht.1 e
    (alternatingGroup.center_eq_bot (by simp))
  have hy := coverResidual_le_action_kernel H K hn hKH e
  have hYH := (coverResidualIn_le K).trans hKH
  have hk := (action_kernel_le_span H (coverResidualIn K) T a hYH ht.2.1 hy ht.1).trans
    (comap_mono (f := H.subtype) hspan)
  have hproper := proper_action_image H J a hJ hk
  obtain ⟨P, hP⟩ := exists_sylow_action_image H T hT a
  have hs := (model_span_le_source_image H (coverResidualIn K) T a hYH ht.2.1 hy).trans
    (map_mono (f := a) (comap_mono (f := H.subtype) hspan))
  rw [← hP] at hs
  have hnon := six_nonNatural_of_span_le_proper a.range ((J.subgroupOf H).map a)
    (centralModelAction_inner_le_range H K hn hKH e) P hproper hs
  by_contra hall
  push Not at hall
  have hK : K ≤ (AlternatingSix.ShadowLocal.natural.comap a).map H.subtype := by
    intro k hk
    refine ⟨⟨k, hKH hk⟩, ?_, rfl⟩
    change a (inclusion hKH ⟨k, hk⟩) ∈ AlternatingSix.ShadowLocal.natural
    rw [centralModelAction_inner]
    exact AlternatingSix.ShadowLocal.inner_le_natural ⟨_, rfl⟩
  have hTs : T ≤ (AlternatingSix.ShadowLocal.natural.comap a).map H.subtype := by
    intro t ht
    exact ⟨⟨t, (hgen ▸ (show T ≤ K ⊔ T from le_sup_right)) ht⟩, hall ⟨t, ht⟩, rfl⟩
  have hwhole : H ≤ (AlternatingSix.ShadowLocal.natural.comap a).map H.subtype :=
    hgen.trans_le (sup_le hK hTs)
  apply hnon
  rintro _ ⟨x, rfl⟩
  obtain ⟨y, hy, he⟩ := hwhole x.property
  have he' : y = x := Subtype.ext he
  exact he' ▸ hy

open Sporadic.Mathieu Theory.GroupTheory
open scoped Pointwise

/-- A normalized hexad pullback carries its canonical C-component into the overlap. -/
theorem hexadResidualIn_mem_cComponentsIn (K J : Subgroup G)
    (e : (K ⧸ centralPreimage (pCore 2 K)) ≃* M22)
    {B : Finset (Fin 22)} (hB : B ∈ m22Blocks)
    (hle : hexadLift K e B ≤ J)
    (hn : J ≤ normalizer (hexadLift K e B : Set G)) :
    hexadResidualIn K e B ∈ Chapter1.cComponentsIn J := by
  let E := hexadLift K e B
  let E' := E.subgroupOf J
  let : E'.Normal := normal_subgroupOf_of_le_normalizer hn
  have hc := (hexadResidual_isCComponent K e hB).map_equiv
    ((hexadPreimage K e B).equivMapOfInjective K.subtype K.subtype_injective)
  rw [map_solvableResidual_eq _
    ((hexadPreimage K e B).equivMapOfInjective K.subtype K.subtype_injective).surjective] at hc
  let d := subgroupOfEquivOfLe hle
  have hc' := (hc.map_equiv d.symm).map_subtype (inferInstance : E'.Normal).isSubnormal
  have hm : ((solvableResidual E).map d.symm.toMonoidHom).map E'.subtype =
      ((solvableResidual E).map E.subtype).subgroupOf J := by
    rw [map_map]
    ext x
    constructor
    · rintro ⟨y, hy, rfl⟩
      exact mem_map.mpr ⟨y, hy, rfl⟩
    · intro hx
      obtain ⟨y, hy, he⟩ := mem_map.mp hx
      exact ⟨y, hy, Subtype.ext he⟩
  change (((solvableResidual E).map d.symm.toMonoidHom).map E'.subtype).IsCComponent at hc'
  rw [hm] at hc'
  exact ⟨(map_subtype_le _).trans hle, hc'⟩

/-- In the Mathieu branch the selected local triple cover is a C-component of the overlap. -/
theorem mathieu_source_component_comparison (H K T J : Subgroup G)
    (hH : H.pCoreIn 2 ≠ ⊥) (hKH : K ≤ H) [(K.subgroupOf H).Normal]
    (hgen : H = K ⊔ T) (hT : Chapter1.IsSylowIn 2 T H)
    (e : (K ⧸ centralPreimage (pCore 2 K)) ≃* M22)
    [IsQuasisimple (K ⧸ pCore 2 K)]
    (hc : Nat.card (center (K ⧸ pCore 2 K)) = 3)
    (hJ : J < H) (hTJ : T ≤ J)
    (hspan : solvableOvergroupSpan H (coverResidualIn K) T ≤ J) :
    ∃ s : LocalSix K T, s.subgroup < K ∧
      SolvableExclusion.IsTripleCoverSix (s.subgroup ⧸ pCore 2 s.subgroup) ∧
      s.subgroup ∈ Chapter1.cComponentsIn J := by
  let hn := le_normalizer_of_normal_subgroupOf hKH
  let a := centralModelAction H K hn e
  have ht := Chapter1.isSylowIn_iff.mp hT
  let := centralModelAction_ker_solvable H K T hKH hgen ht.1 e m22_center_eq_bot
  have hy := coverResidual_le_action_kernel H K hn hKH e
  have hYH := (coverResidualIn_le K).trans hKH
  have hk := (action_kernel_le_span H (coverResidualIn K) T a hYH ht.2.1 hy ht.1).trans
    (comap_mono (f := H.subtype) hspan)
  have hproper := proper_action_image H J a hJ hk
  obtain ⟨P, hP⟩ := exists_sylow_action_image H T hT a
  have hs := (model_span_le_source_image H (coverResidualIn K) T a hYH ht.2.1 hy).trans
    (map_mono (f := a) (comap_mono (f := H.subtype) hspan))
  rw [← hP] at hs
  have hPS : (P : Subgroup a.range).map a.range.subtype ≤ (J.subgroupOf H).map a := by
    rw [hP]
    exact map_mono (comap_mono hTJ)
  obtain ⟨B, hnS, hES, _hmax, hidentify⟩ :=
    MathieuSolvableSpan.exists_hexad_identifying_proper_overgroups a.range
      (centralModelAction_inner_le_range H K hn hKH e) P
  have himage := hidentify ((J.subgroupOf H).map a) hproper.le hproper.ne hPS hs
  have hnJ : (J.subgroupOf H).map a ≤
      normalizer (MathieuSolvableSpan.innerHexad B : Set (MulAut M22)) := by
    rw [himage]
    exact sup_le (MathieuSolvableSpan.innerHexad B).le_normalizer hnS
  have hnLift : J ≤ normalizer (hexadLift K e B.val : Set G) := by
    intro j hj
    exact centralModelAction_normalizes_lift H K hn e m22_center_eq_bot
      (MulAction.stabilizer M22 B.val) ⟨j, hJ.le hj⟩
      (hnJ (mem_map.mpr ⟨⟨j, hJ.le hj⟩, hj, rfl⟩))
  have hEJ : hexadLift K e B.val ≤ J := by
    rintro x ⟨k, hkE, rfl⟩
    have hi : a (inclusion hKH k) ∈ (J.subgroupOf H).map a := by
      apply (hES.trans hs)
      change a (inclusion hKH k) ∈ MathieuSolvableSpan.innerHexad B
      rw [centralModelAction_inner]
      exact ⟨mathieuProjection K e k, hkE, rfl⟩
    have hh : inclusion hKH k ∈ ((J.subgroupOf H).map a).comap a := hi
    rw [comap_map_eq_self (show a.ker ≤ J.subgroupOf H from hk)] at hh
    exact hh
  have hnT := hTJ.trans hnLift
  refine ⟨localSix_hexad H K T hH hKH hT e hc B.property hnT,
    hexadResidualIn_lt K e B.property,
    hexadResidualIn_isTripleCoverSix K e hc B.property, ?_⟩
  exact hexadResidualIn_mem_cComponentsIn K J e B.property hEJ hnLift

open Theory.SpecificGroups.SymmetricSix in
/-- The non-natural source actor fails to preserve the two genuine parabolic types. -/
theorem six_source_moved_parabolic (H K T J : Subgroup G)
    (hKH : K ≤ H) [(K.subgroupOf H).Normal]
    (hgen : H = K ⊔ T) (hT : Chapter1.IsSylowIn 2 T H)
    (e : (K ⧸ centralPreimage (pCore 2 K)) ≃* alternatingGroup (Fin 6))
    (hJ : J < H)
    (hspan : solvableOvergroupSpan H (coverResidualIn K) T ≤ J) :
    ∃ t : T,
      let β : MulAut (alternatingGroup (Fin 6)) :=
        centralModelAction H K (le_normalizer_of_normal_subgroupOf hKH) e
          ⟨t.val, (hgen ▸ (show T ≤ K ⊔ T from le_sup_right)) t.property⟩
      β ∉ AlternatingSix.ShadowLocal.natural ∧ ¬ (
        (∃ g : alternatingGroup (Fin 6), a6DuadStabilizer.map β.toMonoidHom =
          a6DuadStabilizer.map (MulAut.conj g).toMonoidHom) ∧
        (∃ g : alternatingGroup (Fin 6), a6SynthemeStabilizer.map β.toMonoidHom =
          a6SynthemeStabilizer.map (MulAut.conj g).toMonoidHom)) := by
  obtain ⟨t, ht⟩ := six_source_diagram_actor H K T J hKH hgen hT e hJ hspan
  exact ⟨t, ht, fun h => ht
    ((AlternatingSix.ShadowLocal.FourNormalizers.SixParabolics.natural_iff_preserves_source_parabolic_types _).mpr h)⟩

/-- The finite-cover comparison in the actual source overlap. The span containment
is the parent's application of universal 13.8.13 when Y = L₁. -/
theorem cover_solvable_overlap_comparison (H K L₁ T G₁ M : Subgroup G)
    (hH : H ∈ Source.Hz L₁ T G₁ M) (hKH : K ≤ H)
    (hK : (K.subgroupOf H).IsCComponent) [(K.subgroupOf H).Normal]
    (hgen : H = K ⊔ T) (hT : Chapter1.IsSylowIn 2 T H) (hTM : T ≤ M)
    [IsQuasisimple (K ⧸ pCore 2 K)]
    (hc : Nat.card (center (K ⧸ pCore 2 K)) = 3)
    (hmodels : Nonempty ((K ⧸ centralPreimage (pCore 2 K)) ≃* alternatingGroup (Fin 6)) ∨
      Nonempty ((K ⧸ centralPreimage (pCore 2 K)) ≃* M22))
    (hspan : solvableOvergroupSpan H (coverResidualIn K) T ≤ H ⊓ M) :
    ∃ s : LocalSix K T, s.subgroup ≤ K ∧
      SolvableExclusion.IsTripleCoverSix (s.subgroup ⧸ pCore 2 s.subgroup) ∧
      (s.subgroup ∈ Chapter1.cComponentsIn (H ⊓ M) ∨
        s.subgroup = K ∧
          ∃ e : (K ⧸ centralPreimage (pCore 2 K)) ≃* alternatingGroup (Fin 6),
          ∃ t : T, centralModelAction H K (le_normalizer_of_normal_subgroupOf hKH) e
            ⟨t.val, (hgen ▸ (show T ≤ K ⊔ T from le_sup_right)) t.property⟩ ∉
              AlternatingSix.ShadowLocal.natural) := by
  have hJ : H ⊓ M < H := lt_of_le_of_ne inf_le_left (by
    intro he
    exact hH.2.2 (he.ge.trans inf_le_right))
  rcases hmodels with he | he
  · obtain ⟨e⟩ := he
    let d := (centralPreimageQuotientEquiv (pCore 2 K)).symm.trans e
    let s := localSix_self H K L₁ T G₁ M hH hT hKH hK d
    obtain ⟨t, ht⟩ := six_source_diagram_actor H K T (H ⊓ M) hKH hgen hT e hJ hspan
    refine ⟨s, le_rfl, ?_, Or.inr ⟨rfl, e, t, ht⟩⟩
    change SolvableExclusion.IsTripleCoverSix (K ⧸ pCore 2 K)
    exact ⟨inferInstance, hc, ⟨d⟩⟩
  · obtain ⟨e⟩ := he
    obtain ⟨s, hs, hc', hj⟩ := mathieu_source_component_comparison H K T (H ⊓ M)
      hH.1.1 hKH hgen hT e hc hJ
      (le_inf (Chapter1.isSylowIn_iff.mp hT).2.1 hTM) hspan
    exact ⟨s, hs.le, hc', Or.inl hj⟩

end CFSG.Quasithin.Chapter13.Section08.ComponentSieve.FieldComponents.SmallCovers.Reduction.LocalGeometry.CoverParabolics
