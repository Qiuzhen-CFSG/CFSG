module
public import CFSG.Quasithin.ChapterK.Section01To04.Linear.Recognition.SourceQuadratic
public import CFSG.Quasithin.Chapter13.Section08.ComponentSieve.FieldComponents.ExceptionalFields.LinearThreeFour.AutomorphismModule.NaturalSections.Recognition
public import CFSG.Quasithin.Chapter13.Section08.ComponentSieve.FieldComponents.ExceptionalFields.LinearThreeFour.AutomorphismModule.NaturalSections.NoFF.Recognition
public import CFSG.Quasithin.ChapterK.Section01To04.Linear.Recognition.PSL3FourExclusion

/-!
# Native recognition for invariant SL₃(4) constituents

The proved degree-three source theorem recognizes a faithful component-
irreducible action of quadratic ratio at most two as natural. Its natural
coordinates and exact ratio discharge both former linear classification inputs.
The proved PSL₃(4) bound discharges the projective-image alternative, retaining
the distinction between the full special-linear cover and its central quotient.
Thus invariant_natural_section constructs the actual marked natural central
section without any universal earlier-classification parameter.

The original-source application in SpecialLinearFourModule transports the
original graph relation to this new marking and excludes the invariant case.
NativeSelection uses this implication on the subgroup generated by the
component and a quadratic actor, constructing a homogeneous natural constituent
which may be moved by H. None is assumed here.
Source: Aschbacher–Smith, B.4.5, K.3.2.4 and 13.8.20, printed pp.87,455–456,955.
-/

public noncomputable section
open Subgroup Representation Representation.BinaryOffender Representation.SL3FourNaturalDual Theory.GroupTheory
open CFSG.Quasithin
namespace CFSG.Quasithin.Chapter13.Section08.ComponentSieve.FieldComponents.ExceptionalFields.LinearThreeFour.AutomorphismModule.NaturalRecognition.Native
universe u
private def four : ChapterB.QuasisimpleSource.BinaryField where
  Carrier := F
  degree := 2
  degree_pos := by decide
  card_eq := by rw [Nat.card_eq_fintype_card,SL2FourNatural.card_field]; decide
private theorem quotient_center_equiv {K : Type*} [Group K] (e : K ≃* SL) :
    Nonempty (K ⧸ center K ≃* Matrix.ProjectiveSpecialLinearGroup (Fin 3) F) := by
  refine ⟨QuotientGroup.congr _ _ e ?_⟩
  apply le_antisymm
  · rintro _ ⟨x,hx,rfl⟩
    exact (centerCongr e ⟨x,hx⟩).property
  · intro x hx
    exact ⟨e.symm x,((centerCongr e).symm ⟨x,hx⟩).property,e.apply_symm_apply x⟩

private theorem recognized {X U : Type u} [Group X] [Finite X]
    [AddCommGroup U] [Module (ZMod 2) U] [FiniteDimensional (ZMod 2) U]
    {κ : GroupClass.{u}} (ρ : Representation (ZMod 2) X U) (L : Subgroup X)
    (hsq : IsSQTK κ X) (hfit : generalizedFitting X = L) (hqs : IsQuasisimple L)
    (hf : Function.Injective ρ) (hi : IsIrreducible (ρ.comp L.subtype))
    (e : L ≃* SL) (hq : quadraticRatio ρ ≤ 2) :
    Nonempty (ChapterK.Linear.Natural.SourceInput ρ L four 3 κ) := by
  let h : ChapterK.Linear.Recognition.SourceHypothesis κ ρ L :=
    ⟨inferInstance,inferInstance,hsq,hfit,hqs,hf,hi,(cubicRatio_le_quadraticRatio ρ).trans hq⟩
  let C : ChapterK.Linear.Recognition.LinearCover four 3 L :=
    { projection := e.symm.toMonoidHom
      surjective := e.symm.surjective
      central_kernel := ((MonoidHom.ker_eq_bot_iff e.symm.toMonoidHom).mpr e.symm.injective).le.trans bot_le }
  obtain ⟨q⟩ := quotient_center_equiv e
  exact ChapterK.Linear.Recognition.SourceQuadratic.naturalSourceInput_of_quadratic_le_two h C q hq

/-- Native degree-three recognition supplies the FF-or-large-ratio implication. -/
theorem smallRatio {κ : GroupClass.{u}} : LinearSmallRatioInput κ := by
  intro X U _ _ _ _ _ ρ L hsq hfit hqs hf hi hm
  by_cases hq : quadraticRatio ρ ≤ 2
  · obtain ⟨e⟩ := hm
    obtain ⟨h⟩ := recognized ρ L hsq hfit hqs hf hi e hq
    left
    apply isFFModule_of_quadraticRatio_le_one
    rw [(ChapterK.Linear.Natural.source_natural ρ L four 3 h).1]
    norm_num
  · exact Or.inr (lt_of_not_ge hq)

/-- Native recognition supplies actual natural coordinates, with their component marking. -/
theorem naturalFF {κ : GroupClass.{u}} : LinearFFInput κ := by
  intro X U _ _ _ _ _ ρ L hsq hfit hqs hf hi hm hff
  obtain ⟨e⟩ := hm
  obtain ⟨h⟩ := recognized ρ L hsq hfit hqs hf hi e
    (((isFFModule_iff_quadraticRatio_le_one ρ).mp hff).trans (by norm_num))
  let B : Chapter15.Section04.LocalSetup.TwoFactors.FFBranch.ClassificationComparison.FFAlternatives.BinaryField :=
    { Carrier := F, degree := 2, degree_pos := by decide,
      card_eq := by rw [Nat.card_eq_fintype_card,SL2FourNatural.card_field]; decide }
  have hB : Nat.card B.Carrier = 4 := by
    rw [Nat.card_eq_fintype_card]; exact SL2FourNatural.card_field
  let a := NoFF.Recognition.fourNaturalEquiv B hB
  refine ⟨h.natural.groupEquiv.trans a.groupEquiv,h.natural.linearEquiv.trans a.linearEquiv,?_⟩
  intro l v
  change a.linearEquiv (h.natural.linearEquiv (ρ l v)) = _
  exact (congrArg a.linearEquiv (h.natural.intertwines l v)).trans
    (a.intertwines (h.natural.groupEquiv l) (h.natural.linearEquiv v))

/-- The centerless projective action cannot have quadratic ratio at most two. -/
theorem projectiveBound {κ : GroupClass.{u}} : Projective.IrreducibleProjectiveBound κ F := by
  intro hF X U _ _ _ _ _ ρ L hsq hfit _ hf hi hm
  exact ChapterK.Linear.Recognition.PSL3FourExclusion.quadraticRatio_gt_two hsq hfit
    ⟨F,inferInstance,inferInstance,hF,hm⟩ hf hi

/-- Recognize the literal invariant constituent without a classification callback. -/
theorem invariant_natural_section {X U : Type u} [Group X] [Finite X]
    [AddCommGroup U] [Module (ZMod 2) U] [FiniteDimensional (ZMod 2) U]
    {κ : GroupClass.{u}} (ρ : Representation (ZMod 2) X U) (K : Subgroup X) [K.Normal]
    (eK : K ≃* SL) (hsq : IsSQTK κ X) (hquot : IsPGroup 2 (X ⧸ K))
    (I : Submodule (ZMod 2) U) (hI : IsIrrPlus ρ K I)
    (hstable : (⊤ : Subgroup X) ≤ subspaceStabilizer ρ I)
    (A : Subgroup X) (hA : IsElementaryTwo A) (hq : IsQuadratic ρ A)
    (hc : fixedCodim ρ A ≤ 2 * rank A) (hAC : Disjoint A (centralizer (K : Set X))) :
    ∃ e : K ≃* SL, Nonempty (NaturalCentralSection ρ K e I) :=
  NaturalRecognition.invariant_natural_section ρ K eK hsq hquot I hI hstable A hA hq hc hAC
    projectiveBound smallRatio naturalFF
end CFSG.Quasithin.Chapter13.Section08.ComponentSieve.FieldComponents.ExceptionalFields.LinearThreeFour.AutomorphismModule.NaturalRecognition.Native
