module
public import CFSG.Quasithin.Chapter13.Section08.ComponentSieve.FieldComponents.ExceptionalFields.LinearThreeFour.AutomorphismModule.NaturalSections.NativeRecognition
public import Theory.Representation.NormalComponentConstituents
public import Theory.Representation.BinaryOffender.AmbientSectionTransport

/-!
# Selecting a natural SL₃(4) constituent for the original two-group

Choose an Irr⁺ constituent homogeneous under the specified normalizing
two-group. A fixed-free scalar makes its component action faithful: its
central kernel is either trivial or the full cubic center, and the latter
would fix the constituent pointwise. The quadratic actor acts faithfully on
this same section, so the independent-orbit bound forces it to stabilize the
constituent. Restrict to the subgroup generated by the component and actor.
Native B.4.5 then gives natural coordinates on its literal central quotient.
The subgroup-to-ambient quotient equivalence preserves the component marking.

The original-source consumer is SpecialLinearFourConstituent. It supplies
the fixed-free scalar and an actual quadratic actor contained in T*, retaining
T*-homogeneity and the original inverter for the later graph-pair assembly.
Source: Aschbacher–Smith, A.1.42, D.3.5–7, B.4.5 and 13.8.20,
printed pp.32,195–196,87,955.
-/

public noncomputable section
open Subgroup Representation Representation.BinaryOffender Representation.SL3FourNaturalDual Theory.GroupTheory
open CFSG.Quasithin
namespace CFSG.Quasithin.Chapter13.Section08.ComponentSieve.FieldComponents.ExceptionalFields.LinearThreeFour.AutomorphismModule.NaturalRecognition.Native
universe u
variable {D U : Type u} [Group D] [Finite D] [AddCommGroup U] [Module (ZMod 2) U]
  [FiniteDimensional (ZMod 2) U] (ρ : Representation (ZMod 2) D U)
  (K : Subgroup D) [K.Normal] [IsQuasisimple K]
omit [Finite D] [FiniteDimensional (ZMod 2) U] [K.Normal] in
private theorem constituent_faithful
    (eK : K ≃* SL) (x : D) (hx : x ∈ (center K).map K.subtype)
    (hfree : ∀ v, ρ x v = v → v = 0)
    (I : Submodule (ZMod 2) U) (hI : IsIrrPlus ρ K I) :
    Function.Injective (invariantSubspace ρ K I hI.choose).toRepresentation := by
  let σ := (invariantSubspace ρ K I hI.choose).toRepresentation
  have hZ : Nat.card (center K) = 3 := by
    rw [Nat.card_congr (centerCongr eK).toEquiv,Atlas.ExceptionalSupport.card_sl_center,
      Fintype.card_fin,Nat.card_eq_fintype_card,SL2FourNatural.card_field]
    decide
  have hk : σ.ker ≤ center K := by
    rcases IsQuasisimple.normal_le_center_or_eq_top σ.ker with h | h
    · exact h
    · exfalso
      apply hI.not_le_fixedSpace ρ
      intro v hv k
      have he : σ k = 1 := (show k ∈ σ.ker from h.symm ▸ mem_top k)
      exact congrArg (fun f => (f ⟨v,hv⟩ : U)) he
  apply (MonoidHom.ker_eq_bot_iff _).mp
  by_contra hn
  let : Fact (Nat.card (center K)).Prime := ⟨hZ ▸ Nat.prime_three⟩
  have hne : σ.ker.subgroupOf (center K) ≠ ⊥ := by
    intro hb
    apply hn
    apply bot_unique
    intro k hk'
    have hm : (⟨k,hk hk'⟩ : center K) ∈ σ.ker.subgroupOf (center K) := hk'
    have he : (⟨k,hk hk'⟩ : center K) = 1 := mem_bot.mp (hb ▸ hm)
    exact mem_bot.mpr (congrArg (fun z : center K => (z : K)) he)
  have ht : σ.ker.subgroupOf (center K) = ⊤ :=
    (σ.ker.subgroupOf (center K)).eq_bot_or_eq_top_of_prime_card.resolve_left hne
  obtain ⟨z,hz,hzx⟩ := hx
  have hzker : z ∈ σ.ker :=
    (show (⟨z,hz⟩ : center K) ∈ σ.ker.subgroupOf (center K) from ht ▸ mem_top _)
  apply hI.ne_bot ρ
  apply bot_unique
  intro v hv
  apply (Submodule.mem_bot (ZMod 2)).mpr
  apply hfree v
  rw [←hzx]
  exact congrArg (fun f => (f ⟨v,hv⟩ : U)) hzker

omit [IsQuasisimple K] in
private theorem stabilized_natural
    {κ : GroupClass.{u}} (eK : K ≃* SL) (hsq : IsSQTK κ D)
    (I : Submodule (ZMod 2) U) (hI : IsIrrPlus ρ K I)
    (A : Subgroup D) (hA : IsElementaryTwo A) (hq : IsQuadratic ρ A)
    (hc : fixedCodim ρ A ≤ 2 * rank A) (hAC : A ⊓ centralizer (K : Set D) = ⊥)
    (hAI : A ≤ subspaceStabilizer ρ I) :
    ∃ e : K ≃* SL, Nonempty (NaturalCentralSection ρ K e I) := by
  let E := K ⊔ A
  let K₀ := K.subgroupOf E
  let A₀ := A.subgroupOf E
  let σ := ρ.comp E.subtype
  let e₀ : K₀ ≃* K := subgroupOfEquivOfLe le_sup_left
  let : IsElementaryAbelian 2 A := hA.2
  have hA₀ : IsElementaryTwo A₀ := by
    refine ⟨?_,IsElementaryAbelian.subgroupOf (show A ≤ E from le_sup_right)⟩
    intro he
    change A.subgroupOf E = ⊥ at he
    exact hA.1 (by
      rw [←map_subgroupOf_eq_of_le (show A ≤ E from le_sup_right),he,Subgroup.map_bot])
  have hgen : K₀ ⊔ A₀ = ⊤ := by
    rw [←subgroupOf_sup (show K ≤ E from le_sup_left) (show A ≤ E from le_sup_right)]
    exact subgroupOf_self _
  have hquot : IsPGroup 2 (E ⧸ K₀) :=
    quotient_isPGroup_of_sup_eq_top A₀ K₀ hA₀.2.isPGroup ((sup_comm _ _).trans hgen)
  have hi₀ : IsIrrPlus σ K₀ I := (IsIrrPlus.subgroupOf_iff ρ K E le_sup_left I).mpr hI
  have hs : (⊤ : Subgroup E) ≤ subspaceStabilizer σ I := by
    intro g _
    exact (sup_le hI.choose hAI) g.property
  have hAC₀ : Disjoint A₀ (centralizer (K₀ : Set E)) := by
    apply disjoint_iff.mpr
    apply bot_unique
    rintro a ⟨ha,hcent⟩
    apply Subtype.ext
    apply mem_bot.mp
    rw [←hAC]
    refine ⟨ha,mem_centralizer_iff.mpr (fun k hk => ?_)⟩
    exact congrArg Subtype.val (mem_centralizer_iff.mp hcent
      (⟨k,show k ∈ E from mem_sup_left hk⟩ : E) hk)
  have hd : fixedCodim σ A₀ ≤ 2 * rank A₀ := by
    rw [fixedCodim_subgroupOf ρ (show A ≤ E from le_sup_right),
      rank_subgroupOf (show A ≤ E from le_sup_right)]
    exact hc
  obtain ⟨e,⟨n⟩⟩ := invariant_natural_section σ K₀ (e₀.trans eK) (hsq.subgroup E)
    hquot I hi₀ hs A₀ hA₀ (fun a ha b hb v => hq a ha b hb v) hd hAC₀
  let f := subgroupCentralQuotientEquiv ρ K E le_sup_left I
  refine ⟨e₀.symm.trans e,⟨⟨hI.choose,f.symm.trans n.coordinates,?_⟩⟩⟩
  intro k v
  obtain ⟨w,rfl⟩ := f.surjective v
  have he : centralQuotientRepresentation ρ K I hI.choose k (f w) =
      f (centralQuotientRepresentation σ K₀ I n.stable (e₀.symm k) w) := by
    induction w using Submodule.Quotient.induction_on with | _ w => rfl
  change n.coordinates (f.symm (centralQuotientRepresentation ρ K I hI.choose k (f w))) = _
  rw [he,f.symm_apply_apply]
  exact (n.equivariant (e₀.symm k) w).trans (by rw [LinearEquiv.trans_apply,f.symm_apply_apply]; rfl)

/-- The actual quadratic actor selects and recognizes a natural central section,
with homogeneity under the specified containing two-group retained. -/
theorem quadratic_natural_constituent {κ : GroupClass.{u}}
    (eK : K ≃* SL) (hsq : IsSQTK κ D) (hf : Function.Injective ρ)
    (x : D) (hx : x ∈ (center K).map K.subtype)
    (hfree : ∀ v, ρ x v = v → v = 0)
    (A P : Subgroup D) (hP : IsPGroup 2 P) (hAP : A ≤ P) (hA : IsElementaryTwo A) (hq : IsQuadratic ρ A)
    (hc : fixedCodim ρ A ≤ 2 * rank A) (hAC : A ⊓ centralizer (K : Set D) = ⊥) :
    ∃ I : Submodule (ZMod 2) U, ∃ _hI : Homogeneous.IsIrrPlusWith ρ K P I,
      A ≤ subspaceStabilizer ρ I ∧
      ∃ e : K ≃* SL, Nonempty (NaturalCentralSection ρ K e I) := by
  let : IsSimpleGroup (K ⧸ center K) := IsQuasisimple.simple
  let : Nontrivial K := (QuotientGroup.mk'_surjective (center K)).nontrivial
  obtain ⟨I,hi⟩ := Homogeneous.exists_isIrrPlusWith_of_faithful ρ hf K P
    ((Subgroup.nontrivial_iff_ne_bot K).mp inferInstance) le_normalizer_of_normal hP
  have hfix : fixedSpace ρ K = ⊥ := by
    apply bot_unique
    intro v hv
    exact (Submodule.mem_bot (ZMod 2)).mpr (hfree v (hv ⟨x,(map_subtype_le _) hx⟩))
  have hfi := constituent_faithful ρ K eK x hx hfree I hi.isIrrPlus
  have hfaithK : ∀ k ∈ K, (∀ v ∈ I, ρ k v = v) → k = 1 := by
    intro k hk hh
    have he : (invariantSubspace ρ K I hi.isIrrPlus.choose).toRepresentation ⟨k,hk⟩ = 1 := by
      ext v
      exact hh v v.property
    exact congrArg Subtype.val (hfi (he.trans (map_one _).symm))
  have hfaithA := actor_faithful_on_section ρ K A I hi.isIrrPlus.choose hfaithK
    le_normalizer_of_normal hAC
  have hsub : subspaceOrbit ρ A I ⊆ subspaceOrbit ρ P I := by
    rintro J ⟨a,rfl⟩
    exact ⟨⟨a,hAP a.property⟩,rfl⟩
  have hs := quadratic_stabilizes_of_independent_orbit ρ I A hA hq
    ((hi.independent_orbit_of_fixedSpace_eq_bot ρ hfix).mono hsub) hfaithA
    (hi.isIrrPlus.finrank_gt_two ρ K) hc
  exact ⟨I,hi,hs,stabilized_natural ρ K eK hsq I hi.isIrrPlus A hA hq hc hAC hs⟩
end CFSG.Quasithin.Chapter13.Section08.ComponentSieve.FieldComponents.ExceptionalFields.LinearThreeFour.AutomorphismModule.NaturalRecognition.Native
