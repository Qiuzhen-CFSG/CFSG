module

public import CFSG.Quasithin.Chapter13.Section08.ComponentSieve.FieldComponents.HigherFieldReduction.LocalBorel.CentralizingCalculation.Covered
public import CFSG.Quasithin.Chapter13.Section08.ComponentSieve.FieldComponents.HigherFieldReduction.LocalBorel.CentralizingCalculation.Covered.ModelImage
public import Theory.GroupTheory.PResidual.CubicKernel
public import Theory.GroupTheory.PResidual.CubicCoreIndex
public import Theory.GroupTheory.PResidual.OddCoreSupplement

/-!
# The covered calculation in the full Borel product

Write D = L₁, X = L₁,+, C = O²(C_{BD}(L/O₂(L))), and J = BD.
The concrete covered action gives J = CD; the earlier factorization
D = XL₀ and L₀ ≤ C then give J = CX. Relative normality places the
intrinsic two-cores of X and D in O₂(J). If C = J, the checked kernel
intersection forces D = L₀, contradicting their quotient orders nine
and three. The cubic supplement lemmas now give [J : C O₂(J)] = 3
and O²(O³(B)) ≤ C. An abelian Borel quotient, kept as the explicit
premise discharged by ModelBorel, gives O³(B) ≤ C O₂(B).

These conclusions use the full carrier BD. They do not assert the
stronger placement L₀ ≤ BX preserved in the existing ZeroPlacement API.
Import this extension near source consumers, never back into Covered.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004,
13.2.2(3), p.877; 13.7.3(9), p.936; the sufficient full-product
calculation for the proof of 13.8.20, p.954/PDF p.971.
-/

@[expose] public section
open Subgroup
namespace CFSG.Quasithin.Chapter13.Section08.ComponentSieve.FieldComponents.HigherFieldReduction.LocalBorel.CentralizingCalculation.Covered.ZeroPlacement.FullProduct
open CFSG.Quasithin.Chapter13.Section08.ComponentSieve.FieldComponents.LinearThree.Geometry.CoveredProduct.ResidualPlacement
universe u v
variable {G : Type u} [Group G] [Finite G]
variable {T : Sylow 2 G} {H K L V V₁ V₂ V₃ M G₁ : Subgroup G}
  [(Source.starImage H K).Normal] {n : ℕ} {unitary four : Bool}
  (d : SourceContext.{u,v} T H K L V V₁ V₂ V₃ M G₁ n unitary four)
  (a : LocalAction.NaturalSetup L (T : Subgroup G) V V₁ V₃)
  (hfactor : one L (T : Subgroup G) V₁ = plus L (T : Subgroup G) V₁ ⊔ zero L)

local notation "D" => one L (T : Subgroup G) V₁
local notation "X" => plus L (T : Subgroup G) V₁
local notation "C" => centralizingResidual d.B D L
local notation "J" => d.B ⊔ D

include a hfactor in
/-- The full Borel product is generated by the centralizing residual and the actual marked X. -/
theorem product_eq : J = C ⊔ X := by
  calc
    J = C ⊔ D := ModelImage.product_eq d a hfactor
    _ = C ⊔ (X ⊔ zero L) := by rw [hfactor]
    _ = C ⊔ X := by
      rw [← sup_assoc, sup_eq_left.mpr ((source_zero_le d hfactor).trans le_sup_left)]

/-- C is normal relative to the full product J. -/
theorem product_normalizes_centralizingResidual : J ≤ normalizer (C : Set G) :=
  centralizingResidual_normalized _ _ _ _ d.product_normalizes_L
    (J).le_normalizer d.product_normalizes_L

/-- The source normalization of B by D makes B normal in J. -/
theorem product_normalizes_borel : J ≤ normalizer (d.B : Set G) :=
  sup_le d.B.le_normalizer (le_sup_left.trans d.borel_normalized)

/-- The intrinsic formulation of relative normality of C. -/
theorem centralizingResidual_normal : ((C).subgroupOf J).Normal :=
  (normal_subgroupOf_iff_le_normalizer (centralizingResidual_le _ _ _)).mpr
    (product_normalizes_centralizingResidual d)

/-- The intrinsic formulation of relative normality of B. -/
theorem borel_normal : (d.B.subgroupOf J).Normal :=
  (normal_subgroupOf_iff_le_normalizer le_sup_left).mpr (product_normalizes_borel d)

omit [Finite G] in
include a in
/-- Normality of the marked residual in D controls its intrinsic core. -/
theorem plus_core_le_one_core : (X).pCoreIn 2 ≤ (D).pCoreIn 2 :=
  pCoreIn_mono_of_normalizes (plus_le_one L (T : Subgroup G) V₁ a.line_stable)
    (one_normalizes_plus L (T : Subgroup G) V₁)

/-- The theta identity puts the intrinsic core of D in O₂(J). -/
theorem one_core_le_product_core : (D).pCoreIn 2 ≤ (J).pCoreIn 2 :=
  pCoreIn_mono_of_normalizes le_sup_right (Covered.product_normalizes_one d)

include a in
/-- Both relative normality steps retain the actual marked core. -/
theorem plus_core_le_product_core : (X).pCoreIn 2 ≤ (J).pCoreIn 2 :=
  (plus_core_le_one_core a).trans (one_core_le_product_core d)

/-- Two-perfectness of B comes from its literal Borel residual definition. -/
theorem borel_isPPerfect : IsPPerfect 2 d.B := isPPerfect_embedded_pResidual 2 _

/-- The full product is separately two-perfect. -/
theorem product_isPPerfect : IsPPerfect 2 (J : Subgroup G) := Covered.product_isPPerfect d

include a hfactor in
/-- The intrinsic quotient orders nine and three prevent C from filling J. -/
theorem centralizingResidual_ne_product : C ≠ J := by
  intro he
  have hh := source_residual_intersection d hfactor
  rw [he, inf_eq_right.mpr le_sup_right] at hh
  have hr : residualIn 2 D = D := by
    unfold residualIn
    rw [(pResidual_eq_top_iff 2 D).mpr (show IsPPerfect 2 D from residual_isPPerfect _),
      ← MonoidHom.range_eq_map, range_subtype]
  rw [hr] at hh
  have hc := LocalAction.one_quotient_card L (T : Subgroup G) V₁ a.normalizes_L
    a.line_stable hfactor a.zero_core_card (a.plus_core_card hfactor)
  rw [hh, a.zero_core_card] at hc
  omega

include a hfactor in
/-- The full product has index three over C O₂(J). -/
theorem cubic_index : (C ⊔ (J).pCoreIn 2).relIndex J = 3 :=
  cubic_relIndex_sup_pCoreIn C X J (product_eq d a hfactor).symm
    (product_normalizes_centralizingResidual d) (product_isPPerfect d)
    (a.plus_core_card hfactor) (plus_core_le_product_core d a)
    (centralizingResidual_ne_product d a hfactor)

include a hfactor in
/-- The actual cubic supplement puts the iterated residual of J in C. -/
theorem product_two_threeResidual_le : residualIn 2 (residualIn 3 J) ≤ C := by
  have hCJ : C ≤ J := centralizingResidual_le _ _ _
  have hXJ : X ≤ J := (plus_le_one L (T : Subgroup G) V₁ a.line_stable).trans le_sup_right
  let _ := centralizingResidual_normal d
  have hg : (C).subgroupOf J ⊔ (X).subgroupOf J = ⊤ := by
    rw [← subgroupOf_sup hCJ hXJ, ← product_eq d a hfactor, subgroupOf_self]
  let e := subgroupOfEquivOfLe hXJ
  have hc : Nat.card ((X).subgroupOf J ⧸ pCore 2 ((X).subgroupOf J)) = 3 := by
    rw [Nat.card_congr (QuotientGroup.congr _ _ e (pCore_map_iso 2 e)).toEquiv]
    exact a.plus_core_card hfactor
  have hh := map_mono (f := (J).subtype)
    (two_threeResidual_le_normal_of_cubic_supplement ((C).subgroupOf J) ((X).subgroupOf J) hg hc)
  rw [map_subgroupOf_eq_of_le hCJ, map_embedded_pResidual] at hh
  exact hh

include a hfactor in
/-- Residual monotonicity restricts the full-product result to B. -/
theorem borel_two_threeResidual_le : residualIn 2 (residualIn 3 d.B) ≤ C :=
  (embedded_pResidual_mono 2 (embedded_pResidual_mono 3 le_sup_left)).trans
    (product_two_threeResidual_le d a hfactor)

/-- Abelianness and two-perfectness give the odd quotient needed for the supplement. -/
theorem borel_threeResidual (hab : ⁅d.B, d.B⁆ ≤ d.B.pCoreIn 2) :
    residualIn 3 d.B = residualIn 2 (residualIn 3 d.B) ⊔ d.B.pCoreIn 2 :=
  threeResidual_twoResidual_sup_twoCore d.B
    (odd_card_quotient_twoCore_of_isPPerfect d.B (borel_isPPerfect d) hab)

include a hfactor in
/-- The sufficient source residual bound, with only the Borel quotient premise explicit. -/
theorem borel_threeResidual_le (hab : ⁅d.B, d.B⁆ ≤ d.B.pCoreIn 2) :
    residualIn 3 d.B ≤ C ⊔ d.B.pCoreIn 2 := by
  rw [borel_threeResidual d hab]
  exact sup_le_sup (borel_two_threeResidual_le d a hfactor) le_rfl

/-- Normality of B retains its core inside the full product core. -/
theorem borel_core_le_product_core : d.B.pCoreIn 2 ≤ (J).pCoreIn 2 :=
  pCoreIn_mono_of_normalizes le_sup_left (product_normalizes_borel d)

end CFSG.Quasithin.Chapter13.Section08.ComponentSieve.FieldComponents.HigherFieldReduction.LocalBorel.CentralizingCalculation.Covered.ZeroPlacement.FullProduct
