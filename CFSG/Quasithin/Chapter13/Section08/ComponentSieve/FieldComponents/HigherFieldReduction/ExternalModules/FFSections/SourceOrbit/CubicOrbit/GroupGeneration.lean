module

public import Theory.GroupTheory.SmallFittingResidual

/-!
# Removing the odd part of the external supplement

If a centerless normal component has abelian outer automorphism group,
the earlier source identity D = [D,P] makes D act on the component by inner
automorphisms. Two-perfectness and the small Fitting subgroup then absorb
the centralizer coordinate into the external cubic subgroup. Thus the
source generation KDP = H implies KXP = H, rather than assuming it.

The abelian outer automorphism group is a separate model obligation for
the three surviving external carriers. No automorphism classification is
asserted here.

Source: Aschbacher–Smith, proof of 13.8.20(a), printed p.954, with the
earlier D = L₁ = [L₁,T] and Fitting alternative 13.8.14.
-/

public section

open Subgroup
open scoped IsMulCommutative commutatorElement

namespace CFSG.Quasithin.Chapter13.Section08.ComponentSieve.FieldComponents.HigherFieldReduction.ExternalModules.FFSections.SourceOrbit
variable {G : Type*} [Group G] [Finite G]

omit [Finite G] in
/-- A supplement generated by its commutators has trivial image in the
abelian outer automorphism group of the normal component. -/
theorem supplement_le_component_centralizer
    (K D P : Subgroup G) [K.Normal]
    [IsMulCommutative (MulAut.Outer K)] (hfull : ⁅D,P⁆ = D) :
    D ≤ K ⊔ centralizer (K : Set G) := by
  rw [← MulAut.conjNormal_comap_innerSubgroup K]
  let f : G →* MulAut.Outer K :=
    (QuotientGroup.mk' (MulAut.innerSubgroup K)).comp MulAut.conjNormal
  have hd : D ≤ f.ker := by
    rw [← hfull]
    apply commutator_le.mpr
    intro d _ p _
    change f ⁅d,p⁆ = 1
    rw [map_commutatorElement, commutatorElement_eq_one_iff_mul_comm]
    exact mul_comm _ _
  intro d hdD
  change (MulAut.conjNormal d : MulAut K) ∈ MulAut.innerSubgroup K
  exact (QuotientGroup.eq_one_iff _).mp (hd hdD)

private theorem supplement_le_component_fitting
    (K D : Subgroup G) [K.Normal] (hD : IsPPerfect 2 D)
    (hC : Group.IsSolvable (centralizer (K : Set G)))
    (hF : Nat.card (fittingSubgroup G) = 1 ∨ Nat.card (fittingSubgroup G) = 3)
    (hinner : D ≤ K ⊔ centralizer (K : Set G)) :
    D ≤ K ⊔ fittingSubgroup G := by
  let C := centralizer (K : Set G)
  let B := fittingSubgroupOf C
  have hBN : B.Normal := fittingSubgroupOf_normal C inferInstance
  have hBF : B ≤ fittingSubgroup G :=
    le_sSup ⟨hBN, fittingSubgroupOf_isNilpotent C⟩
  have hBc : Nat.card B = 1 ∨ Nat.card B = 3 := by
    have hd := card_dvd_of_le hBF
    rcases hF with hF | hF
    · rw [hF] at hd
      exact Or.inl (Nat.dvd_one.mp hd)
    · rw [hF] at hd
      exact (Nat.dvd_prime Nat.prime_three).mp hd
  have hDC : D ≤ centralizer (B : Set G) :=
    twoPerfect_centralizes_small_normal D B hD hBc
  intro d hd
  obtain ⟨k,hk,c,hc,hkc⟩ := mem_sup_of_normal_left.mp (hinner hd)
  have hkB : k ∈ centralizer (B : Set G) :=
    (le_centralizer_iff.mpr (show B ≤ centralizer (K : Set G) from map_subtype_le _)) hk
  have hcB : c ∈ centralizer (B : Set G) := by
    have he : c = k⁻¹ * d := by rw [← hkc]; group
    rw [he]
    exact (centralizer (B : Set G)).mul_mem
      ((centralizer (B : Set G)).inv_mem hkB) (hDC hd)
  have hcfit : (⟨c,hc⟩ : C) ∈ fittingSubgroup C := by
    apply centralizer_fittingSubgroup_le_fittingSubgroup_of_solvable hC
    intro b hb
    exact Subtype.ext (hcB b.val (mem_map_of_mem C.subtype hb))
  rw [← hkc]
  exact (K ⊔ fittingSubgroup G).mul_mem (mem_sup_left hk)
    (mem_sup_right (hBF (mem_map_of_mem C.subtype hcfit)))

/-- Recover KXP generation from the actual KDP generation, full supplement
commutator, and small Fitting bound. The only model input is abelian Out(K). -/
theorem component_cubic_generation_of_outer_abelian
    (K D X P : Subgroup G) [K.Normal]
    [IsMulCommutative (MulAut.Outer K)] [Group.IsSolvable (D ⊔ P : Subgroup G)]
    (hz : center K = ⊥) (hD : IsPPerfect 2 D) (hfull : ⁅D,P⁆ = D)
    (hfit : fittingSubgroup G ≤ X) (hcard : Nat.card X = 3)
    (hgen : K ⊔ (D ⊔ P) = ⊤) :
    D ≤ K ⊔ X ∧ K ⊔ (X ⊔ P) = ⊤ := by
  let q := QuotientGroup.mk' K
  have hmap : (D ⊔ P).map q = ⊤ := by
    have h := congrArg (map q) hgen
    simpa only [q, Subgroup.map_sup, QuotientGroup.map_mk'_self, bot_sup_eq,
      map_top_of_surjective _ (QuotientGroup.mk'_surjective _)] using h
  have hf : Function.Surjective (q.comp (D ⊔ P).subtype) := by
    intro y
    have hy : y ∈ (D ⊔ P).map q := hmap.symm ▸ mem_top y
    obtain ⟨d,hd,he⟩ := hy
    exact ⟨⟨d,hd⟩,he⟩
  let _ : Group.IsSolvable (G ⧸ K) := Group.isSolvable_of_surjective hf
  have hC := centralizer_solvable_of_centerless_quotient K hz
  have hF : Nat.card (fittingSubgroup G) = 1 ∨ Nat.card (fittingSubgroup G) = 3 := by
    have hd := card_dvd_of_le hfit
    rw [hcard] at hd
    exact (Nat.dvd_prime Nat.prime_three).mp hd
  have hDle : D ≤ K ⊔ X :=
    (supplement_le_component_fitting K D hD hC hF
      (supplement_le_component_centralizer K D P hfull)).trans (sup_le_sup_left hfit K)
  refine ⟨hDle, top_unique ?_⟩
  rw [← hgen]
  exact sup_le le_sup_left
    (sup_le (hDle.trans (sup_le le_sup_left (le_sup_left.trans le_sup_right)))
      (le_sup_right.trans le_sup_right))

end CFSG.Quasithin.Chapter13.Section08.ComponentSieve.FieldComponents.HigherFieldReduction.ExternalModules.FFSections.SourceOrbit
