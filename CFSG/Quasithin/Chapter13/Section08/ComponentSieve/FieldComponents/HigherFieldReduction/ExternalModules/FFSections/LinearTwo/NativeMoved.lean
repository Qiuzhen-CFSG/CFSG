module
public import CFSG.Quasithin.Chapter13.Section08.ComponentSieve.FieldComponents.HigherFieldReduction.ExternalModules.FFSections.LinearTwo.NativeSource
public import CFSG.Quasithin.ChapterB.Section01.IrreducibleSections
public import CFSG.Quasithin.Chapter13.Section08.ComponentSieve.FieldComponents.HigherFieldReduction.ExternalModules.FFSections.LinearTwo.NoStrongMoved

/-!
# Original-source classification in the external PSL₂ moved-space argument

The native irreducible strong-offender exclusion applies to every actual
noncentral invariant section, since the normal cubic and the common
centralizer bound force those sections to be faithful. In the two-FF
alternative, a minimal offender stabilizes a constituent by B.1.5(3).
Equality in the codimension bound then makes the entire moved module that
constituent, contradicting the cubic pair decomposition.

Consequently the F.9.18(6) alternatives leave exactly W=[U,K]. Both earlier
classification inputs are proved here through NativeSource. A K-central
ambient complement is permitted, and the original source application in
OriginalSource.LinearTwo constructs the quadratic actor and centralizer bound.
Source: Aschbacher–Smith, B.1.5(3), B.4.2, F.9.18(6), 13.8.20(a), pp.69–70,86,325–326,954.
-/

public noncomputable section
open Subgroup Representation Representation.BinaryOffender Theory.GroupTheory
open scoped MatrixGroups
namespace CFSG.Quasithin.Chapter13.Section08.ComponentSieve.FieldComponents.HigherFieldReduction.ExternalModules.FFSections.LinearTwo.NativeSource
open Components.Swapped.LinearTwo.ModuleAlternatives.F918Sections.NoStrong
open Components.Swapped.LinearTwo.ModuleAlternatives.F918Sections.NoStrong.IrreducibleReduction
open CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.GenerationOne.RepresentationReduction.SourceRestrictions.Cases
open CFSG.Quasithin.Chapter15.Section04.LocalSetup.TwoFactors.FFBranch.ClassificationComparison.FFAlternatives
open CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.GenerationOne.RepresentationReduction.SourceRestrictions
open NoStrongMoved InvertedCubicTensor
universe u v w

section NonFF
variable {D : Type u} [Group D] [Finite D] (K X : Subgroup D) [K.Normal]

/-- A faithful module generated by both the component and the normal cubic
cannot be FF; the native classification discharges both earlier inputs. -/
theorem not_ff_cubic_full
    {F : Type w} [Field F] [Finite F] [CharP F 2]
    [IsQuasisimple K] [X.Normal] (e : K ≃* PSL(2,F))
    (hS : IsSQTK KnownSimple.IsKnownSimple D) (hx : Nat.card X = 3)
    (hc : centralizer (K : Set D) ⊓ centralizer (X : Set D) ≤ X)
    (hKX : K ≤ centralizer (X : Set D))
    {V : Type v} [AddCommGroup V] [Module (ZMod 2) V] [Finite V]
    (ρ : Representation (ZMod 2) D V) (hf : Function.Injective ρ)
    (s : S₃ →* D) (hs : ∀ (k : K) g, Commute (k : D) (s g))
    (hmark : (alternatingGroup (Fin 3)).map s = X)
    (hg : subspaceCommutator ρ ⊤ X = ⊤)
    (hn : ¬ ∀ k ∈ K, ∀ v, ρ k v = v)
    (hfull : subspaceCommutator ρ ⊤ K = ⊤) : ¬ IsFFModule ρ := by
  rintro ⟨B,hB⟩
  obtain ⟨A, _, hA, hq, _⟩ := hB.exists_quadratic_minimalBestOffender ρ
  have hoff := (hA.1.isOffender ρ).2
  have hfree := ambient_fixedFree_of_commutator ρ s (by rw [hmark]; exact hg)
  by_cases hAX : A ≤ centralizer (X : Set D)
  swap
  · obtain ⟨hr,hd⟩ := normalThree_quadratic_rank_fixedCodim ρ hf X inferInstance hx hg A hA.1.1 hq hAX
    have hdim := cubic_dimension_gt_two K ρ s hs hfree hn
    omega
  have hKA := component_commutator_of_centralizes_cubic K X hx hc hA.1.1 hAX
  have hKne : K ≠ ⊥ := by intro he; apply hn; simp [he]
  obtain ⟨I,hI⟩ := exists_isIrrPlus_of_faithful ρ hf K hKne
  obtain ⟨hr,hchief⟩ := quasisimple_stabilization_hypotheses K
  have hAI := irr_invariance D V ρ hf A K hA hKne hr hKA hchief I hI
  let E := K ⊔ A
  let L := K.subgroupOf E
  let A₀ := A.subgroupOf E
  let τ := ρ.comp E.subtype
  let : IsQuasisimple L := IsQuasisimple.of_mulEquiv
    (subgroupOfEquivOfLe (show K ≤ E from le_sup_left)).symm
  have hfit : generalizedFitting E = L := generated_fitting K X hx hc hKX hA.1.1 hAX
  let eL : L ≃* PSL(2,F) := (subgroupOfEquivOfLe le_sup_left).trans e
  have hcent : centralizer (L : Set E) = ⊥ := selfcentral_of_fitting L hfit (psl_center_bot L eL)
  have hEI : E ≤ subspaceStabilizer ρ I := sup_le hI.choose hAI
  let U : Subrepresentation τ := ⟨I, fun g _ hv => (hEI g.property _).2 hv⟩
  have hnU : ¬ ∀ l ∈ L, ∀ v, U.toRepresentation l v = v := by
    intro ht
    apply hI.not_le_fixedSpace ρ
    intro v hv k
    exact congrArg Subtype.val (ht ⟨k,mem_sup_left k.property⟩ k.property ⟨v,hv⟩)
  have hkU : (actionHom U.toRepresentation).ker = ⊥ := by
    apply bot_unique
    rw [← hcent]
    exact CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.GenerationOne.RepresentationReduction.SourceRestrictions.action_kernel_le_centralizer U.toRepresentation L
      (CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.GenerationOne.RepresentationReduction.SourceRestrictions.central_kernel_of_quasisimple U.toRepresentation L hnU)
  have hfU : Function.Injective U.toRepresentation := by
    intro a b hab
    apply (MonoidHom.ker_eq_bot_iff (actionHom U.toRepresentation)).mp hkU
    exact imageRepresentation_injective _ hab
  have hnsU : ¬ IsStrongFFModule U.toRepresentation := by
    intro hstrong
    exact preaction_impossible_of_source {
      Actor := E
      Space := I
      representation := U.toRepresentation
      sqtk := hS.subgroup E
      faithful := hfU
      strong := hstrong
      quasisimple := by rw [hfit]; infer_instance
      componentEquiv := (MulEquiv.subgroupCongr hfit).trans eL }
  have hA₀ := hA.1.subgroupOf ρ (show A ≤ E from le_sup_right)
  have hrA : rank A₀ = rank A := by
    rw [← rank_map_injective E.subtype E.subtype_injective A₀]
    exact congrArg rank (map_subgroupOf_eq_of_le (show A ≤ E from le_sup_right))
  have hcod : fixedCodim τ A₀ = fixedCodim ρ A := by
    unfold fixedCodim
    rw [fixedSpace_comp_map, map_subgroupOf_eq_of_le (show A ≤ E from le_sup_right)]
  have hlow : rank A₀ ≤ fixedCodim U.toRepresentation A₀ :=
    Nat.le_of_not_gt (fun hlt => hnsU ⟨A₀,hA₀.1,hlt⟩)
  have hle := fixedCodim_subrepresentation_le τ U A₀
  have heq : fixedCodim U.toRepresentation A₀ = fixedCodim τ A₀ := by omega
  have hsup := (fixedCodim_subrepresentation_eq_iff τ U A₀).mp heq
  have hfixA := quotient_trivial_of_sup_fixedSpace τ U A₀ hsup
  have hcomm : ⁅L,A₀⁆ = L := by
    apply Subgroup.map_injective E.subtype_injective
    rw [Subgroup.map_commutator]
    change ⁅(K.subgroupOf E).map E.subtype, (A.subgroupOf E).map E.subtype⁆ = (K.subgroupOf E).map E.subtype
    rw [map_subgroupOf_eq_of_le (show K ≤ E from le_sup_left),
      map_subgroupOf_eq_of_le (show A ≤ E from le_sup_right), hKA]
  have hfixK := trivial_sup_of_commutator_eq U.quotientRepresentation L A₀ hcomm hfixA
  have hKI : subspaceCommutator ρ ⊤ K ≤ I := by
    apply Submodule.span_le.mpr
    rintro _ ⟨k,hk,v,_,rfl⟩
    exact (Submodule.Quotient.eq I).mp (hfixK ⟨k,mem_sup_left hk⟩ (mem_sup_right hk) (I.mkQ v))
  have hItop : I = ⊤ := top_unique (hfull ▸ hKI)
  exact irrPlus_not_invariant ρ s K hs (by rw [hmark]; exact hg) I hI
    (by rw [hItop]; exact le_subspaceStabilizer ρ ⊤ (by simp))


end NonFF

private def imageEquivOfFaithful
    {D V : Type*} [Group D] [AddCommGroup V] [Module (ZMod 2) V]
    (ρ : Representation (ZMod 2) D V) (hf : Function.Injective ρ) :
    D ≃* actionImage ρ :=
  MulEquiv.ofBijective (actionHom ρ)
    ⟨fun _ _ h => hf (congrArg (imageRepresentation ρ) h),
      ρ.asGroupHom.rangeRestrict_surjective⟩

private theorem imageEquivOfFaithful_symm_action
    {D V : Type*} [Group D] [AddCommGroup V] [Module (ZMod 2) V]
    (ρ : Representation (ZMod 2) D V) (hf : Function.Injective ρ)
    (g : actionImage ρ) (v : V) :
    imageRepresentation ρ g v = ρ ((imageEquivOfFaithful ρ hf).symm g) v := by
  obtain ⟨x,rfl⟩ := ρ.asGroupHom.rangeRestrict_surjective g
  change ρ x v = ρ ((imageEquivOfFaithful ρ hf).symm (imageEquivOfFaithful ρ hf x)) v
  rw [MulEquiv.symm_apply_apply]

private theorem ff_of_image
    {D V : Type*} [Group D] [AddCommGroup V] [Module (ZMod 2) V]
    (ρ : Representation (ZMod 2) D V) (hf : Function.Injective ρ)
    (h : IsFFModule (imageRepresentation ρ)) : IsFFModule ρ :=
  h.map_equivariant (imageRepresentation ρ) ρ
    (imageEquivOfFaithful ρ hf).symm.toMonoidHom
    (imageEquivOfFaithful ρ hf).symm.injective (LinearEquiv.refl _ _)
    (imageEquivOfFaithful_symm_action ρ hf)

private theorem strong_of_image
    {D V : Type*} [Group D] [AddCommGroup V] [Module (ZMod 2) V]
    (ρ : Representation (ZMod 2) D V) (hf : Function.Injective ρ)
    (h : IsStrongFFModule (imageRepresentation ρ)) : IsStrongFFModule ρ :=
  CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.GenerationOne.RepresentationReduction.SourceRestrictions.FFExclusions.strongFF_map_equivariant
    (imageRepresentation ρ) ρ (imageEquivOfFaithful ρ hf).symm.toMonoidHom
    (imageEquivOfFaithful ρ hf).symm.injective (LinearEquiv.refl _ _)
    (imageEquivOfFaithful_symm_action ρ hf) h

variable {D : Type u} [Group D] [Finite D] (K X : Subgroup D)
    [K.Normal] [X.Normal] [IsQuasisimple K]
    {F : Type w} [Field F] [Finite F] [CharP F 2]
    (e : K ≃* PSL(2,F)) (hS : IsSQTK KnownSimple.IsKnownSimple D)
    (hx : Nat.card X = 3)
    (hc : centralizer (K : Set D) ⊓ centralizer (X : Set D) ≤ X)
    {V : Type v} [AddCommGroup V] [Module (ZMod 2) V] [Finite V]
    (ρ : Representation (ZMod 2) D V)
    (s : S₃ →* D) (hs : ∀ (k : K) g, Commute (k : D) (s g))
    (hmark : (alternatingGroup (Fin 3)).map s = X)
    (hg : subspaceCommutator ρ ⊤ X = ⊤)

omit [Finite D] [X.Normal] in
include hmark in
private theorem cubic_mem : s cubic ∈ X := by
  rw [← hmark]
  exact mem_map_of_mem s (show cubic ∈ alternatingGroup (Fin 3) from by change Equiv.Perm.sign cubic = 1; decide +kernel)

omit [Finite D] [K.Normal] [X.Normal] [IsQuasisimple K] in
include hmark hs in
private theorem component_centralizes_cubic : K ≤ centralizer (X : Set D) := by
  intro k hk x hx
  rw [← hmark] at hx
  obtain ⟨g,_,rfl⟩ := hx
  exact (hs ⟨k,hk⟩ g).symm.eq

include e hS hx hc hg in
/-- The actual restricted KT action has no strong FF-offender. This proof
permits a nontrivial O₂(KT); its cubic action is inherited from H. -/
theorem no_strong_restriction (hf : Function.Injective ρ) (E : Subgroup D) :
    ¬ IsStrongFFModule (ρ.comp E.subtype) := by
  intro h
  apply no_strong_cubic K X e hS hx hc ρ hf hg
  exact CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.GenerationOne.RepresentationReduction.SourceRestrictions.FFExclusions.strongFF_map_equivariant
    (ρ.comp E.subtype) ρ E.subtype E.subtype_injective
    (LinearEquiv.refl _ _) (fun _ _ => rfl) h

include e hS hx hc hg hmark in
/-- Every literal noncentral invariant section is faithful, and its faithful
image after restriction to KT has no strong FF-offender. -/
theorem section_faithful_no_strong (C W : Subrepresentation ρ) (E : Subgroup D)
    (hn : ¬ ∀ k ∈ K, ∀ v, sectionRepresentation ρ C W k v = v) :
    Function.Injective (sectionRepresentation ρ C W) ∧
      ¬ IsStrongFFModule (imageRepresentation ((sectionRepresentation ρ C W).comp E.subtype)) := by
  let σ := sectionRepresentation ρ C W
  let : Finite (W.toSubmodule ⧸ (sectionLower ρ C W).toSubmodule) :=
    Finite.of_surjective _ (Submodule.mkQ_surjective _)
  have hfree := section_fixedFree ρ s C W (by rw [hmark]; exact hg)
  have hf := faithful_of_cubic K X hx hc σ hn (s cubic) (cubic_mem X s hmark) hfree
  refine ⟨hf, ?_⟩
  have hfull := full_of_fixedFree X σ (s cubic) (cubic_mem X s hmark) hfree
  exact fun h => no_strong_restriction K X e hS hx hc σ hfull hf E
    (strong_of_image _ (hf.comp E.subtype_injective) h)

include e hS hx hc hg hmark hs in
/-- All alternatives of F.9.18(6) are discharged. In particular, the two-FF
branch is contradicted by the proved cubic full-moved-space exclusion. -/
theorem moved_space (W : Subrepresentation ρ)
    (hW : W.toSubmodule ≠ ⊥)
    (hfull : subspaceCommutator ρ W.toSubmodule K = W.toSubmodule)
    (A : Subgroup D) (hA : IsElementaryTwo A)
    (hbound : fixedCodim ρ A ≤ 2 * rank A)
    (hfaith : A ⊓ centralizer (K : Set D) = ⊥) :
    W.toSubmodule = subspaceCommutator ρ ⊤ K := by
  have hxmem := cubic_mem X s hmark
  have hfree := ambient_fixedFree_of_commutator ρ s (by rw [hmark]; exact hg)
  have hwfree := fixedFree_of_injective (ρ.comp s) (W.toRepresentation.comp s)
    W.toSubmodule.subtype W.toSubmodule.subtype_injective (fun _ => rfl) hfree
  have hwfull := full_of_fixedFree X W.toRepresentation (s cubic) hxmem hwfree
  have hnW := subrepresentation_action_nontrivial ρ W K hW hfull
  have hfW := faithful_of_cubic K X hx hc W.toRepresentation hnW (s cubic) hxmem hwfree
  have hqfree := fixedFree_of_surjective (ρ.comp s) (W.quotientRepresentation.comp s)
    W.toSubmodule.mkQ W.toSubmodule.mkQ_surjective (fun _ => rfl) hfree
  let : Finite (V ⧸ W.toSubmodule) := Finite.of_surjective _ W.toSubmodule.mkQ_surjective
  have hqfull := full_of_fixedFree X W.quotientRepresentation (s cubic) hxmem hqfree
  by_contra hne
  have hnQ := quotient_action_nontrivial ρ W K hfull hne
  have hfQ := faithful_of_cubic K X hx hc W.quotientRepresentation hnQ (s cubic) hxmem hqfree
  rcases faithful_image_ff_alternative_of_quasisimple ρ W K A hA hbound hfaith hW hfull
    with he | ⟨hwff,_⟩ | hwstrong | hqstrong
  · exact hne he
  · have hKW : subspaceCommutator W.toRepresentation ⊤ K = ⊤ := by
      apply Submodule.map_injective_of_injective W.toSubmodule.subtype_injective
      have he := subspaceCommutator_map_embedding ρ W.toRepresentation (MonoidHom.id D)
        W.toSubmodule.subtype (fun _ _ => rfl) K ⊤
      simpa only [Submodule.map_top, Submodule.range_subtype, Subgroup.map_id, hfull] using he.symm
    exact not_ff_cubic_full K X e hS hx hc
      (component_centralizes_cubic K X s hs hmark) W.toRepresentation hfW s hs hmark hwfull hnW hKW
      (ff_of_image _ hfW hwff)
  · exact no_strong_cubic K X e hS hx hc W.toRepresentation hfW hwfull
      (strong_of_image _ hfW hwstrong)
  · exact no_strong_cubic K X e hS hx hc W.quotientRepresentation hfQ hqfull
      (strong_of_image _ hfQ hqstrong)
end CFSG.Quasithin.Chapter13.Section08.ComponentSieve.FieldComponents.HigherFieldReduction.ExternalModules.FFSections.LinearTwo.NativeSource
