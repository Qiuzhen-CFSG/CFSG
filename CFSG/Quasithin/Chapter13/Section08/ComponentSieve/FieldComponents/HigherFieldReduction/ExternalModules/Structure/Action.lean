module

public import CFSG.Quasithin.Chapter13.Section08.ComponentSieve.FieldComponents.HigherFieldReduction.SeedAction
public import Theory.GroupTheory.Commutator.ConjugateSpan
public import Theory.Representation.BinaryOffender.ConjugationGeneration
public import Theory.Representation.BinaryOffender.SectionLinear
public import Theory.Representation.InvertedCubicTensor

/-!
# Cubic generation and paired restrictions on the source sections

Relative normality propagates V₃ = [V₃,X] to U_H = [U_H,X]. The literal
map U_H → U_H/V₁ transports this to full commutator generation for the
given source conjugation action of H/O₂(H). An actual commuting S₃
embedding therefore yields the inverted-cubic tensor decomposition.

The same zero-norm identity passes first through the inclusion of an
invariant subspace, then through its actual quotient map. Thus every
chief section, including each noncentral chief section, has two isomorphic
K*-summands and an equivariant tensor map with the binary natural S₃ module.
No faithfulness, semisimplicity or FF classification is assumed.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004, proof of
13.8.20(a), printed p.954 (PDF p.971). The cubic embedding is an explicit
input here and is constructed separately from the source group structure.
-/

@[expose] public section

open Subgroup Representation Representation.BinaryOffender
open scoped TensorProduct IsMulCommutative
namespace CFSG.Quasithin.Chapter13.Section08.ComponentSieve.FieldComponents.HigherFieldReduction.ExternalModules.Structure
variable {G : Type*} [Group G]
variable (H X V₃ V₁ : Subgroup G)
  [(V₁.subgroupOf (Source.UH H V₃)).Normal]
  [IsElementaryAbelian 2 (Source.Utilde H V₃ V₁)]

/-- Relative normality propagates the earlier source seed commutator identity
and the genuine quotient map carries it to the binary source action. -/
theorem source_commutator_generation (hXH : X ≤ H) [(X.subgroupOf H).Normal]
    (ρ : Representation (ZMod 2) (Source.Hstar H) (SeedAction.Space H V₃ V₁))
    (hρ : SeedAction.IsConjugation H V₃ V₁ ρ) (hseed : V₃ = ⁅V₃, X⁆) :
    subspaceCommutator ρ ⊤ (Source.starImage H X) = ⊤ := by
  let f : X →* Source.Hstar H := (QuotientGroup.mk' (pCore 2 H)).comp (inclusion hXH)
  have hf : f.range = Source.starImage H X := by
    ext x
    constructor
    · rintro ⟨y,rfl⟩
      exact ⟨⟨y.val,hXH y.property⟩,y.property,rfl⟩
    · rintro ⟨y,hy,rfl⟩
      exact ⟨⟨y.val,hy⟩,rfl⟩
  have hXU : X ≤ normalizer (Source.UH H V₃ : Set G) :=
    hXH.trans (le_normalizer_conjugateSpanBy V₃ H)
  have hgen : ⁅X, Source.UH H V₃⁆ = Source.UH H V₃ := by
    rw [commutator_comm]
    exact (conjugateSpanBy_eq_commutator_of_seed V₃ H X X hXH
      (le_normalizer_of_normal_subgroupOf hXH) le_rfl hseed).symm
  rw [← hf]
  exact commutator_eq_top_of_conjugation ρ (Source.UH H V₃) X hXU f
    (QuotientGroup.mk' (V₁.subgroupOf (Source.UH H V₃)))
    (QuotientGroup.mk'_surjective _) (fun x u => hρ ⟨x.val,hXH x.property⟩ u) hgen

end CFSG.Quasithin.Chapter13.Section08.ComponentSieve.FieldComponents.HigherFieldReduction.ExternalModules.Structure

namespace CFSG.Quasithin.Chapter13.Section08.ComponentSieve.FieldComponents.HigherFieldReduction.ExternalModules.Structure
variable {D V : Type*} [Group D] [AddCommGroup V] [Module (ZMod 2) V]
variable (ρ : Representation (ZMod 2) D V) (K X : Subgroup D)
  (s : Equiv.Perm (Fin 3) →* D)
  (hs : s.range ≤ centralizer (K : Set D))
  (hX : (alternatingGroup (Fin 3)).map s = X)
  (hgen : subspaceCommutator ρ ⊤ X = ⊤)

include hs in
/-- The two actions commute because both use the given ambient representation. -/
theorem component_symmetric_commute (k : K) (g : Equiv.Perm (Fin 3)) :
    Commute (K.subtype k) (s g) := hs ⟨g,rfl⟩ k.val k.property

include hX hgen in
/-- Cubic fixed points vanish on the actual module generated by cubic commutators. -/
theorem cubic_fixedFree : ∀ v, (ρ.comp s) InvertedCubicTensor.cubic v = v → v = 0 := by
  apply InvertedCubicTensor.ambient_fixedFree_of_commutator ρ s
  rwa [hX]

include hX hgen in
/-- The literal quotient map on a section preserves the absence of cubic fixed points. -/
theorem section_cubic_fixedFree (L N : Subrepresentation ρ) :
    ∀ v, ((sectionRepresentation ρ L N).comp s) InvertedCubicTensor.cubic v = v → v = 0 := by
  have hn : ∀ v, (N.toRepresentation.comp s) InvertedCubicTensor.cubic v = v → v = 0 :=
    InvertedCubicTensor.fixedFree_of_injective (ρ.comp s) (N.toRepresentation.comp s)
      N.toSubmodule.subtype N.toSubmodule.subtype_injective (fun _ => rfl)
      (cubic_fixedFree ρ X s hX hgen)
  exact InvertedCubicTensor.fixedFree_of_surjective (N.toRepresentation.comp s)
    ((sectionRepresentation ρ L N).comp s) (sectionLower ρ L N).toSubmodule.mkQ
    (sectionLower ρ L N).toSubmodule.mkQ_surjective (fun _ => rfl) hn

/-- The component representation on the inverter-fixed multiplicity space
of a literal section of the original ambient representation. -/
noncomputable def sectionMultiplicity (L N : Subrepresentation ρ) :=
  InvertedCubicTensor.multiplicity ((sectionRepresentation ρ L N).comp s)
    ((sectionRepresentation ρ L N).comp K.subtype)
    (InvertedCubicTensor.ambient_commute (sectionRepresentation ρ L N) K.subtype s
      (component_symmetric_commute K s hs))

/-- An actual equivariant tensor map on every invariant section, in particular
on every noncentral chief section; no FF classification is used. -/
noncomputable def sectionTensorEquiv (L N : Subrepresentation ρ) :
    InvertedCubicTensor.multiplicitySpace ((sectionRepresentation ρ L N).comp s) ⊗[ZMod 2]
      BinaryPermutation.core (Fin 3) ≃ₗ[ZMod 2]
      (N.toSubmodule ⧸ (sectionLower ρ L N).toSubmodule) :=
  InvertedCubicTensor.tensorEquiv ((sectionRepresentation ρ L N).comp s)
    (section_cubic_fixedFree ρ X s hX hgen L N)

/-- Restriction of the literal section to K is two isomorphic copies of the
constructed multiplicity space. -/
noncomputable def sectionPairEquiv (L N : Subrepresentation ρ) :
    (InvertedCubicTensor.multiplicitySpace ((sectionRepresentation ρ L N).comp s) ×
      InvertedCubicTensor.multiplicitySpace ((sectionRepresentation ρ L N).comp s)) ≃ₗ[ZMod 2]
      (N.toSubmodule ⧸ (sectionLower ρ L N).toSubmodule) :=
  InvertedCubicTensor.pairEquiv ((sectionRepresentation ρ L N).comp s)
    (section_cubic_fixedFree ρ X s hX hgen L N)

theorem sectionPairEquiv_equivariant (L N : Subrepresentation ρ) (k : K)
    (x : InvertedCubicTensor.multiplicitySpace ((sectionRepresentation ρ L N).comp s) ×
      InvertedCubicTensor.multiplicitySpace ((sectionRepresentation ρ L N).comp s)) :
    sectionPairEquiv ρ X s hX hgen L N
      (sectionMultiplicity ρ K s hs L N k x.1, sectionMultiplicity ρ K s hs L N k x.2) =
        sectionRepresentation ρ L N k.val (sectionPairEquiv ρ X s hX hgen L N x) :=
  InvertedCubicTensor.pairEquiv_equivariant _ _ _ _ _ _

theorem sectionTensorEquiv_equivariant (L N : Subrepresentation ρ) (k : K)
    (g : Equiv.Perm (Fin 3))
    (z : InvertedCubicTensor.multiplicitySpace ((sectionRepresentation ρ L N).comp s) ⊗[ZMod 2]
      BinaryPermutation.core (Fin 3)) :
    sectionTensorEquiv ρ X s hX hgen L N
      (InvertedCubicTensor.tensorRepresentation ((sectionRepresentation ρ L N).comp s)
        ((sectionRepresentation ρ L N).comp K.subtype)
        (InvertedCubicTensor.ambient_commute (sectionRepresentation ρ L N) K.subtype s
          (component_symmetric_commute K s hs)) (k,g) z) =
      sectionRepresentation ρ L N (k.val * s g) (sectionTensorEquiv ρ X s hX hgen L N z) :=
  InvertedCubicTensor.ambient_tensorEquiv_equivariant (sectionRepresentation ρ L N) K.subtype s
    (component_symmetric_commute K s hs) (section_cubic_fixedFree ρ X s hX hgen L N) k g z

end CFSG.Quasithin.Chapter13.Section08.ComponentSieve.FieldComponents.HigherFieldReduction.ExternalModules.Structure

end
