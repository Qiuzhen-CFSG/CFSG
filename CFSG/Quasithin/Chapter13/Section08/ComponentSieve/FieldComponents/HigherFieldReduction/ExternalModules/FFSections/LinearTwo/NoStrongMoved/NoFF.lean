module
public import CFSG.Quasithin.Chapter13.Section08.ComponentSieve.FieldComponents.HigherFieldReduction.ExternalModules.FFSections.LinearTwo.NoStrongMoved.Cubic
public import CFSG.Quasithin.Chapter13.Section08.ComponentSieve.FieldComponents.HigherFieldReduction.ExternalModules.FFSections.SectionCoordinates
/-!
# Excluding the two-FF branch

A faithful H-module generated by K-commutators and by the normal cubic X
cannot be FF. A quadratic minimal best offender moving X has rank one and
fixes half the module; the commuting S₃ coordinates make the dimension
larger than two. If it centralizes X, the full B.1.5(3) implication fixes an
Irr⁺ constituent. The generated actor KA has trivial two-core by the
coprime common-centralizer calculation, and F*(KA) is exactly K. Its
faithful action on that constituent is not strong by the genuine PSL₂
reduction. Equality of codimensions forces KA to fix the quotient by the
constituent. Full K-commutator generation then makes it the whole module,
contradicting the cubic pair decomposition.

Thus non-FF is a proved conclusion, with no assumption on the desired
moved-space equality. Source: Aschbacher–Smith, 13.8.20(a), p.954,
B.1.5(3), B.4.2, and F.9.18(6), manuscript of 1 March 2004.
-/

@[expose] public noncomputable section
open Subgroup Representation Representation.BinaryOffender Theory.GroupTheory InvertedCubicTensor
open scoped MatrixGroups
open CFSG.Quasithin.Chapter13.Section08.Components.Swapped.LinearTwo.ModuleAlternatives.F918Sections.NoStrong
open CFSG.Quasithin.Chapter13.Section08.Components.Swapped.LinearTwo.ModuleAlternatives.F918Sections.NoStrong.IrreducibleReduction
namespace CFSG.Quasithin.Chapter13.Section08.ComponentSieve.FieldComponents.HigherFieldReduction.ExternalModules.FFSections.LinearTwo.NoStrongMoved
universe u v w
variable {D : Type u} [Group D] [Finite D] (K X : Subgroup D) [K.Normal]
private theorem binary_line_fixed {E V : Type*} [Group E] [AddCommGroup V]
    [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V]
    (ρ : Representation (ZMod 2) E V) (hd : Module.finrank (ZMod 2) V ≤ 1)
    (g : E) (v : V) : ρ g v = v := by
  by_cases hz : Module.finrank (ZMod 2) V = 0
  · let : Subsingleton V := Module.finrank_zero_iff.mp hz
    exact Subsingleton.elim _ _
  have hd1 : Module.finrank (ZMod 2) V = 1 := by omega
  by_cases hv : v = 0
  · simp [hv]
  obtain ⟨a, ha⟩ := exists_smul_eq_of_finrank_eq_one hd1 hv (ρ g v)
  have han : a ≠ 0 := by
    intro he
    rw [he, zero_smul] at ha
    have hh := congrArg (ρ g⁻¹) ha
    simp only [map_zero, ← Module.End.mul_apply, ← map_mul, inv_mul_cancel,
      map_one, Module.End.one_apply] at hh
    exact hv hh.symm
  have ha1 : a = 1 := by
    have h : ∀ a : ZMod 2, a ≠ 0 → a = 1 := by decide
    exact h a han
  simpa only [ha1, one_smul] using ha.symm

omit [Finite D] [K.Normal] in
theorem cubic_dimension_gt_two
    {V : Type v} [AddCommGroup V] [Module (ZMod 2) V] [Finite V]
    (ρ : Representation (ZMod 2) D V)
    (s : S₃ →* D) (hs : ∀ (k : K) g, Commute (k : D) (s g))
    (hf : ∀ v, ρ (s cubic) v = v → v = 0)
    (hn : ¬ ∀ k ∈ K, ∀ v, ρ k v = v) : 2 < Module.finrank (ZMod 2) V := by
  by_contra hd
  have hdim := (pairEquiv (ρ.comp s) hf).finrank_eq
  rw [Module.finrank_prod] at hdim
  change Module.finrank (ZMod 2) (multiplicitySpace (ρ.comp s)) +
    Module.finrank (ZMod 2) (multiplicitySpace (ρ.comp s)) = Module.finrank (ZMod 2) V at hdim
  have hm : Module.finrank (ZMod 2) (multiplicitySpace (ρ.comp s)) ≤ 1 := by omega
  let μ := multiplicity (ρ.comp s) (ρ.comp K.subtype) (ambient_commute ρ K.subtype s hs)
  apply hn
  intro k hk v
  obtain ⟨⟨a,b⟩,rfl⟩ := (pairEquiv (ρ.comp s) hf).surjective v
  have h := pairEquiv_equivariant (ρ.comp s) (ρ.comp K.subtype)
    (ambient_commute ρ K.subtype s hs) hf ⟨k,hk⟩ (a,b)
  change pairEquiv (ρ.comp s) hf (μ ⟨k,hk⟩ a, μ ⟨k,hk⟩ b) = _ at h
  rw [binary_line_fixed μ hm, binary_line_fixed μ hm] at h
  exact h.symm

omit [K.Normal] in
theorem quasisimple_stabilization_hypotheses [IsQuasisimple K] :
    pResidual 2 K = ⊤ ∧ HasCentralPChiefFactors 2 K := by
  constructor
  · apply (pResidual_eq_top_iff 2 K).mpr
    intro N hN hp
    let := hN
    have ht : Subsingleton (K ⧸ N) := by
      by_contra! hn
      exact Group.IsPerfect.not_isNilpotent (K ⧸ N) hp.isNilpotent
    apply top_unique
    intro k _
    exact (QuotientGroup.eq_one_iff k).mp (Subsingleton.elim _ _)
  · exact hasCentralTwoChiefFactors_of_odd_normal_quasisimple_quotient
      (⊥ : Subgroup K) (by simp) (IsQuasisimple.of_mulEquiv QuotientGroup.quotientBot.symm)

theorem not_ff_cubic_full {𝒦 : GroupClass.{u}} (hB42 : FullB42.{u,v} 𝒦)
    (hInv : FullIrrInvariance.{u,v})
    {F : Type w} [Field F] [Finite F] [CharP F 2]
    [IsQuasisimple K] [X.Normal] (e : K ≃* PSL(2,F))
    (hS : IsSQTK 𝒦 D) (hx : Nat.card X = 3)
    (hc : centralizer (K : Set D) ⊓ centralizer (X : Set D) ≤ X)
    (hKX : K ≤ centralizer (X : Set D))
    {V : Type v} [AddCommGroup V] [Module (ZMod 2) V] [Finite V]
    (ρ : Representation (ZMod 2) D V) (hf : Function.Injective ρ)
    (s : S₃ →* D) (hs : ∀ (k : K) g, Commute (k : D) (s g))
    (hmark : (alternatingGroup (Fin 3)).map s = X)
    (hg : subspaceCommutator ρ ⊤ X = ⊤)
    (hn : ¬ ∀ k ∈ K, ∀ v, ρ k v = v)
    (hfull : subspaceCommutator ρ ⊤ K = ⊤) : ¬ IsFFModule ρ := by
  rintro ⟨B,hB⟩
  obtain ⟨A, _, hA, hq, _⟩ := hB.exists_quadratic_minimalBestOffender ρ
  have hoff := (hA.1.isOffender ρ).2
  have hfree := ambient_fixedFree_of_commutator ρ s (by rw [hmark]; exact hg)
  by_cases hAX : A ≤ centralizer (X : Set D)
  swap
  · obtain ⟨hr,hd⟩ := normalThree_quadratic_rank_fixedCodim ρ hf X inferInstance hx hg A hA.1.1 hq hAX
    have hdim := cubic_dimension_gt_two K ρ s hs hfree hn
    omega
  have hKA := component_commutator_of_centralizes_cubic K X hx hc hA.1.1 hAX
  have hKne : K ≠ ⊥ := by intro he; apply hn; simp [he]
  obtain ⟨I,hI⟩ := exists_isIrrPlus_of_faithful ρ hf K hKne
  obtain ⟨hr,hchief⟩ := quasisimple_stabilization_hypotheses K
  have hAI := hInv D V ρ hf A K hA hKne hr hKA hchief I hI
  let E := K ⊔ A
  let L := K.subgroupOf E
  let A₀ := A.subgroupOf E
  let τ := ρ.comp E.subtype
  let : IsQuasisimple L := IsQuasisimple.of_mulEquiv
    (subgroupOfEquivOfLe (show K ≤ E from le_sup_left)).symm
  have hfit : generalizedFitting E = L := generated_fitting K X hx hc hKX hA.1.1 hAX
  let eL : L ≃* PSL(2,F) := (subgroupOfEquivOfLe le_sup_left).trans e
  have hcent : centralizer (L : Set E) = ⊥ := selfcentral_of_fitting L hfit (psl_center_bot L eL)
  have hEI : E ≤ subspaceStabilizer ρ I := sup_le hI.choose hAI
  let U : Subrepresentation τ := ⟨I, fun g _ hv => (hEI g.property _).2 hv⟩
  have hnU : ¬ ∀ l ∈ L, ∀ v, U.toRepresentation l v = v := by
    intro ht
    apply hI.not_le_fixedSpace ρ
    intro v hv k
    exact congrArg Subtype.val (ht ⟨k,mem_sup_left k.property⟩ k.property ⟨v,hv⟩)
  have hkU : (actionHom U.toRepresentation).ker = ⊥ := by
    apply bot_unique
    rw [← hcent]
    exact CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.GenerationOne.RepresentationReduction.SourceRestrictions.action_kernel_le_centralizer U.toRepresentation L
      (CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.GenerationOne.RepresentationReduction.SourceRestrictions.central_kernel_of_quasisimple U.toRepresentation L hnU)
  have hfU : Function.Injective U.toRepresentation := by
    intro a b hab
    apply (MonoidHom.ker_eq_bot_iff (actionHom U.toRepresentation)).mp hkU
    exact imageRepresentation_injective _ hab
  have hnsU : ¬ IsStrongFFModule U.toRepresentation := by
    intro hstrong
    exact preaction_impossible hB42 hInv {
      Actor := E
      Space := I
      representation := U.toRepresentation
      sqtk := hS.subgroup E
      faithful := hfU
      strong := hstrong
      quasisimple := by rw [hfit]; infer_instance
      componentEquiv := (MulEquiv.subgroupCongr hfit).trans eL }
  have hA₀ := hA.1.subgroupOf ρ (show A ≤ E from le_sup_right)
  have hrA : rank A₀ = rank A := by
    rw [← rank_map_injective E.subtype E.subtype_injective A₀]
    exact congrArg rank (map_subgroupOf_eq_of_le (show A ≤ E from le_sup_right))
  have hcod : fixedCodim τ A₀ = fixedCodim ρ A := by
    unfold fixedCodim
    rw [fixedSpace_comp_map, map_subgroupOf_eq_of_le (show A ≤ E from le_sup_right)]
  have hlow : rank A₀ ≤ fixedCodim U.toRepresentation A₀ :=
    Nat.le_of_not_gt (fun hlt => hnsU ⟨A₀,hA₀.1,hlt⟩)
  have hle := fixedCodim_subrepresentation_le τ U A₀
  have heq : fixedCodim U.toRepresentation A₀ = fixedCodim τ A₀ := by omega
  have hsup := (fixedCodim_subrepresentation_eq_iff τ U A₀).mp heq
  have hfixA := quotient_trivial_of_sup_fixedSpace τ U A₀ hsup
  have hcomm : ⁅L,A₀⁆ = L := by
    apply Subgroup.map_injective E.subtype_injective
    rw [Subgroup.map_commutator]
    change ⁅(K.subgroupOf E).map E.subtype, (A.subgroupOf E).map E.subtype⁆ = (K.subgroupOf E).map E.subtype
    rw [map_subgroupOf_eq_of_le (show K ≤ E from le_sup_left),
      map_subgroupOf_eq_of_le (show A ≤ E from le_sup_right), hKA]
  have hfixK := trivial_sup_of_commutator_eq U.quotientRepresentation L A₀ hcomm hfixA
  have hKI : subspaceCommutator ρ ⊤ K ≤ I := by
    apply Submodule.span_le.mpr
    rintro _ ⟨k,hk,v,_,rfl⟩
    exact (Submodule.Quotient.eq I).mp (hfixK ⟨k,mem_sup_left hk⟩ (mem_sup_right hk) (I.mkQ v))
  have hItop : I = ⊤ := top_unique (hfull ▸ hKI)
  exact irrPlus_not_invariant ρ s K hs (by rw [hmark]; exact hg) I hI
    (by rw [hItop]; exact le_subspaceStabilizer ρ ⊤ (by simp))

end CFSG.Quasithin.Chapter13.Section08.ComponentSieve.FieldComponents.HigherFieldReduction.ExternalModules.FFSections.LinearTwo.NoStrongMoved
