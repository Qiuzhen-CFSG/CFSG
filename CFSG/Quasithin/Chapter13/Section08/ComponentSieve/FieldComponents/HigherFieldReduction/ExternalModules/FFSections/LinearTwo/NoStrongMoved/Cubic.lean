module
public import Theory.GroupTheory.SmallFittingResidual
public import Theory.Representation.BinaryOffender.NormalThree
public import Theory.Representation.BinaryOffender.FaithfulRankOne
public import CFSG.Quasithin.Chapter13.Section08.ComponentSieve.FieldComponents.HigherFieldReduction.ExternalModules.FFSections.LinearTwo.NoStrongMoved.Irreducible

/-!
# Cubic actors and faithful external sections

The small Fitting bound makes the common centralizer of K and X lie in X.
A quadratic offender moving the normal cubic group has rank one. Every
remaining strong offender generates K by commutation, so the faithful
irreducible PSL₂ reduction excludes it. For a subgroup generated by K and
an offender centralizing X, the two-core is proved trivial using its own
normality and coprime orders, and its generalized Fitting subgroup is K.

A noncentral K-section with fixed-point-free cubic action is faithful on
H: its kernel centralizes K, meets X trivially, and therefore centralizes X
and vanishes. This proves section faithfulness without an assumption about
the two-core of KT.

Source: Aschbacher–Smith, B.1.5, B.4.2, F.9.18(6), and 13.8.20(a),
printed pp.69–70, 86, 325–326 and 954, manuscript of 1 March 2004.
-/

@[expose] public noncomputable section
open Subgroup Representation Representation.BinaryOffender Theory.GroupTheory
open scoped MatrixGroups
open CFSG.Quasithin.Chapter13.Section08.Components.Swapped.LinearTwo.ModuleAlternatives.F918Sections.NoStrong
namespace CFSG.Quasithin.Chapter13.Section08.ComponentSieve.FieldComponents.HigherFieldReduction.ExternalModules.FFSections.LinearTwo.NoStrongMoved
universe u v w
variable {D : Type u} [Group D] [Finite D] (K X : Subgroup D) [K.Normal]

theorem common_centralizer_le (hC : Group.IsSolvable (centralizer (K : Set D)))
    (hF : fittingSubgroup D ≤ X) :
    centralizer (K : Set D) ⊓ centralizer (X : Set D) ≤ X := by
  let C := centralizer (K : Set D)
  have hFC : fittingSubgroupOf C ≤ fittingSubgroup D :=
    le_sSup ⟨fittingSubgroupOf_normal C inferInstance, fittingSubgroupOf_isNilpotent C⟩
  intro c hc
  apply hF
  apply hFC
  refine ⟨⟨c, hc.1⟩, ?_, rfl⟩
  apply centralizer_fittingSubgroup_le_fittingSubgroup_of_solvable hC
  intro b hb
  exact Subtype.ext (hc.2 b (hF (hFC ⟨b,hb,rfl⟩)))

omit [Finite D] in
theorem elementary_cubic_eq_one {A : Subgroup D} (hA : IsElementaryTwo A)
    (hx : Nat.card X = 3) {a : D} (ha : a ∈ A) (haX : a ∈ X) : a = 1 := by
  let : IsElementaryAbelian 2 A := hA.2
  have h2 : a^2 = 1 := elemPow_eq_one_of_isElementaryAbelian a ha
  have h3 : a^3 = 1 := congrArg Subtype.val
    (show (⟨a,haX⟩ : X)^3 = 1 by simpa only [hx] using pow_card_eq_one' (x := (⟨a,haX⟩ : X)))
  simpa only [pow_succ, h2, one_mul] using h3

omit [Finite D] in
theorem component_commutator_of_centralizes_cubic [IsQuasisimple K]
    (hx : Nat.card X = 3)
    (hc : centralizer (K : Set D) ⊓ centralizer (X : Set D) ≤ X)
    {A : Subgroup D} (hA : IsElementaryTwo A)
    (haX : A ≤ centralizer (X : Set D)) : ⁅K,A⁆ = K := by
  have hk : IsComponent D K := ⟨(inferInstance : K.Normal).isSubnormal, inferInstance⟩
  rcases hk.commutator_dichotomy A with hz | he
  · exfalso
    apply hA.1
    apply bot_unique
    intro a ha
    apply mem_bot.mpr
    exact elementary_cubic_eq_one X hA hx ha
      (hc ⟨commutator_eq_bot_iff_le_centralizer.mp ((commutator_comm A K).trans hz) ha, haX ha⟩)
  · simpa only [MulEquiv.toMonoidHom_eq_coe, Subgroup.Normal.map_conj_eq, iSup_const] using he

theorem no_strong_cubic {𝒦 : GroupClass.{u}} (hB42 : FullB42.{u,v} 𝒦)
    (hInv : FullIrrInvariance.{u,v})
    {F : Type w} [Field F] [Finite F] [CharP F 2]
    [IsQuasisimple K] [X.Normal] (e : K ≃* PSL(2,F))
    (hS : IsSQTK 𝒦 D) (hx : Nat.card X = 3)
    (hc : centralizer (K : Set D) ⊓ centralizer (X : Set D) ≤ X)
    {V : Type v} [AddCommGroup V] [Module (ZMod 2) V] [Finite V]
    (ρ : Representation (ZMod 2) D V) (hf : Function.Injective ρ)
    (hg : subspaceCommutator ρ ⊤ X = ⊤) : ¬ IsStrongFFModule ρ := by
  rintro ⟨B,hB⟩
  obtain ⟨A, _, hA, hq, hs⟩ := hB.exists_quadratic_minimalBestOffender ρ
  by_cases hAX : A ≤ centralizer (X : Set D)
  · exact not_strong_of_component_commutator hB42 hInv ρ hf hS K A e
      (component_commutator_of_centralizes_cubic K X hx hc hA.1.1 hAX) hA hs
  · have hr := (normalThree_quadratic_rank_fixedCodim ρ hf X inferInstance hx hg A hA.1.1 hq hAX).1
    have hp := fixedCodim_pos_of_faithful ρ hf hA.1.1.1
    have ht := hs.2
    omega

omit [Finite D] [K.Normal] in
theorem psl_center_bot {F : Type w} [Field F] [CharP F 2]
    (e : K ≃* PSL(2,F)) : center K = ⊥ := by
  apply _root_.eq_bot_iff.mpr
  intro k hk
  have h := (centerCongr e ⟨k,hk⟩).property
  change e k ∈ center PSL(2,F) at h
  rw [Atlas.RankOneFieldAutomorphisms.psl_center_eq_bot, mem_bot] at h
  exact mem_bot.mpr (e.injective (h.trans e.map_one.symm))

theorem centralizing_generated_core [IsQuasisimple K]
    (hx : Nat.card X = 3)
    (hc : centralizer (K : Set D) ⊓ centralizer (X : Set D) ≤ X)
    (hKX : K ≤ centralizer (X : Set D))
    {A : Subgroup D} (hAX : A ≤ centralizer (X : Set D)) :
    pCore 2 (K ⊔ A : Subgroup D) = ⊥ := by
  let E := K ⊔ A
  let L := K.subgroupOf E
  let : IsQuasisimple L := IsQuasisimple.of_mulEquiv
    (subgroupOfEquivOfLe (show K ≤ E from le_sup_left)).symm
  have hcQ := CFSG.Quasithin.ChapterB.irreducibleReduction_core_centralizes L
  have hmap : (pCore 2 E).map E.subtype ≤ X := by
    rintro g ⟨q,hq,rfl⟩
    apply hc
    refine ⟨?_, (sup_le hKX hAX) q.property⟩
    intro k hk
    exact congrArg Subtype.val (hcQ hq ⟨k,mem_sup_left hk⟩ hk)
  have hpX : IsPGroup 3 X := IsPGroup.of_card (n := 1) (by simpa using hx)
  have hd := (pCore_isPGroup (p := 2) (G := E)).map E.subtype |>.disjoint_of_coprime hpX (by decide)
  have hb := hd.eq_bot_of_le hmap
  exact (Subgroup.map_eq_bot_iff_of_injective _ E.subtype_injective).mp hb

theorem generated_fitting [IsQuasisimple K]
    (hx : Nat.card X = 3)
    (hc : centralizer (K : Set D) ⊓ centralizer (X : Set D) ≤ X)
    (hKX : K ≤ centralizer (X : Set D))
    {A : Subgroup D} (hA : IsElementaryTwo A)
    (hAX : A ≤ centralizer (X : Set D)) :
    generalizedFitting (K ⊔ A : Subgroup D) = K.subgroupOf (K ⊔ A) := by
  let E := K ⊔ A
  let L := K.subgroupOf E
  let B := A.subgroupOf E
  let : IsQuasisimple L := IsQuasisimple.of_mulEquiv
    (subgroupOfEquivOfLe (show K ≤ E from le_sup_left)).symm
  let : IsElementaryAbelian 2 A := hA.2
  have hp : IsPGroup 2 B := (IsElementaryAbelian.isPGroup 2 A).comap_subtype
  have hg : B ⊔ L = ⊤ := by
    apply Subgroup.map_injective E.subtype_injective
    rw [Subgroup.map_sup]
    change (A.subgroupOf E).map E.subtype ⊔ (K.subgroupOf E).map E.subtype =
      (⊤ : Subgroup E).map E.subtype
    rw [map_subgroupOf_eq_of_le (show A ≤ E from le_sup_right),
      map_subgroupOf_eq_of_le (show K ≤ E from le_sup_left), sup_comm]
    exact E.range_subtype.symm.trans E.subtype.range_eq_map
  exact generalizedFitting_eq_of_quasisimple_two_quotient L
    (quotient_isPGroup_of_sup_eq_top B L hp hg)
    (centralizing_generated_core K X hx hc hKX hAX)

theorem selfcentral_of_fitting {E : Type*} [Group E] [Finite E]
    (L : Subgroup E) (hfit : generalizedFitting E = L) (hz : center L = ⊥) :
    centralizer (L : Set E) = ⊥ := by
  have hle : centralizer (L : Set E) ≤ L :=
    hfit ▸ CFSG.Quasithin.ChapterB.QuasisimpleSections.centralizer_generalizedFitting_le
  apply _root_.eq_bot_iff.mpr
  intro g hg
  have hz' : (⟨g,hle hg⟩ : L) ∈ center L := by
    rw [mem_center_iff]
    intro l
    exact Subtype.ext (hg l l.property)
  exact mem_bot.mpr (congrArg (fun a : L => (a : E)) (mem_bot.mp (hz ▸ hz')))


omit [Finite D] in
theorem faithful_of_cubic [X.Normal] [IsQuasisimple K]
    (hx : Nat.card X = 3)
    (hc : centralizer (K : Set D) ⊓ centralizer (X : Set D) ≤ X)
    {V : Type v} [AddCommGroup V] [Module (ZMod 2) V]
    (ρ : Representation (ZMod 2) D V)
    (hn : ¬ ∀ k ∈ K, ∀ v, ρ k v = v)
    (x : D) (hxX : x ∈ X) (hf : ∀ v, ρ x v = v → v = 0) :
    Function.Injective ρ := by
  let N := (actionHom ρ).ker
  have hNK :=
    CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.GenerationOne.RepresentationReduction.SourceRestrictions.action_kernel_le_centralizer ρ K
      (CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.GenerationOne.RepresentationReduction.SourceRestrictions.central_kernel_of_quasisimple ρ K hn)
  let : Fact (Nat.card X).Prime := ⟨hx ▸ Nat.prime_three⟩
  have hNX : N ⊓ X = ⊥ := by
    rcases (N.subgroupOf X).eq_bot_or_eq_top_of_prime_card with hb | ht
    · apply _root_.eq_bot_iff.mpr
      intro g hg
      have h : (⟨g,hg.2⟩ : X) ∈ N.subgroupOf X := hg.1
      exact mem_bot.mpr (congrArg (fun a : X => (a : D)) (mem_bot.mp (hb ▸ h)))
    · exfalso
      apply hn
      have hxn : x ∈ N := by
        have h : (⟨x,hxX⟩ : X) ∈ N.subgroupOf X := by rw [ht]; trivial
        exact h
      have hz : ∀ v : V, v = 0 := fun v => hf v ((actionHom_eq_one_iff ρ x).mp hxn v)
      intro k _ v
      rw [hz v, map_zero]
  have hNC : N ≤ centralizer (X : Set D) :=
    commutator_eq_bot_iff_le_centralizer.mp (bot_unique (hNX ▸ commutator_le_inf N X))
  have hb : N = ⊥ := by
    apply _root_.eq_bot_iff.mpr
    intro n hn
    exact hNX ▸ (show n ∈ N ⊓ X from ⟨hn, hc ⟨hNK hn,hNC hn⟩⟩)
  have hi := (MonoidHom.ker_eq_bot_iff (actionHom ρ)).mp hb
  intro a b hab
  apply hi
  exact imageRepresentation_injective ρ hab

omit [Finite D] in
theorem full_of_fixedFree
    {V : Type v} [AddCommGroup V] [Module (ZMod 2) V] [Finite V]
    (ρ : Representation (ZMod 2) D V) (x : D) (hx : x ∈ X)
    (hf : ∀ v, ρ x v = v → v = 0) : subspaceCommutator ρ ⊤ X = ⊤ := by
  let f := ρ x - LinearMap.id
  have hi : Function.Injective f := (LinearMap.ker_eq_bot).mp (by
    apply _root_.eq_bot_iff.mpr
    intro v hv
    exact hf v (sub_eq_zero.mp hv))
  have hs := (LinearMap.injective_iff_surjective).mp hi
  apply top_unique
  intro v _
  obtain ⟨w,rfl⟩ := hs v
  exact Submodule.subset_span ⟨x,hx,w,Submodule.mem_top,rfl⟩

end CFSG.Quasithin.Chapter13.Section08.ComponentSieve.FieldComponents.HigherFieldReduction.ExternalModules.FFSections.LinearTwo.NoStrongMoved
