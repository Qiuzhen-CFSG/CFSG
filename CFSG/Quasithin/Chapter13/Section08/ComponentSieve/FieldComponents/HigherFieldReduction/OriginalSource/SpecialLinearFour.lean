/-!
# Original containment in the full SL₃(4) branch

The model Borel and the original torus-reduction Borel are the same subgroup:
both use the actual image of T intersected with K through H/O₂(H). The full
SL₃(4) Borel has elementary-nine two-core quotient and is generated by its
cubic elements. Its placement in M and theta(H intersect M)=L₁ therefore
put it in L₁. It is normalized by L₁ and carries the full possible three-part
of L₁/O₂(L₁); two-perfectness then forces L₁ into K.

This proves containment directly from the genuine source context without the
legacy B_C residual/index identities. Applying it to the original generation
and seed commutator gives H=KT and U_H=[U_H,K]. The final adapter transports
any field-four special-linear marking of K/O₂(K), retaining the scalar center.
The graph-module recognition and contradiction, other exceptional rows and
full field-source assembly remain with qt-d-138-fields-source.
Source: Aschbacher–Smith, 13.8.20(b), printed p.955, using 13.7.3(9), p.936,
and the full special-linear Borel on pp.954–955.
-/

public noncomputable section

namespace CFSG.Quasithin.Chapter13.Section08.ComponentSieve.FieldComponents.HigherFieldReduction.OriginalSource
open Subgroup Theory.GroupTheory Representation.SL3FourNaturalDual
open SourceCompletion TransvectionRecognition.Component.ModelExtension
open LinearThree.Geometry.CoveredProduct.ResidualPlacement
open ExceptionalFields.LinearThreeFour.AutomorphismModule
open ExceptionalFields.LinearThreeFour.AutomorphismModule.LocalAlternatives
open ExceptionalFields.Containment.Reduction
universe u
variable {G : Type u} [Group G] [Finite G]
  {T : Sylow 2 G} {L V V₁ V₂ V₃ M G₁ H K : Subgroup G}

/-- The SL₃(4) Borel marking is exactly the Borel from the original torus reduction. -/
theorem source_specialLinearThree_borel_eq
    [(Source.starImage H K).Normal]
    (eK : Source.starImage H K ≃* SL) (hKH : K ≤ H)
    (hT : Chapter1.IsSylowIn 2 (T : Subgroup G) H) :
    SourceMarking.sourceBorel H K T eK hKH hT = LocalBorel.borel H K T hKH hT := by
  have hS : (SourceMarking.sourceSylow H K T eK hT : Subgroup SL) =
      (LocalBorel.sourceSylow H K T hT : Subgroup (Source.starImage H K)).map eK.toMonoidHom := by
    rw [SourceMarking.sourceSylow_eq,LocalBorel.sourceSylow_eq]
    ext x
    rw [mem_map_equiv]
    rfl
  have hB : modelBorel H K eK (SourceMarking.sourceSylow H K T eK hT) =
      LocalBorel.borelStar H K T hT := by
    unfold modelBorel LocalBorel.borelStar
    change (normalizer ((SourceMarking.sourceSylow H K T eK hT : Subgroup SL) : Set SL)).map
      (sourceActor H K eK) = _
    rw [hS,←map_normalizer_eq_of_bijective _ eK.bijective,Subgroup.map_map]
    congr 1
    ext k
    simp [sourceActor]
  exact congrArg (fun B => borelResidual (borelLift H K hKH B)) hB

/-- The full elementary-nine torus forces containment of L₁ in the special
linear component. Only the true order-three closure identity is used. -/
theorem source_specialLinearThree_containment
    (c : FieldComponents.SourceContext T L V V₁ V₂ V₃ M G₁ H K)
    (eK : Source.starImage H K ≃* SL) : one L T V₁ ≤ K := by
  let : (K.subgroupOf H).Normal := c.component.normal
  let : (Source.starImage H K).Normal :=
    c.component.normal.map _ (QuotientGroup.mk'_surjective _)
  let m : TorusModels.Assembly.Model.{u,0} (Source.starImage H K) 2 false true :=
    .specialLinearThree F sl3Field_card eK
      (Matrix.PSL3.OuterSolvable.standard_eq_top_of_two_power_card F (by decide) sl3Field_card)
  let i := sourceInput c (by decide : 1 < 2) m
  obtain ⟨d⟩ : Nonempty (LocalBorel.CentralizingCalculation.SourceContext.{u,0}
      T H K L V V₁ V₂ V₃ M G₁ 2 false true) := by
    rcases local_quotient_alternatives c.localSetup with ⟨e,he⟩ | ⟨e,he⟩
    · obtain ⟨a⟩ := LocalFitting.ordinary_natural c.localSetup e he
      exact ⟨i.ordinarySourceContext a⟩
    · obtain ⟨a⟩ := local_covered_flag_model c.localSetup e he
      exact ⟨i.coveredSourceContext a (CoverFactorization.source_factorization a)⟩
  let B := SourceMarking.sourceBorel H K T eK d.component_le d.sylow_H
  have hBM : B ≤ M := by
    rw [show B = d.B from source_specialLinearThree_borel_eq eK d.component_le d.sylow_H]
    exact d.borel_in_M
  have hBL : B ≤ one L T V₁ := SourceMarking.sourceBorel_le_one
    H K T eK d.component_le d.sylow_H L M V₁ hBM d.theta
  have hnorm : one L T V₁ ≤ normalizer (B : Set G) := by
    rw [show B = d.B from source_specialLinearThree_borel_eq eK d.component_le d.sylow_H]
    exact le_sup_left.trans d.borel_normalized
  have h9 : 9 ∣ Nat.card B := by
    have he := Nat.card_congr (SourceMarking.sourceBorelQuotientEquiv
      H K T eK d.component_le d.sylow_H).toEquiv
    have hc : Nat.card (B ⧸ pCore 2 B) = 9 := by
      rw [he,Nat.card_prod,Nat.card_units,sl3Field_card]
      norm_num
    exact hc ▸ card_quotient_dvd_card (pCore 2 B)
  have hval : 2 ≤ (Nat.card B).factorization 3 :=
    (Nat.prime_three.pow_dvd_iff_le_factorization Nat.card_pos.ne').mp h9
  by_contra hout
  have hbK : B ≤ K := SourceMarking.sourceBorel_le_K H K T eK d.component_le d.sylow_H
  have hY := (map_subtype_le (primeToResidual 3 B)).trans hBL
  have hp : IsPPerfect 2 (one L T V₁) := isPPerfect_embedded_pResidual 2 _
  rcases local_quotient_alternatives c.localSetup with ⟨e,he⟩ | ⟨e,he⟩
  · have hq := LocalFitting.ordinary_core_card c.localSetup ⟨e⟩
    have hh := borel_three_valuation_lt_of_outside B K (one L T V₁) hbK hout hY hnorm hp 1
      (by simpa only [pow_one] using hq)
    omega
  · obtain ⟨a⟩ := local_covered_flag_model c.localSetup e he
    have hfactor := CoverFactorization.source_factorization a
    have hq := LocalAction.one_quotient_card L (T : Subgroup G) V₁ a.normalizes_L
      a.line_stable hfactor a.zero_core_card (a.plus_core_card hfactor)
    have hh := borel_three_valuation_lt_of_outside B K (one L T V₁) hbK hout hY hnorm hp 2 hq
    omega

/-- Apply the containment to the actual source generation and moved module. -/
theorem source_specialLinearThree_reduction
    (c : FieldComponents.SourceContext T L V V₁ V₂ V₃ M G₁ H K)
    (eK : Source.starImage H K ≃* SL) :
    one L T V₁ ≤ K ∧ H = K ⊔ (T : Subgroup G) ∧
      Source.UH H V₃ = ⁅Source.UH H V₃,K⁆ := by
  have hLK := source_specialLinearThree_containment c eK
  let : (K.subgroupOf H).Normal := c.component.normal
  have hseed := (Section07.ModelExclusions.seed_commutator_point_residual
    (localNaturalSetup c.localSetup)).symm
  exact ⟨hLK,ExceptionalFields.reduction_of_containment H K (one L T V₁)
    T (one L T V₁) V₃ c.component.generated.symm hLK le_rfl hseed⟩


/-- The source reduction from any field-four special-linear marking of the
intrinsic component quotient, with the full scalar center preserved. -/
theorem source_specialLinearThree_four_reduction
    (c : FieldComponents.SourceContext T L V V₁ V₂ V₃ M G₁ H K)
    (hm : Chapter1.Section02.LocalModels.IsSL (K ⧸ pCore 2 K) 3 4) :
    one L T V₁ ≤ K ∧ H = K ⊔ (T : Subgroup G) ∧
      Source.UH H V₃ = ⁅Source.UH H V₃,K⁆ := by
  obtain ⟨Q,hQ,hfin,hcard,⟨e⟩⟩ := hm
  let := Fintype.ofFinite Q
  let := Fintype.ofFinite F
  let a : Q ≃+* F := FiniteField.ringEquivOfCardEq (by
    rw [←Nat.card_eq_fintype_card,←Nat.card_eq_fintype_card,hcard,sl3Field_card]
    norm_num)
  have hKH : K ≤ H := (le_sup_left.trans le_sup_left).trans_eq c.component.generated
  let eK := (Components.componentStarEquiv H K hKH c.component.component).symm.trans
    (e.trans (Atlas.fieldEquivSL 3 a))
  exact source_specialLinearThree_reduction c eK

end CFSG.Quasithin.Chapter13.Section08.ComponentSieve.FieldComponents.HigherFieldReduction.OriginalSource
