/-- The original overlap is the actual five-point stabilizer in the marked S₅
action. These coordinates apply to the literal coset module in 13.8.4(5). -/
theorem source_projectiveTwo_four_point_coordinates
    (c : FieldComponents.SourceContext T L V V₁ V₂ V₃ M G₁ H K)
    (hm : ClassicalGroup.IsPSL (Source.starImage H K) 2 4) :
    ∃ (eA : Source.starImage H K ≃* alternatingGroup (Fin 5))
      (eH : Source.Hstar H ≃* Equiv.Perm (Fin 5)),
      (∀ k : Source.starImage H K, eH k = eA k) ∧
      ∃ d : (Source.Hstar H ⧸ Source.starImage H (H ⊓ M)) ≃ Fin 5,
        ∀ h ω, d (h • ω) = eH h (d ω) := by
  let : (K.subgroupOf H).Normal := c.component.normal
  let : (Source.starImage H K).Normal :=
    c.component.normal.map _ (QuotientGroup.mk'_surjective _)
  obtain ⟨_,_,_,_,eA,eH,he⟩ := source_projectiveTwo_four_structure c hm
  have hKH : K ≤ H := (le_sup_left.trans le_sup_left).trans_eq c.component.generated
  have hTH : (T : Subgroup G) ≤ H := le_sup_right.trans c.component.local_overgroup.1.2
  have hTM : (T : Subgroup G) ≤ M := by
    rw [c.localSetup.local_normalizer]
    exact c.localSetup.normalizes_L
  obtain ⟨F,hF,hfin,hcard,⟨eK⟩⟩ := hm
  have hfield : HigherFieldAlternative (K ⧸ pCore 2 K) :=
    ⟨2,by decide,Or.inl ⟨F,hF,hfin,hcard,
      ⟨(Components.componentStarEquiv H K hKH c.component.component).trans eK⟩⟩⟩
  let : IsElementaryAbelian 2 (Source.UH H V₃) :=
    c.localSetup.uh_elementary c.component.local_overgroup
  have hF9 := c.f9 H c.component.local_overgroup
  let act := Comparison.conjugationAction (c.localSetup.line_le_uh H) hF9.plus_le_H
    (hF9.H_centralizes.trans (Subgroup.centralizer_le_normalizer _))
    hF9.commutator_UH_QH_le_point
  obtain ⟨_,hT,hBM,_,t,_,_,_,_,⟨_,houter⟩⟩ := source_borel_exceptional_linear c act hfield
  obtain ⟨S,hS⟩ := Reduction.exists_component_sylow_in_source H K hKH (T.subtype hTH)
  have hST : (S : Subgroup K).map K.subtype ≤ (T : Subgroup G) := by
    simpa only [Sylow.coe_subtype,map_subgroupOf_eq_of_le hTH] using hS
  have hP : Reduction.componentStarSylow H K hKH S = LocalBorel.sourceSylow H K T hT := by
    apply Sylow.ext
    apply map_injective (Source.starImage H K).subtype_injective
    exact (Reduction.componentStarSylow_source_intersection H K hKH S T hST).trans
      (LocalBorel.sourceSylow_image H K T hT).symm
  have hB₀ : Reduction.componentBorel H K hKH S = LocalBorel.borel₀ H K T hKH hT := by
    unfold Reduction.componentBorel Reduction.componentBorelImage
    rw [hP]
    rfl
  obtain ⟨hB₀H,hstar,U,hUT⟩ := Reduction.componentBorel_marking H K T hKH S hST
  have hB : (pResidual 2 (Reduction.componentBorel H K hKH S)).map
      (Reduction.componentBorel H K hKH S).subtype ≤ M := by
    change borelResidual (Reduction.componentBorel H K hKH S) ≤ M
    rw [hB₀]
    exact hBM
  have hcomm := (Section07.source_commutator_conclusions (localNaturalSetup c.localSetup)
    hF9 c.component.local_overgroup.2.1 c.noncentral_core).1
  refine ⟨eA,eH,he,?_⟩
  exact ExceptionalFields.Containment.linear_two_four_point_coordinates
    H K M T (Reduction.componentBorel H K hKH S) V V₃
    c.component.local_overgroup.2.2 hTH hTM c.localSetup.seed_le hcomm
    (source_overlap_normalizer c).symm hB₀H hB U hUT
    (Reduction.componentStarSylow H K hKH S) hstar eA eH he
    (QuotientGroup.mk' (pCore 2 H) ⟨t.val,hTH t.property.1⟩)
    ⟨⟨t.val,hTH t.property.1⟩,t.property.1,rfl⟩ houter

end CFSG.Quasithin.Chapter13.Section08.ComponentSieve.FieldComponents.HigherFieldReduction.OriginalSource
