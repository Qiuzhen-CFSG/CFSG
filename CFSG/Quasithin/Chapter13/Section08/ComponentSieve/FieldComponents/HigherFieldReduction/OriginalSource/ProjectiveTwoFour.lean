/-- The intrinsic component quotient gives the same containment, ordinary
local quotient, product and commutator conclusions. -/
theorem source_projectiveTwo_four_reduction
    (c : FieldComponents.SourceContext T L V V₁ V₂ V₃ M G₁ H K)
    (hm : ClassicalGroup.IsPSL (K ⧸ pCore 2 K) 2 4) :
    one L T V₁ ≤ K ∧
      Nonempty ((L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 6)) ∧
      H = K ⊔ (T : Subgroup G) ∧ Source.UH H V₃ = ⁅Source.UH H V₃,K⁆ ∧
      ∃ (eA : Source.starImage H K ≃* alternatingGroup (Fin 5))
        (eH : Source.Hstar H ≃* Equiv.Perm (Fin 5)),
        ∀ k : Source.starImage H K, eH k = eA k := by
  have hKH : K ≤ H := (le_sup_left.trans le_sup_left).trans_eq c.component.generated
  exact source_projectiveTwo_four_structure c
    (hm.of_mulEquiv (Components.componentStarEquiv H K hKH c.component.component).symm)

