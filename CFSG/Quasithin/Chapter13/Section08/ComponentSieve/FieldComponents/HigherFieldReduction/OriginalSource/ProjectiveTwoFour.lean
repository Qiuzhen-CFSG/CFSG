  [(Source.starImage H K).Normal]
  {F : Type} [Field F] [Finite F] [CharP F 2]

private def twoFourBorelEquiv (eK : Source.starImage H K ≃* PSL(2,F))
    (hT : Chapter1.IsSylowIn 2 (T : Subgroup G) H) :
    borelStar H K T hT ≃* Matrix.ProjectiveSpecialLinearGroup.OddBorel.borel F := by
  let S := LocalBorel.sourceSylow H K T hT
  let S' := S.mapSurjective (f := eK.toMonoidHom) eK.surjective
  let N := normalizer (S : Set (Source.starImage H K))
  have he : N.map eK.toMonoidHom = normalizer (S' : Set PSL(2,F)) :=
    map_normalizer_eq_of_bijective _ eK.bijective
  exact (equivMapOfInjective N (Source.starImage H K).subtype
    (Source.starImage H K).subtype_injective).symm.trans
      (((eK.subgroupMap N).trans (MulEquiv.subgroupCongr he)).trans
        (sylowNormalizerEquiv F S'))

/-- The literal field-four Borel retains its full A₄ image and intrinsic cubic torus. -/
theorem source_twoFour_borel
    {n : ℕ} {unitary four : Bool}
    (d : LocalBorel.CentralizingCalculation.SourceContext.{u,0}
      T H K L V V₁ V₂ V₃ M G₁ n unitary four)
    (hF : Nat.card F = 4) (eK : Source.starImage H K ≃* PSL(2,F)) :
    d.B ≤ one L T V₁ ∧
      Source.starImage H d.B = borelStar H K T d.sylow_H ∧
      Nat.card (d.B ⧸ pCore 2 d.B) = 3 := by
  let eN := twoFourBorelEquiv eK d.sylow_H
  have hp : IsPPerfect 2 (borelStar H K T d.sylow_H) :=
    (borel_isPPerfect F hF.ge).of_surjective eN.symm.toMonoidHom eN.symm.surjective
  have hs : Source.starImage H d.B = borelStar H K T d.sylow_H := by
    rw [LocalBorel.borel_star, residualIn, (pResidual_eq_top_iff _ _).mpr hp,
      ← MonoidHom.range_eq_map, range_subtype]
  let e := (MulEquiv.subgroupCongr hs).trans eN
  let eQ := (starCoreQuotientEquiv H d.B
    ((borel_le_component H K T d.component_le d.sylow_H).trans d.component_le)).trans
      ((QuotientGroup.congr _ _ e (pCore_map_iso 2 e)).trans
        (quotientTorusEquiv F (n := 2) (by simpa using hF)))
  have hc : Nat.card (d.B ⧸ pCore 2 d.B) = 3 := by
    rw [Nat.card_congr eQ.toEquiv, Nat.card_units, hF]
  refine ⟨?_,hs,hc⟩
  have hgen : closure {x : d.B | orderOf x = 3} = ⊤ :=
    cubic_closure_eq_top_of_twoPerfect_of_quotient_cube (G := d.B)
    (isPPerfect_embedded_pResidual 2 _ : IsPPerfect 2 d.B)
    (fun x => hc ▸ pow_card_eq_one' (x := x))
  have hle : closure {x : d.B | orderOf x = 3} ≤ (one L T V₁).comap d.B.subtype := by
    apply (closure_le _).mpr
    intro x hx
    change (x : G) ∈ one L T V₁
    rw [d.theta]
    exact subset_closure ⟨⟨((borel_le_component H K T d.component_le d.sylow_H).trans
      d.component_le) x.property,d.borel_in_M x.property⟩,
      (Subgroup.orderOf_coe x).trans hx⟩
  rw [hgen] at hle
  exact fun x hx => hle (show (⟨x,hx⟩ : d.B) ∈ ⊤ from trivial)


omit [(Source.starImage H K).Normal] [CharP F 2] in
/-- The original PSL₂(4) component contains the whole local residual L₁. -/
theorem source_projectiveTwo_four_containment
    (c : FieldComponents.SourceContext T L V V₁ V₂ V₃ M G₁ H K)
    (hm : ClassicalGroup.IsPSL (Source.starImage H K) 2 4) : one L T V₁ ≤ K := by
  let : (K.subgroupOf H).Normal := c.component.normal
  let : (Source.starImage H K).Normal :=
    c.component.normal.map _ (QuotientGroup.mk'_surjective _)
  let : IsElementaryAbelian 2 (Source.UH H V₃) :=
    c.localSetup.uh_elementary c.component.local_overgroup
  have hKH : K ≤ H := (le_sup_left.trans le_sup_left).trans_eq c.component.generated
  have hF9 := c.f9 H c.component.local_overgroup
  let act := Comparison.conjugationAction (c.localSetup.line_le_uh H) hF9.plus_le_H
    (hF9.H_centralizes.trans (Subgroup.centralizer_le_normalizer _))
    hF9.commutator_UH_QH_le_point
  obtain ⟨F,hF,hfin,hcard,⟨eK⟩⟩ := hm
  let := Fintype.ofFinite F
  let : CharP F 2 := charP_of_card_eq_prime_pow (p := 2) (f := 2)
    (by simpa [←Nat.card_eq_fintype_card] using hcard)
  have hfield : HigherFieldAlternative (K ⧸ pCore 2 K) :=
    ⟨2,by decide,Or.inl ⟨F,hF,hfin,hcard,
      ⟨(Components.componentStarEquiv H K hKH c.component.component).trans eK⟩⟩⟩
  obtain ⟨n,hn,unitary,four,m⟩ := torus_model_of_higher_field
    (show HigherFieldAlternative (Source.starImage H K) from
      ⟨2,by decide,Or.inl ⟨F,hF,hfin,hcard,⟨eK⟩⟩⟩)
  let i := sourceInput c hn m
  by_contra hout
  rcases local_quotient_alternatives c.localSetup with ⟨e,he⟩ | ⟨e,he⟩
  · obtain ⟨a⟩ := LocalFitting.ordinary_natural c.localSetup e he
    let d := i.ordinarySourceContext a
    obtain ⟨hBD,_,hc⟩ := source_twoFour_borel d hcard eK
    have hd : 3 ∣ Nat.card d.B := hc ▸ card_quotient_dvd_card (pCore 2 d.B)
    have hlo := (Nat.prime_three.dvd_iff_one_le_factorization Nat.card_pos.ne').mp hd
    have hlt := Reduction.borel_three_valuation_lt_of_outside d.B K (one L T V₁)
      (borel_le_component H K T d.component_le d.sylow_H) hout
      ((map_subtype_le _).trans hBD) (le_sup_left.trans d.borel_normalized)
      (isPPerfect_embedded_pResidual 2 _) 1
      (by simpa using LocalFitting.ordinary_core_card c.localSetup ⟨e⟩)
    omega
  · obtain ⟨a⟩ := local_covered_flag_model c.localSetup e he
    have hfactor := CoverFactorization.source_factorization a
    let d := i.coveredSourceContext a hfactor
    obtain ⟨hBD,hstar,hc⟩ := source_twoFour_borel d hcard eK
    obtain ⟨_,_,_,X,t,hlocal,hinv,_,_,houter⟩ := source_borel_exceptional_linear c act hfield
    have hX : X = plus L T V₁ := by
      rcases hlocal with h6 | h6
      · have h3 := LocalFitting.ordinary_core_card c.localSetup h6.1
        have h9 := a.one_quotient_card hfactor
        omega
      · exact h6.2.1
    subst X
    let C3 := Multiplicative (ZMod 3)
    let e₀ : (zero L ⧸ pCore 2 (zero L)) ≃* C3 :=
      mulEquivOfPrimeCardEq a.zero_core_card (by simp [C3])
    let eX : (plus L T V₁ ⧸ pCore 2 (plus L T V₁)) ≃* C3 :=
      mulEquivOfPrimeCardEq (a.plus_core_card hfactor) (by simp [C3])
    let e₉ := (LocalAction.markedProductEquiv L T V₁ a.normalizes_L a.line_stable
      hfactor (a.plus_core_card hfactor)).symm.trans (e₀.prodCongr eX)
    have hc₀ : Nat.card (Source.starImage (one L T V₁) (zero L)) = 3 := by
      rw [←LocalAction.localCoreMap_range (one L T V₁) (zero L)
        (LocalAction.zero_le_one_of_factorization L T V₁ hfactor)
        (LocalAction.one_normalizes_zero L T V₁ a.normalizes_L)]
      rw [←Nat.card_congr (MonoidHom.ofInjective
        (LocalAction.localCoreMap_injective _ _ _ _)).toEquiv]
      exact a.zero_core_card
    have hcX : Nat.card (Source.starImage (one L T V₁) (plus L T V₁)) = 3 := by
      rw [←LocalAction.localCoreMap_range (one L T V₁) (plus L T V₁)
        (plus_le_one L T V₁ a.line_stable) (one_normalizes_plus L T V₁)]
      rw [←Nat.card_congr (MonoidHom.ofInjective
        (LocalAction.localCoreMap_injective _ _ _ _)).toEquiv]
      exact a.plus_core_card hfactor
    have hcomm : ⁅zero L,zpowers t.val⁆ ≤ (zero L).pCoreIn 2 := by
      apply commutator_le.mpr
      intro z hz s hs
      have hsL : s ∈ L := (zpowers_le.mpr t.property.2) hs
      have hh := (coreAction_eq_one_iff _ _).mp
        (L_centralizes_zero_quotient L ⟨s,hsL⟩) ⟨z,hz⟩
      have hh' : s*z*s⁻¹*z⁻¹ ∈ (zero L).pCoreIn 2 := ⟨_,hh,rfl⟩
      simpa only [commutatorElement_def,mul_inv_rev,inv_inv,mul_assoc] using
        ((zero L).pCoreIn 2).inv_mem hh'
    have hpK : IsPPerfect 2 K := by
      have : Group.IsPerfect K := by
        let := c.component.component.perfect
        exact Group.IsPerfect.ofSurjective (f := (subgroupOfEquivOfLe hKH).toMonoidHom)
          (subgroupOfEquivOfLe hKH).surjective
      intro N hN hp
      let := hN
      have hsub : Subsingleton (K ⧸ N) := by
        by_contra! hn
        exact Group.IsPerfect.not_isNilpotent (K ⧸ N) hp.isNilpotent
      exact eq_top_iff.mpr fun k _ =>
        (QuotientGroup.eq_one_iff k).mp (Subsingleton.elim _ _)
    obtain ⟨S,hS⟩ := d.sylow_H
    have hBstar : borelStar H K T d.sylow_H ≤ Source.starImage H (one L T V₁) :=
      hstar ▸ (map_mono (subgroupOf_mono H hBD))
    have hDN : Source.starImage H (one L T V₁) ≤
        normalizer (borelStar H K T d.sylow_H : Set (Source.Hstar H)) := by
      rw [←hstar]
      exact ExceptionalFields.LinearThreeFour.AutomorphismModule.LocalAlternatives.SourceMarking.starImage_normalizes
        H _ _ (le_sup_left.trans d.borel_normalized)
    have hi := CentralFactors.linear_two_four_external_X_and_inner
      H K (one L T V₁) (zero L) (plus L T V₁) T M c.component.generated.symm
      c.component.external (SolvableSource.covered_normalizer_source c.localSetup c.maximal ⟨e⟩)
      hpK (isPPerfect_embedded_pResidual 2 _) (residual_isPPerfect _)
      (residual_isPPerfect _) ((sup_comm _ _).trans hfactor.symm) hout S hS
      (a.normalizes_L.trans (normalizer_le_zero_normalizer L))
      (T_normalizes_plus L T V₁ a.normalizes_L a.line_stable) hcard eK
      (LocalBorel.sourceSylow H K T d.sylow_H)
      (LocalBorel.sourceSylow_image H K T d.sylow_H) hBstar hDN e₉ hc₀ hcX
      ⟨t.val,d.T_le_H t.property.1⟩ t.property.1 hcomm hinv.2
    obtain ⟨_,houter⟩ := houter
    exact houter hi.2

omit [(Source.starImage H K).Normal] [CharP F 2] in
/-- Containment excludes the covered local quotient and identifies the whole
star group, with the component's actual alternating-five inclusion retained. -/
theorem source_projectiveTwo_four_structure
    (c : FieldComponents.SourceContext T L V V₁ V₂ V₃ M G₁ H K)
    (hm : ClassicalGroup.IsPSL (Source.starImage H K) 2 4) :
    one L T V₁ ≤ K ∧
      Nonempty ((L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 6)) ∧
      H = K ⊔ (T : Subgroup G) ∧ Source.UH H V₃ = ⁅Source.UH H V₃,K⁆ ∧
      ∃ (eA : Source.starImage H K ≃* alternatingGroup (Fin 5))
        (eH : Source.Hstar H ≃* Equiv.Perm (Fin 5)),
        ∀ k : Source.starImage H K, eH k = eA k := by
  let : (K.subgroupOf H).Normal := c.component.normal
  let : (Source.starImage H K).Normal :=
    c.component.normal.map _ (QuotientGroup.mk'_surjective _)
  have hLK := source_projectiveTwo_four_containment c hm
  have hKH : K ≤ H := (le_sup_left.trans le_sup_left).trans_eq c.component.generated
  have hLH := hLK.trans hKH
  obtain ⟨F,hF,hfin,hcard,⟨eK⟩⟩ := hm
  obtain ⟨e5⟩ := Matrix.ProjectiveSpecialLinearGroup.equiv_alternatingGroup_of_card_four hcard
  let eA := eK.trans e5
  have hord : Nonempty ((L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 6)) := by
    rcases local_quotient_alternatives c.localSetup with ⟨e,he⟩ | ⟨e,he⟩
    · exact ⟨e⟩
    · obtain ⟨a⟩ := local_covered_flag_model c.localSetup e he
      have h9 := a.one_quotient_card (CoverFactorization.source_factorization a)
      have hd : 9 ∣ Nat.card (Source.starImage H (one L T V₁)) := by
        rw [←h9,Nat.card_congr (starCoreQuotientEquiv H (one L T V₁) hLH).toEquiv]
        exact card_quotient_dvd_card _
      have hin : Source.starImage H (one L T V₁) ≤ Source.starImage H K :=
        map_mono (subgroupOf_mono H hLK)
      have hd' := hd.trans (card_dvd_of_le hin)
      rw [Nat.card_congr eA.toEquiv,nat_card_alternatingGroup] at hd'
      norm_num [Nat.factorial] at hd'
  have hseed := (Section07.ModelExclusions.seed_commutator_point_residual
    (localNaturalSetup c.localSetup)).symm
  obtain ⟨hHT,hU⟩ := ExceptionalFields.reduction_of_containment H K (one L T V₁)
    T (one L T V₁) V₃ c.component.generated.symm hLK le_rfl hseed
  let : IsElementaryAbelian 2 (Source.UH H V₃) :=
    c.localSetup.uh_elementary c.component.local_overgroup
  have hF9 := c.f9 H c.component.local_overgroup
  let act := Comparison.conjugationAction (c.localSetup.line_le_uh H) hF9.plus_le_H
    (hF9.H_centralizes.trans (Subgroup.centralizer_le_normalizer _))
    hF9.commutator_UH_QH_le_point
  have hfield : HigherFieldAlternative (K ⧸ pCore 2 K) :=
    ⟨2,by decide,Or.inl ⟨F,hF,hfin,hcard,
      ⟨(Components.componentStarEquiv H K hKH c.component.component).trans eK⟩⟩⟩
  obtain ⟨_,_,_,_,t,_,_,_,_,houter⟩ := source_borel_exceptional_linear c act hfield
  obtain ⟨_,houter⟩ := houter
  exact ⟨hLK,hord,hHT,hU,ExceptionalFields.linear_two_four_identification H K T hHT
    T.isPGroup' hcard eK _ houter⟩

