/-!
# The irreducible external-cubic pairing calculation

For a finite group with generalized Fitting subgroup `K × X`, where the
marked component `K` is SL₃(2) and `X` has order three, an irreducible binary
module generated by its `X`-commutators has two Steinberg constituents or two
natural and two dual constituents whenever the conjugation image is the full
automorphism group and `K` acts nontrivially.

Choose an actual constituent using H.6.1. The Steinberg model extends along
the full conjugation action. The natural and dual models extend to the
preimage of the inner automorphisms: centerlessness identifies that inner
action with the component itself. This preimage has index two, and the other
coset exchanges the two models. Commutation with `X` makes each extension
trivial on `X`. The cubic Clifford theorems then determine multiplicity two;
explicit intertwining equivalences reorder the four factors and transport
the result through the marked component isomorphism.

The catalogue-input theorem retains the earlier interface, and the final
wrapper discharges that input using the proved binary H.6.1 catalogue. These
are the representation calculations used by the chief-section assembly,
not an assertion of the remaining clauses of 13.8.21.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*, H.6.1 and
the proof of 13.8.21(1), printed pp.386 and 956 (1 March 2004 manuscript).
-/

public section

open Representation Representation.BinaryOffender
namespace CFSG.Quasithin.Chapter13.Section08.ComponentSieve.FieldComponents.LinearThree.ExternalModules
namespace PairingCalculation
open BinaryLinearThree.AutomorphismAction
variable {H : Type*} [Group H] (K : Subgroup H) [K.Normal]
    (eK : K ≃* BinaryLinearThree.Group)

private def action : H →* MulAut BinaryLinearThree.Group :=
  (MulAut.congr eK).toMonoidHom.comp MulAut.conjNormal

private theorem action_component (k : K) :
    action K eK k = MulAut.conj (eK k) := by
  ext y : 1
  change eK (MulAut.conjNormal (k : H) (eK.symm y)) = _
  have hk : MulAut.conjNormal (k : H) (eK.symm y) = k * eK.symm y * k⁻¹ := by
    apply Subtype.ext
    rfl
  rw [hk, map_mul, map_mul, map_inv, eK.apply_symm_apply]
  rfl

private theorem action_external (X : Subgroup H)
    (hc : ∀ k : K, ∀ x : X, Commute (k : H) (x : H)) (x : X) :
    action K eK x = 1 := by
  have hx : (MulAut.conjNormal (x : H) : MulAut K) = 1 := by
    ext k : 1
    apply Subtype.ext
    change (x : H) * k * (x : H)⁻¹ = k
    rw [(hc k x).eq.symm, mul_inv_cancel_right]
  change MulAut.congr eK (MulAut.conjNormal (x : H)) = 1
  rw [hx, map_one]

private def innerPreimage : Subgroup H :=
  (MulAut.innerSubgroup BinaryLinearThree.Group).comap (action K eK)

private instance : (innerPreimage K eK).Normal := inferInstanceAs
  ((MulAut.innerSubgroup BinaryLinearThree.Group).comap (action K eK)).Normal

private theorem component_le_inner : K ≤ innerPreimage K eK := by
  intro k hk
  change action K eK k ∈ MulAut.innerSubgroup BinaryLinearThree.Group
  exact ⟨eK ⟨k, hk⟩, (action_component K eK ⟨k, hk⟩).symm⟩

private theorem product_le_inner (X : Subgroup H)
    (hc : ∀ k : K, ∀ x : X, Commute (k : H) (x : H)) :
    K ⊔ X ≤ innerPreimage K eK := by
  refine sup_le (component_le_inner K eK) ?_
  intro x hx
  change action K eK x ∈ MulAut.innerSubgroup BinaryLinearThree.Group
  rw [action_external K eK X hc ⟨x, hx⟩]
  exact one_mem _

private theorem inner_index_two
    (hf : Function.Surjective (MulAut.conjNormal (H := K) : H →* MulAut K)) :
    (innerPreimage K eK).index = 2 := by
  rw [innerPreimage, Subgroup.index_comap_of_surjective _
    ((MulAut.congr eK).surjective.comp hf)]
  exact Matrix.PSL3Two.Automorphisms.card_outer_sl

private noncomputable def innerEquiv : BinaryLinearThree.Group ≃*
    MulAut.innerSubgroup BinaryLinearThree.Group :=
  MonoidHom.ofInjective (MulAut.conj_injective_of_center_eq_bot Matrix.PSL3Two.center_eq_bot)

private noncomputable def innerCoordinate : innerPreimage K eK →* BinaryLinearThree.Group :=
  innerEquiv.symm.toMonoidHom.comp
    (((action K eK).comp (innerPreimage K eK).subtype).codRestrict
      (MulAut.innerSubgroup BinaryLinearThree.Group) (fun i => i.property))

private theorem innerCoordinate_conj (i : innerPreimage K eK) :
    MulAut.conj (innerCoordinate K eK i) = action K eK i := by
  exact congrArg Subtype.val (innerEquiv.apply_symm_apply
    ⟨action K eK i, i.property⟩)

private theorem innerCoordinate_component (hKI : K ≤ innerPreimage K eK) (k : K) :
    innerCoordinate K eK (Subgroup.inclusion hKI k) = eK k := by
  apply MulAut.conj_injective_of_center_eq_bot Matrix.PSL3Two.center_eq_bot
  rw [innerCoordinate_conj]
  exact action_component K eK k

private theorem innerCoordinate_external (X : Subgroup H)
    (hc : ∀ k : K, ∀ x : X, Commute (k : H) (x : H))
    (x : innerPreimage K eK) (hx : (x : H) ∈ X) :
    innerCoordinate K eK x = 1 := by
  apply MulAut.conj_injective_of_center_eq_bot Matrix.PSL3Two.center_eq_bot
  rw [innerCoordinate_conj, map_one]
  exact action_external K eK X hc ⟨x, hx⟩

omit [K.Normal] in
private theorem absolute_pullback {E : Type*} [AddCommGroup E] [Module (ZMod 2) E]
    (σ : Representation (ZMod 2) BinaryLinearThree.Group E)
    (ha : IsAbsolutelyIrreducible σ) : IsAbsolutelyIrreducible (σ.comp eK.toMonoidHom) := by
  constructor
  exact (irreducible_comp_surjective_iff eK.toMonoidHom eK.surjective
    (extendScalars (AlgebraicClosure (ZMod 2)) σ)).mpr ha.irreducible_of_closure

private theorem conjugate_pullback {E : Type*} [AddCommGroup E] [Module (ZMod 2) E]
    (σ : Representation (ZMod 2) BinaryLinearThree.Group E) (g : H) :
    conjugateRep (σ.comp eK.toMonoidHom) g =
      (σ.comp (action K eK g).toMonoidHom).comp eK.toMonoidHom := by
  apply MonoidHom.ext
  intro k
  change σ (eK (MulAut.conjNormal g k)) =
    σ (eK (MulAut.conjNormal g (eK.symm (eK k))))
  rw [eK.symm_apply_apply]

private def reindexEquiv {E V : Type*} [AddCommGroup E] [Module (ZMod 2) E]
    [AddCommGroup V] [Module (ZMod 2) V]
    (ρ : Representation (ZMod 2) H V)
    (σ : Representation (ZMod 2) BinaryLinearThree.Group E)
    (e : Representation.Equiv (ρ.comp K.subtype) (σ.comp eK.toMonoidHom)) :
    Representation.Equiv (componentAction ρ K eK) σ :=
  .mk e.toLinearEquiv (fun k => by simpa [componentAction] using e.isIntertwining' (eK.symm k))

private def constituentEquiv {E V : Type*} [AddCommGroup E] [Module (ZMod 2) E]
    [AddCommGroup V] [Module (ZMod 2) V]
    (α : Representation (ZMod 2) K V)
    (σ : Representation (ZMod 2) BinaryLinearThree.Group E)
    (e : Representation.Equiv (α.comp eK.symm.toMonoidHom) σ) :
    Representation.Equiv α (σ.comp eK.toMonoidHom) :=
  .mk e.toLinearEquiv (fun k => by simpa using e.isIntertwining' (eK k))

variable [Finite H] {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]
    [FiniteDimensional (ZMod 2) V]

private theorem steinberg_pair
    (ρ : Representation (ZMod 2) H V) [IsIrreducible ρ]
    (X : Subgroup H) [X.Normal] (hs : PairedStructure K X)
    (hcomm : subspaceCommutator ρ ⊤ X = ⊤)
    (habs : IsAbsolutelyIrreducible BinaryLinearThree.S)
    (A : Subrepresentation (ρ.comp K.subtype))
    (hA : Nonempty (Representation.Equiv
      (A.toRepresentation.comp eK.symm.toMonoidHom) BinaryLinearThree.S)) :
    Nonempty (Representation.Equiv (componentAction ρ K eK) pairedSteinberg) := by
  let τ := steinbergAut.comp (action K eK)
  have hres : τ.comp K.subtype = BinaryLinearThree.S.comp eK.toMonoidHom := by
    apply MonoidHom.ext
    intro k
    change steinbergAut (action K eK k) = BinaryLinearThree.S (eK k)
    rw [action_component]
    exact congrArg (fun r : Representation (ZMod 2) BinaryLinearThree.Group
      BinaryLinearThree.Steinberg => r (eK k)) steinbergAut_comp_conj
  have hτ : X ≤ τ.ker := by
    intro x hx
    change steinbergAut (action K eK x) = 1
    rw [action_external K eK X hs.commute ⟨x, hx⟩, map_one]
  have habs' : IsAbsolutelyIrreducible (τ.comp K.subtype) := by
    rw [hres]
    exact absolute_pullback K eK BinaryLinearThree.S habs
  obtain ⟨eA⟩ := hA
  have hoc : Nonempty (Representation.Equiv A.toRepresentation (τ.comp K.subtype)) := by
    rw [hres]
    exact ⟨constituentEquiv K eK _ _ eA⟩
  obtain ⟨e⟩ := CubicClifford.restriction_pair_of_extension_of_commutator_eq_top
    ρ K X hs.card_three
    (quotient_external_isTwoGroup K X eK hs.card_three hs.commute hs.fitting)
    hcomm τ habs' hτ A hoc
  rw [hres] at e
  refine ⟨.mk e.toLinearEquiv ?_⟩
  intro k
  simpa [componentAction, pairedSteinberg, Representation.prod] using
    e.isIntertwining' (eK.symm k)

private theorem exchanged_pairs
    {E F : Type*} [AddCommGroup E] [Module (ZMod 2) E]
    [FiniteDimensional (ZMod 2) E] [AddCommGroup F] [Module (ZMod 2) F]
    (ρ : Representation (ZMod 2) H V) [IsIrreducible ρ]
    (X : Subgroup H) [X.Normal] (hs : PairedStructure K X)
    (hcomm : subspaceCommutator ρ ⊤ X = ⊤)
    (σ : Representation (ZMod 2) BinaryLinearThree.Group E)
    (δ : Representation (ZMod 2) BinaryLinearThree.Group F)
    (habs : IsAbsolutelyIrreducible σ)
    (hout : ∀ a : MulAut BinaryLinearThree.Group,
      a ∉ MulAut.innerSubgroup BinaryLinearThree.Group →
        Nonempty (Representation.Equiv (σ.comp a.toMonoidHom) δ))
    (hne : ¬ Nonempty (Representation.Equiv σ δ))
    (A : Subrepresentation (ρ.comp K.subtype))
    (hA : Nonempty (Representation.Equiv
      (A.toRepresentation.comp eK.symm.toMonoidHom) σ)) :
    Nonempty (Representation.Equiv (componentAction ρ K eK)
      (Representation.prod (Representation.prod σ δ) (Representation.prod σ δ))) := by
  let I := innerPreimage K eK
  have hKXI : K ⊔ X ≤ I := product_le_inner K eK X hs.commute
  have hKI : K ≤ I := le_sup_left.trans hKXI
  have hi : I.index = 2 := inner_index_two K eK hs.full_conjugation
  obtain ⟨g, hg⟩ : ∃ g : H, g ∉ I := by
    by_contra! he
    have ht : I = ⊤ := top_unique (fun g _ => he g)
    rw [ht, Subgroup.index_top] at hi
    omega
  let τ := σ.comp (innerCoordinate K eK)
  have hres : τ.comp (Subgroup.inclusion hKI) = σ.comp eK.toMonoidHom := by
    ext k : 1
    exact congrArg σ (innerCoordinate_component K eK hKI k)
  have hτ : X.subgroupOf I ≤ τ.ker := by
    intro x hx
    change σ (innerCoordinate K eK x) = 1
    rw [innerCoordinate_external K eK X hs.commute x hx, map_one]
  have habs' : IsAbsolutelyIrreducible (τ.comp (Subgroup.inclusion hKI)) := by
    rw [hres]
    exact absolute_pullback K eK σ habs
  obtain ⟨eA⟩ := hA
  have hoc : Nonempty (Representation.Equiv A.toRepresentation
      (τ.comp (Subgroup.inclusion hKI))) := by
    rw [hres]
    exact ⟨constituentEquiv K eK _ _ eA⟩
  obtain ⟨eg⟩ := hout (action K eK g) hg
  have hconj : conjugateRep (σ.comp eK.toMonoidHom) g =
      (σ.comp (action K eK g).toMonoidHom).comp eK.toMonoidHom :=
    conjugate_pullback K eK σ g
  let et : Representation.Equiv (conjugateRep (σ.comp eK.toMonoidHom) g)
      (δ.comp eK.toMonoidHom) := by
    rw [hconj]
    exact .mk eg.toLinearEquiv (fun k => eg.isIntertwining' (eK k))
  have hn : ¬ Nonempty (Representation.Equiv
      (τ.comp (Subgroup.inclusion hKI))
      (conjugateRep (τ.comp (Subgroup.inclusion hKI)) g)) := by
    rw [hres]
    rintro ⟨e⟩
    exact hne ⟨inflationEquiv eK.toMonoidHom eK.surjective σ δ (e.trans et)⟩
  obtain ⟨e⟩ := CubicClifford.restriction_two_pairs_of_index_two_extension
    ρ K X hs.card_three
    (quotient_external_isTwoGroup K X eK hs.card_three hs.commute hs.fitting)
    hcomm I hKXI hi g hg τ habs' hτ A hoc hn
  rw [hres] at e
  let er : Representation.Equiv
      (Representation.prod
        (Representation.prod (σ.comp eK.toMonoidHom) (σ.comp eK.toMonoidHom))
        (Representation.prod (conjugateRep (σ.comp eK.toMonoidHom) g)
          (conjugateRep (σ.comp eK.toMonoidHom) g)))
      ((Representation.prod (Representation.prod σ δ) (Representation.prod σ δ)).comp eK.toMonoidHom) :=
    .mk (((LinearEquiv.refl (ZMod 2) (E × E)).prodCongr
      (et.toLinearEquiv.prodCongr et.toLinearEquiv)).trans
        (LinearEquiv.prodProdProdComm (ZMod 2) E E F F)) (by
      intro k
      apply LinearMap.ext
      intro v
      have he₁ := congrArg (fun f : E →ₗ[ZMod 2] F => f v.2.1) (et.isIntertwining' k)
      have he₂ := congrArg (fun f : E →ₗ[ZMod 2] F => f v.2.2) (et.isIntertwining' k)
      exact Prod.ext (Prod.ext rfl he₁) (Prod.ext rfl he₂))
  exact ⟨reindexEquiv K eK ρ _ (e.trans er)⟩

end PairingCalculation

universe u
variable {H : Type*} [Group H] [Finite H]
    {V : Type u} [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V]

/-- The irreducible external-cubic calculation: full automorphism action forces
an actual pair of Steinberg modules or two natural-dual pairs on the component.
The extension and inertia multiplicities are proved, rather than assumed. -/
theorem irreducible_paired_alternatives_of_catalogue
    (ρ : Representation (ZMod 2) H V) (K X : Subgroup H) [K.Normal] [X.Normal]
    (eK : K ≃* BinaryLinearThree.Group) (hs : PairedStructure K X)
    (hcat : LinearThreeIrreducibleCatalogue.{u}) (hirr : IsIrreducible ρ)
    (hcomm : subspaceCommutator ρ ⊤ X = ⊤)
    (hmoved : ∃ k : K, ∃ v, ρ k v ≠ v) :
    PairedAlternatives (componentAction ρ K eK) := by
  let : IsIrreducible ρ := hirr
  obtain ⟨A, _, hA⟩ := exists_catalogued_constituent ρ K hirr hmoved eK hcat
  rcases hA with hn | hd | hs'
  · exact Or.inr (PairingCalculation.exchanged_pairs K eK ρ X hs hcomm
      BinaryLinearThree.W BinaryLinearThree.W.dual hcat.natural_absolute
      (fun a ha => ⟨BinaryLinearThree.AutomorphismAction.naturalOuterEquiv a ha⟩)
      BinaryLinearThree.AutomorphismAction.natural_not_equiv_dual A hn)
  · obtain ⟨e⟩ := PairingCalculation.exchanged_pairs K eK ρ X hs hcomm
      BinaryLinearThree.W.dual BinaryLinearThree.W hcat.dual_absolute
      (fun a ha => ⟨BinaryLinearThree.AutomorphismAction.dualOuterEquiv a ha⟩)
      (fun ⟨e⟩ => BinaryLinearThree.AutomorphismAction.natural_not_equiv_dual ⟨e.symm⟩) A hd
    let swap : Representation.Equiv
        ((BinaryLinearThree.W.dual.prod BinaryLinearThree.W).prod
          (BinaryLinearThree.W.dual.prod BinaryLinearThree.W)) pairedNaturalDual :=
      .mk ((LinearEquiv.prodComm (ZMod 2) _ _).prodCongr
        (LinearEquiv.prodComm (ZMod 2) _ _)) (fun _ => rfl)
    exact Or.inr ⟨e.trans swap⟩
  · exact Or.inl (PairingCalculation.steinberg_pair K eK ρ X hs hcomm
      hcat.steinberg_absolute A hs')

/-- The published binary H.6.1 catalogue packaged at the universe of the
ambient chief section; no classification hypothesis remains in this witness. -/
theorem linearThreeIrreducibleCatalogue : LinearThreeIrreducibleCatalogue.{u} where
  classify V _ _ _ σ hirr hmove := by
    let : IsIrreducible σ := hirr
    exact BinaryLinearThree.IrreducibleCatalogue.classify_nontrivial σ hmove
  natural_absolute := BinaryLinearThree.IrreducibleCatalogue.natural_absolute
  dual_absolute := BinaryLinearThree.IrreducibleCatalogue.dual_absolute
  steinberg_absolute := BinaryLinearThree.IrreducibleCatalogue.steinberg_absolute

/-- The irreducible pairing calculation with the actual H.6.1 catalogue
discharged. This supplies the representation step of 13.8.21(1); assembly on
all literal chief sections remains with the chief-decomposition theorem. -/
theorem irreducible_paired_alternatives
    (ρ : Representation (ZMod 2) H V) (K X : Subgroup H) [K.Normal] [X.Normal]
    (eK : K ≃* BinaryLinearThree.Group) (hs : PairedStructure K X)
    (hirr : IsIrreducible ρ) (hcomm : subspaceCommutator ρ ⊤ X = ⊤)
    (hmoved : ∃ k : K, ∃ v, ρ k v ≠ v) :
    PairedAlternatives (componentAction ρ K eK) :=
  irreducible_paired_alternatives_of_catalogue ρ K X eK hs linearThreeIrreducibleCatalogue hirr hcomm hmoved
end CFSG.Quasithin.Chapter13.Section08.ComponentSieve.FieldComponents.LinearThree.ExternalModules
