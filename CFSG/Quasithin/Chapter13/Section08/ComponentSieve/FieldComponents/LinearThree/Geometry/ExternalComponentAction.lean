/-!
# Reduction and ordinary geometry of an external binary linear-three component

The exact component list and earlier source setup give m₃(K)=1 and the
actual equivalence K* ≃ L₃(2), uniformly in the A₆ and Â₆ branches. The
intrinsic kernel is O₂(K). In the ordinary A₆ branch the source marked
quotient of order three and X=[X,T], with X=L₁ outside K, give
[X,K]≤O₂(K). `ordinary_external_geometry` assembles these deductions
with the action and seed arguments below; neither rank, model recognition
nor the external commutator bound is an extra premise of that theorem.

The actual conjugation action on a normal K* ≃ L₃(2) has kernel
C_H*(K*). Its image contains the inner automorphisms, which have index
two in Aut(L₃(2)); hence the image is either inner or full. In the full
case the first isomorphism theorem gives a quotient identification whose
value on every representative agrees with conjugation on K*.

In the inner case, project onto L₃(2). The centralizer kernel is solvable:
it embeds in H*/K*, which is generated by a normal solvable X* and the
two-group T*. Pull back the two parabolics containing the image of T,
first to H and then to the original ambient group. Both preimages are
solvable, contain XT, lie in G₁, and together generate H. Thus these are
overgroups to which the exact solvable exclusion 13.8.13 applies.

Normality of X* is derived from H = KXT, its centralization of K*, and
T-normalization of X. The group seed identity V₃ = [V₃,X] then gives
Ũ_H = [Ũ_H,X*] through the actual SourceAction.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004,
13.8.21(1), printed p.956. The standing setup, exact earlier marked-subgroup
facts, actual source module action, and list 13.8.21(2) remain explicit.
The parent geometry task owns their final source instantiation, the covered
branch after rank reduction, representation exclusion, and final L₁≤K
assembly. No exclusion of K* ≃ L₃(2) is asserted here.
-/

@[expose] public section

open Subgroup
namespace CFSG.Quasithin.Chapter13.Section08.ComponentSieve.FieldComponents.LinearThree.Geometry.ExternalComponentAction
variable {G : Type*} [Group G] [Finite G]

section Action
variable {A : Type*} [Group A] (N : Subgroup A) [N.Normal]
  (e : N ≃* Matrix.PSL3Two.PSL)

/-- Conjugation on N, transported along the specified concrete L₃(2) identification. -/
def modelAction : A →* MulAut Matrix.PSL3Two.PSL :=
  (MulAut.congr e).toMonoidHom.comp MulAut.conjNormal

/-- The model action retains the original conjugation on every element of N. -/
theorem modelAction_apply (a : A) (n : N) :
    modelAction N e a (e n) = e (MulAut.conjNormal a n) := by
  simp [modelAction, MulAut.congr_apply]

/-- The conjugation kernel is precisely the centralizer in the acting group. -/
theorem modelAction_kernel : (modelAction N e).ker = centralizer (N : Set A) := by
  rw [modelAction, MonoidHom.ker_comp_of_injective _ _ (MulAut.congr e).injective]
  exact MulAut.conjNormal_ker_eq_centralizer N

/-- Elements of N induce their corresponding inner automorphisms. -/
theorem modelAction_inner (n : N) : modelAction N e n.val = MulAut.conj (e n) := by
  ext k
  obtain ⟨l, rfl⟩ := e.surjective k
  rw [modelAction_apply]
  simp [MulAut.conjNormal_val, MulAut.conj_apply]

/-- The conjugation image contains all inner automorphisms. -/
theorem inner_le_modelAction_range :
    MulAut.innerSubgroup Matrix.PSL3Two.PSL ≤ (modelAction N e).range := by
  rintro _ ⟨k, rfl⟩
  exact ⟨(e.symm k).val, by rw [modelAction_inner, e.apply_symm_apply]⟩

/-- The full-image case identifies the actual centralizer quotient with Aut(L₃(2)). -/
noncomputable def fullActionEquiv
    (hf : Function.Surjective (modelAction N e)) :
    (A ⧸ centralizer (N : Set A)) ≃* MulAut Matrix.PSL3Two.PSL :=
  QuotientGroup.liftEquiv _ hf (modelAction_kernel N e).symm

/-- The quotient identification agrees with conjugation, not merely group order. -/
theorem fullActionEquiv_apply
    (hf : Function.Surjective (modelAction N e)) (a : A) (n : N) :
    fullActionEquiv N e hf (QuotientGroup.mk' (centralizer (N : Set A)) a) (e n) =
      e (MulAut.conjNormal a n) := by
  exact modelAction_apply N e a n
end Action

private theorem inner_injective :
    Function.Injective (MulAut.conj : Matrix.PSL3Two.PSL →* MulAut Matrix.PSL3Two.PSL) := by
  apply (MonoidHom.ker_eq_bot_iff _).mp
  apply bot_unique
  intro x hx
  have hc : x ∈ center Matrix.PSL3Two.PSL := by
    rw [mem_center_iff]
    intro y
    have h := congrArg (fun a : MulAut Matrix.PSL3Two.PSL => a y) hx
    change x * y * x⁻¹ = y at h
    exact (mul_inv_eq_iff_eq_mul.mp h).symm
  simpa only [Matrix.PSL3Two.Automorphisms.center_psl_eq_bot] using hc

private noncomputable def innerEquiv :
    Matrix.PSL3Two.PSL ≃* MulAut.innerSubgroup Matrix.PSL3Two.PSL :=
  MonoidHom.ofInjective inner_injective

/-- An action containing Inn(L₃(2)) is either the inner group or all automorphisms. -/
theorem modelAction_range_alternative {A : Type*} [Group A]
    (N : Subgroup A) [N.Normal] (e : N ≃* Matrix.PSL3Two.PSL) :
    (modelAction N e).range = MulAut.innerSubgroup Matrix.PSL3Two.PSL ∨
      Function.Surjective (modelAction N e) := by
  let I := MulAut.innerSubgroup Matrix.PSL3Two.PSL
  let R := (modelAction N e).range
  have hi : Nat.card I = 168 :=
    (Nat.card_congr innerEquiv.toEquiv).symm.trans Matrix.PSL3Two.card_PSL
  have hi2 : I.index = 2 := by
    have h := I.card_mul_index
    rw [hi, Matrix.PSL3Two.Automorphisms.card_aut] at h
    omega
  have hIR : I ≤ R := inner_le_modelAction_range N e
  have hd : R.index ∣ 2 := by
    have hd := index_dvd_of_le hIR
    rwa [hi2] at hd
  rcases (Nat.dvd_prime (by decide : Nat.Prime 2)).mp hd with hr | hr
  · right
    exact MonoidHom.range_eq_top.mp (index_eq_one.mp hr)
  · left
    have hrel := relIndex_mul_index hIR
    rw [hi2, hr] at hrel
    exact (relIndex_eq_one.mp (by omega : I.relIndex R = 1)).antisymm hIR

private theorem solvable_of_card_twentyFour {A : Type*} [Group A] [Finite A]
    (hc : Nat.card A = 24) : Group.IsSolvable A := by
  let P : Sylow 2 A := Classical.choice inferInstance
  have hp : Nat.card P = 8 := by
    rw [P.card_eq_multiplicity, hc]
    decide +kernel
  have hi : (P : Subgroup A).index ≤ 4 := by
    have h := (P : Subgroup A).card_mul_index
    rw [hp, hc] at h
    omega
  let : Group.IsNilpotent P := P.isPGroup'.isNilpotent
  exact (P : Subgroup A).isSolvable_of_index_le_four hi

private theorem solvable_generating_parabolics (S : Subgroup Matrix.PSL3Two.PSL)
    (hS : IsPGroup 2 S) :
    ∃ P Q : Subgroup Matrix.PSL3Two.PSL,
      S ≤ P ∧ S ≤ Q ∧ Group.IsSolvable P ∧ Group.IsSolvable Q ∧ P ⊔ Q = ⊤ := by
  obtain ⟨T, hST⟩ := hS.exists_le_sylow
  obtain ⟨P, Q, hp, hq, hne, hinf, hcp, hcq, _⟩ := Matrix.PSL3Two.sylow_parabolics T
  refine ⟨P, Q, hST.trans ?_, hST.trans ?_,
    solvable_of_card_twentyFour hcp, solvable_of_card_twentyFour hcq,
    hp.sup_eq_top_of_ne hq hne⟩
  · rw [← hinf]; exact inf_le_left
  · rw [← hinf]; exact inf_le_right

private noncomputable def innerProjection {A : Type*} [Group A]
    (N : Subgroup A) [N.Normal] (e : N ≃* Matrix.PSL3Two.PSL)
    (hr : (modelAction N e).range = MulAut.innerSubgroup Matrix.PSL3Two.PSL) :
    A →* Matrix.PSL3Two.PSL :=
  innerEquiv.symm.toMonoidHom.comp
    ((MulEquiv.subgroupCongr hr).toMonoidHom.comp (modelAction N e).rangeRestrict)

private theorem innerProjection_surjective {A : Type*} [Group A]
    (N : Subgroup A) [N.Normal] (e : N ≃* Matrix.PSL3Two.PSL)
    (hr : (modelAction N e).range = MulAut.innerSubgroup Matrix.PSL3Two.PSL) :
    Function.Surjective (innerProjection N e hr) :=
  innerEquiv.symm.surjective.comp
    ((MulEquiv.subgroupCongr hr).surjective.comp (modelAction N e).rangeRestrict_surjective)

private theorem innerProjection_kernel {A : Type*} [Group A]
    (N : Subgroup A) [N.Normal] (e : N ≃* Matrix.PSL3Two.PSL)
    (hr : (modelAction N e).range = MulAut.innerSubgroup Matrix.PSL3Two.PSL) :
    (innerProjection N e hr).ker = centralizer (N : Set A) := by
  rw [innerProjection, MonoidHom.ker_comp_of_injective _ _ innerEquiv.symm.injective,
    MonoidHom.ker_comp_of_injective _ _ (MulEquiv.subgroupCongr hr).injective,
    MonoidHom.ker_rangeRestrict]
  exact modelAction_kernel N e

private theorem centralizer_solvable_of_quotient {A : Type*} [Group A]
    (N : Subgroup A) [N.Normal] (e : N ≃* Matrix.PSL3Two.PSL)
    [Group.IsSolvable (A ⧸ N)] : Group.IsSolvable (centralizer (N : Set A)) := by
  let C := centralizer (N : Set A)
  let f := (QuotientGroup.mk' N).comp C.subtype
  apply Group.isSolvable_of_isSolvable_injective (f := f)
  apply (MonoidHom.ker_eq_bot_iff f).mp
  apply bot_unique
  intro x hx
  have hxN : x.val ∈ N := (QuotientGroup.eq_one_iff x.val).mp hx
  have hc : (⟨x.val, hxN⟩ : N) ∈ center N := by
    rw [mem_center_iff]
    intro n
    apply Subtype.ext
    exact x.property n.val n.property
  have he : e ⟨x.val, hxN⟩ ∈ center Matrix.PSL3Two.PSL :=
    (Subgroup.centerCongr e ⟨_, hc⟩).property
  rw [Matrix.PSL3Two.Automorphisms.center_psl_eq_bot, mem_bot] at he
  apply mem_bot.mpr
  apply Subtype.ext
  exact congrArg (fun n : N => n.val) (e.map_eq_one_iff.mp he)

private theorem solvable_overgroups_of_projection {A : Type*} [Group A] [Finite A]
    (f : A →* Matrix.PSL3Two.PSL) (hf : Function.Surjective f)
    [Group.IsSolvable f.ker] (X T : Subgroup A) (hX : X ≤ f.ker)
    (hT : IsPGroup 2 T) :
    ∃ J₁ J₂ : Subgroup A, X ⊔ T ≤ J₁ ∧ X ⊔ T ≤ J₂ ∧
      Group.IsSolvable J₁ ∧ Group.IsSolvable J₂ ∧ J₁ ⊔ J₂ = ⊤ := by
  obtain ⟨P, Q, hTP, hTQ, hp, hq, hgen⟩ :=
    solvable_generating_parabolics (T.map f) (hT.map f)
  let := hp
  let := hq
  refine ⟨P.comap f, Q.comap f, sup_le ?_ (map_le_iff_le_comap.mp hTP),
    sup_le ?_ (map_le_iff_le_comap.mp hTQ),
    isSolvable_comap_of_solvable_ker f P, isSolvable_comap_of_solvable_ker f Q, ?_⟩
  · intro x hx
    change f x ∈ P
    rw [show f x = 1 from hX hx]
    exact P.one_mem
  · intro x hx
    change f x ∈ Q
    rw [show f x = 1 from hX hx]
    exact Q.one_mem
  · rw [comap_sup_eq f P Q hf, hgen, comap_top]

private theorem solvable_quotient_of_generation {A : Type*} [Group A]
    (N X T : Subgroup A) [N.Normal] [X.Normal]
    [Group.IsSolvable X] [Group.IsSolvable T]
    (hgen : N ⊔ X ⊔ T = ⊤) : Group.IsSolvable (A ⧸ N) := by
  let q := QuotientGroup.mk' N
  let X' := X.map q
  let T' := T.map q
  have htop : X' ⊔ T' = ⊤ := by
    have h := congrArg (Subgroup.map q) hgen
    simpa only [q, X', T', Subgroup.map_sup, QuotientGroup.map_mk'_self, bot_sup_eq,
      map_top_of_surjective _ (QuotientGroup.mk'_surjective N)] using h
  let : X'.Normal := (inferInstance : X.Normal).map q (QuotientGroup.mk'_surjective N)
  let : Group.IsSolvable X' := Group.isSolvable_of_surjective (q.subgroupMap_surjective X)
  let : Group.IsSolvable T' := Group.isSolvable_of_surjective (q.subgroupMap_surjective T)
  exact Group.isSolvable_of_normal_sup_eq_top X' T' htop

private theorem normal_of_centralizing_generators {A : Type*} [Group A]
    (N X T : Subgroup A) (hgen : N ⊔ X ⊔ T = ⊤)
    (hcomm : X ≤ centralizer (N : Set A)) (hnorm : T ≤ normalizer (X : Set A)) :
    X.Normal := by
  rw [← normalizer_eq_top_iff]
  apply top_unique
  rw [← hgen]
  refine sup_le (sup_le ?_ X.le_normalizer) hnorm
  apply le_normalizer_iff_commutator_le_left.mpr
  rw [commutator_eq_bot_iff_le_centralizer.mpr hcomm]
  exact bot_le

omit [Finite G] in
/-- A commutator contained in O₂(H) becomes trivial in the actual star quotient. -/
theorem star_centralizes (H K X : Subgroup G)
    (hc : ⁅X.subgroupOf H, K.subgroupOf H⁆ ≤ pCore 2 H) :
    Source.starImage H X ≤ centralizer (Source.starImage H K : Set (Source.Hstar H)) := by
  apply commutator_eq_bot_iff_le_centralizer.mp
  apply bot_unique
  change ⁅(X.subgroupOf H).map (QuotientGroup.mk' (pCore 2 H)),
    (K.subgroupOf H).map (QuotientGroup.mk' (pCore 2 H))⁆ ≤ ⊥
  rw [← map_commutator]
  have hm := map_mono (f := QuotientGroup.mk' (pCore 2 H)) hc
  simpa only [QuotientGroup.map_mk'_self] using hm

omit [Finite G] in
/-- The source product H = KXT generates the whole star quotient. -/
theorem star_generation (H K X T : Subgroup G)
    (hK : K ≤ H) (hX : X ≤ H) (hT : T ≤ H) (hgen : K ⊔ X ⊔ T = H) :
    Source.starImage H K ⊔ Source.starImage H X ⊔ Source.starImage H T = ⊤ := by
  have hs : (K.subgroupOf H ⊔ X.subgroupOf H) ⊔ T.subgroupOf H = ⊤ := by
    rw [← subgroupOf_sup hK hX, ← subgroupOf_sup (sup_le hK hX) hT, hgen,
      subgroupOf_self]
  have hm := congrArg (Subgroup.map (QuotientGroup.mk' (pCore 2 H))) hs
  simpa only [Source.starImage, Subgroup.map_sup,
    map_top_of_surjective _ (QuotientGroup.mk'_surjective _)] using hm

omit [Finite G] in
/-- T-normalization descends to the star images of subgroups contained in H. -/
theorem star_normalizes (H X T : Subgroup G) (hX : X ≤ H)
    (hn : T ≤ normalizer (X : Set G)) :
    Source.starImage H T ≤ normalizer (Source.starImage H X : Set (Source.Hstar H)) := by
  have hi : T.subgroupOf H ≤ normalizer (X.subgroupOf H : Set H) := by
    rw [← subgroupOf_normalizer_eq hX]
    exact comap_mono hn
  exact (map_mono hi).trans (le_normalizer_map _)

omit [Finite G] in
/-- Derive normality of X* from the three generators of H*. -/
theorem star_normal_of_centralizing (H K X T : Subgroup G)
    (hK : K ≤ H) (hX : X ≤ H) (hT : T ≤ H) (hgen : K ⊔ X ⊔ T = H)
    (hc : ⁅X.subgroupOf H, K.subgroupOf H⁆ ≤ pCore 2 H)
    (hn : T ≤ normalizer (X : Set G)) : (Source.starImage H X).Normal :=
  normal_of_centralizing_generators _ _ _ (star_generation H K X T hK hX hT hgen)
    (star_centralizes H K X hc) (star_normalizes H X T hX hn)

private theorem source_solvable_preimages (H X T G₁ : Subgroup G)
    (hX : X ≤ H) (hT : T ≤ H) (hH : H ≤ G₁)
    (f : H →* Matrix.PSL3Two.PSL) (hf : Function.Surjective f)
    [Group.IsSolvable f.ker] (hx : X.subgroupOf H ≤ f.ker) (ht : IsPGroup 2 T) :
    ∃ J₁ J₂ : Subgroup G, X ⊔ T ≤ J₁ ∧ J₁ ≤ G₁ ∧ X ⊔ T ≤ J₂ ∧ J₂ ≤ G₁ ∧
      Group.IsSolvable J₁ ∧ Group.IsSolvable J₂ ∧ J₁ ⊔ J₂ = H := by
  obtain ⟨P, Q, hp, hq, hps, hqs, hgen⟩ := solvable_overgroups_of_projection f hf
    (X.subgroupOf H) (T.subgroupOf H) hx (ht.of_equiv (subgroupOfEquivOfLe hT).symm)
  let := hps
  let := hqs
  have hx' : ((X.subgroupOf H) ⊔ T.subgroupOf H).map H.subtype = X ⊔ T := by
    rw [Subgroup.map_sup, map_subgroupOf_eq_of_le hX, map_subgroupOf_eq_of_le hT]
  refine ⟨P.map H.subtype, Q.map H.subtype, ?_, (map_subtype_le P).trans hH,
    ?_, (map_subtype_le Q).trans hH,
    Group.isSolvable_of_surjective (H.subtype.subgroupMap_surjective P),
    Group.isSolvable_of_surjective (H.subtype.subgroupMap_surjective Q), ?_⟩
  · exact hx' ▸ map_mono hp
  · exact hx' ▸ map_mono hq
  · rw [← Subgroup.map_sup, hgen, ← MonoidHom.range_eq_map, range_subtype]

local instance star_normal (H K : Subgroup G) [(K.subgroupOf H).Normal] :
    (Source.starImage H K).Normal :=
  (inferInstance : (K.subgroupOf H).Normal).map _ (QuotientGroup.mk'_surjective _)

/-- Construct the solvable XT-overgroups, or the compatible full automorphism quotient.
This conditional deduction requires the external commutator bound and the actual
component identification; it does not assert those source inputs. -/
theorem source_action_alternative (H K X T G₁ : Subgroup G)
    [(K.subgroupOf H).Normal]
    (hK : K ≤ H) (hX : X ≤ H) (hT : T ≤ H) (hH : H ≤ G₁)
    (hgen : K ⊔ X ⊔ T = H) (ht : IsPGroup 2 T) (hx : Group.IsSolvable X)
    (hc : ⁅X.subgroupOf H, K.subgroupOf H⁆ ≤ pCore 2 H)
    (hn : T ≤ normalizer (X : Set G)) (e : Source.starImage H K ≃* Matrix.PSL3Two.PSL) :
    (∃ J₁ J₂ : Subgroup G, X ⊔ T ≤ J₁ ∧ J₁ ≤ G₁ ∧ X ⊔ T ≤ J₂ ∧ J₂ ≤ G₁ ∧
      Group.IsSolvable J₁ ∧ Group.IsSolvable J₂ ∧ J₁ ⊔ J₂ = H) ∨
    (∃ d : (Source.Hstar H ⧸ centralizer (Source.starImage H K : Set (Source.Hstar H))) ≃*
        MulAut Matrix.PSL3Two.PSL,
      ∀ (a : Source.Hstar H) (k : Source.starImage H K),
        d (QuotientGroup.mk' (centralizer (Source.starImage H K : Set (Source.Hstar H))) a)
          (e k) = e (MulAut.conjNormal a k)) := by
  let N := Source.starImage H K
  let X' := Source.starImage H X
  let T' := Source.starImage H T
  let q := QuotientGroup.mk' (pCore 2 H)
  let : X'.Normal := star_normal_of_centralizing H K X T hK hX hT hgen hc hn
  let := hx
  let : Group.IsSolvable (X.subgroupOf H) :=
    Group.isSolvable_of_isSolvable_injective
      (f := (subgroupOfEquivOfLe hX).toMonoidHom) (subgroupOfEquivOfLe hX).injective
  let : Group.IsSolvable X' := Group.isSolvable_of_surjective (q.subgroupMap_surjective _)
  have ht' : IsPGroup 2 T' := (ht.of_equiv (subgroupOfEquivOfLe hT).symm).map q
  let : Group.IsNilpotent T' := ht'.isNilpotent
  let : Group.IsSolvable (Source.Hstar H ⧸ N) := solvable_quotient_of_generation N X' T'
    (star_generation H K X T hK hX hT hgen)
  rcases modelAction_range_alternative N e with hr | hfull
  · left
    let π := innerProjection N e hr
    let : Group.IsSolvable π.ker := by
      rw [innerProjection_kernel]
      exact centralizer_solvable_of_quotient N e
    let : Group.IsSolvable q.ker := by
      rw [QuotientGroup.ker_mk']
      let : Group.IsNilpotent (pCore 2 H) := pCore_isNilpotent
      infer_instance
    let f := π.comp q
    let : Group.IsSolvable f.ker := by
      change Group.IsSolvable (π.comp q).ker
      rw [← MonoidHom.comap_ker]
      exact isSolvable_comap_of_solvable_ker q π.ker
    apply source_solvable_preimages H X T G₁ hX hT hH f
      ((innerProjection_surjective N e hr).comp (QuotientGroup.mk'_surjective _))
    · intro x hx
      change q x ∈ π.ker
      rw [innerProjection_kernel]
      exact star_centralizes H K X hc (mem_map_of_mem q hx)
    · exact ht
  · right
    exact ⟨fullActionEquiv N e hfull, fullActionEquiv_apply N e hfull⟩

open Representation Representation.BinaryOffender
open scoped IsMulCommutative

omit [Finite G] in
/-- The derived normality of X* promotes the earlier group seed identity to
generation of the entire source module by X*-commutators. -/
theorem source_seed_generation (H K X T V₃ V₁ : Subgroup G)
    [(V₁.subgroupOf (Source.UH H V₃)).Normal]
    [IsMulCommutative (Source.Utilde H V₃ V₁)]
    [Module (ZMod 2) (Additive (Source.Utilde H V₃ V₁))]
    (act : SourceAction H V₃ V₁)
    (hK : K ≤ H) (hX : X ≤ H) (hT : T ≤ H) (hgen : K ⊔ X ⊔ T = H)
    (hc : ⁅X.subgroupOf H, K.subgroupOf H⁆ ≤ pCore 2 H)
    (hn : T ≤ normalizer (X : Set G)) (hseed : ⁅V₃, X⁆ = V₃) :
    subspaceCommutator act.representation ⊤ (Source.starImage H X) = ⊤ := by
  exact normal_seed_generation H V₃ V₁ act X
    (star_normal_of_centralizing H K X T hK hX hT hgen hc hn)
    (seed_commutator_of_group_commutator H V₃ V₁ act X hX hseed)

omit [Finite G] in
/-- Conjugation by H* on its actual normal component image K*. -/
def sourceConjugation (H K : Subgroup G) [(K.subgroupOf H).Normal] :
    Source.Hstar H →* MulAut (Source.starImage H K) :=
  MulAut.conjNormal

omit [Finite G] in
/-- The source conjugation map uses multiplication in H/O₂(H). -/
theorem sourceConjugation_apply (H K : Subgroup G) [(K.subgroupOf H).Normal]
    (a : Source.Hstar H) (k : Source.starImage H K) :
    (sourceConjugation H K a k : Source.Hstar H) = a * k.val * a⁻¹ := rfl

omit [Finite G] in
/-- Its kernel is the literal centralizer in the source quotient. -/
theorem sourceConjugation_kernel (H K : Subgroup G) [(K.subgroupOf H).Normal] :
    (sourceConjugation H K).ker =
      centralizer (Source.starImage H K : Set (Source.Hstar H)) :=
  MulAut.conjNormal_ker_eq_centralizer _

omit [Finite G] in
/-- The action on the concrete model is transported source conjugation. -/
theorem modelAction_eq_sourceConjugation (H K : Subgroup G)
    [(K.subgroupOf H).Normal] (e : Source.starImage H K ≃* Matrix.PSL3Two.PSL) :
    modelAction (Source.starImage H K) e =
      (MulAut.congr e).toMonoidHom.comp (sourceConjugation H K) := rfl

/-- Assemble the ordinary-A₆ external geometry from the earlier source
setup and the exact component list. The rank and component identification,
commutator bound, normality, seed generation and action alternatives are
conclusions. The full-image equivalence preserves conjugation on K*; the
other branch supplies solvable overgroups of L₁T in the original group.

The explicit earlier inputs are the marked residual of 13.2.1, its ordinary
quotient order, L₁=[L₁,T], and [V₃,L₁]=V₃ recalled in 13.7.5(2).
`d` retains relative component normality from 13.8.16(1) and θ(H∩M)=L₁
from 13.7.3(9). The action is the literal source conjugation action on Ũ_H.
This completes the group geometry on printed p.956, leaving the subsequent
representation exclusion and final L₁≤K conclusion to the parent. -/
theorem ordinary_external_geometry
    (κ : GroupClass) (H K L L₁ M G₁ V₁ V₃ : Subgroup G) (T : Sylow 2 G)
    (hQTKE : IsSimpleQTKE κ G)
    (d : RankReduction.SourceSetup κ H K L₁ M G₁ T) (hout : ¬ L₁ ≤ K)
    (models : RankReduction.SmallQuotient (K ⧸ pCore 2 K))
    (eL : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 6))
    (hmarked : L₁ =
      (pResidual 2 ((L ⊔ (T : Subgroup G)) ⊓ normalizer (V₁ : Set G) : Subgroup G)).map
        ((L ⊔ (T : Subgroup G)) ⊓ normalizer (V₁ : Set G) : Subgroup G).subtype)
    (hflag : (T : Subgroup G) ≤ normalizer (V₁ : Set G))
    (horder : Nonempty ((L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 6)) →
      Nat.card (L₁ ⧸ pCore 2 L₁) = 3)
    (hfull : ⁅L₁, (T : Subgroup G)⁆ = L₁) (hseed : ⁅V₃, L₁⁆ = V₃)
    [(V₁.subgroupOf (Source.UH H V₃)).Normal]
    [IsMulCommutative (Source.Utilde H V₃ V₁)]
    [Module (ZMod 2) (Additive (Source.Utilde H V₃ V₁))]
    (act : SourceAction H V₃ V₁) :
    letI : (K.subgroupOf H).Normal := d.normal
    primeRank 3 K = 1 ∧ ∃ e : Source.starImage H K ≃* Matrix.PSL3Two.PSL,
      ⁅L₁, K⁆ ≤ (pCore 2 K).map K.subtype ∧
      ⁅L₁.subgroupOf H, K.subgroupOf H⁆ ≤ pCore 2 H ∧
      Group.IsSolvable L₁ ∧ (T : Subgroup G) ≤ normalizer (L₁ : Set G) ∧
      Source.starImage H L₁ ≤
        centralizer (Source.starImage H K : Set (Source.Hstar H)) ∧
      (Source.starImage H L₁).Normal ∧
      subspaceCommutator act.representation (seedSpace H V₃ V₁)
        (Source.starImage H L₁) = seedSpace H V₃ V₁ ∧
      subspaceCommutator act.representation ⊤ (Source.starImage H L₁) = ⊤ ∧
      (sourceConjugation H K).ker =
        centralizer (Source.starImage H K : Set (Source.Hstar H)) ∧
      ((modelAction (Source.starImage H K) e).range =
        MulAut.innerSubgroup Matrix.PSL3Two.PSL ∨
        Function.Surjective (modelAction (Source.starImage H K) e)) ∧
      ((∃ J₁ J₂ : Subgroup G,
        L₁ ⊔ (T : Subgroup G) ≤ J₁ ∧ J₁ ≤ G₁ ∧
        L₁ ⊔ (T : Subgroup G) ≤ J₂ ∧ J₂ ≤ G₁ ∧
        Group.IsSolvable J₁ ∧ Group.IsSolvable J₂ ∧
        K ⊔ L₁ ≤ J₁ ⊔ J₂ ∧ J₁ ⊔ J₂ = H) ∨
      (∃ f : (Source.Hstar H ⧸
          centralizer (Source.starImage H K : Set (Source.Hstar H))) ≃*
          MulAut Matrix.PSL3Two.PSL,
        ∀ (a : Source.Hstar H) (k : Source.starImage H K),
          f (QuotientGroup.mk'
            (centralizer (Source.starImage H K : Set (Source.Hstar H))) a)
            (e k) = e (sourceConjugation H K a k))) := by
  let : (K.subgroupOf H).Normal := d.normal
  have hKH : K ≤ H := (le_sup_left.trans le_sup_left).trans_eq d.generated
  have hLH : L₁ ≤ H := (le_sup_right.trans le_sup_left).trans_eq d.generated
  have hTH : (T : Subgroup G) ≤ H := le_sup_right.trans_eq d.generated
  have hT : Chapter1.IsSylowIn 2 (T : Subgroup G) H :=
    Chapter1.isSylowIn_iff.mpr
      ⟨T.isPGroup', hTH, fun _ hU hTU _ => T.is_maximal' hU hTU⟩
  obtain ⟨hrank, ⟨e⟩⟩ := RankReduction.rank_one_and_model d hout models
  obtain ⟨hc, hci, hs, hn⟩ :=
    OrdinaryCentralization.ordinary_external_centralization κ H K L L₁ T G₁ M V₁ V₃
      hQTKE d.local_overgroup d.sqtk hT d.generated d.component d.normal d.external hout
      eL hmarked hflag horder hfull hseed hrank e
  have hnormal := star_normal_of_centralizing H K L₁ T hKH hLH hTH d.generated hci hn
  have hseed' := seed_commutator_of_group_commutator H V₃ V₁ act L₁ hLH hseed
  refine ⟨hrank, e, hc, hci, hs, hn, star_centralizes H K L₁ hci, hnormal, hseed',
    normal_seed_generation H V₃ V₁ act L₁ hnormal hseed',
    sourceConjugation_kernel H K, modelAction_range_alternative _ e, ?_⟩
  rcases source_action_alternative H K L₁ T G₁ hKH hLH hTH d.local_overgroup.2.1
      d.generated T.isPGroup' hs hci hn e with
    ⟨J₁, J₂, hJ₁, hJ₁G, hJ₂, hJ₂G, hs₁, hs₂, hjoin⟩ | hf
  · exact Or.inl ⟨J₁, J₂, hJ₁, hJ₁G, hJ₂, hJ₂G, hs₁, hs₂,
      (sup_le hKH hLH).trans_eq hjoin.symm, hjoin⟩
  · exact Or.inr hf


end CFSG.Quasithin.Chapter13.Section08.ComponentSieve.FieldComponents.LinearThree.Geometry.ExternalComponentAction
