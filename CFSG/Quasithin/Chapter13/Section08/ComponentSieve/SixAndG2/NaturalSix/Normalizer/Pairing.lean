module
public import CFSG.Quasithin.Chapter13.Section08.ComponentSieve.SixAndG2.NaturalSix.Basic
public import Theory.Representation.BinaryPermutationNaturalDuality
public import Mathlib.GroupTheory.GroupAction.MultipleTransitivity

/-!
# The unique invariant pairing of the natural A₆ module

A commuting endomorphism preserves the unique line fixed by the alternating
Borel. Transitivity on duads forces it to be scalar everywhere. The descended
coordinate pairing is nondegenerate, so invariant bilinear forms correspond
to these commuting endomorphisms. Consequently every normalizer of the actual
alternating image preserves the pairing.

This is the pairing half of the normalizer calculation used in
Aschbacher–Smith 13.8.26–27, printed pp.962–963, on the module of §B.3,
printed pp.83–85. It retains the literal augmentation quotient and its actions.
-/

@[expose] public section
namespace CFSG.Quasithin.Chapter13.Section08.ComponentSieve.SixAndG2.NaturalSix
open BinaryPermutation
open Theory.SpecificGroups.SymmetricSix.BinaryFlags.NaturalGeometry

noncomputable abbrev pairing := naturalPairing (Fin 6)

private def pairCore (i j : Fin 6) : core (Fin 6) :=
  ⟨Pi.single i 1 + Pi.single j 1, by
    simp [mem_core, Finset.sum_add_distrib, CharTwo.add_self_eq_zero]⟩

private theorem pairCore_image (i j : Fin 6) :
    coreToNatural (Fin 6) (pairCore i j) = pairVector i j := rfl

theorem pairing_pairVector (i j k l : Fin 6) :
    pairing (pairVector i j) (pairVector k l) =
      (if i = k then 1 else 0) + (if i = l then 1 else 0) +
      ((if j = k then 1 else 0) + (if j = l then 1 else 0)) := by
  rw [← pairCore_image, ← pairCore_image, naturalPairing_apply_core]
  change dotProduct (Pi.single i 1 + Pi.single j 1)
    (Pi.single k 1 + Pi.single l 1) = _
  simp [dotProduct_add, dotProduct_single, Pi.single_apply, eq_comm]
  ring

theorem pairing_invariant (g : Symmetric) (v w : Natural) :
    pairing (symmetricAction g v) (symmetricAction g w) = pairing v w := by
  obtain ⟨a, rfl⟩ := coreToNatural_surjective v
  obtain ⟨b, rfl⟩ := coreToNatural_surjective w
  rw [← coreToNatural_equivariant, ← coreToNatural_equivariant,
    naturalPairing_apply_core, naturalPairing_apply_core]
  change (∑ i, a.val (g.symm i) * b.val (g.symm i)) = ∑ i, a.val i * b.val i
  exact Equiv.sum_comp g.symm (fun i => a.val i * b.val i)

private theorem alternating_pair_transitive (d : Duad) :
    ∃ a : Alternating, alternatingAction a (pairVector 4 5) = duadVector d := by
  have : MulAction.IsMultiplyPretransitive Alternating (Fin 6) (Nat.card (Fin 6) - 2) :=
    alternatingGroup.isMultiplyPretransitive (Fin 6)
  have ht : MulAction.IsMultiplyPretransitive Alternating (Fin 6) 2 :=
    MulAction.isMultiplyPretransitive_of_le (n := Nat.card (Fin 6) - 2) (by simp) (by simp)
  obtain ⟨a, ha, hb⟩ := MulAction.is_two_pretransitive_iff.mp ht
    (by decide : (4 : Fin 6) ≠ 5) (ne_of_lt d.property)
  refine ⟨a, ?_⟩
  change a.val 4 = d.val.1 at ha
  change a.val 5 = d.val.2 at hb
  change symmetricAction a.val (pairVector 4 5) = _
  rw [pairVector_map, ha, hb]
  rfl

/-- An endomorphism commuting with the literal alternating action is scalar. -/
theorem commuting_endomorphism_scalar (t : Module.End (ZMod 2) Natural)
    (ht : ∀ a : Alternating, ∀ v, t (alternatingAction a v) = alternatingAction a (t v)) :
    ∃ c : ZMod 2, ∀ v, t v = c • v := by
  have hfixed (g : Symmetric) (hg : g ∈ T0) :
      symmetricAction g (pairVector 4 5) = pairVector 4 5 := by
    rcases Theory.SpecificGroups.SymmetricSix.BinaryFlags.mem_H1_cases hg.1.1 with h | h
    · rw [pairVector_map, h.1, h.2]
    · rw [pairVector_map, h.1, h.2, pairVector_comm]
  obtain ⟨c, hc⟩ : ∃ c : ZMod 2, t (pairVector 4 5) = c • pairVector 4 5 := by
    by_cases hz : t (pairVector 4 5) = 0
    · exact ⟨0, by simpa using hz⟩
    let W := Submodule.span (ZMod 2) {t (pairVector 4 5)}
    have hw : W = canonicalLine := canonicalLine_unique W
      (finrank_span_singleton hz) (by
        intro g hg
        change Submodule.map _ (Submodule.span (ZMod 2) {t (pairVector 4 5)}) = _
        rw [Submodule.map_span, Set.image_singleton]
        have he := ht ⟨g, hg.2⟩ (pairVector 4 5)
        change t (symmetricAction g (pairVector 4 5)) =
          symmetricAction g (t (pairVector 4 5)) at he
        rw [hfixed g hg] at he
        rw [← he])
    have hm : t (pairVector 4 5) ∈ canonicalLine := hw ▸ Submodule.subset_span (by simp)
    obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp hm
    exact ⟨c, hc.symm⟩
  refine ⟨c, fun v => ?_⟩
  rcases vector_cases v with rfl | ⟨d, rfl⟩
  · simp
  obtain ⟨a, ha⟩ := alternating_pair_transitive d
  rw [← ha, ht, hc, map_smul]

/-- The invariant bilinear forms form the line generated by the dot pairing. -/
theorem invariant_pairing_scalar (B : Natural →ₗ[ZMod 2] Natural →ₗ[ZMod 2] ZMod 2)
    (hB : ∀ a : Alternating, ∀ v w,
      B (alternatingAction a v) (alternatingAction a w) = B v w) :
    ∃ c : ZMod 2, ∀ v w, B v w = c * pairing v w := by
  let E : Natural ≃ₗ[ZMod 2] Module.Dual (ZMod 2) Natural :=
    LinearEquiv.ofBijective pairing ⟨naturalPairing_injective (Fin 6),
      (LinearMap.injective_iff_surjective_of_finrank_eq_finrank (by simp)).mp
        (naturalPairing_injective (Fin 6))⟩
  let t : Module.End (ZMod 2) Natural := E.symm.toLinearMap.comp B
  have htB (v w : Natural) : pairing (t v) w = B v w :=
    LinearMap.congr_fun (E.apply_symm_apply (B v)) w
  have ht (a : Alternating) (v : Natural) :
      t (alternatingAction a v) = alternatingAction a (t v) := by
    apply naturalPairing_injective (Fin 6)
    apply LinearMap.ext
    intro w
    obtain ⟨z, rfl⟩ := (Module.End.isUnit_iff _).mp (alternatingHom a).isUnit |>.2 w
    change pairing (t (alternatingAction a v)) (alternatingAction a z) =
      pairing (alternatingAction a (t v)) (alternatingAction a z)
    rw [htB, hB]
    exact (htB v z).symm.trans (pairing_invariant a.val (t v) z).symm
  obtain ⟨c, hc⟩ := commuting_endomorphism_scalar t ht
  refine ⟨c, fun v w => ?_⟩
  rw [← htB, hc]
  simp

/-- Any operator normalizing the actual alternating image preserves its pairing. -/
theorem normalizer_preserves_pairing (u : LinearGroup)
    (hu : u ∈ Subgroup.normalizer (alternatingImage : Set LinearGroup)) :
    ∀ v w, pairing (u.val v) (u.val w) = pairing v w := by
  let B := pairing.compl₁₂ u.val u.val
  have hB (a : Alternating) (v w : Natural) :
      B (alternatingAction a v) (alternatingAction a w) = B v w := by
    have hm := (Subgroup.mem_normalizer_iff.mp hu (alternatingHom a)).mp ⟨a, rfl⟩
    obtain ⟨b, hb⟩ := hm
    have he : u * alternatingHom a = alternatingHom b * u := by
      rw [hb, mul_assoc, mul_assoc, inv_mul_cancel, mul_one]
    have hv (x : Natural) : u.val (alternatingAction a x) = alternatingAction b (u.val x) :=
      LinearMap.congr_fun (congrArg Units.val he) x
    change pairing (u.val (alternatingAction a v)) (u.val (alternatingAction a w)) = _
    rw [hv, hv]
    exact pairing_invariant b.val _ _
  obtain ⟨c, hc⟩ := invariant_pairing_scalar B hB
  have hc1 : c = 1 := by
    fin_cases c
    · obtain ⟨v, hv⟩ := ((Module.End.isUnit_iff u.val).mp u.isUnit).2 (pairVector 0 1)
      obtain ⟨w, hw⟩ := ((Module.End.isUnit_iff u.val).mp u.isUnit).2 (pairVector 0 2)
      have h := hc v w
      change pairing (u.val v) (u.val w) = 0 * pairing v w at h
      rw [hv, hw, zero_mul] at h
      have hn : pairing (pairVector 0 1) (pairVector 0 2) = 1 := by
        rw [pairing_pairVector]
        decide
      exact (zero_ne_one (h.symm.trans hn)).elim
    · rfl
  intro v w
  change B v w = pairing v w
  rw [hc, hc1, one_mul]
end CFSG.Quasithin.Chapter13.Section08.ComponentSieve.SixAndG2.NaturalSix
