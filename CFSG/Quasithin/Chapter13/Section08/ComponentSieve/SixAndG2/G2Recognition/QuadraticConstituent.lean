/-!
# G₂ constituents from the actual quadratic critical actor

Restrict to the subgroup generated by the component and its elementary
quadratic actor. The no-strong-offender and no-transvection argument makes
every proper invariant subspace component-central. Hence the fixed space
is maximal, and its quotient is irreducible for the generated subgroup.
The quadratic supplement theorem makes that quotient irreducible on the
component itself. Transport through the literal top central quotient gives
Irr⁺ on the whole original module, allowing its central subspace.

Every Irr⁺ member is therefore the whole module. Its two orbit spans are
unchanged, and the same faithful quadratic actor proves both action-image
ratio bounds. This constructs the precise OrbitInputs used in the original
14.7.53 G₂ exclusion without assuming F.9.18 or a recognized module.
Source: Aschbacher–Smith13.8.22,13.8.27,14.7.54, pp.957,963,1065–1066;
quadratic orbit argument D.3.5, pp.195–196, and F.9.18(3–4), pp.325–326.
-/

public noncomputable section
open Subgroup Representation Representation.BinaryOffender Theory.GroupTheory
namespace CFSG.Quasithin.Chapter13.Section08.ComponentSieve.SixAndG2.G2Recognition
variable {D V : Type*} [Group D] [Finite D] [AddCommGroup V]
  [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V]
  (ρ : Representation (ZMod 2) D V) (L : Subgroup D) [L.Normal] [IsQuasisimple L]

/-- The literal fixed quotient is irreducible on the G₂ component. -/
theorem whole_isIrrPlus_of_quadratic_supplement
    (hf : Function.Injective ρ)
    (hc : centralizer (L : Set D) = ⊥)
    (hZ : center L = ⊥)
    (e : L ≃* commutator (Atlas.G2.Model (ZMod 2)))
    (hgen : subspaceCommutator ρ ⊤ L = ⊤)
    (A : Subgroup D) (hLA : L ⊔ A = ⊤) (hA : IsElementaryTwo A)
    (hq : IsQuadratic ρ A) (hb : fixedCodim ρ A ≤ 2 * rank A)
    (B : Submodule (ZMod 2) V)
    (hcritical : B ≤ fixedSpace ρ A ∨ ∃ S : Submodule (ZMod 2) V,
      IsAtom S ∧ ∀ a ∈ A, ∀ d ∈ B, ρ a d - d ∈ S)
    (hdim : Module.finrank (ZMod 2) (V ⧸ B) ≤ rank A) :
    IsIrrPlus ρ L ⊤ := by
  have hn : ¬ L ≤ ρ.ker := by
    intro hl
    have hbot : L = ⊥ := bot_unique (by
      intro x hx
      exact hf ((hl hx).trans (map_one _).symm))
    let : IsSimpleGroup (L ⧸ center L) := IsQuasisimple.simple
    let : Nontrivial L := (QuotientGroup.mk'_surjective (center L)).nontrivial
    exact ((nontrivial_iff_ne_bot L).mp inferInstance) hbot
  let C := fixedSubrepresentation ρ L
  have hC : IsCoatom C := by
    refine ⟨?_,?_⟩
    · intro he
      apply hn
      intro l hl
      apply LinearMap.ext
      intro v
      have hv : v ∈ C := he.symm ▸ (show v ∈ (⊤ : Subrepresentation ρ) from trivial)
      exact hv ⟨l,hl⟩
    · intro N hN
      rcases proper_submodules_central ρ L hc e hgen A hA B hcritical hdim N with he | hn
      · exact he
      · exact ((not_le_of_gt hN) hn).elim
  have hi : IsIrreducible C.quotientRepresentation :=
    SimpleHeadQuotient.irreducible_quotient_of_isCoatom C hC
  have hqC : IsQuadratic C.quotientRepresentation A :=
    quadratic_of_equivariant_surjection ρ C.quotientRepresentation
      C.toSubmodule.mkQ C.toSubmodule.mkQ_surjective (fun _ _ => rfl) A hq
  have hbC : fixedCodim C.quotientRepresentation A ≤ 2 * rank A := by
    have hh := fixedCodim_quotient_add_subrepresentation_le ρ C A
    omega
  have hAC : A ⊓ centralizer (L : Set D) = ⊥ := by rw [hc,inf_bot_eq]
  have hnc : ¬ (⊤ : Submodule (ZMod 2) (V ⧸ C.toSubmodule)) ≤
      fixedSpace C.quotientRepresentation L := by
    intro hh
    apply fixedQuotient_noncentral ρ L hn
    intro l hl
    exact LinearMap.ext (fun v => hh Submodule.mem_top ⟨l,hl⟩)
  have hri := component_irreducible_of_quadratic_supplement C.quotientRepresentation
    L A hZ hLA hA hqC hbC hAC hi hnc
  have hs : L ≤ subspaceStabilizer ρ (⊤ : Submodule (ZMod 2) V) :=
    le_subspaceStabilizer ρ ⊤ (by intros; trivial)
  refine ⟨hs,hgen,?_⟩
  let E : RepEquiv (centralQuotientRepresentation ρ L ⊤ hs)
      (C.quotientRepresentation.comp L.subtype) := {
    toLinearEquiv := topCentralQuotientEquiv ρ L
    isIntertwining' := by
      intro l
      exact LinearMap.ext (fun v => topCentralQuotientEquiv_intertwines ρ L hs l v) }
  exact (RepEquiv.irreducible_euqiv E).mpr hri

open Chapter15.Section03.AbelianAmalgam.GenerationOne.OriginalModule.Normal

/-- Restriction to the component-actor join removes the supplement hypothesis. -/
theorem whole_isIrrPlus_of_quadratic_actor
    (hf : Function.Injective ρ)
    (hc : centralizer (L : Set D) = ⊥)
    (hZ : center L = ⊥)
    (e : L ≃* commutator (Atlas.G2.Model (ZMod 2)))
    (hgen : subspaceCommutator ρ ⊤ L = ⊤)
    (A : Subgroup D) (hA : IsElementaryTwo A)
    (hq : IsQuadratic ρ A) (hb : fixedCodim ρ A ≤ 2 * rank A)
    (B : Submodule (ZMod 2) V)
    (hcritical : B ≤ fixedSpace ρ A ∨ ∃ S : Submodule (ZMod 2) V,
      IsAtom S ∧ ∀ a ∈ A, ∀ d ∈ B, ρ a d - d ∈ S)
    (hdim : Module.finrank (ZMod 2) (V ⧸ B) ≤ rank A) :
    IsIrrPlus ρ L ⊤ := by
  let H := L ⊔ A
  let L₀ := L.subgroupOf H
  let A₀ := A.subgroupOf H
  let τ := ρ.comp H.subtype
  let : IsQuasisimple L₀ := componentInSup_quasisimple L A
  have hc₀ : centralizer (L₀ : Set H) = ⊥ := by
    apply bot_unique
    intro a ha
    apply Subtype.ext
    apply mem_bot.mp
    rw [← hc]
    intro l hl
    exact congrArg Subtype.val (ha ⟨l,(le_sup_left : L ≤ H) hl⟩ hl)
  have hg₀ : subspaceCommutator τ ⊤ L₀ = ⊤ := by
    rw [subspaceCommutator_comp_map, map_subgroupOf_eq_of_le (show L ≤ H from le_sup_left)]
    exact hgen
  have hcrit₀ : B ≤ fixedSpace τ A₀ ∨ ∃ S : Submodule (ZMod 2) V,
      IsAtom S ∧ ∀ a ∈ A₀, ∀ d ∈ B, τ a d - d ∈ S := by
    rcases hcritical with hs | ⟨S,hS,hs⟩
    · exact Or.inl (by rwa [fixedSpace_subgroupOf ρ A H le_sup_right])
    · exact Or.inr ⟨S,hS,fun a ha d hd => hs a ha d hd⟩
  apply (IsIrrPlus.subgroupOf_iff ρ L H le_sup_left ⊤).mp
  apply whole_isIrrPlus_of_quadratic_supplement τ L₀
    (hf.comp H.subtype_injective) hc₀ (componentInSup_center L A hZ)
    ((componentInSupEquiv L A).trans e) hg₀ A₀ (componentInSup_generated L A)
    (actorInSup_elementary L A hA) (actorInSup_quadratic ρ L A hq)
    (actorInSup_bound ρ L A hb) B hcrit₀
  rwa [rank_subgroupOf (show A ≤ H from le_sup_right)]

open FieldComponents.SmallCovers.Reduction.LocalGeometry.DynkinExclusion.OrbitInvariance
open CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.GenerationOne.RepresentationReduction.SourceRestrictions.Cases

private theorem ratio_of_top_subrepresentation
    (hf : Function.Injective ρ) (A : Subgroup D) (hA : IsElementaryTwo A)
    (hq : IsQuadratic ρ A) (hb : fixedCodim ρ A ≤ 2 * rank A)
    (R : Subrepresentation ρ) (hR : R.toSubmodule = ⊤) :
    quadraticRatio (imageRepresentation R.toRepresentation) ≤ 2 := by
  have hfaith : ∀ a ∈ A, (∀ v, R.toRepresentation a v = v) → a = 1 := by
    intro a ha he
    apply hf
    rw [map_one]
    apply LinearMap.ext
    intro v
    exact congrArg Subtype.val (he ⟨v,hR.symm ▸ Submodule.mem_top⟩)
  apply (quadraticRatio_le_two_iff _).mpr
  refine ⟨actionSubgroup R.toRepresentation A, hA.actionSubgroup _ hfaith,
    quadratic_actionSubgroup _ (quadratic_subrepresentation ρ R hq),?_⟩
  rw [fixedCodim_actionSubgroup, actionSubgroup_rank _ A hfaith]
  exact (fixedCodim_subrepresentation_le ρ R A).trans hb

omit [IsQuasisimple L] in
/-- A whole Irr⁺ module has only its whole-space orbit member. The same
faithful quadratic actor supplies both literal action-image ratio bounds. -/
theorem orbitInputs_of_whole_isIrrPlus
    (hf : Function.Injective ρ) (hi : IsIrrPlus ρ L ⊤)
    (A : Subgroup D) (hA : IsElementaryTwo A)
    (hq : IsQuadratic ρ A) (hb : fixedCodim ρ A ≤ 2 * rank A)
    (P : Sylow 2 D) (hLP : L ⊔ (P : Subgroup D) = ⊤) :
    OrbitInputs ρ L P hLP := by
  have htop (I : Submodule (ZMod 2) V) (hI : IsIrrPlusWith ρ L P I) : I = ⊤ :=
    hI.isIrrPlus.eq_of_le ρ hi le_top
  refine ⟨?_,?_⟩
  · intro I hI
    have horbit (S : Subgroup D) : orbitSpan ρ S I = ⊤ := by
      apply top_unique
      rw [← htop I hI]
      exact le_orbitSpan ρ S I
    exact ⟨ratio_of_top_subrepresentation ρ hf A hA hq hb _ (horbit P),
      ratio_of_top_subrepresentation ρ hf A hA hq hb _ (horbit ⊤)⟩
  · intro I hI
    left
    rw [htop I hI]
    exact le_subspaceStabilizer ρ ⊤ (by intros; trivial)

end CFSG.Quasithin.Chapter13.Section08.ComponentSieve.SixAndG2.G2Recognition
