module

public import Theory.Representation.BinaryPermutationNaturalCover

/-!
# The natural A₆ module and its precise five-dimensional cover

The augmentation module on six letters is a perfect central cover of
the four-dimensional deleted permutation module. The known one-dimensional
first cohomology, transported through self-duality, makes every nontrivial
perfect central cover isomorphic to this augmentation module. The resulting
linear equivalence both intertwines the A₆ action and commutes with the
given projection onto the natural module.

This supplies the cover comparison invoked at the end of Aschbacher–Smith
13.8.26, printed p.962, using I.1.5–6, printed p.408, and the concrete modules
of §B.3. It reuses the repository's even-degree cohomology and universal-cover
construction. The source application must still produce its natural quotient,
its projection with central kernel and commutator-generated source, and the
marking under which `L₁` has two noncentral chief factors. None of those
conditions is inferred solely from the dimension of the module.
-/

public section

open Module Representation Representation.OneCohomology Equiv BinaryPermutation
namespace CFSG.Quasithin.Chapter13.Section08.ComponentSieve.SixAndG2

private lemma commutator_stable {k G W : Type*} [Field k] [Group G]
    [AddCommGroup W] [Module k W] (ρ : Representation k G W) (g : G) :
    Coinvariants.ker ρ ≤ (Coinvariants.ker ρ).comap (ρ g) := by
  apply Submodule.span_le.mpr
  rintro _ ⟨⟨h, v⟩, rfl⟩
  change ρ g (ρ h v - v) ∈ Coinvariants.ker ρ
  have he : ρ g (ρ h v - v) = (ρ (g * h) v - v) - (ρ g v - v) := by
    rw [map_sub, map_mul, Module.End.mul_apply]
    abel
  rw [he]
  exact (Coinvariants.ker ρ).sub_mem (Coinvariants.sub_mem_ker _ _)
    (Coinvariants.sub_mem_ker _ _)

/-- The augmentation module of A₆ is generated by its commutators. -/
lemma alternatingSix_core_generated :
    Coinvariants.ker (alternatingCoreRepresentation (Fin 6)) = ⊤ := by
  let ρ := alternatingCoreRepresentation (Fin 6)
  let C := Coinvariants.ker ρ
  let D := C.map (core (Fin 6)).subtype
  have hD : ∀ g : alternatingGroup (Fin 6), ∀ v ∈ D,
      representation (Fin 6) g.val v ∈ D := by
    intro g v hv
    obtain ⟨u, hu, rfl⟩ := hv
    exact ⟨ρ g u, commutator_stable ρ g hu, rfl⟩
  rcases invariant_le_constants_or_core_le (by decide : 5 ≤ Fintype.card (Fin 6)) D hD
      with h | h
  · let g : alternatingGroup (Fin 6) := ⟨swap 0 1 * swap 1 2, by
      simp [Perm.mem_alternatingGroup]⟩
    let v : core (Fin 6) := ⟨Pi.single 0 1 + Pi.single 3 1, by
      simp [mem_core, Finset.sum_add_distrib, CharTwo.add_self_eq_zero]⟩
    have hv : ρ g v - v ∈ C := Coinvariants.sub_mem_ker g v
    obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp (h ⟨ρ g v - v, hv, rfl⟩)
    have hconst : (ρ g v - v).val 0 = (ρ g v - v).val 4 := by
      exact (congrFun hc.symm 0).trans (congrFun hc 4)
    have hne : (ρ g v - v).val 0 ≠ (ρ g v - v).val 4 := by decide
    exact (hne hconst).elim
  · apply top_unique
    intro v _
    obtain ⟨u, hu, he⟩ := h v.property
    have : u = v := Subtype.ext he
    exact this ▸ hu

/-- The five-dimensional augmentation module is a perfect central cover. -/
lemma alternatingSix_coreProjection_isCover :
    IsCover (alternatingCoreProjection (Fin 6)) := by
  refine ⟨coreToNatural_surjective, ?_, alternatingSix_core_generated⟩
  intro v hv g
  have hv' : v.val ∈ constants (Fin 6) := by
    apply (Submodule.Quotient.mk_eq_zero _).mp
    exact congrArg Subtype.val hv
  obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp hv'
  apply Subtype.ext
  change representation (Fin 6) g.val v.val = v.val
  rw [← hc, map_smul, permute_allOne]
/-- Self-duality transfers I.1.6(1) to the coefficients used in I.1.5. -/
lemma alternatingSix_natural_dual_finrank_H1 :
    finrank (ZMod 2) (H1 (alternatingNaturalRepresentation (Fin 6)).dual) = 1 := by
  let E := H1Congr (alternatingNaturalRepresentation (Fin 6))
    (alternatingNaturalRepresentation (Fin 6)).dual
    (MulEquiv.refl (alternatingGroup (Fin 6))) (naturalDualEquiv (Fin 6))
    (fun g v => naturalDualEquiv_equivariant (Fin 6) g.val v)
  rw [← E.finrank_eq]
  exact BinaryPermutation.alternatingSix_natural_finrank_H1


section Comparison
variable {k G N V W : Type*} [Field k] [Group G]
  [AddCommGroup N] [Module k N] [FiniteDimensional k N]
  [AddCommGroup V] [Module k V] [FiniteDimensional k V]
  [AddCommGroup W] [Module k W] [FiniteDimensional k W]
  {ρ : Representation k G N} {σ : Representation k G V} {τ : Representation k G W}

/-- A nontrivial cover is identified with a cover of maximal dimension. -/
private lemma cover_equiv_commuting [Finite G]
    (p : σ.IntertwiningMap ρ) (hp : IsCover p)
    (q : τ.IntertwiningMap ρ) (hq : IsCover q)
    (hH : finrank k (H1 ρ.dual) = 1)
    (hV : p.toLinearMap.ker ≠ ⊥)
    (hW : finrank k W = finrank k N + 1) :
    ∃ f : V ≃ₗ[k] W, (∀ g v, f (σ g v) = τ g (f v)) ∧
      (∀ v, q (f v) = p v) := by
  have : FiniteDimensional k (Module.Dual k (cocycles ρ.dual)) :=
    Subspace.instModuleDualFiniteDimensional (K := k) (V := cocycles ρ.dual)
  obtain ⟨a, ha, hap⟩ := exists_universalCover_quotient p hp
  obtain ⟨b, hb, hbq⟩ := exists_universalCover_quotient q hq
  let u := universalCoverProjection ρ
  have hu : Function.Surjective u := by
    intro n
    obtain ⟨v, rfl⟩ := hp.1 n
    obtain ⟨x, rfl⟩ := ha v
    exact ⟨x, (hap x).symm⟩
  have hU := u.toLinearMap.finrank_range_add_finrank_ker
  rw [LinearMap.range_eq_top.mpr hu, finrank_top,
    finrank_ker_universalCoverProjection, hH] at hU
  have hVp := p.toLinearMap.finrank_range_add_finrank_ker
  rw [LinearMap.range_eq_top.mpr hp.1, finrank_top] at hVp
  have hpos : 0 < finrank k p.toLinearMap.ker := by
    have : finrank k p.toLinearMap.ker ≠ 0 := fun h =>
      hV (Submodule.finrank_eq_zero.mp h)
    omega
  have hle := LinearMap.finrank_le_finrank_of_surjective (f := a.toLinearMap) ha
  have hVU : finrank k V = finrank k (Module.Dual k (cocycles ρ.dual)) := by omega
  have hWU : finrank k W = finrank k (Module.Dual k (cocycles ρ.dual)) := by omega
  let A := LinearEquiv.ofBijective a.toLinearMap
    ⟨(LinearMap.injective_iff_surjective_of_finrank_eq_finrank hVU.symm).mpr ha, ha⟩
  let B := LinearEquiv.ofBijective b.toLinearMap
    ⟨(LinearMap.injective_iff_surjective_of_finrank_eq_finrank hWU.symm).mpr hb, hb⟩
  refine ⟨A.symm.trans B, ?_, ?_⟩
  · intro g v
    have he : A.symm (σ g v) = (universalAction ρ.dual).dual g (A.symm v) := by
      apply A.injective
      change A (A.symm (σ g v)) = a ((universalAction ρ.dual).dual g (A.symm v))
      rw [A.apply_symm_apply, a.isIntertwining]
      exact congrArg (σ g) (A.apply_symm_apply v).symm
    change B (A.symm (σ g v)) = τ g (B (A.symm v))
    rw [he]
    change b ((universalAction ρ.dual).dual g (A.symm v)) = τ g (b (A.symm v))
    exact LinearMap.congr_fun (b.isIntertwining' g) (A.symm v)
  · intro v
    change q (b (A.symm v)) = p v
    rw [hbq, ← hap]
    exact congrArg p (A.apply_symm_apply v)
end Comparison

variable {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]
  [FiniteDimensional (ZMod 2) V]
  {σ : Representation (ZMod 2) (alternatingGroup (Fin 6)) V}

/-- The nontrivial perfect central cover has actual augmentation coordinates,
and these coordinates commute with the specified natural projection. -/
theorem augmentation_equiv_of_nontrivial_cover
    (p : σ.IntertwiningMap (alternatingNaturalRepresentation (Fin 6)))
    (hp : IsCover p) (hker : p.toLinearMap.ker ≠ ⊥) :
    ∃ E : V ≃ₗ[ZMod 2] core (Fin 6),
      (∀ g v, E (σ g v) = alternatingCoreRepresentation (Fin 6) g (E v)) ∧
      (∀ v, coreToNatural (Fin 6) (E v) = p v) := by
  exact cover_equiv_commuting p hp (alternatingCoreProjection (Fin 6))
    alternatingSix_coreProjection_isCover alternatingSix_natural_dual_finrank_H1 hker (by
      rw [finrank_core, finrank_natural_even (Fin 6) (by decide)]
      decide)

/-- A perfect central cover is either the natural module itself or the
five-dimensional augmentation module, with its projection retained. -/
theorem natural_or_augmentation_of_cover
    (p : σ.IntertwiningMap (alternatingNaturalRepresentation (Fin 6)))
    (hp : IsCover p) :
    (∃ E : V ≃ₗ[ZMod 2] natural (Fin 6),
      (∀ g v, E (σ g v) = alternatingNaturalRepresentation (Fin 6) g (E v)) ∧
      (∀ v, E v = p v)) ∨
    (∃ E : V ≃ₗ[ZMod 2] core (Fin 6),
      (∀ g v, E (σ g v) = alternatingCoreRepresentation (Fin 6) g (E v)) ∧
      (∀ v, coreToNatural (Fin 6) (E v) = p v)) := by
  by_cases hk : p.toLinearMap.ker = ⊥
  · left
    let E := LinearEquiv.ofBijective p.toLinearMap
      ⟨LinearMap.ker_eq_bot.mp hk, hp.1⟩
    exact ⟨E, fun g v => LinearMap.congr_fun (p.isIntertwining' g) v, fun _ => rfl⟩
  · exact Or.inr (augmentation_equiv_of_nontrivial_cover p hp hk)

end CFSG.Quasithin.Chapter13.Section08.ComponentSieve.SixAndG2
