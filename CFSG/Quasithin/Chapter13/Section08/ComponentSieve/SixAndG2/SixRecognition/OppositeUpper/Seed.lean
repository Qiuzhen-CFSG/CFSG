module

public import CFSG.Quasithin.Chapter13.Section08.ComponentSieve.SixAndG2.SixRecognition.Strict
public import CFSG.Quasithin.Chapter13.Section08.LocalAnalysis.TransvectionModules.Basic

/-!
# The original upper section is generated by a parabolic-fixed vector

The image of the index-two source seed in V_H/U_H is a binary line. Its
normalizer therefore fixes its nonzero vector, and the H-conjugate span of
the seed proves that the vector generates the entire upper representation.
This constructs the actual coset-permutation surjection for any displayed
`UpperSection`, rather than just for one choice of quotient coordinates.
The original commutator noncontainment supplies a moved vector on this same
carrier. No natural quotient or parabolic marking is assumed here.

Source: Aschbacher–Smith 13.8.4(5), printed p.947, used in 13.8.26, p.962.
-/

@[expose] public section

open Representation Subgroup
open scoped commutatorElement
namespace CFSG.Quasithin.Chapter13.Section08.ComponentSieve.SixAndG2.SixRecognition.OppositeUpper
open AlternatingAndLinear.FourStructure.CriticalTransfer.PairConsequences

variable {J E : Type*} [Group J] [AddCommGroup E] [Module (ZMod 2) E]

/-- The generator condition for a quotient of the actual coset permutation
module. Its vector is fixed by the specified subgroup, not by an abstract
parabolic with an unrelated action. -/
def IsParabolicCyclic (τ : Representation (ZMod 2) J E) (P : Subgroup J) : Prop :=
  ∃ v : E, (∀ a ∈ P, τ a v = v) ∧
    Submodule.span (ZMod 2) (Set.range fun a => τ a v) = ⊤

/-- The fixed cyclic vector constructs an equivariant surjection from the
literal left-coset permutation module. -/
theorem IsParabolicCyclic.permutation_surjection
    {τ : Representation (ZMod 2) J E} {P : Subgroup J}
    [Fintype (J ⧸ P)] (h : IsParabolicCyclic τ P) :
    ∃ f : Representation.IntertwiningMap
        ((BinaryPermutation.representation (J ⧸ P)).comp
          (MulAction.toPermHom J (J ⧸ P))) τ,
      Function.Surjective f := by
  classical
  obtain ⟨v, hv, hs⟩ := h
  let d := cosetPermutationSectionData τ P v hv hs
  exact ⟨d.intertwiningMap, d.intertwiningMap_surjective⟩

variable {G : Type*} [Group G] {H VH UH : Subgroup G}
  {τ : Representation (ZMod 2) (Source.Hstar H) E}

/-- The source quotient map, index-two seed and normal generation provide
the cyclic vector with its original subgroup of actors. -/
theorem cyclic_of_index_two_seed (t : UpperSection H VH UH τ)
    (X P : Subgroup G) (hXV : X ≤ VH)
    (hspan : VH = conjugateSpanBy X H) (hindex : UH.relIndex X = 2)
    (hnorm : P ≤ normalizer (X : Set G)) :
    IsParabolicCyclic τ (Source.starImage H P) := by
  obtain ⟨x, hx, hxu, hcosets⟩ := relIndex_eq_two_iff_exists_notMem_and.mp hindex
  let xV : VH := ⟨x, hXV hx⟩
  let v : E := (t.quotient xV).toAdd
  have hneg : -v = v := by
    calc
      -v = (-1 : ZMod 2) • v := (neg_one_smul (ZMod 2) v).symm
      _ = v := by rw [show (-1 : ZMod 2) = 1 from by decide, one_smul]
  have hseed (y : VH) (hy : (y : G) ∈ X) :
      (t.quotient y).toAdd = 0 ∨ (t.quotient y).toAdd = v := by
    rcases hcosets y hy with h | h
    · right
      have hh : (t.quotient (y * xV)).toAdd = 0 := by
        change y * xV ∈ t.quotient.ker
        rwa [t.kernel]
      rw [map_mul] at hh
      exact (eq_neg_of_add_eq_zero_left hh).trans hneg
    · left
      change y ∈ t.quotient.ker
      rwa [t.kernel]
  refine ⟨v, ?_, ?_⟩
  · rintro _ ⟨a, ha, rfl⟩
    have hyX : (a : G) * x * (a : G)⁻¹ ∈ X :=
      (mem_normalizer_iff.mp (hnorm ha) x).mp hx
    let y : VH := ⟨(a : G) * x * (a : G)⁻¹, hXV hyX⟩
    have he : τ (QuotientGroup.mk' (pCore 2 H) a) v = (t.quotient y).toAdd :=
      t.conjugates a xV
    rw [he]
    rcases hseed y hyX with hy | hy
    · have hyU : (y : G) ∈ UH := by
        change y ∈ UH.subgroupOf VH
        rw [← t.kernel]
        exact hy
      exact (hxu ((mem_normalizer_iff.mp (t.normalizes_kernel a.property) x).mpr hyU)).elim
    · exact hy
  · let S := Submodule.span (ZMod 2) (Set.range (fun g => τ g v))
    let K : Subgroup G := ((S.toAddSubgroup.toSubgroup').comap t.quotient).map VH.subtype
    have hVK : VH ≤ K := by
      rw [hspan]
      apply (closure_le _).mpr
      rintro _ ⟨a, ha, y, hy, rfl⟩
      let yV : VH := ⟨y, hXV hy⟩
      refine ⟨⟨a * y * a⁻¹,
        (mem_normalizer_iff.mp (t.normalizes ha) y).mp (hXV hy)⟩, ?_, rfl⟩
      change (t.quotient _).toAdd ∈ S
      rw [← t.conjugates ⟨a, ha⟩ yV]
      rcases hseed yV hy with he | he
      · rw [he, map_zero]
        exact S.zero_mem
      · rw [he]
        exact Submodule.subset_span ⟨_, rfl⟩
    apply top_unique
    intro w _
    obtain ⟨y, hy⟩ := t.surjective (Multiplicative.ofAdd w)
    obtain ⟨z, hz, he⟩ := hVK y.property
    have he' : z = y := Subtype.ext he
    subst z
    change (t.quotient y).toAdd ∈ S at hz
    rwa [hy] at hz

/-- Noncentrality of the literal group section is nontriviality of the
displayed action; the `UpperSection` kernel is essential here. -/
theorem upper_moved_vector (t : UpperSection H VH UH τ)
    (hnc : ¬ ⁅VH, H⁆ ≤ UH) : ∃ a v, τ a v ≠ v := by
  classical
  by_contra! h
  apply hnc
  rw [commutator_comm]
  apply commutator_le.mpr
  intro a ha v hv
  have he := t.displacement ⟨a, ha⟩ ⟨v, hv⟩
  rw [h, sub_self] at he
  have hk : (⟨⁅a, v⁆, t.commutator_mem ⟨a, ha⟩ ⟨v, hv⟩⟩ : VH) ∈ t.quotient.ker :=
    he.symm
  rwa [t.kernel] at hk

/-- Source 13.8.4(5) for the actual quotient carrier, including its moved
vector. `P` may be `H ∩ M` or the original `L₁T` when its normalization of
the seed has been supplied by the source geometry. -/
theorem source_cyclic {V V₃ : Subgroup G}
    (t : UpperSection H (Source.VH H V) (Source.UH H V₃) τ)
    (P : Subgroup G) (hflag : V₃ ≤ V) (hindex : V₃.relIndex V = 2)
    (hnorm : P ≤ normalizer (V : Set G))
    (hnc : ¬ ⁅Source.VH H V, H⁆ ≤ Source.UH H V₃) :
    IsParabolicCyclic τ (Source.starImage H P) ∧ (∃ a v, τ a v ≠ v) := by
  have hi : V₃ = V ⊓ Source.UH H V₃ :=
    flag_intersection_of_index_two V V₃ (Source.UH H V₃)
      (le_inf hflag (le_conjugateSpanBy V₃ H)) hindex
      (seed_not_le_UH_of_noncentral H V V₃ hnc)
  have hi' : (Source.UH H V₃).relIndex V = 2 := by
    rwa [hi, inf_relIndex_left] at hindex
  exact ⟨cyclic_of_index_two_seed t V P (le_conjugateSpanBy V H) rfl hi' hnorm,
    upper_moved_vector t hnc⟩

end CFSG.Quasithin.Chapter13.Section08.ComponentSieve.SixAndG2.SixRecognition.OppositeUpper
end
