module
public import CFSG.Quasithin.Chapter10.SourceA5PointConstrainedModels
public import CFSG.Quasithin.Chapter10.SourceA5PointLocalImage
public import CFSG.Quasithin.Chapter10.SourceA5PointFixedKernel.FixedSpan

/-!
# The actual component inside the offender actor

The Thompson commutator identity places the entire component image inside
the offender subgroup, not merely its intersection. This combines the
literal quasisimple action and full B.5.1 conclusion with the original local
A5 section, preserving the equivalence needed by the model selector.
Source: Aschbacher–Smith 10.2.9, printed pp.751–752.
-/

@[expose] public noncomputable section
open Subgroup Theory.GroupTheory Stellmacher Representation Representation.BinaryOffender
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter10
open Chapter3.Section02 ChapterB.InternalThompsonAction
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L : Subgroup G}
  (D : FundamentalSetup KnownSimple.IsKnownSimple T L)
local instance : IsElementaryAbelian 2 (⁅D.fullModule,L⁆ : Subgroup G) :=
  source_original_full_moved_elementary D

/-- The actual constrained point actor is quasisimple, is generated by its
commutators with the actual Thompson image, and acts on the literal reduced
orbit module through a faithful FF action. -/
theorem source_a5_point_offender_model_data
    (e : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 5))
    (hi : (originalMovedQuotientAction D e).IsIrreducible)
    (hn : ¬ (T : Subgroup G) ≤ normalizer (L : Set G))
    {t v : G} (ht : t ∈ (T : Subgroup G))
    (hcross : (⁅D.fullModule,L⁆).map (MulAut.conj t).toMonoidHom ≤ centralizer (L : Set G))
    (hv : v ∈ D.fullModule) (hvne : v ≠ 1)
    (hvL : v ∈ centralizer (L : Set G))
    (I : Subgroup G) (hLI : L ≤ I) (hIX : I ≤ centralizer ({v} : Set G))
    (hI : (I.subgroupOf (centralizer ({v} : Set G))).IsCComponent)
    (hNI : centralizer ({v} : Set G) ≤ normalizer (I : Set G))
    (hnot : ¬ IsQuasisimple I) (hout : ¬ I ≤ D.maximalLocal)
    (hCW : centralizer (↑(⁅D.fullModule,L⁆ : Subgroup G) : Set G) ≤ D.maximalLocal)
    (hs : Chapter1.IsSylowIn 2 ((T : Subgroup G) ⊓ centralizer ({v} : Set G))
      (centralizer ({v} : Set G)))
    (hJP : elementaryAbelianMaxJ ((T : Subgroup G) ⊓ centralizer ({v} : Set G)) =
      elementaryAbelianMaxJ (T : Subgroup G)) :
    let S := (T : Subgroup G) ⊓ centralizer ({v} : Set G)
    let H := I ⊔ S
    let U := (conjugateSpanBy (⁅D.fullModule,L⁆ ⊓ centralizer (S : Set G)) I).subgroupOf H
    ∃ hr : IsPReduced 2 U, letI := hr.normal; letI := hr.elementary
      IsQuasisimple ((I.subgroupOf H).map (actionMk U)) ∧
      ((I.subgroupOf H).map (actionMk U)) ≤ offenderSubgroup (action U) ∧
      Nonempty (ChapterB.SourceInduction.ProjectiveLine.QuasisimpleSourceConclusion
        ((action U).comp (offenderSubgroup (action U)).subtype)
        (((I.subgroupOf H).map (actionMk U)).subgroupOf (offenderSubgroup (action U)))) ∧
      ChapterB.QuasisimpleSource.moved (action U) ((I.subgroupOf H).map (actionMk U)) = ⊤ ∧
      let q := actionMk U
      let K := I.subgroupOf H
      let B := ((L.subgroupOf H).map q).subgroupOf (K.map q)
      B < ⊤ ∧ Nonempty ((B ⧸ pCore 2 B) ≃* alternatingGroup (Fin 5)) ∧
        ∃ R : Sylow 2 K,
          (R : Subgroup K) = ((T : Subgroup G).subgroupOf H).subgroupOf K ∧
          B ∈ ChapterA.Section03.localCComponents (R.mapSurjective (q.subgroupMap_surjective K)) := by
  obtain ⟨hr,hmodel,hfull,hlocal⟩ := source_a5_point_constrained_model_data D e hi hn ht hcross
    hv hvne hvL I hLI hIX hI hNI hnot hout hCW hs hJP
  obtain ⟨hr',hA,hcomm,_⟩ := source_a5_point_quasisimple_ff_action_all_points D e hi hn ht hcross
    hv hvne hvL I hLI hIX hI hNI hnot hout hCW hs hJP
  let S := (T : Subgroup G) ⊓ centralizer ({v} : Set G)
  let H := I ⊔ S
  let U := (conjugateSpanBy (⁅D.fullModule,L⁆ ⊓ centralizer (S : Set G)) I).subgroupOf H
  let := hr.normal
  let := hr.elementary
  have hHX : H ≤ centralizer ({v} : Set G) := sup_le hIX inf_le_right
  obtain ⟨P,hP⟩ := hs.restrict le_sup_right hHX
  have hP' : (P : Subgroup H) = S.subgroupOf H := by
    apply map_injective H.subtype_injective
    rw [hP,map_subgroupOf_eq_of_le le_sup_right]
  have hJT : (elementaryAbelianMaxJ (S.subgroupOf H)).map (actionMk U) ≤
      offenderSubgroup (action U) := by
    rw [←hP']
    exact thompson_image_le P U
  have hAN : ((I.subgroupOf H).map (actionMk U)) ≤ offenderSubgroup (action U) := by
    let : (offenderSubgroup (action U)).Normal := offenderSubgroup_normal _
    rw [←hcomm]
    exact (commutator_mono le_rfl hJT).trans (commutator_le_right _ _)
  exact ⟨hr,hA,hAN,hmodel,hfull,hlocal⟩
end CFSG.Quasithin.Chapter10
