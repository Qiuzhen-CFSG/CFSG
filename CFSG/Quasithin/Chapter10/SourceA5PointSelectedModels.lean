module
public import CFSG.Quasithin.Chapter10.SourceA5PointOffenderModels
public import CFSG.Quasithin.Chapter10.SourceA5PointFFModels.Sieve
public import CFSG.Quasithin.Chapter10.SourceA5PointLocalImage
public import CFSG.Quasithin.Chapter10.SourceA5PointFixedKernel.FixedSpan

/-!
# The six model branches of the actual constrained point action

The component image lies wholly in the offender actor. Transporting its
original local A5 section and full Sylow through this literal inclusion
applies the complete B.5.1 sieve on the same moved section. The source
conclusion and all its other clauses are retained for the A7 branches.
Source: Aschbacher–Smith 10.2.9, printed pp.751–752.
-/

@[expose] public noncomputable section
open Subgroup Theory.GroupTheory Stellmacher Representation Representation.BinaryOffender
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter10
open Chapter3.Section02 ChapterB.InternalThompsonAction
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L : Subgroup G}
  (D : FundamentalSetup KnownSimple.IsKnownSimple T L)
local instance : IsElementaryAbelian 2 (⁅D.fullModule,L⁆ : Subgroup G) :=
  source_original_full_moved_elementary D

/-- The actual constrained point actor is quasisimple, is generated by its
commutators with the actual Thompson image, and acts on the literal reduced
orbit module through a faithful FF action. -/
theorem source_a5_point_six_way_models
    (e : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 5))
    (hi : (originalMovedQuotientAction D e).IsIrreducible)
    (hn : ¬ (T : Subgroup G) ≤ normalizer (L : Set G))
    {t v : G} (ht : t ∈ (T : Subgroup G))
    (hcross : (⁅D.fullModule,L⁆).map (MulAut.conj t).toMonoidHom ≤ centralizer (L : Set G))
    (hv : v ∈ D.fullModule) (hvne : v ≠ 1)
    (hvL : v ∈ centralizer (L : Set G))
    (I : Subgroup G) (hLI : L ≤ I) (hIX : I ≤ centralizer ({v} : Set G))
    (hI : (I.subgroupOf (centralizer ({v} : Set G))).IsCComponent)
    (hNI : centralizer ({v} : Set G) ≤ normalizer (I : Set G))
    (hnot : ¬ IsQuasisimple I) (hout : ¬ I ≤ D.maximalLocal)
    (hCW : centralizer (↑(⁅D.fullModule,L⁆ : Subgroup G) : Set G) ≤ D.maximalLocal)
    (hs : Chapter1.IsSylowIn 2 ((T : Subgroup G) ⊓ centralizer ({v} : Set G))
      (centralizer ({v} : Set G)))
    (hJP : elementaryAbelianMaxJ ((T : Subgroup G) ⊓ centralizer ({v} : Set G)) =
      elementaryAbelianMaxJ (T : Subgroup G)) :
    let S := (T : Subgroup G) ⊓ centralizer ({v} : Set G)
    let H := I ⊔ S
    let U := (conjugateSpanBy (⁅D.fullModule,L⁆ ⊓ centralizer (S : Set G)) I).subgroupOf H
    ∃ hr : IsPReduced 2 U, letI := hr.normal; letI := hr.elementary
      let A := (I.subgroupOf H).map (actionMk U)
      let N := offenderSubgroup (action U)
      ∃ _hAN : A ≤ N,
      ∃ h : ChapterB.SourceInduction.ProjectiveLine.QuasisimpleSourceConclusion
        ((action U).comp N.subtype) (A.subgroupOf N),
        SourceA5PointFFModels.SixWay ((action U).comp N.subtype) (A.subgroupOf N)
          h.sectionData := by
  obtain ⟨hr,hA,hAN,⟨hmodel⟩,hfull,hBp,⟨eB⟩,R,hR,hlocal⟩ :=
    source_a5_point_offender_model_data D e hi hn ht hcross hv hvne hvL
      I hLI hIX hI hNI hnot hout hCW hs hJP
  let S := (T : Subgroup G) ⊓ centralizer ({v} : Set G)
  let H := I ⊔ S
  let U := (conjugateSpanBy (⁅D.fullModule,L⁆ ⊓ centralizer (S : Set G)) I).subgroupOf H
  let := hr.normal
  let := hr.elementary
  let q := actionMk U
  let K := I.subgroupOf H
  let A := K.map q
  let N := offenderSubgroup (action U)
  let C := A.subgroupOf N
  let B := ((L.subgroupOf H).map q).subgroupOf A
  let a : A ≃* C := (subgroupOfEquivOfLe hAN).symm
  let R0 : Sylow 2 A := R.mapSurjective (q.subgroupMap_surjective K)
  let R1 := R0.mapSurjective (f := a.toMonoidHom) a.surjective
  let B1 := B.map a.toMonoidHom
  let : IsQuasisimple A := hA
  let : IsQuasisimple C := IsQuasisimple.of_mulEquiv a
  let : Group.IsSolvable a.toMonoidHom.ker := by
    rw [a.toMonoidHom.ker_eq_bot_iff.mpr a.injective]
    apply Group.isSolvable_of_top_eq_bot
    ext x
    simp only [mem_top,mem_bot,true_iff]
    exact Subtype.ext (mem_bot.mp x.property)
  have hlocal1 : B1 ∈ ChapterA.Section03.localCComponents R1 :=
    Chapter1.Section02.localCComponents_map_of_solvable_ker hlocal a.toMonoidHom
  have hp1 : B1 ≠ ⊤ := by
    intro he
    apply hBp.ne
    apply map_injective (f := a.toMonoidHom) a.injective
    rw [map_top_of_surjective a.toMonoidHom a.surjective]
    exact he
  let b : B ≃* B1 := B.equivMapOfInjective a.toMonoidHom a.injective
  let e1 : (B1 ⧸ pCore 2 B1) ≃* alternatingGroup (Fin 5) :=
    (QuotientGroup.congr _ _ b (pCore_map_iso 2 b)).symm.trans eB
  exact ⟨hr,hAN,hmodel,SourceA5PointFFModels.sixWay_of_source
    ((action U).comp N.subtype) C hmodel R1 B1 hlocal1 hp1 e1⟩
end CFSG.Quasithin.Chapter10
