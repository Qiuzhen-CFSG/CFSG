module
public import CFSG.Quasithin.Chapter10.SourceA5PointThompsonMovement
public import CFSG.Quasithin.ChapterB.QuasisimpleThompsonAction
public import CFSG.Quasithin.ChapterB.Section05.GeneralClassification.Complete

/-!
# The constrained point component on its reduced orbit module

This is the literal B.5 application in the constrained branch of
Aschbacher–Smith 10.2.9. Thompson movement and the reduced centralizer quotient
produce a quasisimple component image, generated by its Thompson commutators,
inside the faithful FF action. The fixed-span and preceding Thompson equality
are explicit source inputs.
-/

@[expose] public noncomputable section
open Subgroup Theory.GroupTheory Stellmacher Representation Representation.BinaryOffender
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter10
open Chapter3.Section02 ChapterB.InternalThompsonAction
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L : Subgroup G}
  (D : FundamentalSetup KnownSimple.IsKnownSimple T L)

/-- The actual constrained point actor is quasisimple, is generated by its
commutators with the actual Thompson image, and acts on the literal reduced
orbit module through a faithful FF action. -/
theorem source_a5_point_quasisimple_ff_action
    (hn : ¬ (T : Subgroup G) ≤ normalizer (L : Set G))
    {t v : G} (ht : t ∈ (T : Subgroup G))
    (hcross : (⁅D.fullModule,L⁆).map (MulAut.conj t).toMonoidHom ≤ centralizer (L : Set G))
    (hv : v ∈ D.fullModule) (hvne : v ≠ 1)
    (hvL : v ∈ centralizer (L : Set G))
    (I : Subgroup G) (hLI : L ≤ I) (hIX : I ≤ centralizer ({v} : Set G))
    (hI : (I.subgroupOf (centralizer ({v} : Set G))).IsCComponent)
    (hNI : centralizer ({v} : Set G) ≤ normalizer (I : Set G))
    (hnot : ¬ IsQuasisimple I) (hout : ¬ I ≤ D.maximalLocal)
    (hCW : centralizer (↑(⁅D.fullModule,L⁆ : Subgroup G) : Set G) ≤ D.maximalLocal)
    (hs : Chapter1.IsSylowIn 2 ((T : Subgroup G) ⊓ centralizer ({v} : Set G))
      (centralizer ({v} : Set G)))
    (hJP : elementaryAbelianMaxJ ((T : Subgroup G) ⊓ centralizer ({v} : Set G)) =
      elementaryAbelianMaxJ (T : Subgroup G))
    (hspan : ⁅D.fullModule,L⁆ ≤ conjugateSpanBy
      (⁅D.fullModule,L⁆ ⊓ centralizer
        ((T : Subgroup G) ⊓ centralizer ({v} : Set G) : Set G)) I) :
    let S := (T : Subgroup G) ⊓ centralizer ({v} : Set G)
    let H := I ⊔ S
    let U := (conjugateSpanBy (⁅D.fullModule,L⁆ ⊓ centralizer (S : Set G)) I).subgroupOf H
    ∃ hr : IsPReduced 2 U, letI := hr.normal; letI := hr.elementary
      IsQuasisimple ((I.subgroupOf H).map (actionMk U)) ∧
      ⁅(I.subgroupOf H).map (actionMk U),
        (elementaryAbelianMaxJ (S.subgroupOf H)).map (actionMk U)⁆ =
        (I.subgroupOf H).map (actionMk U) ∧
      IsFFModule (V := Additive U) (action U) ∧ Function.Injective (action U) ∧
      Nonempty (ChapterB.SourceInduction.SQTKQuotient KnownSimple.IsKnownSimple (ActionQuotient U)) := by
  let S := (T : Subgroup G) ⊓ centralizer ({v} : Set G)
  let H := I ⊔ S
  let V := conjugateSpanBy (⁅D.fullModule,L⁆ ⊓ centralizer (S : Set G)) I
  let U := V.subgroupOf H
  have hr : IsPReduced 2 U := source_a5_point_component_reduced_module D
    hv hvne hvL hCW I hLI hIX hI hNI hnot hs
  refine ⟨hr,?_⟩
  let := hr.normal
  let := hr.elementary
  have hHX : H ≤ centralizer ({v} : Set G) := sup_le hIX inf_le_right
  have hsH : Chapter1.IsSylowIn 2 S H := hs.restrict le_sup_right hHX
  have hmove := source_a5_point_thompson_not_centralizes D hn ht hcross I hLI hout hCW
    hsH hJP hspan hr
  obtain ⟨P,hP⟩ := hsH
  have hP' : (P : Subgroup H) = S.subgroupOf H := by
    apply map_injective H.subtype_injective
    rw [hP,map_subgroupOf_eq_of_le le_sup_right]
  have hjmap : (elementaryAbelianMaxJ (P : Subgroup H)).map H.subtype =
      elementaryAbelianMaxJ S := by
    rw [←elementaryAbelianMaxJ_map_injective H.subtype H.subtype_injective,hP]
  have hVH : V ≤ H := (conjugateSpanBy_le_self
    (inf_le_left.trans ((source_full_moved_le_component D).trans hLI))).trans le_sup_left
  have hmove' : ¬ elementaryAbelianMaxJ (P : Subgroup H) ≤ centralizer (U : Set H) := by
    intro hc
    apply hmove
    rw [←hjmap]
    rintro _ ⟨a,ha,rfl⟩ z hz
    exact congrArg H.subtype (hc ha ⟨z,hVH hz⟩ hz)
  have hu := Chapter1.Section02.nonsolvable_uniqueness_of_theoremsAC
    (fun _ _ _ => ChapterA.Section02.theoremA_knownSimple)
    (fun _ _ _ => ChapterA.Section02.theoremC_knownSimple)
    D.simpleQTKE T D.maximal
  have hv2 : orderOf v = 2 := by
    let := D.fullModule_elementary hu
    exact orderOf_eq_prime (elemPow_eq_one_of_isElementaryAbelian v hv) hvne
  have hH : IsSQTK KnownSimple.IsKnownSimple H :=
    (IsSQTK.equiv (subgroupOfEquivOfLe hHX)).mp
      ((D.simpleQTKE.involution_centralizer_sqtk hv2).subgroup _)
  let : (I.subgroupOf H).Normal := normal_subgroupOf_of_le_normalizer
    (sup_le I.le_normalizer (inf_le_right.trans hNI))
  have hK : (I.subgroupOf H).IsCComponent := hI.subgroupOf_of_le le_sup_left hHX
  have hKP : I.subgroupOf H ⊔ (P : Subgroup H) = ⊤ := by
    rw [hP',←subgroupOf_sup le_sup_left le_sup_right,subgroupOf_self]
  have hquasi := quasisimple_of_thompson_movement ChapterB.SourceInduction.adequateClassification_knownSimple
    hH P (I.subgroupOf H) U hK hKP hr.quotient_pCore_eq_bot hmove'
  let := hquasi
  refine ⟨hquasi,?_,isFFModule_of_thompson_movement P U hmove',action_faithful U,?_⟩
  · rw [←hP']
    exact commutator_thompson_eq P (I.subgroupOf H) U hKP hr.quotient_pCore_eq_bot hmove'
  · exact ⟨{ Cover := H
             kernel := centralizer (U : Set H)
             sqtk := hH
             equiv := MulEquiv.refl _ }⟩
end CFSG.Quasithin.Chapter10
