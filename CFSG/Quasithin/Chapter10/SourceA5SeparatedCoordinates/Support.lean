module
public import CFSG.Quasithin.Chapter10.SourceA5OriginalIrreducibility.FaithfulAction
public import CFSG.Quasithin.Chapter10.SourceA5OriginalProductEmbedding
public import CFSG.Quasithin.Chapter10.SourceA5OriginalProductExchange
public import Theory.Representation.NormalPairSupport

/-!
# The actual separated full quotient has two support blocks

The original Irr⁺ seed is generated by its L₀-commutators, so it has a nonzero
image in V_M/C_VM(L₀). Separation places this image in one factor-fixed support
space. Faithfulness and minimal full-module irreducibility then give the literal
complementary support spaces. The chosen original t exchanges the marked A₅
factors with exactly its square-conjugation twist.

No full/local equality, local irreducibility, or multiplicity bound is assumed.
Source: Aschbacher--Smith D.3.21 and 3.2.6, printed pp.206 and581.
-/

public noncomputable section
open Subgroup Theory.GroupTheory Representation
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter10
open Chapter3.Section02
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L : Subgroup G}
  (D : FundamentalSetup KnownSimple.IsKnownSimple T L)
local instance : IsElementaryAbelian 2 D.fullModule :=
  D.fullModule_elementary (source_module_nonsolvable_uniqueness D)

/-- The original seed has nonzero image in the full central quotient. -/
theorem source_seed_not_centralized_by_orbit :
    ¬ D.seed ≤ centralizer (localOrbit T L : Set G) := by
  intro hc
  have he : D.seed = ⁅D.seed,localOrbit T L⁆ :=
    ReducedNormal.subspaceImage_eq_commutator (localJoin T L) D.seedSpace
      (localOrbit T L) le_sup_left D.homogeneous.invariant
      D.homogeneous.isIrrPlus.choose_spec.1
  exact D.seed_ne_bot (he.trans (commutator_eq_bot_iff_le_centralizer.mpr hc))

/-- A separated original seed gives a nonzero vector in one of the two literal
support spaces of every correctly marked full-quotient action. -/
theorem source_separated_full_support_nonzero
    (e : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 5))
    (hn : ¬ (T : Subgroup G) ≤ normalizer (L : Set G))
    {t : G} (ht : t ∈ T) (htn : t ∉ normalizer (L : Set G))
    (hsep : D.seed ≤ centralizer (L.map (MulAut.conj t).toMonoidHom : Set G) ∨
      D.seed ≤ centralizer (L : Set G)) :
    let U := D.fullModule.subgroupOf D.maximalLocal
    let := (source_full_module_reduced D).normal
    let q := QuotientGroup.mk' (centralizer (U : Set D.maximalLocal))
    ∀ (τ : Representation (ZMod 2) (D.maximalLocal ⧸ centralizer (U : Set D.maximalLocal))
        (Additive D.fullCentralQuotient))
      (i : alternatingGroup (Fin 5) × alternatingGroup (Fin 5) →*
        (D.maximalLocal ⧸ centralizer (U : Set D.maximalLocal))),
      (∀ x : localOrbit T L,
        i (originalA5ProductProjection D e hn ht htn x) =
          q (inclusion (localOrbit T L).le_normalizer x)) →
      (∀ (m : D.maximalLocal) (v : D.fullModule),
        τ (q m) (Additive.ofMul (QuotientGroup.mk' D.fullCentralizer v)) =
          Additive.ofMul (QuotientGroup.mk' D.fullCentralizer
            ⟨(m : G) * (v : G) * (m : G)⁻¹,
              (mem_normalizer_iff.mp (D.maximalLocal_normalizes_fullModule m.property) v).mp
                v.property⟩)) →
      NormalPairSupport.left τ i ≠ ⊥ ∨ NormalPairSupport.right τ i ≠ ⊥ := by
  dsimp only
  let := (source_full_module_reduced D).normal
  intro τ i hi hτ
  obtain ⟨v,hv,hvc⟩ := Set.not_subset.mp (source_seed_not_centralized_by_orbit D)
  have hvfull : v ∈ D.fullModule :=
    (le_componentOrbit D.seed T).trans (le_componentOrbit _ D.maximalLocal) hv
  let v' : D.fullModule := ⟨v,hvfull⟩
  let w : Additive D.fullCentralQuotient := Additive.ofMul (QuotientGroup.mk' D.fullCentralizer v')
  have hw : w ≠ 0 := by
    intro hw
    have he : QuotientGroup.mk' D.fullCentralizer v' = 1 := hw
    exact hvc ((QuotientGroup.eq_one_iff v').mp he)
  have hfix (x : localOrbit T L) (hc : v ∈ centralizer ({(x : G)} : Set G)) :
      τ (i (originalA5ProductProjection D e hn ht htn x)) w = w := by
    rw [hi]
    change τ _ (Additive.ofMul (QuotientGroup.mk' D.fullCentralizer v')) = w
    rw [hτ]
    apply congrArg Additive.ofMul
    apply congrArg (QuotientGroup.mk' D.fullCentralizer)
    apply Subtype.ext
    change (x : G) * v * (x : G)⁻¹ = v
    rw [hc x (by simp),mul_inv_cancel_right]
  rcases hsep with hsep | hsep
  · left
    intro hbot
    have hm : w ∈ NormalPairSupport.left τ i := by
      intro a
      obtain ⟨l,hl⟩ := (e.surjective.comp (QuotientGroup.mk'_surjective (pCore 2 L))) a
      change e (QuotientGroup.mk' (pCore 2 L) l) = a at hl
      have he := hfix (originalConjugateOrbitInclusion ht l) (by
        intro z hz
        have hz' : z = (originalConjugateOrbitInclusion (L := L) ht l : G) :=
          Set.mem_singleton_iff.mp hz
        subst z
        exact hsep hv _ (mem_map_of_mem (MulAut.conj t).toMonoidHom l.property))
      rw [originalA5ProductProjection_second,hl] at he
      exact he
    have hz : w ∈ (⊥ : Submodule (ZMod 2) (Additive D.fullCentralQuotient)) := hbot ▸ hm
    exact hw hz
  · right
    intro hbot
    have hm : w ∈ NormalPairSupport.right τ i := by
      intro a
      obtain ⟨l,hl⟩ := (e.surjective.comp (QuotientGroup.mk'_surjective (pCore 2 L))) a
      change e (QuotientGroup.mk' (pCore 2 L) l) = a at hl
      have he := hfix ⟨l,le_componentOrbit L T l.property⟩ (by
        intro z hz
        have hz' : z = (l : G) := Set.mem_singleton_iff.mp hz
        subst z
        exact hsep hv _ l.property)
      rw [originalA5ProductProjection_first,hl] at he
      exact he
    have hz : w ∈ (⊥ : Submodule (ZMod 2) (Additive D.fullCentralQuotient)) := hbot ▸ hm
    exact hw hz

/-- The chosen original Sylow element exchanges the two marked full-actor
factors, with precisely the square-conjugation twist on the first coordinate. -/
theorem source_original_full_pair_exchange
    (e : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 5))
    (hn : ¬ (T : Subgroup G) ≤ normalizer (L : Set G))
    {t : G} (ht : t ∈ T) (htn : t ∉ normalizer (L : Set G)) :
    let U := D.fullModule.subgroupOf D.maximalLocal
    let := (source_full_module_reduced D).normal
    let q := QuotientGroup.mk' (centralizer (U : Set D.maximalLocal))
    ∀ i : alternatingGroup (Fin 5) × alternatingGroup (Fin 5) →*
        (D.maximalLocal ⧸ centralizer (U : Set D.maximalLocal)),
      (∀ x : localOrbit T L,
        i (originalA5ProductProjection D e hn ht htn x) =
          q (inclusion (localOrbit T L).le_normalizer x)) →
      ∀ x y, q ⟨t,le_normalizer_componentOrbit L T ht⟩ * i (x,y) *
        (q ⟨t,le_normalizer_componentOrbit L T ht⟩)⁻¹ =
          i (originalA5ConjugationTwist D e hn ht y,x) := by
  dsimp only
  let := (source_full_module_reduced D).normal
  intro i hi x y
  obtain ⟨z,hz⟩ := originalA5ProductProjection_surjective D e hn ht htn (x,y)
  have hh := hi (originalOrbitConjugation ht z)
  rw [originalA5ProductProjection_conjugate,hz] at hh
  rw [←hz,hi]
  rw [hh]
  simp only [←map_inv,←map_mul]
  congr 1

/-- The actual separated minimal full quotient has complementary support
spaces and the original marked factor exchange, before any multiplicity bound. -/
theorem source_a5_full_separated_support_data
    (e : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 5))
    (hn : ¬ (T : Subgroup G) ≤ normalizer (L : Set G))
    {t : G} (ht : t ∈ T) (htn : t ∉ normalizer (L : Set G))
    (hD : D.IsMinimalFullModule) (hbound : SourceFullModuleCubicBound D)
    (hsep : D.seed ≤ centralizer (L.map (MulAut.conj t).toMonoidHom : Set G) ∨
      D.seed ≤ centralizer (L : Set G)) :
    let U := D.fullModule.subgroupOf D.maximalLocal
    let := (source_full_module_reduced D).normal
    let q := QuotientGroup.mk' (centralizer (U : Set D.maximalLocal))
    ∃ (τ : Representation (ZMod 2) (D.maximalLocal ⧸ centralizer (U : Set D.maximalLocal))
        (Additive D.fullCentralQuotient))
      (i : alternatingGroup (Fin 5) × alternatingGroup (Fin 5) →*
        (D.maximalLocal ⧸ centralizer (U : Set D.maximalLocal))),
      Function.Injective τ ∧ τ.IsIrreducible ∧ BinaryOffender.cubicRatio τ ≤ 2 ∧
      Function.Injective i ∧ i.range.Normal ∧
      IsCompl (NormalPairSupport.left τ i) (NormalPairSupport.right τ i) ∧
      (NormalPairSupport.left τ i ≠ ⊥ ∨ NormalPairSupport.right τ i ≠ ⊥) ∧
      (∀ x y, q ⟨t,le_normalizer_componentOrbit L T ht⟩ * i (x,y) *
        (q ⟨t,le_normalizer_componentOrbit L T ht⟩)⁻¹ =
          i (originalA5ConjugationTwist D e hn ht y,x)) ∧
      (∀ x : localOrbit T L,
        i (originalA5ProductProjection D e hn ht htn x) =
          q (inclusion (localOrbit T L).le_normalizer x)) ∧
      (∀ (m : D.maximalLocal) (v : D.fullModule),
        τ (q m) (Additive.ofMul (QuotientGroup.mk' D.fullCentralizer v)) =
          Additive.ofMul (QuotientGroup.mk' D.fullCentralizer
            ⟨(m : G) * (v : G) * (m : G)⁻¹,
              (mem_normalizer_iff.mp (D.maximalLocal_normalizes_fullModule m.property) v).mp
                v.property⟩)) := by
  dsimp only
  let := (source_full_module_reduced D).normal
  obtain ⟨τ,hfaith,hτirr,hcubic,hτ⟩ :=
    source_minimal_full_quotient_faithful_cubic_action D hD hbound
  obtain ⟨i,hi,hnorm,hdiag⟩ := source_a5_original_product_embedding D e hn ht htn
  let : i.range.Normal := hnorm
  let : τ.IsIrreducible := hτirr
  let : IsQuasisimple (alternatingGroup (Fin 5)) := {
    toIsPerfect := ⟨commutator_alternatingGroup_eq_top (by simp)⟩
    simple := by
      let : IsSimpleGroup (alternatingGroup (Fin 5)) :=
        alternatingGroup.isSimpleGroup (by simp)
      exact ((QuotientGroup.quotientMulEquivOfEq
        (alternatingGroup.center_eq_bot (by simp))).trans QuotientGroup.quotientBot).isSimpleGroup }
  have hs := source_separated_full_support_nonzero D e hn ht htn hsep τ i hdiag hτ
  exact ⟨τ,i,hfaith,hτirr,hcubic,hi,hnorm,
    NormalPairSupport.support_isCompl τ i hi (alternatingGroup.center_eq_bot (by simp)) hfaith hs,
    hs,source_original_full_pair_exchange D e hn ht htn i hdiag,hdiag,hτ⟩

end CFSG.Quasithin.Chapter10
