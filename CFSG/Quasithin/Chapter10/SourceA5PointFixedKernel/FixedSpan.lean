module
public import CFSG.Quasithin.Chapter10.SourceA5PointFixedKernel.Stabilization
public import CFSG.Quasithin.Chapter10.SourceA5PointConstrainedAction

/-!
# Fixed spans and constrained actions for all escaping A₅ points

Covering uniqueness proves that the Sylow intersection of an escaping
point centralizer normalizes L. The chosen-module fixed-generation theorem
therefore supplies the full original moved factor in its component orbit,
even for a point fixed by L₀. Applying the existing constrained action
construction removes its former noncentralization premise as well.

Source: Aschbacher–Smith 10.2.9, printed p.751. Chosen irreducibility,
Sylow promotion, and the point Thompson equality retain their independent
source producers; the original numerator and action maps are unchanged.
-/

@[expose] public noncomputable section
open Subgroup Theory.GroupTheory Stellmacher Representation Representation.BinaryOffender
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter10
open Chapter3.Section02 ChapterB.InternalThompsonAction
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L : Subgroup G}
  (D : FundamentalSetup KnownSimple.IsKnownSimple T L)
local instance : IsElementaryAbelian 2 (⁅D.fullModule,L⁆ : Subgroup G) :=
  source_original_full_moved_elementary D

/-- The original fixed-span theorem applies to every escaping point. -/
theorem source_a5_escaping_point_fixed_span
    (e : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 5))
    (hi : (originalMovedQuotientAction D e).IsIrreducible)
    (hn : ¬ (T : Subgroup G) ≤ normalizer (L : Set G))
    {v : G} (hvT : v ∈ (T : Subgroup G)) (hvne : v ≠ 1)
    (hvL : v ∈ centralizer (L : Set G))
    (hout : ¬ centralizer ({v} : Set G) ≤ D.maximalLocal) :
    conjugateSpanBy (⁅D.fullModule,L⁆ ⊓ centralizer
      (((T : Subgroup G) ⊓ centralizer ({v} : Set G)) : Set G)) L = ⁅D.fullModule,L⁆ := by
  have hPM : (T : Subgroup G) ⊓ centralizer ({v} : Set G) ≤ D.maximalLocal :=
    inf_le_left.trans (le_normalizer_componentOrbit L T)
  have hPL : (T : Subgroup G) ⊓ centralizer ({v} : Set G) ≤ normalizer (L : Set G) :=
    source_a5_escaping_element_sylow_stabilizes D e hn hvT hvne hvL hout
  exact source_a5_moved_fixed_span (G := G) (T := T) (L := L) D e hi
    ((T : Subgroup G) ⊓ centralizer ({v} : Set G)) hPM hPL
    (T.isPGroup'.to_le inf_le_left)

/-- The actual containing-component orbit contains the whole moved factor,
including when the original point lies in the fixed kernel. -/
theorem source_a5_escaping_point_component_fixed_span_contains
    (e : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 5))
    (hi : (originalMovedQuotientAction D e).IsIrreducible)
    (hn : ¬ (T : Subgroup G) ≤ normalizer (L : Set G))
    {v : G} (hvT : v ∈ (T : Subgroup G)) (hvne : v ≠ 1)
    (hvL : v ∈ centralizer (L : Set G))
    (hout : ¬ centralizer ({v} : Set G) ≤ D.maximalLocal)
    (I : Subgroup G) (hLI : L ≤ I) :
    ⁅D.fullModule,L⁆ ≤ conjugateSpanBy (⁅D.fullModule,L⁆ ⊓ centralizer
      (((T : Subgroup G) ⊓ centralizer ({v} : Set G)) : Set G)) I := by
  have hs := source_a5_escaping_point_fixed_span D e hi hn hvT hvne hvL hout
  calc
    ⁅D.fullModule,L⁆ = conjugateSpanBy (⁅D.fullModule,L⁆ ⊓ centralizer
        (((T : Subgroup G) ⊓ centralizer ({v} : Set G)) : Set G)) L := hs.symm
    _ ≤ _ := conjugateSpanBy_mono le_rfl hLI

/-- The actual constrained point actor is quasisimple, is generated by its
commutators with the actual Thompson image, and acts on the literal reduced
orbit module through a faithful FF action. -/
theorem source_a5_point_quasisimple_ff_action_all_points
    (e : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 5))
    (hi : (originalMovedQuotientAction D e).IsIrreducible)
    (hn : ¬ (T : Subgroup G) ≤ normalizer (L : Set G))
    {t v : G} (ht : t ∈ (T : Subgroup G))
    (hcross : (⁅D.fullModule,L⁆).map (MulAut.conj t).toMonoidHom ≤ centralizer (L : Set G))
    (hv : v ∈ D.fullModule) (hvne : v ≠ 1)
    (hvL : v ∈ centralizer (L : Set G))
    (I : Subgroup G) (hLI : L ≤ I) (hIX : I ≤ centralizer ({v} : Set G))
    (hI : (I.subgroupOf (centralizer ({v} : Set G))).IsCComponent)
    (hNI : centralizer ({v} : Set G) ≤ normalizer (I : Set G))
    (hnot : ¬ IsQuasisimple I) (hout : ¬ I ≤ D.maximalLocal)
    (hCW : centralizer (↑(⁅D.fullModule,L⁆ : Subgroup G) : Set G) ≤ D.maximalLocal)
    (hs : Chapter1.IsSylowIn 2 ((T : Subgroup G) ⊓ centralizer ({v} : Set G))
      (centralizer ({v} : Set G)))
    (hJP : elementaryAbelianMaxJ ((T : Subgroup G) ⊓ centralizer ({v} : Set G)) =
      elementaryAbelianMaxJ (T : Subgroup G)) :
    let S := (T : Subgroup G) ⊓ centralizer ({v} : Set G)
    let H := I ⊔ S
    let U := (conjugateSpanBy (⁅D.fullModule,L⁆ ⊓ centralizer (S : Set G)) I).subgroupOf H
    ∃ hr : IsPReduced 2 U, letI := hr.normal; letI := hr.elementary
      IsQuasisimple ((I.subgroupOf H).map (actionMk U)) ∧
      ⁅(I.subgroupOf H).map (actionMk U),
        (elementaryAbelianMaxJ (S.subgroupOf H)).map (actionMk U)⁆ =
        (I.subgroupOf H).map (actionMk U) ∧
      IsFFModule (V := Additive U) (action U) ∧ Function.Injective (action U) ∧
      Nonempty (ChapterB.SourceInduction.SQTKQuotient KnownSimple.IsKnownSimple (ActionQuotient U)) := by
  have hu := Chapter1.Section02.nonsolvable_uniqueness_of_theoremsAC
    (fun _ _ _ => ChapterA.Section02.theoremA_knownSimple)
    (fun _ _ _ => ChapterA.Section02.theoremC_knownSimple) D.simpleQTKE T D.maximal
  have hvT := D.fullModule_le_sylow hu hv
  have hescape : ¬ centralizer ({v} : Set G) ≤ D.maximalLocal :=
    fun hc => hout (hIX.trans hc)
  exact source_a5_point_quasisimple_ff_action D hn ht hcross hv hvne hvL
    I hLI hIX hI hNI hnot hout hCW hs hJP
    (source_a5_escaping_point_component_fixed_span_contains D e hi hn hvT hvne hvL hescape I hLI)
end CFSG.Quasithin.Chapter10
