/-!
# The centralizing Hall branch of original 10.2.3

The literal Hall action is faithful under the permitted section-kernel
premise. The SL₃(2) row gives a three-group. The orthogonal row gives
norm-one exponent divisibility for the actual Hall subgroup; no bound on
the order of the whole rank-two torus is substituted for that exponent.

The seed and constituent analysis excludes the Suzuki, ordinary and
Hermitian alternatives, leaving only a whole natural tensor in degree
n >= 3. Its original Hall B is cyclic of order 2^n - 1, and n(H) >= n-1.
The genuine H-component catalogue excludes unitary, rank-two and paired
rows by their actual torus orders. In the remaining normal PSL₂ and
Suzuki rows, the same Sylow exchanger acts on the same B both as ordinary
field action and as inverse field action, which is impossible.

`source_nonnormalCentralHall` therefore proves the unchanged source
contract with no further callback. The earlier conditional assembly APIs
remain available. The original generation-bound consumer discharges
Hall faithfulness separately and retains its moving-center branch.

Source: Aschbacher--Smith, 10.2.3, centralizing-Z branch, printed p.745,
using 10.1.1--2 and the comparison of 9.2.7, pp.731--732.
-/

public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter10
open Chapter3.Section02 CentralHall
universe u
variable {G : Type u} [Group G] [Finite G] (T : Sylow 2 G)

/-- The two actual action-image branches imply the published Hall contract.
Their source proofs are separate obligations; faithfulness is precisely the
premise already permitted by that contract. -/
theorem source_nonnormalCentralHall_of_image_branches
    (hlinear : LinearThreeImageAt T) (htorus : NonlinearTorusAt T) :
    SourceNonnormalCentralHallAt T := by
  intro hmany L D hminimal hn ha H hH hlarge hcentral B hBM hHall hab hperm hfaith
  let c : Context D H B :=
    ⟨hmany,hminimal,hn,ha,hH,hlarge,hcentral,hBM,hHall,hab,hperm,hfaith⟩
  by_cases he : Nonempty ((L ⧸ pCore 2 L) ≃*
      Matrix.SpecialLinearGroup (Fin 3) (ZMod 2))
  · exact Or.inl (isThreeGroup_of_image D B c.hall_le c.faithful
      (hlinear L D H B c he))
  · obtain ⟨n,_,_,f,hf⟩ := htorus L D H B c he
    exact Or.inr ⟨n,exponent_dvd_of_image_embedding D B c.hall_le c.faithful n f hf⟩

/-- The proved linear-three branch leaves only the nonlinear source
calculation for the original central Hall contract. -/
theorem source_nonnormalCentralHall_of_nonlinearTorus
    (htorus : NonlinearTorusAt T) : SourceNonnormalCentralHallAt T :=
  source_nonnormalCentralHall_of_image_branches T (source_linearThreeImageAt T) htorus

/-- Assembly after the completed linear-three, natural and orthogonal rows.
The three earlier source premises remain with qt-d-10-nona5-central-hall-orders;
Hall faithfulness is still exactly the premise permitted by the final contract. -/
theorem source_nonnormalCentralHall_of_seed_recognition_suzuki
    (hseed : Nonlinear.Modules.SeedAnalysisAt T)
    (hrecognize : Nonlinear.Modules.MovedRecognitionAt T)
    (hsuzuki : Nonlinear.HallGeometry.SuzukiActionTrivialAt T) :
    SourceNonnormalCentralHallAt T :=
  source_nonnormalCentralHall_of_nonlinearTorus T
    (Nonlinear.HallGeometry.nonlinearTorus_of_moduleAnalysis_and_suzuki T
      (Nonlinear.Modules.moduleAnalysis_of_seedAnalysis_and_recognition T hseed hrecognize)
      hsuzuki)

/-- Assembly with all Hall rows discharged. The separated-seed and moved-module
recognition obligations remain with this central Hall source owner. -/
theorem source_nonnormalCentralHall_of_seed_recognition
    (hseed : Nonlinear.Modules.SeedAnalysisAt T)
    (hrecognize : Nonlinear.Modules.MovedRecognitionAt T) :
    SourceNonnormalCentralHallAt T :=
  source_nonnormalCentralHall_of_nonlinearTorus T
    (Nonlinear.HallGeometry.nonlinearTorus_of_moduleAnalysis T
      (Nonlinear.Modules.moduleAnalysis_of_seedAnalysis_and_recognition T hseed hrecognize))

/-- All recognition and Hall calculations are discharged. The sole remaining
source input constructs the separated original seed, and remains owned by
qt-d-10-nona5-central-hall-orders. Hall faithfulness is the permitted premise
of the unchanged conclusion. -/
theorem source_nonnormalCentralHall_of_seed
    (hseed : Nonlinear.Modules.SeedAnalysisAt T) : SourceNonnormalCentralHallAt T :=
  source_nonnormalCentralHall_of_seed_recognition T hseed
    (Nonlinear.Modules.source_movedRecognitionAt (T := T))

/-- The source assembly after discharging the literal moved central kernel.
Separated-seed analysis and exhaustive quotient recognition remain with this
central Hall source owner; Hall faithfulness is the permitted source premise. -/
theorem source_nonnormalCentralHall_of_seed_quotientRecognition
    (hseed : Nonlinear.Modules.SeedAnalysisAt T)
    (hrecognize : Nonlinear.Modules.MovedQuotientRecognitionAt T) :
    SourceNonnormalCentralHallAt T :=
  source_nonnormalCentralHall_of_seed_recognition T hseed
    (Nonlinear.Modules.movedRecognition_of_quotientRecognition hrecognize)

/-- The original Hall consumer with the full local small-action premises
discharged. The remaining separated-seed and B.4 recognition obligations are
still owned by qt-d-10-nona5-central-hall-orders. -/
theorem source_nonnormalCentralHall_of_seed_smallRecognition
    (hseed : Nonlinear.Modules.SeedAnalysisAt T)
    (hrecognize : Nonlinear.Modules.MovedSmallRecognitionAt T) :
    SourceNonnormalCentralHallAt T :=
  source_nonnormalCentralHall_of_seed_quotientRecognition T hseed
    (Nonlinear.Modules.movedQuotientRecognition_of_smallRecognition hrecognize)

/-- Original 10.2.3 in the centralizing omega-center branch. The actual
Hall subgroup is a three-group or has norm-one exponent divisibility;
section faithfulness is exactly the premise of the published contract. -/
theorem source_nonnormalCentralHall : SourceNonnormalCentralHallAt T := by
  intro hmany L D hminimal hn ha H hH hlarge hcentral B hBM hHall hab hperm hfaith
  exact Nonlinear.Modules.original_hall_conclusion D
    (⟨hmany,hminimal,hn,ha,hH,hlarge,hcentral,hBM,hHall,hab,hperm,hfaith⟩ : Context D H B)

end CFSG.Quasithin.Chapter10
