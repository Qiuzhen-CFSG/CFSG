/-!
# The original comparison component and its Borel-normalized overcomponent

Seed faithfulness selects the actual H-star comparison component with its
local module, Baumann normalization and single-or-paired natural coverage.
The common maximal two-local contains both H and the original orbit Borel.
Source 1.2.4 embeds the comparison component in a unique C-component of
that overgroup. Since the original Borel is two-perfect, source 1.2.1(3)
normalizes the containing component.

The original two-residual is the span of the Sylow conjugates of the
comparison component. Sylow normalization of the Borel therefore propagates
comparison normalization to the whole residual, and the checked field and
coprime-lifting arguments give literal Hall placement. The equality row is
complete; proper comparison embeddings remain with the moving-Hall owner.
No Hall-placement premise is used to construct this geometry.
Source: Aschbacher–Smith 10.2.3, printed pp.745–746.
-/

public noncomputable section
open Subgroup Theory.GroupTheory Stellmacher Representation Representation.BinaryOffender
open scoped MatrixGroups
namespace CFSG.Quasithin.Chapter10.MovingHall.HallPlacement
open Chapter3.Section02 ChapterB ChapterB.QuasisimpleSource
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L : Subgroup G}
  (D : FundamentalSetup KnownSimple.IsKnownSimple T L)
  {F : Type} [Field F] [Finite F] [CharP F 2]

/-- The literal comparison residual is generated by the Sylow conjugates
of any generating C-component. -/
theorem comparison_residual_eq_span
    {H : Subgroup G} {B : Subgroup H} (ctx : MovingHall.Context D H B)
    (K : Subgroup H) (hK : K.IsCComponent)
    (hgen : K ⊔ (T.subtype ctx.hstar.1.1.2 : Subgroup H) = ⊤) :
    (pResidual 2 H).map H.subtype =
      conjugateSpanBy (K.map H.subtype) (T : Subgroup G) := by
  let := hK.perfect
  let : Group.IsNilpotent (H ⧸ pResidual 2 H) :=
    (isPGroup_quotient_pResidual 2).isNilpotent
  have hp : K ≤ pResidual 2 H := le_of_isPerfect_of_solvable_quotient K _
  apply embedded_pResidual_eq_conjugateSpanBy _ _ _ (map_mono hp) T.isPGroup'
  have hg := congrArg (Subgroup.map H.subtype) hgen
  have hS : (T.subtype ctx.hstar.1.1.2 : Subgroup H).map H.subtype =
      (T : Subgroup G) := map_subgroupOf_eq_of_le ctx.hstar.1.1.2
  simpa only [Subgroup.map_sup,hS,←MonoidHom.range_eq_map,range_subtype] using hg

/-- Borel normalization propagates to all original Sylow conjugates. -/
theorem borel_normalizes_residual_of_comparison
    {H : Subgroup G} {B : Subgroup H} (ctx : MovingHall.Context D H B)
    (K : Subgroup H) (hK : K.IsCComponent)
    (hgen : K ⊔ (T.subtype ctx.hstar.1.1.2 : Subgroup H) = ⊤)
    (hBK : sourceOrbitBorel T L ≤ normalizer (K.map H.subtype : Set G)) :
    sourceOrbitBorel T L ≤ normalizer ((pResidual 2 H).map H.subtype : Set G) := by
  rw [comparison_residual_eq_span D ctx K hK hgen]
  exact normalizes_conjugateSpanBy_of_normalized_actor _ _ _ hBK
    source_original_sylow_normalizes_borel

/-- Inside the actual common local overgroup, the unique containing
C-component is normalized by the original two-perfect Borel. -/
theorem comparison_overcomponent
    {H : Subgroup G} {B : Subgroup H} (ctx : MovingHall.Context D H B)
    {M₁ : Subgroup G} (hM : IsMaximalTwoLocal M₁)
    (hBM : sourceOrbitBorel T L ⊔ H ≤ M₁)
    (K : Subgroup H) (hK : K.IsCComponent) :
    ∃! I : Subgroup G, I ∈ Chapter1.cComponentsIn M₁ ∧
      K.map H.subtype ≤ I ∧ sourceOrbitBorel T L ≤ normalizer (I : Set G) := by
  have hHM : H ≤ M₁ := le_sup_right.trans hBM
  have hTM : (T : Subgroup G) ≤ M₁ := ctx.hstar.1.1.2.trans hHM
  have hKM : K.map H.subtype ≤ M₁ := (map_subtype_le K).trans hHM
  have hlocal : K.map H.subtype ∈ Chapter1.L G (T : Subgroup G) := by
    apply (Chapter1.lemma_1_2_6 T ctx.hstar.1.1).2
    apply (Chapter1.lemma_1_2_6 T ctx.hstar.1.1).1
    refine ⟨map_subtype_le K,?_⟩
    have hm : (K.map H.subtype).subgroupOf H = K :=
      comap_map_eq_self_of_injective H.subtype_injective K
    exact hm.symm ▸ hK
  have hlocalM : (K.map H.subtype).subgroupOf M₁ ∈
      Chapter1.L M₁ (T.subtype hTM) :=
    (Chapter1.mem_LIn_iff_subgroupOf hTM hKM).mp ⟨hKM,hlocal⟩
  have hsq := D.simpleQTKE.twoLocal_sqtk hM.1
  have hQ : IsSQTK KnownSimple.IsKnownSimple (M₁ ⧸ pCore 2 M₁) := by
    refine ⟨?_,hsq.isKGroup.quotient _⟩
    intro p hp ho
    let : Fact p.Prime := ⟨hp⟩
    exact (primeRank_quotient_le_of_isTwoGroup p ho _ pCore_isPGroup).trans
      (hsq.stronglyQuasithin p hp ho)
  obtain ⟨I,⟨hI,hKI⟩,hu⟩ := (Chapter1.existsUnique_cComponentsIn_iff hKM).mp
    (Chapter1.Section02.lemma_1_2_4_containment_of_A_3_12
      (Chapter1.Section02.containment_of_theoremsAC
        (fun X _ _ => ChapterA.Section02.theoremA_knownSimple (G := X))
        (fun X _ _ => ChapterA.Section02.theoremC_knownSimple (G := X)))
      hQ (T.subtype hTM) hlocalM)
  refine ⟨I,⟨hI,hKI,?_⟩,fun J hJ => hu J ⟨hJ.1,hJ.2.1⟩⟩
  have hB : sourceOrbitBorel T L ≤ M₁ := le_sup_left.trans hBM
  have hp : IsPPerfect 2 ((sourceOrbitBorel T L).subgroupOf M₁) :=
    (isPPerfect_embedded_pResidual 2 (sourceOrbitSylowNormalizer T L)).of_surjective
      (subgroupOfEquivOfLe hB).symm.toMonoidHom (subgroupOfEquivOfLe hB).symm.surjective
  have hn := Chapter1.Section02.twoPerfect_normalizes_cComponent_source hQ hI.2 hp
  have hm := (map_mono (f := M₁.subtype) hn).trans ((I.subgroupOf M₁).le_normalizer_map M₁.subtype)
  simpa only [map_subgroupOf_eq_of_le hB,map_subgroupOf_eq_of_le hI.1] using hm

/-- The actual comparison geometry before original Hall placement.  The
local module and both natural-source alternatives are retained literally. -/
structure ComparisonConfiguration
    {H : Subgroup G} {B : Subgroup H} (ctx : MovingHall.Context D H B) where
  component : Subgroup H
  component_isCComponent : component.IsCComponent
  omega_normalizes :
    (conjugateSpanBy (omegaOneCenterAmbient (T : Subgroup G)) H).subgroupOf H ≤
      normalizer (component : Set H)
  baumann_normalizes : ChapterB.baumann (T.subtype ctx.hstar.1.1.2 : Subgroup H) ≤
    normalizer (component : Set H)
  local_class : ChapterC.GlaubermanNiles.InLocalClass
    (inclusion (show ChapterB.baumann (T.subtype ctx.hstar.1.1.2 : Subgroup H) ≤
      component ⊔ ChapterB.baumann (T.subtype ctx.hstar.1.1.2 : Subgroup H) from le_sup_right))
  local_module :
    (ChapterC.GlaubermanNiles.localV (inclusion
      (show ChapterB.baumann (T.subtype ctx.hstar.1.1.2 : Subgroup H) ≤
        component ⊔ ChapterB.baumann (T.subtype ctx.hstar.1.1.2 : Subgroup H) from le_sup_right))).map
      (component ⊔ ChapterB.baumann (T.subtype ctx.hstar.1.1.2 : Subgroup H)).subtype =
    ⁅(conjugateSpanBy (omegaOneCenterAmbient (T : Subgroup G)) H).subgroupOf H, component⁆ ⊔
      (thompsonAlpha (T.subtype ctx.hstar.1.1.2 : Subgroup H) ⊓ centralizer (component : Set H))
  generates : component ⊔ (T.subtype ctx.hstar.1.1.2 : Subgroup H) = ⊤
  source_cases : component = pResidual 2 H ∨
    ((thompsonAlpha (T.subtype ctx.hstar.1.1.2 : Subgroup H) ⊓
      centralizer (component : Set H) ≠ ⊥) ∧
    (∃ E : BinaryField,
      Nonempty ((component ⧸ pCore 2 component) ≃* SL(2,E.Carrier))) ∧
    ∃ t ∈ (T.subtype ctx.hstar.1.1.2 : Subgroup H),
      pResidual 2 H = component ⊔ component.map (MulAut.conj t).toMonoidHom)
  ambient : Subgroup G
  maximal : IsMaximalTwoLocal ambient
  baumann_overgroup :
    normalizer (ChapterB.baumann (T : Subgroup G) : Set G) ⊔ H ≤ ambient
  borel_overgroup : sourceOrbitBorel T L ⊔ H ≤ ambient
  overcomponent : Subgroup G
  overcomponent_mem : overcomponent ∈ Chapter1.cComponentsIn ambient
  component_le : component.map H.subtype ≤ overcomponent
  borel_normalizes : sourceOrbitBorel T L ≤ normalizer (overcomponent : Set G)

/-- The original seed-faithfulness, common-local and unique-containment
proofs construct the comparison geometry without Hall placement. -/
theorem exists_comparison_configuration
    {H : Subgroup G} {B : Subgroup H} (ctx : MovingHall.Context D H B)
    (n : ℕ) (hn : 1 < n) (hF : Nat.card F = 2 ^ n)
    (e : (L ⧸ pCore 2 L) ≃* SL(2,F)) (mark : NaturalMarking D e) :
    Nonempty (ComparisonConfiguration D ctx) := by
  have hCZ := seed_centralizer_eq_sylow D ctx n hn hF e mark
  obtain ⟨K,hK,hU,hS,hlocal,hmodule,hgen,hcases⟩ :=
    ctx.hstar_component_coverage_of_seed_centralizer D n hn hF e hCZ
  obtain ⟨M₁,hM,hNH,hBH⟩ := borel_common_local_overgroup D ctx n hn hF e mark
  obtain ⟨I,⟨hI,hKI,hBI⟩,_⟩ := comparison_overcomponent D ctx hM hBH K hK
  exact ⟨⟨K,hK,hU,hS,hlocal,hmodule,hgen,hcases,M₁,hM,hNH,hBH,I,hI,hKI,hBI⟩⟩

/-- Normalization of the selected component reaches the literal Hall
through its original residual and the established field-rigidity argument. -/
theorem ComparisonConfiguration.hall_le_borel_of_normalizes
    {H : Subgroup G} {B : Subgroup H} {ctx : MovingHall.Context D H B}
    (c : ComparisonConfiguration D ctx)
    (e : (L ⧸ pCore 2 L) ≃* SL(2,F))
    (hBK : sourceOrbitBorel T L ≤ normalizer (c.component.map H.subtype : Set G)) :
    B.map H.subtype ≤ sourceOrbitBorel T L :=
  hall_le_borel_of_borel_normalizes_residual D ctx e
    (borel_normalizes_residual_of_comparison D ctx c.component
      c.component_isCComponent c.generates hBK)

/-- The equality row of the original comparison is completely discharged. -/
theorem ComparisonConfiguration.hall_le_borel_of_eq
    {H : Subgroup G} {B : Subgroup H} {ctx : MovingHall.Context D H B}
    (c : ComparisonConfiguration D ctx)
    (e : (L ⧸ pCore 2 L) ≃* SL(2,F))
    (he : c.component.map H.subtype = c.overcomponent) :
    B.map H.subtype ≤ sourceOrbitBorel T L :=
  c.hall_le_borel_of_normalizes D e (he.symm ▸ c.borel_normalizes)

/-- Only proper comparison embeddings remain in the Borel-normalization
step. Their source model arguments are retained by the moving-Hall owner. -/
theorem hall_le_borel_of_proper_comparison
    {H : Subgroup G} {B : Subgroup H} (ctx : MovingHall.Context D H B)
    (n : ℕ) (hn : 1 < n) (hF : Nat.card F = 2 ^ n)
    (e : (L ⧸ pCore 2 L) ≃* SL(2,F)) (mark : NaturalMarking D e)
    (hproper : ∀ c : ComparisonConfiguration D ctx,
      c.component.map H.subtype < c.overcomponent →
      sourceOrbitBorel T L ≤ normalizer (c.component.map H.subtype : Set G)) :
    B.map H.subtype ≤ sourceOrbitBorel T L := by
  obtain ⟨c⟩ := exists_comparison_configuration D ctx n hn hF e mark
  by_cases he : c.component.map H.subtype = c.overcomponent
  · exact c.hall_le_borel_of_eq D e he
  · exact c.hall_le_borel_of_normalizes D e (hproper c (lt_of_le_of_ne c.component_le he))

end CFSG.Quasithin.Chapter10.MovingHall.HallPlacement
