module

public import CFSG.Quasithin.Chapter10.SourceLinearThreeReduction.SmallOffender.Recognition.Quiet.SuzukiPairDegree
public import CFSG.Quasithin.ChapterB.Section05.GeneralClassification.LargeSections

/-!
# Remaining FF cases in the quiet Suzuki centralizer

Restrict the literal full action to the subgroup generated by the best offenders
in the orbit centralizer. Its faithful action, trivial two-core, and actual
SQTK cover allow the B.5 large-section reduction. This connects the two remaining
module cases to the original small-offender contract.

Source: Aschbacher–Smith, 10.1.1 and 10.2.12 (printed pp.741–742, 754–755).
The small-offender owner discharges these cases; half-Sylow uniqueness is retained
as an independent earlier input for final assembly.
-/

public noncomputable section
open scoped IsMulCommutative
open Subgroup Theory.GroupTheory Representation Representation.BinaryOffender Stellmacher
namespace CFSG.Quasithin.Chapter10.SmallOffender.Recognition
open Chapter3.Section02 BenderSuzuki.MatrixGroups PointControl.Selection
open ChapterB.SourceInduction ChapterB.QuasisimpleSource
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L : Subgroup G}

theorem full_orbit_action_fixed_eq_bot
    (D : FundamentalSetup KnownSimple.IsKnownSimple T L)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hJ : elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (D.moduleSubgroup : Set G)) :
    let U := D.fullModule.subgroupOf D.maximalLocal
    let := (source_full_module_reduced D).normal
    let := (source_full_module_reduced D).elementary
    let q := ChapterB.InternalThompsonAction.actionMk U
    let ρ := ChapterB.InternalThompsonAction.action U
    let X := ((localOrbit T L).subgroupOf D.maximalLocal).map q
    fixedSpace ρ X = ⊥ := by
  dsimp only
  let M := D.maximalLocal
  let R := localOrbit T L
  let U := D.fullModule.subgroupOf M
  let := (source_full_module_reduced D).normal
  let := (source_full_module_reduced D).elementary
  let q := ChapterB.InternalThompsonAction.actionMk U
  let ρ := ChapterB.InternalThompsonAction.action U
  let X := (R.subgroupOf M).map q
  apply bot_unique
  intro v hv
  apply Additive.toMul.injective
  apply Subtype.ext
  apply Subtype.ext
  apply (source_fullModule_fixed_eq_bot_of_many D hmany hJ).le
  refine ⟨v.toMul.property,?_⟩
  intro r hr
  let rM : M := ⟨r,R.le_normalizer hr⟩
  have hh := hv ⟨q rM,mem_map_of_mem q hr⟩
  have hact := ChapterB.InternalThompsonAction.action_apply U rM v
  have he : r * (v.toMul : G) * r⁻¹ = (v.toMul : G) := by
    exact (congrArg (fun x : M => (x : G)) hact).symm.trans
      (congrArg (fun x : Additive U => ((x.toMul : M) : G)) hh)
  exact mul_inv_eq_iff_eq_mul.mp he

theorem quiet_suzuki_centralizer_ff_rows
    (D : FundamentalSetup KnownSimple.IsKnownSimple T L) {g : G}
    (c : Configuration T D g)
    (hJ : elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (D.moduleSubgroup : Set G))
    (hNL : normalizer (L : Set G) ≤ D.maximalLocal)
    {m : ℕ} (hm : 1 ≤ m) (e : (L ⧸ pCore 2 L) ≃* SuzukiMatrixGroup m) :
    let U := D.fullModule.subgroupOf D.maximalLocal
    let := (source_full_module_reduced D).normal
    let := (source_full_module_reduced D).elementary
    let q := ChapterB.InternalThompsonAction.actionMk U
    let ρ := ChapterB.InternalThompsonAction.action U
    let X := ((localOrbit T L).subgroupOf D.maximalLocal).map q
    let C := centralizer (X : Set (D.maximalLocal ⧸ centralizer (U : Set D.maximalLocal)))
    let N := offenderSubgroup (ρ.comp C.subtype)
    let σ := (ρ.comp C.subtype).comp N.subtype
    LargeSectionFFCases σ := by
  dsimp only
  let M := D.maximalLocal
  let R := localOrbit T L
  let U := D.fullModule.subgroupOf M
  let hu := source_full_module_reduced D
  let := hu.normal
  let := hu.elementary
  let Q := M ⧸ centralizer (U : Set M)
  let q := ChapterB.InternalThompsonAction.actionMk U
  let ρ := ChapterB.InternalThompsonAction.action U
  let X := (R.subgroupOf M).map q
  let C := centralizer (X : Set Q)
  let N := offenderSubgroup (ρ.comp C.subtype)
  let f := C.subtype.comp N.subtype
  let : (R.subgroupOf M).Normal := normal_subgroupOf_of_le_normalizer le_rfl
  let : X.Normal := Subgroup.Normal.map inferInstance q (QuotientGroup.mk'_surjective _)
  let : C.Normal := inferInstance
  let : Group.IsPerfect L := Chapter1.mem_L_isPerfect D.maximal.1
  let : Group.IsPerfect R := isPerfect_iSup_conjugates L T
  let : Group.IsPerfect (R.subgroupOf M) :=
    Group.IsPerfect.ofSurjective (f := (subgroupOfEquivOfLe R.le_normalizer).symm.toMonoidHom)
      (subgroupOfEquivOfLe R.le_normalizer).symm.surjective
  let : Group.IsPerfect X := Group.IsPerfect.map q
  let cover : SQTKQuotient KnownSimple.IsKnownSimple Q := {
    Cover := M
    kernel := centralizer (U : Set M)
    sqtk := D.simpleQTKE.twoLocal_sqtk
      (source_module_nonsolvable_uniqueness D).normalizer_maximal.1
    equiv := MulEquiv.refl Q }
  have hcore : pCore 2 C = ⊥ := normal_subgroup_twoCore_eq_bot C hu.quotient_pCore_eq_bot
  have hff := (quiet_suzuki_orbit_centralizer_nonsolvable_ff D c hJ hNL hm e).2
  obtain ⟨A,hA⟩ := (isFFModule_iff_exists_bestOffender (ρ.comp C.subtype)).mp hff
  have hffN : IsFFModule ((ρ.comp C.subtype).comp N.subtype) :=
    ⟨A.subgroupOf N,(hA.isOffender _).subgroupOf _ (hA.le_offenderSubgroup _)⟩
  apply ff_rows_of_large_commuting_perfect ρ (ChapterB.InternalThompsonAction.action_faithful U)
    X (full_orbit_action_fixed_eq_bot D c.many hJ) ?_ f
    (C.subtype_injective.comp N.subtype_injective) ?_
    (offenderSubgroup_twoCore _ hcore) ((cover.subgroup C).subgroup N)
    (offenderSubgroup_restrict_eq_top _) hffN
  · intro W hW
    have hd := quiet_suzuki_orbit_submodule_degree D c hJ hNL hm e W hW
    exact (by omega : 24 ≤ 8*(2*m+1)).trans hd
  · rintro _ ⟨x,rfl⟩
    exact x.val.property

/-- Apply the remaining concrete FF alternatives to the original survivor
contract. Half-Sylow uniqueness remains an independent earlier source input. -/
theorem nonnormalSmallOffender_or_quiet_suzuki_ff_rows
    (hhalf : PointControl.HalfSylowUniqueAt T) :
    SourceNonnormalSmallOffenderAt T ∨
    (∃ (L : Subgroup G) (D : FundamentalSetup KnownSimple.IsKnownSimple T L) (g : G),
      Configuration T D g ∧
      elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (D.moduleSubgroup : Set G) ∧
      normalizer (L : Set G) ≤ D.maximalLocal ∧
      ∃ m : ℕ, 1 ≤ m ∧ Nonempty ((L ⧸ pCore 2 L) ≃* SuzukiMatrixGroup m) ∧
        (let U := D.fullModule.subgroupOf D.maximalLocal
         let := (source_full_module_reduced D).normal
         let := (source_full_module_reduced D).elementary
         let q := ChapterB.InternalThompsonAction.actionMk U
         let ρ := ChapterB.InternalThompsonAction.action U
         let X := ((localOrbit T L).subgroupOf D.maximalLocal).map q
         let C := centralizer (X : Set (D.maximalLocal ⧸ centralizer (U : Set D.maximalLocal)))
         let N := offenderSubgroup (ρ.comp C.subtype)
         LargeSectionFFCases ((ρ.comp C.subtype).comp N.subtype))) := by
  rcases nonnormalSmallOffender_or_quiet_suzuki hhalf with hs | h
  · exact Or.inl hs
  obtain ⟨L,D,g,c,hJ,hNL,m,hm,he,_,_,_⟩ := h
  exact Or.inr ⟨L,D,g,c,hJ,hNL,m,hm,he,
    quiet_suzuki_centralizer_ff_rows D c hJ hNL hm he.some⟩

end CFSG.Quasithin.Chapter10.SmallOffender.Recognition
