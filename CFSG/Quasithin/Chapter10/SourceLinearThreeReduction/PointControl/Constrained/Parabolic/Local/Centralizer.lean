module
public import CFSG.Quasithin.Chapter10.SourceLinearThreeReduction.PointControl.Constrained.Parabolic.Local.Setup
public import CFSG.Quasithin.Chapter10.SourceLinearThreeReduction.PointControl.Constrained.Parabolic.Structure

/-!
# The actual plane parabolic from the smaller orbit

The component remains the cubic residual of the original point
centralizer. The smaller orbit's faithful SL₅(2) quotient has a two-group
kernel, so its Sylow overgroups are generated by their cubic residual
and point Sylow. This identifies the actual plane centralizer, proves
its exchange symmetry and computes its intrinsic two-core quotient:
L₄(2) in dimension five, S₃ × L₃(2) in dimension ten.

All stabilizers are preimages under the literal action on the smaller
orbit. The full original setup and VI are retained. The proof adapts
Parabolic.Residual, Centralizer and Structure at this local carrier.
Source: Aschbacher--Smith, 10.2.9, pp.752--753.
-/

@[expose] public noncomputable section
open Subgroup Theory.GroupTheory Stellmacher Representation
open scoped MatrixGroups IsMulCommutative
namespace CFSG.Quasithin.Chapter10.PointControl.Constrained
open Chapter3.Section02 ChapterB.InternalThompsonAction
open BinaryLinear.FiveFlagGeometry
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L : Subgroup G}
  {D : FundamentalSetup KnownSimple.IsKnownSimple T L} {t v : G} {I : Subgroup G}


/-- The actual action kernel gives the intrinsic component two-core quotient. -/
def LocalFiveData.componentQuotient {c : Context D t v I} (m : LocalFiveData c) :
    (I ⧸ pCore 2 I) ≃* Matrix.SpecialLinearGroup (Fin 5) (ZMod 2) := by
  let H := pointJoin T v I
  let K := I.subgroupOf H
  let := m.reduced.normal
  let f := (actionMk (localFiveModule T t v I)).subgroupMap K
  let a : I ≃* K := (subgroupOfEquivOfLe (show I ≤ H from le_sup_left)).symm
  exact (QuotientGroup.congr _ _ a (pCore_map_iso 2 a)).trans
    (((QuotientGroup.quotientMulEquivOfEq m.kernel_eq.symm).trans
      (QuotientGroup.quotientKerEquivOfSurjective f
        ((actionMk (localFiveModule T t v I)).subgroupMap_surjective K))).trans m.actor)

/-- In the terminal model the original point component is exactly the
three-prime residual of the full ambient point centralizer. -/
theorem LocalFiveData.component_eq_point_residual {c : Context D t v I}
    (m : LocalFiveData c) :
    (primeToResidual 3 (centralizer ({v} : Set G))).map
      (centralizer ({v} : Set G)).subtype = I :=
  c.component_eq_point_residual_of_four_natural_cover m.cover

omit [Finite G] in
private theorem map_point_centralizer (a : G ≃* G) (w : G) :
    (centralizer ({w} : Set G)).map a.toMonoidHom = centralizer ({a w} : Set G) := by
  ext g
  constructor
  · rintro ⟨x,hx,rfl⟩
    apply mem_centralizer_singleton_iff.mpr
    change a x * a w = a w * a x
    simpa only [map_mul] using congrArg a (mem_centralizer_singleton_iff.mp hx)
  · intro hg
    refine ⟨a.symm g,mem_centralizer_singleton_iff.mpr ?_,a.apply_symm_apply g⟩
    apply a.injective
    simpa only [map_mul,a.apply_symm_apply] using mem_centralizer_singleton_iff.mp hg

/-- The same embedded residual identity in the conjugate point centralizer. -/
theorem LocalFiveData.conjugate_component_eq_point_residual {c : Context D t v I}
    (m : LocalFiveData c) :
    (primeToResidual 3 (centralizer ({oppositePoint t v} : Set G))).map
      (centralizer ({oppositePoint t v} : Set G)).subtype =
        I.map (MulAut.conj t).toMonoidHom := by
  rw [←m.component_eq_point_residual,map_embedded_primeToResidual,
    map_point_centralizer]

/-- The prescribed point Sylow is the same for both original coordinates. -/
theorem LocalFiveData.opposite_pointSylow {c : Context D t v I}
    (m : LocalFiveData c) : pointSylow T (oppositePoint t v) = pointSylow T v := by
  have ht : (T : Subgroup G).map (MulAut.conj t).toMonoidHom = (T : Subgroup G) :=
    mem_normalizer_iff_map_conj_eq.mp ((T : Subgroup G).le_normalizer c.escaping.t_mem)
  have hs := mem_normalizer_iff_map_conj_eq.mp (m.pointSylow_normalized c.escaping.t_mem)
  calc
    pointSylow T (oppositePoint t v) = (pointSylow T v).map (MulAut.conj t).toMonoidHom := by
      rw [pointSylow,pointSylow,Subgroup.map_inf _ _ _ (MulAut.conj t).injective,
        ht,map_point_centralizer]
    _ = pointSylow T v := hs

/-- The plane residual lies in both of the actual conjugate components. -/
theorem LocalFiveData.plane_residual_le_components {c : Context D t v I}
    (m : LocalFiveData c) :
    (primeToResidual 3 (centralizer (pointPlane t v : Set G))).map
      (centralizer (pointPlane t v : Set G)).subtype ≤ I ⊓ I.map (MulAut.conj t).toMonoidHom := by
  apply le_inf
  · rw [←m.component_eq_point_residual]
    exact embedded_primeToResidual_mono 3 (centralizer_le
      (Set.singleton_subset_iff.mpr
        ((show zpowers v ≤ pointPlane t v from le_sup_right) (mem_zpowers v))))
  · rw [←m.conjugate_component_eq_point_residual]
    exact embedded_primeToResidual_mono 3 (centralizer_le
      (Set.singleton_subset_iff.mpr
        ((show zpowers (oppositePoint t v) ≤ pointPlane t v from le_sup_left) (mem_zpowers _))))

/-- The original exchange acts on the embedded plane residual. -/
theorem LocalFiveData.exchange_normalizes_plane_residual {c : Context D t v I}
    (m : LocalFiveData c) : t ∈ normalizer
      ((primeToResidual 3 (centralizer (pointPlane t v : Set G))).map
        (centralizer (pointPlane t v : Set G)).subtype : Set G) := by
  apply mem_normalizer_iff_map_conj_eq.mpr
  change ((primeToResidual 3 (centralizer (pointPlane t v : Set G))).map
    (centralizer (pointPlane t v : Set G)).subtype).map (MulAut.conj t).toMonoidHom = _
  rw [map_embedded_primeToResidual]
  have hc := mem_normalizer_iff_map_conj_eq.mp
    (normalizer_le_normalizer_centralizer (pointPlane t v) m.exchange_normalizes_plane)
  change (centralizer (pointPlane t v : Set G)).map (MulAut.conj t).toMonoidHom = _ at hc
  rw [hc]

/-- The source residual and Sylow supplement is t-invariant and lies in both
original point joins. The remaining parabolic geometry must prove that it
exhausts the point-join centralizer of E. -/
theorem LocalFiveData.plane_residual_supplement {c : Context D t v I}
    (m : LocalFiveData c) :
    let R := (primeToResidual 3 (centralizer (pointPlane t v : Set G))).map
      (centralizer (pointPlane t v : Set G)).subtype
    t ∈ normalizer ((R ⊔ pointSylow T v : Subgroup G) : Set G) ∧
      R ⊔ pointSylow T v ≤
        (pointJoin T v I ⊓ centralizer (pointPlane t v : Set G)) ⊓
        pointJoin T (oppositePoint t v) (I.map (MulAut.conj t).toMonoidHom) := by
  dsimp only
  constructor
  · exact normalizer_inf_normalizer_le_normalizer_sup _ _
      ⟨m.exchange_normalizes_plane_residual,m.pointSylow_normalized c.escaping.t_mem⟩
  · apply le_inf
    · apply le_inf
      · exact sup_le ((m.plane_residual_le_components.trans inf_le_left).trans le_sup_left)
          le_sup_right
      · exact sup_le (map_subtype_le _) m.pointSylow_centralizes_plane
    · change _ ≤ I.map (MulAut.conj t).toMonoidHom ⊔ pointSylow T (oppositePoint t v)
      rw [m.opposite_pointSylow]
      exact sup_le ((m.plane_residual_le_components.trans inf_le_right).trans le_sup_left)
        le_sup_right



/-- The kernel on the whole point join is an extension of two-groups. -/
theorem LocalFiveData.action_kernel_two {c : Context D t v I} (m : LocalFiveData c) :
    letI := m.reduced.normal
    IsPGroup 2 (actionMk (localFiveModule T t v I)).ker := by
  let H := pointJoin T v I
  let K := I.subgroupOf H
  let S := (pointSylow T v).subgroupOf H
  let := m.reduced.normal
  let q := actionMk (localFiveModule T t v I)
  let f := q.subgroupMap K
  let : K.Normal := normal_subgroupOf_of_le_normalizer
    (sup_le I.le_normalizer (inf_le_right.trans c.escaping.normalizes))
  have hKS : K ⊔ S = ⊤ := by
    rw [← subgroupOf_sup (show I ≤ H from le_sup_left)
      (show pointSylow T v ≤ H from le_sup_right), subgroupOf_self]
  have hquot : IsPGroup 2 (H ⧸ K) := isPGroup_quotient_of_sup_eq_top K S
    ((T.isPGroup'.to_le inf_le_left).comap_subtype) hKS
  intro x
  obtain ⟨n,hn⟩ := hquot (QuotientGroup.mk' K (x : H))
  have hxK : (x : H) ^ (2 ^ n) ∈ K := by
    apply (QuotientGroup.eq_one_iff _).mp
    change (QuotientGroup.mk' K) ((x : H) ^ (2 ^ n)) = 1
    simpa only [map_pow] using hn
  let y : K := ⟨(x : H) ^ (2 ^ n), hxK⟩
  have hy : y ∈ f.ker := by
    apply Subtype.ext
    change q ((x : H) ^ (2 ^ n)) = 1
    rw [map_pow, show q (x : H) = 1 from x.property, one_pow]
  rw [show f.ker = pCore 2 K from m.kernel_eq] at hy
  obtain ⟨r,hr⟩ := (pCore_isPGroup (p := 2) (G := K)) ⟨y,hy⟩
  refine ⟨n+r, Subtype.ext ?_⟩
  have he := congrArg (fun a : pCore 2 K => ((a : K) : H)) hr
  change ((x : H) ^ (2 ^ n)) ^ (2 ^ r) = 1 at he
  change (x : H) ^ (2 ^ (n+r)) = 1
  simpa only [←pow_mul,←pow_add] using he

/-- The original quotient map followed by its actual binary-five marking. -/
noncomputable def LocalFiveData.joinAction {c : Context D t v I} (m : LocalFiveData c) :
    pointJoin T v I →* BinaryLinear.OuterCyclic.LinearGroup 5 := by
  let := m.reduced.normal
  let A := (I.subgroupOf (pointJoin T v I)).map (actionMk (localFiveModule T t v I))
  let e : ActionQuotient (localFiveModule T t v I) ≃* A :=
    (Subgroup.topEquiv).symm.trans (MulEquiv.subgroupCongr m.actor_eq_top.symm)
  exact ((m.actor.trans (BinaryLinear.OuterCyclic.slEquivLinear 5)).toMonoidHom.comp
    e.toMonoidHom).comp (actionMk (localFiveModule T t v I))

theorem LocalFiveData.joinAction_surjective {c : Context D t v I} (m : LocalFiveData c) :
    Function.Surjective m.joinAction := by
  let := m.reduced.normal
  exact ((BinaryLinear.OuterCyclic.slEquivLinear 5).surjective.comp m.actor.surjective).comp
    (((Subgroup.topEquiv).symm.trans
      (MulEquiv.subgroupCongr m.actor_eq_top.symm)).surjective.comp
        (QuotientGroup.mk'_surjective _))

theorem LocalFiveData.joinAction_ker {c : Context D t v I} (m : LocalFiveData c) :
    letI := m.reduced.normal
    m.joinAction.ker = (actionMk (localFiveModule T t v I)).ker := by
  let := m.reduced.normal
  ext x
  simp [LocalFiveData.joinAction, MonoidHom.mem_ker]

theorem LocalFiveData.joinAction_kernel_two {c : Context D t v I} (m : LocalFiveData c) :
    IsPGroup 2 m.joinAction.ker := by
  let := m.reduced.normal
  rw [m.joinAction_ker]
  exact m.action_kernel_two

/-- Centralizing the original generator would centralize its entire I-orbit,
forcing I into M. Thus the actual plane centralizer is proper. -/
theorem LocalFiveData.plane_centralizer_ne_join {c : Context D t v I}
    (m : LocalFiveData c) :
    pointJoin T v I ⊓ centralizer (pointPlane t v : Set G) ≠ pointJoin T v I := by
  intro he
  have hIu : I ≤ centralizer ({oppositePoint t v} : Set G) := by
    intro i hi
    have hh : i ∈ pointJoin T v I ⊓ centralizer (pointPlane t v : Set G) :=
      he.symm ▸ (show i ∈ pointJoin T v I from (le_sup_left : I ≤ pointJoin T v I) hi)
    rw [c.join_plane_centralizer] at hh
    exact hh.2
  have hIz : I ≤ centralizer (zpowers (oppositePoint t v) : Set G) := by
    apply le_centralizer_iff.mpr
    apply zpowers_le.mpr
    intro i hi
    exact mem_centralizer_singleton_iff.mp (hIu hi)
  have hI := le_centralizer_conjugateSpanBy_of_normalizes I
    (zpowers (oppositePoint t v)) I I.le_normalizer hIz
  rw [←m.orbit_eq_opposite_span] at hI
  exact c.escaping.escapes
    (hI.trans m.orbit_centralizer_le)

/-- The model is attached to the literal point-join centralizer through its
actual action quotient, with a Sylow subgroup supplied by point saturation. -/
theorem LocalFiveData.plane_centralizer_isFlagParabolic {c : Context D t v I}
    (m : LocalFiveData c) : BinaryLinear.FiveFlagGeometry.IsFlagParabolic
      (((pointJoin T v I ⊓ centralizer (pointPlane t v : Set G)).subgroupOf
        (pointJoin T v I)).map m.joinAction) := by
  obtain ⟨S,hS⟩ := c.join_sylow
  apply BinaryLinear.FiveFlagGeometry.isFlagParabolic_of_sylow_le
    (S.mapSurjective m.joinAction_surjective)
  apply map_mono
  intro s hs
  have hp : (s : G) ∈ pointSylow T v := hS ▸ mem_map_of_mem (pointJoin T v I).subtype hs
  exact ⟨s.property,m.pointSylow_centralizes_plane hp⟩

/-- The centralizer of the original involution plane is exactly the join
of the ambient plane residual with the prescribed point Sylow. -/
theorem LocalFiveData.plane_centralizer_eq {c : Context D t v I} (m : LocalFiveData c) :
    pointJoin T v I ⊓ centralizer (pointPlane t v : Set G) =
      (primeToResidual 3 (centralizer (pointPlane t v : Set G))).map
        (centralizer (pointPlane t v : Set G)).subtype ⊔ pointSylow T v := by
  let H := pointJoin T v I
  let C := H ⊓ centralizer (pointPlane t v : Set G)
  let K := C.subgroupOf H
  obtain ⟨S,hS⟩ := c.join_sylow
  have hSK : (S : Subgroup H) ≤ K := by
    intro s hs
    have hp : (s : G) ∈ pointSylow T v := hS ▸ mem_map_of_mem H.subtype hs
    exact ⟨s.property,m.pointSylow_centralizes_plane hp⟩
  have hgen := BinaryLinear.FiveFlagGeometry.embedded_primeToResidual_sup_sylow_of_two_kernel
    m.joinAction m.joinAction_surjective m.joinAction_kernel_two S K hSK
  have hC : (primeToResidual 3 C).map C.subtype ⊔ pointSylow T v = C := by
    have hh := congrArg (Subgroup.map H.subtype) hgen
    rw [Subgroup.map_sup, map_embedded_primeToResidual_of_hom, hS,
      map_subgroupOf_eq_of_le (show C ≤ H from inf_le_left)] at hh
    exact hh
  apply le_antisymm
  · change C ≤ _
    rw [←hC]
    exact sup_le_sup (embedded_primeToResidual_mono 3 inf_le_right) le_rfl
  · exact m.plane_residual_supplement.2.trans inf_le_left

/-- The literal exchange normalizes the entire point-join plane centralizer. -/
theorem LocalFiveData.exchange_normalizes_plane_centralizer {c : Context D t v I}
    (m : LocalFiveData c) : t ∈ normalizer
      ((pointJoin T v I ⊓ centralizer (pointPlane t v : Set G) : Subgroup G) : Set G) := by
  rw [m.plane_centralizer_eq]
  exact m.plane_residual_supplement.1

/-- The same centralizer is obtained in the conjugate point join. -/
theorem LocalFiveData.plane_centralizer_eq_conjugate {c : Context D t v I}
    (m : LocalFiveData c) :
    pointJoin T v I ⊓ centralizer (pointPlane t v : Set G) =
      pointJoin T (oppositePoint t v) (I.map (MulAut.conj t).toMonoidHom) ⊓
        centralizer (pointPlane t v : Set G) := by
  have he := mem_normalizer_iff_map_conj_eq.mp m.exchange_normalizes_plane_centralizer
  have hT := mem_normalizer_iff_map_conj_eq.mp (m.pointSylow_normalized c.escaping.t_mem)
  have hC := mem_normalizer_iff_map_conj_eq.mp
    (normalizer_le_normalizer_centralizer (pointPlane t v) m.exchange_normalizes_plane)
  change ((pointJoin T v I ⊓ centralizer (pointPlane t v : Set G)).map
    (MulAut.conj t).toMonoidHom) = _ at he
  rw [Subgroup.map_inf _ _ _ (MulAut.conj t).injective, pointJoin, Subgroup.map_sup] at he
  change (pointSylow T v).map (MulAut.conj t).toMonoidHom = _ at hT
  change (centralizer (pointPlane t v : Set G)).map (MulAut.conj t).toMonoidHom = _ at hC
  rw [hT,hC] at he
  change (I ⊔ pointSylow T v) ⊓ centralizer (pointPlane t v : Set G) =
    (I.map (MulAut.conj t).toMonoidHom ⊔ pointSylow T (oppositePoint t v)) ⊓
      centralizer (pointPlane t v : Set G)
  rw [m.opposite_pointSylow]
  exact he.symm

/-- The action kernel centralizes the literal plane: it fixes its orbit
coordinate u, while the whole point join fixes v. -/
theorem LocalFiveData.joinAction_kernel_le_plane_centralizer {c : Context D t v I}
    (m : LocalFiveData c) : m.joinAction.ker ≤
      (pointJoin T v I ⊓ centralizer (pointPlane t v : Set G)).subgroupOf (pointJoin T v I) := by
  let H := pointJoin T v I
  let := m.reduced.normal
  rw [m.joinAction_ker]
  intro x hx
  rw [c.join_plane_centralizer]
  refine ⟨x.property,mem_centralizer_singleton_iff.mpr ?_⟩
  have hc : x ∈ centralizer (localFiveModule T t v I : Set H) := by
    simpa only [actionMk,QuotientGroup.ker_mk'] using hx
  have he := hc ⟨oppositePoint t v,m.orbit_le_join m.opposite_mem_orbit⟩ m.opposite_mem_orbit
  exact (congrArg H.subtype he).symm

/-- The actual centralizer image is a proper flag parabolic of SL₅(2). -/
theorem LocalFiveData.plane_centralizer_image_ne_top {c : Context D t v I}
    (m : LocalFiveData c) :
    ((pointJoin T v I ⊓ centralizer (pointPlane t v : Set G)).subgroupOf
      (pointJoin T v I)).map m.joinAction ≠ ⊤ := by
  intro htop
  have hK : (pointJoin T v I ⊓ centralizer (pointPlane t v : Set G)).subgroupOf
      (pointJoin T v I) = ⊤ := by
    apply map_injective_of_ker_le m.joinAction m.joinAction_kernel_le_plane_centralizer le_top
    rw [htop,map_top_of_surjective _ m.joinAction_surjective]
  apply m.plane_centralizer_ne_join
  have he := congrArg (Subgroup.map (pointJoin T v I).subtype) hK
  rw [map_subgroupOf_eq_of_le inf_le_left, ←MonoidHom.range_eq_map, range_subtype] at he
  exact he


open BinaryNaturalDual.VectorStabilizers

def LocalFiveData.quotientActor {c : Context D t v I} (m : LocalFiveData c) :
    letI := m.reduced.normal
    ActionQuotient (localFiveModule T t v I) ≃* Matrix.SpecialLinearGroup (Fin 5) (ZMod 2) := by
  let := m.reduced.normal
  exact ((Subgroup.topEquiv).symm.trans
    (MulEquiv.subgroupCongr m.actor_eq_top.symm)).trans m.actor

theorem LocalFiveData.module_irreducible {c : Context D t v I} (m : LocalFiveData c) :
    letI := m.reduced.normal
    letI := m.reduced.elementary
    IsIrreducible (action (localFiveModule T t v I)) := by
  let := m.reduced.normal
  let := m.reduced.elementary
  let A := (I.subgroupOf (pointJoin T v I)).map (actionMk (localFiveModule T t v I))
  have hs : Function.Surjective A.subtype := by
    intro x
    exact ⟨⟨x, by change x ∈ (I.subgroupOf (pointJoin T v I)).map (actionMk (localFiveModule T t v I)); rw [m.actor_eq_top]; trivial⟩,rfl⟩
  exact (irreducible_comp_surjective_iff A.subtype hs _).mp m.irreducible

/-- The point is the original u, regarded as a vector of the literal smaller orbit. -/
def LocalFiveData.pointVector {c : Context D t v I} (m : LocalFiveData c) :
    Additive (localFiveModule T t v I) :=
  Additive.ofMul ⟨⟨oppositePoint t v,m.orbit_le_join m.opposite_mem_orbit⟩,m.opposite_mem_orbit⟩

theorem LocalFiveData.pointVector_ne_zero {c : Context D t v I} (m : LocalFiveData c) :
    m.pointVector ≠ 0 := by
  intro he
  have hh := congrArg (fun x : Additive (localFiveModule T t v I) =>
    (((x.toMul : localFiveModule T t v I) : pointJoin T v I) : G)) he
  exact c.escaping.v_ne ((MulAut.conj t).map_eq_one_iff.mp hh)

theorem LocalFiveData.pointVector_fixed_iff {c : Context D t v I} (m : LocalFiveData c)
    (h : pointJoin T v I) :
    letI := m.reduced.normal
    letI := m.reduced.elementary
    action (localFiveModule T t v I) (actionMk (localFiveModule T t v I) h) m.pointVector =
      m.pointVector ↔ (h : G) ∈ planeCentralizer T t v I := by
  let := m.reduced.normal
  let := m.reduced.elementary
  rw [planeCentralizer,c.join_plane_centralizer]
  constructor
  · intro he
    refine ⟨h.property,mem_centralizer_singleton_iff.mpr ?_⟩
    have hh := congrArg (fun x : Additive (localFiveModule T t v I) =>
      (((x.toMul : localFiveModule T t v I) : pointJoin T v I) : G)) he
    have ha := congrArg (pointJoin T v I).subtype
      (action_apply (localFiveModule T t v I) h m.pointVector)
    change _ = (h : G) * oppositePoint t v * (h : G)⁻¹ at ha
    change _ = oppositePoint t v at hh
    exact mul_inv_eq_iff_eq_mul.mp (ha.symm.trans hh)
  · intro hh
    have hc := mem_centralizer_singleton_iff.mp hh.2
    apply Additive.toMul.injective
    apply Subtype.ext
    apply Subtype.ext
    have ha := congrArg (pointJoin T v I).subtype
      (action_apply (localFiveModule T t v I) h m.pointVector)
    change _ = (h : G) * oppositePoint t v * (h : G)⁻¹ at ha
    exact ha.trans (mul_inv_eq_iff_eq_mul.mpr hc)

/-- Removing the literal action kernel preserves the intrinsic two-core quotient
of the original plane centralizer. -/
def LocalFiveData.planeQuotientEquiv {c : Context D t v I} (m : LocalFiveData c) :
    letI := m.reduced.normal
    letI := m.reduced.elementary
    (planeCentralizer T t v I ⧸ pCore 2 (planeCentralizer T t v I)) ≃*
      (representationStabilizer (action (localFiveModule T t v I)) m.pointVector ⧸
        pCore 2 (representationStabilizer (action (localFiveModule T t v I)) m.pointVector)) := by
  let := m.reduced.normal
  let := m.reduced.elementary
  let H := pointJoin T v I
  let C := planeCentralizer T t v I
  let q := actionMk (localFiveModule T t v I)
  let B := representationStabilizer (action (localFiveModule T t v I)) m.pointVector
  let i : C →* H := inclusion inf_le_left
  let f : C →* B := (q.comp i).codRestrict B (fun x =>
    (m.pointVector_fixed_iff (i x)).mpr x.property)
  have hf : Function.Surjective f := by
    intro b
    obtain ⟨h,hh⟩ := QuotientGroup.mk'_surjective (centralizer
      (localFiveModule T t v I : Set H)) b.val
    have hc : (h : G) ∈ C := (m.pointVector_fixed_iff h).mp (by
      change action (localFiveModule T t v I) (q h) m.pointVector = m.pointVector
      rw [show q h = b.val from hh]
      exact b.property)
    exact ⟨⟨h,hc⟩,Subtype.ext hh⟩
  have hk : IsPGroup 2 f.ker := by
    let j : f.ker →* q.ker := {
      toFun := fun x => ⟨i x.val, congrArg Subtype.val x.property⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl }
    exact m.action_kernel_two.of_injective j (by
      intro x y he
      apply Subtype.ext
      apply Subtype.ext
      exact congrArg (fun x : q.ker => ((x : H) : G)) he)
  exact f.pCoreQuotientEquiv hf hk

/-- The prescribed point Sylow has a full Sylow image fixing the actual u. -/
theorem LocalFiveData.pointVector_sylow {c : Context D t v I} (m : LocalFiveData c) :
    letI := m.reduced.normal
    letI := m.reduced.elementary
    ∃ S : Sylow 2 (ActionQuotient (localFiveModule T t v I)),
      (S : Subgroup _) ≤ representationStabilizer (action (localFiveModule T t v I)) m.pointVector := by
  let := m.reduced.normal
  let := m.reduced.elementary
  let H := pointJoin T v I
  let q := actionMk (localFiveModule T t v I)
  obtain ⟨S,hS⟩ := c.join_sylow
  refine ⟨S.mapSurjective (f := q) (QuotientGroup.mk'_surjective _),?_⟩
  rintro _ ⟨s,hs,rfl⟩
  apply (m.pointVector_fixed_iff s).mpr
  refine ⟨s.property,m.pointSylow_centralizes_plane ?_⟩
  exact hS ▸ mem_map_of_mem H.subtype hs

private theorem LocalFiveData.plane_maximal_of_stabilizer {c : Context D t v I}
    (m : LocalFiveData c)
    (hm : letI := m.reduced.normal; letI := m.reduced.elementary
      IsCoatom (representationStabilizer (action (localFiveModule T t v I)) m.pointVector)) :
    IsCoatom ((planeCentralizer T t v I).subgroupOf (pointJoin T v I)) := by
  let := m.reduced.normal
  let := m.reduced.elementary
  have he : (planeCentralizer T t v I).subgroupOf (pointJoin T v I) =
      (representationStabilizer (action (localFiveModule T t v I)) m.pointVector).comap
        (actionMk (localFiveModule T t v I)) := by
    ext h
    exact (m.pointVector_fixed_iff h).symm
  rw [he]
  exact isCoatom_comap_of_surjective (QuotientGroup.mk'_surjective _) hm

/-- Source 10.2.9's rank-five centralizer is a maximal parabolic in the actual
point join, with intrinsic quotient L₄(2). -/
theorem LocalFiveData.plane_structure_five {c : Context D t v I} (m : LocalFiveData c)
    (hd : letI := m.reduced.elementary
      Module.finrank (ZMod 2) (Additive (localFiveModule T t v I)) = 5) :
    IsCoatom ((planeCentralizer T t v I).subgroupOf (pointJoin T v I)) ∧
      Nonempty ((planeCentralizer T t v I ⧸ pCore 2 (planeCentralizer T t v I)) ≃*
        Matrix.ProjectiveSpecialLinearGroup (Fin 4) (ZMod 2)) := by
  let := m.reduced.normal
  let := m.reduced.elementary
  obtain ⟨hm,⟨e⟩⟩ := BinaryFivePointStabilizers.natural_structure
    (action (localFiveModule T t v I)) (action_faithful _) m.quotientActor hd
    m.pointVector m.pointVector_ne_zero
  exact ⟨m.plane_maximal_of_stabilizer hm,⟨m.planeQuotientEquiv.trans e⟩⟩

/-- Source 10.2.9's rank-ten centralizer is a maximal parabolic in the actual
point join. Its intrinsic quotient is S₃ × L₃(2), with no model callback. -/
theorem LocalFiveData.plane_structure_ten {c : Context D t v I} (m : LocalFiveData c)
    (hd : letI := m.reduced.elementary
      Module.finrank (ZMod 2) (Additive (localFiveModule T t v I)) = 10) :
    IsCoatom ((planeCentralizer T t v I).subgroupOf (pointJoin T v I)) ∧
      Nonempty ((planeCentralizer T t v I ⧸ pCore 2 (planeCentralizer T t v I)) ≃*
        Equiv.Perm (Fin 3) × Matrix.ProjectiveSpecialLinearGroup (Fin 3) (ZMod 2)) := by
  let := m.reduced.normal
  let := m.reduced.elementary
  let : IsIrreducible (action (localFiveModule T t v I)) := m.module_irreducible
  obtain ⟨S,hS⟩ := m.pointVector_sylow
  obtain ⟨hm,⟨e⟩⟩ := BinaryFivePointStabilizers.exterior_structure
    (action (localFiveModule T t v I)) m.quotientActor hd S m.pointVector m.pointVector_ne_zero hS
  let e₂ := (BinaryLinear.OuterCyclic.slEquivLinear 2).trans
    BinaryLinear.SmallParabolicLevi.linearTwoEquivSymmetricThree
  let e₃ := (BinaryLinear.OuterCyclic.slEquivLinear 3).trans
    BinaryLinear.SmallParabolicLevi.linearThreeEquivProjective
  exact ⟨m.plane_maximal_of_stabilizer hm,
    ⟨(m.planeQuotientEquiv.trans e).trans (e₂.prodCongr e₃)⟩⟩

/-- Both source dimensions give the genuine maximal plane centralizer. -/
theorem LocalFiveData.plane_maximal {c : Context D t v I} (m : LocalFiveData c) :
    IsCoatom ((planeCentralizer T t v I).subgroupOf (pointJoin T v I)) := by
  rcases m.dimension with hd | hd
  · exact (m.plane_structure_five hd).1
  · exact (m.plane_structure_ten hd).1


