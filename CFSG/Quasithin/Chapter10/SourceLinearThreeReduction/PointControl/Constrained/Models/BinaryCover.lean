/-!
# Binary containing sections on the original orbit module

Full original moved-span inclusion makes VI commutator-generated by I.
Vanishing of dual H¹ then makes the literal B.5.1 projection onto a binary
natural section of degree at least four, or an irreducible ten-dimensional
SL₅(2) section, an equivalence. Its original fixed kernel is proved zero.
The normalizer calculations consequently identify the literal I-image with
the entire centralizer quotient.

The original natural--dual moved subgroup excludes the four- and
five-dimensional natural sections by dimension. In the original natural-three
row, the ten-dimensional section now supplies all terminal module and actor
data; its actual two-core kernel identity alone remains explicit when applying
the proved parabolic contradiction. General preparation, original-row
recognition, this kernel identity, and the remaining containing actions are
still discharged by the final owner qt-d-10-nona5-point-constrained.
No irreducible constituent replaces the original module or its fixed vectors.

Source: Aschbacher--Smith 10.2.9, printed pp.751--753; the central-cover
cohomology calculations are I.1.6, printed p.408.
-/

public noncomputable section
open Subgroup Theory.GroupTheory Representation Representation.BinaryOffender
open CFSG.Quasithin.ChapterB.QuasisimpleSource
open scoped MatrixGroups IsMulCommutative

private theorem full_section
    {Q V : Type*} [Group Q] [Finite Q] [AddCommGroup V] [Module (ZMod 2) V]
    [FiniteDimensional (ZMod 2) V]
    (ρ : Representation (ZMod 2) Q V) (A : Subgroup Q) (s : MovedSection ρ A)
    (hm : Coinvariants.ker (ρ.comp A.subtype) = ⊤)
    (hH : Module.finrank (ZMod 2)
      (OneCohomology.H1 (Representation.dual (s.action.comp A.subtype))) = 0) :
    s.central.toSubmodule = ⊥ ∧
      Nonempty (Representation.Equiv (ρ.comp A.subtype) (s.action.comp A.subtype)) := by
  have he : Coinvariants.ker (ρ.comp A.subtype) = moved ρ A := by
    apply le_antisymm
    · apply Submodule.span_le.mpr
      rintro _ ⟨⟨a,v⟩,rfl⟩
      exact Submodule.subset_span ⟨a,a.property,v,Submodule.mem_top,rfl⟩
    · apply Submodule.span_le.mpr
      rintro _ ⟨a,ha,v,_,rfl⟩
      exact Coinvariants.sub_mem_ker (ρ := ρ.comp A.subtype) ⟨a,ha⟩ v
  have hfull : moved ρ A = ⊤ := he.symm.trans hm
  let p : Representation.IntertwiningMap (ρ.comp A.subtype) (s.action.comp A.subtype) := {
    toLinearMap := s.fullProjection hfull
    isIntertwining' := by
      intro a
      ext v
      exact s.fullProjection_intertwines hfull a v }
  have hp : OneCohomology.IsCover p := by
    refine ⟨s.fullProjection_surjective hfull,?_,hm⟩
    intro v hv a
    exact (s.fullProjection_eq_zero_iff hfull v).mp hv a
  have hinj := BinaryParabolicNatural.cover_injective_of_H1_zero p hp hH
  refine ⟨?_,⟨p.ofBijective ⟨hinj,hp.1⟩⟩⟩
  apply bot_unique
  intro w hw
  apply Subtype.ext
  apply hinj
  change s.fullProjection hfull w.val = s.fullProjection hfull 0
  rw [map_zero]
  exact (Submodule.Quotient.mk_eq_zero _).mpr hw

namespace CFSG.Quasithin.Chapter10.PointControl.Constrained
open Chapter3.Section02 ChapterB.InternalThompsonAction
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L : Subgroup G}
  {D : FundamentalSetup KnownSimple.IsKnownSimple T L} {t v : G} {I : Subgroup G}

private theorem restricted_coinvariants (c : Context D t v I)
    (hspan : ⁅D.fullModule,L⁆ ≤ orbitModule D v I) :
    letI := c.reduced.normal
    letI := c.reduced.elementary
    let A := (I.subgroupOf (pointJoin T v I)).map (actionMk (internalModule D v I))
    ∀ (N : Subgroup (ActionQuotient (internalModule D v I))) (_hAN : A ≤ N),
      Coinvariants.ker (((action (internalModule D v I)).comp N.subtype).comp
        (A.subgroupOf N).subtype) = ⊤ := by
  let := c.reduced.normal
  let := c.reduced.elementary
  let U := internalModule D v I
  let A := (I.subgroupOf (pointJoin T v I)).map (actionMk U)
  dsimp only
  intro N hAN
  apply top_unique
  rw [←c.orbit_coinvariants_of_moved_le hspan]
  apply Submodule.span_le.mpr
  rintro _ ⟨⟨a,w⟩,rfl⟩
  exact Coinvariants.sub_mem_ker
    (ρ := ((action U).comp N.subtype).comp (A.subgroupOf N).subtype)
    ⟨⟨a,hAN a.property⟩,a.property⟩ w

/-- Vanishing dual cohomology removes the fixed kernel of the actual natural
section and transports its marked action to the whole original orbit. -/
theorem Context.binary_natural_section_full (c : Context D t v I)
    (hspan : ⁅D.fullModule,L⁆ ≤ orbitModule D v I) {d : ℕ} (hd : 4 ≤ d) :
    letI := c.reduced.normal
    letI := c.reduced.elementary
    let A := (I.subgroupOf (pointJoin T v I)).map (actionMk (internalModule D v I))
    ∀ (N : Subgroup (ActionQuotient (internalModule D v I))) (hAN : A ≤ N)
      (s : MovedSection ((action (internalModule D v I)).comp N.subtype) (A.subgroupOf N))
      (e : ActionEquiv (s.action.comp (A.subgroupOf N).subtype) (linearNatural BinaryField.two d)),
      s.central.toSubmodule = ⊥ ∧
        ∃ E : ActionEquiv ((action (internalModule D v I)).comp A.subtype)
          (linearNatural BinaryField.two d),
          E.groupEquiv = (subgroupOfEquivOfLe hAN).symm.trans e.groupEquiv := by
  let := c.reduced.normal
  let := c.reduced.elementary
  dsimp only
  intro N hAN s e
  let A := (I.subgroupOf (pointJoin T v I)).map (actionMk (internalModule D v I))
  let := ChapterB.QuasisimpleSource.SourceCompletion.binary_natural_dual_H1
    (s.action.comp (A.subgroupOf N).subtype) hd ⟨e⟩
  have hH : Module.finrank (ZMod 2)
      (OneCohomology.H1 (Representation.dual (s.action.comp (A.subgroupOf N).subtype))) = 0 := Module.finrank_zero_of_subsingleton
  obtain ⟨hz,⟨f⟩⟩ := full_section _ _ s (restricted_coinvariants c hspan N hAN) hH
  refine ⟨hz,{
    groupEquiv := (subgroupOfEquivOfLe hAN).symm.trans e.groupEquiv
    linearEquiv := f.toLinearEquiv.trans e.linearEquiv
    intertwines := ?_ },rfl⟩
  intro a w
  have hf := LinearMap.congr_fun (f.isIntertwining' ((subgroupOfEquivOfLe hAN).symm a)) w
  exact (congrArg e.linearEquiv hf).trans
    (e.intertwines ((subgroupOfEquivOfLe hAN).symm a) (f w))

private theorem irreducible_of_equiv {H X Y : Type*} [Group H]
    [AddCommGroup X] [Module (ZMod 2) X] [AddCommGroup Y] [Module (ZMod 2) Y]
    {ρ : Representation (ZMod 2) H X} {σ : Representation (ZMod 2) H Y}
    (e : ρ.Equiv σ) (hs : IsIrreducible σ) : IsIrreducible ρ := by
  let f := IntertwiningMap.equivLinearMapAsModule ρ σ e.toIntertwiningMap
  let ef := LinearEquiv.ofBijective f (show Function.Bijective f from e.toLinearEquiv.bijective)
  rw [Representation.irreducible_iff_isSimpleModule_asModule]
  exact ef.isSimpleModule_iff.mpr
    ((Representation.irreducible_iff_isSimpleModule_asModule σ).mp hs)

/-- The actual ten-dimensional section has zero fixed kernel and makes the
whole original orbit irreducible of dimension ten. -/
theorem Context.exterior_five_section_full (c : Context D t v I)
    (hspan : ⁅D.fullModule,L⁆ ≤ orbitModule D v I) :
    letI := c.reduced.normal
    letI := c.reduced.elementary
    let A := (I.subgroupOf (pointJoin T v I)).map (actionMk (internalModule D v I))
    ∀ (N : Subgroup (ActionQuotient (internalModule D v I))) (_hAN : A ≤ N)
      (s : MovedSection ((action (internalModule D v I)).comp N.subtype) (A.subgroupOf N))
      (_e : (A.subgroupOf N) ≃* SL(5,ZMod 2)),
      IsIrreducible (s.action.comp (A.subgroupOf N).subtype) →
      Module.finrank (ZMod 2) (s.space.toSubmodule ⧸ s.central.toSubmodule) = 10 →
      s.central.toSubmodule = ⊥ ∧
        IsIrreducible ((action (internalModule D v I)).comp A.subtype) ∧
        Module.finrank (ZMod 2) (Additive (internalModule D v I)) = 10 := by
  let := c.reduced.normal
  let := c.reduced.elementary
  let U := internalModule D v I
  let A := (I.subgroupOf (pointJoin T v I)).map (actionMk U)
  dsimp only
  intro N hAN s e hi hd
  let := hi
  let : IsIrreducible (Representation.dual (s.action.comp (A.subgroupOf N).subtype)) := isIrreducible_dual
  let := SL5TenDimensional.h1_subsingleton_of_group_equiv
    (Representation.dual (s.action.comp (A.subgroupOf N).subtype)) e
    (by rw [Subspace.dual_finrank_eq,hd])
  have hH : Module.finrank (ZMod 2)
      (OneCohomology.H1 (Representation.dual (s.action.comp (A.subgroupOf N).subtype))) = 0 :=
    Module.finrank_zero_of_subsingleton
  obtain ⟨hz,⟨f⟩⟩ := full_section _ _ s (restricted_coinvariants c hspan N hAN) hH
  refine ⟨hz,?_,f.toLinearEquiv.finrank_eq.trans hd⟩
  have hC := irreducible_of_equiv f hi
  exact (irreducible_comp_surjective_iff
    (subgroupOfEquivOfLe hAN).toMonoidHom (subgroupOfEquivOfLe hAN).surjective
    ((action U).comp A.subtype)).mp hC

private theorem moved_card_le (c : Context D t v I)
    (hspan : ⁅D.fullModule,L⁆ ≤ orbitModule D v I) {d : ℕ}
    (hd : letI := c.reduced.elementary
      Module.finrank (ZMod 2) (Additive (internalModule D v I)) = d) :
    Nat.card (⁅D.fullModule,L⁆ : Subgroup G) ≤ 2 ^ d := by
  let := c.reduced.elementary
  have hU : Nat.card (internalModule D v I) = 2 ^ d := by
    change Nat.card (Additive (internalModule D v I)) = _
    rw [Module.natCard_eq_pow_finrank (K := ZMod 2),Nat.card_zmod,hd]
  have hV : Nat.card (orbitModule D v I) = 2 ^ d :=
    (Nat.card_congr (subgroupOfEquivOfLe c.orbit_le_join).toEquiv).symm.trans hU
  exact hV ▸ Nat.card_le_card_of_injective (inclusion hspan) (inclusion_injective hspan)

/-- The original six-dimensional natural--dual moved subgroup excludes a
natural containing section of degree four or five, with no full-span premise. -/
theorem Context.no_binary_natural_section_of_naturalDual (c : Context D t v I)
    (e : (L ⧸ pCore 2 L) ≃* BinaryLinearThree.Group)
    (r : BinaryConjugationSection L ⁅D.fullModule,L⁆ ⊥
      (BinaryLinearThree.NaturalDual.action.comp
        (e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 L)))))
    {d : ℕ} (hd : d = 4 ∨ d = 5) :
    letI := c.reduced.normal
    letI := c.reduced.elementary
    let A := (I.subgroupOf (pointJoin T v I)).map (actionMk (internalModule D v I))
    ∀ (N : Subgroup (ActionQuotient (internalModule D v I))) (_hAN : A ≤ N)
      (s : MovedSection ((action (internalModule D v I)).comp N.subtype) (A.subgroupOf N))
      (_E : ActionEquiv (s.action.comp (A.subgroupOf N).subtype)
        (linearNatural BinaryField.two d)), False := by
  let := c.reduced.normal
  let := c.reduced.elementary
  dsimp only
  intro N hAN s E
  have hspan := c.moved_le_of_naturalDual e r
  obtain ⟨_,f,_⟩ := c.binary_natural_section_full hspan (by omega) N hAN s E
  have hdim : Module.finrank (ZMod 2) (Additive (internalModule D v I)) = d := by
    exact f.linearEquiv.finrank_eq.trans (Module.finrank_fin_fun (ZMod 2))
  have hb := moved_card_le c hspan hdim
  have hcard := r.card_section
  have hm : Nat.card BinaryLinearThree.NaturalDual.Space = 64 := by
    rw [Module.natCard_eq_pow_finrank (K := ZMod 2),Nat.card_zmod]
    norm_num [BinaryLinearThree.NaturalDual.Space,BinaryLinearThree.Vector,
      Module.finrank_prod,Subspace.dual_finrank_eq]
  rw [hm,card_bot,mul_one] at hcard
  rw [hcard] at hb
  rcases hd with rfl | rfl <;> norm_num at hb

/-- In a natural containing row the literal I-image is the whole centralizer quotient. -/
theorem Context.actor_eq_top_of_binary_natural_section (c : Context D t v I)
    (hspan : ⁅D.fullModule,L⁆ ≤ orbitModule D v I) {d : ℕ} (hd : 4 ≤ d) :
    letI := c.reduced.normal
    letI := c.reduced.elementary
    let A := (I.subgroupOf (pointJoin T v I)).map (actionMk (internalModule D v I))
    ∀ (N : Subgroup (ActionQuotient (internalModule D v I))) (_hAN : A ≤ N)
      (s : MovedSection ((action (internalModule D v I)).comp N.subtype) (A.subgroupOf N))
      (_e : ActionEquiv (s.action.comp (A.subgroupOf N).subtype)
        (linearNatural BinaryField.two d)), A = ⊤ := by
  let H := pointJoin T v I
  let U := internalModule D v I
  let := c.reduced.normal
  let := c.reduced.elementary
  let K := I.subgroupOf H
  let A := K.map (actionMk U)
  let : K.Normal := normal_subgroupOf_of_le_normalizer
    (sup_le I.le_normalizer (inf_le_right.trans c.escaping.normalizes))
  let : A.Normal := Normal.map inferInstance (actionMk U) (QuotientGroup.mk'_surjective _)
  dsimp only
  intro N hAN s e
  obtain ⟨_,E,_⟩ := c.binary_natural_section_full hspan hd N hAN s e
  exact BinaryLinearNormalActors.normal_natural_eq_top (action U) (action_faithful U)
    A d E.groupEquiv E.linearEquiv E.intertwines

/-- The ten-dimensional containing row also supplies the exact whole-actor equality. -/
theorem Context.actor_eq_top_of_exterior_five_section (c : Context D t v I)
    (hspan : ⁅D.fullModule,L⁆ ≤ orbitModule D v I) :
    letI := c.reduced.normal
    letI := c.reduced.elementary
    let A := (I.subgroupOf (pointJoin T v I)).map (actionMk (internalModule D v I))
    ∀ (N : Subgroup (ActionQuotient (internalModule D v I))) (_hAN : A ≤ N)
      (s : MovedSection ((action (internalModule D v I)).comp N.subtype) (A.subgroupOf N))
      (_e : (A.subgroupOf N) ≃* SL(5,ZMod 2)),
      IsIrreducible (s.action.comp (A.subgroupOf N).subtype) →
      Module.finrank (ZMod 2) (s.space.toSubmodule ⧸ s.central.toSubmodule) = 10 → A = ⊤ := by
  let H := pointJoin T v I
  let U := internalModule D v I
  let := c.reduced.normal
  let := c.reduced.elementary
  let K := I.subgroupOf H
  let A := K.map (actionMk U)
  let : K.Normal := normal_subgroupOf_of_le_normalizer
    (sup_le I.le_normalizer (inf_le_right.trans c.escaping.normalizes))
  let : A.Normal := Normal.map inferInstance (actionMk U) (QuotientGroup.mk'_surjective _)
  dsimp only
  intro N hAN s e hi hd
  obtain ⟨_,hI,hV⟩ := c.exterior_five_section_full hspan N hAN s e hi hd
  let := hI
  exact BinaryLinearNormalActors.normal_ten_dimensional_eq_top (action U) (action_faithful U)
    A ((subgroupOfEquivOfLe hAN).symm.trans e) hV

/-- The literal exterior-five section feeds the proved parabolic contradiction.
The final source owner still discharges the displayed two-core kernel identity. -/
theorem Context.no_exterior_five_section_of_natural_three_of_kernel
    (c : Context D t v I)
    (e : (L ⧸ pCore 2 L) ≃* SL(3,ZMod 2))
    (r : BinaryConjugationSection L ⁅D.fullModule,L⁆ ⊥
      ((specialLinearNatural 3).comp
        (e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 L)))))
    (hk : letI := c.reduced.normal
      ((actionMk (internalModule D v I)).subgroupMap
        (I.subgroupOf (pointJoin T v I))).ker =
          pCore 2 (I.subgroupOf (pointJoin T v I))) :
    letI := c.reduced.normal
    letI := c.reduced.elementary
    let A := (I.subgroupOf (pointJoin T v I)).map (actionMk (internalModule D v I))
    ∀ (N : Subgroup (ActionQuotient (internalModule D v I))) (_hAN : A ≤ N)
      (s : MovedSection ((action (internalModule D v I)).comp N.subtype) (A.subgroupOf N))
      (_E : (A.subgroupOf N) ≃* SL(5,ZMod 2)),
      IsIrreducible (s.action.comp (A.subgroupOf N).subtype) →
      Module.finrank (ZMod 2) (s.space.toSubmodule ⧸ s.central.toSubmodule) = 10 → False := by
  let := c.reduced.normal
  let := c.reduced.elementary
  dsimp only
  intro N hAN s E hi hd
  have hspan := c.moved_le_of_natural_three e r
  obtain ⟨_,hI,hV⟩ := c.exterior_five_section_full hspan N hAN s E hi hd
  let m : LinearFiveData c := {
    quotient := e
    natural := r
    sylow_eq := c.pointSylow_eq_of_natural_three e r
    moved_le := hspan
    actor := (subgroupOfEquivOfLe hAN).symm.trans E
    actor_eq_top := c.actor_eq_top_of_exterior_five_section hspan N hAN s E hi hd
    kernel_eq := hk
    irreducible := hI
    dimension := Or.inr hV }
  exact m.impossible

