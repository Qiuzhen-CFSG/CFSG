/-!
# The exceptional A₇ section fills the literal orbit module

Full original moved-span inclusion makes VI commutator-generated by I.
The actual B.5.1 projection onto an irreducible four-dimensional A₇ section
is therefore a central cover. Vanishing of first cohomology of the dual
makes that projection injective, proving that its fixed kernel is zero and
that the whole original VI has dimension four.

For the original natural-three marking, the existing four-space argument
now reconstructs I/O₂(I) and excludes A₇ without a dimension premise. For
the original zero-kernel natural–dual marking, its six-dimensional moved
subgroup cannot embed in that four-space. Together with the deleted-seven
exclusion and the torus sieve, both markings leave actual SL₄(2) or SL₅(2)
actors. The complete B.5.1 source conclusion and its action markings are
retained. No constituent or abstract carrier replaces the original module.

General original-row recognition, quiet preparation and the remaining binary
reductions, including the four-natural row, remain with the final assembly
owner qt-d-10-nona5-point-constrained.
Source: Aschbacher–Smith 10.2.9, printed pp.751–752, and I.1.5–6,
printed p.408, for the central-cover cohomology calculation.
-/

public noncomputable section
open Subgroup Theory.GroupTheory Representation Representation.BinaryOffender
open CFSG.Quasithin.ChapterB.QuasisimpleSource

private theorem four_section_full
    {Q V : Type*} [Group Q] [AddCommGroup V] [Module (ZMod 2) V]
    [FiniteDimensional (ZMod 2) V]
    (ρ : Representation (ZMod 2) Q V) (A : Subgroup Q)
    (s : MovedSection ρ A) (e : A ≃* alternatingGroup (Fin 7))
    (hm : Coinvariants.ker (ρ.comp A.subtype) = ⊤)
    (hi : IsIrreducible (s.action.comp A.subtype))
    (hd : Module.finrank (ZMod 2) (s.space.toSubmodule ⧸ s.central.toSubmodule) = 4) :
    s.central.toSubmodule = ⊥ ∧ Module.finrank (ZMod 2) V = 4 := by
  have he : Coinvariants.ker (ρ.comp A.subtype) = moved ρ A := by
    apply le_antisymm
    · apply Submodule.span_le.mpr
      rintro _ ⟨⟨a,v⟩,rfl⟩
      exact Submodule.subset_span ⟨a,a.property,v,Submodule.mem_top,rfl⟩
    · apply Submodule.span_le.mpr
      rintro _ ⟨a,ha,v,_,rfl⟩
      exact Coinvariants.sub_mem_ker (ρ := ρ.comp A.subtype) ⟨a,ha⟩ v
  have hs : s.space.toSubmodule = ⊤ := s.space_eq.trans (he.symm.trans hm)
  let σ : Representation (ZMod 2) (alternatingGroup (Fin 7)) s.space.toSubmodule := (s.space.toRepresentation.comp A.subtype).comp e.symm.toMonoidHom
  let τ : Representation (ZMod 2) (alternatingGroup (Fin 7)) (s.space.toSubmodule ⧸ s.central.toSubmodule) := (s.action.comp A.subtype).comp e.symm.toMonoidHom
  let := hi
  let : IsIrreducible τ :=
    (irreducible_comp_surjective_iff e.symm.toMonoidHom e.symm.surjective _).mpr hi
  let p : σ.IntertwiningMap τ := {
    toLinearMap := s.central.toSubmodule.mkQ
    isIntertwining' := by intros; rfl }
  have hp : OneCohomology.IsCover p := by
    refine ⟨Submodule.mkQ_surjective _,?_,?_⟩
    · intro w hw g
      have hw' : w ∈ s.central.toSubmodule := (Submodule.Quotient.mk_eq_zero _).mp hw
      rw [s.central_eq] at hw'
      exact hw' (e.symm g)
    · let C := (Coinvariants.ker σ).map s.space.toSubmodule.subtype
      have hC : Coinvariants.ker (ρ.comp A.subtype) ≤ C := by
        apply Submodule.span_le.mpr
        rintro _ ⟨⟨a,v⟩,rfl⟩
        let w : s.space.toSubmodule := ⟨v,hs.symm ▸ Submodule.mem_top⟩
        refine ⟨σ (e a) w - w,Coinvariants.sub_mem_ker (e a) w,?_⟩
        change ρ (e.symm (e a)).val v - v = ρ a.val v - v
        rw [e.symm_apply_apply]
      apply top_unique
      intro w _
      obtain ⟨z,hz,he⟩ := hC (hm.symm ▸ (Submodule.mem_top : w.val ∈ (⊤ : Submodule (ZMod 2) V)))
      exact (Subtype.ext he : z = w) ▸ hz
  have hinj := BinaryAlternatingSevenControl.four_cover_injective hd p hp
  have hz : s.central.toSubmodule = ⊥ := by
    have hh := LinearMap.ker_eq_bot.mpr hinj
    change LinearMap.ker s.central.toSubmodule.mkQ = ⊥ at hh
    rwa [Submodule.ker_mkQ] at hh
  refine ⟨hz,?_⟩
  have heq := (LinearEquiv.ofBijective p.toLinearMap ⟨hinj,hp.1⟩).finrank_eq
  have hdW := heq.trans hd
  calc
    Module.finrank (ZMod 2) V = Module.finrank (ZMod 2) s.space.toSubmodule := by
      rw [hs,finrank_top]
    _ = 4 := hdW

namespace CFSG.Quasithin.Chapter10.PointControl.Constrained
open Chapter3.Section02 ChapterB.InternalThompsonAction
open scoped IsMulCommutative MatrixGroups
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L : Subgroup G}
  {D : FundamentalSetup KnownSimple.IsKnownSimple T L} {t v : G} {I : Subgroup G}

/-- Full original moved-span inclusion generates the entire literal reduced action by I-commutators. -/
theorem Context.orbit_coinvariants_of_moved_le (c : Context D t v I)
    (hspan : ⁅D.fullModule,L⁆ ≤ orbitModule D v I) :
    letI := c.reduced.normal
    letI := c.reduced.elementary
    let A := (I.subgroupOf (pointJoin T v I)).map (actionMk (internalModule D v I))
    Coinvariants.ker ((action (internalModule D v I)).comp A.subtype) = ⊤ := by
  let H := pointJoin T v I
  let K := I.subgroupOf H
  let U := internalModule D v I
  let := c.reduced.normal
  let := c.reduced.elementary
  have hmV : ⁅orbitModule D v I,I⁆ = orbitModule D v I :=
    (source_a5_point_action_marking D I c.escaping.strict.le c.escaping.escapes
      ((Subgroup.centralizer_le_normalizer _).trans c.escaping.moved_normalizer)
      hspan c.reduced).1
  have hm : ⁅U,K⁆ = U := by
    apply map_injective H.subtype_injective
    rw [map_commutator,map_subgroupOf_eq_of_le c.orbit_le_join,
      map_subgroupOf_eq_of_le (show I ≤ H from le_sup_left)]
    exact hmV
  exact NormalElementaryQuotient.coinvariants_image_eq_top U (actionMk U)
    (QuotientGroup.mk'_surjective _) (QuotientGroup.ker_mk' _) K
    (comap_mono c.orbit_le_component) hm

/-- The actual exceptional A₇ section has zero central kernel and fills the original VI. The quotient and offender inclusions are retained. -/
theorem Context.four_dimensional_of_seven_section (c : Context D t v I)
    (hspan : ⁅D.fullModule,L⁆ ≤ orbitModule D v I) :
    letI := c.reduced.normal
    letI := c.reduced.elementary
    let A := (I.subgroupOf (pointJoin T v I)).map (actionMk (internalModule D v I))
    ∀ (N : Subgroup (ActionQuotient (internalModule D v I))) (_hAN : A ≤ N)
      (s : MovedSection ((action (internalModule D v I)).comp N.subtype) (A.subgroupOf N))
      (_e : (A.subgroupOf N) ≃* alternatingGroup (Fin 7)),
      IsIrreducible (s.action.comp (A.subgroupOf N).subtype) →
      Module.finrank (ZMod 2) (s.space.toSubmodule ⧸ s.central.toSubmodule) = 4 →
      s.central.toSubmodule = ⊥ ∧
        Module.finrank (ZMod 2) (Additive (internalModule D v I)) = 4 := by
  let := c.reduced.normal
  let := c.reduced.elementary
  let U := internalModule D v I
  let A := (I.subgroupOf (pointJoin T v I)).map (actionMk U)
  dsimp only
  intro N hAN s e hi hd
  apply four_section_full _ _ s e ?_ hi hd
  apply top_unique
  rw [←c.orbit_coinvariants_of_moved_le hspan]
  apply Submodule.span_le.mpr
  rintro _ ⟨⟨a,w⟩,rfl⟩
  exact Coinvariants.sub_mem_ker
    (ρ := ((action U).comp N.subtype).comp (A.subgroupOf N).subtype)
    ⟨⟨a,hAN a.property⟩,a.property⟩ w

/-- The original natural-three marking excludes the exceptional A₇ source section; no whole-module dimension or two-core kernel premise remains. -/
theorem Context.no_seven_four_section_of_natural_three (c : Context D t v I)
    (e : (L ⧸ pCore 2 L) ≃* SL(3,ZMod 2))
    (r : BinaryConjugationSection L ⁅D.fullModule,L⁆ ⊥
      ((specialLinearNatural 3).comp (e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 L))))) :
    letI := c.reduced.normal
    letI := c.reduced.elementary
    let A := (I.subgroupOf (pointJoin T v I)).map (actionMk (internalModule D v I))
    ∀ (N : Subgroup (ActionQuotient (internalModule D v I))) (_hAN : A ≤ N)
      (s : MovedSection ((action (internalModule D v I)).comp N.subtype) (A.subgroupOf N))
      (_E : (A.subgroupOf N) ≃* alternatingGroup (Fin 7)),
      IsIrreducible (s.action.comp (A.subgroupOf N).subtype) →
      Module.finrank (ZMod 2) (s.space.toSubmodule ⧸ s.central.toSubmodule) = 4 → False := by
  let := c.reduced.normal
  let := c.reduced.elementary
  dsimp only
  intro N hAN s E hi hd
  have hfull := (c.four_dimensional_of_seven_section
    (c.moved_le_of_natural_three e r) N hAN s E hi hd).2
  exact c.no_four_alternatingSeven_action_of_natural_three e r
    ((subgroupOfEquivOfLe hAN).symm.trans E) hfull

end CFSG.Quasithin.Chapter10.PointControl.Constrained

namespace CFSG.Quasithin.Chapter10.PointControl.Constrained
open Chapter3.Section02 ChapterB.InternalThompsonAction
open scoped IsMulCommutative MatrixGroups
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L : Subgroup G}
  {D : FundamentalSetup KnownSimple.IsKnownSimple T L} {t v : G} {I : Subgroup G}

private theorem binary_source_action_of_no_four_section (c : Context D t v I)
    (a : ActionFacts c) (hspan : ⁅D.fullModule,L⁆ ≤ orbitModule D v I)
    (hfour : letI := c.reduced.normal
      letI := c.reduced.elementary
      let A := (I.subgroupOf (pointJoin T v I)).map (actionMk (internalModule D v I))
      let N := offenderSubgroup (action (internalModule D v I))
      ∀ (s : MovedSection ((action (internalModule D v I)).comp N.subtype) (A.subgroupOf N))
        (_E : (A.subgroupOf N) ≃* alternatingGroup (Fin 7)),
        IsIrreducible (s.action.comp (A.subgroupOf N).subtype) →
        Module.finrank (ZMod 2) (s.space.toSubmodule ⧸ s.central.toSubmodule) = 4 → False) :
    letI := c.reduced.normal
    letI := c.reduced.elementary
    let A := (I.subgroupOf (pointJoin T v I)).map (actionMk (internalModule D v I))
    let N := offenderSubgroup (action (internalModule D v I))
    ∃ h : ChapterB.SourceInduction.ProjectiveLine.QuasisimpleSourceConclusion
        ((action (internalModule D v I)).comp N.subtype) (A.subgroupOf N),
      BinaryOrSevenAction h.sectionData ∧
        ∃ d, (d = 4 ∨ d = 5) ∧ Nonempty (A ≃* SL(d,ZMod 2)) := by
  let := c.reduced.normal
  let := c.reduced.elementary
  let U := internalModule D v I
  let A := (I.subgroupOf (pointJoin T v I)).map (actionMk U)
  let N := offenderSubgroup (action U)
  have hAN : A ≤ N := a.classification.2.1
  let f : A ≃* A.subgroupOf N := (subgroupOfEquivOfLe hAN).symm
  obtain ⟨h,hs⟩ := c.binary_or_seven_action_of_moved_le a hspan
  refine ⟨h,hs,?_⟩
  cases hs with
  | sevenFour _ hi E hd =>
    exact (hfour h.sectionData E hi hd).elim
  | sevenDeleted _ _ E =>
    exact (c.no_deletedSeven_source_section a h.sectionData ⟨E⟩).elim
  | linear d hd _ _ E => exact ⟨d,hd,⟨f.trans E.groupEquiv⟩⟩
  | orthogonalSix _ _ E => exact ⟨4,Or.inl rfl,
      ⟨((f.trans E.groupEquiv).trans Atlas.Comparisons.Exceptional.alt8EquivPSL4Two).trans
        (_root_.BinaryLinear.OuterCyclic.projectiveEquivSL (by decide))⟩⟩
  | symmetricEight _ _ E => exact ⟨4,Or.inl rfl,
      ⟨((f.trans E.subgroupEquiv).trans Atlas.Comparisons.Exceptional.alt8EquivPSL4Two).trans
        (_root_.BinaryLinear.OuterCyclic.projectiveEquivSL (by decide))⟩⟩
  | exteriorFive _ _ E _ => exact ⟨5,Or.inr rfl,⟨f.trans E⟩⟩
  | naturalDual d hd E => exact ⟨d,hd,⟨f.trans E.some.groupEquiv⟩⟩
  | repeatedNatural d _ hd _ _ E => exact ⟨d,hd,⟨f.trans E.some.groupEquiv⟩⟩

/-- The natural-three row leaves a binary linear actor of degree four or five, retaining every source action clause and supplying its own preparation. -/
theorem Context.binary_source_action_of_natural_three (c : Context D t v I)
    (e : (L ⧸ pCore 2 L) ≃* SL(3,ZMod 2))
    (r : BinaryConjugationSection L ⁅D.fullModule,L⁆ ⊥
      ((specialLinearNatural 3).comp (e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 L))))) :
    letI := c.reduced.normal
    letI := c.reduced.elementary
    let A := (I.subgroupOf (pointJoin T v I)).map (actionMk (internalModule D v I))
    let N := offenderSubgroup (action (internalModule D v I))
    ∃ h : ChapterB.SourceInduction.ProjectiveLine.QuasisimpleSourceConclusion
        ((action (internalModule D v I)).comp N.subtype) (A.subgroupOf N),
      BinaryOrSevenAction h.sectionData ∧
        ∃ d, (d = 4 ∨ d = 5) ∧ Nonempty (A ≃* SL(d,ZMod 2)) := by
  let := c.reduced.normal
  let := c.reduced.elementary
  have a := c.actionFacts_of_natural_three e r
  exact binary_source_action_of_no_four_section c a (c.moved_le_of_natural_three e r)
    (c.no_seven_four_section_of_natural_three e r _ a.classification.2.1)

/-- No containing A₇ actor occurs for the original natural-three marking, regardless of the initially chosen B.5.1 section. -/
theorem Context.no_seven_actor_of_natural_three (c : Context D t v I)
    (e : (L ⧸ pCore 2 L) ≃* SL(3,ZMod 2))
    (r : BinaryConjugationSection L ⁅D.fullModule,L⁆ ⊥
      ((specialLinearNatural 3).comp (e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 L))))) :
    letI := c.reduced.normal
    ∀ (_E : ((I.subgroupOf (pointJoin T v I)).map (actionMk (internalModule D v I))) ≃*
      alternatingGroup (Fin 7)), False := by
  let := c.reduced.normal
  let := c.reduced.elementary
  intro E
  obtain ⟨_,_,d,hd,⟨f⟩⟩ := c.binary_source_action_of_natural_three e r
  have hc := Nat.card_congr (f.symm.trans E).toEquiv
  rw [_root_.BinaryLinear.card_SL,nat_card_alternatingGroup] at hc
  rcases hd with rfl | rfl <;>
    norm_num [_root_.BinaryLinear.order,Fin.prod_univ_succ,Nat.factorial] at hc

end CFSG.Quasithin.Chapter10.PointControl.Constrained

namespace CFSG.Quasithin.Chapter10.PointControl.Constrained
open Chapter3.Section02 ChapterB.InternalThompsonAction
open scoped IsMulCommutative MatrixGroups
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L : Subgroup G}
  {D : FundamentalSetup KnownSimple.IsKnownSimple T L} {t v : G} {I : Subgroup G}

private theorem moved_card_le_sixteen_of_four (c : Context D t v I)
    (hspan : ⁅D.fullModule,L⁆ ≤ orbitModule D v I)
    (hd : letI := c.reduced.elementary
      Module.finrank (ZMod 2) (Additive (internalModule D v I)) = 4) :
    Nat.card (⁅D.fullModule,L⁆ : Subgroup G) ≤ 16 := by
  let := c.reduced.elementary
  have hU : Nat.card (internalModule D v I) = 16 := by
    change Nat.card (Additive (internalModule D v I)) = 16
    rw [Module.natCard_eq_pow_finrank (K := ZMod 2),Nat.card_zmod,hd]
    norm_num
  have hV : Nat.card (orbitModule D v I) = 16 :=
    (Nat.card_congr (subgroupOfEquivOfLe c.orbit_le_join).toEquiv).symm.trans hU
  exact hV ▸ Nat.card_le_card_of_injective (inclusion hspan) (inclusion_injective hspan)

/-- The original six-dimensional natural–dual moved subgroup excludes the exceptional four-dimensional A₇ section. -/
theorem Context.no_seven_four_section_of_naturalDual (c : Context D t v I)
    (e : (L ⧸ pCore 2 L) ≃* BinaryLinearThree.Group)
    (r : BinaryConjugationSection L ⁅D.fullModule,L⁆ ⊥
      (BinaryLinearThree.NaturalDual.action.comp
        (e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 L))))) :
    letI := c.reduced.normal
    letI := c.reduced.elementary
    let A := (I.subgroupOf (pointJoin T v I)).map (actionMk (internalModule D v I))
    ∀ (N : Subgroup (ActionQuotient (internalModule D v I))) (_hAN : A ≤ N)
      (s : MovedSection ((action (internalModule D v I)).comp N.subtype) (A.subgroupOf N))
      (_E : (A.subgroupOf N) ≃* alternatingGroup (Fin 7)),
      IsIrreducible (s.action.comp (A.subgroupOf N).subtype) →
      Module.finrank (ZMod 2) (s.space.toSubmodule ⧸ s.central.toSubmodule) = 4 → False := by
  let := c.reduced.normal
  let := c.reduced.elementary
  dsimp only
  intro N hAN s E hi hd
  have hspan := c.moved_le_of_naturalDual e r
  have hfull := (c.four_dimensional_of_seven_section hspan N hAN s E hi hd).2
  have hsmall := moved_card_le_sixteen_of_four c hspan hfull
  have hmodel : Nat.card BinaryLinearThree.NaturalDual.Space = 64 := by
    rw [Module.natCard_eq_pow_finrank (K := ZMod 2),Nat.card_zmod]
    norm_num [BinaryLinearThree.NaturalDual.Space,BinaryLinearThree.Vector,
      Module.finrank_prod,Subspace.dual_finrank_eq]
  have hcard := r.card_section
  rw [hmodel,card_bot,mul_one] at hcard
  omega

/-- The natural–dual marking supplies preparation and reduces the literal source action to a binary actor of degree four or five. -/
theorem Context.binary_source_action_of_naturalDual (c : Context D t v I)
    (e : (L ⧸ pCore 2 L) ≃* BinaryLinearThree.Group)
    (r : BinaryConjugationSection L ⁅D.fullModule,L⁆ ⊥
      (BinaryLinearThree.NaturalDual.action.comp
        (e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 L))))) :
    letI := c.reduced.normal
    letI := c.reduced.elementary
    let A := (I.subgroupOf (pointJoin T v I)).map (actionMk (internalModule D v I))
    let N := offenderSubgroup (action (internalModule D v I))
    ∃ h : ChapterB.SourceInduction.ProjectiveLine.QuasisimpleSourceConclusion
        ((action (internalModule D v I)).comp N.subtype) (A.subgroupOf N),
      BinaryOrSevenAction h.sectionData ∧
        ∃ d, (d = 4 ∨ d = 5) ∧ Nonempty (A ≃* SL(d,ZMod 2)) := by
  let := c.reduced.normal
  let := c.reduced.elementary
  have a := c.actionFacts_of_naturalDual e r
  exact binary_source_action_of_no_four_section c a (c.moved_le_of_naturalDual e r)
    (c.no_seven_four_section_of_naturalDual e r _ a.classification.2.1)

/-- The original natural–dual marking excludes every containing A₇ actor. -/
theorem Context.no_seven_actor_of_naturalDual (c : Context D t v I)
    (e : (L ⧸ pCore 2 L) ≃* BinaryLinearThree.Group)
    (r : BinaryConjugationSection L ⁅D.fullModule,L⁆ ⊥
      (BinaryLinearThree.NaturalDual.action.comp
        (e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 L))))) :
    letI := c.reduced.normal
    ∀ (_E : ((I.subgroupOf (pointJoin T v I)).map (actionMk (internalModule D v I))) ≃*
      alternatingGroup (Fin 7)), False := by
  let := c.reduced.normal
  let := c.reduced.elementary
  intro E
  obtain ⟨_,_,d,hd,⟨f⟩⟩ := c.binary_source_action_of_naturalDual e r
  have hc := Nat.card_congr (f.symm.trans E).toEquiv
  rw [_root_.BinaryLinear.card_SL,nat_card_alternatingGroup] at hc
  rcases hd with rfl | rfl <;>
    norm_num [_root_.BinaryLinear.order,Fin.prod_univ_succ,Nat.factorial] at hc

end CFSG.Quasithin.Chapter10.PointControl.Constrained
