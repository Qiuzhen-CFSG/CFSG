public import CFSG.Quasithin.Chapter10.SourceLinearThreeReduction.PointControl.Constrained.Models.BinaryKernel
public import Theory.Representation.BinaryConjugationSection.Multiplicity
public import Theory.Representation.PSL3Two.NaturalDualCentralizer

/-!
# Repeated containing actions on the original natural three-space

The original moved subgroup is a simple three-space with scalar
endomorphisms. Each coordinate map into a natural four- or five-space has
the same simple image: a second independent image would require dimension
at least six. Thus all coordinate maps in a repeated containing module are
proportional. Since the literal orbit VI is generated by the original moved
subgroup, these relations hold on all of VI, forcing multiplicity one.

The resulting single-natural action feeds the already proved degree-four
or degree-five contradiction. The final consumer retains the complete B.5.1
source conclusion and reduces this marked original row to the orthogonal
six-space, deleted eight-point and natural--dual containing actions.
The general quiet preparation, the original four-natural row, and the
remaining containing exclusions stay with qt-d-10-nona5-point-constrained.

Source: Aschbacher--Smith 10.2.9, printed p.752, the irreducible-orbit step.
-/

public noncomputable section
namespace CFSG.Quasithin.Chapter10.PointControl.Constrained
open Subgroup Theory.GroupTheory Representation Representation.BinaryOffender
open Chapter3.Section02 ChapterB.InternalThompsonAction ChapterB.QuasisimpleSource
open scoped MatrixGroups IsMulCommutative
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L : Subgroup G}
  {D : FundamentalSetup KnownSimple.IsKnownSimple T L} {t v : G} {I : Subgroup G}

/-- Repetition in the actual orbit has multiplicity one when the original
moved subgroup is a natural three-space. -/
theorem Context.repeated_multiplicity_one_of_natural_three
    (c : Context D t v I)
    (e : (L ⧸ pCore 2 L) ≃* SL(3,ZMod 2))
    (r : BinaryConjugationSection L ⁅D.fullModule,L⁆ ⊥
      ((specialLinearNatural 3).comp
        (e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 L)))))
    {d n : ℕ} (hd : d = 4 ∨ d = 5) (hn : 0 < n) :
    letI := c.reduced.normal
    letI := c.reduced.elementary
    let A := (I.subgroupOf (pointJoin T v I)).map (actionMk (internalModule D v I))
    ∀ (_E : ActionEquiv ((action (internalModule D v I)).comp A.subtype)
      (repeated (linearNatural BinaryField.two d) n)), n = 1 := by
  let H := pointJoin T v I
  let U := internalModule D v I
  let R := orbitModule D v I
  let K := I.subgroupOf H
  let := c.reduced.normal
  let := c.reduced.elementary
  let W := ⁅D.fullModule,L⁆
  let : IsElementaryAbelian 2 W := source_original_full_moved_elementary D
  let A := K.map (actionMk U)
  dsimp only
  intro E
  have hspan := c.moved_le_of_natural_three e r
  let q := e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 L))
  have hq : Function.Surjective q := e.surjective.comp (QuotientGroup.mk'_surjective _)
  let ρ : Representation (ZMod 2) L (Fin 3 → ZMod 2) :=
    (specialLinearNatural (k := ZMod 2) 3).comp q
  let : IsIrreducible ρ := (irreducible_comp_surjective_iff q hq _).mpr
    BinaryLinearThree.IrreducibleCatalogue.natural_irreducible
  let f : I →* A := ((actionMk U).subgroupMap K).comp
    (subgroupOfEquivOfLe (show I ≤ H from le_sup_left)).symm.toMonoidHom
  let φ := E.groupEquiv.toMonoidHom.comp f
  let σ := (linearNatural BinaryField.two d).comp φ
  let τ := (repeated (linearNatural BinaryField.two d) n).comp φ
  let j : R ≃* U := (subgroupOfEquivOfLe c.orbit_le_join).symm
  let s : BinaryConjugationSection I R ⊥ τ := {
    section_le := c.orbit_le_component
    kernel_le := bot_le
    normalized := le_normalizer_conjugateSpanBy _ _
    coordinates := {
      toFun w := Multiplicative.ofAdd (E.linearEquiv (Additive.ofMul (j w)))
      map_one' := by change E.linearEquiv (Additive.ofMul (j 1)) = 0; rw [map_one]; exact E.linearEquiv.map_zero
      map_mul' x y := by
        change E.linearEquiv (Additive.ofMul (j (x*y))) =
          E.linearEquiv (Additive.ofMul (j x)) + E.linearEquiv (Additive.ofMul (j y))
        rw [map_mul]; exact E.linearEquiv.map_add _ _ }
    onto := by
      intro w
      exact ⟨j.symm (E.linearEquiv.symm w.toAdd).toMul,by
        change E.linearEquiv (Additive.ofMul (j (j.symm _))) = w.toAdd
        rw [j.apply_symm_apply]
        exact E.linearEquiv.apply_symm_apply _⟩
    kernel_eq := by
      ext w
      change E.linearEquiv (Additive.ofMul (j w)) = 0 ↔ (w:G) = 1
      rw [E.linearEquiv.map_eq_zero_iff]
      change j w = 1 ↔ (w:G) = 1
      rw [j.map_eq_one_iff]
      exact Subtype.val_inj.symm
    equivariant := by
      intro i w
      have ha : action U (f i).val (Additive.ofMul (j w)) =
          Additive.ofMul (j ⟨(i:G)*w*(i:G)⁻¹,
            (mem_normalizer_iff.mp (le_normalizer_conjugateSpanBy _ _ i.property) w).mp w.property⟩) := by
        apply Additive.toMul.injective
        apply Subtype.ext
        apply Subtype.ext
        exact congrArg H.subtype
          (action_apply U ⟨i,(show I ≤ H from le_sup_left) i.property⟩ (Additive.ofMul (j w)))
      exact (congrArg E.linearEquiv ha.symm).trans (E.intertwines (f i) _) }
  have hscalar (b : ρ.IntertwiningMap ρ) : ∃ a : ZMod 2, ∀ w, b w = a • w := by
    let b' : BinaryLinearThree.W.IntertwiningMap BinaryLinearThree.W := {
      toLinearMap := b.toLinearMap
      isIntertwining' := by intro g; obtain ⟨l,rfl⟩ := hq g; exact b.isIntertwining' l }
    exact BinaryLinearThree.NaturalDual.natural_scalar b'
  let : Nonempty (Fin d) := ⟨⟨0,by omega⟩⟩
  have hdim : Module.finrank (ZMod 2) (Fin d → BinaryField.two.Carrier) <
      2 * Module.finrank (ZMod 2) (Fin 3 → ZMod 2) := by
    change Module.finrank (ZMod 2) (Fin d → ZMod 2) <
      2 * Module.finrank (ZMod 2) (Fin 3 → ZMod 2)
    rw [Module.finrank_fin_fun,Module.finrank_fin_fun]
    omega
  exact r.copies_eq_one_of_generates σ τ (fun _ _ _ => rfl) s
    c.escaping.strict.le hspan
    (conjugateSpanBy_mono inf_le_left le_rfl) hscalar hdim hn

end CFSG.Quasithin.Chapter10.PointControl.Constrained

namespace CFSG.Quasithin.Chapter10.PointControl.Constrained
open Subgroup Theory.GroupTheory Representation Representation.BinaryOffender
open Chapter3.Section02 ChapterB.InternalThompsonAction ChapterB.QuasisimpleSource
open scoped MatrixGroups IsMulCommutative
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L : Subgroup G}
  {D : FundamentalSetup KnownSimple.IsKnownSimple T L} {t v : G} {I : Subgroup G}

private theorem whole_natural_impossible (c : Context D t v I)
    (e : (L ⧸ pCore 2 L) ≃* SL(3,ZMod 2))
    (r : BinaryConjugationSection L ⁅D.fullModule,L⁆ ⊥
      ((specialLinearNatural 3).comp
        (e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 L)))))
    {d : ℕ} (hd : d = 4 ∨ d = 5) :
    letI := c.reduced.normal
    letI := c.reduced.elementary
    let A := (I.subgroupOf (pointJoin T v I)).map (actionMk (internalModule D v I))
    ∀ (_E : ActionEquiv ((action (internalModule D v I)).comp A.subtype)
      (linearNatural BinaryField.two d)), False := by
  let H := pointJoin T v I
  let U := internalModule D v I
  let K := I.subgroupOf H
  let := c.reduced.normal
  let := c.reduced.elementary
  let A := K.map (actionMk U)
  dsimp only
  intro E
  have hdim := E.linearEquiv.finrank_eq.trans (Module.finrank_fin_fun (ZMod 2))
  rcases hd with rfl | rfl
  · exact c.no_four_dimensional_binary_actor_of_natural_three e r E.groupEquiv hdim
  · let : K.Normal := normal_subgroupOf_of_le_normalizer
      (sup_le I.le_normalizer (inf_le_right.trans c.escaping.normalizes))
    let : A.Normal := Normal.map inferInstance (actionMk U) (QuotientGroup.mk'_surjective _)
    let m : LinearFiveData c := {
      quotient := e
      natural := r
      sylow_eq := c.pointSylow_eq_of_natural_three e r
      moved_le := c.moved_le_of_natural_three e r
      actor := E.groupEquiv
      actor_eq_top := BinaryLinearNormalActors.normal_natural_eq_top (action U) (action_faithful U)
        A 5 E.groupEquiv E.linearEquiv E.intertwines
      kernel_eq := c.action_kernel_eq_twoCore_of_binary_actor (Or.inr rfl) E.groupEquiv
      irreducible := ExtensionConsequences.irreducible_of_equiv E
        (ExtensionConsequences.linearNatural_irreducible BinaryField.two (by decide))
      dimension := Or.inl hdim }
    exact m.impossible

/-- The complete repeated-natural containing row is excluded, on the
original orbit and with its source action marking retained. -/
theorem Context.no_repeated_natural_section_of_natural_three
    (c : Context D t v I)
    (e : (L ⧸ pCore 2 L) ≃* SL(3,ZMod 2))
    (r : BinaryConjugationSection L ⁅D.fullModule,L⁆ ⊥
      ((specialLinearNatural 3).comp
        (e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 L)))))
    {d n : ℕ} (hd : d = 4 ∨ d = 5) (hn : 0 < n) :
    letI := c.reduced.normal
    letI := c.reduced.elementary
    let A := (I.subgroupOf (pointJoin T v I)).map (actionMk (internalModule D v I))
    ∀ (N : Subgroup (ActionQuotient (internalModule D v I))) (_hAN : A ≤ N)
      (s : MovedSection ((action (internalModule D v I)).comp N.subtype) (A.subgroupOf N))
      (_E : ActionEquiv (s.space.toRepresentation.comp (A.subgroupOf N).subtype)
        (repeated (linearNatural BinaryField.two d) n)), False := by
  let := c.reduced.normal
  let := c.reduced.elementary
  let U := internalModule D v I
  let A := (I.subgroupOf (pointJoin T v I)).map (actionMk U)
  dsimp only
  intro N hAN s E
  have hs : s.space.toSubmodule = ⊤ := by
    rw [s.space_eq,moved_comp_map,map_subgroupOf_eq_of_le hAN]
    exact c.fully_moved_of_moved_le (c.moved_le_of_natural_three e r)
  let j : Additive U ≃ₗ[ZMod 2] s.space.toSubmodule := LinearEquiv.ofBijective
    ((LinearMap.id : Additive U →ₗ[ZMod 2] Additive U).codRestrict s.space.toSubmodule
      (fun _ => hs.symm ▸ Submodule.mem_top))
    ⟨fun _ _ h => congrArg Subtype.val h,fun w => ⟨w.val,Subtype.ext rfl⟩⟩
  let f : ActionEquiv ((action U).comp A.subtype)
      (repeated (linearNatural BinaryField.two d) n) := {
    groupEquiv := (subgroupOfEquivOfLe hAN).symm.trans E.groupEquiv
    linearEquiv := j.trans E.linearEquiv
    intertwines := fun a w => E.intertwines ((subgroupOfEquivOfLe hAN).symm a) (j w) }
  have hn1 := c.repeated_multiplicity_one_of_natural_three e r hd hn f
  subst n
  let one : (Fin 1 → Fin d → ZMod 2) ≃ₗ[ZMod 2] (Fin d → ZMod 2) := {
    toFun w := w 0
    invFun w _ := w
    left_inv w := funext fun i => congrArg w (Subsingleton.elim _ _)
    right_inv _ := rfl
    map_add' _ _ := rfl
    map_smul' _ _ := rfl }
  exact whole_natural_impossible c e r hd {
    groupEquiv := f.groupEquiv
    linearEquiv := f.linearEquiv.trans one
    intertwines := fun a w => congrFun (f.intertwines a w) 0 }

/-- The surviving source markings after the repeated, single-natural and
exterior families have been excluded in the original natural-three row. -/
inductive NaturalThreeRemainingAction
    {Q V : Type*} [Group Q] [AddCommGroup V] [Module (ZMod 2) V]
    {ρ : Representation (ZMod 2) Q V} {A : Subgroup Q} (s : MovedSection ρ A) : Prop
  | orthogonalSix (faithful : Function.Injective s.action)
      (irreducible : IsIrreducible (s.action.comp A.subtype))
      (action : ActionEquiv (s.action.comp A.subtype) (alternatingNatural 8))
  | symmetricEight (faithful : Function.Injective s.action)
      (irreducible : IsIrreducible (s.action.comp A.subtype))
      (action : MarkedActionEquiv s.action (offenderSubgroup s.action) A
        (BinaryPermutation.naturalRepresentation (Fin 8)) (alternatingGroup (Fin 8)))
  | naturalDual (d : ℕ) (degree : d = 4 ∨ d = 5)
      (action : IsNaturalPlusDual (s.space.toRepresentation.comp A.subtype) d)

/-- Actual consumer: the literal B.5.1 conclusion now has only the
orthogonal/deleted-eight and natural--dual containing actions in this row.
The remaining exclusions stay with qt-d-10-nona5-point-constrained. -/
theorem Context.remaining_source_action_of_natural_three
    (c : Context D t v I)
    (e : (L ⧸ pCore 2 L) ≃* SL(3,ZMod 2))
    (r : BinaryConjugationSection L ⁅D.fullModule,L⁆ ⊥
      ((specialLinearNatural 3).comp
        (e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 L))))) :
    letI := c.reduced.normal
    letI := c.reduced.elementary
    let A := (I.subgroupOf (pointJoin T v I)).map (actionMk (internalModule D v I))
    let N := offenderSubgroup (action (internalModule D v I))
    ∃ h : ChapterB.SourceInduction.ProjectiveLine.QuasisimpleSourceConclusion
        ((action (internalModule D v I)).comp N.subtype) (A.subgroupOf N),
      NaturalThreeRemainingAction h.sectionData ∧
        ∃ d, (d = 4 ∨ d = 5) ∧ Nonempty (A ≃* SL(d,ZMod 2)) := by
  let := c.reduced.normal
  let := c.reduced.elementary
  let U := internalModule D v I
  let A := (I.subgroupOf (pointJoin T v I)).map (actionMk U)
  let N := offenderSubgroup (action U)
  have a := c.actionFacts_of_natural_three e r
  have hAN : A ≤ N := a.classification.2.1
  obtain ⟨h,hs,hactor⟩ := c.binary_source_action_of_natural_three e r
  refine ⟨h,?_,hactor⟩
  cases hs with
  | sevenFour _ hi E hd => exact (c.no_seven_four_section_of_natural_three e r N hAN h.sectionData E hi hd).elim
  | sevenDeleted _ _ E => exact (c.no_deletedSeven_source_section a h.sectionData ⟨E⟩).elim
  | linear d hd _ _ E => exact (c.no_binary_natural_section_of_natural_three e r hd N hAN h.sectionData E).elim
  | orthogonalSix hf hi E => exact .orthogonalSix hf hi E
  | symmetricEight hf hi E => exact .symmetricEight hf hi E
  | exteriorFive _ hi E hd => exact (c.no_exterior_five_section_of_natural_three e r N hAN h.sectionData E hi hd).elim
  | naturalDual d hd E => exact .naturalDual d hd E
  | repeatedNatural d n hd hn _ E =>
    exact (c.no_repeated_natural_section_of_natural_three e r hd hn N hAN h.sectionData E.some).elim

end CFSG.Quasithin.Chapter10.PointControl.Constrained
