module
public import CFSG.Quasithin.Chapter10.SourceLinearThreeReduction.PointControl.Constrained.Preparation.FourNatural
public import CFSG.Quasithin.Chapter10.SourceLinearThreeReduction.PointControl.Constrained.Models.SevenMoved
public import Theory.SpecificGroups.Alternating.SevenThreeCore

/-!
# Excluding A₇ containing actions for the original four-natural cover

The exceptional A₇ section reconstructs the actual block I inside I C_T(v).
The original SL₃(2) quotient places O₂(L) inside O₂(I). Since the original
moved subgroup is generated by its L-commutators, it lies in the block layer
[VI,I]. Consequently the full original moved subgroup lies in VI in this
branch, and its order 4096 contradicts the four-dimensional A₇ orbit.
This argument retains the fixed kernels and does not assume full-orbit
containment from the four-natural marking alone.

The deleted-seven action is already excluded by the original point Sylow.
The complete source action therefore has a binary SL₄(2) or SL₅(2) actor;
the actual action kernel identifies I/O₂(I) and the cubic residual of C_G(v).
Source applies this reduction to original point control. Original row
exhaustion and the remaining binary containing exclusions stay with
qt-d-10-nona5-point-constrained; no later generation bound is used.

Source: Aschbacher--Smith 10.2.9 and C.1.24, pp.751--752 and130--131.
-/

public noncomputable section
open Subgroup Theory.GroupTheory Representation Representation.BinaryOffender
open scoped MatrixGroups IsMulCommutative

namespace CFSG.Quasithin.Chapter10.PointControl.Constrained
open Chapter3.Section02 ChapterB.InternalThompsonAction ChapterB.QuasisimpleSource
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L : Subgroup G}
  {D : FundamentalSetup KnownSimple.IsKnownSimple T L} {t v : G} {I : Subgroup G}

/-- The original moved subgroup lies in VI once the actual A₇ block is reconstructed. -/
theorem Context.moved_le_of_seven_block (c : Context D t v I)
    (e : (L ⧸ pCore 2 L) ≃* SL(3,ZMod 2))
    (E : (I ⧸ pCore 2 I) ≃* alternatingGroup (Fin 7))
    (hb : ChapterC.IsBlock (I.subgroupOf (pointJoin T v I)))
    (hne : ⁅internalModule D v I,I.subgroupOf (pointJoin T v I)⁆ ≠ ⊥) :
    ⁅D.fullModule,L⁆ ≤ orbitModule D v I := by
  let H := pointJoin T v I
  let K := I.subgroupOf H
  let U := internalModule D v I
  let W := ⁅D.fullModule,L⁆
  let B := L.subgroupOf H
  let Z := W.subgroupOf H
  let := c.reduced.normal
  let := c.reduced.elementary
  have hLH : L ≤ H := c.escaping.strict.le.trans le_sup_left
  have hWH : W ≤ H := (source_full_moved_le_component D).trans hLH
  have hmap : (K.pCoreIn 2).map H.subtype = I.pCoreIn 2 := by
    rw [map_pCoreIn_of_injective 2 _ _ H.subtype_injective,
      map_subgroupOf_eq_of_le (show I ≤ H from le_sup_left)]
  have hZ : Z ≤ K.pCoreIn 2 := by
    intro z hz
    have hWC : W ≤ L.pCoreIn 2 := le_pCoreIn_of_normalizes
      (source_original_full_moved_elementary D).isPGroup
      (source_full_moved_le_component D) (normalizer_commutator_ge_right _ _)
    have hc := hWC.trans
      (alternatingGroup.SevenThreeSection.twoCoreIn_le_of_quotient_equivs L I c.escaping.strict.le e E)
    have hh := hc hz
    rw [←hmap] at hh
    exact (mem_map_iff_mem H.subtype_injective).mp hh
  have hmove : ⁅Z,B⁆ = Z := by
    apply map_injective H.subtype_injective
    rw [map_commutator,map_subgroupOf_eq_of_le hWH,map_subgroupOf_eq_of_le hLH]
    exact source_full_moved_eq_commutator D
  have hblock : (ChapterC.blockU K).map K.subtype = ⁅U,K⁆ :=
    ChapterC.RankOne.ChiProduct.SelectedRankOne.blockU_eq_nontrivial_normal_module_commutator
      K U hb hne
  have hZU : Z ≤ U := by
    rw [←hmove]
    apply (commutator_mono hZ (comap_mono c.escaping.strict.le)).trans
    have he : ⁅K.pCoreIn 2,K⁆ = (ChapterC.blockU K).map K.subtype := by
      rw [ChapterC.blockU,map_commutator,←MonoidHom.range_eq_map,range_subtype]
      rfl
    change ⁅K.pCoreIn 2,K⁆ ≤ U
    rw [he,hblock]
    exact commutator_le_left _ _
  intro w hw
  exact hZU (show (⟨w,hWH hw⟩ : H) ∈ Z from hw)

/-- The original four-natural cover has exactly twelve binary dimensions. -/
theorem Context.four_natural_card (c : Context D t v I) (h : FourNaturalCover D) :
    Nat.card (⁅D.fullModule,L⁆ : Subgroup G) = 4096 := by
  obtain ⟨e,⟨s⟩⟩ := h
  have hinj : Function.Injective s.coordinates := (MonoidHom.ker_eq_bot_iff _).mp (by
    rw [s.kernel_eq,c.moved_fixed_eq_bot,bot_subgroupOf])
  have hc := Nat.card_congr (Equiv.ofBijective s.coordinates ⟨hinj,s.onto⟩)
  change Nat.card (⁅D.fullModule,L⁆ : Subgroup G) =
    Nat.card (Fin 4 → Fin 3 → ZMod 2) at hc
  norm_num [Nat.card_fun] at hc
  exact hc

/-- Reconstruct the block before bounding the full original four-natural subgroup. -/
theorem Context.no_seven_four_section_of_four_natural_cover
    (c : Context D t v I) (h : FourNaturalCover D) :
    letI := c.reduced.normal
    letI := c.reduced.elementary
    let A := (I.subgroupOf (pointJoin T v I)).map (actionMk (internalModule D v I))
    ∀ (N : Subgroup (ActionQuotient (internalModule D v I))) (_hAN : A ≤ N)
      (s : MovedSection ((action (internalModule D v I)).comp N.subtype) (A.subgroupOf N))
      (_E : (A.subgroupOf N) ≃* alternatingGroup (Fin 7)),
      IsIrreducible (s.action.comp (A.subgroupOf N).subtype) →
      Module.finrank (ZMod 2) (s.space.toSubmodule ⧸ s.central.toSubmodule) = 4 → False := by
  let := c.reduced.normal
  let := c.reduced.elementary
  let U := internalModule D v I
  let K := I.subgroupOf (pointJoin T v I)
  let : IsElementaryAbelian 2 (⁅U,K⁆ : Subgroup (pointJoin T v I)) :=
    IsElementaryAbelian.of_le (commutator_le_left U K)
  dsimp only
  intro N hAN s E hi hd
  have af := c.actionFacts_of_four_natural_cover h
  have hm := (c.moved_four_dimensional_of_seven_section af N hAN s E hi hd).2
  obtain ⟨hb,⟨eI⟩⟩ := c.block_and_quotient_of_four_moved_action af
    ((subgroupOfEquivOfLe hAN).symm.trans E) hm
  have hne : ⁅U,K⁆ ≠ ⊥ := by
    intro hz
    have hc : Nat.card (⁅U,K⁆ : Subgroup (pointJoin T v I)) = 16 := by
      change Nat.card (Additive (⁅U,K⁆ : Subgroup (pointJoin T v I))) = 16
      rw [Module.natCard_eq_pow_finrank (K := ZMod 2),Nat.card_zmod,hm]
      norm_num
    rw [hz,card_bot] at hc
    omega
  have hspan := c.moved_le_of_seven_block h.choose eI hb hne
  have hu := (c.four_dimensional_of_seven_section hspan N hAN s E hi hd).2
  have hcard : Nat.card (orbitModule D v I) = 16 := by
    rw [←Nat.card_congr (subgroupOfEquivOfLe c.orbit_le_join).toEquiv]
    change Nat.card (Additive U) = 16
    rw [Module.natCard_eq_pow_finrank (K := ZMod 2),Nat.card_zmod,hu]
    norm_num
  have hle := card_le_of_le hspan
  rw [c.four_natural_card h,hcard] at hle
  omega

/-- The retained four-natural row has a binary-linear containing actor;
the complete B.5.1 marking and its fixed kernel are retained. -/
theorem Context.binary_source_action_of_four_natural_cover (c : Context D t v I)
    (hmodel : FourNaturalCover D) :
    letI := c.reduced.normal
    letI := c.reduced.elementary
    let A := (I.subgroupOf (pointJoin T v I)).map (actionMk (internalModule D v I))
    let N := offenderSubgroup (action (internalModule D v I))
    ∃ h : ChapterB.SourceInduction.ProjectiveLine.QuasisimpleSourceConclusion
        ((action (internalModule D v I)).comp N.subtype) (A.subgroupOf N),
      BinaryOrSevenAction h.sectionData ∧
        ∃ d, (d = 4 ∨ d = 5) ∧ Nonempty (A ≃* SL(d,ZMod 2)) := by
  let := c.reduced.normal
  let := c.reduced.elementary
  let A := (I.subgroupOf (pointJoin T v I)).map (actionMk (internalModule D v I))
  let N := offenderSubgroup (action (internalModule D v I))
  have a := c.actionFacts_of_four_natural_cover hmodel
  have hAN : A ≤ N := a.classification.2.1
  let f : A ≃* A.subgroupOf N := (subgroupOfEquivOfLe hAN).symm
  let original := hmodel.choose
  obtain ⟨h,hs⟩ := c.binary_or_seven_action_of_binaryThree_quotient a original
  refine ⟨h,hs,?_⟩
  cases hs with
  | sevenFour _ hi E hd =>
    exact (c.no_seven_four_section_of_four_natural_cover hmodel N hAN h.sectionData E hi hd).elim
  | sevenDeleted _ _ E =>
    exact (c.no_deletedSeven_source_section a h.sectionData ⟨E⟩).elim
  | linear d hd _ _ E => exact ⟨d,hd,⟨f.trans E.groupEquiv⟩⟩
  | orthogonalSix _ _ E => exact ⟨4,Or.inl rfl,
      ⟨((f.trans E.groupEquiv).trans Atlas.Comparisons.Exceptional.alt8EquivPSL4Two).trans
        (_root_.BinaryLinear.OuterCyclic.projectiveEquivSL (by decide))⟩⟩
  | symmetricEight _ _ E => exact ⟨4,Or.inl rfl,
      ⟨((f.trans E.subgroupEquiv).trans Atlas.Comparisons.Exceptional.alt8EquivPSL4Two).trans
        (_root_.BinaryLinear.OuterCyclic.projectiveEquivSL (by decide))⟩⟩
  | exteriorFive _ _ E _ => exact ⟨5,Or.inr rfl,⟨f.trans E⟩⟩
  | naturalDual d hd E => exact ⟨d,hd,⟨f.trans E.some.groupEquiv⟩⟩
  | repeatedNatural d _ hd _ _ E => exact ⟨d,hd,⟨f.trans E.some.groupEquiv⟩⟩

/-- No A₇ containing actor occurs for an original four-natural cover. -/
theorem Context.no_seven_actor_of_four_natural_cover (c : Context D t v I)
    (hmodel : FourNaturalCover D) :
    letI := c.reduced.normal
    ∀ (_E : ((I.subgroupOf (pointJoin T v I)).map (actionMk (internalModule D v I))) ≃*
      alternatingGroup (Fin 7)), False := by
  let := c.reduced.normal
  let := c.reduced.elementary
  intro E
  obtain ⟨_,_,d,hd,⟨f⟩⟩ := c.binary_source_action_of_four_natural_cover hmodel
  have hc := Nat.card_congr (f.symm.trans E).toEquiv
  rw [_root_.BinaryLinear.card_SL,nat_card_alternatingGroup] at hc
  rcases hd with rfl | rfl <;>
    norm_num [_root_.BinaryLinear.order,Fin.prod_univ_succ,Nat.factorial] at hc

/-- The binary actor induces the literal original two-core quotient. -/
theorem Context.binary_quotient_of_four_natural_cover (c : Context D t v I)
    (h : FourNaturalCover D) :
    ∃ d, (d = 4 ∨ d = 5) ∧ Nonempty ((I ⧸ pCore 2 I) ≃* SL(d,ZMod 2)) := by
  let := c.reduced.normal
  let := c.reduced.elementary
  obtain ⟨_,_,d,hd,⟨E⟩⟩ := c.binary_source_action_of_four_natural_cover h
  exact ⟨d,hd,⟨c.binaryActorQuotient hd E⟩⟩

/-- Every marked original row now forces a binary containing component quotient. -/
theorem Context.four_natural_and_binary_quotient_of_original_moved_cover
    (c : Context D t v I) (h : OriginalMovedCover D) :
    FourNaturalCover D ∧
      ∃ d, (d = 4 ∨ d = 5) ∧ Nonempty ((I ⧸ pCore 2 I) ≃* SL(d,ZMod 2)) := by
  have hf := c.four_natural_of_original_moved_cover h
  exact ⟨hf,c.binary_quotient_of_four_natural_cover hf⟩

/-- The actual four-natural containing component is the cubic residual of the point centralizer. -/
theorem Context.component_eq_point_residual_of_four_natural_cover
    (c : Context D t v I) (h : FourNaturalCover D) :
    (primeToResidual 3 (centralizer ({v} : Set G))).map
      (centralizer ({v} : Set G)).subtype = I := by
  let := c.reduced.normal
  let := c.reduced.elementary
  obtain ⟨_,_,d,hd,⟨E⟩⟩ := c.binary_source_action_of_four_natural_cover h
  exact c.component_eq_point_residual_of_binary_actor hd E

/-- Four-natural covers also exclude the actual A₇ two-core quotient of I. -/
theorem Context.no_alternatingSeven_quotient_of_four_natural_cover
    (c : Context D t v I) (h : FourNaturalCover D)
    (E : (I ⧸ pCore 2 I) ≃* alternatingGroup (Fin 7)) : False := by
  obtain ⟨d,hd,⟨e⟩⟩ := c.binary_quotient_of_four_natural_cover h
  have hc := Nat.card_congr (e.symm.trans E).toEquiv
  rw [_root_.BinaryLinear.card_SL,nat_card_alternatingGroup] at hc
  rcases hd with rfl | rfl <;>
    norm_num [_root_.BinaryLinear.order,Fin.prod_univ_succ,Nat.factorial] at hc

end CFSG.Quasithin.Chapter10.PointControl.Constrained
