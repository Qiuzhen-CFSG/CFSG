module
public import CFSG.Quasithin.Chapter10.SourceLinearThreeReduction.PointControl.Constrained.Models.AlternatingSeven
public import CFSG.Quasithin.Chapter10.SourceLinearThreeReduction.PointControl.Selection.BinaryThree.CoreOmega
public import Theory.Representation.BinaryConjugationSection.FaithfulNormalizer

/-!
# The positive natural cover and its opposite cubic

The original component Sylow fixes exactly the central kernel of the
positive natural cover. Since the half-Sylow fixes that kernel, it is
precisely the seed of the literal reduced orbit. The fourteen-vector
component orbit gives an opposite cubic fixing the original moved subgroup.

A centralizing normalizer acts trivially on the marked component quotient.
If the containing two-core quotient is A₇, its smaller SL₃(2) image is
self-normalizing and centerless. The cubic therefore has trivial image,
contradicting the two-group kernel. This excludes every original natural
cover from an actual A₇ head, without identifying VI with the moved subgroup.

Models.SevenMoved discharges the possible central cubic kernel of an A₇
action using its literal moved submodule. The binary containing cases,
general quiet preparation and the retained four-natural row remain with
qt-d-10-nona5-point-constrained.
Source: Aschbacher--Smith B.4.8 and 10.2.9, printed pp.91 and751--752.
-/

public noncomputable section
open Subgroup Theory.GroupTheory Stellmacher Representation
open scoped MatrixGroups IsMulCommutative
namespace CFSG.Quasithin.Chapter10.PointControl.Constrained
open Chapter3.Section02 ChapterB.InternalThompsonAction
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L : Subgroup G}
  {D : FundamentalSetup KnownSimple.IsKnownSimple T L} {t v : G} {I : Subgroup G}

/-- The literal fixed seed of a positive natural cover is its original central kernel. -/
theorem Context.seed_eq_fixed_of_positive_binaryThree (c : Context D t v I)
    (hmodel : Selection.BinaryThreeNatural D) (hne : sourceMovedFixed D ≠ ⊥) :
    ⁅D.fullModule,L⁆ ⊓ centralizer (pointSylow T v : Set G) = sourceMovedFixed D := by
  apply le_antisymm
  · have hLS : (T : Subgroup G) ⊓ L ≤ pointSylow T v :=
      le_inf inf_le_left (inf_le_right.trans
        (c.escaping.strict.le.trans c.escaping.le_centralizer))
    exact le_inf inf_le_left
      ((inf_le_inf_left _ (centralizer_le hLS)).trans
        (Selection.BinaryThree.moved_fixed_by_sylow_intersection D hmodel hne))
  · apply le_inf inf_le_left
    have hh := Selection.BinaryThree.half_sylow_centralizes_moved_kernels D hmodel
      c.escaping.t_mem c.escaping.t_not_normalizes
    exact le_centralizer_iff.mp
      (((le_inf inf_le_left c.escaping.sylow_normalizes).trans hh).trans
        (centralizer_le (show sourceMovedFixed D ≤ sourceMovedFixed D ⊔
          (sourceMovedFixed D).map (MulAut.conj t).toMonoidHom from le_sup_left)))

/-- The original positive-kernel orbit is generated by that kernel, retaining its literal I-action. -/
theorem Context.orbit_eq_fixed_span_of_positive_binaryThree (c : Context D t v I)
    (hmodel : Selection.BinaryThreeNatural D) (hne : sourceMovedFixed D ≠ ⊥) :
    orbitModule D v I = conjugateSpanBy (sourceMovedFixed D) I := by
  unfold orbitModule
  rw [c.seed_eq_fixed_of_positive_binaryThree hmodel hne]

/-- Every original natural cover has an opposite cubic fixing the original moved subgroup. -/
theorem Context.exists_opposite_cubic_of_binaryThreeNatural (c : Context D t v I)
    (hmodel : Selection.BinaryThreeNatural D) :
    ∃ y : G, orderOf y = 3 ∧ y ∈ centralizer ({v} : Set G) ∧
      y ∈ normalizer (L : Set G) ∧ y ∈ centralizer (↑(⁅D.fullModule,L⁆ : Subgroup G) : Set G) := by
  by_cases hz : sourceMovedFixed D = ⊥
  · obtain ⟨e,⟨s⟩⟩ := hmodel
    have hs : BinaryConjugationSection L ⁅D.fullModule,L⁆ ⊥
        ((specialLinearNatural 3).comp
          (e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 L)))) := hz ▸ s
    exact c.exists_opposite_cubic_of_natural_three e hs
  obtain ⟨w,hw,hwt⟩ := c.escaping.v_mem
  let C := L ⊓ centralizer ({w} : Set G)
  have hC3 : 3 ∣ Nat.card C := by
    by_cases hc : w ∈ centralizer (L : Set G)
    · have he : C = L := inf_eq_left.mpr (by
        intro l hl
        exact mem_centralizer_singleton_iff.mpr (hc l hl))
      rw [he]
      exact (Selection.BinaryThree.three_dvd_quotient D hmodel).trans
        (pCore 2 L).card_quotient_dvd_card
    · let : MulAction L G := MulAction.compHom G
        (ConjAct.toConjAct.toMonoidHom.comp L.subtype)
      have he : C.subgroupOf L = MulAction.stabilizer L w := by
        ext l
        change ((l : G) ∈ L ∧ (l : G) ∈ centralizer ({w} : Set G)) ↔
          (l : G)*w*(l : G)⁻¹ = w
        simp only [l.property,true_and,mem_centralizer_singleton_iff,
          mul_inv_eq_iff_eq_mul]
      have hi : (C.subgroupOf L).index = 14 := by
        rw [he,MulAction.index_stabilizer]
        exact Selection.BinaryThree.moved_orbit_card_of_positive_kernel D hmodel hz hw hc
      have hcard := (C.subgroupOf L).index_mul_card
      rw [hi,Nat.card_congr (subgroupOfEquivOfLe (show C ≤ L from inf_le_left)).toEquiv]
        at hcard
      obtain ⟨e,_⟩ := hmodel
      have hL : Nat.card L = 168 * Nat.card (pCore 2 L) := by
        rw [card_eq_card_quotient_mul_card_subgroup (pCore 2 L),
          Nat.card_congr e.toEquiv,Matrix.PSL3Two.card_SL]
      have hC : Nat.card C = 12 * Nat.card (pCore 2 L) := by omega
      rw [hC]
      exact dvd_mul_of_dvd_left (by decide) _
  obtain ⟨x,hx⟩ := exists_prime_orderOf_dvd_card' (G := C) 3 hC3
  let y := (MulAut.conj t) (x : G)
  have hyB : y ∈ L.map (MulAut.conj t).toMonoidHom := mem_map_of_mem _ x.property.1
  refine ⟨y,((MulAut.conj t).orderOf_eq (x : G)).trans
    ((Subgroup.orderOf_coe x).trans hx),?_,?_,?_⟩
  · apply mem_centralizer_singleton_iff.mpr
    have he := congrArg (MulAut.conj t) (mem_centralizer_singleton_iff.mp x.property.2)
    change (MulAut.conj t) w = v at hwt
    simpa only [map_mul,hwt] using he
  · apply source_nonnormal_orbit_le_normalizer D
      (fun h => c.escaping.t_not_normalizes (h c.escaping.t_mem))
    exact (mem_normalizer_iff.mp (le_normalizer_componentOrbit L T c.escaping.t_mem)
      (x : G)).mp ((le_componentOrbit L T) x.property.1)
  · exact le_centralizer_iff.mp (commutator_eq_bot_iff_le_centralizer.mp
      (source_a5_moved_normalizer_opposite_cross D c.escaping.t_mem
        c.escaping.t_not_normalizes c.escaping.crossed)) hyB
end CFSG.Quasithin.Chapter10.PointControl.Constrained

namespace CFSG.Quasithin.Chapter10.PointControl.Constrained
open Subgroup Theory.GroupTheory Representation
open Chapter3.Section02 ChapterB.InternalThompsonAction
open scoped MatrixGroups
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L : Subgroup G}
  {D : FundamentalSetup KnownSimple.IsKnownSimple T L} {t v : G} {I : Subgroup G}

/-- A normalizing cubic fixing a natural cover cannot occur in an A₇ head.
The proof uses the actor quotient; it needs no containment of the original
moved subgroup in the reduced orbit. -/
theorem Context.no_normalizing_cubic_of_binaryThreeNatural_seven
    (c : Context D t v I) (hmodel : Selection.BinaryThreeNatural D)
    (E : (I ⧸ pCore 2 I) ≃* alternatingGroup (Fin 7))
    {y : G} (hy : y ∈ I) (hy3 : orderOf y = 3)
    (hyn : y ∈ normalizer (L : Set G))
    (hyc : y ∈ centralizer (↑(⁅D.fullModule,L⁆ : Subgroup G) : Set G)) : False := by
  obtain ⟨e,⟨s⟩⟩ := hmodel
  let A := L.subgroupOf I
  let a : A ≃* L := subgroupOfEquivOfLe c.escaping.strict.le
  let eA : (A ⧸ pCore 2 A) ≃* SL(3,ZMod 2) :=
    (QuotientGroup.congr _ _ a (pCore_map_iso 2 a)).trans e
  let f := E.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 I))
  have hk : IsPGroup 2 (f.subgroupMap A).ker := by
    let j : (f.subgroupMap A).ker →* pCore 2 I :=
      (A.subtype.comp (f.subgroupMap A).ker.subtype).codRestrict _ (fun x => by
        apply (QuotientGroup.eq_one_iff _).mp
        apply E.map_eq_one_iff.mp
        exact congrArg Subtype.val x.property)
    exact pCore_isPGroup.of_injective j (fun x z h => Subtype.ext (Subtype.ext
      (congrArg (fun k : pCore 2 I => (k : I)) h)))
  have hker := (alternatingGroup.SevenThreeSection.image_twoCore_eq_bot_and_ker_eq f A hk eA).2
  have hnorm := alternatingGroup.SevenThreeSection.image_normalizer_eq f A hk eA
  let yI : I := ⟨y,hy⟩
  have hynA : yI ∈ normalizer (A : Set I) := fun l => hyn (l : G)
  have hyf : f yI ∈ A.map f := hnorm ▸
    (A.le_normalizer_map f (mem_map_of_mem f hynA))
  have hyC : f yI ∈ centralizer (A.map f : Set (alternatingGroup (Fin 7))) := by
    rintro _ ⟨l,hl,rfl⟩
    let lA : A := ⟨l,hl⟩
    let z : A := ⟨yI*l*yI⁻¹*l⁻¹,
      A.mul_mem ((mem_normalizer_iff.mp hynA l).mp hl) (A.inv_mem hl)⟩
    have hact := s.normalizer_commutator_action_eq_one hyn hyc (a lA)
    change specialLinearNatural 3 (e (QuotientGroup.mk' (pCore 2 L) (a z))) = 1 at hact
    have hzL : a z ∈ pCore 2 L := (QuotientGroup.eq_one_iff _).mp
      (e.map_eq_one_iff.mp ((specialLinearNatural_injective 3)
        (hact.trans (map_one _).symm)))
    rw [←pCore_map_iso 2 a] at hzL
    have hz : z ∈ pCore 2 A := (mem_map_equiv).mp hzL
    have hzf : f (yI*l*yI⁻¹*l⁻¹) = 1 :=
      congrArg Subtype.val (show z ∈ (f.subgroupMap A).ker from hker.symm ▸ hz)
    rw [map_mul,map_mul,map_mul,map_inv,map_inv] at hzf
    exact (mul_inv_eq_iff_eq_mul.mp (mul_inv_eq_one.mp hzf)).symm
  let b : A.map f ≃* SL(3,ZMod 2) :=
    (((QuotientGroup.quotientKerEquivOfSurjective (f.subgroupMap A)
      (f.subgroupMap_surjective A)).symm.trans
        (QuotientGroup.quotientMulEquivOfEq hker)).trans eA)
  let z : A.map f := ⟨f yI,hyf⟩
  have hz : b z ∈ center SL(3,ZMod 2) := by
    apply mem_center_iff.mpr
    intro g
    obtain ⟨x,rfl⟩ := b.surjective g
    have hh : x*z = z*x := Subtype.ext (hyC x x.property)
    simpa only [map_mul] using congrArg b hh
  rw [Matrix.PSL3Two.center_eq_bot,mem_bot] at hz
  have hz1 : z = 1 := b.map_eq_one_iff.mp hz
  have hycore : yI ∈ pCore 2 I := (QuotientGroup.eq_one_iff _).mp
    (E.map_eq_one_iff.mp (congrArg Subtype.val hz1))
  let k : pCore 2 I := ⟨yI,hycore⟩
  have hk3 : orderOf k = 3 := (Subgroup.orderOf_coe k).symm.trans
    ((Subgroup.orderOf_coe yI).symm.trans hy3)
  have hkne : k ≠ 1 := by intro he; rw [he,orderOf_one] at hk3; omega
  have htwo := (pCore_isPGroup (p := 2) (G := I)).dvd_orderOf hkne
  rw [hk3] at htwo
  norm_num at htwo

/-- Every natural cover excludes the actual A₇ two-core quotient, including
positive original fixed kernels. -/
theorem Context.no_alternatingSeven_of_binaryThreeNatural
    (c : Context D t v I) (hmodel : Selection.BinaryThreeNatural D)
    (E : (I ⧸ pCore 2 I) ≃* alternatingGroup (Fin 7)) : False := by
  obtain ⟨y,hy3,hyv,hyn,hyc⟩ := c.exists_opposite_cubic_of_binaryThreeNatural hmodel
  have hyI : y ∈ I := by
    rw [←c.component_eq_point_residual_of_alternatingSeven E]
    apply mem_map_of_mem (centralizer ({v} : Set G)).subtype (x := ⟨y,hyv⟩)
    apply mem_primeToResidual_of_pow (n := 1)
    apply Subtype.ext
    change y ^ (3 ^ 1) = 1
    simpa only [pow_one,hy3] using pow_orderOf_eq_one y
  exact c.no_normalizing_cubic_of_binaryThreeNatural_seven hmodel E hyI hy3 hyn hyc
end CFSG.Quasithin.Chapter10.PointControl.Constrained
