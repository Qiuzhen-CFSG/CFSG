/-!
# Original constrained action geometry before row recognition

Minimality and the vanishing full fixed layer make the M-action irreducible.
Clifford restriction along L ◁ L₀ ◁ M makes every invariant subgroup of
[V_M,L] semisimple. Its fixed kernel is zero, so it is generated by its
L-commutators. Applying this to VI ∩ [V_M,L] shows [VI,I] = VI without
assuming that all of [V_M,L] lies in VI.

The literal action kernel fixes the nonzero local moved subgroup. It lies
in M, and crossed centralization prevents it from exchanging the original
components. Thus it normalizes L. This discharges the full-span premise
in the scalar obstruction. A nonfixed original point-Sylow seed also
survives the B.5.1 central projection; at cubic component order the complete
source conclusion is applied to that same seed and quotient map.

Original marked-row exhaustion remains unproved. These results preserve
V_T, V_M, VI, and the original central quotient separately.

Source: Aschbacher--Smith 10.1.1 and 10.2.9, printed pp.741,751--752;
Clifford restriction, Isaacs, Character Theory of Finite Groups, Theorem 6.5.
-/

public noncomputable section
open Subgroup Theory.GroupTheory Representation Representation.BinaryOffender
open scoped IsMulCommutative MonoidAlgebra
namespace CFSG.Quasithin.Chapter10.PointControl.Constrained
open Chapter3.Section02 Chapter4 ChapterB.InternalThompsonAction
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L : Subgroup G}
  {D : FundamentalSetup KnownSimple.IsKnownSimple T L} {t v : G} {I : Subgroup G}
local instance fullElementary : IsElementaryAbelian 2 D.fullModule :=
  D.fullModule_elementary (source_module_nonsolvable_uniqueness D)

private def fullConjugation (D : FundamentalSetup KnownSimple.IsKnownSimple T L) :
    Representation (ZMod 2) D.maximalLocal (Additive D.fullModule) :=
  elementaryRepresentation
    (D.fullModule.normalizerMonoidHom.comp (inclusion D.maximalLocal_normalizes_fullModule))

private def fullSection (D : FundamentalSetup KnownSimple.IsKnownSimple T L) :
    BinaryConjugationSection D.maximalLocal D.fullModule ⊥ (fullConjugation D) := {
  section_le := D.fullModule_le_orbit.trans (localOrbit T L).le_normalizer
  kernel_le := bot_le
  normalized := D.maximalLocal_normalizes_fullModule
  coordinates := { toFun v := Multiplicative.ofAdd (Additive.ofMul v)
                   map_one' := rfl
                   map_mul' _ _ := rfl }
  onto := fun v => ⟨v.toAdd.toMul,rfl⟩
  kernel_eq := by ext v; simp
  equivariant := fun _ _ => rfl }

private theorem fullConjugation_irreducible (c : Context D t v I) :
    (fullConjugation D).IsIrreducible := by
  have hn : D.fullModule ≠ ⊥ := fun hz => D.module_ne_bot
    (bot_unique ((le_componentOrbit D.moduleSubgroup D.maximalLocal).trans hz.le))
  let : Nontrivial D.fullModule := (Subgroup.nontrivial_iff_ne_bot _).mpr hn
  apply (fullSection D).irreducible_of_subgroup_minimal
  intro A hAV hMA
  rcases source_minimal_fullModule_eq_or_le_centralizer D c.minimal A hMA hAV with he | hc
  · exact Or.inl he
  · exact Or.inr ((le_inf hAV hc).trans_eq c.full_fixed_eq_bot)

private theorem fullConjugation_component_semisimple (c : Context D t v I) :
    IsSemisimpleModule (ZMod 2)[L]
      (Representation.asModule ((fullConjugation D).comp
        (inclusion ((le_componentOrbit L T).trans (localOrbit T L).le_normalizer)))) := by
  let ρ := fullConjugation D
  let K := L.subgroupOf D.maximalLocal
  let N := (localOrbit T L).subgroupOf D.maximalLocal
  have hLM : L ≤ D.maximalLocal := (le_componentOrbit L T).trans (localOrbit T L).le_normalizer
  let : N.Normal := normal_subgroupOf_of_le_normalizer le_rfl
  have hn : N ≤ normalizer (K : Set D.maximalLocal) := by
    intro n hn
    rw [Subgroup.mem_normalizer_iff]
    intro k
    exact Subgroup.mem_normalizer_iff.mp
      (source_nonnormal_orbit_le_normalizer D
        (fun hn => c.escaping.t_not_normalizes (hn c.escaping.t_mem)) hn) k
  let : FiniteDimensional (ZMod 2) (Additive D.fullModule) := Module.Finite.of_finite
  let : IsSemisimpleModule (ZMod 2)[K] (Representation.asModule (ρ.comp K.subtype)) :=
    irreducible_restriction_semisimple_of_normal_chain ρ
      (fullConjugation_irreducible c) K N (comap_mono (le_componentOrbit L T)) hn
  let e : L ≃* K := (subgroupOfEquivOfLe hLM).symm
  exact comp_semisimple_of_surjective (ρ.comp K.subtype) e.toMonoidHom e.surjective

/-- Every L-invariant subgroup of the original moved subgroup is fully moved. -/
theorem Context.moved_subgroup_eq_commutator (c : Context D t v I)
    (A : Subgroup G) (hAW : A ≤ ⁅D.fullModule,L⁆)
    (hLA : L ≤ normalizer (A : Set G)) : ⁅A,L⁆ = A := by
  have hWV : ⁅D.fullModule,L⁆ ≤ D.fullModule := le_normalizer_iff_commutator_le_left.mp
    (((le_componentOrbit L T).trans (localOrbit T L).le_normalizer).trans
      D.maximalLocal_normalizes_fullModule)
  have hAV := hAW.trans hWV
  let : IsElementaryAbelian 2 A := IsElementaryAbelian.of_injective
    (inclusion hAV) (inclusion_injective hAV)
  let σ : Representation (ZMod 2) L (Additive A) :=
    elementaryRepresentation (A.normalizerMonoidHom.comp (inclusion hLA))
  let ρ := (fullConjugation D).comp
    (inclusion ((le_componentOrbit L T).trans (localOrbit T L).le_normalizer))
  let := fullConjugation_component_semisimple c
  let f : σ.IntertwiningMap ρ := {
    toLinearMap := (inclusion hAV).toAdditive.toZModLinearMap 2
    isIntertwining' _ := by ext w; rfl }
  let : IsSemisimpleModule (ZMod 2)[L] σ.asModule :=
    IsSemisimpleModule.of_injective (IntertwiningMap.equivLinearMapAsModule _ _ f)
      (by intro x y h; exact Additive.toMul.injective ((inclusion_injective hAV) h))
  have hf : σ.invariants = ⊥ := by
    apply bot_unique
    intro w hw
    have hc : (w.toMul : G) ∈ centralizer (L : Set G) := by
      intro l hl
      have he := congrArg (fun x : Additive A => (x.toMul : G)) (hw ⟨l,hl⟩)
      change l * (w.toMul : G) * l⁻¹ = (w.toMul : G) at he
      exact mul_inv_eq_iff_eq_mul.mp he
    have hz : (w.toMul : G) ∈ sourceMovedFixed D := ⟨hAW w.toMul.property,hc⟩
    rw [c.moved_fixed_eq_bot] at hz
    exact Additive.toMul.injective (Subtype.ext (mem_bot.mp hz))
  have hg := coinvariants_eq_top_of_semisimple_of_invariants_eq_bot σ hf
  let s : BinaryConjugationSection L A ⊥ σ := {
    section_le := hAW.trans (source_full_moved_le_component D)
    kernel_le := bot_le
    normalized := hLA
    coordinates := { toFun w := Multiplicative.ofAdd (Additive.ofMul w)
                     map_one' := rfl
                     map_mul' _ _ := rfl }
    onto := fun w => ⟨w.toAdd.toMul,rfl⟩
    kernel_eq := by ext w; simp
    equivariant := fun _ _ => rfl }
  apply le_antisymm (le_normalizer_iff_commutator_le_left.mp hLA)
  have hgen : Coinvariants.ker (σ.comp (inclusion (le_refl L))) ⊔ s.image ⊥ = ⊤ := by
    change Coinvariants.ker σ ⊔ s.image ⊥ = ⊤
    rw [hg,top_sup_eq]
  simpa only [sup_bot_eq] using s.le_commutator_sup_of_coinvariants L ⊥ le_rfl hgen

/-- The original reduced orbit is generated by I-commutators without a cover marking. -/
theorem Context.orbit_eq_commutator (c : Context D t v I) :
    ⁅orbitModule D v I,I⁆ = orbitModule D v I := by
  let W := ⁅D.fullModule,L⁆
  let V := orbitModule D v I
  let A := V ⊓ W
  have hLA : L ≤ normalizer (A : Set G) :=
    (le_inf (c.escaping.strict.le.trans (le_normalizer_conjugateSpanBy _ _))
      (normalizer_commutator_ge_right _ _)).trans inf_normalizer_le_normalizer_inf
  have hA : A ≤ ⁅V,I⁆ := by
    rw [←c.moved_subgroup_eq_commutator A inf_le_right hLA]
    exact commutator_mono inf_le_left c.escaping.strict.le
  apply le_antisymm (le_normalizer_iff_commutator_le_left.mp
    (le_normalizer_conjugateSpanBy _ _))
  apply conjugateSpanBy_le ?_ (normalizer_commutator_ge_right _ _)
  exact (le_inf (le_conjugateSpanBy _ _) inf_le_left).trans hA

/-- The complete B.5.1 moved section is the whole literal VI. -/
theorem Context.fully_moved (c : Context D t v I) :
    letI := c.reduced.normal
    letI := c.reduced.elementary
    ChapterB.QuasisimpleSource.moved (action (internalModule D v I))
      ((I.subgroupOf (pointJoin T v I)).map (actionMk (internalModule D v I))) = ⊤ := by
  let H := pointJoin T v I
  let U := internalModule D v I
  let := c.reduced.normal
  let := c.reduced.elementary
  have hm : ⁅U,I.subgroupOf H⁆ = U := by
    apply map_injective H.subtype_injective
    rw [map_commutator,map_subgroupOf_eq_of_le c.orbit_le_join,
      map_subgroupOf_eq_of_le le_sup_left]
    exact c.orbit_eq_commutator
  rw [←ChapterB.QuasisimpleSource.SourceCompletion.coinvariants_eq_moved]
  exact NormalElementaryQuotient.coinvariants_image_eq_top U (actionMk U)
    (QuotientGroup.mk'_surjective _) (QuotientGroup.ker_mk' _) (I.subgroupOf H)
    (comap_mono c.orbit_le_component) hm

/-- The nonzero local moved subgroup prevents the original component from being exchanged. -/
theorem Context.local_moved_centralizer_normalizes (c : Context D t v I) :
    centralizer (↑(⁅D.moduleSubgroup,L⁆ : Subgroup G) : Set G) ≤ normalizer (L : Set G) := by
  let W := ⁅D.moduleSubgroup,L⁆
  let F := ⁅D.fullModule,L⁆
  have hWF : W ≤ F := commutator_mono (le_componentOrbit _ _) le_rfl
  have hn : ¬ (T : Subgroup G) ≤ normalizer (L : Set G) :=
    fun hn => c.escaping.t_not_normalizes (hn c.escaping.t_mem)
  intro b hb
  have hbM : b ∈ D.maximalLocal :=
    c.local_moved_normalizer_le ((Subgroup.centralizer_le_normalizer _) hb)
  rcases source_nonnormal_maximal_pair D hn c.escaping.t_mem
      c.escaping.t_not_normalizes b hbM with he | he
  · exact mem_normalizer_iff_map_conj_eq.mpr he
  · have hF : F.map (MulAut.conj b).toMonoidHom = F.map (MulAut.conj t).toMonoidHom := by
      change (⁅D.fullModule,L⁆).map (MulAut.conj b).toMonoidHom =
        (⁅D.fullModule,L⁆).map (MulAut.conj t).toMonoidHom
      have hbF : D.fullModule.map (MulAut.conj b).toMonoidHom = D.fullModule :=
        mem_normalizer_iff_map_conj_eq.mp (D.maximalLocal_normalizes_fullModule hbM)
      have htF : D.fullModule.map (MulAut.conj t).toMonoidHom = D.fullModule :=
        mem_normalizer_iff_map_conj_eq.mp (D.maximalLocal_normalizes_fullModule
          (le_normalizer_componentOrbit L T c.escaping.t_mem))
      rw [map_commutator,hbF,he,map_commutator,htF]
    have hW : W.map (MulAut.conj b).toMonoidHom = W :=
      mem_normalizer_iff_map_conj_eq.mp ((Subgroup.centralizer_le_normalizer _) hb)
    have hWC : W ≤ centralizer (L : Set G) := by
      have h := map_mono (f := (MulAut.conj b).toMonoidHom) hWF
      rw [hW,hF] at h
      exact h.trans c.escaping.crossed
    exact (Selection.ModuleChoice.local_moved_ne_bot D
      (bot_unique ((le_inf hWF hWC).trans_eq c.moved_fixed_eq_bot))).elim

/-- The literal reduced action kernel normalizes L before any model recognition. -/
theorem Context.orbit_centralizer_normalizes_component (c : Context D t v I) :
    centralizer (orbitModule D v I : Set G) ≤ normalizer (L : Set G) :=
  (centralizer_le c.local_moved_le).trans c.local_moved_centralizer_normalizes

/-- The same statement on the exact quotient map used by the FF action. -/
theorem Context.action_kernel_normalizes_component (c : Context D t v I) :
    letI := c.reduced.normal
    (actionMk (internalModule D v I)).ker ≤
      normalizer (L.subgroupOf (pointJoin T v I) : Set (pointJoin T v I)) := by
  let H := pointJoin T v I
  let U := internalModule D v I
  let := c.reduced.normal
  intro x hx
  have hxC : x ∈ centralizer (U : Set H) := by
    simpa only [actionMk,QuotientGroup.ker_mk'] using hx
  have hG : (x : G) ∈ centralizer (orbitModule D v I : Set G) := by
    intro z hz
    exact congrArg H.subtype (hxC ⟨z,c.orbit_le_join hz⟩ hz)
  rw [mem_normalizer_iff]
  intro l
  exact mem_normalizer_iff.mp (c.orbit_centralizer_normalizes_component hG) (l : G)

/-- A nonfixed vector of the original seed survives the containing central quotient. -/
theorem Context.exists_nonfixed_seed (c : Context D t v I) :
    ∃ z ∈ ⁅D.fullModule,L⁆ ⊓ centralizer (pointSylow T v : Set G),
      z ∉ centralizer (I : Set G) := by
  by_contra! h
  have hIC : I ≤ normalizer (centralizer (I : Set G) : Set G) :=
    (le_centralizer_iff.mp le_rfl).trans (Subgroup.centralizer_le_normalizer _)
  have hVC := conjugateSpanBy_le h hIC
  have hWC : ⁅D.moduleSubgroup,L⁆ ≤ centralizer (L : Set G) :=
    c.local_moved_le.trans (hVC.trans (centralizer_le c.escaping.strict.le))
  exact Selection.ModuleChoice.local_moved_ne_bot D
    (bot_unique ((le_inf (commutator_mono (le_componentOrbit _ _) le_rfl) hWC).trans_eq
      c.moved_fixed_eq_bot))

/-- The original point-fixed seed is nonzero in the literal containing central quotient. -/
theorem Context.action_fixed_seed (c : Context D t v I) :
    let H := pointJoin T v I
    let U := internalModule D v I
    letI := c.reduced.normal
    letI := c.reduced.elementary
    ∃ z : Additive U, ((z.toMul : H) : G) ∈ ⁅D.fullModule,L⁆ ∧
      z ∈ fixedSpace (action U) ((pointSylow T v).subgroupOf H |>.map (actionMk U)) ∧
      z ∉ fixedSpace (action U) ((I.subgroupOf H).map (actionMk U)) := by
  let H := pointJoin T v I
  let U := internalModule D v I
  let := c.reduced.normal
  let := c.reduced.elementary
  obtain ⟨z,hz,hzn⟩ := c.exists_nonfixed_seed
  have hzV : z ∈ orbitModule D v I := le_conjugateSpanBy _ _ hz
  let w : Additive U := Additive.ofMul ⟨⟨z,c.orbit_le_join hzV⟩,hzV⟩
  refine ⟨w,hz.1,?_,?_⟩
  · apply (mem_fixedSpace_iff U ((pointSylow T v).subgroupOf H) w).mpr
    intro p hp
    exact Subtype.ext (hz.2 p.val hp)
  · intro hw
    apply hzn
    have hc := (mem_fixedSpace_iff U (I.subgroupOf H) w).mp hw
    intro i hi
    exact congrArg H.subtype (hc ⟨i,(show I ≤ H from le_sup_left) hi⟩ hi)

/-- The B.5.1 central projection keeps an original point-fixed vector nonzero,
without assuming that the whole original moved group lies in VI. -/
theorem Context.source_projection_seed (c : Context D t v I) :
    let H := pointJoin T v I
    let U := internalModule D v I
    letI := c.reduced.normal
    letI := c.reduced.elementary
    let A := (I.subgroupOf H).map (actionMk U)
    ∀ (N : Subgroup (ActionQuotient U)) (_hAN : A ≤ N)
      (s : ChapterB.QuasisimpleSource.MovedSection ((action U).comp N.subtype) (A.subgroupOf N)),
      ∃ hm : ChapterB.QuasisimpleSource.moved ((action U).comp N.subtype) (A.subgroupOf N) = ⊤,
        ∃ z : Additive U, ((z.toMul : H) : G) ∈ ⁅D.fullModule,L⁆ ∧
          z ∈ fixedSpace (action U) ((pointSylow T v).subgroupOf H |>.map (actionMk U)) ∧
          s.fullProjection hm z ≠ 0 := by
  let H := pointJoin T v I
  let U := internalModule D v I
  let := c.reduced.normal
  let := c.reduced.elementary
  let A := (I.subgroupOf H).map (actionMk U)
  dsimp only
  intro N hAN s
  have hm : ChapterB.QuasisimpleSource.moved ((action U).comp N.subtype) (A.subgroupOf N) = ⊤ := by
    rw [ChapterB.QuasisimpleSource.moved_comp_map,map_subgroupOf_eq_of_le hAN]
    exact c.fully_moved
  obtain ⟨z,hz,hp,hn⟩ := c.action_fixed_seed
  refine ⟨hm,z,hz,hp,?_⟩
  intro he
  have hf := (s.fullProjection_eq_zero_iff hm z).mp he
  rw [fixedSpace_comp_map,map_subgroupOf_eq_of_le hAN] at hf
  exact hn hf

/-- Apply the complete FF theorem to the cubic branch and retain a nonzero
original seed in that very source conclusion's central quotient. -/
theorem Context.source_conclusion_with_seed_of_three (c : Context D t v I)
    (hd : 3 ∣ Nat.card (L ⧸ pCore 2 L)) :
    let H := pointJoin T v I
    let U := internalModule D v I
    letI := c.reduced.normal
    letI := c.reduced.elementary
    let A := (I.subgroupOf H).map (actionMk U)
    let N := offenderSubgroup (action U)
    ∃ h : ChapterB.SourceInduction.ProjectiveLine.QuasisimpleSourceConclusion
        ((action U).comp N.subtype) (A.subgroupOf N),
      ∃ hm : ChapterB.QuasisimpleSource.moved ((action U).comp N.subtype) (A.subgroupOf N) = ⊤,
        ∃ z : Additive U, ((z.toMul : H) : G) ∈ ⁅D.fullModule,L⁆ ∧
          z ∈ fixedSpace (action U) ((pointSylow T v).subgroupOf H |>.map (actionMk U)) ∧
          h.sectionData.fullProjection hm z ≠ 0 := by
  let := c.reduced.normal
  let := c.reduced.elementary
  have a := c.actionFacts_of_three hd
  obtain ⟨h⟩ := a.classification.2.2.2.2.2
  exact ⟨h,c.source_projection_seed _ a.classification.2.1 h.sectionData⟩

/-- The actual component-image scalar obstruction needs no full moved-span
premise: the literal action kernel already normalizes L. -/
theorem Context.no_moving_original_action_prime (c : Context D t v I) (af : ActionFacts c)
    (hz : center (L ⧸ pCore 2 L) = ⊥)
    (p : ℕ) [Fact p.Prime] (hp : p ≠ 2)
    (hd : p ∣ Nat.card (L ⧸ pCore 2 L))
    (ho : Nat.Coprime p (Nat.card (MulAut.Outer (L ⧸ pCore 2 L)))) :
    let H := pointJoin T v I
    let U := internalModule D v I
    letI := c.reduced.normal
    letI := c.reduced.elementary
    let K := I.subgroupOf H
    let q := actionMk U
    let B := ((L.subgroupOf H).map q).subgroupOf (K.map q)
    ∀ (x : K.map q), orderOf x = p → x ∈ sectionCentralizer B →
      ∀ z : U, ((z : H) : G) ∈ ⁅D.fullModule,L⁆ →
        action U (x : ActionQuotient U) (Additive.ofMul z) ≠ Additive.ofMul z → False := by

  let P := (T : Subgroup G) ⊓ centralizer ({v} : Set G)
  let H := I ⊔ P
  let V := conjugateSpanBy (⁅D.fullModule,L⁆ ⊓ centralizer (P : Set G)) I
  let U := V.subgroupOf H
  let := c.reduced.normal
  let := c.reduced.elementary
  let K := I.subgroupOf H
  let A := L.subgroupOf H
  let q := actionMk U
  let B := (A.map q).subgroupOf (K.map q)
  change ∀ (x : K.map q), orderOf x = p → x ∈ sectionCentralizer B →
    ∀ z : U, ((z : H) : G) ∈ ⁅D.fullModule,L⁆ →
      action U (x : ActionQuotient U) (Additive.ofMul z) ≠ Additive.ofMul z → False
  intro x hxp hxB z hzW hmove
  let i : I ≃* K := (subgroupOfEquivOfLe (show I ≤ H from le_sup_left)).symm
  let g := q.subgroupMap K
  let f : I →* K.map q := g.comp i.toMonoidHom
  have hf : Function.Surjective f := (q.subgroupMap_surjective K).comp i.surjective
  have hLH : L ≤ H := c.escaping.strict.le.trans le_sup_left
  let a : L.subgroupOf I ≃* A :=
    (subgroupOfEquivOfLe c.escaping.strict.le).trans (subgroupOfEquivOfLe hLH).symm
  let : Group.IsSolvable g.ker := af.solvable_kernel
  let j : f.ker →* g.ker :=
    (i.toMonoidHom.comp f.ker.subtype).codRestrict g.ker (fun y => y.property)
  let : Group.IsSolvable f.ker := Group.isSolvable_of_isSolvable_injective (f := j) (by
    intro y y' he
    apply Subtype.ext
    exact i.injective (congrArg Subtype.val he))
  have hV : V ≤ H := (conjugateSpanBy_le_self
    (inf_le_left.trans ((source_full_moved_le_component D).trans c.escaping.strict.le))).trans le_sup_left
  have hkn : f.ker ≤ normalizer (L.subgroupOf I : Set I) := by
    intro y hy
    have hyq : q ((i y : K) : H) = 1 := congrArg Subtype.val hy
    have hyC : ((i y : K) : H) ∈ centralizer (U : Set H) :=
      (QuotientGroup.eq_one_iff _).mp hyq
    have hyVG : (y : G) ∈ centralizer (V : Set G) := by
      intro w hw
      exact congrArg H.subtype (hyC ⟨w,hV hw⟩ hw)
    have hyN := c.orbit_centralizer_normalizes_component hyVG
    intro l
    exact hyN (l : G)
  have hkA := (c.small_image_twoCore af hz).1
  let fL := f.subgroupMap (L.subgroupOf I)
  let gL := q.subgroupMap A
  let ja : fL.ker →* gL.ker := (a.toMonoidHom.comp fL.ker.subtype).codRestrict gL.ker (by
    intro y
    apply Subtype.ext
    exact congrArg (fun b : (L.subgroupOf I).map f => ((b : K.map q) : ActionQuotient U)) y.property)
  have hk : IsPGroup 2 fL.ker := hkA.of_injective ja (by
    intro y y' he
    apply Subtype.ext
    exact a.injective (congrArg Subtype.val he))
  have hB : (L.subgroupOf I).map f = B := by
    ext b
    constructor
    · rintro ⟨l,hl,rfl⟩
      exact mem_map.mpr ⟨⟨l,hLH hl⟩,hl,rfl⟩
    · rintro ⟨l,hl,he⟩
      exact ⟨⟨l,c.escaping.strict.le hl⟩,hl,Subtype.ext he⟩
  have hxL : x ∈ sectionCentralizer ((L.subgroupOf I).map f) := by
    rwa [hB]
  obtain ⟨y,hy,hyC⟩ := c.image_prime_lifts_to_moved_centralizer hz p hp hd ho f hf hkn hk hxp hxL
  apply hmove
  have hyq : q ((i y : K) : H) = (x : ActionQuotient U) := congrArg Subtype.val hy
  rw [←hyq]
  apply Additive.toMul.injective
  apply Subtype.ext
  apply Subtype.ext
  have ha := congrArg H.subtype (action_apply U ((i y : K) : H) (Additive.ofMul z))
  exact ha.trans (by
    change (y : G) * ((z : H) : G) * (y : G)⁻¹ = ((z : H) : G)
    rw [←hyC _ hzW,mul_inv_cancel_right])


end CFSG.Quasithin.Chapter10.PointControl.Constrained
