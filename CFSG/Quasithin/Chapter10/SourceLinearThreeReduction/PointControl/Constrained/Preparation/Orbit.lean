module
public import CFSG.Quasithin.Chapter10.SourceLinearThreeReduction.PointControl.Constrained.Preparation.Centralizer
public import CFSG.Quasithin.Chapter10.SourceLinearThreeReduction.PointControl.Selection.BinaryThree.FixedLayer
public import Theory.Representation.SpecialLinearThreeTransitivity

/-!
# Orbit preparation from the original moved factor

A transitive moved factor is generated by any nonidentity point-Sylow fixed
vector, so it lies in the literal I-orbit. A nonzero component-fixed kernel
instead lies in the L₀-fixed layer, by the original crossed pair. Thus either
kind of natural cover supplies the ambient centralizer bound without changing
the orbit or assuming that its full moved factor is contained in it.
Source: Aschbacher--Smith, 10.2.9, printed p.751.
-/

public noncomputable section
open Subgroup Theory.GroupTheory Stellmacher Representation
namespace CFSG.Quasithin.Chapter10.PointControl.Constrained
open Chapter3.Section02
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L : Subgroup G}
  {D : FundamentalSetup KnownSimple.IsKnownSimple T L} {t v : G} {I : Subgroup G}

/-- Transitivity on nonidentity moved vectors gives the actual full-span alternative. -/
theorem Context.moved_le_of_transitive (c : Context D t v I)
    (htrans : ∀ a b : (⁅D.fullModule,L⁆ : Subgroup G), a ≠ 1 → b ≠ 1 →
      ∃ l : L, (MulAut.conj (l : G)) (a : G) = (b : G)) :
    ⁅D.fullModule,L⁆ ≤ orbitModule D v I := by
  let S := pointSylow T v
  let W := ⁅D.fullModule,L⁆
  have hSW : S ≤ normalizer (W : Set G) :=
    (le_inf (inf_le_left.trans (le_normalizer_componentOrbit L T))
      c.escaping.sylow_normalizes).trans (source_moved_normalizer_local_containment D)
  have hfix := inf_centralizer_ne_bot_of_pGroups S W (T.isPGroup'.to_le inf_le_left)
    (source_original_full_moved_elementary D).isPGroup hSW (source_full_moved_ne_bot D)
  obtain ⟨z,hz⟩ := ne_bot_iff_exists_ne_one.mp hfix
  have hzne : (⟨z,z.property.1⟩ : W) ≠ 1 :=
    fun he => hz (Subtype.ext (congrArg (fun a : W => (a : G)) he))
  intro w hw
  by_cases hwne : w = 1
  · exact hwne ▸ one_mem _
  obtain ⟨l,hl⟩ := htrans ⟨z,z.property.1⟩ ⟨w,hw⟩ hzne
    (fun he => hwne (congrArg Subtype.val he))
  change (MulAut.conj (l : G)) (z : G) = w at hl
  rw [←hl]
  exact (mem_normalizer_iff.mp
    (le_normalizer_conjugateSpanBy _ I (c.escaping.strict.le l.property)) z).mp
      (le_conjugateSpanBy _ _ z.property)

/-- The original crossed pair identifies the fixed kernel with the relevant L₀-fixed layer. -/
theorem Context.moved_fixed_eq_orbit_fixed (c : Context D t v I) :
    sourceMovedFixed D = ⁅D.fullModule,L⁆ ⊓ centralizer (localOrbit T L : Set G) := by
  apply le_antisymm
  · intro z hz
    refine ⟨hz.1,?_⟩
    have hfull := Selection.BinaryThree.fixed_layer_eq_moved_kernels D
      c.escaping.t_mem c.escaping.t_not_normalizes c.escaping.crossed
    exact (hfull.ge ((show sourceMovedFixed D ≤ sourceMovedFixed D ⊔
      (sourceMovedFixed D).map (MulAut.conj t).toMonoidHom from le_sup_left) hz)).2
  · exact inf_le_inf_left _ (centralizer_le (le_componentOrbit L T))

/-- A nonzero fixed kernel controls the literal orbit centralizer in every natural-cover row. -/
theorem Context.centralizer_le_of_moved_fixed_ne_bot (c : Context D t v I)
    (hne : sourceMovedFixed D ≠ ⊥) :
    centralizer (orbitModule D v I : Set G) ≤ D.maximalLocal :=
  c.centralizer_le_of_fixed_layer (c.moved_fixed_eq_orbit_fixed ▸ hne)

/-- In the binary-three natural-cover row, both possible kernels give centralizer control. -/
theorem Context.centralizer_le_of_binaryThreeNatural (c : Context D t v I)
    (hmodel : Selection.BinaryThreeNatural D) :
    centralizer (orbitModule D v I : Set G) ≤ D.maximalLocal := by
  by_cases hz : sourceMovedFixed D = ⊥
  · obtain ⟨e,⟨s⟩⟩ := hmodel
    have hi : Function.Injective s.coordinates := (MonoidHom.ker_eq_bot_iff _).mp (by
      rw [s.kernel_eq]
      change (sourceMovedFixed D).subgroupOf ⁅D.fullModule,L⁆ = ⊥
      rw [hz,bot_subgroupOf])
    apply c.centralizer_le_of_moved_le
    apply c.moved_le_of_transitive
    intro a b ha hb
    have hne (x : (⁅D.fullModule,L⁆ : Subgroup G)) (hx : x ≠ 1) :
        (s.coordinates x).toAdd ≠ 0 := by
      intro he
      exact hx (hi (he.trans (map_one s.coordinates).symm))
    obtain ⟨g,hg⟩ := Matrix.SpecialLinearGroup.exists_mulVec_eq_three
      (s.coordinates a).toAdd (s.coordinates b).toAdd (hne a ha) (hne b hb)
    obtain ⟨l,hl⟩ := (e.surjective.comp (QuotientGroup.mk'_surjective (pCore 2 L))) g
    change e (QuotientGroup.mk' (pCore 2 L) l) = g at hl
    refine ⟨l,?_⟩
    have he := s.equivariant l a
    change (s.coordinates _).toAdd = specialLinearNatural 3
      (e (QuotientGroup.mk' (pCore 2 L) l)) (s.coordinates a).toAdd at he
    rw [hl] at he
    exact congrArg Subtype.val (hi (Multiplicative.toAdd.injective (he.trans hg)))
  · exact c.centralizer_le_of_moved_fixed_ne_bot hz

end CFSG.Quasithin.Chapter10.PointControl.Constrained
