/-!
# Two-factor rows for the original moving local module

The original centralizer quotient retains two distinct components. When
J(T) moves the local module, its image lies in the offender subgroup and
the component orbit is generated by its J(T)-commutators. Thus both
components lie in that subgroup, with a genuine SQTK cover. The complete
B.5 classification leaves only its product rows. Full commutator generation
of the local module excludes the hyperplane row.

The result retains the literal action, internal product and quotient
summands. It does not identify the full and local modules or assert
separated support. The full-module action restricted to the original
component orbit also has precisely its two-core as kernel.

Source: Aschbacher--Smith B.5.6, 3.2.2(6) and 10.1.1--2,
printed pp.105,579,741--742.
-/

@[expose] public noncomputable section
open Stellmacher Representation Representation.BinaryOffender
open Subgroup Theory.GroupTheory
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter10.PointControl.Selection.ModuleChoice
open Chapter3.Section02
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L : Subgroup G}
  (D : FundamentalSetup KnownSimple.IsKnownSimple T L)

/-- The original full actor restricted to L₀ has precisely its two-core as kernel. -/
theorem full_actor_restriction_kernel (D : FundamentalSetup KnownSimple.IsKnownSimple T L)
    (hn : ¬ (T : Subgroup G) ≤ normalizer (L : Set G)) :
    let U := D.fullModule.subgroupOf D.maximalLocal
    let := (source_full_module_reduced D).normal
    ((QuotientGroup.mk' (centralizer (U : Set D.maximalLocal))).comp
      (inclusion (localOrbit T L).le_normalizer)).ker = pCore 2 (localOrbit T L) := by
  dsimp only
  let M := D.maximalLocal
  let R := localOrbit T L
  let H := localJoin T L
  let U := D.fullModule.subgroupOf M
  let := (source_full_module_reduced D).normal
  let qM := QuotientGroup.mk' (centralizer (U : Set M))
  let f := qM.comp (inclusion R.le_normalizer)
  change f.ker = pCore 2 R
  have hVM : D.fullModule ≤ M := D.fullModule_le_orbit.trans R.le_normalizer
  apply le_antisymm
  · have hCH := full_module_local_kernel_isTwoGroup D hn
    have hp := hCH.comap_of_injective (inclusion (show R ≤ H from le_sup_left))
      (inclusion_injective _)
    have hk : f.ker ≤ (centralizer (D.fullModule.subgroupOf H : Set H)).comap
        (inclusion (show R ≤ H from le_sup_left)) := by
      intro x hx v hv
      have hxC : (inclusion R.le_normalizer x : M) ∈ centralizer (U : Set M) :=
        (QuotientGroup.eq_one_iff _).mp hx
      have hxm := hxC ⟨v, hVM hv⟩ hv
      exact Subtype.ext (congrArg (fun z : M => (z : G)) hxm)
    exact le_sSup ⟨inferInstance,hp.to_le hk⟩
  · intro x hx
    have hc : R.pCoreIn 2 ≤ M.pCoreIn 2 :=
      pCoreIn_mono_of_normalizes R.le_normalizer le_rfl
    obtain ⟨z,hz,hzx⟩ := hc (mem_map_of_mem R.subtype hx)
    have hz' : z = inclusion R.le_normalizer x := Subtype.ext hzx
    have hm : inclusion R.le_normalizer x ∈ pCore 2 M := hz' ▸ hz
    exact (QuotientGroup.eq_one_iff _).mpr
      ((le_centralizer_iff.mp (source_full_module_reduced D).le_centralizer_pCore) hm)


/-- Both original conjugate components remain distinct in the literal local
centralizer quotient. -/
theorem local_action_component_pair
    {t : G} (ht : t ∈ (T : Subgroup G)) (htn : t ∉ normalizer (L : Set G)) :
    let H := localJoin T L
    let U := D.moduleSubgroup.subgroupOf H
    let : U.Normal := normal_subgroupOf_of_le_normalizer D.join_normalizes_module
    let q := QuotientGroup.mk' (centralizer (U : Set H))
    let A := L.subgroupOf H
    let tH : H := ⟨t, (show (T : Subgroup G) ≤ localJoin T L from le_sup_right) ht⟩
    let B := A.map (MulAut.conj tH).toMonoidHom
    IsComponent (H ⧸ centralizer (U : Set H)) (A.map q) ∧
      IsComponent (H ⧸ centralizer (U : Set H)) (B.map q) ∧ A.map q ≠ B.map q := by
  dsimp only
  let H := localJoin T L
  let A := L.subgroupOf H
  let U := D.moduleSubgroup.subgroupOf H
  let : U.Normal := normal_subgroupOf_of_le_normalizer D.join_normalizes_module
  let C := centralizer (U : Set H)
  let q := QuotientGroup.mk' C
  let tH : H := ⟨t, (show (T : Subgroup G) ≤ localJoin T L from le_sup_right) ht⟩
  let B := A.map (MulAut.conj tH).toMonoidHom
  have hn : ¬ (T : Subgroup G) ≤ normalizer (L : Set G) := fun h => htn (h ht)
  have hAq := (local_action_original_component D hn).1
  have hBq : B.map q = (A.map q).map (MulAut.conj (q tH)).toMonoidHom := by
    rw [map_map, map_map]
    congr 1
  refine ⟨hAq, hBq.symm ▸ hAq.map_equiv (MulAut.conj (q tH)), ?_⟩
  have hA : A.IsCComponent := by
    change (L.subgroupOf (componentOrbit L (T : Subgroup G) ⊔ (T : Subgroup G))).IsCComponent
    rw [componentOrbit_sup]
    exact D.maximal.1.1
  have heq (N : Subgroup H) [N.Normal] (hN : N = pCore 2 H)
      (he : A.map (QuotientGroup.mk' N) = B.map (QuotientGroup.mk' N)) : A = B := by
    subst N
    let : Group.IsNilpotent (pCore 2 H) := pCore_isPGroup.isNilpotent
    exact hA.eq_of_map_quotient_eq (hA.map_equiv (MulAut.conj tH)) (pCore 2 H) he
  intro he
  have he' := congrArg (map H.subtype) (heq C (local_module_kernel_eq_twoCore D hn) he)
  have hLH : L ≤ H := (le_componentOrbit L T).trans le_sup_left
  have hmapA : A.map H.subtype = L := map_subgroupOf_eq_of_le hLH
  have hmapB : B.map H.subtype = L.map (MulAut.conj t).toMonoidHom := by
    rw [map_map, show H.subtype.comp (MulAut.conj tH).toMonoidHom =
      (MulAut.conj t).toMonoidHom.comp H.subtype from rfl, ←map_map, hmapA]
  rw [hmapA,hmapB] at he'
  exact htn (mem_normalizer_iff_map_conj_eq.mpr he'.symm)

/-- The local module is generated by the actual orbit component, before any
full/local equality or separated-support assertion. -/
theorem local_module_eq_commutator :
    D.moduleSubgroup = ⁅D.moduleSubgroup,localOrbit T L⁆ := by
  have hXM : localOrbit T L ≤ localJoin T L := le_sup_left
  have hXn : localJoin T L ≤ normalizer (localOrbit T L : Set G) :=
    sup_le (localOrbit T L).le_normalizer (le_normalizer_componentOrbit L T)
  let : ((localOrbit T L).subgroupOf (localJoin T L)).Normal :=
    normal_subgroupOf_of_le_normalizer hXn
  have he := ReducedNormal.seedOrbit_eq_commutator (localJoin T L) (localOrbit T L)
    hXM D.homogeneous.isIrrPlus
  have ho : componentOrbit D.seed (localJoin T L) = D.moduleSubgroup := by
    apply le_antisymm
    · exact iSup_conjugates_le_of_le_normalizer _ _ _
        (le_componentOrbit D.seed T) D.join_normalizes_module
    · exact iSup_le fun t => le_iSup_of_le
        (⟨t.val,(show (T : Subgroup G) ≤ localJoin T L from le_sup_right) t.property⟩ : localJoin T L) le_rfl
  change componentOrbit D.seed (localJoin T L) =
    ⁅componentOrbit D.seed (localJoin T L),localOrbit T L⁆ at he
  rwa [ho] at he

/-- Thompson movement puts the whole original component orbit in the
faithful action's offender subgroup. -/
theorem local_orbit_image_le_offender
    (hJ : ¬ elementaryAbelianMaxJ (T : Subgroup G) ≤
      centralizer (D.moduleSubgroup : Set G)) :
    let H := localJoin T L
    let U := D.moduleSubgroup.subgroupOf H
    let := (D.module_reduced (source_module_nonsolvable_uniqueness D)).normal
    let := (D.module_reduced (source_module_nonsolvable_uniqueness D)).elementary
    let q := ChapterB.InternalThompsonAction.actionMk U
    let ρ := ChapterB.InternalThompsonAction.action U
    ((localOrbit T L).subgroupOf H).map q ≤ offenderSubgroup ρ := by
  dsimp only
  let H := localJoin T L
  let U := D.moduleSubgroup.subgroupOf H
  let := (D.module_reduced (source_module_nonsolvable_uniqueness D)).normal
  let := (D.module_reduced (source_module_nonsolvable_uniqueness D)).elementary
  let q := ChapterB.InternalThompsonAction.actionMk U
  let ρ := ChapterB.InternalThompsonAction.action U
  let X := (localOrbit T L).subgroupOf H
  let S := T.subtype (show (T : Subgroup G) ≤ H from le_sup_right)
  let J := elementaryAbelianMaxJ (S : Subgroup H)
  let Y := offenderSubgroup ρ
  let := offenderSubgroup_normal ρ
  have hJmap : J.map H.subtype = elementaryAbelianMaxJ (T : Subgroup G) := by
    rw [← elementaryAbelianMaxJ_map_injective H.subtype H.subtype_injective]
    exact congrArg elementaryAbelianMaxJ (map_subgroupOf_eq_of_le le_sup_right)
  have hX : X = ⁅X,J⁆ := by
    apply map_injective H.subtype_injective
    rw [map_commutator,map_subgroupOf_eq_of_le (show localOrbit T L ≤ H from le_sup_left),hJmap]
    exact D.actor_eq_commutator_of_thompson_not_centralizes
      (source_module_nonsolvable_uniqueness D) hJ
  have hJY : J.map q ≤ Y := ChapterB.InternalThompsonAction.thompson_image_le S U
  calc
    X.map q = ⁅X.map q,J.map q⁆ := by rw [←map_commutator,←hX]
    _ ≤ ⁅X.map q,Y⁆ := commutator_mono le_rfl hJY
    _ ≤ Y := commutator_le_right _ _

/-- The complete B.5 classification on the original local module has the
two-factor row. All group and module inputs are derived from FSU and
Thompson movement; no model or separation assumption is supplied. -/
theorem local_module_two_factor_case
    (hn : ¬ (T : Subgroup G) ≤ normalizer (L : Set G))
    (hJ : ¬ elementaryAbelianMaxJ (T : Subgroup G) ≤
      centralizer (D.moduleSubgroup : Set G)) :
    let H := localJoin T L
    let U := D.moduleSubgroup.subgroupOf H
    let := (D.module_reduced (source_module_nonsolvable_uniqueness D)).normal
    let := (D.module_reduced (source_module_nonsolvable_uniqueness D)).elementary
    let ρ := ChapterB.InternalThompsonAction.action U
    Nonempty (ChapterB.SourceInduction.SourceTwoFactorCase
      (ρ.comp (offenderSubgroup ρ).subtype)) := by
  dsimp only
  let H := localJoin T L
  let U := D.moduleSubgroup.subgroupOf H
  have hU := D.module_reduced (source_module_nonsolvable_uniqueness D)
  let := hU.normal
  let := hU.elementary
  let q := ChapterB.InternalThompsonAction.actionMk U
  let ρ := ChapterB.InternalThompsonAction.action U
  let Y := offenderSubgroup ρ
  let σ := ρ.comp Y.subtype
  let X := (localOrbit T L).subgroupOf H
  have hXY : X.map q ≤ Y := local_orbit_image_le_offender D hJ
  have hsource := ChapterB.InternalThompsonAction.offender_hypothesis ρ q
    (QuotientGroup.mk'_surjective _) (D.local_internal_module
      (source_module_nonsolvable_uniqueness D)).sqtk
    (ChapterB.InternalThompsonAction.action_faithful U) hU.quotient_pCore_eq_bot
  obtain ⟨t,ht,htn,hpair,_⟩ := source_nonnormal_pair D.simpleQTKE D.maximal.1 hn
  let A := L.subgroupOf H
  let tH : H := ⟨t,(show (T : Subgroup G) ≤ localJoin T L from le_sup_right) ht⟩
  let B := A.map (MulAut.conj tH).toMonoidHom
  obtain ⟨hAq,hBq,hne⟩ := local_action_component_pair D ht htn
  have hAX : A ≤ X := comap_mono (le_componentOrbit L T)
  have hBX : B ≤ X := by
    intro b hb
    obtain ⟨a,ha,rfl⟩ := hb
    have hXn : H ≤ normalizer (localOrbit T L : Set G) :=
      sup_le (localOrbit T L).le_normalizer (le_normalizer_componentOrbit L T)
    exact (mem_normalizer_iff.mp (hXn tH.property) a).mp (hAX ha)
  have hAY : A.map q ≤ Y := (map_mono hAX).trans hXY
  have hBY : B.map q ≤ Y := (map_mono hBX).trans hXY
  have hneY : (A.map q).subgroupOf Y ≠ (B.map q).subgroupOf Y := by
    intro he
    apply hne
    have hh := congrArg (map Y.subtype) he
    simpa only [map_subgroupOf_eq_of_le hAY,map_subgroupOf_eq_of_le hBY] using hh
  have hclass := ChapterB.SourceInduction.adequateAlternative_knownSimple σ hsource
  rcases hclass.product_rows_of_two_components σ (hAq.subgroupOf hAY)
      (hBq.subgroupOf hBY) hneY with hp | hp
  · exact hp
  obtain ⟨hp⟩ := hp
  have hmU : ⁅U,X⁆ = U := by
    apply map_injective H.subtype_injective
    rw [map_commutator,
      map_subgroupOf_eq_of_le (D.module_le_sylow.trans (show (T : Subgroup G) ≤ H from le_sup_right)),
      map_subgroupOf_eq_of_le (show localOrbit T L ≤ H from le_sup_left)]
    exact (local_module_eq_commutator D).symm
  have hmX : subspaceCommutator ρ ⊤ (X.map q) = ⊤ := by
    change subspaceCommutator (NormalElementaryQuotient.representation U q
      (QuotientGroup.mk'_surjective _) (QuotientGroup.ker_mk' _)) ⊤ (X.map q) = ⊤
    rw [←NormalElementaryQuotient.commutatorSpace_eq U q
      (QuotientGroup.mk'_surjective _) (QuotientGroup.ker_mk' _) X]
    ext w
    change (w.toMul : H) ∈ ⁅U,X⁆ ↔ True
    rw [hmU]
    exact iff_true_intro w.toMul.property
  have hmY : subspaceCommutator σ ⊤ ⊤ = ⊤ := by
    change subspaceCommutator (ρ.comp Y.subtype) ⊤ ⊤ = ⊤
    rw [subspaceCommutator_comp_map, ←MonoidHom.range_eq_map, range_subtype]
    apply top_unique
    calc
      ⊤ = subspaceCommutator ρ ⊤ (X.map q) := hmX.symm
      _ ≤ subspaceCommutator ρ ⊤ Y := Submodule.span_mono
        (by rintro _ ⟨g,hg,v,hv,rfl⟩; exact ⟨g,hXY hg,v,hv,rfl⟩)
  have hh := hp.hyperplane
  unfold ChapterB.QuasisimpleSource.moved at hh
  rw [hmY,top_sup_eq,Module.finrank_zero_of_subsingleton] at hh
  omega


end CFSG.Quasithin.Chapter10.PointControl.Selection.ModuleChoice
