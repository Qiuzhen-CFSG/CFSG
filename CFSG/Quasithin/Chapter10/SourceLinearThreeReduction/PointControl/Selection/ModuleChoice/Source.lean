theorem tensor_point_borel_and_hstar
    (D : FundamentalSetup KnownSimple.IsKnownSimple T L)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hmin : D.IsMinimalFullModule)
    (hn : ¬ (T : Subgroup G) ≤ normalizer (L : Set G))
    (hJ : elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (D.moduleSubgroup : Set G))
    (cL : (L ⧸ pCore 2 L) ≃* Matrix.PSL3Two.SL)
    {z : G} (hzV : z ∈ D.fullModule) (hz1 : z ≠ 1)
    (hzT : (T : Subgroup G) ≤ centralizer ({z} : Set G)) :
    let := D.fullModule_elementary (source_module_nonsolvable_uniqueness D)
    ∀ (e : Additive D.fullModule ≃ₗ[ZMod 2] BinaryTensorThree.Space),
      ((localOrbit T L).subgroupOf (localJoin T L)).map
        (quietTensorLinearAction D e) = BinaryTensorThree.baseAction.range →
      ∀ P : Sylow 3 (CentralizerSetup.X ⟨T,localOrbit T L,z⟩),
    let d : CentralizerSetup G := ⟨T,localOrbit T L,z⟩
    let P₀ := (P : Subgroup d.X).map d.X.subtype
    (d.Gz : Set G) = (d.Kz : Set G) * (d.Mz : Set G) ∧
    d.KzT ∈ Chapter3.HStar (T : Subgroup G) D.maximalLocal ∧
    ChapterE.generationParameter d.KzT = 2 ∧
    d.Kz ⊓ D.maximalLocal = borel d.Kz (T : Subgroup G) ∧
    borel d.Kz (T : Subgroup G) = d.X ⊔ ((T : Subgroup G) ⊓ d.Kz) ∧
    (d.X : Set G) * (((T : Subgroup G) ⊓ d.Kz : Subgroup G) : Set G) =
      (d.Kz ⊓ D.maximalLocal : Subgroup G) ∧
    d.KzT ⊓ D.maximalLocal = d.XT ∧
    ∃ K : Subgroup G,
      K ∈ Chapter1.cComponentsIn d.Gz ∧ ¬ K ≤ D.maximalLocal ∧
      IsQuasisimple (Chapter1.XiQuotient K) ∧
      d.Kz = componentOrbit K (T : Subgroup G) ∧ ⁅d.Kz,P₀⁆ = d.Kz ∧
      Nonempty (P₀ ≃* Plane 3) ∧ SwappedFactors (T : Subgroup G) P₀ K ∧
      ClassicalGroup.IsPSL (Chapter1.XiQuotient K) 2 5 ∧
      ClassicalGroup.IsPSL (Chapter1.XiQuotient K) 2 4 ∧
      ∃ s ∈ (T : Subgroup G) ⊓ normalizer (P₀ : Set G),
        s ∉ normalizer (K : Set G) ∧
        (d.Kz : Set G) = (K : Set G) * (K.conjBy s : Set G) := by
  dsimp only
  intro e hbase P
  let d : CentralizerSetup G := ⟨T,localOrbit T L,z⟩
  obtain ⟨hf,K,hK,hKM,hq,hclosure,hcomm,hP,hswap,hm⟩ :=
    tensor_point_factor_and_swapped_five_models D hmany hmin hn hJ cL hzV hz1 hzT e hbase P
  have hs := quiet_tensor_five_swapped_input D hn e hbase hzV hz1 hzT P
    hK hq hclosure hcomm hP hswap hm
  obtain ⟨hstar,hBM,hB,hMT⟩ := quiet_tensor_five_borel_hstar D hmany hmin hn hJ cL
    e hbase hzV hz1 hzT P hs hclosure hm
  have hprod : (d.X : Set G) * (((T : Subgroup G) ⊓ d.Kz : Subgroup G) : Set G) =
      (d.Kz ⊓ D.maximalLocal : Subgroup G) := by
    rw [←coe_mul_of_right_le_normalizer_left d.X ((T : Subgroup G) ⊓ d.Kz)
      (inf_le_left.trans hs.invariant),←hB,←hBM]
  have hm4 : ClassicalGroup.IsPSL (XiQuotient K) 2 4 := by
    obtain ⟨F,_,_,hF,⟨a⟩⟩ := hm
    exact ⟨GaloisField 2 2,inferInstance,inferInstance,
      by rw [GaloisField.card 2 2 (by decide)]; norm_num,
      ⟨a.trans (Matrix.ProjectiveSpecialLinearGroup.cardFiveEquivFour hF)⟩⟩
  refine ⟨hf,hstar,tensor_hstar_generation D hmany hmin hn hJ cL hzV hz1 hzT
    e hbase P _ hstar,hBM,hB,hprod,hMT,K,hK,hKM,hq,hclosure,hcomm,hP,hswap,hm,hm4,?_⟩
  obtain ⟨s,hsT,hsK⟩ := hs.toSwappedInput.exists_swap
  let hA := fun (Y : Type _) [Group Y] [Finite Y] => ChapterA.Section02.theoremA_knownSimple (G := Y)
  let hC := fun (Y : Type _) [Group Y] [Finite Y] => ChapterA.Section02.theoremC_knownSimple (G := Y)
  obtain ⟨hi,_⟩ := SwappedSylow.nonnormal_model_of_theoremsAC hA hC hs.toSwappedInput
  have horbit := SwappedFactorsProof.orbit_eq_sup hs.toSwappedInput hi hsT.1 hsK
  have hnormalize : K.conjBy s ≤ normalizer (K : Set G) :=
    (le_iSup (fun t : (T : Subgroup G) => K.conjBy (t : G)) ⟨s,hsT.1⟩).trans
      (cComponentOrbit_le_normalizer hK hzT)
  refine ⟨s,hsT,hsK,?_⟩
  rw [hclosure,horbit,coe_mul_of_right_le_normalizer_left _ _ hnormalize]


