    (hnon : ¬ (T : Subgroup G) ≤ normalizer (L : Set G))
    (hna : ¬ Nonempty ((L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 5)))
    (hJ : elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (D.moduleSubgroup : Set G))
    (n : ℕ) (hn : 3 ≤ n)
    (e : (L ⧸ pCore 2 L) ≃* Matrix.SpecialLinearGroup (Fin 2) (GaloisField 2 n))
    {t : G} (ht : t ∈ (T : Subgroup G)) (htn : t ∉ normalizer (L : Set G)) :
    let := D.seed_elementary
    (⁅D.fullModule ⊓ centralizer
        (L.map (MulAut.conj t).toMonoidHom : Set G),L⁆ ≠ ⊥ ∧
      (⁅D.fullModule,L⁆).map (MulAut.conj t).toMonoidHom ≤ centralizer (L : Set G) ∧
      PointSylowControl D t) ∨
    (QuietRankOneSeedMarking D e ht ∧ D.seed = D.fullModule ∧
      D.moduleSubgroup = D.fullModule ∧ QuietRankOneFullTensorMarking D e ht ∧
      ∀ H ∈ Chapter3.HStar (T : Subgroup G) D.maximalLocal,
        n-1 ≤ ChapterE.generationParameter H ∧ ChapterE.generationParameter H ≤ n ∧
          QuietRankOneInverseFieldData D n H) := by
  dsimp only
  let := D.seed_elementary
  rcases quiet_rankOne_point_selection_or_full_tensor D hmany hmin hnon hJ n hn e ht htn
    with hp | ⟨hm,hs,hfull,htensor⟩
  · exact Or.inl hp
  · refine Or.inr ⟨hm,hs,hfull,htensor,?_⟩
    intro H hH
    have hlocal : D.moduleSubgroup = D.seed := hfull.trans hs.symm
    have hc := quiet_rankOne_hstar_cyclic_cartan D hmany hmin hnon hna hJ hn htn hm hlocal hH
    exact ⟨hc.1,hc.2.1,
      quiet_rankOne_hstar_inverse_field D hmany hmin hnon hna hJ hn htn hm hlocal hH⟩

/-- Original point selection now retains only the quiet full tensor with
its constructed H-star Cartan obstruction. The named half-Sylow normalizer
input retains its independent producer; even positive fixed-layer geometry
is still a distinct source obligation. -/
theorem exists_point_selection_or_quiet_rankOne_cartan
    (D : FundamentalSetup KnownSimple.IsKnownSimple T L)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hmin : D.IsMinimalFullModule)
    (hnon : ¬ (T : Subgroup G) ≤ normalizer (L : Set G))
    (hna : ¬ Nonempty ((L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 5)))
    (n : ℕ) (hn : 3 ≤ n)
    (e : (L ⧸ pCore 2 L) ≃* Matrix.SpecialLinearGroup (Fin 2) (GaloisField 2 n))
    (hN : HalfUniqueness.StabilizerNormalizerAt T) :
    let := D.seed_elementary
    ∃ (t : G) (ht : t ∈ (T : Subgroup G)), t ∉ normalizer (L : Set G) ∧
      (((⁅D.fullModule,L⁆).map (MulAut.conj t).toMonoidHom ≤ centralizer (L : Set G) ∧
        (HalfSylowUnique D → PointSylowControl D t)) ∨
      (QuietRankOneSeedMarking D e ht ∧ D.seed = D.fullModule ∧
        D.moduleSubgroup = D.fullModule ∧ QuietRankOneFullTensorMarking D e ht ∧
        ∀ H ∈ Chapter3.HStar (T : Subgroup G) D.maximalLocal,
          n-1 ≤ ChapterE.generationParameter H ∧ ChapterE.generationParameter H ≤ n ∧
            QuietRankOneInverseFieldData D n H)) := by
  dsimp only
  let := D.seed_elementary
  by_cases hJ : elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (D.moduleSubgroup : Set G)
  · obtain ⟨t,ht,htn,_,_⟩ := source_nonnormal_pair D.simpleQTKE D.maximal.1 hnon
    refine ⟨t,ht,htn,?_⟩
    rcases quiet_rankOne_point_selection_or_hstar_cartan D hmany hmin hnon hna hJ n hn e ht htn
      with ⟨_,hc,hp⟩ | hm
    · exact Or.inl ⟨hc,fun _ => hp⟩
    · exact Or.inr hm
  · obtain ⟨t,ht,htn,hc,hp⟩ :=
      exists_point_selection_of_minimal_local_thompson_direct D hmany hmin hnon hna hJ hN
    exact ⟨t,ht,htn,Or.inl ⟨hc,hp⟩⟩

open scoped MatrixGroups in
/-- Every quiet minimal source module has nonzero component-fixed support,
with all actual component families and both tensor exclusions discharged. -/
theorem quiet_component_fixed_ne_bot
    (D : FundamentalSetup KnownSimple.IsKnownSimple T L)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hmin : D.IsMinimalFullModule)
    (hn : ¬ (T : Subgroup G) ≤ normalizer (L : Set G))
    (hna : ¬ Nonempty ((L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 5)))
    (hJ : Stellmacher.elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (D.moduleSubgroup : Set G)) :
    D.fullModule ⊓ centralizer (L : Set G) ≠ ⊥ := by
  by_cases hb : Nonempty ((L ⧸ pCore 2 L) ≃* SL(3,ZMod 2))
  · exact quiet_binaryThree_component_fixed_ne_bot D hmany hmin hn hJ hb.some
  intro hfix
  obtain ⟨t,ht,htn,_,_⟩ := source_nonnormal_pair D.simpleQTKE D.maximal.1 hn
  have hfix' : D.fullModule ⊓ centralizer
      (L.map (MulAut.conj t).toMonoidHom : Set G) = ⊥ := by
    rw [←quiet_component_fixed_conjugate D ht,hfix,Subgroup.map_bot]
  have hseed : D.seed ≤ D.fullModule :=
    (le_componentOrbit D.seed T).trans (le_componentOrbit _ _)
  have hsep : ¬ (D.seed ≤ centralizer (L.map (MulAut.conj t).toMonoidHom : Set G) ∨
      D.seed ≤ centralizer (L : Set G)) := by
    rintro (hc | hc)
    · exact D.seed_ne_bot (bot_unique ((le_inf hseed hc).trans_eq hfix'))
    · exact D.seed_ne_bot (bot_unique ((le_inf hseed hc).trans_eq hfix))
  obtain ⟨n,hn3,⟨e⟩⟩ := quiet_nonseparated_model_even D hmany hn hna hJ hb ht htn hsep
  exact quiet_rankOne_component_fixed_ne_bot D hmany hmin hn hna hJ n hn3 e hfix


/-- Complete quiet support on the original full module. -/
theorem quietSupportAt : QuietSupportAt (G := G) T := by
  intro hmany L D hmin hn hna hJ
  have hlocal := hJ.trans (centralizer_le (le_componentOrbit D.moduleSubgroup D.maximalLocal))
  obtain ⟨t,ht,htn,hs,_,_⟩ := exists_point_selection_of_quiet_component_fixed_ne_bot
    D hmany hmin hn hJ (quiet_component_fixed_ne_bot D hmany hmin hn hna hlocal)
  exact ⟨t,ht,htn,hs⟩

/-- The original full-Thompson quiet branch has crossed movement and point
control for every opposite point, without a half-Sylow or geometry premise. -/
theorem exists_point_selection_of_quiet
    (D : FundamentalSetup KnownSimple.IsKnownSimple T L)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hmin : D.IsMinimalFullModule)
    (hn : ¬ (T : Subgroup G) ≤ normalizer (L : Set G))
    (hna : ¬ Nonempty ((L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 5)))
    (hJ : Stellmacher.elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (D.fullModule : Set G)) :
    ∃ t ∈ (T : Subgroup G), t ∉ normalizer (L : Set G) ∧
      ⁅D.fullModule ⊓ centralizer
        (L.map (MulAut.conj t).toMonoidHom : Set G),L⁆ ≠ ⊥ ∧
      (⁅D.fullModule,L⁆).map (MulAut.conj t).toMonoidHom ≤ centralizer (L : Set G) ∧
      PointSylowControl D t := by
  have hlocal := hJ.trans (centralizer_le (le_componentOrbit D.moduleSubgroup D.maximalLocal))
  exact exists_point_selection_of_quiet_component_fixed_ne_bot D hmany hmin hn hJ
    (quiet_component_fixed_ne_bot D hmany hmin hn hna hlocal)

open scoped MatrixGroups in
/-- Both Thompson branches of the original rank-one component satisfy the
selected fixed-support row on the same minimal full module. -/
theorem fixed_support_row_of_minimal_rankOne
    (D : FundamentalSetup KnownSimple.IsKnownSimple T L)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hmin : D.IsMinimalFullModule)
    (hnon : ¬ (T : Subgroup G) ≤ normalizer (L : Set G))
    (hna : ¬ Nonempty ((L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 5)))
    (n : ℕ) (hn : 3 ≤ n)
    (e : (L ⧸ pCore 2 L) ≃* SL(2,GaloisField 2 n)) :
    ∃ t ∈ (T : Subgroup G), t ∉ normalizer (L : Set G) ∧
      ⁅D.fullModule ⊓ centralizer
        (L.map (MulAut.conj t).toMonoidHom : Set G),L⁆ ≠ ⊥ ∧
      (Stellmacher.elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (D.fullModule : Set G) ∨
        (D.fullModule = D.moduleSubgroup ∧ (RankOneNatural D ∨ BinaryThreeNatural D))) := by
  by_cases hJ : Stellmacher.elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (D.moduleSubgroup : Set G)
  · have hd : 3 ∣ Nat.card (L ⧸ pCore 2 L) := by
      rw [Nat.card_congr e.toEquiv]
      exact Theory.SpecificGroups.three_dvd_card_sl_two _
    exact fixed_support_row_of_quiet_component_fixed_ne_bot D hmany hmin hnon
      (full_thompson_centralizes_of_local_three D hnon hd hJ)
      (quiet_rankOne_component_fixed_ne_bot D hmany hmin hnon hna hJ n hn e)
  · obtain ⟨t,ht,htn,hs,hfull,hm⟩ := fixed_support_row_of_minimal_local_thompson D hmin hnon hna hJ
    exact ⟨t,ht,htn,hs,Or.inr ⟨hfull,hm⟩⟩

open scoped MatrixGroups in
/-- Rank-one point selection with the quiet tensor excluded. The named
external half-Sylow normalizer input retains its original producer. The even
positive fixed-layer output is separate from this point-control theorem. -/
theorem exists_point_selection_of_minimal_rankOne
    (D : FundamentalSetup KnownSimple.IsKnownSimple T L)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hmin : D.IsMinimalFullModule)
    (hnon : ¬ (T : Subgroup G) ≤ normalizer (L : Set G))
    (hna : ¬ Nonempty ((L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 5)))
    (n : ℕ) (hn : 3 ≤ n)
    (e : (L ⧸ pCore 2 L) ≃* SL(2,GaloisField 2 n))
    (hN : HalfUniqueness.StabilizerNormalizerAt T) :
    ∃ t ∈ (T : Subgroup G), t ∉ normalizer (L : Set G) ∧
      (⁅D.fullModule,L⁆).map (MulAut.conj t).toMonoidHom ≤ centralizer (L : Set G) ∧
      (HalfSylowUnique D → PointSylowControl D t) := by
  by_cases hJ : Stellmacher.elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (D.moduleSubgroup : Set G)
  · have hd : 3 ∣ Nat.card (L ⧸ pCore 2 L) := by
      rw [Nat.card_congr e.toEquiv]
      exact Theory.SpecificGroups.three_dvd_card_sl_two _
    obtain ⟨t,ht,htn,_,hc,hp⟩ := exists_point_selection_of_quiet_component_fixed_ne_bot
      D hmany hmin hnon (full_thompson_centralizes_of_local_three D hnon hd hJ)
      (quiet_rankOne_component_fixed_ne_bot D hmany hmin hnon hna hJ n hn e)
    exact ⟨t,ht,htn,hc,fun _ => hp⟩
  · exact exists_point_selection_of_minimal_local_thompson_direct D hmany hmin hnon hna hJ hN


/-- Every original minimal full module has the selected fixed-support row. -/
theorem fixedSupportRowsAt : FixedSupportRowsAt (G := G) T := by
  intro hmany L D hmin hn hna
  by_cases hJ : elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (D.moduleSubgroup : Set G)
  · exact fixed_support_row_of_quiet_component_fixed_ne_bot D hmany hmin hn
      (full_thompson_centralizes_of_local D hmany hmin hn hJ)
      (quiet_component_fixed_ne_bot D hmany hmin hn hna hJ)
  · obtain ⟨t,ht,htn,hs,hfull,hm⟩ :=
      fixed_support_row_of_minimal_local_thompson D hmin hn hna hJ
    exact ⟨t,ht,htn,hs,Or.inr ⟨hfull,hm⟩⟩

/-- Minimal source selection now supplies the complete original module choice. -/
theorem moduleChoiceAt (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G) :
    ModuleChoiceAt T := moduleChoiceAt_of_fixed_support_rows hG fixedSupportRowsAt

/-- Original point selection with both fixed-support rows and the separate
even positive fixed-layer premise discharged. Only the independently owned
stabilizer-normalizer input remains. -/
theorem selectionAt_of_stabilizer_normalizer
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (hN : HalfUniqueness.StabilizerNormalizerAt T) : SelectionAt T :=
  selectionAt_of_even_positive_fixed_support_rows hG fixedSupportRowsAt
    RankOne.evenPositiveFixedLayerAt hN

/-- Actual source point-control application with the selected-module premise
discharged. The independently owned component exclusions and uniqueness remain. -/
theorem source_nonnormalPointControl_of_proved_selection
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (hN : HalfUniqueness.StabilizerNormalizerAt T) (hhalf : HalfSylowUniqueAt T)
    (hquasi : QuasisimpleExclusionAt T) (hconstrained : ConstrainedExclusionAt T) :
    SourceNonnormalPointControlAt T :=
  source_nonnormalPointControl_of_sourceSteps hhalf
    (selectionAt_of_stabilizer_normalizer hG hN) hquasi hconstrained

