/-- The original source hypotheses select an actual minimal module and
supply the complete two-factor alternative whenever its Thompson subgroup
moves the local module. This is the local classification input to 3.2.6. -/
theorem exists_minimal_local_module_classification
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (hL : L ∈ Chapter1.LStar G (T : Subgroup G))
    (hf : ChapterA.Section04.IsFaithfulSignalizerType L)
    (hq : IsQuasisimple (L ⧸ pCore 2 L))
    (hn : ¬ (T : Subgroup G) ≤ normalizer (L : Set G)) :
    ∃ E : FundamentalSetup KnownSimple.IsKnownSimple T L, E.IsMinimalFullModule ∧
      (elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (E.moduleSubgroup : Set G) ∨
        let H := localJoin T L
        let U := E.moduleSubgroup.subgroupOf H
        let := (E.module_reduced (source_module_nonsolvable_uniqueness E)).normal
        let := (E.module_reduced (source_module_nonsolvable_uniqueness E)).elementary
        let ρ := ChapterB.InternalThompsonAction.action U
        Nonempty (ChapterB.SourceInduction.SourceTwoFactorCase
          (ρ.comp (Representation.BinaryOffender.offenderSubgroup ρ).subtype))) := by
  obtain ⟨E, hE⟩ := FundamentalSetup.exists_minimal_fullModule_of_source hG hL hf hq
  refine ⟨E, hE, ?_⟩
  by_cases hJ : elementaryAbelianMaxJ (T : Subgroup G) ≤
      centralizer (E.moduleSubgroup : Set G)
  · exact Or.inl hJ
  · exact Or.inr (local_module_two_factor_case E hn hJ)



/-- Select a minimal source setup and classify its actual full action in
all moving-local-Thompson cases. The classified actor is precisely the
original L₀ image, and crossed centralization holds on the full module.
The centralizing-local-Thompson and natural-row recognition branches are
not asserted by this theorem. -/
theorem exists_minimal_full_module_classification
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (hL : L ∈ Chapter1.LStar G (T : Subgroup G))
    (hf : ChapterA.Section04.IsFaithfulSignalizerType L)
    (hq : IsQuasisimple (L ⧸ pCore 2 L))
    (hn : ¬ (T : Subgroup G) ≤ normalizer (L : Set G))
    (hna : ¬ Nonempty ((L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 5))) :
    ∃ E : FundamentalSetup KnownSimple.IsKnownSimple T L, E.IsMinimalFullModule ∧
      (elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (E.moduleSubgroup : Set G) ∨
        ((∀ t ∈ (T : Subgroup G), t ∉ normalizer (L : Set G) →
          (⁅E.fullModule,L⁆).map (MulAut.conj t).toMonoidHom ≤ centralizer (L : Set G)) ∧
        let M := E.maximalLocal
        let U := E.fullModule.subgroupOf M
        let := (source_full_module_reduced E).normal
        let := (source_full_module_reduced E).elementary
        let q := ChapterB.InternalThompsonAction.actionMk U
        let ρ := ChapterB.InternalThompsonAction.action U
        Nonempty (ChapterB.SourceInduction.SourceTwoFactorCase
          (ρ.comp (((localOrbit T L).subgroupOf M).map q).subtype)))) := by
  obtain ⟨E,hE⟩ := FundamentalSetup.exists_minimal_fullModule_of_source hG hL hf hq
  refine ⟨E,hE,?_⟩
  by_cases hJ : elementaryAbelianMaxJ (T : Subgroup G) ≤
      centralizer (E.moduleSubgroup : Set G)
  · exact Or.inl hJ
  · exact Or.inr ⟨fun _ ht htn => crossed_of_local_thompson E hJ ht htn,
      full_module_two_factor_case_on_orbit E hn hna hJ⟩

/-- The fixed-support row for a genuine binary rank-one component with
moving local Thompson subgroup. This discharges that branch of
`FixedSupportRowsAt` on the original module and exchanger. -/
theorem fixed_support_row_of_binary_component
