    {F : Type*} [Field F] [Finite F] [CharP F 2]
    (e : (L ⧸ pCore 2 L) ≃* Matrix.SpecialLinearGroup (Fin 2) F) :
    ∃ t ∈ (T : Subgroup G), t ∉ normalizer (L : Set G) ∧
