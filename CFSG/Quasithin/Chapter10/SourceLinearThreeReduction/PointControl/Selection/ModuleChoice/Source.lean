open ChapterE Chapter8.Section03 in
/-- The binary tensor row is impossible on the original full module. A
nonidentity T-fixed point and a cubic Sylow subgroup are chosen internally.
The original Borel and H-star, strict-r bound, point-core containment and
W₂ centralization are all proved from this same tensor marking. Recognition
of that marking from the general quiet-module hypotheses remains separate. -/
theorem tensor_coordinates_impossible
    (D : FundamentalSetup KnownSimple.IsKnownSimple T L)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hmin : D.IsMinimalFullModule)
    (hn : ¬ (T : Subgroup G) ≤ normalizer (L : Set G))
    (hJ : elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (D.moduleSubgroup : Set G))
    (cL : (L ⧸ pCore 2 L) ≃* Matrix.PSL3Two.SL)
    : let := D.fullModule_elementary (source_module_nonsolvable_uniqueness D)
      ∀ (e : Additive D.fullModule ≃ₗ[ZMod 2] BinaryTensorThree.Space),
        ((localOrbit T L).subgroupOf (localJoin T L)).map
          (quietTensorLinearAction D e) = BinaryTensorThree.baseAction.range → False := by
  dsimp only
  intro e hbase
  have hV : D.fullModule ≠ ⊥ := by
    intro hh
    exact D.module_ne_bot (bot_unique ((le_componentOrbit D.moduleSubgroup D.maximalLocal).trans_eq hh))
  have hfixed := inf_centerIn_ne_bot T.isPGroup' hV
    (D.fullModule_le_sylow (source_module_nonsolvable_uniqueness D))
    ((le_normalizer_componentOrbit L T).trans D.maximalLocal_normalizes_fullModule)
  obtain ⟨z,hz,hz1⟩ := (D.fullModule ⊓ centerIn (T : Subgroup G)).bot_or_exists_ne_one.resolve_left hfixed
  have hzT : (T : Subgroup G) ≤ centralizer ({z} : Set G) :=
    fun t ht => mem_centralizer_singleton_iff.mpr (hz.2.2 t ht)
  let d : CentralizerSetup G := ⟨T,localOrbit T L,z⟩
  let P : Sylow 3 d.X := Classical.choice inferInstance
  obtain ⟨_,hstar,hgen,_,hB,_⟩ :=
    tensor_point_borel_and_hstar D hmany hmin hn hJ cL hz.1 hz1 hzT e hbase P
  have hBN : d.X ≤ normalizer (((T : Subgroup G) ⊓ d.Kz : Subgroup G) : Set G) := by
    apply le_trans ?_ (show ChapterF.Source.borel d.Kz (T : Subgroup G) ≤ _ from inf_le_right)
    rw [hB]
    exact le_sup_left
  have hW := (tensor_weakClosure_two_of_tensor_coordinates D hmany hmin hn hJ cL
    hz.1 hz1 hzT e hbase P).2
  exact hstar.1.2 (quiet_tensor_point_generation_endpoint D hn e hbase hz.1 hz1 hzT hBN hgen hW)

/-- In the quiet binary-three branch the original seed is proper in the full
module. If they coincided, the genuine exchanged quotient action and the
original cubic bound would construct the tensor coordinates and literal base
image excluded above. No tensor recognition premise remains in this branch. -/
theorem quiet_binaryThree_seed_ne_full
    (D : FundamentalSetup KnownSimple.IsKnownSimple T L)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hmin : D.IsMinimalFullModule)
    (hn : ¬ (T : Subgroup G) ≤ normalizer (L : Set G))
    (hJ : elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (D.moduleSubgroup : Set G))
    (cL : (L ⧸ pCore 2 L) ≃* Matrix.PSL3Two.SL) : D.seed ≠ D.fullModule := by
  intro hseed
  obtain ⟨t,ht,htn,_,_⟩ := source_nonnormal_pair D.simpleQTKE D.maximal.1 hn
  let := D.fullModule_elementary (source_module_nonsolvable_uniqueness D)
  obtain ⟨e,hbase⟩ := quiet_binaryThree_seed_eq_full_tensor_coordinates
    D hmany hmin hn hJ cL hseed ht htn
  exact tensor_coordinates_impossible D hmany hmin hn hJ cL e hbase

open CentralHall.Nonlinear.Modules Representation.BinaryOffender.NaturalTensor in
/-- The quiet binary-three branch supplies the original point selection, or
a proper, explicitly marked tensor seed. In the latter branch every full-action
element of displacement at most eight preserves that same seed, while some
element of the original maximal normalizer moves it with displacement at least
nine. The remaining ambient exclusion must rule out this second branch. -/
theorem quiet_binaryThree_support_or_proper_seed
    (D : FundamentalSetup KnownSimple.IsKnownSimple T L)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hmin : D.IsMinimalFullModule)
    (hn : ¬ (T : Subgroup G) ≤ normalizer (L : Set G))
    (hJ : elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (D.moduleSubgroup : Set G))
    (cL : (L ⧸ pCore 2 L) ≃* Matrix.PSL3Two.SL)
    {t : G} (ht : t ∈ (T : Subgroup G)) (htn : t ∉ normalizer (L : Set G)) :
    let := D.fullModule_elementary (source_module_nonsolvable_uniqueness D)
    (⁅D.fullModule ⊓ centralizer
        (L.map (MulAut.conj t).toMonoidHom : Set G),L⁆ ≠ ⊥ ∧
      (⁅D.fullModule,L⁆).map (MulAut.conj t).toMonoidHom ≤ centralizer (L : Set G) ∧
      PointSylowControl D t) ∨
    (D.seed < D.fullModule ∧ QuietBinaryThreeSeedMarking D cL ht ∧
      (∀ m : D.maximalLocal, operatorFixedCodim (originalFullAction D m) < 9 →
        (m : G) ∈ normalizer (D.seed : Set G)) ∧
      ∃ m : D.maximalLocal, (m : G) ∉ normalizer (D.seed : Set G) ∧
        9 ≤ operatorFixedCodim (originalFullAction D m)) := by
  dsimp only
  let := D.fullModule_elementary (source_module_nonsolvable_uniqueness D)
  by_cases hfix : D.fullModule ⊓ centralizer (L : Set G) = ⊥
  · right
    have hs := quiet_binaryThree_seed_ne_full D hmany hmin hn hJ cL
    have hle : D.seed ≤ D.fullModule :=
      (le_componentOrbit D.seed T).trans (le_componentOrbit _ _)
    have hstable : ∀ m : D.maximalLocal,
        operatorFixedCodim (originalFullAction D m) < 9 →
          (m : G) ∈ normalizer (D.seed : Set G) :=
      quiet_binaryThree_seed_stable_of_displacement_lt_nine D hmany hn hJ cL hfix
    have hmove : ¬ D.maximalLocal ≤ normalizer (D.seed : Set G) := by
      intro hc
      apply hs
      apply le_antisymm hle
      rw [D.fullModule_eq_seed_orbit]
      exact iSup_conjugates_le_of_le_normalizer D.seed D.maximalLocal D.seed le_rfl hc
    obtain ⟨m,hm,hmn⟩ := SetLike.not_le_iff_exists.mp hmove
    exact ⟨lt_of_le_of_ne hle hs,
      quiet_binaryThree_seed_marking_of_no_component_fixed D hmany hn hJ cL hfix ht htn,
      hstable,⟨m,hm⟩,hmn,le_of_not_gt (fun hh => hmn (hstable ⟨m,hm⟩ hh))⟩
  · left
    have hs := quiet_fixed_support_of_component_fixed_ne_bot D hmany hJ ht htn hfix
    have hc := crossed_of_minimal_fixed_support D hmin ht htn hs
    have hd : 3 ∣ Nat.card (L ⧸ pCore 2 L) := by
      rw [Nat.card_congr cL.toEquiv,Matrix.PSL3Two.card_SL]
      decide
    have hfull := full_thompson_centralizes_of_local_three D hn hd hJ
    exact ⟨hs,hc,pointSylowControl_of_thompson_centralizes D hmany ht htn hc hfull⟩


/-- In the remaining proper-seed branch the source supplies a genuine
starred cubic actor on the full module, with rank at most four and fixed
codimension at most eight. Its entire original preimage preserves the same
marked seed. Thus actor faithfulness and stability are no longer inputs to
the remaining tensor-constituent exclusion. -/
theorem quiet_binaryThree_support_or_stable_proper_seed
    (D : FundamentalSetup KnownSimple.IsKnownSimple T L)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hmin : D.IsMinimalFullModule)
    (hn : ¬ (T : Subgroup G) ≤ normalizer (L : Set G))
    (hJ : elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (D.moduleSubgroup : Set G))
    (cL : (L ⧸ pCore 2 L) ≃* Matrix.PSL3Two.SL)
    {t : G} (ht : t ∈ (T : Subgroup G)) (htn : t ∉ normalizer (L : Set G)) :
    let := D.fullModule_elementary (source_module_nonsolvable_uniqueness D)
    let U := D.fullModule.subgroupOf D.maximalLocal
    let := (source_full_module_reduced D).normal
    let := (source_full_module_reduced D).elementary
    let q := ChapterB.InternalThompsonAction.actionMk U
    let ρ := ChapterB.InternalThompsonAction.action U
    (⁅D.fullModule ⊓ centralizer
        (L.map (MulAut.conj t).toMonoidHom : Set G),L⁆ ≠ ⊥ ∧
      (⁅D.fullModule,L⁆).map (MulAut.conj t).toMonoidHom ≤ centralizer (L : Set G) ∧
