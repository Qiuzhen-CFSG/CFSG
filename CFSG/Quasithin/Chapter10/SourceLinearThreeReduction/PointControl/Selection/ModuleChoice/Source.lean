open Chapter8.Section03 Chapter1 Chapter1.XiEmbedding Representation Representation.BinaryOffender in
/-- The faithful action of the literal K_z image on the original U/⟨z⟩
is the direct sum of two natural SL₂(4) modules. Best-offender generation,
faithfulness on the whole square, both natural intertwiners and vanishing
of the fixed kernel are derived. The original full action kernel, Sylow
image, two-conjugate span and individual-cubic obstruction are retained. -/
theorem tensor_point_eight_space_natural_decomposition
    (D : FundamentalSetup KnownSimple.IsKnownSimple T L)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hmin : D.IsMinimalFullModule)
    (hn : ¬ (T : Subgroup G) ≤ normalizer (L : Set G))
    (hJ : elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (D.moduleSubgroup : Set G))
    (cL : (L ⧸ pCore 2 L) ≃* Matrix.PSL3Two.SL)
    {z : G} (hzV : z ∈ D.fullModule) (hz1 : z ≠ 1)
    (hzT : (T : Subgroup G) ≤ centralizer ({z} : Set G))
    (hcore : ¬ D.fullModule ≤ (centralizer ({z} : Set G)).pCoreIn 2) :
    let := D.fullModule_elementary (source_module_nonsolvable_uniqueness D)
    ∀ (e : Additive D.fullModule ≃ₗ[ZMod 2] BinaryTensorThree.Space),
      ((localOrbit T L).subgroupOf (localJoin T L)).map
        (quietTensorLinearAction D e) = BinaryTensorThree.baseAction.range →
      ∀ _P : Sylow 3 (CentralizerSetup.X ⟨T,localOrbit T L,z⟩),
    ∃ (q : localJoin T L →* BinaryTensorThree.PointParabolic.Actor)
      (b : Additive D.fullModule ≃ₗ[ZMod 2] BinaryTensorThree.Space)
      (hq : Function.Surjective q)
      (hb : ∀ (a : localJoin T L) (v : Additive D.fullModule),
        quietTensorLinearAction D b a (b v) =
          BinaryTensorThree.action (BinaryTensorThree.PointParabolic.tensorHom (q a)) (b v))
      (hpoint : b (Additive.ofMul ⟨z,hzV⟩) = BinaryTensorThree.point),
      let s := quietTensorPointFlagSetup D b z
      let hs := quiet_tensor_point_flag_hypothesis D q hq b hb hzV hpoint hzT hz1
      let : ((zpowers z).subgroupOf s.U).Normal :=
        normal_subgroupOf_of_le_normalizer (hs.U_le_H.trans hs.H_le)
      let := quiet_tensor_point_closure_quotient_elementary D q hq b hb hzV hpoint hzT hz1
      let π := QuotientGroup.mk' (pCore 2 s.H)
      let A := (D.fullModule.subgroupOf s.H).map π
      let N := ((CentralizerSetup.Kz ⟨T,localOrbit T L,z⟩).subgroupOf s.H).map π
      ∃ k : CentralizerSetup.Kz ⟨T,localOrbit T L,z⟩,
        s.U = quietTensorFive D b ⊔ (quietTensorFive D b).conjBy k ∧
      ∃ (σ : Representation (ZMod 2) (s.H ⧸ pCore 2 s.H)
          (Additive (s.U ⧸ (zpowers z).subgroupOf s.U)))
        (c : Representation.BinaryConjugationSection s.H s.U (zpowers z) (σ.comp π)),
      let τ : Representation (ZMod 2) N (Additive (s.U ⧸ (zpowers z).subgroupOf s.U)) := σ.comp N.subtype;
        (∀ u : s.U, (c.coordinates u).toAdd =
          Additive.ofMul (QuotientGroup.mk' ((zpowers z).subgroupOf s.U) u)) ∧
        (σ.comp π).ker.map s.H.subtype = commutatorPreimage s.H s.U (zpowers z) ∧
        Nat.card A = 16 ∧ IsSylowIn 2 A N ∧
        Nonempty (N ≃* (alternatingGroup (Fin 5) × alternatingGroup (Fin 5))) ∧
        IsOffender σ A ∧ IsOffender σ.dual A ∧ IsQuadratic σ A ∧
        Function.Injective τ ∧
        offenderSubgroup τ = ⊤ ∧
        Module.finrank (ZMod 2) (Additive (s.U ⧸ (zpowers z).subgroupOf s.U)) = 8 ∧
        Nonempty (ChapterB.SourceInduction.AlternatingFiveSquare.NaturalEightDecomposition τ) ∧
        ∀ a : CentralizerSetup.XT ⟨T,localOrbit T L,z⟩, (a:G)^3 = 1 →
          let hVH := (D.fullModule_le_sylow (source_module_nonsolvable_uniqueness D)).trans hzT
          let haH := (sup_le ((CentralizerSetup.X_le ⟨T,localOrbit T L,z⟩).trans inf_le_right) hzT) a.property
          (∃ v : D.fullModule, π ⟨v,hVH v.property⟩ ≠ 1 ∧
            π ⟨a,haH⟩ * π ⟨v,hVH v.property⟩ = π ⟨v,hVH v.property⟩ * π ⟨a,haH⟩) ∨
          (∃ v : quietTensorFive D b,
            c.coordinates ⟨v,le_conjugateSpanBy _ _ v.property⟩ ≠ 1 ∧
            σ (π ⟨a,haH⟩) (c.coordinates ⟨v,le_conjugateSpanBy _ _ v.property⟩).toAdd =
              (c.coordinates ⟨v,le_conjugateSpanBy _ _ v.property⟩).toAdd) := by
  dsimp only
  intro e hbase P
  let d : CentralizerSetup G := ⟨T,localOrbit T L,z⟩
  obtain ⟨q,b,hq,hb,hpoint,hdata⟩ :=
    tensor_point_eight_space_cubic_obstruction D hmany hmin hn hJ cL hzV hz1 hzT hcore e hbase P
  refine ⟨q,b,hq,hb,hpoint,?_⟩
  have hs := quiet_tensor_point_flag_hypothesis D q hq b hb hzV hpoint hzT hz1
  let s := quietTensorPointFlagSetup D b z
  let : ((zpowers z).subgroupOf s.U).Normal :=
    normal_subgroupOf_of_le_normalizer (hs.U_le_H.trans hs.H_le)
  let := quiet_tensor_point_closure_quotient_elementary D q hq b hb hzV hpoint hzT hz1
  obtain ⟨k,htwo,hdim,σ,c,hc,_hspan,_hcomm,_hquad,_h5,hA,_hAB,_hAN,hoff,hoffdual,hquadA,hcubic⟩ := hdata
  have hcard := quiet_tensor_point_closure_card_le D q hq b hb hzV hpoint hzT hz1 k htwo
  obtain ⟨_,hSylow,kgen,hgen⟩ :=
    tensor_point_sylow_offender_reduction D hmany hmin hn hJ cL hzV hz1 hzT hcore e hbase P
  obtain ⟨_,K,hK,_,hQ,hclosure,hcomm,hplane,hswap,hm⟩ :=
    tensor_point_factor_and_swapped_five_models D hmany hmin hn hJ cL hzV hz1 hzT e hbase P
  have hswapInput := quiet_tensor_five_swapped_input D hn e hbase hzV hz1 hzT P
    hK hQ hclosure hcomm hplane hswap hm
  obtain ⟨eK⟩ := quiet_tensor_swapped_five_square hswapInput hm
  have eK' : Nonempty ((d.Kz ⧸ pCore 2 d.Kz) ≃*
      (alternatingGroup (Fin 5) × alternatingGroup (Fin 5))) := hclosure.symm ▸ ⟨eK⟩
  obtain ⟨eK'⟩ := eK'
  let : (d.Kz.subgroupOf s.H).Normal :=
    normal_subgroupOf_of_le_normalizer (le_normalizer_conjugateSpanBy d.X d.Gz)
  let i := subgroupOfEquivOfLe d.Kz_le_Gz
  let eN := (coreQuotientEquivImage 2 (d.Kz.subgroupOf s.H)).symm.trans
    ((QuotientGroup.congr _ _ i (pCore_map_iso 2 i)).trans eK')
  obtain ⟨hf,hg,hclass⟩ := quiet_tensor_point_square_classification D q hq b hb hzV hpoint hzT hz1
    hcore σ c hcard kgen hgen eN hSylow
  obtain ⟨m,hzero,hdim',hsplit,hm₁,hm₂,F₁,F₂,hF₁,hF₂,hn₁,hn₂⟩ :=
    ChapterB.SourceInduction.AlternatingFiveSquare.natural_eight eN hclass hdim
  exact ⟨k,htwo,σ,c,hc,c.action_kernel_map hs.H_le,hA,hSylow,⟨eN⟩,hoff,hoffdual,hquadA,
    hf,hg,hdim',⟨⟨m,hzero,hdim',hsplit,hm₁,hm₂,F₁,F₂,hF₁,hF₂,hn₁,hn₂⟩⟩,hcubic⟩


open Chapter8.Section03 Chapter1 Chapter1.XiEmbedding in
/-- Original 8.3.12 on the marked full tensor module. The actual cubic plane
maps faithfully through the whole point two-core. Its diagonal cubic is
fixed-point-free on the original closure quotient and centralizes no
nonidentity element of the original V-image. H.4.12(1) excludes both
fixed-vector alternatives, proving containment in the full point two-core. -/
theorem tensor_point_core
    (D : FundamentalSetup KnownSimple.IsKnownSimple T L)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hmin : D.IsMinimalFullModule)
    (hn : ¬ (T : Subgroup G) ≤ normalizer (L : Set G))
    (hJ : elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (D.moduleSubgroup : Set G))
    (cL : (L ⧸ pCore 2 L) ≃* Matrix.PSL3Two.SL)
    {z : G} (hzV : z ∈ D.fullModule) (hz1 : z ≠ 1)
    (hzT : (T : Subgroup G) ≤ centralizer ({z} : Set G)) :
    let := D.fullModule_elementary (source_module_nonsolvable_uniqueness D)
    ∀ (e : Additive D.fullModule ≃ₗ[ZMod 2] BinaryTensorThree.Space),
      ((localOrbit T L).subgroupOf (localJoin T L)).map
        (quietTensorLinearAction D e) = BinaryTensorThree.baseAction.range →
      ∀ _P : Sylow 3 (CentralizerSetup.X ⟨T,localOrbit T L,z⟩),
      D.fullModule ≤ (centralizer ({z} : Set G)).pCoreIn 2 := by
  dsimp only
  intro e hbase P
  by_contra hcore
  let d : CentralizerSetup G := ⟨T,localOrbit T L,z⟩
  obtain ⟨q,b,hq,hb,hpoint,hdata⟩ :=
    tensor_point_eight_space_natural_decomposition D hmany hmin hn hJ cL hzV hz1 hzT hcore e hbase P
  have hs := quiet_tensor_point_flag_hypothesis D q hq b hb hzV hpoint hzT hz1
  let s := quietTensorPointFlagSetup D b z
  let : ((zpowers z).subgroupOf s.U).Normal :=
    normal_subgroupOf_of_le_normalizer (hs.U_le_H.trans hs.H_le)
  let := quiet_tensor_point_closure_quotient_elementary D q hq b hb hzV hpoint hzT hz1
  obtain ⟨_,_,σ,c,_,_,_,hSylow,_,_,_,_,_,_,_,⟨m⟩,_⟩ := hdata
  obtain ⟨_,_,_,_,_,_,_,⟨eP⟩,_,_⟩ :=
    tensor_point_factor_and_swapped_five_models D hmany hmin hn hJ cL hzV hz1 hzT e hbase P
  have hAN : (D.fullModule.subgroupOf s.H).map (QuotientGroup.mk' (pCore 2 s.H)) ≤
      (d.Kz.subgroupOf s.H).map (QuotientGroup.mk' (pCore 2 s.H)) := by
    obtain ⟨S,hS⟩ := hSylow
    rw [←hS]
    exact map_subtype_le _
  exact quiet_tensor_point_diagonal_contradiction D q hq b hb hzV hpoint hzT hz1 hcore σ c
    ((P : Subgroup d.X).map d.X.subtype) (map_subtype_le _) eP hAN m

