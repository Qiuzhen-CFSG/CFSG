  have hm := rankOneNatural_of_binary_component D hn hna hJ e
  obtain ⟨t,ht,htn,_,_⟩ := source_nonnormal_pair D.simpleQTKE D.maximal.1 hn
  exact ⟨t,ht,htn,fixed_support_moved_of_crossed D ht htn
    (crossed_of_local_thompson D hJ ht htn),full_eq_local_of_rankOneNatural D hn hm,hm⟩

