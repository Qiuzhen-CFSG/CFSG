module
public import CFSG.Quasithin.Chapter10.SourceLinearThreeReduction.PointControl.Selection.ModuleChoice.QuietTensorPointFaithful
public import Theory.Representation.BinaryOffender.NormalRestriction
public import Theory.Representation.BinaryOffender.SylowFaithful
public import Theory.GroupTheory.PPrimeCoreReduction

/-!
# Classification on the literal point square

The best-offender subgroup of the restricted K_z action has normal image
in the full point quotient. It meets the original V-image nontrivially;
upper-layer irreducibility then puts the whole V-image inside. The two
original generating conjugates give best-offender generation of the square.
Its trivial odd core and the already faithful Sylow actor kill the full
restricted action kernel. The original point centralizer supplies the SQTK
cover, so complete B.5 applies to this actual square on U/⟨z⟩.

The Source consumer supplies the square marking and the original Sylow and
generation results, and applies the natural-eight-space comparison.
Source: Aschbacher--Smith B.5.3--6 and 8.3.12, printed pp.103--105,726,
refs/quasithin.pdf.
-/

public noncomputable section


open scoped commutatorElement
set_option backward.isDefEq.respectTransparency false
open Subgroup Theory.GroupTheory Representation.BinaryOffender
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter10.PointControl.Selection.ModuleChoice
open Chapter3.Section02 Chapter8.Section03 Chapter1 BinaryTensorThree
universe u
variable {G : Type u} [_root_.Group G] [Finite G] {T : Sylow 2 G} {L : Subgroup G}
  (D : FundamentalSetup KnownSimple.IsKnownSimple T L)
local instance : IsElementaryAbelian 2 D.fullModule :=
  D.fullModule_elementary (source_module_nonsolvable_uniqueness D)
variable (q : localJoin T L →* PointParabolic.Actor) (hq : Function.Surjective q)
  (b : Additive D.fullModule ≃ₗ[ZMod 2] Space)
  (hb : ∀ (a : localJoin T L) (v : Additive D.fullModule),
    quietTensorLinearAction D b a (b v) = action (PointParabolic.tensorHom (q a)) (b v))
  {z : G} (hzV : z ∈ D.fullModule)
  (hbz : b (Additive.ofMul ⟨z,hzV⟩) = point)
  (hzT : (T : Subgroup G) ≤ centralizer ({z} : Set G)) (hz1 : z ≠ 1)


include hq hb hbz hzT hz1 in
/-- Upper irreducibility promotes a nontrivial intersection with the original
V-image to containment of that whole image in a normal subgroup. -/
theorem quiet_tensor_point_normal_contains_image
    (J : Subgroup ((quietTensorPointFlagSetup D b z).H ⧸
      pCore 2 (quietTensorPointFlagSetup D b z).H)) [J.Normal]
    (hne : let s := quietTensorPointFlagSetup D b z
      let A := (D.fullModule.subgroupOf s.H).map (QuotientGroup.mk' (pCore 2 s.H))
      A ⊓ J ≠ ⊥) :
    (D.fullModule.subgroupOf (quietTensorPointFlagSetup D b z).H).map
      (QuotientGroup.mk' (pCore 2 (quietTensorPointFlagSetup D b z).H)) ≤ J := by
  let d : CentralizerSetup G := ⟨T,localOrbit T L,z⟩
  let s := quietTensorPointFlagSetup D b z
  let π := QuotientGroup.mk' (pCore 2 s.H)
  let N := (J.comap π).map s.H.subtype
  let E := D.fullModule ⊓ N
  have hs := quiet_tensor_point_flag_hypothesis D q hq b hb hzV hbz hzT hz1
  have h5Q : quietTensorFive D b ≤ s.H.pCoreIn 2 :=
    (le_conjugateSpanBy _ _).trans hs.U_le_core
  have hQN : s.H.pCoreIn 2 ≤ N := by
    rintro _ ⟨a,ha,rfl⟩
    refine ⟨a,?_,rfl⟩
    change π a ∈ J
    rw [show π a = 1 from (QuotientGroup.eq_one_iff a).mpr ha]
    exact J.one_mem
  have h5E : quietTensorFive D b ≤ E := le_inf (quietTensorFive_le D b) (h5Q.trans hQN)
  have hXT := quiet_XT_eq_point_centralizer (T := T) (L := L) hzT
  have hXN : d.XT ≤ normalizer (N : Set G) := by
    apply (sup_le (d.X_le.trans inf_le_right) hzT).trans
    change s.H ≤ normalizer (N : Set G)
    simpa only [N,normalizer_eq_top,←MonoidHom.range_eq_map,range_subtype]
      using (J.comap π).le_normalizer_map s.H.subtype
  have hVN : d.XT ≤ normalizer (D.fullModule : Set G) :=
    (hXT.le.trans inf_le_left).trans
      ((sup_le (localOrbit T L).le_normalizer (le_normalizer_componentOrbit L T)).trans
        D.maximalLocal_normalizes_fullModule)
  have hEN : d.XT ≤ normalizer (E : Set G) :=
    (le_inf hVN hXN).trans inf_normalizer_le_normalizer_inf
  rcases quiet_tensor_point_upper_irreducible D q hq b hb hzV hbz hzT
      E h5E inf_le_left hEN with he | he
  · apply (hne ?_).elim
    apply bot_unique
    rintro a ⟨⟨v,hv,rfl⟩,ha⟩
    have hvE : (v:G) ∈ E := ⟨hv,⟨v,ha,rfl⟩⟩
    obtain ⟨w,hw,hwv⟩ := h5Q (he ▸ hvE)
    have hwv' : w = v := Subtype.ext hwv
    exact (QuotientGroup.eq_one_iff v).mpr (hwv' ▸ hw)
  · rintro a ⟨v,hv,rfl⟩
    have hvE : (v:G) ∈ E := he.symm ▸ hv
    obtain ⟨w,hw,hwv⟩ := hvE.2
    have hwv' : w = v := Subtype.ext hwv
    exact hwv' ▸ hw

include hq hb hbz hzT hz1 in
/-- The original square action is generated by best offenders, before
passing to any faithful image. -/
theorem quiet_tensor_point_square_offender_generated
    (hcore : ¬ D.fullModule ≤ (centralizer ({z} : Set G)).pCoreIn 2)
    {W : Type u} [AddCommGroup W] [Module (ZMod 2) W]
    (σ : Representation (ZMod 2)
      ((quietTensorPointFlagSetup D b z).H ⧸ pCore 2 (quietTensorPointFlagSetup D b z).H) W)
    (c : Representation.BinaryConjugationSection (quietTensorPointFlagSetup D b z).H
      (quietTensorPointFlagSetup D b z).U (zpowers z)
      (σ.comp (QuotientGroup.mk' (pCore 2 (quietTensorPointFlagSetup D b z).H))))
    (hc : Nat.card (quietTensorPointFlagSetup D b z).U ≤ 512)
    (k : CentralizerSetup.Kz ⟨T,localOrbit T L,z⟩)
    (hgen : let d : CentralizerSetup G := ⟨T,localOrbit T L,z⟩
      let π := QuotientGroup.mk' (pCore 2 d.Gz)
      let A := (D.fullModule.subgroupOf d.Gz).map π
      A ⊔ A.map (MulAut.conj (π (inclusion d.Kz_le_Gz k))).toMonoidHom =
        (d.Kz.subgroupOf d.Gz).map π) :
    let d : CentralizerSetup G := ⟨T,localOrbit T L,z⟩
    let N := (d.Kz.subgroupOf d.Gz).map (QuotientGroup.mk' (pCore 2 d.Gz))
    offenderSubgroup (σ.comp N.subtype) = ⊤ := by
  dsimp only
  let d : CentralizerSetup G := ⟨T,localOrbit T L,z⟩
  let s := quietTensorPointFlagSetup D b z
  let π := QuotientGroup.mk' (pCore 2 s.H)
  let A := (D.fullModule.subgroupOf s.H).map π
  let N := (d.Kz.subgroupOf s.H).map π
  let : (d.Kz.subgroupOf s.H).Normal :=
    normal_subgroupOf_of_le_normalizer (le_normalizer_conjugateSpanBy d.X d.Gz)
  let : N.Normal := (inferInstance : (d.Kz.subgroupOf s.H).Normal).map π
    (QuotientGroup.mk'_surjective _)
  let τ := σ.comp N.subtype
  let J := (offenderSubgroup τ).map N.subtype
  let : J.Normal := normal_restriction_offender_image σ N
  let : Finite W := Finite.of_surjective (fun u : s.U => (c.coordinates u).toAdd)
    (Multiplicative.toAdd.surjective.comp c.onto)
  change A ⊔ A.map (MulAut.conj (π (inclusion d.Kz_le_Gz k))).toMonoidHom = N at hgen
  have hAN : A ≤ N := hgen ▸ le_sup_left
  have hoff := (quiet_tensor_point_full_offender D q hq b hb hzV hbz hzT hz1 hcore σ c hc).subgroupOf σ hAN
  obtain ⟨B,hBA,hbest⟩ := hoff.exists_bestOffender τ
  have hBJ : B.map N.subtype ≤ J := map_mono (hbest.le_offenderSubgroup τ)
  have hAB : B.map N.subtype ≤ A := by
    rintro _ ⟨x,hx,rfl⟩
    exact hBA hx
  have hmeet : A ⊓ J ≠ ⊥ := by
    intro he
    have hh : B.map N.subtype = ⊥ := bot_unique ((le_inf hAB hBJ).trans_eq he)
    exact hbest.1.1 ((map_eq_bot_iff_of_injective _ N.subtype_injective).mp hh)
  have hAJ := quiet_tensor_point_normal_contains_image D q hq b hb hzV hbz hzT hz1 J hmeet
  have hNJ : N ≤ J := by
    rw [←hgen]
    refine sup_le hAJ ?_
    rintro _ ⟨a,ha,rfl⟩
    exact (inferInstance : J.Normal).conj_mem a (hAJ ha) _
  apply top_unique
  intro x _
  obtain ⟨y,hy,he⟩ := hNJ x.property
  exact (N.subtype_injective he) ▸ hy


private theorem five_square_oddCore {N : Type*} [Group N] [Finite N]
    (e : N ≃* (alternatingGroup (Fin 5) × alternatingGroup (Fin 5))) :
    pPrimeCore 2 N = ⊥ := by
  have ho : pPrimeCore 2 (alternatingGroup (Fin 5)) = ⊥ := by
    let : IsSimpleGroup (alternatingGroup (Fin 5)) := alternatingGroup.isSimpleGroup (by simp)
    rcases (inferInstance : (pPrimeCore 2 (alternatingGroup (Fin 5))).Normal).eq_bot_or_eq_top with h | h
    · exact h
    · have hc := pPrimeCore_coprime_card (p := 2) (G := alternatingGroup (Fin 5))
      rw [h,Nat.card_congr Subgroup.topEquiv.toEquiv,nat_card_alternatingGroup] at hc
      norm_num [Nat.factorial] at hc
  exact pPrimeCore_eq_bot_of_equiv e (pPrimeCore_prod_eq_bot ho ho)

include hq hb hbz hzT hz1 in
/-- B.5 classifies the literal original square on the same point section.
Sylow faithfulness kills its full kernel; upper irreducibility supplies its
best-offender generation. The SQTK cover is the actual point centralizer. -/
theorem quiet_tensor_point_square_classification
    (hcore : ¬ D.fullModule ≤ (centralizer ({z} : Set G)).pCoreIn 2)
    {W : Type u} [AddCommGroup W] [Module (ZMod 2) W]
    (σ : Representation (ZMod 2)
      ((quietTensorPointFlagSetup D b z).H ⧸ pCore 2 (quietTensorPointFlagSetup D b z).H) W)
    (c : Representation.BinaryConjugationSection (quietTensorPointFlagSetup D b z).H
      (quietTensorPointFlagSetup D b z).U (zpowers z)
      (σ.comp (QuotientGroup.mk' (pCore 2 (quietTensorPointFlagSetup D b z).H))))
    (hc : Nat.card (quietTensorPointFlagSetup D b z).U ≤ 512)
    (k : CentralizerSetup.Kz ⟨T,localOrbit T L,z⟩)
    (hgen : let d : CentralizerSetup G := ⟨T,localOrbit T L,z⟩
      let π := QuotientGroup.mk' (pCore 2 d.Gz)
      let A := (D.fullModule.subgroupOf d.Gz).map π
      A ⊔ A.map (MulAut.conj (π (inclusion d.Kz_le_Gz k))).toMonoidHom =
        (d.Kz.subgroupOf d.Gz).map π)
    (e : let d : CentralizerSetup G := ⟨T,localOrbit T L,z⟩
      ((d.Kz.subgroupOf d.Gz).map (QuotientGroup.mk' (pCore 2 d.Gz))) ≃*
        (alternatingGroup (Fin 5) × alternatingGroup (Fin 5)))
    (hSylow : let d : CentralizerSetup G := ⟨T,localOrbit T L,z⟩
      let π := QuotientGroup.mk' (pCore 2 d.Gz)
      IsSylowIn 2 ((D.fullModule.subgroupOf d.Gz).map π) ((d.Kz.subgroupOf d.Gz).map π)) :
    let d : CentralizerSetup G := ⟨T,localOrbit T L,z⟩
    let N := (d.Kz.subgroupOf d.Gz).map (QuotientGroup.mk' (pCore 2 d.Gz))
    Function.Injective (σ.comp N.subtype) ∧
      offenderSubgroup (σ.comp N.subtype) = ⊤ ∧
      ChapterB.SourceInduction.NontrivialAdequateAlternative (σ.comp N.subtype) := by
  dsimp only
  let d : CentralizerSetup G := ⟨T,localOrbit T L,z⟩
  let s := quietTensorPointFlagSetup D b z
  let π := QuotientGroup.mk' (pCore 2 s.H)
  let N := (d.Kz.subgroupOf s.H).map π
  let τ := σ.comp N.subtype
  let : (d.Kz.subgroupOf s.H).Normal :=
    normal_subgroupOf_of_le_normalizer (le_normalizer_conjugateSpanBy d.X d.Gz)
  let : N.Normal := (inferInstance : (d.Kz.subgroupOf s.H).Normal).map π
    (QuotientGroup.mk'_surjective _)
  let : Finite W := Finite.of_surjective (fun u : s.U => (c.coordinates u).toAdd)
    (Multiplicative.toAdd.surjective.comp c.onto)
  obtain ⟨S,hS⟩ := hSylow
  have hfA := quiet_tensor_point_offender_faithful D q hq b hb hzV hbz hzT hz1 σ c k hgen
  have hf : Function.Injective τ := faithful_of_sylow_two τ S (five_square_oddCore e) (by
    intro a ha hfix
    apply Subtype.ext
    apply hfA a
    · exact hS ▸ mem_map_of_mem N.subtype ha
    · exact hfix)
  have hg := quiet_tensor_point_square_offender_generated D q hq b hb hzV hbz hzT hz1 hcore σ c hc k hgen
  have hsq : IsSQTK KnownSimple.IsKnownSimple s.H := D.simpleQTKE.twoLocal_sqtk
    (isTwoLocal_involution_centralizer (orderOf_eq_prime
      (elemPow_eq_one_of_isElementaryAbelian z hzV) hz1))
  let cover : ChapterB.SourceInduction.SQTKQuotient KnownSimple.IsKnownSimple (s.H ⧸ pCore 2 s.H) := {
    Cover := s.H
    kernel := pCore 2 s.H
    sqtk := hsq
    equiv := MulEquiv.refl _ }
  let : Nontrivial N := e.symm.injective.nontrivial
  refine ⟨hf,hg,ChapterB.SourceInduction.nontrivialAdequateAlternative_knownSimple τ ?_⟩
  exact {
    finite_module := inferInstance
    faithful := hf
    twoCore := normal_subgroup_twoCore_eq_bot N (pCore_quotient_pCore_eq_bot 2)
    generated := hg
    quotient := ⟨cover.subgroup N⟩ }

end CFSG.Quasithin.Chapter10.PointControl.Selection.ModuleChoice
