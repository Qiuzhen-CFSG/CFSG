module
public import CFSG.Quasithin.Chapter10.SourceA5PointSelectedModels
public import CFSG.Quasithin.Chapter10.SourceA5PointSylow.Completion
public import CFSG.Quasithin.Chapter10.SourceA5PointFFModels.Sieve
public import CFSG.Quasithin.Chapter10.SourceA5PointLocalImage
public import CFSG.Quasithin.Chapter10.SourceA5PointFixedKernel.FixedSpan

/-!
# Model selection at every nonzero partner point

The actual partner vector lies in the full module and centralizes the original
component. Full point-Sylow saturation gives the original Thompson equality,
so the six-way source model theorem needs no separate equality or fixed-kernel
exclusion. Source: Aschbacher–Smith 10.2.9, printed pp.750–753.
-/

@[expose] public noncomputable section
open Subgroup Theory.GroupTheory Stellmacher Representation Representation.BinaryOffender
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter10
open Chapter3.Section02 ChapterB.InternalThompsonAction
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L : Subgroup G}
  (D : FundamentalSetup KnownSimple.IsKnownSimple T L)
local instance : IsElementaryAbelian 2 (⁅D.fullModule,L⁆ : Subgroup G) :=
  source_original_full_moved_elementary D

/-- The actual constrained point actor is quasisimple, is generated by its
commutators with the actual Thompson image, and acts on the literal reduced
orbit module through a faithful FF action. -/
theorem source_a5_point_six_way_models_of_partner
    (e : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 5))
    (hi : (originalMovedQuotientAction D e).IsIrreducible)
    (hn : ¬ (T : Subgroup G) ≤ normalizer (L : Set G))
    {t v : G} (ht : t ∈ (T : Subgroup G))
    (hcross : (⁅D.fullModule,L⁆).map (MulAut.conj t).toMonoidHom ≤ centralizer (L : Set G))
    (hv : v ∈ (⁅D.fullModule,L⁆).map (MulAut.conj t).toMonoidHom) (hvne : v ≠ 1)
    (I : Subgroup G) (hLI : L ≤ I) (hIX : I ≤ centralizer ({v} : Set G))
    (hI : (I.subgroupOf (centralizer ({v} : Set G))).IsCComponent)
    (hNI : centralizer ({v} : Set G) ≤ normalizer (I : Set G))
    (hnot : ¬ IsQuasisimple I) (hout : ¬ I ≤ D.maximalLocal)
    (hCW : centralizer (↑(⁅D.fullModule,L⁆ : Subgroup G) : Set G) ≤ D.maximalLocal)
    (hs : Chapter1.IsSylowIn 2 ((T : Subgroup G) ⊓ centralizer ({v} : Set G))
      (centralizer ({v} : Set G))) :
    let S := (T : Subgroup G) ⊓ centralizer ({v} : Set G)
    let H := I ⊔ S
    let U := (conjugateSpanBy (⁅D.fullModule,L⁆ ⊓ centralizer (S : Set G)) I).subgroupOf H
    ∃ hr : IsPReduced 2 U, letI := hr.normal; letI := hr.elementary
      let A := (I.subgroupOf H).map (actionMk U)
      let N := offenderSubgroup (action U)
      ∃ _hAN : A ≤ N,
      ∃ h : ChapterB.SourceInduction.ProjectiveLine.QuasisimpleSourceConclusion
        ((action U).comp N.subtype) (A.subgroupOf N),
        SourceA5PointFFModels.SixWay ((action U).comp N.subtype) (A.subgroupOf N)
          h.sectionData := by
  have hWV : ⁅D.fullModule,L⁆ ≤ D.fullModule := le_normalizer_iff_commutator_le_left.mp
    (((le_componentOrbit L T).trans (localOrbit T L).le_normalizer).trans
      D.maximalLocal_normalizes_fullModule)
  have hmapV : D.fullModule.map (MulAut.conj t).toMonoidHom = D.fullModule :=
    mem_normalizer_iff_map_conj_eq.mp (D.maximalLocal_normalizes_fullModule
      (le_normalizer_componentOrbit L T ht))
  have hvV : v ∈ D.fullModule := hmapV ▸ map_mono hWV hv
  have hJ := source_a5_partner_thompson_eq_of_irreducible D e hi ht hv
    (hs.restrict (le_inf (inf_le_left.trans (le_normalizer_componentOrbit L T)) inf_le_right)
      inf_le_right)
  exact source_a5_point_six_way_models D e hi hn ht hcross hvV hvne (hcross hv)
    I hLI hIX hI hNI hnot hout hCW hs hJ
end CFSG.Quasithin.Chapter10
