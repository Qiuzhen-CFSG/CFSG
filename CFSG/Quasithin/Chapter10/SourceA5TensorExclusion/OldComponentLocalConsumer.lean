module
public import CFSG.Quasithin.Chapter10.SourceA5TensorExclusion.OldComponentLocal
public import CFSG.Quasithin.Chapter10.SourceA5TensorExclusion.OvergroupComponent

/-!
# Tensor overgroup generated by the literal old residual

The actual tensor line and plane discharge the geometric core-centralization
premise in the pair theorem. The central involution supplies the old local
family's nontrivial core, while the old Sylow supplement supplies escape.
Only the original residual quotient, source 9.3.2 Sylow clause, and remaining
Cartan/action inputs are retained.

Source: Aschbacher–Smith 9.3.4–6, printed pp.733–734.
-/

public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter10.SourceA5TensorModel
open Chapter3.Section02
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L : Subgroup G}
  {D : FundamentalSetup KnownSimple.IsKnownSimple T L}
  {e : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 5)}

theorem old_residual_component_product (m : SourceA5TensorModel D e)
    (hn : ¬ (T : Subgroup G) ≤ normalizer (L : Set G))
    {H : Subgroup G} (hH : H ∈ Chapter3.HStar (T : Subgroup G) D.maximalLocal)
    (eK : ((pResidual 2 H).map H.subtype ⧸
      pCore 2 ((pResidual 2 H).map H.subtype)) ≃* alternatingGroup (Fin 5))
    (hSyl : Chapter1.IsSylowIn 2 ((T : Subgroup G) ⊓ normalizer (L : Set G))
      ((pResidual 2 H).map H.subtype ⊔ ((T : Subgroup G) ⊓ normalizer (L : Set G))))
    (M₀ : Subgroup G) (hMcore : pCore 2 M₀ ≠ ⊥)
    (hgen : M₀ = (L ⊔ (pResidual 2 H).map H.subtype) ⊔
      ((T : Subgroup G) ⊓ normalizer (L : Set G)))
    (hKU : (pResidual 2 H).map H.subtype ≤ centralizer (m.tensorLine : Set G))
    (hmove : ¬ (pResidual 2 H).map H.subtype ≤ centralizer (m.tensorPlane : Set G)) :
    (pResidual 2 M₀).IsCComponent ∧
      L.subgroupOf M₀ ≤ pResidual 2 M₀ ∧
      ((pResidual 2 H).map H.subtype).subgroupOf M₀ ≤ pResidual 2 M₀ ∧
      ∀ g : M₀, ∃ k ∈ pResidual 2 M₀,
        ∃ r ∈ (((T : Subgroup G) ⊓ normalizer (L : Set G)).subgroupOf M₀), k * r = g := by
  have hK := m.old_residual_mem_local_at_stabilizer hn hH eK hSyl
  have hKM := source_hstar_residual_not_le (le_normalizer_componentOrbit L T) hH
  have hout : ¬ M₀ ≤ D.maximalLocal := by
    intro hm
    exact hKM ((hgen ▸ (show (pResidual 2 H).map H.subtype ≤
      (L ⊔ (pResidual 2 H).map H.subtype) ⊔
        ((T : Subgroup G) ⊓ normalizer (L : Set G)) from
      le_sup_of_le_left le_sup_right)).trans hm)
  exact source_a5_tensor_pair_component_product D e hn M₀
    ((pResidual 2 H).map H.subtype) m.tensorLine hMcore hgen hout hK
    m.component_core_centralizes_tensorPlane hKU hmove

end CFSG.Quasithin.Chapter10.SourceA5TensorModel
