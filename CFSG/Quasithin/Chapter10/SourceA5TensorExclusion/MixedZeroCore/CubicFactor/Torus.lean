module
public import CFSG.Quasithin.Chapter10.SourceA5TensorExclusion.MixedZeroCore.CubicFactor.LineCharacter
public import CFSG.Quasithin.Chapter10.SourceA5TensorExclusion.SourceOldResidualCartanTwoCore.Tensor
public import CFSG.Quasithin.Chapter10.SourceA5TensorExclusion.SourceOldResidualCartanPermutability
public import Theory.Representation.CoprimeElementaryComplement

/-!
# The two invariant cubic directions in the actual Cartan quotient

The Borel normalizer is generated by the original Cartan and the common
Sylow. The proved tensor two-core equality kills the latter, leaving a
normal elementary abelian group of order nine in (A∨T)/O₂(A∨T).
Its line-character kernel is the image of the original Hall cubic.
Coprime action of the original Sylow constructs a complementary cubic,
and generation proves that complement normal in the entire quotient.

These are the actual quotient subgroups used to construct the second
permutation character, without assuming a field–swap element or a marking.
Final source assembly stays with qt-d-tensor-mixed-zero-core.
Source: Aschbacher–Smith, original 9.3.1–2, printed pp.732–733.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter10.SourceA5TensorModel
open Chapter3.Section02
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L : Subgroup G}
  {D : FundamentalSetup KnownSimple.IsKnownSimple T L}
  {e : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 5)}
  (m : SourceA5TensorModel D e)

/-- The literal quotient by the two-core of the Cartan--Sylow join. -/
abbrev CartanTwoCoreQuotient (A : Subgroup G) :=
  (A ⊔ (T : Subgroup G) : Subgroup G) ⧸ pCore 2 (A ⊔ (T : Subgroup G) : Subgroup G)

@[expose] def cartanTwoCoreMap (A : Subgroup G) :
    (A ⊔ (T : Subgroup G) : Subgroup G) →* CartanTwoCoreQuotient (T := T) A :=
  QuotientGroup.mk' _

@[expose] def cartanQuotientTorus (A : Subgroup G) : Subgroup (CartanTwoCoreQuotient (T := T) A) :=
  (A.subgroupOf (A ⊔ (T : Subgroup G))).map (cartanTwoCoreMap A)

@[expose] def cartanQuotientHall (A B : Subgroup G) : Subgroup (CartanTwoCoreQuotient (T := T) A) :=
  (B.subgroupOf (A ⊔ (T : Subgroup G))).map (cartanTwoCoreMap A)

omit m [Finite G] in
/-- Quotienting by the actual two-core is faithful on the cubic torus. -/
theorem cartanTwoCoreMap_injective_on_cartan (A : Subgroup G) (hA9 : Nat.card A = 9) :
    Function.Injective ((cartanTwoCoreMap (T := T) A).comp
      (inclusion (show A ≤ A ⊔ (T : Subgroup G) from le_sup_left))) := by
  let P := A ⊔ (T : Subgroup G)
  let q := cartanTwoCoreMap (T := T) A
  have hker : IsPGroup 2 q.ker := by
    change IsPGroup 2 (QuotientGroup.mk' (pCore 2 P)).ker
    rw [QuotientGroup.ker_mk']
    exact pCore_isPGroup
  have hA : IsPGroup 3 A := IsPGroup.of_card (n := 2) hA9
  exact (Theory.AlternatingFive.injective_on_three_subgroup q hker (A.subgroupOf P)
    hA.comap_subtype).comp (subgroupOfEquivOfLe (show A ≤ P from le_sup_left)).symm.injective

omit m [Finite G] in
/-- The original order-nine torus keeps its order in this precise quotient. -/
theorem card_cartanQuotientTorus (A : Subgroup G) (hA9 : Nat.card A = 9) :
    Nat.card (cartanQuotientTorus (T := T) A) = 9 := by
  let f := (cartanTwoCoreMap (T := T) A).comp
    (inclusion (show A ≤ A ⊔ (T : Subgroup G) from le_sup_left))
  have hr : f.range = cartanQuotientTorus (T := T) A := by
    rw [MonoidHom.range_comp,inclusion_range]
    rfl
  rw [←hr,← Nat.card_congr (MonoidHom.ofInjective
    (cartanTwoCoreMap_injective_on_cartan A hA9)).toEquiv]
  exact hA9

omit m [Finite G] in
/-- The image torus inherits the original elementary abelian structure. -/
theorem cartanQuotientTorus_elementary (A : Subgroup G) (hAe : IsElementaryAbelian 3 A) :
    IsElementaryAbelian 3 (cartanQuotientTorus (T := T) A) := by
  let := hAe
  let : IsElementaryAbelian 3 (A.subgroupOf (A ⊔ (T : Subgroup G))) :=
    IsElementaryAbelian.of_injective (subgroupOfEquivOfLe
      (show A ≤ A ⊔ (T : Subgroup G) from le_sup_left)).toMonoidHom
      (subgroupOfEquivOfLe (show A ≤ A ⊔ (T : Subgroup G) from le_sup_left)).injective
  exact IsElementaryAbelian.map (cartanTwoCoreMap A)

include m in
/-- The Borel normalizer becomes the order-nine torus after quotienting by
O₂(AT), hence that torus is normal in the whole quotient. -/
theorem cartanQuotientTorus_normal (A : Subgroup G)
    (hAB : A ≤ sourceOrbitBorel T L) (hA9 : Nat.card A = 9) :
    (cartanQuotientTorus (T := T) A).Normal := by
  let P := A ⊔ (T : Subgroup G)
  let R := localOrbit T L
  let U := (T : Subgroup G) ⊓ R
  let N := sourceOrbitSylowNormalizer T L
  let q := cartanTwoCoreMap (T := T) A
  have hTR : (T : Subgroup G) ≤ normalizer (R : Set G) := le_normalizer_componentOrbit L T
  have hTU : (T : Subgroup G) ≤ normalizer (U : Set G) :=
    (le_inf (T : Subgroup G).le_normalizer hTR).trans inf_normalizer_le_normalizer_inf
  have hTN : (T : Subgroup G) ≤ normalizer (N : Set G) :=
    (le_inf hTR (hTU.trans (normalizer (U : Set G)).le_normalizer)).trans
      inf_normalizer_le_normalizer_inf
  have hAN : A ≤ N := hAB.trans (map_subtype_le _)
  have hPN : P ≤ normalizer (N : Set G) := sup_le (hAN.trans N.le_normalizer) hTN
  have hUP : U ≤ P := inf_le_left.trans le_sup_right
  have hNP : N ≤ P := by
    change sourceOrbitSylowNormalizer T L ≤ P
    rw [m.cartan_orbit_sylow_normalizer_eq_sup A hAB hA9]
    exact sup_le hUP le_sup_left
  let : (N.subgroupOf P).Normal := (normal_subgroupOf_iff_le_normalizer hNP).mpr hPN
  have hUcore : U ≤ P.pCoreIn 2 := by
    rw [m.source_tensor_cartan_twoCore A hAB hA9]
    exact le_sup_left
  have hUmap : (U.subgroupOf P).map q = ⊥ := by
    apply (Subgroup.map_eq_bot_iff _).mpr
    intro u hu
    apply (QuotientGroup.eq_one_iff _).mpr
    obtain ⟨v,hv,he⟩ := hUcore hu
    have he' : v = u := Subtype.ext he
    exact he' ▸ hv
  have he : (N.subgroupOf P).map q = cartanQuotientTorus (T := T) A := by
    change ((sourceOrbitSylowNormalizer T L).subgroupOf P).map q = _
    rw [m.cartan_orbit_sylow_normalizer_eq_sup A hAB hA9,
      subgroupOf_sup hUP le_sup_left,Subgroup.map_sup,hUmap,bot_sup_eq]
    rfl
  rw [←he]
  exact (inferInstance : (N.subgroupOf P).Normal).map q (QuotientGroup.mk'_surjective _)

omit m [Finite G] in
/-- The Hall cubic also survives injectively through the actual two-core. -/
theorem card_cartanQuotientHall (A B : Subgroup G) (hBA : B ≤ A) (hB3 : Nat.card B = 3) :
    Nat.card (cartanQuotientHall (T := T) A B) = 3 := by
  let P := A ⊔ (T : Subgroup G)
  let q := cartanTwoCoreMap (T := T) A
  have hBP : B ≤ P := hBA.trans le_sup_left
  let f := q.comp (inclusion hBP)
  have hker : IsPGroup 2 q.ker := by
    change IsPGroup 2 (QuotientGroup.mk' (pCore 2 P)).ker
    rw [QuotientGroup.ker_mk']
    exact pCore_isPGroup
  have hB : IsPGroup 3 B := IsPGroup.of_card (n := 1) hB3
  have hi : Function.Injective f :=
    (Theory.AlternatingFive.injective_on_three_subgroup q hker (B.subgroupOf P)
      hB.comap_subtype).comp (subgroupOfEquivOfLe hBP).symm.injective
  have hr : f.range = cartanQuotientHall (T := T) A B := by
    rw [MonoidHom.range_comp,inclusion_range]
    rfl
  rw [←hr,←Nat.card_congr (MonoidHom.ofInjective hi).toEquiv]
  exact hB3

/-- The Hall cubic is exactly the intersection of the normal image torus
with the kernel of the descended first character. -/
theorem cartanQuotientHall_eq_inf_line_kernel (A B : Subgroup G)
    (hAB : A ≤ sourceOrbitBorel T L) (hBA : B ≤ A)
    (hBC : B = A ⊓ centralizer (m.tensorLine : Set G))
    (q : CartanTwoCoreQuotient (T := T) A →* Equiv.Perm (Fin 3))
    (hq : q.comp (cartanTwoCoreMap A) = m.tensorLineCubicCharacter A hAB) :
    cartanQuotientHall (T := T) A B = cartanQuotientTorus A ⊓ q.ker := by
  have hvalue (a : (A ⊔ (T : Subgroup G) : Subgroup G)) :
      q (cartanTwoCoreMap A a) = m.tensorLineCubicCharacter A hAB a :=
    DFunLike.congr_fun hq a
  apply le_antisymm
  · rintro x ⟨b,hb,rfl⟩
    refine ⟨⟨b,hBA hb,rfl⟩,?_⟩
    change q (cartanTwoCoreMap A b) = 1
    rw [hvalue,m.tensorLineCubicCharacter_eq_one_iff]
    exact (hBC ▸ hb).2
  · rintro x ⟨⟨a,ha,rfl⟩,hx⟩
    refine ⟨a,?_,rfl⟩
    change (a : G) ∈ B
    rw [hBC]
    refine ⟨ha,?_⟩
    apply (m.tensorLineCubicCharacter_eq_one_iff A hAB a).mp
    rw [←hvalue]
    exact hx

/-- Line movement makes the original Hall cubic a normal cubic in the
actual Cartan quotient. This is the invariant direction for the second character. -/
theorem cartanQuotientHall_normal
    {H : Subgroup G} (hH : H ∈ Chapter3.HStar (T : Subgroup G) D.maximalLocal)
    (A B : Subgroup G) (hAB : A ≤ sourceOrbitBorel T L) (hA9 : Nat.card A = 9)
    (hBA : B ≤ A) (hB3 : Nat.card B = 3)
    (hBC : B = A ⊓ centralizer (m.tensorLine : Set G))
    (hmove : ¬ (pResidual 2 H).map H.subtype ≤ centralizer (m.tensorLine : Set G)) :
    (cartanQuotientHall (T := T) A B).Normal := by
  obtain ⟨q,_,hq,_⟩ := m.exists_tensorLine_quotient_character hH A B hAB hA9 hBA hB3 hBC hmove
  let := m.cartanQuotientTorus_normal A hAB hA9
  rw [m.cartanQuotientHall_eq_inf_line_kernel A B hAB hBA hBC q hq]
  infer_instance

omit m [Finite G] in
/-- The original Sylow and the image torus generate the whole two-core quotient. -/
theorem cartanQuotientTorus_sup_sylow (A : Subgroup G) :
    cartanQuotientTorus (T := T) A ⊔
      ((T : Subgroup G).subgroupOf (A ⊔ (T : Subgroup G))).map (cartanTwoCoreMap A) = ⊤ := by
  change (A.subgroupOf (A ⊔ (T : Subgroup G))).map (cartanTwoCoreMap A) ⊔ _ = _
  rw [←Subgroup.map_sup,←subgroupOf_sup le_sup_left le_sup_right,subgroupOf_self,
    ←MonoidHom.range_eq_map]
  exact MonoidHom.range_eq_top.mpr (QuotientGroup.mk'_surjective _)

/-- The source Hall cubic has a complementary cubic invariant under the full
Cartan quotient. It is constructed by coprime action on the actual image torus. -/
theorem exists_normal_complementary_cartan_cubic
    {H : Subgroup G} (hH : H ∈ Chapter3.HStar (T : Subgroup G) D.maximalLocal)
    (A B : Subgroup G) (hAB : A ≤ sourceOrbitBorel T L) (hA9 : Nat.card A = 9)
    (hAe : IsElementaryAbelian 3 A) (hBA : B ≤ A) (hB3 : Nat.card B = 3)
    (hBC : B = A ⊓ centralizer (m.tensorLine : Set G))
    (hmove : ¬ (pResidual 2 H).map H.subtype ≤ centralizer (m.tensorLine : Set G)) :
    ∃ C : Subgroup (CartanTwoCoreQuotient (T := T) A), C.Normal ∧ Nat.card C = 3 ∧
      Disjoint (cartanQuotientHall A B) C ∧
      cartanQuotientHall A B ⊔ C = cartanQuotientTorus A := by
  let Q := CartanTwoCoreQuotient (T := T) A
  let E := cartanQuotientTorus (T := T) A
  let B' := cartanQuotientHall (T := T) A B
  let := m.cartanQuotientTorus_normal A hAB hA9
  let := m.cartanQuotientHall_normal hH A B hAB hA9 hBA hB3 hBC hmove
  let := cartanQuotientTorus_elementary (T := T) A hAe
  have hBE : B' ≤ E := map_mono (show B.subgroupOf (A ⊔ (T : Subgroup G)) ≤
      A.subgroupOf (A ⊔ (T : Subgroup G)) from fun _ hb => hBA hb)
  let i : T →* Q := (cartanTwoCoreMap A).comp
    (inclusion (show (T : Subgroup G) ≤ A ⊔ (T : Subgroup G) from le_sup_right))
  let α : T →* MulAut E := (MulAut.conjNormal : Q →* MulAut E).comp i
  have hcop : Nat.Coprime 3 (Nat.card T) := by
    obtain ⟨n,hn⟩ := T.isPGroup'.exists_card_eq
    rw [hn]
    exact (by decide : Nat.Coprime 3 2).pow_right n
  have hstable : ∀ t : T, ∀ b ∈ B'.subgroupOf E, α t b ∈ B'.subgroupOf E := by
    intro t b hb
    exact (inferInstance : B'.Normal).conj_mem b hb (i t)
  obtain ⟨W,hW,hstableW⟩ := IsElementaryAbelian.exists_invariant_complement α hcop
    (B'.subgroupOf E) hstable
  let C := W.map E.subtype
  have hCE : C ≤ E := map_subtype_le _
  have hB'3 : Nat.card (B'.subgroupOf E) = 3 :=
    (Nat.card_congr (subgroupOfEquivOfLe hBE).toEquiv).trans (card_cartanQuotientHall A B hBA hB3)
  have hW3 : Nat.card W = 3 := by
    have hh := card_mul_eq_card_inf_mul_card_sup_of_normalizes (B'.subgroupOf E) W
      (by rw [normalizer_eq_top]; exact le_top)
    rw [hW.inf_eq_bot,hW.sup_eq_top,card_bot,card_top,one_mul,hB'3,
      card_cartanQuotientTorus A hA9] at hh
    omega
  have hBCgen : B' ⊔ C = E := by
    have hh := congrArg (map E.subtype) hW.sup_eq_top
    rwa [Subgroup.map_sup,map_subgroupOf_eq_of_le hBE,
      ←MonoidHom.range_eq_map,range_subtype] at hh
  have hd : Disjoint B' C := by
    apply disjoint_def.mpr
    rintro x hx ⟨w,hw,rfl⟩
    have he : w = 1 := disjoint_def.mp hW.disjoint hx hw
    exact congrArg Subtype.val he
  have hEN : E ≤ normalizer (C : Set Q) := by
    intro a ha
    apply Subgroup.centralizer_le_normalizer
    intro c hc
    have he := mul_comm (⟨a,ha⟩ : E) (⟨c,hCE hc⟩ : E)
    exact congrArg Subtype.val he.symm
  have hTN : ((T : Subgroup G).subgroupOf (A ⊔ (T : Subgroup G))).map
      (cartanTwoCoreMap A) ≤ normalizer (C : Set Q) := by
    rintro x ⟨t,ht,rfl⟩
    apply mem_normalizer_iff_map_conj_eq.mpr
    apply eq_of_le_of_card_ge
    · rintro y ⟨c,⟨w,hw,rfl⟩,rfl⟩
      exact ⟨α ⟨t,ht⟩ w,hstableW ⟨t,ht⟩ w hw,rfl⟩
    · exact (card_map_of_injective (K := C)
        (f := (MulAut.conj (cartanTwoCoreMap A t)).toMonoidHom)
        (MulAut.conj (cartanTwoCoreMap A t)).injective).ge
  have hCN : C.Normal := by
    apply normalizer_eq_top_iff.mp
    apply top_unique
    rw [←cartanQuotientTorus_sup_sylow (T := T) A]
    exact sup_le hEN hTN
  exact ⟨C,hCN,(card_map_of_injective E.subtype_injective).trans hW3,hd,hBCgen⟩

end CFSG.Quasithin.Chapter10.SourceA5TensorModel
