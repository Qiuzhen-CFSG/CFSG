module
public import CFSG.Quasithin.Chapter10.SourceA5TensorExclusion.SourceOldResidualLineFFImage
public import Theory.GroupTheory.CComponent.NormalImage
/-!
# The original action-image contradiction in 9.3.1

The source overgroup is generated by the old residual K, the prescribed
Sylow subgroup P and the Cartan A. The Sylow already normalizes K.
Consequently, if A's image on the Omega orbit normalizes K's image,
that image is normal in the whole action group. A nonsolvable subgroup
with normal image fills the image of its containing C-component; this
contradicts the proper local A₅ image proved from the same source data.

No lift of an image normalizer through the action kernel is required.
The final theorem keeps the original K, P, A and Omega orbit throughout.

Source: Aschbacher--Smith, Proposition 9.3.1, printed pp.732--733.
-/

public noncomputable section
open Subgroup Theory.GroupTheory Stellmacher
namespace CFSG.Quasithin.Chapter10.SourceOldResidualLineFF
variable {X Y : Type*} [Group X] [Finite X] [Group Y]
/-- A normalizing image of the final generator would make a proper local
image normal in its containing C-component. -/
theorem image_normalization_false (f : X →* Y) (hf : Function.Surjective f)
    (J K P A : Subgroup X) (hJ : J.IsCComponent) (hKJ : K ≤ J)
    (hK : ¬ Group.IsSolvable K) (hgen : (K ⊔ P) ⊔ A = ⊤)
    (hPN : P ≤ normalizer (K : Set X))
    (hproper : K.map f ≠ J.map f)
    (hAN : A.map f ≤ normalizer (K.map f : Set Y)) : False := by
  have hn : (⊤ : Subgroup Y) ≤ normalizer (K.map f : Set Y) := by
    rw [← map_top_of_surjective f hf,←hgen,Subgroup.map_sup,Subgroup.map_sup]
    exact sup_le (sup_le (K.map f).le_normalizer
      ((map_mono hPN).trans (le_normalizer_map f))) hAN
  let : (K.map f).Normal := normalizer_eq_top_iff.mp (top_unique hn)
  exact hproper (cComponent_map_eq_of_normal_image J K hJ hKJ hK f).symm
end CFSG.Quasithin.Chapter10.SourceOldResidualLineFF
namespace CFSG.Quasithin.Chapter10.SourceA5TensorModel
open Chapter3.Section02 ChapterC.MSCentralOrbit ChapterB.InternalThompsonAction
open Representation Representation.BinaryOffender ChapterA.Section03
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L : Subgroup G}
  {D : FundamentalSetup KnownSimple.IsKnownSimple T L}
  {e : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 5)}
  (m : SourceA5TensorModel D e)

/-- In the original nonzero-core line branch, normalization on the actual
Omega-orbit action already gives the source contradiction. -/
theorem nonzero_core_cartan_image_normalization_false
    {H : Subgroup G} (hH : H ∈ Chapter3.HStar (T : Subgroup G) D.maximalLocal)
    (eK : ((pResidual 2 H).map H.subtype ⧸
      pCore 2 ((pResidual 2 H).map H.subtype)) ≃* alternatingGroup (Fin 5))
    (A B : Subgroup G) (hAB : A ≤ sourceOrbitBorel T L)
    (hA9 : Nat.card A = 9) (hAe : IsElementaryAbelian 3 A)
    (hB3 : Nat.card B = 3) (hBC : B = A ⊓ centralizer (m.tensorLine : Set G))
    (hcore : pCore 2 (H ⊔ A : Subgroup G) ≠ ⊥)
    (hmove : ¬ (pResidual 2 H).map H.subtype ≤ centralizer (m.tensorLine : Set G))
    (hAN : let X : Subgroup G := H ⊔ A
      let P := T.subtype ((show (T : Subgroup G) ≤ H from hH.1.1.2).trans
        (show H ≤ X from le_sup_left))
      let K := ((pResidual 2 H).map H.subtype).subgroupOf X
      let W := omegaOrbit (P : Subgroup X)
      (A.subgroupOf X).map (actionMk W) ≤ normalizer (K.map (actionMk W) : Set (ActionQuotient W))) :
    False := by
  let X : Subgroup G := H ⊔ A
  let K0 := (pResidual 2 H).map H.subtype
  have hTX : (T : Subgroup G) ≤ X :=
    (show (T : Subgroup G) ≤ H from hH.1.1.2).trans le_sup_left
  have hKX : K0 ≤ X := (map_subtype_le _).trans le_sup_left
  let P := T.subtype hTX
  let K := K0.subgroupOf X
  let W := omegaOrbit (P : Subgroup X)
  obtain ⟨_,_,J,hJ,hnJ,hKJ,_,hr,_,_,_,hp,_⟩ :=
    m.nonzero_core_cartan_original_data hH eK A B hAB hA9 hAe hB3 hBC hcore hmove
  let := hr.normal
  let q := actionMk W
  have hproper : K.map q ≠ J.map q := by
    intro he
    exact hp.ne (by rw [he,subgroupOf_self])
  let : Group.IsPerfect K0 := Chapter1.mem_L_isPerfect (source_hstar_residual_mem_local_of_a5 hH eK)
  let : Group.IsPerfect K := Group.IsPerfect.ofSurjective
    (f := (subgroupOfEquivOfLe hKX).symm.toMonoidHom) (subgroupOfEquivOfLe hKX).symm.surjective
  have hKne : K ≠ ⊥ := by
    intro hz
    have h0 : K0 = ⊥ := by
      have hh := congrArg (map X.subtype) hz
      simpa only [K,map_subgroupOf_eq_of_le hKX,Subgroup.map_bot] using hh
    apply hmove
    change K0 ≤ _
    rw [h0]
    exact bot_le
  let : Nontrivial K := (nontrivial_iff_ne_bot K).mpr hKne
  have hPN : (P : Subgroup X) ≤ normalizer (K : Set X) := by
    intro p hp
    apply mem_normalizer_iff.mpr
    intro k
    exact mem_normalizer_iff.mp
      (le_normalizer_embedded_pResidual 2 H (hH.1.1.2 hp)) (k : G)
  have hgen : (K ⊔ (P : Subgroup X)) ⊔ A.subgroupOf X = ⊤ := by
    apply map_injective X.subtype_injective
    rw [Subgroup.map_sup,Subgroup.map_sup,map_subgroupOf_eq_of_le hKX,
      show (P : Subgroup X).map X.subtype = (T : Subgroup G) from map_subgroupOf_eq_of_le hTX,
      map_subgroupOf_eq_of_le (show A ≤ X from le_sup_right),
      source_hstar_residual_sup_sylow hH,←MonoidHom.range_eq_map,range_subtype]
  exact SourceOldResidualLineFF.image_normalization_false q (QuotientGroup.mk'_surjective _)
    J K (P : Subgroup X) (A.subgroupOf X) hJ hKJ
    (Group.IsPerfect.not_isSolvable K) hgen hPN hproper hAN
end CFSG.Quasithin.Chapter10.SourceA5TensorModel
