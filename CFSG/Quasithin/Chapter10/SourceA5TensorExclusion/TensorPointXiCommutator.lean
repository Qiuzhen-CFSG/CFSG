module

public import CFSG.Quasithin.Chapter10.SourceA5TensorExclusion.TensorPointResidual
public import CFSG.Quasithin.Chapter1.Section03.Radical.Structure.Actions.Commutator
public import CFSG.Quasithin.ChapterA.Section03.SQTKStructure.OrdinarySource.Complete
public import CFSG.Quasithin.ChapterA.Section02.SourceAssembly.Complete

/-!
# The radical commutator at the actual tensor point

The diagonal point residual has an A₅ quotient, so is nonsolvable, and its
Sylow point centralizer normalizes it. Consequently each relevant radical
factor of a containing local C-component is generated by its commutators
with this literal diagonal residual. This is the final commutator assertion
in Aschbacher–Smith 9.4.1, printed p.736.

The containing local component and its odd Fitting prime come from the
preceding point-image argument. The statement does not assume normalization
of the diagonal residual by the full point centralizer.
-/

@[expose] public section
open Subgroup Theory.GroupTheory Representation
namespace CFSG.Quasithin.Chapter10.SourceA5TensorModel
open Chapter3.Section02 ClassicalOrthogonal.FourPlusMatrix

universe u
variable {G : Type u} [Group G] [Finite G] {T : Sylow 2 G} {L : Subgroup G}
  {D : FundamentalSetup KnownSimple.IsKnownSimple T L}
  {e : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 5)}
  (m : SourceA5TensorModel D e)

/-- The actual diagonal residual at a nonsingular point is nonsolvable. -/
theorem tensorPointResidual_not_isSolvable (v : D.fullModule)
    (hv : ((m.sectionData.coordinates v).toAdd).det ≠ 0) :
    ¬ Group.IsSolvable (m.tensorPointResidual v) := by
  intro hs
  let := hs
  let f := (m.tensorPointResidualA5Equiv v hv).toMonoidHom.comp
    (QuotientGroup.mk' (pCore 2 (m.tensorPointResidual v)))
  have hf : Function.Surjective f := (m.tensorPointResidualA5Equiv v hv).surjective.comp
    (QuotientGroup.mk'_surjective _)
  let : Group.IsPerfect (alternatingGroup (Fin 5)) :=
    ⟨commutator_alternatingGroup_eq_top (by simp)⟩
  exact Group.IsPerfect.not_isSolvable (alternatingGroup (Fin 5))
    (Group.isSolvable_of_surjective (f := f) hf)

/-- The original point residual generates the radical factor by commutators,
using the actual point Sylow centralizer and containing local component. -/
theorem tensorPoint_XiP_commutator_eq
    (v : D.fullModule) (hv : ((m.sectionData.coordinates v).toAdd).det ≠ 0)
    {I : Subgroup G}
    (hlocal : I ∈ Chapter1.L G
      ((T : Subgroup G) ⊓ centralizer ({(v : G)} : Set G)))
    (hQ : IsSQTK KnownSimple.IsKnownSimple
      ((I ⊔ ((T : Subgroup G) ⊓ centralizer ({(v : G)} : Set G)) : Subgroup G) ⧸
        pCore 2 (I ⊔ ((T : Subgroup G) ⊓ centralizer ({(v : G)} : Set G)) : Subgroup G)))
    (hn : ¬ IsQuasisimple (Chapter1.XiQuotient I))
    (hRI : (T : Subgroup G) ⊓ centralizer ({(v : G)} : Set G) ≤ normalizer I)
    (hBI : m.tensorPointResidual v ≤ I)
    {p : ℕ} [Fact p.Prime] (ho : Odd p)
    (hd : p ∣ Nat.card (fittingSubgroup (Chapter1.XiQuotient I))) :
    ⁅Chapter1.XiP p I, m.tensorPointResidual v⁆ = Chapter1.XiP p I := by
  have hA36 : Chapter1.Section02.A36Input.{u} KnownSimple.IsKnownSimple :=
    ChapterA.SQTKStructure.a36Input_of_theoremsAC
      (fun X _ _ => ChapterA.Section02.theoremA_knownSimple (G := X))
      (fun X _ _ => ChapterA.Section02.theoremC_knownSimple (G := X))
  exact Chapter1.RadicalActions.XiP_commutator_eq_of_nonsolvable_subgroup_of_A36
    hA36 hlocal hQ hn hRI (m.tensorPointResidual_sylow_normalized v) hBI
    (m.tensorPointResidual_not_isSolvable v hv) ho hd

end CFSG.Quasithin.Chapter10.SourceA5TensorModel
