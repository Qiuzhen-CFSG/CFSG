module
public import CFSG.Quasithin.Chapter10.SourceA5TensorExclusion.TensorOmegaChief
public import CFSG.Quasithin.Chapter10.SourceA5HallPlacement.Torus
public import Theory.Alternating.FivePairSylowTorusProduct
public import Theory.GroupTheory.NormalSylowQuotientAction

/-!
# Permutability of the original tensor Cartan and Sylow subgroup

The order-nine Cartan A fills the quotient of N = N_{L₀}(T ∩ L₀)
by T ∩ L₀. Hence N = A(T ∩ L₀). The full Sylow subgroup T normalizes N,
so AT = NT is a subgroup and AT = TA. This uses the original tensor
section and Borel placement, before any normalization of the old residual.

The image theorem applies to the literal restricted Sylow and an arbitrary
quotient map. It supplies the product used in the PSU₃(5) containing-component
case of Proposition 9.3.1. Source: Aschbacher–Smith, Lemma 9.3.2,
printed p.733, and the preceding reduction on printed p.732.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
open scoped Pointwise
namespace CFSG.Quasithin.Chapter10.SourceA5TensorModel
open Chapter3.Section02
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L : Subgroup G}
  {D : FundamentalSetup KnownSimple.IsKnownSimple T L}
  {e : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 5)}
  (m : SourceA5TensorModel D e)
include m

/-- The source orbit normalizer is generated by its Sylow intersection
and the original order-nine Cartan. -/
theorem cartan_orbit_sylow_normalizer_eq_sup
    (A : Subgroup G) (hAB : A ≤ sourceOrbitBorel T L) (hA9 : Nat.card A = 9) :
    sourceOrbitSylowNormalizer T L = ((T : Subgroup G) ⊓ localOrbit T L) ⊔ A := by
  let R := localOrbit T L
  let N := sourceOrbitSylowNormalizer T L
  have hNR : N ≤ R := inf_le_left
  have hAN : A ≤ N := hAB.trans (map_subtype_le _)
  have hAR : A ≤ R := hAN.trans hNR
  obtain ⟨S,hS⟩ := NormalSylowQuotientAction.intersection_sylow T R
    (le_normalizer_componentOrbit L T)
  have hNsub : N.subgroupOf R = normalizer (S : Set R) := by
    change (R ⊓ normalizer ((T : Subgroup G) ⊓ R : Set G)).subgroupOf R = _
    rw [inf_subgroupOf_left]
    change (normalizer (((T : Subgroup G) ⊓ R : Subgroup G) : Set G)).subgroupOf R = _
    rw [subgroupOf_normalizer_eq (show (T : Subgroup G) ⊓ R ≤ R from inf_le_right)]
    have hh : ((T : Subgroup G) ⊓ R).subgroupOf R = (T : Subgroup G).subgroupOf R := by
      ext x
      exact ⟨fun h => h.1, fun h => ⟨h,x.property⟩⟩
    rw [hh, ← hS]
    rfl
  have hAn : A.subgroupOf R ≤ normalizer (S : Set R) := by
    rw [← hNsub]
    exact fun _ hx => hAN hx
  obtain ⟨t,ht,htn⟩ := Set.not_subset.mp m.sylow_not_normalizes_component
  obtain ⟨q,hq,hk,_⟩ := source_a5_original_product_quotient D e
    m.sylow_not_normalizes_component ht htn
  have hA : Nat.card (A.subgroupOf R) = 9 :=
    (Nat.card_congr (subgroupOfEquivOfLe hAR).toEquiv).trans hA9
  have he := Theory.AlternatingFive.pair_sylow_normalizer_eq_sup_torus_of_two_kernel
    q hq (hk ▸ pCore_isPGroup) S (A.subgroupOf R) hA hAn
  have hm := congrArg (map R.subtype) he
  rw [← hNsub, map_subgroupOf_eq_of_le hNR, Subgroup.map_sup, hS,
    subgroupOf_map_subtype, map_subgroupOf_eq_of_le hAR] at hm
  exact hm

/-- The actual order-nine Cartan and the original full Sylow subgroup permute. -/
theorem cartan_sylow_permute
    (A : Subgroup G) (hAB : A ≤ sourceOrbitBorel T L) (hA9 : Nat.card A = 9) :
    (A : Set G) * (T : Set G) = (T : Set G) * (A : Set G) := by
  let R := localOrbit T L
  let U := (T : Subgroup G) ⊓ R
  let N := sourceOrbitSylowNormalizer T L
  have hTR : (T : Subgroup G) ≤ normalizer (R : Set G) := le_normalizer_componentOrbit L T
  have hTU : (T : Subgroup G) ≤ normalizer (U : Set G) :=
    (le_inf (T : Subgroup G).le_normalizer hTR).trans inf_normalizer_le_normalizer_inf
  have hTN : (T : Subgroup G) ≤ normalizer (N : Set G) :=
    (le_inf hTR (hTU.trans (normalizer (U : Set G)).le_normalizer)).trans
      inf_normalizer_le_normalizer_inf
  have hAU : A ≤ normalizer (U : Set G) := hAB.trans ((map_subtype_le _).trans inf_le_right)
  have hN : N = U ⊔ A := m.cartan_orbit_sylow_normalizer_eq_sup A hAB hA9
  have hUT : (U : Set G) * (T : Set G) = (T : Set G) := by
    change (U : Set G) * ((T : Subgroup G) : Set G) = ((T : Subgroup G) : Set G)
    rw [← coe_mul_of_right_le_normalizer_left U (T : Subgroup G) hTU,
      sup_eq_right.mpr inf_le_left]
  have hTU' : (T : Set G) * (U : Set G) = (T : Set G) :=
    (set_mul_normalizer_comm (T : Set G) U hTU).trans hUT
  have hNA : (N : Set G) = (A : Set G) * (U : Set G) := by
    rw [hN, sup_comm, coe_mul_of_left_le_normalizer_right A U hAU]
  have hNU : (N : Set G) = (U : Set G) * (A : Set G) := by
    rw [hN, coe_mul_of_right_le_normalizer_left U A hAU]
  calc
    (A : Set G) * (T : Set G) = (N : Set G) * (T : Set G) := by
      rw [hNA, mul_assoc, hUT]
    _ = (T : Set G) * (N : Set G) := (set_mul_normalizer_comm _ _ hTN).symm
    _ = (T : Set G) * (A : Set G) := by rw [hNU, ← mul_assoc, hTU']

/-- Restriction and any subsequent quotient preserve the literal source
Cartan–Sylow product, in particular in the containing-component quotient. -/
theorem cartan_sylow_image_permute
    (A X : Subgroup G) (hAB : A ≤ sourceOrbitBorel T L) (hA9 : Nat.card A = 9)
    (hAX : A ≤ X) (hTX : (T : Subgroup G) ≤ X)
    {Y : Type*} [Group Y] (f : X →* Y) :
    ((A.subgroupOf X).map f : Set Y) *
        ((((T.subtype hTX : Sylow 2 X) : Subgroup X).map f) : Set Y) =
      ((((T.subtype hTX : Sylow 2 X) : Subgroup X).map f) : Set Y) *
        ((A.subgroupOf X).map f : Set Y) := by
  have hp := m.cartan_sylow_permute A hAB hA9
  have hr : (A.subgroupOf X : Set X) * ((T : Subgroup G).subgroupOf X : Set X) =
      ((T : Subgroup G).subgroupOf X : Set X) * (A.subgroupOf X : Set X) := by
    ext x
    constructor
    · rintro ⟨a,ha,t,ht,he⟩
      have hx : (x : G) ∈ (T : Set G) * (A : Set G) := by
        rw [← hp]
        exact ⟨a,ha,t,ht,congrArg Subtype.val he⟩
      obtain ⟨t,ht,a,ha,he⟩ := hx
      exact ⟨⟨t,hTX ht⟩,ht,⟨a,hAX ha⟩,ha,Subtype.ext he⟩
    · rintro ⟨t,ht,a,ha,he⟩
      have hx : (x : G) ∈ (A : Set G) * (T : Set G) := by
        rw [hp]
        exact ⟨t,ht,a,ha,congrArg Subtype.val he⟩
      obtain ⟨a,ha,t,ht,he⟩ := hx
      exact ⟨⟨a,hAX ha⟩,ha,⟨t,hTX ht⟩,ht,Subtype.ext he⟩
  have him := congrArg (Set.image f) hr
  simpa only [Set.image_mul, ← coe_map, Sylow.coe_subtype] using him

end CFSG.Quasithin.Chapter10.SourceA5TensorModel
