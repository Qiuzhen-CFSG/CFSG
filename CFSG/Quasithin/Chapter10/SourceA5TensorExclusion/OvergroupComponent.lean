module

public import CFSG.Quasithin.Chapter10.SourceA5TensorExclusion.OvergroupSylow
public import Theory.GroupTheory.Commutator.PerfectCoreKernel
public import Theory.GroupTheory.Commutator.ConjugateOrbitCentralizer
public import Theory.GroupTheory.PResidual.SubnormalSupplement

/-!
# The component generated by the original tensor pair

The nontrivial two-core places the outside overgroup in a maximal two-local,
so its core quotient is SQTK. Both original local factors lie in components.
If their components were distinct, their commutator would lie in a two-core;
the perfect-subgroup core lemma descends this bound to O₂(L), contradicting
the original tensor action. The common component is normal, supplements the
original stabilizer T₁ and is exactly O²(H).

The final specialization obtains the required commutator obstruction from
K centralizing V₁ but moving V₂=⟨V₁ᴸ⟩, as in source 9.3.5. The earlier
nontrivial-core and original local-family inputs remain explicit.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004,
9.3.4–6, printed pp.733–734.
-/

public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter10
open Chapter3.Section02
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L : Subgroup G}
  (D : FundamentalSetup KnownSimple.IsKnownSimple T L)

include D
private theorem overgroup_quotient_sqtk (H : Subgroup G) (hcore : pCore 2 H ≠ ⊥) :
    IsSQTK KnownSimple.IsKnownSimple (H ⧸ pCore 2 H) := by
  obtain ⟨N, hN, hHN⟩ := exists_maximalTwoLocal_overgroup_of_twoCore_ne_bot H hcore
  have hNQ := D.simpleQTKE.twoLocal_sqtk hN.1
  have hHQ : IsSQTK KnownSimple.IsKnownSimple H :=
    ⟨hNQ.stronglyQuasithin.of_injective (inclusion hHN) (inclusion_injective hHN),
      hNQ.isKGroup.of_injective (inclusion hHN) (inclusion_injective hHN)⟩
  refine ⟨?_, hHQ.isKGroup.quotient _⟩
  intro p hp ho
  let : Fact p.Prime := ⟨hp⟩
  exact (primeRank_quotient_le_of_isTwoGroup p ho _ pCore_isPGroup).trans
    (hHQ.stronglyQuasithin p hp ho)

private theorem original_local_at_stabilizer
    (hn : ¬ (T : Subgroup G) ≤ normalizer (L : Set G))
    {H : Subgroup G} (hLH : L ≤ H)
    (hRH : (T : Subgroup G) ⊓ normalizer (L : Set G) ≤ H)
    (hs : Chapter1.IsSylowIn 2 ((T : Subgroup G) ⊓ normalizer (L : Set G)) H) :
    L ∈ Chapter1.L G ((T : Subgroup G) ⊓ normalizer (L : Set G)) := by
  let R := (T : Subgroup G) ⊓ normalizer (L : Set G)
  have hVR : D.moduleSubgroup ≤ R :=
    le_inf D.module_le_sylow
      (D.module_le_orbit.trans (source_nonnormal_orbit_le_normalizer D hn))
  have hcore : D.moduleSubgroup ≤ (L ⊔ R).pCoreIn 2 :=
    le_pCoreIn_of_normalizes D.module_elementary.isPGroup
      (hVR.trans le_sup_right)
      ((sup_le ((le_componentOrbit L T).trans le_sup_left)
        (inf_le_left.trans le_sup_right)).trans D.join_normalizes_module)
  refine ⟨D.maximal.1.1.subgroupOf_of_le le_sup_left
    (sup_le le_sup_left (inf_le_left.trans le_sup_right)),
    hs.restrict le_sup_right (sup_le hLH hRH), ?_⟩
  intro he
  exact D.module_ne_bot (bot_unique (hcore.trans_eq he))

omit D in
private theorem perfect_twoPerfect {J : Type*} [Group J] [Finite J]
    [Group.IsPerfect J] : IsPPerfect 2 J := by
  intro N hN hp
  let := hN
  have hs : Subsingleton (J ⧸ N) := by
    by_contra! hn
    exact Group.IsPerfect.not_isNilpotent (J ⧸ N) hp.isNilpotent
  apply eq_top_iff.mpr
  intro g _
  exact (QuotientGroup.eq_one_iff g).mp (Subsingleton.elim _ _)

theorem source_a5_outside_pair_component_product
    (e : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 5))
    (hn : ¬ (T : Subgroup G) ≤ normalizer (L : Set G))
    (H B : Subgroup G) (hcore : pCore 2 H ≠ ⊥)
    (hgen : H = (L ⊔ B) ⊔ ((T : Subgroup G) ⊓ normalizer (L : Set G)))
    (hout : ¬ H ≤ D.maximalLocal)
    (hB : B ∈ Chapter1.L G ((T : Subgroup G) ⊓ normalizer (L : Set G)))
    (hcomm : ¬ ⁅L, B⁆ ≤ L.pCoreIn 2) :
    (pResidual 2 H).IsCComponent ∧
      L.subgroupOf H ≤ pResidual 2 H ∧ B.subgroupOf H ≤ pResidual 2 H ∧
      ∀ g : H, ∃ k ∈ pResidual 2 H,
        ∃ r ∈ (((T : Subgroup G) ⊓ normalizer (L : Set G)).subgroupOf H), k * r = g := by
  let R := (T : Subgroup G) ⊓ normalizer (L : Set G)
  have hLH : L ≤ H := hgen ▸ le_sup_of_le_left le_sup_left
  have hBH : B ≤ H := hgen ▸ le_sup_of_le_left le_sup_right
  have hRH : R ≤ H := hgen ▸ le_sup_right
  obtain ⟨P, hP⟩ := source_a5_local_outside_overgroup_sylow D e hn hcore hLH hRH hout
  have hP' : (P : Subgroup H) = R.subgroupOf H := by
    apply map_injective H.subtype_injective
    rw [hP, map_subgroupOf_eq_of_le hRH]
  have hLA : L.subgroupOf H ∈ Chapter1.L H (P : Subgroup H) := by
    rw [hP']
    exact (Chapter1.mem_LIn_iff_subgroupOf hRH hLH).mp
      ⟨hLH, original_local_at_stabilizer D hn hLH hRH ⟨P, hP⟩⟩
  have hBA : B.subgroupOf H ∈ Chapter1.L H (P : Subgroup H) := by
    rw [hP']
    exact (Chapter1.mem_LIn_iff_subgroupOf hRH hBH).mp ⟨hBH, hB⟩
  have hPN : (P : Subgroup H) ≤ normalizer (L.subgroupOf H : Set H) := by
    rw [hP', ← subgroupOf_normalizer_eq hLH]
    exact fun _ hx => hx.2
  have hQ := overgroup_quotient_sqtk D H hcore
  obtain ⟨C, ⟨hC, hLC, hnC⟩, _⟩ :=
    Chapter1.Section02.lemma_1_2_4_containment_normality_source hQ P hLA hPN
  obtain ⟨E, ⟨hE, hBE⟩, _⟩ :=
    Chapter1.Section02.lemma_1_2_4_containment_of_A_3_12
      (Chapter1.Section02.containment_of_theoremsAC
        (fun X _ _ => ChapterA.Section02.theoremA_knownSimple (G := X))
        (fun X _ _ => ChapterA.Section02.theoremC_knownSimple (G := X))) hQ P hBA
  have hEC : E = C := by
    by_contra hne
    have hc := ChapterA.Section03.CComponentCommutation.proposition_1_2_1_two
      hQ hC hE (Ne.symm hne)
    have hCN : C.pCoreIn 2 ≤ normalizer (L.subgroupOf H : Set H) :=
      (pCoreIn_le_of_subnormal 2 hC.subnormal).trans
        (pCore_isPGroup.le_sylow_of_normal P |>.trans hPN)
    let := Chapter1.mem_L_isPerfect hLA
    have hh := perfect_subgroup_core_commutator (L.subgroupOf H) C (B.subgroupOf H)
      hLC hCN ((commutator_mono le_rfl hBE).trans (hc.1.trans inf_le_left))
    have hm := map_mono (f := H.subtype) hh
    rw [map_commutator, map_subgroupOf_eq_of_le hLH, map_subgroupOf_eq_of_le hBH,
      map_pCoreIn_of_injective 2 _ H.subtype H.subtype_injective,
      map_subgroupOf_eq_of_le hLH] at hm
    exact hcomm hm
  have hBC : B.subgroupOf H ≤ C := hEC ▸ hBE
  let : C.Normal := hnC
  have hsup : C ⊔ R.subgroupOf H = ⊤ := by
    apply map_injective H.subtype_injective
    rw [Subgroup.map_sup, map_subgroupOf_eq_of_le hRH,
      ← MonoidHom.range_eq_map, range_subtype]
    apply le_antisymm (sup_le (map_subtype_le C) hRH)
    apply hgen.le.trans
    apply sup_le (sup_le ?_ ?_) le_sup_right
    · have hh := map_mono (f := H.subtype) hLC
      rw [map_subgroupOf_eq_of_le hLH] at hh
      exact hh.trans le_sup_left
    · have hh := map_mono (f := H.subtype) hBC
      rw [map_subgroupOf_eq_of_le hBH] at hh
      exact hh.trans le_sup_left
  have hprod : ∀ g : H, ∃ k ∈ C, ∃ r ∈ R.subgroupOf H, k * r = g := by
    intro g
    exact mem_sup_of_normal_left.mp (hsup ▸ (mem_top g))
  let := hC.perfect
  have hres : pResidual 2 H = C := pResidual_eq_of_subnormal_product C (R.subgroupOf H)
    hC.subnormal perfect_twoPerfect ((T.isPGroup'.to_le inf_le_left).comap_subtype) hprod
  rw [hres]
  exact ⟨hC, hLC, hBC, hprod⟩

omit D [Finite G] in
/-- Source 9.3.5: movement of V₂ contradicts commutation modulo O₂(L). -/
theorem source_tensor_pair_commutator_obstruction (B U : Subgroup G)
    (hQ : L.pCoreIn 2 ≤ centralizer (componentOrbit U L : Set G))
    (hBU : B ≤ centralizer (U : Set G))
    (hmove : ¬ B ≤ centralizer (componentOrbit U L : Set G)) :
    ¬ ⁅L, B⁆ ≤ L.pCoreIn 2 := by
  intro hc
  exact hmove (conjugateOrbit_centralizes_of_commutator_centralizes L B U _ hc hQ hBU)

/-- Original V₁/V₂ geometry discharges the common-component commutator premise. -/
theorem source_a5_tensor_pair_component_product
    (e : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 5))
    (hn : ¬ (T : Subgroup G) ≤ normalizer (L : Set G))
    (H B U : Subgroup G) (hcore : pCore 2 H ≠ ⊥)
    (hgen : H = (L ⊔ B) ⊔ ((T : Subgroup G) ⊓ normalizer (L : Set G)))
    (hout : ¬ H ≤ D.maximalLocal)
    (hB : B ∈ Chapter1.L G ((T : Subgroup G) ⊓ normalizer (L : Set G)))
    (hQ : L.pCoreIn 2 ≤ centralizer (componentOrbit U L : Set G))
    (hBU : B ≤ centralizer (U : Set G))
    (hmove : ¬ B ≤ centralizer (componentOrbit U L : Set G)) :
    (pResidual 2 H).IsCComponent ∧
      L.subgroupOf H ≤ pResidual 2 H ∧ B.subgroupOf H ≤ pResidual 2 H ∧
      ∀ g : H, ∃ k ∈ pResidual 2 H,
        ∃ r ∈ (((T : Subgroup G) ⊓ normalizer (L : Set G)).subgroupOf H), k * r = g :=
  source_a5_outside_pair_component_product D e hn H B hcore hgen hout hB
    (source_tensor_pair_commutator_obstruction B U hQ hBU hmove)

end CFSG.Quasithin.Chapter10
