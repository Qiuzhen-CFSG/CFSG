module
public import CFSG.Quasithin.Chapter10.SourceA5TensorExclusion.TensorLine
public import Theory.Representation.OrthogonalFourPlusMatrix.SingularPlaneNatural

/-!
# Natural coordinates on the original tensor plane

The literal subgroup V₂ generated by the L-conjugates of V₁ is identified
with the natural SL₂(4) column module. The coordinate equivalence retains
conjugation by each original l ∈ L and the exact original quotient and
first-factor marking. The proof restricts the original faithful coordinates
to V₂ and then uses the commuting right-factor plane coordinates.

Source: Aschbacher–Smith9.1.2 and9.2.2(3), combined manuscript,
printed pp.729–731. No replacement component or abstract action is chosen.
-/

@[expose] public noncomputable section
open Subgroup Theory.GroupTheory Representation
namespace CFSG.Quasithin.Chapter10.SourceA5TensorModel
open Chapter3.Section02 ClassicalOrthogonal.FourPlusMatrix
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L : Subgroup G}
  {D : FundamentalSetup KnownSimple.IsKnownSimple T L}
  {e : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 5)}
  (m : SourceA5TensorModel D e)

theorem tensorPlane_normalized : L ≤ normalizer (m.tensorPlane : Set G) :=
  le_normalizer_componentOrbit m.tensorLine L

private def planeImageCoordinates : m.tensorPlane →*
    Multiplicative (m.sectionData.imageSpace m.tensorPlane) where
  toFun v := Multiplicative.ofAdd ⟨
    (m.sectionData.coordinates ⟨v,m.tensorPlane_le_fullModule v.property⟩).toAdd,
    (m.sectionData.mem_imageSpace_iff _ _).mpr
      ⟨⟨v,m.tensorPlane_le_fullModule v.property⟩,v.property,rfl⟩⟩
  map_one' := by
    apply Subtype.ext
    exact congrArg Multiplicative.toAdd m.sectionData.coordinates.map_one
  map_mul' v w := by
    apply Subtype.ext
    exact congrArg Multiplicative.toAdd (m.sectionData.coordinates.map_mul
      ⟨v,m.tensorPlane_le_fullModule v.property⟩ ⟨w,m.tensorPlane_le_fullModule w.property⟩)

private theorem planeImageCoordinates_bijective : Function.Bijective m.planeImageCoordinates := by
  constructor
  · intro v w h
    have hc := congrArg (fun x : Multiplicative (m.sectionData.imageSpace m.tensorPlane) => x.toAdd.val) h
    have he := m.coordinates_injective (Multiplicative.toAdd.injective hc)
    exact Subtype.ext (congrArg (fun x : D.fullModule => (x : G)) he)
  · intro w
    obtain ⟨v,hv,he⟩ := (m.sectionData.mem_imageSpace_iff _ _).mp w.toAdd.property
    exact ⟨⟨v,hv⟩,Subtype.ext he⟩

/-- Natural coordinates retain the original first-factor marking and literal conjugation. -/
theorem exists_tensorPlane_natural_coordinates :
    ∃ c : m.tensorPlane ≃* Multiplicative SL2FourNatural.V,
      ∀ (l : L) (v : m.tensorPlane),
        (c ⟨(l : G)*v*(l : G)⁻¹,
          (mem_normalizer_iff.mp (m.tensorPlane_normalized l.property) v).mp v.property⟩).toAdd =
        SL2FourNatural.action (m.firstMarking (e (QuotientGroup.mk' (pCore 2 L) l))) (c v).toAdd := by
  obtain ⟨Q,hQ⟩ := m.exists_tensorLine_coordinates_sylow
  obtain ⟨c0,hc0⟩ := Binary.sylow_plane_natural_coordinates Q
  have hr : Binary.firstOrbit (BinaryOffender.fixedSpace Binary.action (Q : Subgroup Binary.G)) =
      m.sectionData.imageSpace m.tensorPlane := by
    rw [m.tensorPlane_coordinates_firstOrbit,hQ]
  let c1 := c0.trans (LinearEquiv.ofEq _ _ hr)
  have hc1 (a : SL2FourNatural.SL) (v : SL2FourNatural.V) :
      (c1 (SL2FourNatural.action a v) : Binary.V) = Binary.action (a,1) (c1 v : Binary.V) :=
    hc0 a v
  let E := MulEquiv.ofBijective m.planeImageCoordinates m.planeImageCoordinates_bijective
  let c := E.trans c1.symm.toAddEquiv.toMultiplicative
  refine ⟨c,?_⟩
  intro l v
  let v' : m.tensorPlane := ⟨(l : G)*v*(l : G)⁻¹,
    (mem_normalizer_iff.mp (m.tensorPlane_normalized l.property) v).mp v.property⟩
  change c1.symm (E v').toAdd =
    SL2FourNatural.action (m.firstMarking (e (QuotientGroup.mk' (pCore 2 L) l)))
      (c1.symm (E v).toAdd)
  apply c1.injective
  apply Subtype.ext
  rw [c1.apply_symm_apply,hc1,c1.apply_symm_apply]
  change (m.sectionData.coordinates ⟨v',m.tensorPlane_le_fullModule v'.property⟩).toAdd =
    Binary.action (m.firstMarking (e (QuotientGroup.mk' (pCore 2 L) l)),1)
      (m.sectionData.coordinates ⟨v,m.tensorPlane_le_fullModule v.property⟩).toAdd
  rw [←m.first_factor l]
  exact m.sectionData.equivariant ⟨l,le_componentOrbit L T l.property⟩
    ⟨v,m.tensorPlane_le_fullModule v.property⟩

end CFSG.Quasithin.Chapter10.SourceA5TensorModel
