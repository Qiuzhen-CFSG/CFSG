module
public import CFSG.Quasithin.Chapter10.SourceA5TensorExclusion.TensorPointActionKernel
public import CFSG.Quasithin.Chapter10.SourceA5TensorExclusion.TensorPointActionModule
public import Theory.GroupTheory.PCoreInRestriction
public import CFSG.Quasithin.Chapter10.SourceA5TensorExclusion.TensorPointMovedOrbit

/-!
# Equality of the original tensor point action images

Restrict the reduced center orbit to the literal point component and its
A₅ residual. If their action images differ and the Thompson subgroup moves
the orbit, the completed FF classification applies. The actual moved module
is fully generated by its residual commutators, its two-core acts trivially,
and the original point is fixed by the containing component. The natural
cover calculations then force that point to be the identity, a contradiction.
If the Thompson subgroup centralizes the orbit, the existing source image
comparison gives equality directly.

The common action image has trivial two-core and is A₅. The final application
constructs the reduced orbit and its moved-subgroup containment from the
original nonquasisimple point-component hypotheses. All quotient maps and
actions are retained; no model or image-equality premise remains.

Source: Aschbacher--Smith, The Classification of Quasithin Groups,
9.4.1, printed p.735 of the combined manuscript of 1 March 2004.
-/

public noncomputable section
open Subgroup Theory.GroupTheory Representation Stellmacher
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter10.SourceA5TensorModel
open Chapter3.Section02 ClassicalOrthogonal.FourPlusMatrix
open ChapterB.InternalThompsonAction Representation.BinaryOffender
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L : Subgroup G}
  {D : FundamentalSetup KnownSimple.IsKnownSimple T L}
  {e : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 5)}
  (m : SourceA5TensorModel D e)

/-- The original point component and its residual have the same action image. -/
theorem tensorPoint_centerOrbit_image_eq (v : D.fullModule)
    (hv : ((m.sectionData.coordinates v).toAdd).det ≠ 0)
    {I : Subgroup G} (hLI : m.tensorPointResidual v ≤ I)
    (hIX : I ≤ centralizer ({(v : G)} : Set G))
    (hI : (I.subgroupOf (centralizer ({(v : G)} : Set G))).IsCComponent)
    (hIN : centralizer ({(v : G)} : Set G) ≤ normalizer (I : Set G))
    (hs : Chapter1.IsSylowIn 2
      ((T : Subgroup G) ⊓ centralizer ({(v : G)} : Set G))
      (D.maximalLocal ⊓ centralizer ({(v : G)} : Set G)))
    (hr : IsPReduced 2 ((conjugateSpanBy (omegaOneCenterAmbient (T : Subgroup G)) I).subgroupOf
      (I ⊔ ((T : Subgroup G) ⊓ centralizer ({(v : G)} : Set G)))))
    (hAU : ⁅D.fullModule,m.tensorPointResidual v⁆ ≤
      conjugateSpanBy (omegaOneCenterAmbient (T : Subgroup G)) I) :
    let H := I ⊔ ((T : Subgroup G) ⊓ centralizer ({(v : G)} : Set G))
    let W := (conjugateSpanBy (omegaOneCenterAmbient (T : Subgroup G)) I).subgroupOf H
    letI := hr.normal
    (I.subgroupOf H).map (actionMk W) =
      ((m.tensorPointResidual v).subgroupOf H).map (actionMk W) := by
  let X := centralizer ({(v : G)} : Set G)
  let S := (T : Subgroup G) ⊓ X
  let H := I ⊔ S
  let U := conjugateSpanBy (omegaOneCenterAmbient (T : Subgroup G)) I
  let W := U.subgroupOf H
  let := hr.normal
  let := hr.elementary
  let K := I.subgroupOf H
  let B := (m.tensorPointResidual v).subgroupOf H
  let q := actionMk W
  let A := ⁅D.fullModule,m.tensorPointResidual v⁆
  let AH := A.subgroupOf H
  have hUH : U ≤ H := by
    apply conjugateSpanBy_le ?_ (le_sup_left.trans H.le_normalizer)
    intro z hz
    have hz' := (mem_omegaOneCenterAmbient_iff _ _).mp hz
    exact mem_sup_right ⟨hz'.1,mem_centralizer_singleton_iff.mpr
      (hz'.2.2 v (m.fullModule_le_sylow v.property)).symm⟩
  have hAH : A ≤ H := hAU.trans hUH
  have hLH : m.tensorPointResidual v ≤ H := hLI.trans le_sup_left
  have hAW : A ≤ W.map H.subtype := by rwa [map_subgroupOf_eq_of_le hUH]
  have hAHW : AH ≤ W := comap_mono hAU
  have hBK : B ≤ K := comap_mono hLI
  have hAV : A ≤ D.fullModule := le_normalizer_iff_commutator_le_left.mp
    ((m.tensorPointResidual_le_orbit v).trans m.sectionData.normalized)
  have hfull : ⁅AH,B⁆ = AH := by
    apply map_injective H.subtype_injective
    rw [map_commutator,map_subgroupOf_eq_of_le hAH,map_subgroupOf_eq_of_le hLH,
      m.tensorPoint_moved_idempotent]
  have hvA : (v : G) ∈ A := m.tensorPoint_mem_moved v hv hs
  have hvm : (v : G) ∈ ⁅A,m.tensorPointResidual v⁆ := (m.tensorPoint_moved_idempotent v).symm ▸ hvA
  have hBnonzero : B.map q ≠ ⊥ :=
    m.tensorPointResidual_action_ne_bot v hv hs H hLH W hAW
  have hkB : IsPGroup 2 (q.subgroupMap B).ker := by
    apply m.tensorPointResidual_subgroupOf_kernel_isPGroup v hv H hLH
    intro he
    apply hBnonzero
    apply _root_.eq_bot_iff.mpr
    rintro a ⟨b,hb,rfl⟩
    have hbker : (⟨b,hb⟩ : B) ∈ (q.subgroupMap B).ker := he ▸ mem_top _
    exact congrArg Subtype.val (show q.subgroupMap B ⟨b,hb⟩ = 1 from hbker)
  have hcore : B.pCoreIn 2 ≤ centralizer (AH : Set H) := by
    rw [pCoreIn_subgroupOf 2 (m.tensorPointResidual v) H hLH]
    intro b hb a ha
    exact Subtype.ext ((m.tensorPointResidual_core_centralizes_fullModule v hv) hb a (hAV ha))
  by_contra heq
  have hcentral : elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (U : Set G) := by
    by_contra hm
    obtain ⟨_hff,hq,⟨hsource⟩⟩ := m.tensorPoint_centerOrbit_ff_models v hv hIX hI hIN hs hr hm
    let := hq
    have hKN := m.tensorPoint_centerOrbit_component_le_offender v hIX hIN hs hr hm hq
    obtain ⟨hproper,⟨eB⟩,_hker,R,_hR,hlocal⟩ :=
      m.tensorPointResidual_action_image_data v hv hLI hIX hI hIN hs W A hAW
        v (m.tensorPoint_ne_one v hv) hvm (Ne.symm heq)
    have hz : (⟨v,hAH hvA⟩ : H) = 1 :=
      source_tensor_local_action_fixed_eq_one K B W hBK hKN hsource
        (R.mapSurjective (q.subgroupMap_surjective K)) hlocal hproper eB hkB
        AH hAHW hfull hcore ⟨v,hAH hvA⟩ hvA (by
          intro k hk
          exact Subtype.ext (mem_centralizer_singleton_iff.mp (hIX hk)))
    exact m.tensorPoint_ne_one v hv (congrArg H.subtype hz)
  exact heq (m.tensorPointResidual_image_eq_of_thompson_centralizes v hv hLI hIX hI hs W
    (by rwa [map_subgroupOf_eq_of_le hUH]))

/-- The common point action image is the actual alternating group A₅. -/
theorem tensorPoint_centerOrbit_image_isA5 (v : D.fullModule)
    (hv : ((m.sectionData.coordinates v).toAdd).det ≠ 0)
    {I : Subgroup G} (hLI : m.tensorPointResidual v ≤ I)
    (hIX : I ≤ centralizer ({(v : G)} : Set G))
    (hI : (I.subgroupOf (centralizer ({(v : G)} : Set G))).IsCComponent)
    (hIN : centralizer ({(v : G)} : Set G) ≤ normalizer (I : Set G))
    (hs : Chapter1.IsSylowIn 2
      ((T : Subgroup G) ⊓ centralizer ({(v : G)} : Set G))
      (D.maximalLocal ⊓ centralizer ({(v : G)} : Set G)))
    (hr : IsPReduced 2 ((conjugateSpanBy (omegaOneCenterAmbient (T : Subgroup G)) I).subgroupOf
      (I ⊔ ((T : Subgroup G) ⊓ centralizer ({(v : G)} : Set G)))))
    (hAU : ⁅D.fullModule,m.tensorPointResidual v⁆ ≤
      conjugateSpanBy (omegaOneCenterAmbient (T : Subgroup G)) I) :
    let H := I ⊔ ((T : Subgroup G) ⊓ centralizer ({(v : G)} : Set G))
    let W := (conjugateSpanBy (omegaOneCenterAmbient (T : Subgroup G)) I).subgroupOf H
    letI := hr.normal
    Nonempty (((I.subgroupOf H).map (actionMk W)) ≃* alternatingGroup (Fin 5)) := by
  let X := centralizer ({(v : G)} : Set G)
  let S := (T : Subgroup G) ⊓ X
  let H := I ⊔ S
  let U := conjugateSpanBy (omegaOneCenterAmbient (T : Subgroup G)) I
  let W := U.subgroupOf H
  let := hr.normal
  let K := I.subgroupOf H
  let B := (m.tensorPointResidual v).subgroupOf H
  let q := actionMk W
  have hLH : m.tensorPointResidual v ≤ H := hLI.trans le_sup_left
  have hUH : U ≤ H := by
    apply conjugateSpanBy_le ?_ (le_sup_left.trans H.le_normalizer)
    intro z hz
    have hz' := (mem_omegaOneCenterAmbient_iff _ _).mp hz
    exact mem_sup_right ⟨hz'.1,mem_centralizer_singleton_iff.mpr
      (hz'.2.2 v (m.fullModule_le_sylow v.property)).symm⟩
  have hAW : ⁅D.fullModule,m.tensorPointResidual v⁆ ≤ W.map H.subtype := by
    rwa [map_subgroupOf_eq_of_le hUH]
  have hBnonzero := m.tensorPointResidual_action_ne_bot v hv hs H hLH W hAW
  have hkB : IsPGroup 2 (q.subgroupMap B).ker := by
    apply m.tensorPointResidual_subgroupOf_kernel_isPGroup v hv H hLH
    intro he
    apply hBnonzero
    apply _root_.eq_bot_iff.mpr
    rintro a ⟨b,hb,rfl⟩
    have hbker : (⟨b,hb⟩ : B) ∈ (q.subgroupMap B).ker := he ▸ mem_top _
    exact congrArg Subtype.val (show q.subgroupMap B ⟨b,hb⟩ = 1 from hbker)
  let b : B ≃* m.tensorPointResidual v := subgroupOfEquivOfLe hLH
  let eB : (B ⧸ pCore 2 B) ≃* alternatingGroup (Fin 5) :=
    (QuotientGroup.congr _ _ b (pCore_map_iso 2 b)).trans (m.tensorPointResidualA5Equiv v hv)
  let eImage : (B.map q ⧸ pCore 2 (B.map q)) ≃* alternatingGroup (Fin 5) :=
    ((q.subgroupMap B).pCoreQuotientEquiv (q.subgroupMap_surjective B) hkB).symm.trans eB
  have heq := m.tensorPoint_centerOrbit_image_eq v hv hLI hIX hI hIN hs hr hAU
  let : K.Normal := normal_subgroupOf_of_le_normalizer ((sup_le hIX inf_le_right).trans hIN)
  let : (K.map q).Normal := (inferInstance : K.Normal).map q (QuotientGroup.mk'_surjective _)
  let : (B.map q).Normal := heq ▸ (inferInstance : (K.map q).Normal)
  have hcoreIn : (B.map q).pCoreIn 2 = ⊥ := _root_.eq_bot_iff.mpr (by
    rw [←hr.quotient_pCore_eq_bot]
    exact pCoreIn_le_of_subnormal 2 (inferInstance : (B.map q).Normal).isSubnormal)
  have hcore : pCore 2 (B.map q) = ⊥ := by
    apply map_injective (B.map q).subtype_injective
    rw [Subgroup.map_bot]
    exact hcoreIn
  let e0 : (B.map q ⧸ pCore 2 (B.map q)) ≃* B.map q :=
    (QuotientGroup.quotientMulEquivOfEq hcore).trans QuotientGroup.quotientBot
  exact ⟨(MulEquiv.subgroupCongr heq).trans (e0.symm.trans eImage)⟩

/-- The original reduced-orbit construction discharges both action-image conclusions. -/
theorem tensorPoint_centerOrbit_images_source (v : D.fullModule)
    (hv : ((m.sectionData.coordinates v).toAdd).det ≠ 0)
    {I : Subgroup G} (hLI : m.tensorPointResidual v ≤ I)
    (hIX : I ≤ centralizer ({(v : G)} : Set G))
    (hI : (I.subgroupOf (centralizer ({(v : G)} : Set G))).IsCComponent)
    (hIN : centralizer ({(v : G)} : Set G) ≤ normalizer (I : Set G))
    (hq : ¬ IsQuasisimple I)
    (hs : Chapter1.IsSylowIn 2
      ((T : Subgroup G) ⊓ centralizer ({(v : G)} : Set G))
      (D.maximalLocal ⊓ centralizer ({(v : G)} : Set G))) :
    let H := I ⊔ ((T : Subgroup G) ⊓ centralizer ({(v : G)} : Set G))
    let W := (conjugateSpanBy (omegaOneCenterAmbient (T : Subgroup G)) I).subgroupOf H
    let hr := m.tensorPoint_centerOrbit_reduced_source v hv hLI hIX hI hIN hq hs
    letI := hr.normal
    (I.subgroupOf H).map (actionMk W) =
      ((m.tensorPointResidual v).subgroupOf H).map (actionMk W) ∧
      Nonempty (((I.subgroupOf H).map (actionMk W)) ≃* alternatingGroup (Fin 5)) := by
  let hr := m.tensorPoint_centerOrbit_reduced_source v hv hLI hIX hI hIN hq hs
  have hAU := (m.tensorPoint_centerOrbit_contains_geometry v hv hs hLI).1
  exact ⟨m.tensorPoint_centerOrbit_image_eq v hv hLI hIX hI hIN hs hr hAU,
    m.tensorPoint_centerOrbit_image_isA5 v hv hLI hIX hI hIN hs hr hAU⟩

end CFSG.Quasithin.Chapter10.SourceA5TensorModel
