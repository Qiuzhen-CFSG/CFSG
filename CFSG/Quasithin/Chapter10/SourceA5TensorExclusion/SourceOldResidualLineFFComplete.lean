module
public import CFSG.Quasithin.Chapter10.SourceA5TensorExclusion.SourceOldResidualLineFFContradiction
public import CFSG.Quasithin.Chapter10.SourceA5TensorExclusion.SourceOldResidualLineFFSolvable
public import CFSG.Quasithin.Chapter10.SourceA5TensorExclusion.SourceOldResidualLineFFLinear
public import CFSG.Quasithin.Chapter10.SourceA5TensorExclusion.SourceOldResidualLineFFSymplectic
public import CFSG.Quasithin.Chapter10.SourceA5TensorExclusion.SourceOldResidualLineFFG2
/-!
# The nonzero-core branch of the original tensor-line theorem

For X = H ∨ A with nontrivial two-core, the actual Omega orbit supplies
a proper old A₅ image inside a normal overcomponent. The complete FF
selection on that same action leaves four field-four module rows.
The original Borel placement makes ⟨A,T⟩ solvable, so the linear-three,
symplectic-four and G₂ model theorems all normalize the old image.
Since X is generated by K, T and A, this contradicts the image's proper
containment in the overcomponent. Thus K centralizes the original line.

The proof retains the actual embedded O²(H), the prescribed Sylow and
Cartan, the original Omega orbit and its quotient map. It does not
assume the entire orbit is moved, and does not omit the Cartan factor
from the ambient group. The earlier A₅ recognition and the zero-core
amalgam branch remain independent inputs to the full source theorem.

Source: Aschbacher--Smith, Proposition 9.3.1, printed pp.732--733.
-/

public noncomputable section
open Subgroup Theory.GroupTheory Stellmacher
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter10.SourceA5TensorModel
open Chapter3.Section02 ChapterC.MSCentralOrbit ChapterB.InternalThompsonAction
open Representation Representation.BinaryOffender ChapterA.Section03
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L : Subgroup G}
  {D : FundamentalSetup KnownSimple.IsKnownSimple T L}
  {e : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 5)}
  (m : SourceA5TensorModel D e)

/-- The original nonzero-core branch of source 9.3.1 centralizes the literal
tensor line. The model-selection and Cartan-normalization premises are discharged. -/
theorem old_residual_centralizes_tensorLine_of_nonzero_cartan_core
    {H : Subgroup G} (hH : H ∈ Chapter3.HStar (T : Subgroup G) D.maximalLocal)
    (eK : ((pResidual 2 H).map H.subtype ⧸
      pCore 2 ((pResidual 2 H).map H.subtype)) ≃* alternatingGroup (Fin 5))
    (A B : Subgroup G) (hAB : A ≤ sourceOrbitBorel T L)
    (hA9 : Nat.card A = 9) (hAe : IsElementaryAbelian 3 A)
    (hB3 : Nat.card B = 3) (hBC : B = A ⊓ centralizer (m.tensorLine : Set G))
    (hcore : pCore 2 (H ⊔ A : Subgroup G) ≠ ⊥) :
    (pResidual 2 H).map H.subtype ≤ centralizer (m.tensorLine : Set G) := by
  by_contra hmove
  apply m.nonzero_core_cartan_image_normalization_false hH eK A B
    hAB hA9 hAe hB3 hBC hcore hmove
  dsimp only
  let X : Subgroup G := H ⊔ A
  let K0 := (pResidual 2 H).map H.subtype
  have hTX : (T : Subgroup G) ≤ X :=
    (show (T : Subgroup G) ≤ H from hH.1.1.2).trans le_sup_left
  have hKX : K0 ≤ X := (map_subtype_le _).trans le_sup_left
  have hAX : A ≤ X := le_sup_right
  have hUX : m.tensorLine ≤ X := m.tensorLine_le_sylow.trans hTX
  let P := T.subtype hTX
  let K := K0.subgroupOf X
  let W := omegaOrbit (P : Subgroup X)
  obtain ⟨J,hJ,hnJ,hKJ,_,hr,hUW,_,hJN,_,_,h,_,hfour⟩ :=
    m.nonzero_core_cartan_six_models hH eK A B hAB hA9 hAe hB3 hBC hcore hmove
  let := hnJ
  let := hr.normal
  let := hr.elementary
  let := hAe
  let q := actionMk W
  let N := offenderSubgroup (action W)
  let C := (J.map q).subgroupOf N
  let i : J.map q ≃* C := (subgroupOfEquivOfLe hJN).symm
  have hKlocal : K ∈ localCComponents P :=
    SourceEmbeddings.local_restrict (source_hstar_residual_mem_local_of_a5 hH eK).1 hKX
  let b : K ≃* K0 := subgroupOfEquivOfLe hKX
  let eb : (K ⧸ pCore 2 K) ≃* alternatingGroup (Fin 5) :=
    (QuotientGroup.congr _ _ b (pCore_map_iso 2 b)).trans eK
  have hKOmega : K ≤ centralizer (omegaCenterIn (P : Subgroup X) : Set X) := by
    intro k hk z hz
    have hz' := (mem_omegaCenterIn_iff _ _).mp hz
    have hzG : (z : G) ∈ omegaCenterIn (T : Subgroup G) := by
      apply (mem_omegaCenterIn_iff _ _).mpr
      refine ⟨hz'.1,?_,congrArg Subtype.val hz'.2.2⟩
      intro t ht
      exact congrArg Subtype.val (hz'.2.1 ⟨t,hTX ht⟩ ht)
    exact Subtype.ext (m.old_residual_centralizes_sylowOmega hH hk z hzG)
  have hKW : ¬ K ≤ centralizer (W : Set X) := by
    intro hc
    apply hmove
    intro k hk u hu
    exact congrArg Subtype.val (hc (show (⟨k,hKX hk⟩ : X) ∈ K from hk)
      ⟨u,hUX hu⟩ (hUW hu))
  obtain ⟨hp,_,_,R,hR,hlocal⟩ :=
    SourceOldResidualLineFF.proper_local_image P J K hJ hKlocal hKJ eb hKOmega hKW
  have hRP : (R : Subgroup J).map J.subtype ≤ (P : Subgroup X) := by
    rw [hR,subgroupOf_map_subtype]
    exact inf_le_left
  have hPK : (P : Subgroup X) ≤ normalizer (K : Set X) := by
    intro p hp
    apply mem_normalizer_iff.mpr
    intro k
    exact mem_normalizer_iff.mp
      (le_normalizer_embedded_pResidual 2 H (hH.1.1.2 hp)) (k : G)
  have hA3 : IsPGroup 3 (A.subgroupOf X) :=
    (IsElementaryAbelian.isPGroup 3 A).comap_subtype
  have hAcube : ∀ a ∈ A.subgroupOf X, a ^ 3 = 1 := by
    intro a ha
    exact Subtype.ext (elemPow_eq_one_of_isElementaryAbelian (p := 3) (a : G) ha)
  have hsol : Group.IsSolvable (A.subgroupOf X ⊔ (P : Subgroup X) : Subgroup X) := by
    let Z := A.subgroupOf X ⊔ (P : Subgroup X)
    have he : Z.map X.subtype = A ⊔ (T : Subgroup G) := by
      rw [Subgroup.map_sup,map_subgroupOf_eq_of_le hAX]
      congr 1
      exact map_subgroupOf_eq_of_le hTX
    let f : Z ≃* (A ⊔ (T : Subgroup G) : Subgroup G) :=
      (Z.equivMapOfInjective X.subtype X.subtype_injective).trans (MulEquiv.subgroupCongr he)
    let : Group.IsSolvable (A ⊔ (T : Subgroup G) : Subgroup G) :=
      m.cartan_sylow_join_isSolvable A hAB
    exact Group.isSolvable_of_isSolvable_injective (f := f.toMonoidHom) f.injective
  let Y := (A.subgroupOf X).map q ⊔ (P : Subgroup X).map q
  let : Group.IsSolvable Y := m.cartan_sylow_image_join_isSolvable A X hAB hAX hTX q
  change (A.subgroupOf X).map q ≤ normalizer (K.map q : Set (ActionQuotient W))
  cases hfour with
  | linearThree F hF hf a =>
    exact SourceOldResidualLineFFLinear.mapped_cubic_subgroup_normalizes_local
      q (QuotientGroup.mk'_surjective _) (P : Subgroup X) (A.subgroupOf X) J K hKJ
      R hR Y le_sup_left le_sup_right hAcube hF (i.trans a.groupEquiv) hlocal hp.ne
  | doubleThree F hF a =>
    exact SourceOldResidualLineFFLinear.mapped_cubic_subgroup_normalizes_local
      q (QuotientGroup.mk'_surjective _) (P : Subgroup X) (A.subgroupOf X) J K hKJ
      R hR Y le_sup_left le_sup_right hAcube hF (i.trans a.groupEquiv) hlocal hp.ne
  | symplectic F hF hl hf a =>
    exact SourceOldResidualLineFFSymplectic.action_image_normalizes_local
      W J K (A.subgroupOf X) P R hRP hKJ hA3 hsol hPK (i.trans a.groupEquiv) hF hlocal hp.ne
  | g2 F hF hl hf a =>
    exact SourceOldResidualLineFF.g2_original_image_normalized
      J K W P hKJ (A.subgroupOf X) hA3 hsol R hR hlocal hp.ne (i.trans a.groupEquiv) hF
end CFSG.Quasithin.Chapter10.SourceA5TensorModel
