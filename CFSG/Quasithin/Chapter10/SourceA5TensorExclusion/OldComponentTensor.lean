module
public import CFSG.Quasithin.Chapter10.SourceA5TensorExclusion.OldComponentThompson
public import CFSG.Quasithin.Chapter10.SourceA5TensorExclusion.TensorOmegaCenterFree

/-!
# Tensor non-FF discharges the old residual's Thompson input

The faithful original tensor action is non-FF, so J(T) centralizes the
actual full module and hence the chosen local module. This removes the
centralization premise from the literal old-residual commutator identity
used in source 9.3.7. Only the earlier A₅ quotient recognition remains.
Source: Aschbacher–Smith 9.3.1 and 9.3.7, printed pp.732–734.
-/

public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter10.SourceA5TensorModel
open Chapter3.Section02
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L : Subgroup G}
  {D : FundamentalSetup KnownSimple.IsKnownSimple T L}
  {e : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 5)}

/-- The same original old component is generated by its Thompson commutators. -/
theorem old_residual_eq_thompson_commutator (m : SourceA5TensorModel D e)
    {H : Subgroup G} (hH : H ∈ Chapter3.HStar (T : Subgroup G) D.maximalLocal)
    (eK : ((pResidual 2 H).map H.subtype ⧸
      pCore 2 ((pResidual 2 H).map H.subtype)) ≃* alternatingGroup (Fin 5)) :
    (pResidual 2 H).map H.subtype =
      ⁅(pResidual 2 H).map H.subtype, Stellmacher.elementaryAbelianMaxJ (T : Subgroup G)⁆ := by
  apply source_a5_hstar_residual_thompson_commutator D hH eK
  rw [m.module_eq]
  exact m.thompson_centralizes_fullModule

end CFSG.Quasithin.Chapter10.SourceA5TensorModel
