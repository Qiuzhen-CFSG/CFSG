module
public import CFSG.Quasithin.Chapter10.SourceA5TensorExclusion.SourceOldResidualRecognition
public import CFSG.Quasithin.Chapter10.SourceA5TensorExclusion.OvergroupSelectedModels
public import CFSG.Quasithin.Chapter1.Section01Overgroups.Sylow
public import Theory.GroupTheory.PResidual.NormalizerCore
/-!
# The nonzero-core branch of the original tensor-line argument

For the original H-star subgroup and its cubic Cartan A, put X = H ∨ A.
A nontrivial two-core makes X characteristic two and supplies a normal
C-component containing the literal old residual. The generation statement
retains A: X is generated by that component, the original Sylow, and A.
The Cartan orbit of an original central involution puts the tensor line in
W = Ω₁Z(T)^X. If the residual moves the line, its original Thompson
commutator identity produces a genuine FF action on X/C_X(W).

The old residual fixes Ω₁Z(T). Normality of the containing component then
shows its action image is strictly larger than the old A₅ image. The local
Sylow marking and two-core quotient are transported through the same action
map. This proves the original input package for the B.5 model selection;
the model selection and Cartan-normalization contradiction remain later steps.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004,
Proposition 9.3.1, printed pp.732–733, using 1.2.4 and B.2.14.
-/

public noncomputable section
open Subgroup Theory.GroupTheory Stellmacher
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter10.SourceA5TensorModel
open Chapter3.Section02 ChapterC.MSCentralOrbit ChapterB.InternalThompsonAction
open Representation Representation.BinaryOffender
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L : Subgroup G}
  {D : FundamentalSetup KnownSimple.IsKnownSimple T L}
  {e : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 5)}
  (m : SourceA5TensorModel D e)

theorem nonzero_core_cartan_overcomponent
    {H : Subgroup G} (hH : H ∈ Chapter3.HStar (T : Subgroup G) D.maximalLocal)
    (eK : ((pResidual 2 H).map H.subtype ⧸
      pCore 2 ((pResidual 2 H).map H.subtype)) ≃* alternatingGroup (Fin 5))
    (A : Subgroup G) (hcore : pCore 2 (H ⊔ A : Subgroup G) ≠ ⊥) :
    H ⊔ A ∈ Chapter1.He G ∧ IsSQTK KnownSimple.IsKnownSimple (H ⊔ A : Subgroup G) ∧
    ∃ J : Subgroup (H ⊔ A : Subgroup G), J.IsCComponent ∧ J.Normal ∧
      ((pResidual 2 H).map H.subtype).subgroupOf (H ⊔ A : Subgroup G) ≤ J ∧
      (J ⊔ (T : Subgroup G).subgroupOf (H ⊔ A : Subgroup G)) ⊔ A.subgroupOf (H ⊔ A : Subgroup G) = ⊤ := by
  let X : Subgroup G := H ⊔ A
  let K := (pResidual 2 H).map H.subtype
  have hTX : (T : Subgroup G) ≤ X := (show (T : Subgroup G) ≤ H from hH.1.1.2).trans le_sup_left
  have hKX : K ≤ X := (map_subtype_le _).trans le_sup_left
  have hXH : X ∈ Chapter1.H G := by
    intro hb
    exact hcore ((map_eq_bot_iff_of_injective _ X.subtype_injective).mp hb)
  have hHe : X ∈ Chapter1.He G :=
    Chapter1.lemma_1_1_4_6 T (D.simpleQTKE.evenCharacteristic T) ⟨hXH,hTX⟩
  have hs := Chapter3.sqtk_of_mem_H D.simpleQTKE hXH
  have hq : IsSQTK KnownSimple.IsKnownSimple (X ⧸ pCore 2 X) := by
    refine ⟨?_,hs.isKGroup.quotient _⟩
    intro p hp ho
    let : Fact p.Prime := ⟨hp⟩
    exact (primeRank_quotient_le_of_isTwoGroup p ho _ pCore_isPGroup).trans
      (hs.stronglyQuasithin p hp ho)
  let P := T.subtype hTX
  have hKlocal : K.subgroupOf X ∈ Chapter1.L X (P : Subgroup X) :=
    (Chapter1.mem_LIn_iff_subgroupOf hTX hKX).mp
      ⟨hKX,source_hstar_residual_mem_local_of_a5 hH eK⟩
  have hPK : (P : Subgroup X) ≤ normalizer (K.subgroupOf X : Set X) := by
    rw [←subgroupOf_normalizer_eq hKX]
    exact comap_mono (hH.1.1.2.trans (le_normalizer_embedded_pResidual 2 H))
  obtain ⟨J,⟨hJ,hKJ,hnJ⟩,_⟩ :=
    Chapter1.Section02.lemma_1_2_4_containment_normality_source hq P hKlocal hPK
  refine ⟨hHe,hs,J,hJ,hnJ,hKJ,?_⟩
  apply map_injective X.subtype_injective
  rw [Subgroup.map_sup,Subgroup.map_sup,map_subgroupOf_eq_of_le hTX,
    map_subgroupOf_eq_of_le (show A ≤ X from le_sup_right),
    ←MonoidHom.range_eq_map,range_subtype]
  apply le_antisymm (sup_le (sup_le (map_subtype_le _) hTX) le_sup_right)
  have hh : K ≤ J.map X.subtype := by
    simpa only [map_subgroupOf_eq_of_le hKX] using map_mono (f := X.subtype) hKJ
  change H ⊔ A ≤ _
  rw [←source_hstar_residual_sup_sylow hH]
  exact sup_le_sup (sup_le_sup_right hh _) le_rfl

theorem tensorLine_le_cartan_omegaOrbit
    {H : Subgroup G} (hH : H ∈ Chapter3.HStar (T : Subgroup G) D.maximalLocal)
    (A : Subgroup G) (hAU : A ≤ normalizer (m.tensorLine : Set G))
    (a : G) (haA : a ∈ A) (ha3 : a ^ 3 = 1)
    (haC : a ∉ centralizer (m.tensorLine : Set G)) :
    m.tensorLine.subgroupOf (H ⊔ A : Subgroup G) ≤
      omegaOrbit ((T : Subgroup G).subgroupOf (H ⊔ A : Subgroup G)) := by
  let X : Subgroup G := H ⊔ A
  let W := omegaOrbit ((T : Subgroup G).subgroupOf X)
  have hTX : (T : Subgroup G) ≤ X := (show (T : Subgroup G) ≤ H from hH.1.1.2).trans le_sup_left
  have hUX : m.tensorLine ≤ X := m.tensorLine_le_sylow.trans hTX
  have hAX : A ≤ X := le_sup_right
  have hAW : A ≤ normalizer (W.map X.subtype : Set G) := by
    exact hAX.trans ((normal_subgroupOf_iff_le_normalizer (map_subtype_le W)).mp
      (by simpa only [subgroupOf,comap_map_eq_self_of_injective X.subtype_injective] using (inferInstance : W.Normal)))
  obtain ⟨z,hz2,hzU,hzT⟩ := m.exists_central_involution_tensorLine
  have hzΩ : z ∈ omegaCenterIn (T : Subgroup G) :=
    (mem_omegaCenterIn_iff _ _).mpr
      ⟨m.tensorLine_le_sylow hzU,hzT,hz2 ▸ pow_orderOf_eq_one z⟩
  have hzW : z ∈ W.map X.subtype := by
    have hzΩX : (⟨z,hUX hzU⟩ : X) ∈ omegaCenterIn ((T : Subgroup G).subgroupOf X) := by
      apply (mem_omegaCenterIn_iff _ _).mpr
      refine ⟨m.tensorLine_le_sylow hzU,?_,?_⟩
      · intro t ht
        exact Subtype.ext (hzT t ht)
      · exact Subtype.ext (hz2 ▸ pow_orderOf_eq_one z)
    exact mem_map_of_mem X.subtype (subset_normalClosure hzΩX)
  have hUne : m.tensorLine ⊓ W.map X.subtype ≠ ⊥ := by
    intro hb
    have hzone : z = 1 := mem_bot.mp (hb ▸ (show z ∈ m.tensorLine ⊓ W.map X.subtype from ⟨hzU,hzW⟩))
    simp only [hzone,orderOf_one] at hz2
    omega
  have he : m.tensorLine ⊓ W.map X.subtype = m.tensorLine :=
    (m.tensorLine_cartan_irreducible A hAU a haA ha3 haC _ inf_le_left
      ((le_inf hAU hAW).trans inf_normalizer_le_normalizer_inf)).resolve_left hUne
  have hUW : m.tensorLine ≤ W.map X.subtype := he ▸ inf_le_right
  intro u hu
  obtain ⟨w,hw,hwU⟩ := hUW hu
  have hwU' : w = u := Subtype.ext hwU
  exact hwU' ▸ hw

theorem nonzero_core_cartan_omega_ff
    {H : Subgroup G} (hH : H ∈ Chapter3.HStar (T : Subgroup G) D.maximalLocal)
    (eK : ((pResidual 2 H).map H.subtype ⧸
      pCore 2 ((pResidual 2 H).map H.subtype)) ≃* alternatingGroup (Fin 5))
    (A : Subgroup G) (hcore : pCore 2 (H ⊔ A : Subgroup G) ≠ ⊥)
    (hAU : A ≤ normalizer (m.tensorLine : Set G))
    (a : G) (haA : a ∈ A) (ha3 : a ^ 3 = 1)
    (haC : a ∉ centralizer (m.tensorLine : Set G))
    (hmove : ¬ (pResidual 2 H).map H.subtype ≤ centralizer (m.tensorLine : Set G)) :
    let X : Subgroup G := H ⊔ A
    let P := T.subtype ((show (T : Subgroup G) ≤ H from hH.1.1.2).trans (show H ≤ X from le_sup_left))
    let W := omegaOrbit (P : Subgroup X)
    ∃ hr : IsPReduced 2 W,
      letI := hr.normal; letI := hr.elementary
      m.tensorLine.subgroupOf X ≤ W ∧
      ¬ elementaryAbelianMaxJ (P : Subgroup X) ≤ centralizer (W : Set X) ∧
      IsFFModule (V := Additive W) (action W) := by
  dsimp only
  let X : Subgroup G := H ⊔ A
  let K := (pResidual 2 H).map H.subtype
  have hTX : (T : Subgroup G) ≤ X := (show (T : Subgroup G) ≤ H from hH.1.1.2).trans le_sup_left
  have hKX : K ≤ X := (map_subtype_le _).trans le_sup_left
  have hUX : m.tensorLine ≤ X := m.tensorLine_le_sylow.trans hTX
  let P := T.subtype hTX
  let W := omegaOrbit (P : Subgroup X)
  have hHe := (nonzero_core_cartan_overcomponent (D := D) hH eK A hcore).1
  have hr : IsPReduced 2 W := omegaOrbit_reduced P (Chapter1.mem_He_iff.mp hHe)
  refine ⟨hr,?_⟩
  let := hr.normal
  let := hr.elementary
  have hUW : m.tensorLine.subgroupOf X ≤ W := m.tensorLine_le_cartan_omegaOrbit hH A hAU a haA ha3 haC
  have hKW : ¬ K.subgroupOf X ≤ centralizer (W : Set X) := by
    intro hc
    apply hmove
    intro k hk u hu
    exact congrArg Subtype.val
      (hc (show (⟨k,hKX hk⟩ : X) ∈ K.subgroupOf X from hk) ⟨u,hUX hu⟩ (hUW hu))
  have hcomm : K.subgroupOf X = ⁅K.subgroupOf X,elementaryAbelianMaxJ (P : Subgroup X)⁆ := by
    apply map_injective X.subtype_injective
    rw [map_commutator,map_subgroupOf_eq_of_le hKX,
      ←elementaryAbelianMaxJ_map_injective X.subtype X.subtype_injective]
    have hPmap : (P : Subgroup X).map X.subtype = (T : Subgroup G) := map_subgroupOf_eq_of_le hTX
    rw [hPmap]
    exact m.old_residual_eq_thompson_commutator hH eK
  have hJ := thompson_moves_of_component_commutator (P : Subgroup X)
    (K.subgroupOf X) W hcomm hKW
  exact ⟨hUW,hJ,isFFModule_of_thompson_movement P W hJ⟩

end CFSG.Quasithin.Chapter10.SourceA5TensorModel

namespace CFSG.Quasithin.Chapter10.SourceOldResidualLineFF
open Subgroup Theory.GroupTheory Stellmacher
open ChapterB.InternalThompsonAction ChapterC.MSCentralOrbit ChapterA.Section03
variable {X : Type*} [Group X] [Finite X]

/-- The original omega orbit makes the old local A5 image proper in the
normal overcomponent, without a Sylow-generation assumption. -/
theorem proper_local_image
    (P : Sylow 2 X) (J K : Subgroup X) [J.Normal]
    (hJ : J.IsCComponent) (hK : K ∈ localCComponents P) (hKJ : K ≤ J)
    (eK : (K ⧸ pCore 2 K) ≃* alternatingGroup (Fin 5))
    (hKOmega : K ≤ centralizer (omegaCenterIn (P : Subgroup X) : Set X))
    (hmove : ¬ K ≤ centralizer (omegaOrbit (P : Subgroup X) : Set X)) :
    let W := omegaOrbit (P : Subgroup X)
    let q := actionMk W
    let KI := (K.map q).subgroupOf (J.map q)
    KI < ⊤ ∧ Nonempty ((KI ⧸ pCore 2 KI) ≃* alternatingGroup (Fin 5)) ∧
      Group.IsSolvable (q.subgroupMap J).ker ∧
      ∃ R : Sylow 2 J,
        (R : Subgroup J) = (P : Subgroup X).subgroupOf J ∧
        KI ∈ localCComponents (R.mapSurjective (q.subgroupMap_surjective J)) := by
  let W := omegaOrbit (P : Subgroup X)
  let q := actionMk W
  let KI := (K.map q).subgroupOf (J.map q)
  have hKnonzero : K.map q ≠ ⊥ := by
    intro hz
    exact hmove (by simpa only [q,actionMk,QuotientGroup.ker_mk'] using
      (Subgroup.map_eq_bot_iff K).mp hz)
  have hproper : K.map q < J.map q := by
    refine lt_of_le_of_ne (map_mono hKJ) ?_
    intro he
    have hpre : J ≤ K ⊔ q.ker := by
      rw [←comap_map_eq]
      exact map_le_iff_le_comap.mp he.ge
    have hker : q.ker ≤ centralizer (omegaCenterIn (P : Subgroup X) : Set X) := by
      rw [show q.ker = centralizer (W : Set X) from QuotientGroup.ker_mk' _]
      exact centralizer_le subset_normalClosure
    have hJOmega : J ≤ centralizer (omegaCenterIn (P : Subgroup X) : Set X) :=
      hpre.trans (sup_le hKOmega hker)
    have hWJ : W ≤ centralizer (J : Set X) :=
      normalClosure_le_normal (le_centralizer_iff.mp hJOmega)
    exact hmove (hKJ.trans (le_centralizer_iff.mp hWJ))
  have hKIproper : KI < ⊤ := lt_top_iff_ne_top.mpr (fun he => by
    have hh := congrArg (Subgroup.map (J.map q).subtype) he
    rw [map_subgroupOf_eq_of_le (map_mono hKJ),←MonoidHom.range_eq_map,range_subtype] at hh
    exact hproper.ne hh)
  have hKtop : (⊤ : Subgroup K).IsCComponent := by
    simpa only [subgroupOf_self] using hK.subgroupOf_of_le
      (show K ≤ K from le_rfl) (show K ≤ K ⊔ (P : Subgroup X) from le_sup_left)
  let := hKtop.perfect
  let : Group.IsPerfect K := Group.IsPerfect.ofSurjective
    (f := (topEquiv : (⊤ : Subgroup K) ≃* K).toMonoidHom) topEquiv.surjective
  let : IsSimpleGroup (alternatingGroup (Fin 5)) := alternatingGroup.isSimpleGroup (by simp)
  let : IsSimpleGroup (K ⧸ pCore 2 K) := eK.isSimpleGroup
  let k := q.subgroupMap K
  have hkker : k.ker ≠ ⊤ := by
    intro he
    apply hKnonzero
    apply (Subgroup.eq_bot_iff_forall _).mpr
    rintro _ ⟨a,ha,rfl⟩
    have hm : (⟨a,ha⟩ : K) ∈ k.ker := he ▸ mem_top _
    exact congrArg Subtype.val (show k ⟨a,ha⟩ = 1 from hm)
  have hkcore : k.ker ≤ pCore 2 K := by
    rw [←PerfectCoreTwoExtension.radical_eq_core]
    exact kernel_le_solvableRadical_of_top_isCComponent hKtop k hkker
  have hk2 : IsPGroup 2 k.ker := pCore_isPGroup.of_injective
    (inclusion hkcore) (inclusion_injective hkcore)
  let eImage : (K.map q ⧸ pCore 2 (K.map q)) ≃* alternatingGroup (Fin 5) :=
    (k.pCoreQuotientEquiv (q.subgroupMap_surjective K) hk2).symm.trans eK
  let i : KI ≃* K.map q := subgroupOfEquivOfLe (map_mono hKJ)
  let eKI : (KI ⧸ pCore 2 KI) ≃* alternatingGroup (Fin 5) :=
    (QuotientGroup.congr _ _ i (pCore_map_iso 2 i)).trans eImage
  let f := q.subgroupMap J
  have hfker : f.ker ≠ ⊤ := by
    intro he
    apply hKnonzero
    apply eq_bot_iff.mpr
    rintro x ⟨a,ha,rfl⟩
    have hm : (⟨a,hKJ ha⟩ : J) ∈ f.ker := he ▸ mem_top _
    exact congrArg Subtype.val (show f ⟨a,hKJ ha⟩ = 1 from hm)
  let : Group.IsSolvable f.ker := hJ.isSolvable_of_subnormal_lt_top
    (inferInstance : f.ker.Normal).isSubnormal hfker
  refine ⟨hKIproper,⟨eKI⟩,inferInstance,?_⟩
  obtain ⟨R,hR,hKR⟩ := SourceEmbeddings.exists_local_sylow_restriction P hK hKJ
    (inferInstance : J.Normal).isSubnormal
  have hlocal := Chapter1.Section02.localCComponents_map_of_solvable_ker hKR f
  have himage : (K.subgroupOf J).map f = KI := by
    ext x
    constructor
    · rintro ⟨a,ha,rfl⟩
      exact mem_map.mpr ⟨a,ha,rfl⟩
    · rintro ⟨a,ha,hax⟩
      exact ⟨⟨a,hKJ ha⟩,ha,Subtype.ext hax⟩
  refine ⟨R,hR,?_⟩
  simpa only [himage,Sylow.coe_mapSurjective] using hlocal

end CFSG.Quasithin.Chapter10.SourceOldResidualLineFF

namespace CFSG.Quasithin.Chapter10.SourceA5TensorModel
open Chapter3.Section02 ChapterC.MSCentralOrbit ChapterB.InternalThompsonAction
open Representation Representation.BinaryOffender ChapterA.Section03
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L : Subgroup G}
  {D : FundamentalSetup KnownSimple.IsKnownSimple T L}
  {e : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 5)}
  (m : SourceA5TensorModel D e)

/-- Actual 9.3.1 data, with the original Cartan rather than an independently
chosen noncentral actor. The extra Cartan factor is retained in generation. -/
theorem nonzero_core_cartan_original_data
    {H : Subgroup G} (hH : H ∈ Chapter3.HStar (T : Subgroup G) D.maximalLocal)
    (eK : ((pResidual 2 H).map H.subtype ⧸
      pCore 2 ((pResidual 2 H).map H.subtype)) ≃* alternatingGroup (Fin 5))
    (A B : Subgroup G) (hAB : A ≤ sourceOrbitBorel T L)
    (hA9 : Nat.card A = 9) (hAe : IsElementaryAbelian 3 A)
    (hB3 : Nat.card B = 3) (hBC : B = A ⊓ centralizer (m.tensorLine : Set G))
    (hcore : pCore 2 (H ⊔ A : Subgroup G) ≠ ⊥)
    (hmove : ¬ (pResidual 2 H).map H.subtype ≤ centralizer (m.tensorLine : Set G)) :
    let X : Subgroup G := H ⊔ A
    let P := T.subtype ((show (T : Subgroup G) ≤ H from hH.1.1.2).trans
      (show H ≤ X from le_sup_left))
    let K := ((pResidual 2 H).map H.subtype).subgroupOf X
    let W := omegaOrbit (P : Subgroup X)
    X ∈ Chapter1.He G ∧ IsSQTK KnownSimple.IsKnownSimple X ∧
    ∃ J : Subgroup X, J.IsCComponent ∧ J.Normal ∧ K ≤ J ∧
      (J ⊔ (P : Subgroup X)) ⊔ A.subgroupOf X = ⊤ ∧
      ∃ hr : IsPReduced 2 W,
        letI := hr.normal; letI := hr.elementary
        m.tensorLine.subgroupOf X ≤ W ∧ IsFFModule (V := Additive W) (action W) ∧
        K.map (actionMk W) ≤ offenderSubgroup (action W) ∧
        let q := actionMk W
        let KI := (K.map q).subgroupOf (J.map q)
        KI < ⊤ ∧ Nonempty ((KI ⧸ pCore 2 KI) ≃* alternatingGroup (Fin 5)) ∧
          Group.IsSolvable (q.subgroupMap J).ker ∧
          ∃ R : Sylow 2 J, (R : Subgroup J) = (P : Subgroup X).subgroupOf J ∧
            KI ∈ localCComponents (R.mapSurjective (q.subgroupMap_surjective J)) := by
  dsimp only
  let X : Subgroup G := H ⊔ A
  let K0 := (pResidual 2 H).map H.subtype
  have hTX : (T : Subgroup G) ≤ X :=
    (show (T : Subgroup G) ≤ H from hH.1.1.2).trans le_sup_left
  have hKX : K0 ≤ X := (map_subtype_le _).trans le_sup_left
  have hUX : m.tensorLine ≤ X := m.tensorLine_le_sylow.trans hTX
  let P := T.subtype hTX
  let W := omegaOrbit (P : Subgroup X)
  let K := K0.subgroupOf X
  have hAU : A ≤ normalizer (m.tensorLine : Set G) := hAB.trans m.borel_normalizes_tensorLine
  have hnA : ¬ A ≤ centralizer (m.tensorLine : Set G) := by
    intro hc
    have he : B = A := hBC.trans (inf_eq_left.mpr hc)
    rw [he,hA9] at hB3
    omega
  obtain ⟨a,haA,haC⟩ := Set.not_subset.mp hnA
  let := hAe
  have ha3 : a ^ 3 = 1 := elemPow_eq_one_of_isElementaryAbelian a haA
  obtain ⟨hHe,hs,J,hJ,hnJ,hKJ,hgen⟩ := nonzero_core_cartan_overcomponent (D := D) hH eK A hcore
  let := hnJ
  obtain ⟨hr,hUW,hJmove,hFF⟩ := m.nonzero_core_cartan_omega_ff hH eK A hcore hAU a haA ha3 haC hmove
  let := hr.normal
  let := hr.elementary
  have hcomm : K = ⁅K,elementaryAbelianMaxJ (P : Subgroup X)⁆ := by
    apply map_injective X.subtype_injective
    rw [map_commutator,map_subgroupOf_eq_of_le hKX,
      ←elementaryAbelianMaxJ_map_injective X.subtype X.subtype_injective]
    have hPmap : (P : Subgroup X).map X.subtype = (T : Subgroup G) := map_subgroupOf_eq_of_le hTX
    rw [hPmap]
    exact m.old_residual_eq_thompson_commutator hH eK
  have hKN : K.map (actionMk W) ≤ offenderSubgroup (action W) := by
    conv_lhs => rw [hcomm,map_commutator]
    let : (offenderSubgroup (action W)).Normal := offenderSubgroup_normal _
    exact (commutator_mono le_rfl (thompson_image_le P W)).trans (commutator_le_right _ _)
  refine ⟨hHe,hs,J,hJ,hnJ,hKJ,hgen,hr,hUW,hFF,hKN,?_⟩
  have hKlocal : K ∈ localCComponents P :=
    SourceEmbeddings.local_restrict (source_hstar_residual_mem_local_of_a5 hH eK).1 hKX
  let b : K ≃* K0 := subgroupOfEquivOfLe hKX
  let eb : (K ⧸ pCore 2 K) ≃* alternatingGroup (Fin 5) :=
    (QuotientGroup.congr _ _ b (pCore_map_iso 2 b)).trans eK
  have hKOmega : K ≤ centralizer (omegaCenterIn (P : Subgroup X) : Set X) := by
    intro k hk z hz
    have hz' := (mem_omegaCenterIn_iff _ _).mp hz
    have hzG : (z : G) ∈ omegaCenterIn (T : Subgroup G) := by
      apply (mem_omegaCenterIn_iff _ _).mpr
      refine ⟨hz'.1,?_,congrArg Subtype.val hz'.2.2⟩
      intro t ht
      exact congrArg Subtype.val (hz'.2.1 ⟨t,hTX ht⟩ ht)
    exact Subtype.ext (m.old_residual_centralizes_sylowOmega hH hk z hzG)
  have hKW : ¬ K ≤ centralizer (W : Set X) := by
    intro hc
    apply hmove
    intro k hk u hu
    exact congrArg Subtype.val (hc (show (⟨k,hKX hk⟩ : X) ∈ K from hk)
      ⟨u,hUX hu⟩ (hUW hu))
  exact SourceOldResidualLineFF.proper_local_image P J K hJ hKlocal hKJ eb hKOmega hKW

end CFSG.Quasithin.Chapter10.SourceA5TensorModel
