module
public import CFSG.Quasithin.Chapter10.SourceA5TensorExclusion.TensorPointNonsplitModels
public import CFSG.Quasithin.Chapter10.SourceA5TensorExclusion.OffenderLocalImage
public import CFSG.Quasithin.ChapterB.InternalThompsonFixedSpace
public import Theory.Representation.NormalElementaryQuotient.SubgroupSpace
public import Theory.GroupTheory.PCoreInRestriction
public import Theory.Representation.BinaryOffender.MovedDimension

/-!
# The original fixed element in the internal tensor action

The literal quotient by the centralizer of a normal elementary abelian
subgroup acts on its additive carrier. An ambient subgroup generated by its
commutators with the old local subgroup becomes a fully moved binary subspace.
A two-group kernel on that old subgroup identifies its actual two-core image,
so the original centralization hypothesis gives core-fixedness of this space.

The canonical inclusion of the component image into the offender subgroup
transports the same local subgroup and its Sylow and alternating-five marking.
The source fixed-vector theorem then applies to the vector representing the
original element. Returning to its ambient group value proves that element
is the identity.

Source: Aschbacher--Smith 9.4.1, printed p.735/PDF p.752 of
`refs/quasithin.pdf`, the FF-module contradiction for the original local
moved subgroup. Every quotient, subgroup core and vector uses its literal
map; the earlier full B.5.1 source conclusion is the supplied input.
-/

public section

open Subgroup Theory.GroupTheory Representation Representation.BinaryOffender
open scoped IsMulCommutative commutatorElement
namespace CFSG.Quasithin.Chapter10
open ChapterB.InternalThompsonAction ChapterA.Section03
open Representation.NormalElementaryQuotient
variable {H : Type*} [Group H] [Finite H]

/-- The actual local moved subgroup has trivial intersection with the
centralizer of the component, under the full source module conclusion. -/
theorem source_tensor_local_action_fixed_eq_one
    (K B W : Subgroup H) [W.Normal] [IsElementaryAbelian 2 W]
    (hBK : B ≤ K)
    (hKN : K.map (actionMk W) ≤ offenderSubgroup (action W))
    [IsQuasisimple (K.map (actionMk W))]
    (h : ChapterB.SourceInduction.ProjectiveLine.QuasisimpleSourceConclusion
      ((action W).comp (offenderSubgroup (action W)).subtype)
      ((K.map (actionMk W)).subgroupOf (offenderSubgroup (action W))))
    (R : Sylow 2 (K.map (actionMk W)))
    (hBI : (B.map (actionMk W)).subgroupOf (K.map (actionMk W)) ∈ localCComponents R)
    (hproper : (B.map (actionMk W)).subgroupOf (K.map (actionMk W)) < ⊤)
    (eBI : (((B.map (actionMk W)).subgroupOf (K.map (actionMk W))) ⧸
      pCore 2 ((B.map (actionMk W)).subgroupOf (K.map (actionMk W)))) ≃*
        alternatingGroup (Fin 5))
    (hkerB : IsPGroup 2 ((actionMk W).subgroupMap B).ker)
    (A : Subgroup H) (hAW : A ≤ W) (hm : ⁅A,B⁆ = A)
    (hc : B.pCoreIn 2 ≤ centralizer (A : Set H))
    (x : H) (hxA : x ∈ A) (hxK : x ∈ centralizer (K : Set H)) : x = 1 := by
  let q := actionMk W
  let ρ := action W
  let N := offenderSubgroup ρ
  let I := K.map q
  let C := I.subgroupOf N
  let BI := (B.map q).subgroupOf I
  let i : I ≃* C := (subgroupOfEquivOfLe hKN).symm
  let E := BI.map i.toMonoidHom
  let AS := subgroupSpace W A
  have hBIle : B.map q ≤ I := map_mono hBK
  let : IsQuasisimple C := IsQuasisimple.of_mulEquiv i
  obtain ⟨hEproper,⟨eE⟩,hElocal⟩ := source_tensor_local_image_in_offender K W hKN R BI
    hBI hproper eBI
  have hCmap : C.map N.subtype = I := map_subgroupOf_eq_of_le hKN
  have hEMap : (E.map C.subtype).map N.subtype = B.map q := by
    rw [map_map]
    change (BI.map i.toMonoidHom).map (N.subtype.comp C.subtype) = B.map q
    rw [map_map]
    have he : (N.subtype.comp C.subtype).comp i.toMonoidHom = I.subtype := rfl
    rw [he]
    exact map_subgroupOf_eq_of_le hBIle
  have hcoreq : (B.pCoreIn 2).map q = (B.map q).pCoreIn 2 := by
    have hpre := (q.subgroupMap B).comap_pCore_of_ker_isPGroup
      (q.subgroupMap_surjective B) hkerB
    have him : (pCore 2 B).map (q.subgroupMap B) = pCore 2 (B.map q) := by
      rw [← hpre, map_comap_eq_self]
      rw [MonoidHom.range_eq_top_of_surjective _ (q.subgroupMap_surjective B)]
      exact le_top
    calc
      _ = ((pCore 2 B).map (q.subgroupMap B)).map (B.map q).subtype := by
        rw [pCoreIn, map_map, map_map]
        rfl
      _ = _ := by rw [him]; rfl
  have hcoreE : ((E.pCoreIn 2).map C.subtype).map N.subtype = (B.map q).pCoreIn 2 := by
    rw [map_pCoreIn_of_injective 2 _ _ C.subtype_injective,
      map_pCoreIn_of_injective 2 _ _ N.subtype_injective, hEMap]
  have hcomm : subspaceCommutator ρ AS (B.map q) = AS := by
    change subspaceCommutator (representation W q (QuotientGroup.mk'_surjective _)
      (QuotientGroup.ker_mk' _)) (subgroupSpace W A) (B.map q) = subgroupSpace W A
    rw [← subgroupSpace_commutator W q (QuotientGroup.mk'_surjective _)
      (QuotientGroup.ker_mk' _) A B hAW, hm]
  have hAS : AS ≤ ChapterB.QuasisimpleSource.moved (ρ.comp N.subtype) C := by
    change AS ≤ subspaceCommutator (ρ.comp N.subtype) ⊤ C
    rw [subspaceCommutator_comp_map, hCmap, ← hcomm]
    apply Submodule.span_mono
    rintro v ⟨b,hb,w,hw,rfl⟩
    exact ⟨b,hBIle hb,w,Submodule.mem_top,rfl⟩
  have hcore : AS ≤ fixedSpace ((ρ.comp N.subtype).comp C.subtype) (E.pCoreIn 2) := by
    rw [fixedSpace_comp_map, fixedSpace_comp_map, hcoreE, ← hcoreq]
    exact subgroupSpace_fixed_of_centralizes W q (QuotientGroup.mk'_surjective _)
      (QuotientGroup.ker_mk' _) A (B.pCoreIn 2) hc
  have hmove : subspaceCommutator ((ρ.comp N.subtype).comp C.subtype) AS E = AS := by
    rw [subspaceCommutator_comp_map, subspaceCommutator_comp_map, hEMap, hcomm]
  let v : Additive W := Additive.ofMul ⟨x,hAW hxA⟩
  have hv : v ∈ AS := hxA
  have hfix : v ∈ fixedSpace (ρ.comp N.subtype) C := by
    rw [fixedSpace_comp_map, hCmap]
    exact (ChapterB.InternalThompsonAction.mem_fixedSpace_iff W K v).mpr hxK
  have hz := SourceA5TensorExclusion.source_five_local_moved_fixed_eq_zero
    (ρ.comp N.subtype) C h (R.mapSurjective (f := i.toMonoidHom) i.surjective)
    E hElocal hEproper.ne eE AS hAS hcore hmove v hv hfix
  exact congrArg (fun w : Additive W => (w.toMul : H)) hz
end CFSG.Quasithin.Chapter10
