/-!
# The literal common two-subgroup in the tensor overgroup

Put S = (T ∩ L₀)O₂(L₀T), K = O²(H), and M₀ = ⟨L,K,N_T(L)⟩.
The original Sylow and Borel normalize S. The group ⟨L,K,S⟩ is normal
in M₀, so a zero two-core in M₀ gives the genuine zero-core condition
of F.1.1. Cartan normalization makes HA characteristic two; the 9.3.2
core relation and Borel enclosures then give both local characteristic-two
conditions and the literal local Sylow markings.

The final theorem constructs corrected F.1.1, quasithinness, both A₅
quotients, and Borel normalization. The earlier core relation and Borel
enclosures remain explicit here; the source adapter discharges them.
This does not assert the independent F.1.12 rank-two recognition.
Source: Aschbacher--Smith, 9.3.2--3, printed p.733; F.1.1 and F.1.12,
printed pp.259 and262--264.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter10
open Chapter3.Section02

namespace SourceOldResidualOvergroup
variable {G : Type*} [Group G]

/-- The common two-subgroup `T_L Q` in original 9.3.2--3. -/
@[expose] def commonTwo (T : Sylow 2 G) (L : Subgroup G) : Subgroup G :=
  ((T : Subgroup G) ⊓ localOrbit T L) ⊔ (localJoin T L).pCoreIn 2

/-- The group generated by the two original factors and the source common two-subgroup. -/
@[expose] def generated (T : Sylow 2 G) (L H : Subgroup G) : Subgroup G :=
  (L ⊔ (pResidual 2 H).map H.subtype) ⊔ commonTwo T L

end SourceOldResidualOvergroup

namespace SourceA5TensorModel
open SourceOldResidualOvergroup
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L : Subgroup G}
  {D : FundamentalSetup KnownSimple.IsKnownSimple T L}
  {e : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 5)}
  (m : SourceA5TensorModel D e)

include m in
theorem old_residual_commonTwo_le_stabilizer :
    commonTwo T L ≤ (T : Subgroup G) ⊓ normalizer (L : Set G) := by
  have hQ : (localJoin T L).pCoreIn 2 ≤
      (T : Subgroup G) ⊓ normalizer (L : Set G) := by
    rw [show localJoin T L = L ⊔ (T : Subgroup G) from componentOrbit_sup L T]
    exact Chapter1.Section02.local_join_twoCore_le_sylow_stabilizer D.maximal.1
  exact sup_le (le_inf inf_le_left (inf_le_right.trans
    (source_nonnormal_orbit_le_normalizer D m.sylow_not_normalizes_component))) hQ

omit [Finite G] in
theorem old_residual_commonTwo_normalized :
    (T : Subgroup G) ≤ normalizer (commonTwo T L : Set G) := by
  have hR : (T : Subgroup G) ≤ normalizer
      (((T : Subgroup G) ⊓ localOrbit T L : Subgroup G) : Set G) :=
    (le_inf (T : Subgroup G).le_normalizer (le_normalizer_componentOrbit L T)).trans
      inf_normalizer_le_normalizer_inf
  have hQ : (T : Subgroup G) ≤ normalizer ((localJoin T L).pCoreIn 2 : Set G) :=
    (show (T : Subgroup G) ≤ localJoin T L from le_sup_right).trans
      ((localJoin T L).le_normalizer.trans
        (normalizer_le_normalizer_characteristic_image (localJoin T L)
          (pCore 2 (localJoin T L))))
  exact (le_inf hR hQ).trans (normalizer_inf_normalizer_le_normalizer_sup _ _)

omit [Finite G] in
theorem old_residual_commonTwo_borel_normalized :
    sourceOrbitBorel T L ≤ normalizer (commonTwo T L : Set G) := by
  have hA : sourceOrbitBorel T L ≤ localOrbit T L := (map_subtype_le _).trans inf_le_left
  have hR : sourceOrbitBorel T L ≤ normalizer
      (((T : Subgroup G) ⊓ localOrbit T L : Subgroup G) : Set G) :=
    (map_subtype_le _).trans inf_le_right
  have hQ : sourceOrbitBorel T L ≤ normalizer ((localJoin T L).pCoreIn 2 : Set G) :=
    hA.trans ((show localOrbit T L ≤ localJoin T L from le_sup_left).trans
      ((localJoin T L).le_normalizer.trans
        (normalizer_le_normalizer_characteristic_image (localJoin T L)
          (pCore 2 (localJoin T L)))))
  exact (le_inf hR hQ).trans (normalizer_inf_normalizer_le_normalizer_sup _ _)

include m in
theorem old_residual_commonTwo_isPGroup : IsPGroup 2 (commonTwo T L) :=
  T.isPGroup'.to_le (m.old_residual_commonTwo_le_stabilizer.trans inf_le_left)

theorem old_residual_commonTwo_generated_normalized
    {H : Subgroup G} (hH : H ∈ Chapter3.HStar (T : Subgroup G) D.maximalLocal) :
    ((T : Subgroup G) ⊓ normalizer (L : Set G)) ≤
      normalizer (SourceOldResidualOvergroup.generated T L H : Set G) := by
  have hK : (T : Subgroup G) ≤ normalizer ((pResidual 2 H).map H.subtype : Set G) :=
    hH.1.1.2.trans (le_normalizer_embedded_pResidual 2 H)
  have hLK := (le_inf (show (T : Subgroup G) ⊓ normalizer (L : Set G) ≤
      normalizer (L : Set G) from inf_le_right) (inf_le_left.trans hK)).trans
    (normalizer_inf_normalizer_le_normalizer_sup _ _)
  exact (le_inf hLK (inf_le_left.trans (old_residual_commonTwo_normalized (T := T) (L := L)))).trans
    (normalizer_inf_normalizer_le_normalizer_sup _ _)

include m in
theorem old_residual_commonTwo_generated_core_eq_bot
    {H : Subgroup G} (hH : H ∈ Chapter3.HStar (T : Subgroup G) D.maximalLocal)
    (M₀ : Subgroup G)
    (hgen : M₀ = (L ⊔ (pResidual 2 H).map H.subtype) ⊔
      ((T : Subgroup G) ⊓ normalizer (L : Set G)))
    (hzero : pCore 2 M₀ = ⊥) :
    pCore 2 (SourceOldResidualOvergroup.generated T L H) = ⊥ := by
  let X := SourceOldResidualOvergroup.generated T L H
  have hXM : X ≤ M₀ := by
    rw [hgen]
    exact sup_le_sup_left m.old_residual_commonTwo_le_stabilizer _
  have hn : M₀ ≤ normalizer (X : Set G) := by
    rw [hgen]
    exact sup_le ((show L ⊔ (pResidual 2 H).map H.subtype ≤ X from le_sup_left).trans
      X.le_normalizer) (old_residual_commonTwo_generated_normalized hH)
  have hc : X.pCoreIn 2 = ⊥ := by
    apply bot_unique
    have hh := pCoreIn_mono_of_normalizes (p := 2) hXM hn
    simpa only [pCoreIn,hzero,Subgroup.map_bot] using hh
  exact (map_eq_bot_iff_of_injective _ X.subtype_injective).mp hc

/-- Once the source Cartan normalizes K, its join with H is characteristic two.
The nonzero core is derived from the original normal residual inside H. -/
theorem old_residual_cartan_join_mem_He_of_normalizes
    {H : Subgroup G} (hH : H ∈ Chapter3.HStar (T : Subgroup G) D.maximalLocal)
    (A : Subgroup G)
    (hAK : A ≤ normalizer ((pResidual 2 H).map H.subtype : Set G)) :
    H ⊔ A ∈ Chapter1.He G := by
  let K := (pResidual 2 H).map H.subtype
  have hKne : K ≠ ⊥ := by
    intro he
    apply source_hstar_residual_not_le (le_normalizer_componentOrbit L T) hH
    rw [show (pResidual 2 H).map H.subtype = ⊥ from he]
    exact bot_le
  have hHK : H ≤ normalizer (K : Set G) := le_normalizer_embedded_pResidual 2 H
  have hHHe : H ∈ Chapter1.He G :=
    Chapter1.lemma_1_1_4_6 T (D.simpleQTKE.evenCharacteristic T) hH.1.1
  have hKHe : K ∈ Chapter1.He G :=
    Chapter1.lemma_1_1_3_1 hHHe hKne (map_subtype_le _)
      (normal_subgroupOf_of_le_normalizer hHK).isSubnormal
  have hKcore : K.pCoreIn 2 ≠ ⊥ := by
    intro he
    apply hKne
    apply bot_unique
    intro k hk
    have hkc : k ∈ K ⊓ centralizer (K.pCoreIn 2 : Set G) := by
      refine ⟨hk,?_⟩
      intro q hq
      have hq1 : q = 1 := mem_bot.mp (he ▸ hq)
      simp only [hq1,mul_one,one_mul]
    exact he ▸ hKHe hkc
  have hc : K.pCoreIn 2 ≤ (H ⊔ A : Subgroup G).pCoreIn 2 :=
    pCoreIn_mono_of_normalizes ((map_subtype_le _).trans le_sup_left)
      (sup_le hHK hAK)
  apply Chapter1.lemma_1_1_4_6 T (D.simpleQTKE.evenCharacteristic T)
  refine ⟨?_,(show (T : Subgroup G) ≤ H from hH.1.1.2).trans le_sup_left⟩
  intro he
  exact hKcore (bot_unique (hc.trans_eq he))

private theorem characteristicTwo_of_core_interval (X Y : Subgroup G)
    (hY : Y ∈ Chapter1.He G) (hXY : X ≤ Y) (hQX : Y.pCoreIn 2 ≤ X) :
    generalizedFitting X = pCore 2 X := by
  have hQ : pCore 2 Y ≤ X.subgroupOf Y := by
    intro x hx
    exact hQX (mem_map_of_mem Y.subtype hx)
  exact generalizedFitting_eq_pCore_of_selfCentralizing 2
    ((Theory.Quasithin.centralizer_pCore_le_iff 2 (subgroupOfEquivOfLe hXY)).mp
      (centralizer_pCore_le_of_pCore_le (X.subgroupOf Y) (Chapter1.mem_He_iff.mp hY) hQ))

include m in
/-- The local characteristic-two clauses of F.1.1 follow from the literal
9.3.2 core containment and the common Cartan enclosure of the opposite Borels. -/
theorem old_residual_pair_characteristicTwo
    {H : Subgroup G} (hH : H ∈ Chapter3.HStar (T : Subgroup G) D.maximalLocal)
    (A : Subgroup G) (hAB : A ≤ sourceOrbitBorel T L)
    (hAK : A ≤ normalizer ((pResidual 2 H).map H.subtype : Set G))
    (hQ : (H ⊔ A : Subgroup G).pCoreIn 2 ≤ commonTwo T L)
    (hB : ∀ i : Fin 2, ChapterF.Source.borel
      (![L,(pResidual 2 H).map H.subtype] i) (commonTwo T L) ≤ A ⊔ commonTwo T L) :
    ∀ i : Fin 2, generalizedFitting (ChapterF.Source.parabolic
      ![L,(pResidual 2 H).map H.subtype] (commonTwo T L) i) =
      pCore 2 (ChapterF.Source.parabolic
        ![L,(pResidual 2 H).map H.subtype] (commonTwo T L) i) := by
  have hST := m.old_residual_commonTwo_le_stabilizer.trans inf_le_left
  have hAL : A ≤ localOrbit T L := hAB.trans ((map_subtype_le _).trans inf_le_left)
  have hSJ : commonTwo T L ≤ localJoin T L := hST.trans le_sup_right
  have hAX : A ≤ H ⊔ A := le_sup_right
  have hSX : commonTwo T L ≤ H ⊔ A := hST.trans
    ((show (T : Subgroup G) ≤ H from hH.1.1.2).trans le_sup_left)
  intro i
  fin_cases i
  · apply characteristicTwo_of_core_interval _ (localJoin T L) (localJoin_mem_He D)
    · exact sup_le (sup_le ((le_componentOrbit L T).trans le_sup_left) hSJ)
        ((hB 1).trans (sup_le (hAL.trans le_sup_left) hSJ))
    · exact (show (localJoin T L).pCoreIn 2 ≤ commonTwo T L from le_sup_right).trans
        (le_sup_of_le_left le_sup_right)
  · apply characteristicTwo_of_core_interval _ (H ⊔ A)
      (old_residual_cartan_join_mem_He_of_normalizes hH A hAK)
    · exact sup_le (sup_le ((map_subtype_le _).trans le_sup_left) hSX)
        ((hB 0).trans (sup_le hAX hSX))
    · exact hQ.trans (le_sup_of_le_left le_sup_right)

private theorem rankOneModel_of_a5 {X : Type*} [Group X]
    (f : (X ≃* alternatingGroup (Fin 5))) : ChapterF.Source.IsRankOneModel X := by
  have h4 : Nat.card (GaloisField 2 2) = 4 := by
    rw [GaloisField.card 2 2 (by decide)]
    norm_num
  obtain ⟨a⟩ := Matrix.ProjectiveSpecialLinearGroup.equiv_alternatingGroup_of_card_four h4
  apply ChapterF.Source.IsRankOneModel.linear 2 (by decide)
  exact ⟨GaloisField 2 2,inferInstance,inferInstance,by simpa using h4,⟨f.trans a.symm⟩⟩

include m in
/-- The zero-core case gives the genuine F.1.1 pair on the original L and K.
The only local preparation retained here is 9.3.2's core factorization and
the enclosure of both Sylow normalizers by the original Cartan and S. -/
theorem old_residual_core_zero_rank_two_data
    {H : Subgroup G} (hH : H ∈ Chapter3.HStar (T : Subgroup G) D.maximalLocal)
    (eK : ((pResidual 2 H).map H.subtype ⧸
      pCore 2 ((pResidual 2 H).map H.subtype)) ≃* alternatingGroup (Fin 5))
    (A : Subgroup G) (hAB : A ≤ sourceOrbitBorel T L)
    (hAK : A ≤ normalizer ((pResidual 2 H).map H.subtype : Set G))
    (hS : commonTwo T L = ((T : Subgroup G) ⊓ (pResidual 2 H).map H.subtype) ⊔
      (H ⊔ A : Subgroup G).pCoreIn 2)
    (hB : ∀ i : Fin 2, ChapterF.Source.borel
      (![L,(pResidual 2 H).map H.subtype] i) (commonTwo T L) ≤ A ⊔ commonTwo T L)
    (M₀ : Subgroup G)
    (hgen : M₀ = (L ⊔ (pResidual 2 H).map H.subtype) ⊔
      ((T : Subgroup G) ⊓ normalizer (L : Set G)))
    (hzero : pCore 2 M₀ = ⊥) :
    ChapterF.Source.HypothesisF11 ![L,(pResidual 2 H).map H.subtype] (commonTwo T L) ∧
    IsQuasithin (ChapterF.Source.generated ![L,(pResidual 2 H).map H.subtype] (commonTwo T L)) ∧
    (∀ i : Fin 2, Nonempty ((![L,(pResidual 2 H).map H.subtype] i ⧸
      pCore 2 (![L,(pResidual 2 H).map H.subtype] i)) ≃* alternatingGroup (Fin 5))) ∧
    (∀ i : Fin 2, ChapterF.Source.borel
      (![L,(pResidual 2 H).map H.subtype] i) (commonTwo T L) ≤
        normalizer (commonTwo T L : Set G)) := by
  let K := (pResidual 2 H).map H.subtype
  let S := commonTwo T L
  have hST : S ≤ (T : Subgroup G) := m.old_residual_commonTwo_le_stabilizer.trans inf_le_left
  have hSL : S ≤ normalizer (L : Set G) := m.old_residual_commonTwo_le_stabilizer.trans inf_le_right
  have hTK : (T : Subgroup G) ≤ normalizer (K : Set G) :=
    hH.1.1.2.trans (le_normalizer_embedded_pResidual 2 H)
  have hSK : S ≤ normalizer (K : Set G) := hST.trans hTK
  have hAL : A ≤ normalizer (L : Set G) :=
    hAB.trans (((map_subtype_le _).trans inf_le_left).trans
      (source_nonnormal_orbit_le_normalizer D m.sylow_not_normalizes_component))
  have hn (i : Fin 2) : A ⊔ S ≤ normalizer (![L,K] i : Set G) := by
    fin_cases i
    · exact sup_le hAL hSL
    · exact sup_le hAK hSK
  have hsiL : S ⊓ L = (T : Subgroup G) ⊓ L := by
    apply le_antisymm (inf_le_inf_right L hST)
    exact le_inf ((inf_le_inf_left _ (le_componentOrbit L T)).trans le_sup_left) inf_le_right
  have hsiK : S ⊓ K = (T : Subgroup G) ⊓ K := by
    apply le_antisymm (inf_le_inf_right K hST)
    exact le_inf (le_sup_left.trans_eq hS.symm) inf_le_right
  have hSyl : ∀ i : Fin 2, ∃ P : Sylow 2 (![L,K] i),
      (P : Subgroup (![L,K] i)).map (![L,K] i).subtype = S ⊓ ![L,K] i := by
    intro i
    fin_cases i
    · change ∃ P : Sylow 2 L, (P : Subgroup L).map L.subtype = S ⊓ L
      rw [hsiL]
      exact m.old_residual_component_sylow
    · change ∃ P : Sylow 2 K, (P : Subgroup K).map K.subtype = S ⊓ K
      rw [hsiK]
      exact Chapter1.Section02.IndexTwo.isSylowIn_inf_of_subnormal
        (show Chapter1.IsSylowIn 2 (T : Subgroup G) H from
          ⟨T.subtype hH.1.1.2,map_subgroupOf_eq_of_le hH.1.1.2⟩)
        (map_subtype_le _) (normal_subgroupOf_of_le_normalizer
          (le_normalizer_embedded_pResidual 2 H)).isSubnormal
  have hq (i : Fin 2) : Nonempty ((![L,K] i ⧸ pCore 2 (![L,K] i)) ≃*
      alternatingGroup (Fin 5)) := by
    fin_cases i
    · exact ⟨e⟩
    · exact ⟨eK⟩
  have hf : ChapterF.Source.HypothesisF11 ![L,K] S := by
    refine ⟨inferInstance,m.old_residual_commonTwo_isPGroup,?_,hSyl,?_,?_,?_,?_⟩
    · intro i
      exact (show S ≤ A ⊔ S from le_sup_right).trans (hn i)
    · exact fun i => rankOneModel_of_a5 (hq i).some
    · intro i
      exact (hB (ChapterF.Source.other i)).trans (hn i)
    · exact m.old_residual_commonTwo_generated_core_eq_bot hH M₀ hgen hzero
    · exact m.old_residual_pair_characteristicTwo hH A hAB hAK
        (le_sup_right.trans_eq hS.symm) hB
  refine ⟨hf,D.simpleQTKE.quasithin.subgroup _,hq,?_⟩
  intro i
  exact (hB i).trans (sup_le
    (hAB.trans (old_residual_commonTwo_borel_normalized (T := T) (L := L))) S.le_normalizer)

end SourceA5TensorModel
