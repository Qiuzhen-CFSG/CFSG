module
public import CFSG.Quasithin.Chapter10.SourceA5NaturalGeneration.BlockRecovery.Center
public import CFSG.Quasithin.Chapter10.SourceA5NaturalGeneration.SourceMovement.OriginalSetup
public import CFSG.Quasithin.Chapter10.SourceA5ActionKernel
public import CFSG.Quasithin.ChapterE.Section02.ThompsonAction.CompleteSource
public import CFSG.Quasithin.ChapterE.Section02.ThompsonAction.PairSourceOrbitSpan
public import Theory.GroupTheory.CComponent.QuasisimpleResidualNormal
/-!
# The original entire two-core is generated by its residual action

The commuting block pair and vanishing common Sylow-center fixed subgroup
make the full local two-core elementary. Its centralizer equals the core,
so it is reduced. Original 10.2.2 Thompson movement passes from the chosen
module to this entire core. Applying complete B.5/E.2.3 classification,
the single-factor alternative would make the original component normal.
For the remaining pair, residual moved-plus-fixed generation and the zero
fixed-center hypothesis imply Q = [Q,O²(L₀T)]. This controls extra core
layers without identifying the chosen module with the entire core.

Source: Aschbacher--Smith 10.2.2(1), 10.2.3(4), pp.744 and 746--747,
and E.2.3/B.6.9, pp.216--217 and115--116.
-/
public section
open Subgroup Theory.GroupTheory Stellmacher Representation Representation.BinaryOffender
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter10
open Chapter3.Section02 ChapterC
universe u
variable {G : Type u} [Group G] [Finite G] {T : Sylow 2 G} {L : Subgroup G}
  (D : FundamentalSetup KnownSimple.IsKnownSimple T L)
include D

theorem source_original_full_core_centralizer
    (e : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 5))
    (hn : ¬ (T : Subgroup G) ≤ normalizer (L : Set G))
    (hb : IsBlock (L.subgroupOf (localJoin T L)))
    (hz : omegaOneCenterAmbient (T : Subgroup G) ⊓ centralizer (localOrbit T L : Set G) = ⊥) :
    centralizer (pCore 2 (localJoin T L) : Set (localJoin T L)) = pCore 2 (localJoin T L) := by
  let := source_original_block_local_core_elementary D hn hb hz
  apply le_antisymm
  · exact (centralizer_le (source_parabolic_module_reduced D).le_pCore).trans_eq
      (source_a5_local_module_kernel_eq_twoCore D e hn)
  · exact le_centralizer_iff_isMulCommutative.mpr inferInstance

theorem source_original_full_core_reduced
    (e : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 5))
    (hn : ¬ (T : Subgroup G) ≤ normalizer (L : Set G))
    (hb : IsBlock (L.subgroupOf (localJoin T L)))
    (hz : omegaOneCenterAmbient (T : Subgroup G) ⊓ centralizer (localOrbit T L : Set G) = ⊥) :
    IsPReduced 2 (pCore 2 (localJoin T L)) := by
  refine ⟨inferInstance,source_original_block_local_core_elementary D hn hb hz,?_⟩
  let f := QuotientGroup.quotientMulEquivOfEq
    (source_original_full_core_centralizer D e hn hb hz).symm
  rw [←pCore_map_iso 2 f,pCore_quotient_pCore_eq_bot,Subgroup.map_bot]

theorem source_original_full_core_thompson_moves
    {H : Subgroup G} (hH : H ∈ Chapter3.HStar (T : Subgroup G) D.maximalLocal)
    (hZH : ⁅omegaOneCenterAmbient (T : Subgroup G), H⁆ ≠ ⊥) :
    ¬ elementaryAbelianMaxJ
      (T.subtype (show (T : Subgroup G) ≤ localJoin T L from le_sup_right) : Subgroup (localJoin T L)) ≤
        centralizer (pCore 2 (localJoin T L) : Set (localJoin T L)) := by
  let X := localJoin T L
  let S := T.subtype (show (T : Subgroup G) ≤ X from le_sup_right)
  intro hc
  have hU := hc.trans (centralizer_le (source_parabolic_module_reduced D).le_pCore)
  apply source_hstar_thompson_moves_of_omega_commutator D hH hZH
  have hjmap : (elementaryAbelianMaxJ (S : Subgroup X)).map X.subtype =
      elementaryAbelianMaxJ (T : Subgroup G) := by
    rw [←elementaryAbelianMaxJ_map_injective X.subtype X.subtype_injective]
    exact congrArg elementaryAbelianMaxJ (map_subgroupOf_eq_of_le le_sup_right)
  rw [←hjmap]
  rintro g ⟨j,hj,rfl⟩ z hz
  exact congrArg X.subtype (hU hj
    ⟨z,(D.module_le_core.trans (pCoreIn_le 2 X)) hz⟩ hz)

theorem source_original_full_core_ff
    (hn : ¬ (T : Subgroup G) ≤ normalizer (L : Set G))
    (hb : IsBlock (L.subgroupOf (localJoin T L)))
    (hz : omegaOneCenterAmbient (T : Subgroup G) ⊓ centralizer (localOrbit T L : Set G) = ⊥)
    {H : Subgroup G} (hH : H ∈ Chapter3.HStar (T : Subgroup G) D.maximalLocal)
    (hZH : ⁅omegaOneCenterAmbient (T : Subgroup G), H⁆ ≠ ⊥) :
    let Q := pCore 2 (localJoin T L)
    letI := source_original_block_local_core_elementary D hn hb hz
    let C := centralizer (Q : Set (localJoin T L))
    IsFFModule (NormalElementaryQuotient.representation Q (QuotientGroup.mk' C)
      (QuotientGroup.mk'_surjective C) (QuotientGroup.ker_mk' C)) := by
  let X := localJoin T L
  let Q := pCore 2 X
  let S := T.subtype (show (T : Subgroup G) ≤ X from le_sup_right)
  let := source_original_block_local_core_elementary D hn hb hz
  exact NormalElementaryQuotient.isFFModule_of_thompson_not_le Q _
    (QuotientGroup.mk'_surjective _) (QuotientGroup.ker_mk' _) (S : Subgroup X)
    (pCore_isPGroup.le_sylow_of_normal S)
    (by simpa only [QuotientGroup.ker_mk'] using
      source_original_full_core_thompson_moves D hH hZH)


private theorem original_full_core_fixed_residual
    (hz : omegaOneCenterAmbient (T : Subgroup G) ⊓ centralizer (localOrbit T L : Set G) = ⊥) :
    pCore 2 (localJoin T L) ⊓ centralizer (pResidual 2 (localJoin T L) : Set (localJoin T L)) = ⊥ := by
  let X := localJoin T L
  apply (map_eq_bot_iff_of_injective _ X.subtype_injective).mp
  apply bot_unique
  apply le_trans ?_ (source_orbit_core_centralizer_eq_bot hz).le
  apply le_inf (map_mono inf_le_left)
  have hh := (map_mono (f := X.subtype) (show
    pCore 2 X ⊓ centralizer (pResidual 2 X : Set X) ≤
      centralizer (pResidual 2 X : Set X) from inf_le_right)).trans
    (map_centralizer_le_centralizer_image _ X.subtype)
  change _ ≤ centralizer ((pResidual 2 X).map X.subtype : Set G) at hh
  rwa [source_join_residual D] at hh

/-- Actual movement and vanishing fixed center make the entire core residual-generated. -/
theorem source_original_full_core_moved
    (e : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 5))
    (hn : ¬ (T : Subgroup G) ≤ normalizer (L : Set G))
    (hb : IsBlock (L.subgroupOf (localJoin T L)))
    (hz : omegaOneCenterAmbient (T : Subgroup G) ⊓ centralizer (localOrbit T L : Set G) = ⊥)
    {H : Subgroup G} (hH : H ∈ Chapter3.HStar (T : Subgroup G) D.maximalLocal)
    (hZH : ⁅omegaOneCenterAmbient (T : Subgroup G), H⁆ ≠ ⊥) :
    pCore 2 (localJoin T L) = ⁅pCore 2 (localJoin T L),pResidual 2 (localJoin T L)⁆ := by
  let X := localJoin T L
  let S := T.subtype (show (T : Subgroup G) ≤ X from le_sup_right)
  let Q := pCore 2 X
  have hQ : IsPReduced 2 Q := source_original_full_core_reduced D e hn hb hz
  let := hQ.normal
  let := hQ.elementary
  let C := centralizer (Q : Set X)
  let q := QuotientGroup.mk' C
  have hq := QuotientGroup.mk'_surjective C
  have hk : q.ker = C := QuotientGroup.ker_mk' C
  let α := NormalElementaryQuotient.representation Q q hq hk
  let Y := offenderSubgroup α
  let := offenderSubgroup_normal α
  have hJ := source_original_full_core_thompson_moves D hH hZH
  have hP := source_a5_minimal_parabolic D e hn
  have hu := Chapter1.Section02.nonsolvable_uniqueness_of_theoremsAC
    (fun Z _ _ => ChapterA.Section02.theoremA_knownSimple (G := Z))
    (fun Z _ _ => ChapterA.Section02.theoremC_knownSimple (G := Z))
    D.simpleQTKE T D.maximal
  have hs := ChapterE.ThompsonAction.source_nonsolvable_natural_factors
    (D.local_internal_module hu).sqtk S hP Q hQ (source_join_not_solvable D) hJ
  rcases hs with ⟨hqs,_⟩ | ⟨d,_,_⟩
  · have hcore : pCore 2 (X ⧸ C) = ⊥ := hQ.quotient_pCore_eq_bot
    have hne : q.ker ≠ ⊤ := by
      intro he
      apply hJ
      change elementaryAbelianMaxJ (S : Subgroup X) ≤ C
      rw [←hk,he]
      exact le_top
    have hp := (ChapterB.minimalParabolic_reduced_image S hP q hq hcore hne).2
    have hff : IsFFModule α := source_original_full_core_ff D hn hb hz hH hZH
    have hr := (ChapterB.source_quasisimple_fitting_eq_residual (S.mapSurjective hq) hp Y
      (ChapterB.offender_generation (S.mapSurjective hq) hp α hff hcore).2 hqs).2
    have hker : q.ker ≤ ChapterB.minimalParabolicCore S hP := by
      rw [hk]
      exact ChapterB.RankOneBaumann.reduced_centralizer_le_core S hP Q hQ hJ
    let : Group.IsSolvable (ChapterB.minimalParabolicCore S hP) :=
      ChapterB.minimalParabolic_core_solvable S hP
    let : Group.IsSolvable q.ker := Group.isSolvable_of_isSolvable_injective (inclusion_injective hker)
    have hL : (L.subgroupOf X).IsCComponent := by
      change (L.subgroupOf (componentOrbit L (T : Subgroup G) ⊔ (T : Subgroup G))).IsCComponent
      rw [componentOrbit_sup]
      exact D.maximal.1.1
    have hnormal := hL.normal_of_solvable_kernel_quasisimple_residual _ q hq hr
    exact (hn (le_sup_right.trans ((normal_subgroupOf_iff_le_normalizer
      ((le_componentOrbit L T).trans le_sup_left)).mp hnormal))).elim
  · have hh := ChapterE.ThompsonAction.paired_module_le_moved_sup_alpha_fixed
      S hP Q hQ hJ q hq hk d Q inf_le_left
    rw [original_full_core_fixed_residual D hz,sup_bot_eq] at hh
    exact le_antisymm hh (commutator_le_left _ _)
end CFSG.Quasithin.Chapter10
