module

public import CFSG.Quasithin.Chapter1.Section02.LocalComponents.Quotients
public import CFSG.Quasithin.ChapterA.Section03.SourceComponents.Containment.KnownSimple
public import CFSG.Quasithin.ChapterA.Section03.SourceEmbeddings.Restriction
public import Theory.GroupTheory.Commutator.SubnormalAbsorption

/-!
# The actual common component of the two natural blocks

Unique source containment selects the component containing the first block.
The second block is generated by its commutators with a subgroup of the first,
so subnormal absorption places it in that same component. Restricting the
original Sylow gives the literal local-component family inside this component.
The common Sylow of the two blocks is not assumed Sylow in the larger component.

Source: Aschbacher--Smith 10.2.3(4), printed p.747, using 1.2.4 and A.3.12.
-/

public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter10
open Chapter1.Section02
universe u
variable {G : Type u} [Group G] [Finite G]

/-- The original commutator movement constructs a common C-component; no
proper-embedding classification is assumed. -/
theorem source_natural_pair_common_component
    (hQ : IsSQTK KnownSimple.IsKnownSimple (G ⧸ pCore 2 G))
    (T : Sylow 2 G) {L K D : Subgroup G}
    (hL : L ∈ Chapter1.L G T) (hDL : D ≤ L) (hmove : ⁅K, D⁆ = K) :
    ∃! C : Subgroup G, C.IsCComponent ∧ L ≤ C ∧ K ≤ C := by
  obtain ⟨C, ⟨hC, hLC⟩, hu⟩ := lemma_1_2_4_containment_of_A_3_12
    (fun _ _ _ hX hO S B hB =>
      ChapterA.Section03.SourceComponents.containment_knownSimple hX hO S B hB)
    hQ T hL
  have hKC : K ≤ C := le_of_isSubnormal_of_le_commutator K C hC.subnormal
    (hmove.ge.trans (commutator_mono le_rfl (hDL.trans hLC)))
  exact ⟨C, ⟨hC, hLC, hKC⟩, fun E hE => hu E ⟨hE.1, hE.2.1⟩⟩

/-- Distinct blocks of equal order give a genuinely larger common component.
Both remain local components for the full intersection with the original Sylow. -/
theorem source_natural_pair_proper_common_component
    (hQ : IsSQTK KnownSimple.IsKnownSimple (G ⧸ pCore 2 G))
    (T : Sylow 2 G) {L K D : Subgroup G}
    (hL : L ∈ Chapter1.L G T) (hK : K ∈ Chapter1.L G T)
    (hDL : D ≤ L) (hmove : ⁅K, D⁆ = K)
    (hne : L ≠ K) (hcard : Nat.card L = Nat.card K) :
    ∃ C : Subgroup G, C.IsCComponent ∧ L < C ∧ K < C ∧
      (∀ E : Subgroup G, E.IsCComponent → L ≤ E → E = C) ∧
      ∃ S : Sylow 2 C, (S : Subgroup C) = (T : Subgroup G).subgroupOf C ∧
        L.subgroupOf C ∈ ChapterA.Section03.localCComponents S ∧
        K.subgroupOf C ∈ ChapterA.Section03.localCComponents S := by
  obtain ⟨C, ⟨hC, hLC, hKC⟩, hu⟩ :=
    source_natural_pair_common_component hQ T hL hDL hmove
  have hLCstrict : L < C := lt_of_le_of_ne hLC (by
    intro he
    have hKL : K ≤ L := he.symm ▸ hKC
    exact hne (eq_of_le_of_card_ge hKL hcard.le).symm)
  have hKCstrict : K < C := lt_of_le_of_ne hKC (by
    intro he
    have hLK : L ≤ K := he.symm ▸ hLC
    exact hne (eq_of_le_of_card_ge hLK hcard.ge))
  obtain ⟨S, hS, hLS⟩ :=
    ChapterA.Section03.SourceEmbeddings.exists_local_sylow_restriction T hL.1 hLC hC.subnormal
  refine ⟨C, hC, hLCstrict, hKCstrict, ?_, S, hS, hLS, ?_⟩
  · intro E hE hLE
    apply hu E
    exact ⟨hE, hLE, le_of_isSubnormal_of_le_commutator K E hE.subnormal
      (hmove.ge.trans (commutator_mono le_rfl (hDL.trans hLE)))⟩
  · rw [hS]
    exact ChapterA.Section03.SourceEmbeddings.local_restrict hK.1 hKC

/-- Ambient realization at the actual Borel normalizer. The selected component
contains both original blocks as subgroups of the original ambient group. -/
theorem source_borel_normalizer_common_component
    (A L K D : Subgroup G)
    (hQ : IsSQTK KnownSimple.IsKnownSimple
      ((normalizer (A : Set G)) ⧸ pCore 2 (normalizer (A : Set G))))
    (T : Sylow 2 (normalizer (A : Set G)))
    (hL : L.subgroupOf (normalizer (A : Set G)) ∈
      Chapter1.L (normalizer (A : Set G)) T)
    (hLN : L ≤ normalizer (A : Set G)) (hKN : K ≤ normalizer (A : Set G))
    (hDL : D ≤ L) (hmove : ⁅K, D⁆ = K) :
    ∃! C : Subgroup G,
      C ∈ Chapter1.cComponentsIn (normalizer (A : Set G)) ∧ L ≤ C ∧ K ≤ C := by
  let N := normalizer (A : Set G)
  have hKN' : K ≤ N := hKN
  obtain ⟨C, ⟨hC, hLC⟩, hu⟩ :=
    (Chapter1.existsUnique_cComponentsIn_iff hLN).mp
      (lemma_1_2_4_containment_of_A_3_12
        (fun _ _ _ hX hO S B hB =>
          ChapterA.Section03.SourceComponents.containment_knownSimple hX hO S B hB)
        hQ T hL)
  have absorb (E : Subgroup G) (hE : E ∈ Chapter1.cComponentsIn N) (hLE : L ≤ E) : K ≤ E := by
    have hKE : K.subgroupOf N ≤ E.subgroupOf N := by
      apply le_of_isSubnormal_of_le_commutator _ _ hE.2.subnormal
      apply (map_le_map_iff_of_injective N.subtype_injective).mp
      rw [map_commutator, map_subgroupOf_eq_of_le hKN', map_subgroupOf_eq_of_le hE.1]
      exact hmove.ge.trans (commutator_mono le_rfl (hDL.trans hLE))
    simpa only [map_subgroupOf_eq_of_le hKN', map_subgroupOf_eq_of_le hE.1] using
      map_mono (f := N.subtype) hKE
  exact ⟨C, ⟨hC, hLC, absorb C hC hLC⟩, fun E hE => hu E ⟨hE.1, hE.2.1⟩⟩

end CFSG.Quasithin.Chapter10
