module
public import CFSG.Quasithin.Chapter10.SourceA5WeakClosure
public import Theory.GroupTheory.PResidual.SubnormalCoreAction
public import Theory.GroupTheory.PCoreImage
public import Theory.Representation.BinaryConjugationSection.CentralKernel
public import Theory.Representation.BinaryConjugationSection.Descent
public import Theory.Representation.BinaryConjugationSection.Coinvariants

/-!
# Original A₅ markings on the moved full module

The original moved factor W = [V,L] lies in L and is generated by its
L-commutators. Subnormality places O₂(L) in O₂(M), which centralizes the
reduced module V. Thus the original A₅ quotient acts on W and on the literal
quotient W/C_W(L). Both actions are faithful: a trivial quotient action,
followed by commutator idempotence, would contradict W ≠ 1.

The A₅ injection into the full M-induced automizer retains the original
inclusion and quotient map, so outer automorphisms are not discarded.
No escaping-Baumann-normalizer hypothesis is used. Irreducibility of the
central quotient is a separate source3.2.6 obligation, not a conclusion here.
Source: Aschbacher–Smith,3.2.6 and10.1.1, printed pp.581 and741.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
open scoped IsMulCommutative commutatorElement
namespace CFSG.Quasithin.Chapter10
open Chapter3.Section02
universe u
variable {G : Type u} [Group G] [Finite G] {T : Sylow 2 G} {L : Subgroup G}
  (D : FundamentalSetup KnownSimple.IsKnownSimple T L)
include D

private theorem source_uniqueness :
    Chapter1.Section02.NonsolvableUniquenessConclusion T L :=
  Chapter1.Section02.nonsolvable_uniqueness_of_theoremsAC
    (fun X _ _ => ChapterA.Section02.theoremA_knownSimple (G := X))
    (fun X _ _ => ChapterA.Section02.theoremC_knownSimple (G := X))
    D.simpleQTKE T D.maximal

private theorem component_le_maximal : L ≤ D.maximalLocal :=
  (le_componentOrbit L T).trans (localOrbit T L).le_normalizer

/-- The moved factor is contained in the original component. -/
theorem source_full_moved_le_component : ⁅D.fullModule,L⁆ ≤ L := by
  let M := D.maximalLocal
  let A := L.subgroupOf M
  let V := D.fullModule.subgroupOf M
  have hVM : D.fullModule ≤ M := D.fullModule_le_orbit.trans (localOrbit T L).le_normalizer
  have hLM : L ≤ M := component_le_maximal D
  let : V.Normal := normal_subgroupOf_of_le_normalizer D.maximalLocal_normalizes_fullModule
  have hV : IsPGroup 2 V :=
    (D.fullModule_elementary (source_uniqueness D)).isPGroup.comap_of_injective
      M.subtype M.subtype_injective
  have hVN : V ≤ normalizer (A : Set M) := le_normalizer_of_isSubnormal_isPPerfect A V
    D.component_in_maximalLocal.subnormal
      (D.faithful.1.2.1.of_surjective (subgroupOfEquivOfLe hLM).symm.toMonoidHom
        (subgroupOfEquivOfLe hLM).symm.surjective) hV
    le_normalizer_of_normal
  have hc := map_mono (f := M.subtype) (le_normalizer_iff_commutator_le_right.mp hVN)
  simpa only [V,A,map_commutator,map_subgroupOf_eq_of_le hVM,map_subgroupOf_eq_of_le hLM] using hc

/-- The original moved factor is fully moved by L. -/
theorem source_full_moved_eq_commutator : ⁅⁅D.fullModule,L⁆,L⁆ = ⁅D.fullModule,L⁆ := by
  apply commutator_isPPerfect_idempotent L D.fullModule D.faithful.1.2.1
    (D.fullModule_elementary (source_uniqueness D)).isPGroup
  exact (component_le_maximal D).trans D.maximalLocal_normalizes_fullModule

/-- The intrinsic component two-core centralizes the entire original module. -/
theorem source_component_core_centralizes_fullModule :
    L.pCoreIn 2 ≤ centralizer (D.fullModule : Set G) := by
  let M := D.maximalLocal
  let A := L.subgroupOf M
  have hLM : L ≤ M := component_le_maximal D
  have hcore : L.pCoreIn 2 ≤ M.pCoreIn 2 := by
    have hh := map_mono (f := M.subtype)
      (pCoreIn_le_of_subnormal 2 D.component_in_maximalLocal.subnormal)
    rw [map_pCoreIn_of_injective 2 _ _ M.subtype_injective,
      map_subgroupOf_eq_of_le hLM] at hh
    exact hh
  apply hcore.trans
  apply le_centralizer_iff.mpr
  intro v hv q hq
  obtain ⟨v',hv',rfl⟩ := D.fullModule_le_reduced (source_uniqueness D) hv
  obtain ⟨q',hq',rfl⟩ := hq
  exact congrArg Subtype.val (reducedPSubgroup_le_centralizer_pCore 2 M hv' q' hq')

/-- The original moved factor is elementary abelian. -/
theorem source_original_full_moved_elementary : IsElementaryAbelian 2 (⁅D.fullModule,L⁆ : Subgroup G) := by
  let := D.fullModule_elementary (source_uniqueness D)
  exact IsElementaryAbelian.of_le (le_normalizer_iff_commutator_le_left.mp
    ((component_le_maximal D).trans D.maximalLocal_normalizes_fullModule))

/-- Faithful A₅ action with the exact original group quotient and conjugation. -/
theorem source_a5_original_moved_action
    (e : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 5)) :
    let W := ⁅D.fullModule,L⁆
    letI := source_original_full_moved_elementary D
    ∃ ρ : Representation (ZMod 2) (alternatingGroup (Fin 5)) (Additive W),
      Function.Injective ρ ∧
      ∀ (l : L) (w : Additive W),
        ((ρ (e (QuotientGroup.mk' (pCore 2 L) l)) w).toMul : G) =
          l * w.toMul * (l : G)⁻¹ := by
  dsimp only
  let W := ⁅D.fullModule,L⁆
  let := D.fullModule_elementary (source_uniqueness D)
  have hWV : W ≤ D.fullModule := le_normalizer_iff_commutator_le_left.mp
    ((component_le_maximal D).trans D.maximalLocal_normalizes_fullModule)
  let : IsElementaryAbelian 2 W := IsElementaryAbelian.of_le hWV
  let q := e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 L))
  have hq : Function.Surjective q := e.surjective.comp (QuotientGroup.mk'_surjective _)
  obtain ⟨ρ,hρ⟩ := Representation.BinaryConjugationSection.exists_action_of_central_kernel
    L W (normalizer_commutator_ge_right _ _) q hq (by
      intro l hl
      have hp : l ∈ pCore 2 L := (QuotientGroup.eq_one_iff l).mp
        (e.injective (hl.trans e.map_one.symm))
      exact centralizer_le hWV (source_component_core_centralizes_fullModule D
        (mem_map_of_mem L.subtype hp)))
  refine ⟨ρ,?_,hρ⟩
  let : IsSimpleGroup (alternatingGroup (Fin 5)) := alternatingGroup.isSimpleGroup (by simp)
  apply (MonoidHom.ker_eq_bot_iff ρ).mp
  apply (inferInstance : ρ.ker.Normal).eq_bot_or_eq_top.resolve_right
  intro hk
  have hcentral : W ≤ centralizer (L : Set G) := by
    apply le_centralizer_iff.mpr
    intro l hl w hw
    have hi : ρ (q ⟨l,hl⟩) = 1 := MonoidHom.mem_ker.mp (hk ▸ mem_top _)
    have hh := hρ ⟨l,hl⟩ (Additive.ofMul ⟨w,hw⟩)
    rw [hi] at hh
    exact (mul_inv_eq_iff_eq_mul.mp hh.symm).symm
  have hz : ⁅W,L⁆ = ⊥ := commutator_eq_bot_iff_le_centralizer.mpr hcentral
  rw [source_full_moved_eq_commutator D] at hz
  exact source_full_moved_ne_bot D hz

/-- The actual action of the original component on its moved factor has its
intrinsic two-core as kernel. -/
theorem source_a5_original_moved_kernel
    (e : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 5)) :
    (centralizer (↑(⁅D.fullModule,L⁆ : Subgroup G) : Set G)).subgroupOf L = pCore 2 L := by
  let W := ⁅D.fullModule,L⁆
  let := source_original_full_moved_elementary D
  obtain ⟨ρ,hfaith,hρ⟩ := source_a5_original_moved_action D e
  ext l
  constructor
  · intro hl
    have he : ρ (e (QuotientGroup.mk' (pCore 2 L) l)) = 1 := by
      apply LinearMap.ext
      intro w
      apply Additive.toMul.injective
      apply Subtype.ext
      rw [hρ]
      change (l : G) * (w.toMul : G) * (l : G)⁻¹ = w.toMul
      have hv : (w.toMul : G) * (l : G) = (l : G) * (w.toMul : G) :=
        hl w.toMul w.toMul.property
      exact (congrArg (fun a : G => a * (l : G)⁻¹) hv.symm).trans
        (mul_inv_cancel_right _ _)
    have heq := hfaith (he.trans ρ.map_one.symm)
    exact (QuotientGroup.eq_one_iff l).mp (e.injective (heq.trans e.map_one.symm))
  · intro hl
    have hWV : W ≤ D.fullModule := le_normalizer_iff_commutator_le_left.mp
      ((component_le_maximal D).trans D.maximalLocal_normalizes_fullModule)
    exact centralizer_le hWV (source_component_core_centralizes_fullModule D
      (mem_map_of_mem L.subtype hl))

/-- The original A₅ component sits faithfully in the full action induced by M
on the moved factor. Its inclusion agrees with the original quotient map. -/
theorem source_a5_original_moved_induced_marking
    (e : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 5)) :
    let W := ⁅D.fullModule,L⁆
    ∃ j : alternatingGroup (Fin 5) →* ChapterE.inducedAutomizer W D.maximalLocal,
      Function.Injective j ∧
      ∀ l : L,
        (j (e (QuotientGroup.mk' (pCore 2 L) l)) : ChapterE.Automizer W) =
          W.normalizerMonoidHom.rangeRestrict
            ⟨l,normalizer_commutator_ge_right D.fullModule L l.property⟩ := by
  dsimp only
  let W := ⁅D.fullModule,L⁆
  let A := ChapterE.inducedAutomizer W D.maximalLocal
  let f : L →* A := {
    toFun l := ⟨W.normalizerMonoidHom.rangeRestrict
      ⟨l,normalizer_commutator_ge_right D.fullModule L l.property⟩,
      ⟨⟨l,normalizer_commutator_ge_right D.fullModule L l.property⟩,
        component_le_maximal D l.property,rfl⟩⟩
    map_one' := by
      apply Subtype.ext
      exact map_one W.normalizerMonoidHom.rangeRestrict
    map_mul' a b := by
      apply Subtype.ext
      exact map_mul W.normalizerMonoidHom.rangeRestrict
        ⟨a,normalizer_commutator_ge_right D.fullModule L a.property⟩
        ⟨b,normalizer_commutator_ge_right D.fullModule L b.property⟩ }
  have hfker : f.ker = pCore 2 L := by
    rw [←source_a5_original_moved_kernel D e]
    ext l
    change f l = 1 ↔ (l : G) ∈ centralizer (W : Set G)
    constructor
    · intro hl w hw
      have hh := congrArg (fun a : A => (a.val.val ⟨w,hw⟩ : G)) hl
      change (l : G) * w * (l : G)⁻¹ = w at hh
      exact (mul_inv_eq_iff_eq_mul.mp hh).symm
    · intro hl
      apply Subtype.ext
      apply Subtype.ext
      apply MulEquiv.ext
      intro w
      apply Subtype.ext
      change (l : G) * (w : G) * (l : G)⁻¹ = w
      rw [←hl w w.property,mul_inv_cancel_right]
  let b : (L ⧸ pCore 2 L) →* A := QuotientGroup.lift _ f hfker.ge
  have hb : Function.Injective b := (QuotientGroup.injective_lift_iff _ _ _).mpr hfker.symm
  refine ⟨b.comp e.symm.toMonoidHom,hb.comp e.symm.injective,?_⟩
  intro l
  change ((b (e.symm (e (QuotientGroup.mk' (pCore 2 L) l)))) : ChapterE.Automizer W) = _
  rw [e.symm_apply_apply]
  rfl


/-- The literal fixed part of the original moved factor. -/
@[expose] def sourceMovedFixed : Subgroup G :=
  ⁅D.fullModule,L⁆ ⊓ centralizer (L : Set G)

/-- The central quotient has its literal coordinate map and a faithful A₅ action. -/
theorem source_a5_original_moved_quotient_action
    (e : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 5)) :
    let W := ⁅D.fullModule,L⁆
    let Z := sourceMovedFixed D
    letI := source_original_full_moved_elementary D
    ∃ (ρ : Representation (ZMod 2) (alternatingGroup (Fin 5))
        (Additive (W ⧸ Z.subgroupOf W)))
      (c : Representation.BinaryConjugationSection L W Z
        (ρ.comp (e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 L))))),
      Function.Injective ρ ∧
      ∀ w : W, (c.coordinates w).toAdd =
        Additive.ofMul (QuotientGroup.mk' (Z.subgroupOf W) w) := by
  dsimp only
  let W := ⁅D.fullModule,L⁆
  let Z := sourceMovedFixed D
  let := source_original_full_moved_elementary D
  have hLW : L ≤ normalizer (W : Set G) := normalizer_commutator_ge_right _ _
  have hLZ : L ≤ normalizer (Z : Set G) :=
    (le_inf hLW (L.le_normalizer.trans (normalizer_le_normalizer_centralizer L))).trans
      inf_normalizer_le_normalizer_inf
  let q := e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 L))
  have hq : Function.Surjective q := e.surjective.comp (QuotientGroup.mk'_surjective _)
  obtain ⟨ρ,c,hc⟩ := Representation.BinaryConjugationSection.exists_descended_actor
    L W Z (source_full_moved_le_component D) inf_le_left hLW hLZ q hq (by
      intro l hl w hw
      have hp : l ∈ pCore 2 L := (QuotientGroup.eq_one_iff l).mp
        (e.injective (hl.trans e.map_one.symm))
      have hWV : W ≤ D.fullModule := le_normalizer_iff_commutator_le_left.mp
        ((component_le_maximal D).trans D.maximalLocal_normalizes_fullModule)
      have hh := source_component_core_centralizes_fullModule D
        (mem_map_of_mem L.subtype hp) w (hWV hw)
      have he : ⁅(l : G),w⁆ = 1 := (commutatorElement_eq_one_iff_mul_comm).mpr hh.symm
      rw [he]
      exact Z.one_mem)
  refine ⟨ρ,c,?_,hc⟩
  let : IsSimpleGroup (alternatingGroup (Fin 5)) := alternatingGroup.isSimpleGroup (by simp)
  apply (MonoidHom.ker_eq_bot_iff ρ).mp
  apply (inferInstance : ρ.ker.Normal).eq_bot_or_eq_top.resolve_right
  intro hk
  have hcentral : ⁅W,L⁆ ≤ centralizer (L : Set G) := by
    rw [commutator_comm]
    apply commutator_le.mpr
    intro l hl w hw
    let w' : W := ⟨l*w*l⁻¹,(mem_normalizer_iff.mp (hLW hl) w).mp hw⟩
    have hi : ρ (q ⟨l,hl⟩) = 1 := MonoidHom.mem_ker.mp (hk ▸ mem_top _)
    have he := c.equivariant ⟨l,hl⟩ ⟨w,hw⟩
    change (c.coordinates w').toAdd = ρ (q ⟨l,hl⟩) (c.coordinates ⟨w,hw⟩).toAdd at he
    rw [hi] at he
    have he' : c.coordinates w' = c.coordinates ⟨w,hw⟩ := he
    have hm : c.coordinates (w' * (⟨w,hw⟩ : W)⁻¹) = 1 := by
      rw [map_mul,map_inv,he',mul_inv_cancel]
    have hz := (c.coordinates_eq_one_iff _).mp hm
    exact hz.2
  have hWC : W ≤ centralizer (L : Set G) :=
    (source_full_moved_eq_commutator D).symm.le.trans hcentral
  have hz : ⁅W,L⁆ = ⊥ := commutator_eq_bot_iff_le_centralizer.mpr hWC
  rw [source_full_moved_eq_commutator D] at hz
  exact source_full_moved_ne_bot D hz

/-- Full group movement remains full movement on the literal central quotient. -/
theorem source_original_moved_quotient_coinvariants
    (e : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 5)) :
    let W := ⁅D.fullModule,L⁆
    let Z := sourceMovedFixed D
    letI := source_original_full_moved_elementary D
    ∀ (ρ : Representation (ZMod 2) (alternatingGroup (Fin 5))
        (Additive (W ⧸ Z.subgroupOf W)))
      (_c : Representation.BinaryConjugationSection L W Z
        (ρ.comp (e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 L))))),
      Representation.Coinvariants.ker ρ = ⊤ := by
  let := source_original_full_moved_elementary D
  dsimp only
  intro ρ c
  apply c.coinvariants_eq_top_of_group_generation L le_rfl ρ
    (e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 L))) (fun _ _ => rfl)
  rw [commutator_comm,source_full_moved_eq_commutator D]
  exact sup_eq_left.mpr inf_le_left

end CFSG.Quasithin.Chapter10
