/-!
# The faithful central quotient of the original local module

Let H = L₀T and V be the original local module. Conjugation on the
literal quotient V/C_V(L₀) descends to H/C_H(V). The equivariant
surjection from V preserves this actor, so the original cubic bound
passes to the quotient without changing elementary actor ranks.

The equality [V,L₀] = V and reducedness make the descended action
faithful. In the nonnormal A₅ case, the original marked projection
L₀ → A₅ × A₅ then gives a normal injective embedding in this same
actor. The local semisimple and homogeneous-orbit data are retained.

Source: Aschbacher–Smith, 3.2.2 and the local inputs to D.3.4–5.
-/

public noncomputable section
open Subgroup Theory.GroupTheory Representation
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter10
open Chapter3.Section02 Representation.BinaryOffender Representation.BinaryOffender.Homogeneous
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L : Subgroup G}
local instance localActorElementary (D : FundamentalSetup KnownSimple.IsKnownSimple T L) :
    IsElementaryAbelian 2 D.moduleSubgroup := D.module_elementary

/-- The fixed subgroup of the actual local module under the orbit L₀. -/
@[expose] def sourceLocalCentralizer (D : FundamentalSetup KnownSimple.IsKnownSimple T L) :
    Subgroup D.moduleSubgroup :=
  (centralizer (localOrbit T L : Set G)).subgroupOf D.moduleSubgroup

instance sourceLocalCentralizer_normal (D : FundamentalSetup KnownSimple.IsKnownSimple T L) :
    (sourceLocalCentralizer D).Normal := inferInstance

/-- The literal local central quotient V/C_V(L₀). -/
abbrev sourceLocalCentralQuotient (D : FundamentalSetup KnownSimple.IsKnownSimple T L) :=
  D.moduleSubgroup ⧸ sourceLocalCentralizer D

/-- The original local module is generated by the orbit's commutators. -/
theorem source_local_module_eq_commutator (D : FundamentalSetup KnownSimple.IsKnownSimple T L) :
    D.moduleSubgroup = ⁅D.moduleSubgroup,localOrbit T L⁆ := by
  rw [D.module_eq_subspaceImage]
  exact ReducedNormal.subspaceImage_eq_commutator (localJoin T L) _ (localOrbit T L)
    le_sup_left (orbitSpan_component_invariant _ D.homogeneous.normalizes D.homogeneous.isIrrPlus)
    (orbitSpan_full_commutator _ D.homogeneous.normalizes D.homogeneous.isIrrPlus)

/-- Conjugation on the actual local quotient, retaining its original representatives. -/
theorem source_local_central_quotient_action
    (D : FundamentalSetup KnownSimple.IsKnownSimple T L) :
    ∃ σ : Representation (ZMod 2) (localJoin T L) (Additive (sourceLocalCentralQuotient D)),
      IsSemisimpleRepresentation (σ.comp ((localOrbit T L).subgroupOf (localJoin T L)).subtype) ∧
      (∀ (A B : Subrepresentation
          (σ.comp ((localOrbit T L).subgroupOf (localJoin T L)).subtype)),
        A.toRepresentation.IsIrreducible → B.toRepresentation.IsIrreducible →
        ∃ g : localJoin T L, (homogeneousPart A ⊤).map (σ g) = homogeneousPart B ⊤) ∧
      (∀ (g : localJoin T L) (v : D.moduleSubgroup),
        σ g (Additive.ofMul (QuotientGroup.mk' (sourceLocalCentralizer D) v)) =
          Additive.ofMul (QuotientGroup.mk' (sourceLocalCentralizer D)
            ⟨(g : G) * (v : G) * (g : G)⁻¹,
              (mem_normalizer_iff.mp (D.join_normalizes_module g.property) v).mp v.property⟩)) := by
  let H := localJoin T L
  let X := localOrbit T L
  let : (X.subgroupOf H).Normal := normal_subgroupOf_of_le_normalizer
    (sup_le X.le_normalizer (le_normalizer_componentOrbit L T))
  obtain ⟨σ,hs,hh,hσ⟩ := ReducedNormal.exists_actual_quotient_consequences H
    (orbitSpan (ReducedNormal.representation H) ⊤ D.seedSpace)
    (orbitSpan_invariant _ ⊤ _) X le_sup_left D.homogeneous.isIrrPlus rfl
    D.moduleSubgroup D.local_orbitImage_eq_module D.join_normalizes_module
  exact ⟨σ,hs,hh,hσ⟩

/-- The local central-quotient action factors through the original action kernel. -/
theorem source_local_quotient_action_descent
    (D : FundamentalSetup KnownSimple.IsKnownSimple T L)
    (σ : Representation (ZMod 2) (localJoin T L) (Additive (sourceLocalCentralQuotient D)))
    (hσ : ∀ (g : (localJoin T L)) (v : D.moduleSubgroup),
      σ g (Additive.ofMul (QuotientGroup.mk' (sourceLocalCentralizer D) v)) =
        Additive.ofMul (QuotientGroup.mk' (sourceLocalCentralizer D)
          ⟨(g : G) * (v : G) * (g : G)⁻¹,
            (mem_normalizer_iff.mp (D.join_normalizes_module g.property) v).mp
              v.property⟩)) :
    let U := D.moduleSubgroup.subgroupOf (localJoin T L)
    let := (source_parabolic_module_reduced D).normal
    let q := QuotientGroup.mk' (centralizer (U : Set (localJoin T L)))
    ∃ τ : Representation (ZMod 2) ((localJoin T L) ⧸ centralizer (U : Set (localJoin T L)))
      (Additive (sourceLocalCentralQuotient D)), τ.comp q = σ := by
  dsimp only
  let U := D.moduleSubgroup.subgroupOf (localJoin T L)
  let := (source_parabolic_module_reduced D).normal
  let q := QuotientGroup.mk' (centralizer (U : Set (localJoin T L)))
  have hk : q.ker ≤ σ.asGroupHom.ker := by
    intro m hm
    apply Units.ext
    apply LinearMap.ext
    intro v
    obtain ⟨w,rfl⟩ := QuotientGroup.mk'_surjective (sourceLocalCentralizer D) v.toMul
    change σ m (Additive.ofMul (QuotientGroup.mk' (sourceLocalCentralizer D) w)) =
      Additive.ofMul (QuotientGroup.mk' (sourceLocalCentralizer D) w)
    rw [hσ]
    congr 2
    apply Subtype.ext
    have hc : m ∈ centralizer (U : Set (localJoin T L)) := (QuotientGroup.eq_one_iff m).mp hm
    let wM : (localJoin T L) := ⟨w,D.module_le_core.trans (pCoreIn_le 2 _) w.property⟩
    have he := congrArg Subtype.val (hc wM w.property)
    change (w : G) * (m : G) = (m : G) * (w : G) at he
    change (m : G) * (w : G) * (m : G)⁻¹ = (w : G)
    rw [← he,mul_inv_cancel_right]
  let f := q.liftOfSurjective (QuotientGroup.mk'_surjective _) ⟨σ.asGroupHom,hk⟩
  let τ : Representation (ZMod 2) _ (Additive (sourceLocalCentralQuotient D)) :=
    (Units.coeHom _).comp f
  refine ⟨τ,?_⟩
  ext m v
  have he := q.liftOfRightInverse_comp_apply
    (Function.surjInv (QuotientGroup.mk'_surjective _))
    (Function.rightInverse_surjInv (QuotientGroup.mk'_surjective _)) ⟨σ.asGroupHom,hk⟩ m
  exact congrArg (fun u : (Module.End (ZMod 2) (Additive (sourceLocalCentralQuotient D)))ˣ => u.val v) he

/-- The original local-module cubic bound passes to its central quotient at the same actor. -/
theorem source_local_quotient_cubic_bound
    (D : FundamentalSetup KnownSimple.IsKnownSimple T L)
    (σ : Representation (ZMod 2) (localJoin T L) (Additive (sourceLocalCentralQuotient D)))
    (hσ : ∀ (g : (localJoin T L)) (v : D.moduleSubgroup),
      σ g (Additive.ofMul (QuotientGroup.mk' (sourceLocalCentralizer D) v)) =
        Additive.ofMul (QuotientGroup.mk' (sourceLocalCentralizer D)
          ⟨(g : G) * (v : G) * (g : G)⁻¹,
            (mem_normalizer_iff.mp (D.join_normalizes_module g.property) v).mp
              v.property⟩)) :
    let U := D.moduleSubgroup.subgroupOf (localJoin T L)
    let := (source_parabolic_module_reduced D).normal
    let q := QuotientGroup.mk' (centralizer (U : Set (localJoin T L)))
    ∃ τ : Representation (ZMod 2) ((localJoin T L) ⧸ centralizer (U : Set (localJoin T L)))
      (Additive (sourceLocalCentralQuotient D)),
      τ.comp q = σ ∧ (SourceLocalModuleCubicBound D → BinaryOffender.cubicRatio τ ≤ 2) := by
  dsimp only
  let M := (localJoin T L)
  let U := D.moduleSubgroup.subgroupOf M
  let := (source_parabolic_module_reduced D).normal
  let := (source_parabolic_module_reduced D).elementary
  let q := QuotientGroup.mk' (centralizer (U : Set M))
  let ρ := NormalElementaryQuotient.representation U q
    (QuotientGroup.mk'_surjective _) (QuotientGroup.ker_mk' _)
  obtain ⟨τ,hτ⟩ := source_local_quotient_action_descent D σ hσ
  refine ⟨τ,hτ,?_⟩
  intro hbound
  have hVM : D.moduleSubgroup ≤ M := D.module_le_core.trans (pCoreIn_le 2 _)
  let eU : U ≃* D.moduleSubgroup := subgroupOfEquivOfLe hVM
  let f : Additive U →ₗ[ZMod 2] Additive (sourceLocalCentralQuotient D) :=
    ((QuotientGroup.mk' (sourceLocalCentralizer D)).comp eU.toMonoidHom).toAdditive.toZModLinearMap 2
  have hf : Function.Surjective f := by
    intro w
    obtain ⟨v,hv⟩ := QuotientGroup.mk'_surjective (sourceLocalCentralizer D) w.toMul
    refine ⟨Additive.ofMul (eU.symm v),?_⟩
    change QuotientGroup.mk' (sourceLocalCentralizer D) (eU (eU.symm v)) = w.toMul
    rw [eU.apply_symm_apply,hv]
  have he (g) (v : Additive U) : f (ρ g v) = τ g (f v) := by
    obtain ⟨m,rfl⟩ := QuotientGroup.mk'_surjective (centralizer (U : Set M)) g
    have hτm : τ (q m) = σ m := congrArg (fun r => r m) hτ
    rw [hτm]
    change Additive.ofMul (QuotientGroup.mk' (sourceLocalCentralizer D) (eU (ρ (q m) v).toMul)) =
      σ m (Additive.ofMul (QuotientGroup.mk' (sourceLocalCentralizer D) (eU v.toMul)))
    rw [hσ]
    congr 2
    apply Subtype.ext
    change (((ρ (q m) v).toMul : U) : G) = (m : G) * (v.toMul : G) * (m : G)⁻¹
    exact congrArg (fun x : M => (x : G)) (NormalElementaryQuotient.representation_apply U q
      (QuotientGroup.mk'_surjective _) (QuotientGroup.ker_mk' _) m v)
  exact BinaryOffender.cubicRatio_le_nat_of_equivariant_surjection ρ τ f hf he 2 hbound

/-- Every action with the exact original quotient coordinates is faithful. -/
theorem source_local_central_quotient_faithful
    (D : FundamentalSetup KnownSimple.IsKnownSimple T L) :
    let U := D.moduleSubgroup.subgroupOf (localJoin T L)
    let := (source_parabolic_module_reduced D).normal
    let q := QuotientGroup.mk' (centralizer (U : Set (localJoin T L)))
    ∀ τ : Representation (ZMod 2) ((localJoin T L) ⧸ centralizer (U : Set (localJoin T L)))
      (Additive (sourceLocalCentralQuotient D)),
      (∀ (m : (localJoin T L)) (v : D.moduleSubgroup),
        τ (q m) (Additive.ofMul (QuotientGroup.mk' (sourceLocalCentralizer D) v)) =
          Additive.ofMul (QuotientGroup.mk' (sourceLocalCentralizer D)
            ⟨(m : G) * (v : G) * (m : G)⁻¹,
              (mem_normalizer_iff.mp (D.join_normalizes_module m.property) v).mp
                v.property⟩)) → Function.Injective τ := by
  dsimp only
  let M := (localJoin T L)
  let U := D.moduleSubgroup.subgroupOf M
  let X := (localOrbit T L).subgroupOf M
  let := (source_parabolic_module_reduced D).normal
  let := (source_parabolic_module_reduced D).elementary
  let q := QuotientGroup.mk' (centralizer (U : Set M))
  let ρ := NormalElementaryQuotient.representation U q
    (QuotientGroup.mk'_surjective _) (QuotientGroup.ker_mk' _)
  let : X.Normal := normal_subgroupOf_of_le_normalizer
    (sup_le (localOrbit T L).le_normalizer (le_normalizer_componentOrbit L T))
  let K := X.map q
  let : K.Normal := Subgroup.Normal.map inferInstance q (QuotientGroup.mk'_surjective _)
  intro τ hτ
  have hVM : D.moduleSubgroup ≤ M := D.module_le_core.trans (pCoreIn_le 2 _)
  have hXM : localOrbit T L ≤ M := le_sup_left
  let eU : U ≃* D.moduleSubgroup := subgroupOfEquivOfLe hVM
  let f : Additive U →ₗ[ZMod 2] Additive (sourceLocalCentralQuotient D) :=
    ((QuotientGroup.mk' (sourceLocalCentralizer D)).comp eU.toMonoidHom).toAdditive.toZModLinearMap 2
  have he (g) (v : Additive U) : f (ρ g v) = τ g (f v) := by
    obtain ⟨m,rfl⟩ := QuotientGroup.mk'_surjective (centralizer (U : Set M)) g
    change Additive.ofMul (QuotientGroup.mk' (sourceLocalCentralizer D) (eU (ρ (q m) v).toMul)) =
      τ (q m) (Additive.ofMul (QuotientGroup.mk' (sourceLocalCentralizer D) (eU v.toMul)))
    rw [hτ]
    congr 2
    apply Subtype.ext
    change (((ρ (q m) v).toMul : U) : G) = (m : G) * (v.toMul : G) * (m : G)⁻¹
    exact congrArg (fun x : M => (x : G)) (NormalElementaryQuotient.representation_apply U q
      (QuotientGroup.mk'_surjective _) (QuotientGroup.ker_mk' _) m v)
  have hk : f.ker = fixedSpace ρ K := by
    ext v
    rw [LinearMap.mem_ker,NormalElementaryQuotient.mem_fixedSpace_image U q
      (QuotientGroup.mk'_surjective _) (QuotientGroup.ker_mk' _) X]
    change eU v.toMul ∈ (QuotientGroup.mk' (sourceLocalCentralizer D)).ker ↔ _
    rw [QuotientGroup.ker_mk']
    constructor
    · intro hv m hm
      apply Subtype.ext
      exact hv m hm
    · intro hv x hx
      exact congrArg (fun y : M => (y : G)) (hv ⟨x,hXM hx⟩ hx)
  have hwhole : ⁅U,X⁆ = U := by
    apply map_injective M.subtype_injective
    rw [map_commutator,map_subgroupOf_eq_of_le hVM,map_subgroupOf_eq_of_le hXM]
    exact (source_local_module_eq_commutator D).symm
  have hmove : subspaceCommutator ρ ⊤ K = ⊤ := by
    rw [←NormalElementaryQuotient.commutatorSpace_eq U q
      (QuotientGroup.mk'_surjective _) (QuotientGroup.ker_mk' _) X]
    ext v
    change (v.toMul : M) ∈ ⁅U,X⁆ ↔ True
    rw [hwhole]
    exact iff_true_intro v.toMul.property
  exact faithful_of_equivariant_reduced_central_quotient ρ τ
    (NormalElementaryQuotient.representation_injective U q
      (QuotientGroup.mk'_surjective _) (QuotientGroup.ker_mk' _))
    (source_parabolic_module_reduced D).quotient_pCore_eq_bot K f hk he hmove
/-- The actual local central quotient has a faithful action of the unchanged
local actor and inherits the genuine source cubic bound. -/
theorem source_local_quotient_faithful_cubic_action
    (D : FundamentalSetup KnownSimple.IsKnownSimple T L)
    (hbound : SourceLocalModuleCubicBound D) :
    let U := D.moduleSubgroup.subgroupOf (localJoin T L)
    let := (source_parabolic_module_reduced D).normal
    let q := QuotientGroup.mk' (centralizer (U : Set (localJoin T L)))
    ∃ τ : Representation (ZMod 2) ((localJoin T L) ⧸ centralizer (U : Set (localJoin T L)))
      (Additive (sourceLocalCentralQuotient D)),
      Function.Injective τ ∧ BinaryOffender.cubicRatio τ ≤ 2 ∧
      (∀ (m : localJoin T L) (v : D.moduleSubgroup),
        τ (q m) (Additive.ofMul (QuotientGroup.mk' (sourceLocalCentralizer D) v)) =
          Additive.ofMul (QuotientGroup.mk' (sourceLocalCentralizer D)
            ⟨(m : G) * (v : G) * (m : G)⁻¹,
              (mem_normalizer_iff.mp (D.join_normalizes_module m.property) v).mp
                v.property⟩)) := by
  dsimp only
  let := (source_parabolic_module_reduced D).normal
  obtain ⟨σ,_,_,hσ⟩ := source_local_central_quotient_action D
  obtain ⟨τ,hτ,hq⟩ := source_local_quotient_cubic_bound D σ hσ
  have ha (m : localJoin T L) (v : D.moduleSubgroup) :
      τ (QuotientGroup.mk' _ m)
        (Additive.ofMul (QuotientGroup.mk' (sourceLocalCentralizer D) v)) =
          Additive.ofMul (QuotientGroup.mk' (sourceLocalCentralizer D)
            ⟨(m : G) * (v : G) * (m : G)⁻¹,
              (mem_normalizer_iff.mp (D.join_normalizes_module m.property) v).mp v.property⟩) := by
    have he := congrArg (fun r => r m) hτ
    change τ _ = σ m at he
    rw [he]
    exact hσ m v
  exact ⟨τ,source_local_central_quotient_faithful D τ ha,hq hbound,ha⟩

/-- The original local actor restricted to L₀ has precisely its two-core as kernel. -/
theorem source_a5_local_actor_restriction_ker (D : FundamentalSetup KnownSimple.IsKnownSimple T L)
    (e : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 5))
    (hn : ¬ (T : Subgroup G) ≤ normalizer (L : Set G)) :
    let U := D.moduleSubgroup.subgroupOf (localJoin T L)
    let := (source_parabolic_module_reduced D).normal
    ((QuotientGroup.mk' (centralizer (U : Set (localJoin T L)))).comp
      (inclusion (show localOrbit T L ≤ localJoin T L from le_sup_left))).ker = pCore 2 (localOrbit T L) := by
  dsimp only
  let M := (localJoin T L)
  let R := localOrbit T L
  let H := localJoin T L
  let U := D.moduleSubgroup.subgroupOf M
  let := (source_parabolic_module_reduced D).normal
  let qM := QuotientGroup.mk' (centralizer (U : Set M))
  let f := qM.comp (inclusion (show R ≤ M from le_sup_left))
  change f.ker = pCore 2 R
  have hVM : D.moduleSubgroup ≤ M := D.module_le_core.trans (pCoreIn_le 2 _)
  apply le_antisymm
  · have hCH := source_a5_local_module_kernel_isTwoGroup D e hn
    have hp := hCH.comap_of_injective (inclusion (show R ≤ H from le_sup_left))
      (inclusion_injective _)
    have hk : f.ker ≤ (centralizer (D.moduleSubgroup.subgroupOf H : Set H)).comap
        (inclusion (show R ≤ H from le_sup_left)) := by
      intro x hx v hv
      have hxC : (inclusion (show R ≤ M from le_sup_left) x : M) ∈ centralizer (U : Set M) :=
        (QuotientGroup.eq_one_iff _).mp hx
      have hxm := hxC ⟨v, hVM hv⟩ hv
      exact Subtype.ext (congrArg (fun z : M => (z : G)) hxm)
    exact le_sSup ⟨inferInstance,hp.to_le hk⟩
  · intro x hx
    have hc : R.pCoreIn 2 ≤ M.pCoreIn 2 :=
      pCoreIn_mono_of_normalizes le_sup_left
        (sup_le R.le_normalizer (le_normalizer_componentOrbit L T))
    obtain ⟨z,hz,hzx⟩ := hc (mem_map_of_mem R.subtype hx)
    have hz' : z = inclusion (show R ≤ M from le_sup_left) x := Subtype.ext hzx
    have hm : inclusion (show R ≤ M from le_sup_left) x ∈ pCore 2 M := hz' ▸ hz
    exact (QuotientGroup.eq_one_iff _).mpr
      ((le_centralizer_iff.mp (source_parabolic_module_reduced D).le_centralizer_pCore) hm)

/-- The marked A₅ pair embeds normally in the original faithful actor quotient. -/
theorem source_a5_local_product_embedding
    (D : FundamentalSetup KnownSimple.IsKnownSimple T L)
    (e : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 5))
    (hn : ¬ (T : Subgroup G) ≤ normalizer (L : Set G))
    {t : G} (ht : t ∈ T) (htn : t ∉ normalizer (L : Set G)) :
    let U := D.moduleSubgroup.subgroupOf (localJoin T L)
    let := (source_parabolic_module_reduced D).normal
    ∃ i : alternatingGroup (Fin 5) × alternatingGroup (Fin 5) →*
        ((localJoin T L) ⧸ centralizer (U : Set (localJoin T L))),
      Function.Injective i ∧ i.range.Normal ∧
        ∀ x : localOrbit T L,
          i (originalA5ProductProjection D e hn ht htn x) =
            QuotientGroup.mk' (centralizer (U : Set (localJoin T L)))
              (inclusion (show localOrbit T L ≤ localJoin T L from le_sup_left) x) := by
  dsimp only
  let M := (localJoin T L)
  let R := localOrbit T L
  let U := D.moduleSubgroup.subgroupOf M
  let := (source_parabolic_module_reduced D).normal
  let qM := QuotientGroup.mk' (centralizer (U : Set M))
  let f := qM.comp (inclusion (show R ≤ M from le_sup_left))
  let q := originalA5ProductProjection D e hn ht htn
  have hq := originalA5ProductProjection_surjective D e hn ht htn
  have hk : q.ker = f.ker :=
    (originalA5ProductProjection_ker D e hn ht htn).trans
      (source_a5_local_actor_restriction_ker D e hn).symm
  let i := q.liftOfSurjective hq ⟨f, hk.le⟩
  have hi (x : R) : i (q x) = f x :=
    q.liftOfRightInverse_comp_apply _ _ _ x
  refine ⟨i, ?_, ?_, hi⟩
  · apply (MonoidHom.ker_eq_bot_iff i).mp
    apply le_bot_iff.mp
    intro a ha
    obtain ⟨x, rfl⟩ := hq a
    have hx : x ∈ f.ker := (hi x).symm.trans ha
    have hxq : x ∈ q.ker := hk.symm ▸ hx
    exact hxq
  · have hf : f.range = (R.subgroupOf M).map qM := by
      ext y
      constructor
      · rintro ⟨x, rfl⟩
        exact ⟨inclusion (show R ≤ M from le_sup_left) x, x.property, rfl⟩
      · rintro ⟨x, hx, rfl⟩
        exact ⟨⟨x, hx⟩, rfl⟩
    have hir : i.range = f.range := by
      ext y
      constructor
      · rintro ⟨a, rfl⟩
        obtain ⟨x, rfl⟩ := hq a
        exact ⟨x, (hi x).symm⟩
      · rintro ⟨x, rfl⟩
        exact ⟨q x, hi x⟩
    rw [hir, hf]
    exact (normal_subgroupOf_of_le_normalizer (show M ≤ normalizer (R : Set G)
      from sup_le R.le_normalizer (le_normalizer_componentOrbit L T))).map qM (QuotientGroup.mk'_surjective _)

/-- Semisimplicity and the homogeneous orbit survive descent to the literal
local actor. The restriction is written after inflation to retain L₀ itself. -/
theorem source_local_quotient_homogeneous_action
    (D : FundamentalSetup KnownSimple.IsKnownSimple T L) :
    let U := D.moduleSubgroup.subgroupOf (localJoin T L)
    let := (source_parabolic_module_reduced D).normal
    let q := QuotientGroup.mk' (centralizer (U : Set (localJoin T L)))
    ∀ τ : Representation (ZMod 2) ((localJoin T L) ⧸ centralizer (U : Set (localJoin T L)))
      (Additive (sourceLocalCentralQuotient D)),
      (∀ (m : localJoin T L) (v : D.moduleSubgroup),
        τ (q m) (Additive.ofMul (QuotientGroup.mk' (sourceLocalCentralizer D) v)) =
          Additive.ofMul (QuotientGroup.mk' (sourceLocalCentralizer D)
            ⟨(m : G) * (v : G) * (m : G)⁻¹,
              (mem_normalizer_iff.mp (D.join_normalizes_module m.property) v).mp
                v.property⟩)) →
      IsSemisimpleRepresentation
          ((τ.comp q).comp ((localOrbit T L).subgroupOf (localJoin T L)).subtype) ∧
      (∀ (A B : Subrepresentation
          ((τ.comp q).comp ((localOrbit T L).subgroupOf (localJoin T L)).subtype)),
        A.toRepresentation.IsIrreducible → B.toRepresentation.IsIrreducible →
        ∃ g : localJoin T L,
          (homogeneousPart A ⊤).map ((τ.comp q) g) = homogeneousPart B ⊤) := by
  dsimp only
  let := (source_parabolic_module_reduced D).normal
  intro τ hτ
  obtain ⟨σ,hs,hh,hσ⟩ := source_local_central_quotient_action D
  have he : τ.comp (QuotientGroup.mk' _) = σ := by
    ext g w
    obtain ⟨v,rfl⟩ := QuotientGroup.mk'_surjective (sourceLocalCentralizer D) w.toMul
    exact (hτ g v).trans (hσ g v).symm
  rw [he]
  exact ⟨hs,hh⟩

/-- The actual D.3.5 local input: a faithful bounded action and the marked
normal A₅ pair in the same quotient actor. The numerical source premise is
kept explicit for its independent producer. -/
theorem source_a5_local_central_quotient_data
    (D : FundamentalSetup KnownSimple.IsKnownSimple T L)
    (e : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 5))
    (hn : ¬ (T : Subgroup G) ≤ normalizer (L : Set G))
    {t : G} (ht : t ∈ T) (htn : t ∉ normalizer (L : Set G))
    (hbound : SourceLocalModuleCubicBound D) :
    let U := D.moduleSubgroup.subgroupOf (localJoin T L)
    let := (source_parabolic_module_reduced D).normal
    let q := QuotientGroup.mk' (centralizer (U : Set (localJoin T L)))
    ∃ (τ : Representation (ZMod 2)
        ((localJoin T L) ⧸ centralizer (U : Set (localJoin T L)))
        (Additive (sourceLocalCentralQuotient D)))
      (i : alternatingGroup (Fin 5) × alternatingGroup (Fin 5) →*
        ((localJoin T L) ⧸ centralizer (U : Set (localJoin T L)))),
      Function.Injective τ ∧ BinaryOffender.cubicRatio τ ≤ 2 ∧
      Function.Injective i ∧ i.range.Normal ∧
      (∀ x : localOrbit T L,
        i (originalA5ProductProjection D e hn ht htn x) =
          q (inclusion (show localOrbit T L ≤ localJoin T L from le_sup_left) x)) ∧
      (∀ (m : localJoin T L) (v : D.moduleSubgroup),
        τ (q m) (Additive.ofMul (QuotientGroup.mk' (sourceLocalCentralizer D) v)) =
          Additive.ofMul (QuotientGroup.mk' (sourceLocalCentralizer D)
            ⟨(m : G) * (v : G) * (m : G)⁻¹,
              (mem_normalizer_iff.mp (D.join_normalizes_module m.property) v).mp
                v.property⟩)) := by
  dsimp only
  let := (source_parabolic_module_reduced D).normal
  obtain ⟨τ,hfaithful,hcubic,hτ⟩ := source_local_quotient_faithful_cubic_action D hbound
  obtain ⟨i,hi,hnormal,hdiagram⟩ := source_a5_local_product_embedding D e hn ht htn
  exact ⟨τ,i,hfaithful,hcubic,hi,hnormal,hdiagram,hτ⟩

end CFSG.Quasithin.Chapter10
