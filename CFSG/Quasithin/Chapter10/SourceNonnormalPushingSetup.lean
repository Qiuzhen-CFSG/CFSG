module
public import CFSG.Quasithin.Chapter10.SourceNonnormalIntersectionComponent
public import CFSG.Quasithin.Chapter10.SourceSetup
public import CFSG.Quasithin.Chapter3.Section02.Basic
public import CFSG.Quasithin.Chapter4.Section02.Unitary.FullModule
public import Theory.GroupTheory.ReducedNormal.SubspaceGroupConsequences

/-!
# Original pushing-up data for the full component orbit

The genuine source uniqueness theorem and the two-perfect orbit L₀ supply
Hypothesis 4.1.1 with M=N_G(L₀). The original homogeneous constituent is
generated by L₀ and lies in the omega-center of O₂(L₀T). Sylow conjugacy
inside the literal section centralizer embeds that constituent into the
full omega-center commutator for every chosen section-centralizer Sylow.
In particular that full module is nontrivial. No normalization of L is used.

These are the original 4.2.2 and module clauses of 4.2.4, needed by the
nonnormal covering argument in 4.2.12–13. Source: Aschbacher–Smith,
combined manuscript of 1 March 2004, printed pp.608–610.
-/

public section
open Subgroup Theory.GroupTheory Stellmacher
open scoped Pointwise IsMulCommutative
open Representation.BinaryOffender Representation.BinaryOffender.Homogeneous
namespace CFSG.Quasithin.Chapter10
open Chapter3.Section02 Chapter4 Chapter4.Section02.Unitary
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L : Subgroup G}
  (D : FundamentalSetup KnownSimple.IsKnownSimple T L)

include D in
private theorem source_uniqueness :
    Chapter1.Section02.NonsolvableUniquenessConclusion T L :=
  Chapter1.Section02.nonsolvable_uniqueness_of_theoremsAC
    (fun X _ _ => ChapterA.Section02.theoremA_knownSimple (G := X))
    (fun X _ _ => ChapterA.Section02.theoremC_knownSimple (G := X))
    D.simpleQTKE T D.maximal

theorem source_orbit_hypothesis411 :
    Hypothesis411 KnownSimple.IsKnownSimple T D.maximalLocal (localOrbit T L) := by
  apply hypothesis411_of_normal_unique_sylow_join D.simpleQTKE
    (D.lemma_3_2_3_uniqueness (source_uniqueness D)) le_rfl
  exact (pResidual_eq_top_iff 2 _).mp D.orbit_residual

private theorem local_module_commutator :
    D.moduleSubgroup = ⁅D.moduleSubgroup,localOrbit T L⁆ := by
  rw [D.module_eq_subspaceImage]
  exact ReducedNormal.subspaceImage_eq_commutator (localJoin T L) _ (localOrbit T L)
    le_sup_left (orbitSpan_component_invariant _ D.homogeneous.normalizes D.homogeneous.isIrrPlus)
    (orbitSpan_full_commutator _ D.homogeneous.normalizes D.homogeneous.isIrrPlus)

private theorem local_module_le_full :
    D.moduleSubgroup ≤ fullModule (localOrbit T L) ((localJoin T L).pCoreIn 2) := by
  let := D.module_elementary
  have hv : D.moduleSubgroup ≤ omegaOneCenterAmbient ((localJoin T L).pCoreIn 2) := by
    intro v hv
    apply (mem_omegaOneCenterAmbient_iff _ v).mpr
    refine ⟨D.module_le_core hv,?_,?_⟩
    · exact elemPow_eq_one_of_isElementaryAbelian (p := 2) v hv
    · intro q hq
      exact (mem_centralizer_iff.mp (D.core_centralizes_module hq) v hv).symm
  exact (local_module_commutator D).trans_le (commutator_mono hv le_rfl)

theorem source_orbit_fullModule_comparison
    (S : Sylow 2 (sectionCentralizerIn D.maximalLocal (localOrbit T L))) :
    ∃ c : sectionCentralizerIn D.maximalLocal (localOrbit T L),
      ((localJoin T L).pCoreIn 2).map (MulAut.conj (c : G)).toMonoidHom =
        (S : Subgroup (sectionCentralizerIn D.maximalLocal (localOrbit T L))).map
          (sectionCentralizerIn D.maximalLocal (localOrbit T L)).subtype ∧
      D.moduleSubgroup.map (MulAut.conj (c : G)).toMonoidHom ≤
        fullModule (localOrbit T L)
          ((S : Subgroup (sectionCentralizerIn D.maximalLocal (localOrbit T L))).map
            (sectionCentralizerIn D.maximalLocal (localOrbit T L)).subtype) := by
  let X := localOrbit T L
  let C := sectionCentralizerIn D.maximalLocal X
  have hs := ChapterA.Section04.sylow_core_sectionCentralizer T X
    ((pResidual_eq_top_iff 2 _).mp D.orbit_residual) (le_normalizer_componentOrbit L T)
  rw [← sectionCentralizerIn_eq_twoSectionCentralizer] at hs
  obtain ⟨S0,hS0⟩ := hs
  obtain ⟨c,hc⟩ := MulAction.exists_smul_eq C S0 S
  have hmap : ((localJoin T L).pCoreIn 2).map (MulAut.conj (c : G)).toMonoidHom =
      (S : Subgroup C).map C.subtype := by
    rw [← hS0,← hc]
    change ((S0 : Subgroup C).map C.subtype).map (MulAut.conj (c : G)).toMonoidHom =
      ((S0 : Subgroup C).map (MulAut.conj c).toMonoidHom).map C.subtype
    rw [map_map,map_map]
    rfl
  have hXc : X.map (MulAut.conj (c : G)).toMonoidHom = X :=
    mem_normalizer_iff_map_conj_eq.mp c.property.1
  refine ⟨c,hmap,?_⟩
  have hv := map_mono (f := (MulAut.conj (c : G)).toMonoidHom) (local_module_le_full D)
  rwa [fullModule_map,hXc,hmap] at hv

theorem source_orbit_fullModule_ne_bot
    (S : Sylow 2 (sectionCentralizerIn D.maximalLocal (localOrbit T L))) :
    fullModule (localOrbit T L)
      ((S : Subgroup (sectionCentralizerIn D.maximalLocal (localOrbit T L))).map
        (sectionCentralizerIn D.maximalLocal (localOrbit T L)).subtype) ≠ ⊥ := by
  obtain ⟨c,_,hv⟩ := source_orbit_fullModule_comparison D S
  intro he
  apply D.module_ne_bot
  exact (D.moduleSubgroup.map_eq_bot_iff_of_injective (MulAut.conj (c : G)).injective).mp
    (bot_unique (he ▸ hv))
end CFSG.Quasithin.Chapter10
