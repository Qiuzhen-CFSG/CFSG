/-!
# Odd-core control on the original A5 pair module

For the actual Fundamental Setup, an odd actor centralizing L₀/O₂(L₀)
and the full module V fixes a perfect residual covering L₀ modulo its
full two-core. The same V is generated by that residual and lies in its
two-core. The intrinsic A5 moved-factor bound gives |V|≥16, so A.1.28
and A.1.26 centralize the odd core of the actor normalizer. The proved
identity N_G(V)=M then places that odd core in M.

The H-star consumer retains the literal Cartan actor and its escaping
normalizer. Its section-centralizer and module-fixation conditions remain
explicit. This proves the odd-core step of4.4.8 without a normalized
chosen component or covering-uniqueness premise; it does not prove the
remaining nonnormal-pair4.4.3 exclusion or Hall placement in10.2.3.

Source: Aschbacher–Smith,4.4.5 and4.4.8, printed p.620, and the proof
of10.2.3, printed pp.744–745, combined manuscript of1 March2004.
-/

public section
open Subgroup Theory.GroupTheory
open scoped Pointwise
namespace CFSG.Quasithin.Chapter10
open Chapter3.Section02 Chapter4 Chapter4.Section04
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L : Subgroup G}
  (D : FundamentalSetup KnownSimple.IsKnownSimple T L)

include D in
private theorem source_uniqueness :
    Chapter1.Section02.NonsolvableUniquenessConclusion T L :=
  Chapter1.Section02.nonsolvable_uniqueness_of_theoremsAC
    (fun X _ _ => ChapterA.Section02.theoremA_knownSimple (G := X))
    (fun X _ _ => ChapterA.Section02.theoremC_knownSimple (G := X))
    D.simpleQTKE T D.maximal

private theorem full_core_centralizes :
    (localOrbit T L).pCoreIn 2 ≤ centralizer (D.fullModule : Set G) := by
  have hc : (localOrbit T L).pCoreIn 2 ≤ D.maximalLocal.pCoreIn 2 :=
    pCoreIn_mono_of_normalizes (localOrbit T L).le_normalizer le_rfl
  apply hc.trans
  apply le_centralizer_iff.mpr
  intro v hv q hq
  obtain ⟨v',hv',rfl⟩ := D.fullModule_le_reduced (source_uniqueness D) hv
  obtain ⟨q',hq',rfl⟩ := hq
  exact congrArg Subtype.val (reducedPSubgroup_le_centralizer_pCore 2 D.maximalLocal hv' q' hq')

/-- The actual original full module survives in the fixed residual of L₀. -/
theorem source_fullModule_oddActor_cover
    (B : Subgroup G) (hB : B ≤ sectionCentralizer (localOrbit T L))
    (hodd : Odd (Nat.card B)) (hBV : B ≤ centralizer (D.fullModule : Set G)) :
    let F := (solvableResidual (localOrbit T L ⊓ centralizer (B : Set G) : Subgroup G)).map
      (localOrbit T L ⊓ centralizer (B : Set G)).subtype
    (localOrbit T L : Set G) = (F : Set G) * ((localOrbit T L).pCoreIn 2 : Set G) ∧
      D.fullModule = ⁅D.fullModule,F⁆ ∧ D.fullModule ≤ F.pCoreIn 2 := by
  let X := localOrbit T L
  let C := X ⊓ centralizer (B : Set G)
  let F := (solvableResidual C).map C.subtype
  let := Chapter1.mem_L_isPerfect D.maximal.1
  let : Group.IsPerfect X := isPerfect_iSup_conjugates L (T : Subgroup G)
  have hcover : (X : Set G) = (F : Set G) * (X.pCoreIn 2 : Set G) :=
    perfect_centralizer_cover X B hB hodd
  have he : D.fullModule = ⁅D.fullModule,F⁆ :=
    (D.fullModule_eq_commutator (source_uniqueness D)).trans
      (commutator_eq_of_product_centralizing_factor hcover
        (le_centralizer_iff.mp (full_core_centralizes D)))
  have hVC : D.fullModule ≤ C := le_inf D.fullModule_le_orbit (le_centralizer_iff.mp hBV)
  have hVF : D.fullModule ≤ normalizer (F : Set G) :=
    hVC.trans (C.le_normalizer.trans
      (normalizer_le_normalizer_characteristic_image C (solvableResidual C)))
  have hVFin : D.fullModule ≤ F := he ▸ le_normalizer_iff_commutator_le_right.mp hVF
  have hFN : F ≤ normalizer (D.fullModule : Set G) :=
    ((map_subtype_le _).trans inf_le_left).trans
      (X.le_normalizer.trans D.maximalLocal_normalizes_fullModule)
  let := D.fullModule_elementary (source_uniqueness D)
  exact ⟨hcover,he,le_pCoreIn_of_normalizes
    (IsElementaryAbelian.isPGroup 2 D.fullModule) hVFin hFN⟩

private theorem perfect_isPPerfect {X : Type*} [Group X] [Finite X]
    [Group.IsPerfect X] : IsPPerfect 2 X := by
  intro N hN hp
  let := hN
  by_contra hne
  let : Nontrivial (X ⧸ N) := QuotientGroup.nontrivial_iff.mpr hne
  let := hp.isNilpotent
  exact Group.IsPerfect.not_isSolvable (X ⧸ N) inferInstance

/-- Source4.4.8 on the original A5 module and literal odd normalizer. -/
theorem source_a5_oddNormalizer_oddCore
    (e : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 5))
    (B : Subgroup G) (hB : B ≤ sectionCentralizer (localOrbit T L))
    (hodd : Odd (Nat.card B)) (hBV : B ≤ centralizer (D.fullModule : Set G)) :
    let O := (pPrimeCore 2 (normalizer (B : Set G))).map (normalizer (B : Set G)).subtype
    ⁅D.fullModule,O⁆ = ⊥ ∧ O ≤ D.maximalLocal := by
  let N := normalizer (B : Set G)
  let C := localOrbit T L ⊓ centralizer (B : Set G)
  let F := (solvableResidual C).map C.subtype
  have hFN : F ≤ N := ((map_subtype_le _).trans inf_le_right).trans
    (Subgroup.centralizer_le_normalizer _)
  have hVN : D.fullModule ≤ N := (le_centralizer_iff.mp hBV).trans
    (Subgroup.centralizer_le_normalizer _)
  obtain ⟨_,he,_⟩ := source_fullModule_oddActor_cover D B hB hodd hBV
  let : Group.IsPerfect F := Group.IsPerfect.map C.subtype
  let : Group.IsPerfect (F.subgroupOf N) := Group.IsPerfect.ofSurjective
    (f := (subgroupOfEquivOfLe hFN).symm.toMonoidHom) (subgroupOfEquivOfLe hFN).symm.surjective
  let := D.fullModule_elementary (source_uniqueness D)
  let : IsElementaryAbelian 2 (D.fullModule.subgroupOf N) := IsElementaryAbelian.subgroupOf hVN
  have heN : D.fullModule.subgroupOf N = ⁅D.fullModule.subgroupOf N,F.subgroupOf N⁆ := by
    apply map_injective N.subtype_injective
    rw [map_commutator,map_subgroupOf_eq_of_le hVN,map_subgroupOf_eq_of_le hFN]
    exact he
  have hLV : L ≤ normalizer (D.fullModule : Set G) :=
    ((le_componentOrbit L T).trans (localOrbit T L).le_normalizer).trans
      D.maximalLocal_normalizes_fullModule
  have hc : 16 ≤ Nat.card D.fullModule := (source_a5_full_moved_card D e).trans
    (Nat.card_le_card_of_injective _ (inclusion_injective
      (le_normalizer_iff_commutator_le_left.mp hLV)))
  have hcN : 8 < Nat.card (D.fullModule.subgroupOf N) := by
    rw [Nat.card_congr (subgroupOfEquivOfLe hVN).toEquiv]
    omega
  have hh := ChapterA.large_elementary_commutator_centralizes_oddCore
    (D.simpleQTKE.quasithin.subgroup N) (F.subgroupOf N) (D.fullModule.subgroupOf N)
    perfect_isPPerfect hcN heN
  have hm := congrArg (Subgroup.map N.subtype) hh
  have hcomm : ⁅D.fullModule,(pPrimeCore 2 N).map N.subtype⁆ = ⊥ := by
    simpa only [map_commutator,map_subgroupOf_eq_of_le hVN,Subgroup.map_bot] using hm
  refine ⟨hcomm,?_⟩
  rw [← source_fullModule_normalizer D]
  exact (le_centralizer_iff.mp (commutator_eq_bot_iff_le_centralizer.mp hcomm)).trans
    (Subgroup.centralizer_le_normalizer _)

open ChapterB ChapterE ChapterE.Section06.FixedPointBounds
open ChapterE.Section06.FixedPointBounds.ParabolicCartan

/-- The actual H-star Cartan actor supplies an escaping odd normalizer whose
odd core is already contained in M. The two displayed actor conditions are
exactly the section-centralizer and module-fixation clauses of4.4.1. -/
theorem source_a5_hstar_cartan_oddCore
    (e : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 5))
    (hn : ¬ (T : Subgroup G) ≤ normalizer (L : Set G))
    {H : Subgroup G} (hH : H ∈ Chapter3.HStar (T : Subgroup G) D.maximalLocal)
    (hlarge : 1 < generationParameter H) :
    let hP := source_a5_hstar_minimal_parabolic D e hn hH
    ∃ n : ℕ, IsEGenerated n H ∧ generationParameter H ≤ n ∧
      ∃ d : IntrinsicHallCartanData (T.subtype hH.1.1.2) hP n,
        minimalParabolicMax (T.subtype hH.1.1.2) hP = D.maximalLocal.subgroupOf H ∧
        ∀ (p : ℕ) (_ : Fact p.Prime) (A : Subgroup H),
          Odd p → A ≤ d.witness.cyclicGroup → IsPGroup p A →
          A.map H.subtype ≤ sectionCentralizer (localOrbit T L) →
          A.map H.subtype ≤ centralizer (D.fullModule : Set G) →
          let N := normalizer (A.map H.subtype : Set G)
          let O := (pPrimeCore 2 N).map N.subtype
          ¬ N ≤ D.maximalLocal ∧ ⁅D.fullModule,O⁆ = ⊥ ∧ O ≤ D.maximalLocal := by
  obtain ⟨n,hg,hb,d,hm,hescape⟩ := source_a5_hstar_cartan_data D e hn hH hlarge
  refine ⟨n,hg,hb,d,hm,?_⟩
  intro p hp A ho hA hAp hs hf
  have hodd : Odd (Nat.card (A.map H.subtype)) := by
    rw [card_map_of_injective H.subtype_injective]
    obtain ⟨k,hk⟩ := hAp.exists_card_eq
    rw [hk]
    exact ho.pow
  have hc := source_a5_oddNormalizer_oddCore D e (A.map H.subtype) hs hodd hf
  exact ⟨fun hN => hescape p hp A ho hA hAp (inf_le_right.trans hN),hc⟩
end CFSG.Quasithin.Chapter10
