module
public import CFSG.Quasithin.Chapter10.SourceLinearThreeReplacement.Contracts
public import CFSG.Quasithin.ChapterE.Section01.MinimalParabolicGeneration

/-!
# Generation-one overgroups of the linear-three survivor

The natural moved section has order eight. The original point-centralizer
control therefore gives r(G,V) ≥ 3, while the survivor has w(G,V) = 2.
The actual E.3.35 containment bound excludes every Sylow overgroup with
attained generation parameter one. A group generated by its Sylow
normalizer and generation-one minimal parabolics consequently lies in M.

Source: Aschbacher--Smith 10.3.3 and its reuse in the final paragraph of
§10.3, printed pp.756--757. This proves the exclusion, not the assertion
that a particular model has such a generating family.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter10.SourceLinearThreeReplacement.Overgroups
open Chapter3.Section02 ChapterE
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L : Subgroup G}
  {D : FundamentalSetup KnownSimple.IsKnownSimple T L}

/-- The actual natural section and point centralizers force r(G,V) ≥ 3. -/
theorem globalR_ge_three (s : SourceLinearThreeSurvivor T D) :
    (3 : ℕ∞) ≤ globalR D.fullModule := by
  have hcard := s.natural.card_section
  have hn : 0 < Nat.card (⁅D.fullModule,L⁆ ⊓ centralizer (L : Set G) : Subgroup G) :=
    Nat.card_pos
  have hsize : 8 ≤ Nat.card (⁅D.fullModule,L⁆ : Subgroup G) := by
    simp only [Nat.card_fun, Nat.card_fin, Nat.card_zmod] at hcard
    norm_num at hcard
    change Nat.card (⁅D.fullModule,L⁆ : Subgroup G) =
      8 * Nat.card (⁅D.fullModule,L⁆ ⊓ centralizer (L : Set G) : Subgroup G) at hcard
    omega
  have hLV : L ≤ normalizer (D.fullModule : Set G) :=
    ((le_componentOrbit L T).trans (localOrbit T L).le_normalizer).trans
      D.maximalLocal_normalizes_fullModule
  have hr := source_fullModule_globalR_lower_of_element_centralizers D
    (le_normalizer_iff_commutator_le_left.mp hLV) s.pointCentralizers
  have hlog : 3 ≤ Nat.log 2 (Nat.card (⁅D.fullModule,L⁆ : Subgroup G)) := by
    have := Nat.log_mono_right (b := 2) hsize
    norm_num at this
    exact this
  exact le_trans (by exact_mod_cast hlog) hr

/-- The exclusion applies to every actual Sylow overgroup, without an H*
minimality premise or a callback to the final normalization theorem. -/
theorem le_maximal_of_generation_one (s : SourceLinearThreeSurvivor T D)
    {H : Subgroup G} (hTH : (T : Subgroup G) ≤ H)
    (hn : generationParameter H = 1) : H ≤ D.maximalLocal := by
  by_contra hout
  have hb := source_overgroup_generation_bound D hTH hout (by omega)
  rw [s.weakClosure, hn] at hb
  rcases min_le_iff.mp hb with hw | hr
  · exact (by decide : ¬ (2 : ℕ∞) ≤ 1) hw
  · exact (by decide : ¬ (3 : ℕ∞) ≤ 1) ((globalR_ge_three s).trans hr)

/-- Genuine E-generation at one suffices; the chosen central involution
proves even order, so the numeric minimum is positive and attained. -/
theorem le_maximal_of_eGenerated_one (s : SourceLinearThreeSurvivor T D)
    (d : CentralizerData T D s) {H : Subgroup G}
    (hTH : (T : Subgroup G) ≤ H) (hgen : IsEGenerated 1 H) :
    H ≤ D.maximalLocal := by
  have hd : 2 ∣ Nat.card H := by
    have hh := orderOf_dvd_natCard (⟨d.first * d.second,hTH d.central.1⟩ : H)
    simpa only [Subgroup.orderOf_mk,d.order] using hh
  have heven : ¬ Odd (Nat.card H) := Nat.not_odd_iff_even.mpr (even_iff_two_dvd.mpr hd)
  have hpos := (generationParameter_spec heven ⟨1,by decide,hgen⟩).1
  have hle := generationParameter_le (by decide : 0 < 1) hgen
  exact le_maximal_of_generation_one s hTH (by omega)

/-- The precise generated-family exclusion used twice on printed p.756.
Every member of the family contains the original full Sylow subgroup. -/
theorem le_maximal_of_generation_one_family (s : SourceLinearThreeSurvivor T D)
    {H : Subgroup G} (Δ : Set (Subgroup G))
    (hnorm : H ⊓ normalizer (T : Set G) ≤ D.maximalLocal)
    (hgen : H = (H ⊓ normalizer (T : Set G)) ⊔ sSup Δ)
    (hΔ : ∀ P ∈ Δ, (T : Subgroup G) ≤ P ∧ generationParameter P = 1) :
    H ≤ D.maximalLocal := by
  rw [hgen]
  exact sup_le hnorm (sSup_le fun P hP =>
    le_maximal_of_generation_one s (hΔ P hP).1 (hΔ P hP).2)

/-- In particular an escaping overgroup cannot have the stated source
generating family. Model-specific generation remains a separate assertion. -/
theorem not_generation_one_family (s : SourceLinearThreeSurvivor T D)
    {H : Subgroup G} (hout : ¬ H ≤ D.maximalLocal)
    (Δ : Set (Subgroup G))
    (hnorm : H ⊓ normalizer (T : Set G) ≤ D.maximalLocal)
    (hΔ : ∀ P ∈ Δ, (T : Subgroup G) ≤ P ∧ generationParameter P = 1) :
    H ≠ (H ⊓ normalizer (T : Set G)) ⊔ sSup Δ :=
  fun he => hout (le_maximal_of_generation_one_family s Δ hnorm he hΔ)

end CFSG.Quasithin.Chapter10.SourceLinearThreeReplacement.Overgroups
