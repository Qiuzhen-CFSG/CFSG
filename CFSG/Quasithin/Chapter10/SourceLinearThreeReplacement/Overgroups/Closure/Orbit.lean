module
public import CFSG.Quasithin.Chapter1.Section03.Embeddings.Source.Three
public import Theory.GroupTheory.ConjugateSpanOrder

/-!
# The literal normal closure in the three-complement embedding theorem

The detected component orbit is normal in the local overgroup and satisfies
`[orbit,P] = orbit`. Since the complement P lies in X, its commutators lie
in the normal closure of X. Conversely, the orbit contains X and is normal,
so it contains that closure. This proves equality, retaining relative
normality and all the adequate embedding alternatives, including Held.

This is the normal-closure step used in Aschbacher--Smith 10.2.4, printed
p.747, from the component detection in 1.3.4, pp.509--511. Recognition of
the Chapter 10 seed and the further model sieve are separate obligations.
-/

public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter10.SourceLinearThreeReplacement.Overgroups.Closure
open Chapter1 Chapter1.XiEmbedding
universe u
variable {G : Type u} [Group G]

/-- A relatively normal subgroup generated by its commutators with a
subgroup of X is exactly the H-normal closure of X. -/
theorem normalClosure_eq_of_commutator {X P H K : Subgroup G}
    (hPX : P ≤ X) (hXK : X ≤ K) (hKH : K ≤ H)
    (hn : (K.subgroupOf H).Normal) (hc : ⁅K,P⁆ = K) :
    conjugateSpanBy X H = K := by
  apply le_antisymm
  · exact conjugateSpanBy_le hXK
      ((normal_subgroupOf_iff_le_normalizer hKH).mp hn)
  · rw [← hc]
    exact (commutator_mono le_rfl (hPX.trans (le_conjugateSpanBy X H))).trans
      (le_normalizer_iff_commutator_le_right.mp
        (hKH.trans (le_normalizer_conjugateSpanBy X H)))

/-- The adequate intrinsic p=3 theorem with the original H-normal closure
identified, rather than merely contained in the detected component orbit. -/
theorem adequate_three_normalClosure [Finite G] {T X P H : Subgroup G}
    (h : LocalInput 3 T X P H) (hH : IsSQTK KnownSimple.IsKnownSimple H)
    (hT : IsSylowIn 2 T H) :
    conjugateSpanBy X H = X ∨ ∃ I : Subgroup G,
      I ∈ cComponentsIn H ∧ IsQuasisimple (XiQuotient I) ∧
      ((componentOrbit I T).subgroupOf H).Normal ∧
      ⁅componentOrbit I T,P⁆ = componentOrbit I T ∧
      P ≤ componentOrbit I T ∧
      conjugateSpanBy X H = componentOrbit I T ∧
      (Alternatives 3 T P I ∨ HeldAlternative 3 T P I) := by
  let hA := fun (Y : Type u) [Group Y] [Finite Y] =>
    ChapterA.Section02.theoremA_knownSimple (G := Y)
  let hC := fun (Y : Type u) [Group Y] [Finite Y] =>
    ChapterA.Section02.theoremC_knownSimple (G := Y)
  rcases h.normal_or_detected_containment hA hC hH hT with
    hn | ⟨I,hI,hn,hcomm,hP,hX⟩
  · exact Or.inl (le_antisymm
      (conjugateSpanBy_le le_rfl
        ((normal_subgroupOf_iff_le_normalizer (le_sup_left.trans h.overgroup)).mp hn))
      (le_conjugateSpanBy X H))
  · have hIH : componentOrbit I T ≤ H := (componentOrbit_le_sup I T).trans
      (sup_le hI.mem.1 (le_sup_right.trans h.overgroup))
    have he := normalClosure_eq_of_commutator
      (le_sup_right.trans h.complement.le) hX hIH hn hcomm
    refine Or.inr ⟨I,hI.mem,hI.quasisimple,hn,hcomm,hP,he,?_⟩
    by_cases hi : T ≤ normalizer I
    · have horbit : componentOrbit I T = I :=
        le_antisymm (iSup_conjugates_le_of_le_normalizer I T I le_rfl hi)
          (le_componentOrbit I T)
      rw [horbit] at hn hcomm hP
      exact InvariantThree.Source.alternatives_knownSimple h hH hT hI.mem.1 hn
        hI.quasisimple hP hcomm
    · let hs : SwappedSylowInput KnownSimple.IsKnownSimple 3 T X P H I :=
        { toLocalInput := h
          sqtk := hH
          component := hI.mem
          quasisimple := hI.quasisimple
          orbit_normal := hn
          complement_le_orbit := hP
          orbit_commutator := hcomm
          noncentral := hI.noncentral_component_core
          not_invariant := hi
          sylow_two := hT }
      obtain ⟨he,hf,hm⟩ := SwappedSylow.embedding_of_theoremsAC hA hC hs
      exact Or.inl ⟨he,Or.inl ⟨hf,hm⟩⟩

end CFSG.Quasithin.Chapter10.SourceLinearThreeReplacement.Overgroups.Closure
