module
public import CFSG.Quasithin.Chapter10.SourceLinearThreeReplacement.Geometry.CoreReduced.Inputs

/-!
# The remaining natural-module input to the full-action proof

The required calculation has literal subgroups: in the noncentralizing branch,
the first moved factor's centralizer of V_z is exactly the line generated by a.
The expected proof uses the original natural
SL3(2) section and irreducibility of V/E under X T. This proposition states
the outstanding obligation and supplies no proof of it.

Source: Aschbacher--Smith 10.2.11(3), printed p.754.
-/

@[expose] public noncomputable section

namespace CFSG.Quasithin.Chapter10.SourceLinearThreeReplacement.Geometry.CoreReduced.FullAction
open Subgroup Theory.GroupTheory
open Chapter3.Section02
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L : Subgroup G}
  {D : FundamentalSetup KnownSimple.IsKnownSimple T L}
  {s : SourceLinearThreeSurvivor T D} {a b : G}

/-- The local fixed-subgroup calculation used by the full-action argument. -/
def MovedFactorFixedAt (T : Sylow 2 G) : Prop :=
  ∀ (L : Subgroup G) (D : FundamentalSetup KnownSimple.IsKnownSimple T L)
    (s : SourceLinearThreeSurvivor T D) (a b : G) (c : Configuration s a b),
    SeedAnalysis c →
    centralizerModule a b ≤ centerIn ((centralizer ({a*b} : Set G)).pCoreIn 2) →
    ¬ D.fullModule ≤ centralizer (centralizerModule a b : Set G) →
    ⁅D.fullModule,L⁆ ⊓ centralizer (centralizerModule a b : Set G) = zpowers a

end CFSG.Quasithin.Chapter10.SourceLinearThreeReplacement.Geometry.CoreReduced.FullAction
