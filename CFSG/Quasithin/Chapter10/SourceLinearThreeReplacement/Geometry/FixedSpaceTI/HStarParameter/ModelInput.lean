module
public import CFSG.Quasithin.ChapterB.Section06To07.Structure
public import CFSG.Quasithin.ChapterE.Section04.Basic
public import Theory.Representation.BinaryOffender.Homogeneous.Basic
public import Theory.SpecificGroups.SymmetricFive.WreathComponents

/-!
# The deleted-pair module input to the H-star parameter argument

This is a finite representation-theoretic obligation. The module is generated
by the fixed vectors of the actual maximal Sylow overgroup. In the symmetric-five
wreath model the corresponding permutation module on 25 points has constant,
deleted-sum and deleted-tensor pieces. A nontrivial faithful submodule of one
of the latter two types is required, with the fixed-space parameter on its
full actor. An irreducible quotient alone does not meet this interface.

Source: Aschbacher--Smith 10.3.1, printed pp.755--756. The original H-star
quotient and fixed-seed hypotheses must be established by the source assembly.
-/

@[expose] public section
namespace CFSG.Quasithin.Chapter10.SourceLinearThreeReplacement.Geometry.FixedSpaceTI.HStarParameter
open ChapterB ChapterE Representation.BinaryOffender Representation.BinaryOffender.Homogeneous
universe u v

/-- The independent direct-sum/tensor calculation, including selection inside
an actual module generated by its maximal-overgroup fixed vectors. -/
def WreathFixedSeedBound : Prop :=
  ∀ (X : Type u) [Group X] [Finite X]
    (V : Type v) [AddCommGroup V] [Module (ZMod 2) V] [Finite V]
    (ρ : Representation (ZMod 2) X V), Function.Injective ρ →
    Nonempty (X ≃* Theory.SpecificGroups.SymmetricFive.WreathComponents.W) →
    ∀ (P : Sylow 2 X) (hP : IsMinimalParabolicOver P ⊤),
      orbitSpan ρ ⊤ (fixedSpace ρ (minimalParabolicMax P hP)) = ⊤ →
      ∃ I : Subrepresentation ρ,
        Function.Injective I.toRepresentation ∧ moduleA I.toRepresentation ≤ 1

end CFSG.Quasithin.Chapter10.SourceLinearThreeReplacement.Geometry.FixedSpaceTI.HStarParameter
