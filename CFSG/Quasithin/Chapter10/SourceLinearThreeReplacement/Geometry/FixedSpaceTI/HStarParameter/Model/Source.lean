module
public import CFSG.Quasithin.Chapter10.SourceLinearThreeReplacement.Geometry.FixedSpaceTI.HStarParameter.ModelInput
public import CFSG.Quasithin.Chapter10.SourceLinearThreeReplacement.Geometry.FixedSpaceTI.HStarParameter.Model.Image
public import Theory.Representation.BinaryPermutation.FiveWreathGrid

/-!
# The faithful wreath submodule generated by maximal-overgroup fixed seeds

The Sylow two-subgroup fixes a point in the odd-degree grid action. Its
point stabilizer is proper and therefore lies in the unique maximal Sylow
overgroup. A moved fixed seed gives an equivariant map from the grid module
which separates two point vectors. The constant/pair/tensor decomposition
makes one of its two model restrictions nonzero; simplicity makes it
injective. The actual image is faithful and has fixed-space parameter at
most one, including the full factor-exchanging actor.

Source: Aschbacher--Smith 10.3.1, printed pp.755--756. This proves exactly
the independent model input; the original quotient geometry and Hall
faithfulness remain with their source assembly owners.
-/

public section

open Representation Representation.BinaryOffender Representation.BinaryOffender.Homogeneous
namespace CFSG.Quasithin.Chapter10.SourceLinearThreeReplacement.Geometry.FixedSpaceTI.HStarParameter
open ChapterB Model BinaryPermutation BinaryPermutation.FiveTensorSquare
universe u v

private theorem exists_moved_seed {X U : Type*} [Group X] [Nontrivial X]
    [AddCommGroup U] [Module (ZMod 2) U]
    (ρ : Representation (ZMod 2) X U) (hρ : Function.Injective ρ)
    (I : Submodule (ZMod 2) U) (hgen : orbitSpan ρ ⊤ I = ⊤) :
    ∃ v ∈ I, ∃ g : X, ρ g v ≠ v := by
  by_contra! hh
  have hs : orbitSpan ρ ⊤ I ≤ fixedSpace ρ ⊤ := by
    apply iSup_le
    rintro t _ ⟨w, hw, rfl⟩
    change ∀ g : (⊤ : Subgroup X), ρ g (ρ t w) = ρ t w
    intro g
    rw [hh w hw t, hh w hw g]
  rw [hgen] at hs
  obtain ⟨g, hg⟩ := exists_ne (1 : X)
  apply hg
  apply hρ
  apply LinearMap.ext
  intro w
  exact (hs (Submodule.mem_top) (⟨g, trivial⟩ : (⊤ : Subgroup X))).trans (by simp)

/-- The literal source model input: an actual faithful subrepresentation is
selected inside the module generated by maximal-overgroup fixed vectors. -/
theorem wreathFixedSeedBound : WreathFixedSeedBound.{u,v} := by
  intro X _ _ U _ _ _ ρ hρ ⟨e⟩ P hP hgen
  classical
  let : MulAction X Grid := MulAction.compHom Grid e.toMonoidHom
  let : MulAction.IsPretransitive X Grid := MulAction.isPretransitive_compHom e.surjective
  let : Nontrivial Wreath := ⟨⟨(⟨fun _ => 1, swapIndex⟩ : Wreath), 1,
    fun h => swapIndex_ne_one (congrArg RegularWreathProduct.right h)⟩⟩
  let : Nontrivial X := e.toEquiv.nontrivial
  obtain ⟨x, hx⟩ := P.isPGroup'.nonempty_fixed_point_of_prime_not_dvd_card Grid
    (by norm_num [Nat.card_prod])
  have hPS : (P : Subgroup X) ≤ MulAction.stabilizer X x := by
    intro g hg
    exact hx ⟨g,hg⟩
  have hproper : MulAction.stabilizer X x ≠ ⊤ := by
    obtain ⟨y, hy⟩ := exists_ne x
    obtain ⟨g, hg⟩ := MulAction.exists_smul_eq X x y
    intro ht
    have hfix : g • x = x := (show g ∈ MulAction.stabilizer X x from ht ▸ Subgroup.mem_top g)
    exact hy (hg.symm.trans hfix)
  obtain ⟨M, hM, hSM⟩ := (eq_top_or_exists_le_coatom (MulAction.stabilizer X x)).resolve_left hproper
  have hS : MulAction.stabilizer X x ≤ minimalParabolicMax P hP := by
    rwa [minimalParabolicMax_unique P hP hM (hPS.trans hSM)] at hSM
  obtain ⟨v, hv, g, hgv⟩ := exists_moved_seed ρ hρ _ hgen
  have hvx (a : X) (ha : a • x = x) : ρ a v = v := hv ⟨a, hS ha⟩
  let F := FixedPointPermutation.orbitMap x ρ v hvx
  have haction : (FixedPointPermutation.action (K := ZMod 2) (G := X) (Ω := Grid)) =
      gridRepresentation.comp e.toMonoidHom := by
    apply MonoidHom.ext
    intro a
    apply LinearMap.ext
    intro w
    funext y
    change w (e (a⁻¹) • y) = w ((e a)⁻¹ • y)
    rw [map_inv]
  let f : IntertwiningMap (gridRepresentation.comp e.toMonoidHom) ρ := {
    toLinearMap := F.toLinearMap
    isIntertwining' a := by rw [← haction]; exact F.isIntertwining' a }
  have hxy : f (Pi.single (g • x) 1) ≠ f (Pi.single x 1) := by
    change F (Pi.single (g • x) 1) ≠ F (Pi.single x 1)
    rw [FixedPointPermutation.orbitMap_single, FixedPointPermutation.orbitMap_single,
      FixedPointPermutation.value_equivariant x ρ v hvx,
      FixedPointPermutation.value_base x ρ v hvx]
    exact hgv
  exact faithful_bounded_subrepresentation_of_nonzero_model_map ρ e
    (nonzero_model_restriction ρ e.toMonoidHom f (g • x) x hxy)
end CFSG.Quasithin.Chapter10.SourceLinearThreeReplacement.Geometry.FixedSpaceTI.HStarParameter
