module
public import CFSG.Quasithin.Chapter10.SourceLinearThreeReplacement.Wreath.Branches
public import CFSG.Quasithin.Chapter10.SourceLinearThreeReplacement.Wreath.Generation
public import CFSG.Quasithin.Chapter10.SourceLinearThreeReplacement.Wreath.Orbits
public import CFSG.Quasithin.Chapter10.SourceLinearThreeReplacement.Assembly

/-!
# Assembly of the two source branches for wreath recognition

The non-Bender alternative would produce an escaping component whose join
with T is generated by its Sylow normalizer and parameter-one minimal
parabolics. The proved containment argument excludes this. The Bender
branch then recognizes one original orbit and the actual wreath quotient;
component conjugacy supplies every orbit, and escape supplies X<K_z.

Both branch propositions remain explicit source obligations. This module
connects them to the existing replacement construction without assuming
any normality or classification of K_z.

Source: Aschbacher--Smith 10.3.3, printed p.756.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter10.SourceLinearThreeReplacement
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G}

/-- The exact recognition contract follows from the two independent source branches. -/
theorem wreathRecognition_of_branches (hB : BenderRecognitionAt T)
    (hN : NonBenderGenerationAt T) : WreathRecognitionAt T := by
  intro hmany L D s d
  classical
  have hex : ∃ I : Subgroup G,
      I ∈ Chapter1.cComponentsIn (centralizer ({d.first * d.second} : Set G)) ∧
      ¬ I ≤ D.maximalLocal ∧ ClassificationModels.IsBenderModel (I ⧸ pCore 2 I) := by
    by_contra! hnone
    obtain ⟨I, hI, hout, Δ, hΔ, hgen⟩ := hN hmany L D s d hnone
    have hYM := minimal_parabolic_family_generated_le s le_sup_right Δ hΔ hgen
    exact hout ((le_componentOrbit I (T : Subgroup G)).trans (le_sup_left.trans hYM))
  obtain ⟨I, hI, hout, hb⟩ := hex
  obtain ⟨e, horbit⟩ := hB hmany L D s d I hI hout hb
  obtain ⟨hstrict, hescape⟩ := d.strict_and_escape_of_orbit hout horbit
  exact ⟨e, hstrict, hescape, d.all_component_orbits hI horbit⟩

/-- The branch outputs feed the actual maximal faithful A5 replacement consumer. -/
theorem replacement_of_wreath_branches (hgeometry : CentralizerGeometryAt T)
    (hB : BenderRecognitionAt T) (hN : NonBenderGenerationAt T)
    (hovergroups : OvergroupSpanAt T) : SourceLinearThreeReplacementAt T :=
  replacement_of_source_inputs hgeometry (wreathRecognition_of_branches hB hN) hovergroups

end CFSG.Quasithin.Chapter10.SourceLinearThreeReplacement
