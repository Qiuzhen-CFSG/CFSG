module
public import CFSG.Quasithin.Chapter10.SourceA5PointQuasisimpleAction
public import CFSG.Quasithin.Chapter10.SourceA5PointFixedSpan
public import CFSG.Quasithin.Chapter10.SourceA5PointSmallImage

/-!
# The constrained point action from the original irreducible module

The original natural/deleted fixed-span theorem supplies the full moved
factor inside the point-component orbit. Applying the literal Thompson
argument gives the faithful FF action and quasisimple component image used
in Aschbacher–Smith 10.2.9, printed p.751. The preceding point-Sylow and
Thompson equality remain explicit earlier-source inputs.
-/

@[expose] public noncomputable section
open Subgroup Theory.GroupTheory Stellmacher Representation Representation.BinaryOffender
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter10
open Chapter3.Section02 ChapterB.InternalThompsonAction
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L : Subgroup G}
  (D : FundamentalSetup KnownSimple.IsKnownSimple T L)

local instance pointConstrainedActionElementary : IsElementaryAbelian 2 (⁅D.fullModule,L⁆ : Subgroup G) :=
  source_original_full_moved_elementary D

/-- The actual constrained point actor is quasisimple, is generated by its
commutators with the actual Thompson image, and acts on the literal reduced
orbit module through a faithful FF action. -/
theorem source_a5_point_quasisimple_ff_action_of_irreducible
    (e : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 5))
    (hi : (originalMovedQuotientAction D e).IsIrreducible)
    (hn : ¬ (T : Subgroup G) ≤ normalizer (L : Set G))
    {t v : G} (ht : t ∈ (T : Subgroup G))
    (hcross : (⁅D.fullModule,L⁆).map (MulAut.conj t).toMonoidHom ≤ centralizer (L : Set G))
    (hv : v ∈ D.fullModule) (hvne : v ≠ 1)
    (hvL : v ∈ centralizer (L : Set G))
    (hv0 : v ∉ centralizer (localOrbit T L : Set G))
    (I : Subgroup G) (hLI : L ≤ I) (hIX : I ≤ centralizer ({v} : Set G))
    (hI : (I.subgroupOf (centralizer ({v} : Set G))).IsCComponent)
    (hNI : centralizer ({v} : Set G) ≤ normalizer (I : Set G))
    (hnot : ¬ IsQuasisimple I) (hout : ¬ I ≤ D.maximalLocal)
    (hCW : centralizer (↑(⁅D.fullModule,L⁆ : Subgroup G) : Set G) ≤ D.maximalLocal)
    (hs : Chapter1.IsSylowIn 2 ((T : Subgroup G) ⊓ centralizer ({v} : Set G))
      (centralizer ({v} : Set G)))
    (hJP : elementaryAbelianMaxJ ((T : Subgroup G) ⊓ centralizer ({v} : Set G)) =
      elementaryAbelianMaxJ (T : Subgroup G)) :
    let S := (T : Subgroup G) ⊓ centralizer ({v} : Set G)
    let H := I ⊔ S
    let U := (conjugateSpanBy (⁅D.fullModule,L⁆ ⊓ centralizer (S : Set G)) I).subgroupOf H
    ∃ hr : IsPReduced 2 U, letI := hr.normal; letI := hr.elementary
      IsQuasisimple ((I.subgroupOf H).map (actionMk U)) ∧
      ⁅(I.subgroupOf H).map (actionMk U),
        (elementaryAbelianMaxJ (S.subgroupOf H)).map (actionMk U)⁆ =
        (I.subgroupOf H).map (actionMk U) ∧
      IsFFModule (V := Additive U) (action U) ∧ Function.Injective (action U) ∧
      Nonempty (ChapterB.SourceInduction.SQTKQuotient KnownSimple.IsKnownSimple (ActionQuotient U)) := by
  exact source_a5_point_quasisimple_ff_action D hn ht hcross hv hvne hvL
    I hLI hIX hI hNI hnot hout hCW hs hJP
    (source_a5_point_component_fixed_span_contains D e hi hn hvL hv0 I hLI)
end CFSG.Quasithin.Chapter10
