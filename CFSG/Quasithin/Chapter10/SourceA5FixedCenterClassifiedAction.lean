module
public import CFSG.Quasithin.Chapter10.SourceA5MovingActorGeneration
public import Theory.Representation.CentralizerQuotientRankOne
public import Theory.Representation.BinaryOffender.RankOneGeneratedFaithful
public import CFSG.Quasithin.ChapterG.Section06.SourceClassification.Complete

/-!
# G.6.4 on the actual positive fixed-center action

The selected source transvection acts on the original reduced H-star orbit W.
We retain the literal quotient H/C_H(W), but restrict its representation to
the exact orbit of the transvection displacement. Rank one and the trivial
two-core make that submodule generated by its own displacement. The source
minimal-parabolic residual containment makes the restriction faithful.
Thus every G.6.1 hypothesis is proved, and the complete G.6.4 classification
applies without a generation assumption on all of W.

Source: Aschbacher–Smith 10.2.1 and G.6.1–4, printed pp.743 and345–346.
-/

public noncomputable section
open Subgroup Stellmacher Theory.GroupTheory Representation Representation.BinaryOffender
open scoped IsMulCommutative commutatorElement
namespace CFSG.Quasithin.Chapter10
open Chapter3.Section02
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L : Subgroup G}

/-- The unchanged centralizer quotient, on its exact generated displacement
submodule, satisfies G.6.1 and the complete rank-one classification. -/
@[expose] def SourceFixedCenterClassifiedAction
    (D : FundamentalSetup KnownSimple.IsKnownSimple T L) : Prop :=
  ∃ H : Subgroup G, H ∈ Chapter3.HStar (T : Subgroup G) D.maximalLocal ∧
    H ≤ normalizer (ChapterB.baumann (T : Subgroup G) : Set G) ∧
    (let W := conjugateSpanBy (omegaOneCenterAmbient (T : Subgroup G)) H
     W ≤ omegaOneCenterAmbient (ChapterB.baumann (T : Subgroup G)) ∧
     ∃ hred : IsPReduced 2 (W.subgroupOf H),
       letI := hred.normal
       letI := hred.elementary
       let q := QuotientGroup.mk' (centralizer (W.subgroupOf H : Set H))
       let ρ := centralizerQuotient (W.subgroupOf H)
       ∃ g : H, (g:G)∈(T : Subgroup G) ⊓ localOrbit T L ∧
         pResidual 2 (H ⧸ centralizer (W.subgroupOf H : Set H)) ≤ normalClosure ({q g} : Set _) ∧
         ∃ S : Subrepresentation ρ,
           S.toSubmodule = conjugateDisplacementSpan ρ (q g) ⊤ ∧
           ChapterG.Section06.Hypotheses KnownSimple.IsKnownSimple S.toRepresentation (q g) q ∧
           Module.finrank (ZMod 2) (LinearMap.range (S.toRepresentation (q g)-(LinearMap.id : S.toSubmodule →ₗ[ZMod 2] S.toSubmodule)))=1 ∧
           ChapterG.Section06.Conclusion S.toRepresentation (q g))

theorem source_exists_fixed_center_classified_action
    (D : FundamentalSetup KnownSimple.IsKnownSimple T L)
    (e : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 5))
    (hn : ¬ (T : Subgroup G) ≤ normalizer (L : Set G))
    (hne : omegaOneCenterAmbient (T : Subgroup G) ⊓ centralizer (localOrbit T L : Set G) ≠ ⊥)
    (hout : ¬ normalizer (ChapterB.baumann (T : Subgroup G) : Set G) ≤ D.maximalLocal) :
    SourceFixedCenterClassifiedAction D := by
  obtain ⟨H,hH,hHN,hWE,hred,g,hg,v,hv,hvne,hline,⟨x,hx,hxv⟩,hres,_⟩ :=
    source_exists_fixed_center_transvection_with_residual_generation D e hn hne hout
  let W := conjugateSpanBy (omegaOneCenterAmbient (T : Subgroup G)) H
  have hWH : W ≤ H := fun x hx => hH.1.1.2
    (((mem_omegaOneCenterAmbient_iff _ _).mp (hWE hx)).1.1)
  let vH : W.subgroupOf H := ⟨⟨v,hWH hv⟩,hv⟩
  let := hred.normal
  let := hred.elementary
  let q := QuotientGroup.mk' (centralizer (W.subgroupOf H : Set H))
  let ρ := centralizerQuotient (W.subgroupOf H)
  have hρ : Function.Injective ρ := fun a b hab =>
    centralizerQuotient_faithful (W.subgroupOf H) (Units.ext hab)
  obtain ⟨_,hr,ha,horder⟩ := centralizerQuotient_rank_one_of_commutator_line
    (W.subgroupOf H) g vH
    (fun he => hvne (congrArg (fun z : W.subgroupOf H => (z.val:G)) he))
    (fun y hy => (hline y hy).imp (fun h => Subtype.ext h) (fun h => Subtype.ext h))
    ⟨⟨x,hWH hx⟩,hx,Subtype.ext hxv⟩
  have hresq : pResidual 2 (H ⧸ centralizer (W.subgroupOf H : Set H)) ≤
      normalClosure ({q g} : Set _) := by
    rw [←map_pResidual_of_surjective 2 q (QuotientGroup.mk'_surjective _)]
    have hh := Subgroup.map_mono (f:=q) hres
    rw [map_normalClosure _ q (QuotientGroup.mk'_surjective _),Set.image_singleton] at hh
    exact hh
  obtain ⟨S,hS,hgen,hrS⟩ := BinaryOffender.rank_one_generated_restriction ρ hρ
    hred.quotient_pCore_eq_bot (q g) ha hr
  have hfaith := BinaryOffender.faithful_conjugate_displacement_restriction ρ hρ
    hred.quotient_pCore_eq_bot (q g) hresq S hS
  have hG6 : ChapterG.Section06.Hypotheses KnownSimple.IsKnownSimple S.toRepresentation (q g) q := {
    finite_group := inferInstance
    finite_cover := inferInstance
    finite_displacement := inferInstance
    cover_sqtk := Chapter3.sqtk_of_mem_H D.simpleQTKE hH.1.1.1
    quotient_surjective := QuotientGroup.mk'_surjective _
    twoCore := hred.quotient_pCore_eq_bot
    faithful := hfaith
    involution := horder
    nonidentity := ha
    displacement_rank := by omega
    generated := hgen }
  exact ⟨H,hH,hHN,hWE,hred,g,hg,hresq,S,hS,hG6,hrS,ChapterG.Section06.lemma_G_6_4 hG6 hrS⟩

end CFSG.Quasithin.Chapter10
