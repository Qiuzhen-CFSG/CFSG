module
public import CFSG.Quasithin.Chapter10.SourceWeakClosure
public import CFSG.Quasithin.Chapter3.Section02.ModuleConsequences
public import Theory.SpecificGroups.Alternating.FiveChiefDegree
public import Theory.GroupTheory.SubgroupPairCentralizers
public import Theory.GroupTheory.Commutator.SimpleSubnormal

/-!
# Original A5 moved-factor size and weak-closure upper bounds

The full FSU module is generated by its local-orbit commutators. Thus the
original component acts nontrivially on its moved factor [V,L]. Perfectness
makes its action on that factor nontrivial as well. The intrinsic A5 quotient
then forces an order-five automorphism, so the factor has at least 16 elements;
no classification or chosen model for the module is required.

The genuine element-centralizer conclusion of 10.2.9(1) consequently gives
r(G,V) ≥ 4. The existing source E.3.35 containment theorem then turns an
attained generation bound n(H) ≤ 2 into w(G,V) ≤ n(H) on the same original
module. Element-centralizer containment and the generation bound retain
separate original source producers; the lower bound on w in 10.2.12 is not
asserted here.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004,
10.2.9(2) and 10.2.13, printed pp.750 and 755; E.3.35, p.238.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter10
open Chapter3.Section02
universe u
variable {G : Type u} [Group G] [Finite G] {T : Sylow 2 G} {L : Subgroup G}
  (D : FundamentalSetup KnownSimple.IsKnownSimple T L)

include D

private theorem source_uniqueness :
    Chapter1.Section02.NonsolvableUniquenessConclusion T L :=
  Chapter1.Section02.nonsolvable_uniqueness_of_theoremsAC
    (fun X _ _ => ChapterA.Section02.theoremA_knownSimple (G := X))
    (fun X _ _ => ChapterA.Section02.theoremC_knownSimple (G := X))
    D.simpleQTKE T D.maximal

/-- The original component moves the original full FSU module. -/
theorem source_full_moved_ne_bot : ⁅D.fullModule,L⁆ ≠ ⊥ := by
  intro he
  have hLC : L ≤ centralizer (D.fullModule : Set G) :=
    le_centralizer_iff.mp (commutator_eq_bot_iff_le_centralizer.mp he)
  have hTC : (T : Subgroup G) ≤ normalizer (centralizer (D.fullModule : Set G) : Set G) :=
    ((le_normalizer_componentOrbit L T).trans D.maximalLocal_normalizes_fullModule).trans
      (normalizer_le_normalizer_centralizer _)
  have hOC : localOrbit T L ≤ centralizer (D.fullModule : Set G) :=
    iSup_conjugates_le_of_le_normalizer _ _ _ hLC hTC
  have hz : D.fullModule = ⊥ := (D.fullModule_eq_commutator (source_uniqueness D)).trans
    (commutator_eq_bot_iff_le_centralizer.mpr (le_centralizer_iff.mpr hOC))
  exact D.module_ne_bot (bot_unique ((le_componentOrbit D.moduleSubgroup D.maximalLocal).trans_eq hz))

/-- The actual A5 moved factor has order at least sixteen, independently of its module model. -/
theorem source_a5_full_moved_card
    (e : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 5)) :
    16 ≤ Nat.card (⁅D.fullModule,L⁆ : Subgroup G) := by
  let W := ⁅D.fullModule,L⁆
  have hLW : L ≤ normalizer (W : Set G) := normalizer_commutator_ge_right _ _
  let f : L →* MulAut W := W.normalizerMonoidHom.comp (inclusion hLW)
  have hf : f ≠ 1 := by
    intro he
    have hLC : L ≤ centralizer (W : Set G) := by
      intro l hl w hw
      have hh := congrArg (fun a : MulAut W => (a ⟨w,hw⟩ : G))
        (congrArg (fun a : L →* MulAut W => a ⟨l,hl⟩) he)
      change l * w * l⁻¹ = w at hh
      exact (mul_inv_eq_iff_eq_mul.mp hh).symm
    let := Chapter1.mem_L_isPerfect D.maximal.1
    exact source_full_moved_ne_bot D
      (commutator_eq_bot_of_iterated_eq_bot D.fullModule L
        (commutator_eq_bot_iff_le_centralizer.mpr (le_centralizer_iff.mpr hLC)))
  let := D.fullModule_elementary (source_uniqueness D)
  have hLV : L ≤ normalizer (D.fullModule : Set G) :=
    ((le_componentOrbit L T).trans (localOrbit T L).le_normalizer).trans
      D.maximalLocal_normalizes_fullModule
  exact alternatingGroup.FiveChiefDegree.sixteen_le_card_of_nontrivial_action
    D.faithful.1.2.1 e f hf ((IsElementaryAbelian.isPGroup 2 D.fullModule).to_le
      (le_normalizer_iff_commutator_le_left.mp hLV))

/-- Source10.2.9(2), for any original submodule with the stated element-centralizer control. -/
theorem source_fullModule_globalR_lower_of_element_centralizers
    {W : Subgroup G} (hWV : W ≤ D.fullModule)
    (hcent : ∀ v ∈ W, v ≠ 1 → centralizer ({v} : Set G) ≤ D.maximalLocal) :
    (Nat.log 2 (Nat.card W) : ℕ∞) ≤ ChapterE.globalR D.fullModule := by
  unfold ChapterE.globalR
  apply le_iInf
  intro U
  apply le_iInf
  rintro ⟨hUV,hout⟩
  have hn : ¬ centralizer (U : Set G) ≤ D.maximalLocal := by
    simpa only [source_fullModule_normalizer D] using hout
  have hi := card_le_relIndex_of_centralizer_not_le D.maximalLocal U W D.fullModule hWV hcent hn
  exact_mod_cast Nat.log_mono_right (b := 2) hi

/-- In the A5 branch, original10.2.9(1) forces r(G,V) ≥ 4 without an extra rank premise. -/
theorem source_a5_globalR_four_of_element_centralizers
    (e : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 5))
    (hcent : ∀ v ∈ ⁅D.fullModule,L⁆, v ≠ 1 →
      centralizer ({v} : Set G) ≤ D.maximalLocal) :
    (4 : ℕ∞) ≤ ChapterE.globalR D.fullModule := by
  have hLV : L ≤ normalizer (D.fullModule : Set G) :=
    ((le_componentOrbit L T).trans (localOrbit T L).le_normalizer).trans
      D.maximalLocal_normalizes_fullModule
  have hi := source_fullModule_globalR_lower_of_element_centralizers D
    (le_normalizer_iff_commutator_le_left.mp hLV) hcent
  have hc := Nat.log_mono_right (b := 2) (source_a5_full_moved_card D e)
  have hfour : 4 ≤ Nat.log 2 (Nat.card (⁅D.fullModule,L⁆ : Subgroup G)) := by
    norm_num at hc
    exact hc
  exact le_trans (by exact_mod_cast hfour) hi

/-- The original overgroup has w(G,V) ≤ n(H) when its attained generation parameter is at most two. -/
theorem source_a5_globalW_le_generation_of_element_centralizers
    (e : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 5))
    (hcent : ∀ v ∈ ⁅D.fullModule,L⁆, v ≠ 1 →
      centralizer ({v} : Set G) ≤ D.maximalLocal)
    {H : Subgroup G} (hTH : (T : Subgroup G) ≤ H) (hHM : ¬ H ≤ D.maximalLocal)
    (hpos : 0 < ChapterE.generationParameter H)
    (hbound : ChapterE.generationParameter H ≤ 2) :
    ChapterE.globalW D.fullModule (T : Subgroup G) ≤
      (ChapterE.generationParameter H : ℕ∞) := by
  have hr := source_a5_globalR_four_of_element_centralizers D e hcent
  have hn : (ChapterE.generationParameter H : ℕ∞) < ChapterE.globalR D.fullModule :=
    (lt_of_le_of_lt (by exact_mod_cast hbound) (by decide : (2 : ℕ∞) < 4)).trans_le hr
  exact (min_le_iff.mp (source_overgroup_generation_bound D hTH hHM hpos)).resolve_right
    (not_le_of_gt hn)
end CFSG.Quasithin.Chapter10
