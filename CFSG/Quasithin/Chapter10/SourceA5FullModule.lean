module
public import CFSG.Quasithin.Chapter10.SourceBlockModulePlacement
public import CFSG.Quasithin.Chapter3.Section02.ModuleConsequences

/-!
# The full original module in the alternating-five Baumann exception

When the Baumann normalizer escapes M, the original component is an A₅
block and its intrinsic layer lies in the local module. The full module
is generated by its L₀-commutators. Subnormal core action puts its
L-commutators in that block layer; Sylow conjugation gives the same bound
for every factor of L₀. Thus the full module equals the local module.

This discharges the full/local-module equality in both centralizer branches
of the A₅ proof of 10.2.1, without a zero-fixed-center assumption or the
normalization conclusion of 13.3.2.
Source: Aschbacher–Smith, 10.2.1, printed pp.742–743.
-/

public section
open Subgroup Theory.GroupTheory Stellmacher
open scoped IsMulCommutative
open Representation.BinaryOffender Representation.BinaryOffender.Homogeneous
namespace CFSG.Quasithin.Chapter10
open Chapter3.Section02 ChapterC
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L : Subgroup G}
  (D : FundamentalSetup KnownSimple.IsKnownSimple T L)
include D

private theorem source_uniqueness :
    Chapter1.Section02.NonsolvableUniquenessConclusion T L :=
  Chapter1.Section02.nonsolvable_uniqueness_of_theoremsAC
    (fun X _ _ => ChapterA.Section02.theoremA_knownSimple (G := X))
    (fun X _ _ => ChapterA.Section02.theoremC_knownSimple (G := X))
    D.simpleQTKE T D.maximal

theorem source_a5_exception_fullModule_eq
    (e : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 5))
    (hn : ¬ (T : Subgroup G) ≤ normalizer (L : Set G))
    (hout : ¬ normalizer (ChapterB.baumann (T : Subgroup G) : Set G) ≤ D.maximalLocal) :
    D.fullModule = D.moduleSubgroup := by
  let H := localJoin T L
  let A := L.subgroupOf H
  let F := D.fullModule.subgroupOf H
  have hHM : H ≤ D.maximalLocal :=
    sup_le (localOrbit T L).le_normalizer (le_normalizer_componentOrbit L T)
  have hFH : D.fullModule ≤ H := (D.fullModule_le_sylow (source_uniqueness D)).trans le_sup_right
  have hLH : L ≤ H := (le_componentOrbit L T).trans le_sup_left
  let : F.Normal := normal_subgroupOf_of_le_normalizer (hHM.trans D.maximalLocal_normalizes_fullModule)
  have hpF : IsPGroup 2 F := (D.fullModule_elementary (source_uniqueness D)).isPGroup.comap_of_injective
    H.subtype H.subtype_injective
  obtain ⟨hA,ha,_⟩ := source_a5_original_block_of_baumann_not_controlled D e hn hout
  have hcomm : ⁅D.fullModule,L⁆ ≤ (blockU L).map L.subtype := by
    have hh := map_mono (f := H.subtype)
      (commutator_le_core_commutator_of_isSubnormal A F hA.subnormal
        hA.short.twoPerfect hpF le_normalizer_of_normal)
    rw [map_commutator,map_subgroupOf_eq_of_le hFH,map_subgroupOf_eq_of_le hLH] at hh
    let b : A ≃* L := subgroupOfEquivOfLe hLH
    have he : (blockU L).map L.subtype = ((blockU A).map A.subtype).map H.subtype := by
      rw [←RankOne.Solvable.blockU_map_equiv b,map_map,map_map]
      rfl
    rw [he]
    exact hh
  let C := commutatorPreimage H D.fullModule D.moduleSubgroup
  have hLC : L ≤ C := by
    apply le_commutatorPreimage hLH
    rw [commutator_comm]
    exact hcomm.trans (source_a5_original_block_module_le D e hn hout)
  have hTC : (T : Subgroup G) ≤ normalizer (C : Set G) :=
    commutatorPreimage_normalized H D.fullModule D.moduleSubgroup T D.join_normalizes_module
      ((show (T : Subgroup G) ≤ H from le_sup_right).trans H.le_normalizer)
      ((show (T : Subgroup G) ≤ D.maximalLocal from le_normalizer_componentOrbit L T).trans
        D.maximalLocal_normalizes_fullModule) D.sylow_normalizes_module
  have hOC : localOrbit T L ≤ C :=
    iSup_conjugates_le_of_le_normalizer L T C hLC hTC
  apply le_antisymm ?_ (le_componentOrbit D.moduleSubgroup D.maximalLocal)
  change D.fullModule ≤ D.moduleSubgroup
  rw [D.fullModule_eq_commutator (source_uniqueness D),commutator_comm]
  exact (commutator_mono hOC le_rfl).trans
    (commutator_commutatorPreimage_le H D.fullModule D.moduleSubgroup D.join_normalizes_module)

/-- The actual local module has the source ambient normalizer in the exception. -/
theorem source_a5_exception_module_normalizer
    (e : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 5))
    (hn : ¬ (T : Subgroup G) ≤ normalizer (L : Set G))
    (hout : ¬ normalizer (ChapterB.baumann (T : Subgroup G) : Set G) ≤ D.maximalLocal) :
    normalizer (D.moduleSubgroup : Set G) = D.maximalLocal := by
  rw [←source_a5_exception_fullModule_eq D e hn hout]
  exact source_fullModule_normalizer D

end CFSG.Quasithin.Chapter10
