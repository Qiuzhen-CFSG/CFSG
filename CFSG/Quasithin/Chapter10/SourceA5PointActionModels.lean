module
public import CFSG.Quasithin.Chapter10.SourceA5PointThompsonMovement
public import CFSG.Quasithin.ChapterB.QuasisimpleOffenderModels
public import CFSG.Quasithin.ChapterB.Section05.GeneralClassification.Complete
public import CFSG.Quasithin.Chapter10.SourceA5OriginalModuleMarking.FactorKernel
public import Theory.Representation.NormalElementaryQuotient.FullyMoved
public import CFSG.Quasithin.ChapterB.Section05.Quasisimple.SourceCompletion.SocleInduction
public import CFSG.Quasithin.Chapter10.SourceA5PointActionMarking

/-!
# The full B.5.1 conclusion for the constrained point action

Thompson movement puts the actual component image inside the offender actor.
Its two-group supplement identifies the generalized Fitting subgroup there,
so the complete B.5.1 theorem classifies the literal moved section and its
central quotient. The original point component, module and quotient maps
are retained throughout. Source: Aschbacher–Smith 10.2.9, printed p.751.
-/

@[expose] public noncomputable section
open Subgroup Theory.GroupTheory Stellmacher Representation Representation.BinaryOffender
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter10
open Chapter3.Section02 ChapterB.InternalThompsonAction
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L : Subgroup G}
  (D : FundamentalSetup KnownSimple.IsKnownSimple T L)

/-- The actual constrained point actor is quasisimple, is generated by its
commutators with the actual Thompson image, and acts on the literal reduced
orbit module through a faithful FF action. -/
theorem source_a5_point_quasisimple_source_conclusion
    (hn : ¬ (T : Subgroup G) ≤ normalizer (L : Set G))
    {t v : G} (ht : t ∈ (T : Subgroup G))
    (hcross : (⁅D.fullModule,L⁆).map (MulAut.conj t).toMonoidHom ≤ centralizer (L : Set G))
    (hv : v ∈ D.fullModule) (hvne : v ≠ 1)
    (hvL : v ∈ centralizer (L : Set G))
    (I : Subgroup G) (hLI : L ≤ I) (hIX : I ≤ centralizer ({v} : Set G))
    (hI : (I.subgroupOf (centralizer ({v} : Set G))).IsCComponent)
    (hNI : centralizer ({v} : Set G) ≤ normalizer (I : Set G))
    (hnot : ¬ IsQuasisimple I) (hout : ¬ I ≤ D.maximalLocal)
    (hCW : centralizer (↑(⁅D.fullModule,L⁆ : Subgroup G) : Set G) ≤ D.maximalLocal)
    (hs : Chapter1.IsSylowIn 2 ((T : Subgroup G) ⊓ centralizer ({v} : Set G))
      (centralizer ({v} : Set G)))
    (hJP : elementaryAbelianMaxJ ((T : Subgroup G) ⊓ centralizer ({v} : Set G)) =
      elementaryAbelianMaxJ (T : Subgroup G))
    (hspan : ⁅D.fullModule,L⁆ ≤ conjugateSpanBy
      (⁅D.fullModule,L⁆ ⊓ centralizer
        ((T : Subgroup G) ⊓ centralizer ({v} : Set G) : Set G)) I) :
    let S := (T : Subgroup G) ⊓ centralizer ({v} : Set G)
    let H := I ⊔ S
    let U := (conjugateSpanBy (⁅D.fullModule,L⁆ ⊓ centralizer (S : Set G)) I).subgroupOf H
    ∃ hr : IsPReduced 2 U, letI := hr.normal; letI := hr.elementary
      Nonempty (ChapterB.SourceInduction.ProjectiveLine.QuasisimpleSourceConclusion
        ((action U).comp (offenderSubgroup (action U)).subtype)
        (((I.subgroupOf H).map (actionMk U)).subgroupOf (offenderSubgroup (action U)))) := by
  let S := (T : Subgroup G) ⊓ centralizer ({v} : Set G)
  let H := I ⊔ S
  let V := conjugateSpanBy (⁅D.fullModule,L⁆ ⊓ centralizer (S : Set G)) I
  let U := V.subgroupOf H
  have hr : IsPReduced 2 U := source_a5_point_component_reduced_module D
    hv hvne hvL hCW I hLI hIX hI hNI hnot hs
  refine ⟨hr,?_⟩
  let := hr.normal
  let := hr.elementary
  have hHX : H ≤ centralizer ({v} : Set G) := sup_le hIX inf_le_right
  have hsH : Chapter1.IsSylowIn 2 S H := hs.restrict le_sup_right hHX
  have hmove := source_a5_point_thompson_not_centralizes D hn ht hcross I hLI hout hCW
    hsH hJP hspan hr
  obtain ⟨P,hP⟩ := hsH
  have hP' : (P : Subgroup H) = S.subgroupOf H := by
    apply map_injective H.subtype_injective
    rw [hP,map_subgroupOf_eq_of_le le_sup_right]
  have hjmap : (elementaryAbelianMaxJ (P : Subgroup H)).map H.subtype =
      elementaryAbelianMaxJ S := by
    rw [←elementaryAbelianMaxJ_map_injective H.subtype H.subtype_injective,hP]
  have hVH : V ≤ H := (conjugateSpanBy_le_self
    (inf_le_left.trans ((source_full_moved_le_component D).trans hLI))).trans le_sup_left
  have hmove' : ¬ elementaryAbelianMaxJ (P : Subgroup H) ≤ centralizer (U : Set H) := by
    intro hc
    apply hmove
    rw [←hjmap]
    rintro _ ⟨a,ha,rfl⟩ z hz
    exact congrArg H.subtype (hc ha ⟨z,hVH hz⟩ hz)
  have hu := Chapter1.Section02.nonsolvable_uniqueness_of_theoremsAC
    (fun _ _ _ => ChapterA.Section02.theoremA_knownSimple)
    (fun _ _ _ => ChapterA.Section02.theoremC_knownSimple)
    D.simpleQTKE T D.maximal
  have hv2 : orderOf v = 2 := by
    let := D.fullModule_elementary hu
    exact orderOf_eq_prime (elemPow_eq_one_of_isElementaryAbelian v hv) hvne
  have hH : IsSQTK KnownSimple.IsKnownSimple H :=
    (IsSQTK.equiv (subgroupOfEquivOfLe hHX)).mp
      ((D.simpleQTKE.involution_centralizer_sqtk hv2).subgroup _)
  let : (I.subgroupOf H).Normal := normal_subgroupOf_of_le_normalizer
    (sup_le I.le_normalizer (inf_le_right.trans hNI))
  have hK : (I.subgroupOf H).IsCComponent := hI.subgroupOf_of_le le_sup_left hHX
  have hKP : I.subgroupOf H ⊔ (P : Subgroup H) = ⊤ := by
    rw [hP',←subgroupOf_sup le_sup_left le_sup_right,subgroupOf_self]
  exact quasisimple_source_conclusion_of_thompson_movement hH P (I.subgroupOf H) U
    hK hKP hr.quotient_pCore_eq_bot hmove'
/-- The literal P-fixed seed has a vector whose image modulo the I-fixed
space is nonzero. Thus natural-model torus movement applies to an original
vector of W, rather than an unrelated vector of the model radical. -/
theorem source_a5_point_fixed_seed_not_component_fixed
    (P I : Subgroup G) (hLI : L ≤ I)
    (hspan : ⁅D.fullModule,L⁆ ≤ conjugateSpanBy
      (⁅D.fullModule,L⁆ ⊓ centralizer (P : Set G)) I) :
    ∃ z ∈ ⁅D.fullModule,L⁆ ⊓ centralizer (P : Set G),
      z ∉ centralizer (I : Set G) := by
  by_contra! h
  have hIC : I ≤ normalizer (centralizer (I : Set G) : Set G) :=
    (le_centralizer_iff.mp le_rfl).trans (Subgroup.centralizer_le_normalizer _)
  have hVC := conjugateSpanBy_le (show ⁅D.fullModule,L⁆ ⊓ centralizer (P : Set G) ≤
    centralizer (I : Set G) from h) hIC
  have hWL : ⁅D.fullModule,L⁆ ≤ centralizer (L : Set G) :=
    hspan.trans (hVC.trans (centralizer_le hLI))
  exact source_full_moved_ne_bot D ((source_full_moved_eq_commutator D).symm.trans
    (commutator_eq_bot_iff_le_centralizer.mpr hWL))

/-- The literal action kernel normalizes the original component: it fixes
W and lies in M, so the separate-factor marking excludes exchange of L. -/
theorem source_a5_point_action_centralizer_normalizes_component
    {t : G} (ht : t ∈ (T : Subgroup G)) (htn : t ∉ normalizer (L : Set G))
    (hcross : (⁅D.fullModule,L⁆).map (MulAut.conj t).toMonoidHom ≤ centralizer (L : Set G))
    (V : Subgroup G) (hWV : ⁅D.fullModule,L⁆ ≤ V)
    (hCW : centralizer (↑(⁅D.fullModule,L⁆ : Subgroup G) : Set G) ≤ D.maximalLocal) :
    centralizer (V : Set G) ≤ normalizer (L : Set G) := by
  exact (le_inf ((centralizer_le hWV).trans hCW)
    ((centralizer_le hWV).trans (Subgroup.centralizer_le_normalizer _))).trans
      (source_original_moved_stabilizer_le_component_normalizer D ht htn hcross)

/-- Fixed-span promotion keeps both the full commutator module and the
strict nonzero smaller component in the literal quotient action. -/
theorem source_a5_point_action_fully_moved
    {v : G} (I : Subgroup G) (hLI : L ≤ I)
    (hout : ¬ I ≤ D.maximalLocal)
    (hCW : centralizer (↑(⁅D.fullModule,L⁆ : Subgroup G) : Set G) ≤ D.maximalLocal)
    (hspan : ⁅D.fullModule,L⁆ ≤ conjugateSpanBy
      (⁅D.fullModule,L⁆ ⊓ centralizer
        ((T : Subgroup G) ⊓ centralizer ({v} : Set G) : Set G)) I)
    (hr : IsPReduced 2 ((conjugateSpanBy
      (⁅D.fullModule,L⁆ ⊓ centralizer
        ((T : Subgroup G) ⊓ centralizer ({v} : Set G) : Set G)) I).subgroupOf
          (I ⊔ ((T : Subgroup G) ⊓ centralizer ({v} : Set G))))) :
    let S := (T : Subgroup G) ⊓ centralizer ({v} : Set G)
    let H := I ⊔ S
    let V := conjugateSpanBy (⁅D.fullModule,L⁆ ⊓ centralizer (S : Set G)) I
    let U := V.subgroupOf H
    letI := hr.normal
    letI := hr.elementary
    ChapterB.QuasisimpleSource.moved (action U) ((I.subgroupOf H).map (actionMk U)) = ⊤ := by
  let S := (T : Subgroup G) ⊓ centralizer ({v} : Set G)
  let H := I ⊔ S
  let V := conjugateSpanBy (⁅D.fullModule,L⁆ ⊓ centralizer (S : Set G)) I
  let U := V.subgroupOf H
  let := hr.normal
  let := hr.elementary
  have hVI : V ≤ I := conjugateSpanBy_le_self
    (inf_le_left.trans ((source_full_moved_le_component D).trans hLI))
  have hVH : V ≤ H := hVI.trans le_sup_left
  have hcomm : ⁅U,I.subgroupOf H⁆ = U := by
    apply map_injective H.subtype_injective
    rw [map_commutator,map_subgroupOf_eq_of_le hVH,map_subgroupOf_eq_of_le le_sup_left]
    exact (source_a5_point_action_marking D I hLI hout hCW hspan hr).1
  change ChapterB.QuasisimpleSource.moved (action U) ((I.subgroupOf H).map (actionMk U)) = ⊤
  rw [←ChapterB.QuasisimpleSource.SourceCompletion.coinvariants_eq_moved]
  exact Representation.NormalElementaryQuotient.coinvariants_image_eq_top U (actionMk U)
    (QuotientGroup.mk'_surjective _) (QuotientGroup.ker_mk' _) (I.subgroupOf H)
    (comap_mono hVI) hcomm

end CFSG.Quasithin.Chapter10
