module
public import CFSG.Quasithin.Chapter10.SourceA5OriginalModuleMarking
public import Theory.Representation.ProjectiveCentralCover

/-!
# Removing projective central covers of the original moved factor

The original moved factor W=[V,L] is generated by its L-commutators. Its
central-quotient coordinate map is an equivariant surjection with fixed
kernel. If that quotient is projective over the binary A₅ group algebra,
the map splits and its complementary projection kills every commutator;
thus C_W(L)=1. This upgrades the deleted-permutation quotient to W itself.
Source: Aschbacher–Smith, I.1.5–6 and 10.1.1, printed pp.408 and 741.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
open scoped IsMulCommutative commutatorElement
namespace CFSG.Quasithin.Chapter10
open Chapter3.Section02
universe u
variable {G : Type u} [Group G] [Finite G] {T : Sylow 2 G} {L : Subgroup G}
  (D : FundamentalSetup KnownSimple.IsKnownSimple T L)
  (e : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 5))

local instance originalCoverMovedElementary : IsElementaryAbelian 2 (⁅D.fullModule,L⁆ : Subgroup G) :=
  source_original_full_moved_elementary D

/-- A projective original moved central quotient has trivial fixed kernel. -/
theorem source_original_moved_fixed_eq_bot_of_projective
    (ρ : Representation (ZMod 2) (alternatingGroup (Fin 5))
      (Additive ((⁅D.fullModule,L⁆ : Subgroup G) ⧸
        (sourceMovedFixed D).subgroupOf ⁅D.fullModule,L⁆)))
    (c : Representation.BinaryConjugationSection L ⁅D.fullModule,L⁆ (sourceMovedFixed D)
      (ρ.comp (e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 L)))))
    [Module.Projective (MonoidAlgebra (ZMod 2) (alternatingGroup (Fin 5))) ρ.asModule] :
    sourceMovedFixed D = ⊥ := by
  let W := ⁅D.fullModule,L⁆
  let Z := sourceMovedFixed D
  let q := e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 L))
  have hq : Function.Surjective q := e.surjective.comp (QuotientGroup.mk'_surjective _)
  obtain ⟨σ,_,hσ⟩ := source_a5_original_moved_action D e
  let p : Additive W →+ Additive (W ⧸ Z.subgroupOf W) := {
    toFun w := (c.coordinates w.toMul).toAdd
    map_zero' := c.coordinates.map_one
    map_add' _ _ := c.coordinates.map_mul _ _ }
  let f : σ.IntertwiningMap ρ := {
    toLinearMap := p.toZModLinearMap 2
    isIntertwining' := by
      intro a
      apply LinearMap.ext
      intro w
      obtain ⟨l,rfl⟩ := hq a
      have hs : (σ (q l) w).toMul =
          (⟨(l : G)*w.toMul*(l : G)⁻¹,
            (mem_normalizer_iff.mp (c.normalized l.property) w.toMul).mp w.toMul.property⟩ : W) :=
        Subtype.ext (hσ l w)
      change (c.coordinates (σ (q l) w).toMul).toAdd = ρ (q l) (c.coordinates w.toMul).toAdd
      rw [hs]
      exact c.equivariant l w.toMul }
  have hf : Function.Surjective f := by
    intro v
    obtain ⟨w,hw⟩ := c.onto (Multiplicative.ofAdd v)
    exact ⟨Additive.ofMul w,congrArg Multiplicative.toAdd hw⟩
  have hk : ∀ w, f w = 0 → ∀ a, σ a w = w := by
    intro w hw a
    have hz : (w.toMul : G) ∈ Z := (c.coordinates_eq_one_iff w.toMul).mp hw
    obtain ⟨l,rfl⟩ := hq a
    apply Additive.toMul.injective
    apply Subtype.ext
    change ((σ (e (QuotientGroup.mk' (pCore 2 L) l)) w).toMul : G) = _
    rw [hσ]
    have hh : (l : G) * (w.toMul : G) = (w.toMul : G) * (l : G) := hz.2 l l.property
    rw [hh,mul_inv_cancel_right]
  let d : Representation.BinaryConjugationSection L W ⊥ (σ.comp q) := {
    section_le := source_full_moved_le_component D
    kernel_le := bot_le
    normalized := normalizer_commutator_ge_right _ _
    coordinates := {
      toFun w := Multiplicative.ofAdd (Additive.ofMul w)
      map_one' := rfl
      map_mul' _ _ := rfl }
    onto := fun w => ⟨w.toAdd.toMul,rfl⟩
    kernel_eq := by
      ext w
      change w = 1 ↔ (w : G) = 1
      exact ⟨fun h => congrArg Subtype.val h,fun h => Subtype.ext h⟩
    equivariant := by
      intro l w
      apply Additive.toMul.injective
      apply Subtype.ext
      exact (hσ l (Additive.ofMul w)).symm }
  have hm : Representation.Coinvariants.ker σ = ⊤ :=
    d.coinvariants_eq_top_of_group_generation L le_rfl σ q (fun _ _ => rfl) (by
      rw [sup_bot_eq,commutator_comm,source_full_moved_eq_commutator D])
  have hi := f.injective_of_projective_of_fixed_kernel hf hk hm
  apply bot_unique
  intro z hz
  have he : f (Additive.ofMul (⟨z,hz.1⟩ : W)) = f 0 := by
    rw [map_zero]
    exact (c.coordinates_eq_one_iff _).mpr hz
  exact congrArg (fun w : Additive W => (w.toMul : G)) (hi he)

end CFSG.Quasithin.Chapter10
