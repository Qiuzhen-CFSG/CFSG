module

public import Theory.GroupTheory.GeneralizedFitting.ComponentCalculus
public import Mathlib.GroupTheory.Sylow

/-!
# Components of central involution centralizers

The local notation of Aschbacher–Smith, *The Classification of Quasithin
Groups*, combined manuscript of 1 March 2004, §16.2, pp.1173–1174.

Components are subnormal quasisimple subgroups of the indicated centralizer.
The setup records a chosen Sylow two-subgroup and a central involution in it.
It does not assume the normality asserted by Theorem 16.2.4, or the existence
asserted by Lemma 16.2.1. The global even-type hypothesis is separate from
this local notation.
-/

@[expose] public section

namespace CFSG.Quasithin.Chapter16

open Subgroup Theory.GroupTheory

variable {G : Type*} [Group G]

/-- The ambient centralizer `C_G(t)`. -/
abbrev involutionCentralizer (t : G) : Subgroup G := centralizer ({t} : Set G)

/-- A component of `C_G(t)`, retained as an actual subgroup of `G`.
Containment is necessary: `subgroupOf` alone would only describe an intersection. -/
def IsCentralizerComponent (t : G) (L : Subgroup G) : Prop :=
  L ≤ involutionCentralizer t ∧
    IsComponent (involutionCentralizer t) (L.subgroupOf (involutionCentralizer t))

/-- Notation 16.2.2, before any of its subsequent conclusions have been proved. -/
structure CentralComponentSetup (T : Sylow 2 G) (z : G) (L : Subgroup G) : Prop where
  involution : orderOf z = 2
  mem_sylow : z ∈ T
  sylow_centralizes : (T : Subgroup G) ≤ involutionCentralizer z
  component : IsCentralizerComponent z L

/-- The set `P` at the start of §16.2. Nonemptiness is Lemma 16.2.1. -/
def centralComponentPairs : Set (G × Subgroup G) :=
  {a | ∃ T : Sylow 2 G, CentralComponentSetup T a.1 a.2}

/-- `T_L = T ∩ L`, as a subgroup of the ambient group. -/
def componentSylow (T : Sylow 2 G) (L : Subgroup G) : Subgroup G :=
  (T : Subgroup G) ⊓ L

/-- `T_C = C_T(L)`, as a subgroup of the ambient group. -/
def commutingSylow (T : Sylow 2 G) (L : Subgroup G) : Subgroup G :=
  (T : Subgroup G) ⊓ centralizer (L : Set G)

/-- `L₀ = ⟨L^{C_G(z)}⟩`, the actual subgroup generated by the local conjugates. -/
def localComponentClosure (z : G) (L : Subgroup G) : Subgroup G :=
  componentOrbit L (involutionCentralizer z)

/-- The counterexample overgroup `H = N_G(L₀)` of §16.2. -/
def localComponentNormalizer (z : G) (L : Subgroup G) : Subgroup G :=
  normalizer (localComponentClosure z L : Set G)

/-- The assertion of 16.1.8 as an explicit prerequisite for local deductions.
This definition does not assert that the prerequisite holds. -/
def SmallCentralizerIndexTransfer (G : Type*) [Group G] : Prop :=
  ∀ (t i : G) (L : Subgroup G), orderOf t = 2 → orderOf i = 2 →
    IsCentralizerComponent t L →
    i ∈ centralizer ((zpowers t ⊔ L : Subgroup G) : Set G) →
    ∀ S : Sylow 2 (involutionCentralizer i),
      (involutionCentralizer t).relIndex
        ((S : Subgroup (involutionCentralizer i)).map (involutionCentralizer i).subtype) ≤ 2 →
      IsCentralizerComponent i L

end CFSG.Quasithin.Chapter16
