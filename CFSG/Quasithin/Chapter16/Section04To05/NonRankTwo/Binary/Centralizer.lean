module

public import CFSG.Quasithin.Chapter16.Section04To05.NonRankTwo.Binary.Setup

/-!
# The cyclic commuting-Sylow centralizer consequence

Tight embedding of K=C_G(L) gives C_G(z) ≤ N_G(K)=N_G(L), by applying
normalizer control to the nontrivial two-subgroup generated by z. If the
binary automorphism calculation gives H=LKT, factor an element of C_G(z)
as kb with k in K and b in LT. Since LT centralizes z, k belongs to C_K(z).
The earlier cyclic-Sylow conclusion C_K(z)=T_C therefore gives C_G(z)=LT.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004, printed
p.1183 and the first paragraph of Lemma 16.5.12, p.1200. The H=LKT
calculation is a separate premise here, still to be established by the
binary configuration construction.
-/

@[expose] public section

namespace CFSG.Quasithin.Chapter16.Intersections.NonRankTwo.Binary

open Subgroup
open scoped Pointwise

/-- Tight embedding controls the centralizer of the distinguished involution. -/
theorem centralizer_le_component_normalizer {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {z : G} {L : Subgroup G}
    (h : StandardSetup T z L) : involutionCentralizer z ≤ normalizer (L : Set G) := by
  have hzK : z ∈ centralizer (L : Set G) := by
    rw [mem_centralizer_iff]
    intro l hl
    exact mem_centralizer_singleton_iff.mp (h.component.1 hl)
  have hp : IsPGroup 2 (zpowers z) :=
    IsPGroup.of_card (n := 1) (by rw [Nat.card_zpowers, h.involution, pow_one])
  have hne : zpowers z ≠ ⊥ := by
    intro he
    have hz := zpowers_eq_bot.mp he
    have hi := h.involution
    simp [hz] at hi
  have hn := h.tight.normalizer_le hp hne (zpowers_le.mpr hzK)
  rw [h.normalizers_eq] at hn
  apply le_trans _ hn
  apply le_trans _ (centralizer_le_normalizer (zpowers z : Set G))
  rw [le_centralizer_iff, zpowers_le, mem_centralizer_iff]
  intro a ha
  exact mem_centralizer_singleton_iff.mp ha

/-- Factorization in H and the relative K-centralizer determine C_G(z). -/
theorem centralizer_eq_component_join_sylow {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {z : G} {L : Subgroup G}
    (h : StandardSetup T z L)
    (hH : normalizer (L : Set G) = (L ⊔ centralizer (L : Set G)) ⊔ (T : Subgroup G))
    (hC : centralizer (L : Set G) ⊓ involutionCentralizer z = commutingSylow T L) :
    involutionCentralizer z = L ⊔ (T : Subgroup G) := by
  let K := centralizer (L : Set G)
  let B := L ⊔ (T : Subgroup G)
  have hBcent : B ≤ involutionCentralizer z :=
    sup_le h.component.1 h.sylow_centralizes
  have hBK : B ≤ normalizer (K : Set G) := by
    rw [h.normalizers_eq]
    exact sup_le L.le_normalizer h.sylow_normalizes
  have hH' : normalizer (L : Set G) = K ⊔ B := by
    rw [hH]
    simpa only [sup_assoc] using sup_left_comm L K (T : Subgroup G)
  apply le_antisymm _ hBcent
  intro x hx
  have hxKB : x ∈ (K : Set G) * (B : Set G) := by
    rw [← coe_mul_of_right_le_normalizer_left K B hBK, ← hH']
    exact centralizer_le_component_normalizer h hx
  obtain ⟨k, hk, b, hb, rfl⟩ := hxKB
  have hkC : k ∈ involutionCentralizer z := by
    have hh := (involutionCentralizer z).mul_mem hx
      ((involutionCentralizer z).inv_mem (hBcent hb))
    simpa only [mul_inv_cancel_right] using hh
  have hkT : k ∈ (T : Subgroup G) := (show k ∈ commutingSylow T L from hC ▸ ⟨hk,hkC⟩).1
  exact B.mul_mem (mem_sup_right hkT) hb


/-- The exact cyclic-T_C consequence in the first paragraph of 16.5.12. -/
theorem centralizer_eq_of_cyclic_commutingSylow
    {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {z u g : G}
    {L R X : Subgroup G} (h : EarlierInputs T z L g R X u)
    (hH : normalizer (L : Set G) =
      (L ⊔ centralizer (L : Set G)) ⊔ (T : Subgroup G))
    (hcyclic : IsCyclic (commutingSylow T L)) :
    involutionCentralizer z = L ⊔ (T : Subgroup G) :=
  centralizer_eq_component_join_sylow h.toStandardSetup hH (h.cyclic_centralizer hcyclic)

end CFSG.Quasithin.Chapter16.Intersections.NonRankTwo.Binary
