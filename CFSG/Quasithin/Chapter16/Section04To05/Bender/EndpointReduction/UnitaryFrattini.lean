/-!
# Frattini and omega in the unitary Bender endpoint

For the actual PSU₃(4) Sylow two-group, every fourth power is one and every
involution is a square. In Hermitian root coordinates `(a,b)`, the square is
`(0,a * conj a)`. Thus involutions have `a = 0`; norm and trace surjectivity
construct their square roots. The Frattini subgroup of a finite two-group
is generated by its squares, proving that it equals the first omega subgroup.

The root embeds injectively in the projective group because it meets the
scalar kernel trivially. Its Sylow property comes from the proved special
unitary Borel construction. Sylow conjugacy and a genuine change-of-basis
isomorphism transport the calculation to arbitrary Hermitian forms over a
field of order sixteen with fixed-field order four. Finally, the centerless
quotient isomorphism and normal Sylow restriction identify the actual embedded
subgroup `componentSylow T L`; no subgroup identities are assumed.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), printed p.1194,
Proposition 16.5.1, the identity Φ(T_L) = Ω₁(T_L) in its unitary endpoint.
Root coordinates, norm and trace: Huppert II.10.4 and II.10.12, in the checked
`BenderSuzuki.External.Huppert.II` development.
-/

open BenderSuzuki.MatrixGroups BenderSuzuki.External Subgroup
open CFSG.Quasithin.ChapterF.Source.Unitary
open scoped Matrix

namespace CFSG.Quasithin.Chapter16.Intersections.Bender.UnitaryFrattini
variable {F : Type*} [Field F] [CharP F 2]
variable (J : HermitianForm 3 F)

private theorem coord_square (z : hermitianUnipotentCoord J) :
    ((z ^ 2 : hermitianUnipotentCoord J) : F × F) = (0, z.1.1 * J.conj z.1.1) := by
  rw [pow_two]
  change (z.1.1 + z.1.1, z.1.2 + z.1.2 - z.1.1 * J.conj z.1.1) = _
  simp only [CharTwo.add_self_eq_zero, zero_sub, CharTwo.neg_eq]

private theorem coord_square_eq_one_iff (z : hermitianUnipotentCoord J) :
    z ^ 2 = 1 ↔ z.1.1 = 0 := by
  rw [Subtype.ext_iff, coord_square]
  change (0, z.1.1 * J.conj z.1.1) = (0, 0) ↔ _
  simp [mul_eq_zero]

private theorem coord_fourth (z : hermitianUnipotentCoord J) : z ^ 4 = 1 := by
  rw [show (4 : ℕ) = 2 * 2 from rfl, pow_mul, coord_square_eq_one_iff]
  exact congrArg Prod.fst (coord_square J z)

variable [Finite F]

private theorem coord_involution_square
    (hcard : Nat.card F = 4 ^ 2)
    (hfixed : Nat.card {x : F // J.conj x = x} = 4)
    (z : hermitianUnipotentCoord J) (hz : z ^ 2 = 1) :
    ∃ w : hermitianUnipotentCoord J, w ^ 2 = z := by
  have ha := (coord_square_eq_one_iff J z).mp hz
  have hb : J.conj z.1.2 = z.1.2 := by
    have hp := z.property
    rw [ha, zero_mul, add_zero] at hp
    exact (eq_neg_of_add_eq_zero_right hp).trans (CharTwo.neg_eq _)
  by_cases hb0 : z.1.2 = 0
  · refine ⟨1, ?_⟩
    rw [one_pow]
    apply Subtype.ext
    change (0, 0) = z.val
    exact Prod.ext ha.symm hb0.symm
  obtain ⟨a, _, hanorm⟩ := huppert_II_10_4_norm_surjective J 4 hcard hfixed z.1.2 hb hb0
  obtain ⟨b, hbtrace⟩ := huppert_II_10_4_trace_surjective J 4 hcard hfixed z.1.2 hb
  let w : hermitianUnipotentCoord J := ⟨(a, b), by
    change b + J.conj b + a * J.conj a = 0
    rw [hbtrace, hanorm, CharTwo.add_self_eq_zero]⟩
  refine ⟨w, ?_⟩
  apply Subtype.ext
  rw [coord_square]
  exact Prod.ext ha.symm hanorm

private theorem frattini_eq_omega_of_powers {P : Type*} [Group P] [Finite P]
    (hfour : ∀ x : P, x ^ 4 = 1)
    (hsquare : ∀ x : P, x ^ 2 = 1 → ∃ y : P, y ^ 2 = x) :
    frattini P = omega₁ P (p := 2) := by
  have hp : IsPGroup 2 P := fun x => ⟨2, hfour x⟩
  rw [hp.frattini_eq_closure_squares]
  change closure (Set.range (fun x : P => x ^ 2)) = closure {x : P | x ^ (2 ^ 1) = 1}
  congr 1
  ext x
  constructor
  · rintro ⟨y, rfl⟩
    change (y ^ 2) ^ 2 = 1
    rw [← pow_mul]
    exact hfour y
  · intro hx
    exact hsquare x hx

end CFSG.Quasithin.Chapter16.Intersections.Bender.UnitaryFrattini

namespace CFSG.Quasithin.Chapter16.Intersections.Bender.UnitaryFrattini
variable {F : Type*} [Field F] [Finite F]

omit [Finite F] in
private theorem root_injective (J : HermitianForm 3 F)
    (hstandard : J.form = !![0, 0, 1; 0, 1, 0; 1, 0, 0]) :
    Function.Injective (hermitianUnipotentPSU J hstandard) := by
  apply (hermitianUnipotentPSU J hstandard).ker_eq_bot_iff.mp
  apply eq_bot_iff.mpr
  intro z hz
  have hs : hermitianUnipotentSU J hstandard z ∈ suRoot J hstandard := ⟨z, rfl⟩
  have hk : hermitianUnipotentSU J hstandard z ∈ (suProjection J).ker := by
    change suProjection J (hermitianUnipotentSU J hstandard z) = 1
    change hermitianUnipotentPSU J hstandard z = 1 at hz
    exact hz
  have h1 : hermitianUnipotentSU J hstandard z = 1 :=
    disjoint_def.mp (suRoot_disjoint_kernel J hstandard) hs hk
  exact (suRoot_injective J hstandard) (h1.trans (map_one _).symm)

private theorem exists_root_sylow_equiv (J : HermitianForm 3 F)
    (hcard : Nat.card F = 4 ^ 2) (hconj : ∀ x, J.conj x = x ^ 4)
    (hstandard : J.form = !![0, 0, 1; 0, 1, 0; 1, 0, 0]) :
    ∃ S : Sylow 2 (ProjectiveSpecialUnitaryMatrixGroup J),
      Nonempty (hermitianUnipotentCoord J ≃* S) := by
  obtain ⟨_, _, S, hS, _⟩ := standard_su_borel_data J 2 (by decide) hcard hconj hstandard
  let P := S.mapSurjective (f := suProjection J) (suProjection_surjective J)
  have hP : (P : Subgroup (ProjectiveSpecialUnitaryMatrixGroup J)) =
      (hermitianUnipotentPSU J hstandard).range := by
    change (S : Subgroup J.specialSubgroup).map (suProjection J) = _
    rw [hS, suRoot_map_projection]
  exact ⟨P, ⟨(MonoidHom.ofInjective (root_injective J hstandard)).trans
    (MulEquiv.subgroupCongr hP.symm)⟩⟩

private theorem powers_of_equiv {P Q : Type*} [Group P] [Group Q]
    (e : P ≃* Q) (hfour : ∀ x : P, x ^ 4 = 1)
    (hsquare : ∀ x : P, x ^ 2 = 1 → ∃ y : P, y ^ 2 = x) :
    (∀ x : Q, x ^ 4 = 1) ∧ (∀ x : Q, x ^ 2 = 1 → ∃ y : Q, y ^ 2 = x) := by
  constructor
  · intro x
    obtain ⟨a, rfl⟩ := e.surjective x
    simpa only [map_pow, map_one] using congrArg e (hfour a)
  · intro x hx
    obtain ⟨a, rfl⟩ := e.surjective x
    obtain ⟨b, hb⟩ := hsquare a (e.injective (by simpa only [map_pow, map_one] using hx))
    exact ⟨e b, by simpa only [map_pow] using congrArg e hb⟩

private theorem psu_sylow_powers (J : HermitianForm 3 F)
    (hcard : Nat.card F = 4 ^ 2) (hconj : ∀ x, J.conj x = x ^ 4)
    (S : Sylow 2 (ProjectiveSpecialUnitaryMatrixGroup J)) :
    (∀ x : S, x ^ 4 = 1) ∧ (∀ x : S, x ^ 2 = 1 → ∃ y : S, y ^ 2 = x) := by
  let : Fintype F := Fintype.ofFinite F
  let : Finite (Matrix.ProjGenLinGroup (Fin 3) F) :=
    Finite.of_surjective Matrix.ProjGenLinGroup.mk Matrix.ProjGenLinGroup.mk_surjective
  let J₀ := FormTransport.standardForm J
  obtain ⟨C, hC⟩ := FormTransport.exists_standard_basis J 2 (by decide) hcard hconj
  let e := FormTransport.projectiveEquiv J C hC
  let S₀ := S.mapSurjective (f := e.toMonoidHom) e.surjective
  obtain ⟨R, ⟨eR⟩⟩ := exists_root_sylow_equiv J₀ hcard hconj rfl
  let eS : S ≃* S₀ := (S : Subgroup _).equivMapOfInjective e.toMonoidHom e.injective
  let eall := eR.trans ((Sylow.equiv R S₀).trans eS.symm)
  let : CharP F 2 := charP_two 2 (by decide) hcard
  exact powers_of_equiv eall (coord_fourth J₀)
    (coord_involution_square J₀ hcard (fixed_card J₀ 2 (by decide) hcard hconj))

end CFSG.Quasithin.Chapter16.Intersections.Bender.UnitaryFrattini

namespace CFSG.Quasithin.Chapter16.Intersections.Bender.UnitaryFrattini
private theorem isPSU_sylow_powers {G : Type*} [Group G] [Finite G]
    (hu : ClassicalGroup.IsPSU G 3 4) (S : Sylow 2 G) :
    (∀ x : S, x ^ 4 = 1) ∧ (∀ x : S, x ^ 2 = 1 → ∃ y : S, y ^ 2 = x) := by
  obtain ⟨F, hF, hfin, J, hcard, hconj, ⟨e⟩⟩ := hu
  let : Fintype F := Fintype.ofFinite F
  let S₀ := S.mapSurjective (f := e.toMonoidHom) e.surjective
  let eS : S ≃* S₀ := (S : Subgroup G).equivMapOfInjective e.toMonoidHom e.injective
  obtain ⟨hfour, hsquare⟩ := psu_sylow_powers J hcard hconj S₀
  exact powers_of_equiv eS.symm hfour hsquare
end CFSG.Quasithin.Chapter16.Intersections.Bender.UnitaryFrattini

namespace CFSG.Quasithin.Chapter16.Intersections.Bender
open UnitaryFrattini
variable {G : Type*} [Group G] [Finite G]

/-- In a centerless component with the actual PSU₃(4) model, the Frattini
subgroup of `T ∩ L`, embedded in the original ambient group, is its first omega. -/
public theorem componentSylow_frattini_eq_omega_of_psuFour
    {T : Sylow 2 G} {L : Subgroup G}
    (hnorm : (T : Subgroup G) ≤ normalizer (L : Set G))
    (hc : center L = ⊥)
    (hu : ClassicalGroup.IsPSU (L ⧸ center L) 3 4) :
    (frattini (componentSylow T L)).map (componentSylow T L).subtype =
      omegaOneAmbient (componentSylow T L) := by
  let eQ : L ≃* (L ⧸ center L) :=
    (QuotientGroup.quotientBot (G := L)).symm.trans
      (QuotientGroup.quotientMulEquivOfEq hc).symm
  obtain ⟨P, hP⟩ := componentSylow_isSylow hnorm
  let eP : P ≃* componentSylow T L :=
    ((P : Subgroup L).equivMapOfInjective L.subtype L.subtype_injective).trans
      (MulEquiv.subgroupCongr hP)
  obtain ⟨hfour, hsquare⟩ := isPSU_sylow_powers (hu.of_mulEquiv eQ) P
  obtain ⟨hfour', hsquare'⟩ := powers_of_equiv eP hfour hsquare
  rw [frattini_eq_omega_of_powers hfour' hsquare']
  rfl

end CFSG.Quasithin.Chapter16.Intersections.Bender
