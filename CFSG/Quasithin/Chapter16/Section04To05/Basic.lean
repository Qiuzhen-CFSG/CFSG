module

public import CFSG.Quasithin.Chapter16.Defs
public import Theory.GroupTheory.SubgroupConjugation
public import Theory.GroupTheory.TightlyEmbedded
public import Theory.GroupTheory.PGroup.OmegaAmbient

/-!
# The conjugate-centralizer setup for §§16.4–16.5

The sets Δ and Δ₀ are sets of actual conjugates of C_G(L). Their Sylow
conditions concern the relative normalizer inside that conjugate, rather
than a Sylow subgroup of G. `StandardSetup` retains the genuine earlier
outputs 16.2.4 and 16.3.7 as explicit inputs; none is proved by this record.

Sylow maximality gives R = K' ∩ T. Tight embedding gives normalizer control
for every nontrivial two-subgroup of R. In particular, if R meets Z(T)
nontrivially, the whole T normalizes K'; this is the argument in 16.5.2(1).

Source: Aschbacher–Smith, combined manuscript (1 March 2004), pp.1183,
1188–1189 and 1195. We consistently use left conjugation `conjBy g`,
so the source's exponent g corresponds to our g⁻¹.
-/

@[expose] public section

namespace CFSG.Quasithin.Chapter16.Intersections

open Subgroup Theory.GroupTheory

variable {G : Type*} [Group G]

/-- A Sylow subgroup of H, retained as a subgroup of G. -/
def SylowIn (R H : Subgroup G) : Prop :=
  ∃ S : Sylow 2 H, (S : Subgroup H).map H.subtype = R

/-- The set Δ(K), with K = C_G(L), on printed p.1183. -/
def delta (L : Subgroup G) : Set (Subgroup G) :=
  {J | (∃ g : G, J = (centralizer (L : Set G)).conjBy g) ∧
    J ≠ centralizer (L : Set G) ∧
    Even (Nat.card ↥(J ⊓ normalizer (centralizer (L : Set G) : Set G)))}

/-- The set Δ₀(K). The first omega subgroup is generated by involutions;
it is not assumed to be elementary abelian. -/
def deltaZero (L : Subgroup G) : Set (Subgroup G) :=
  {J | J ∈ delta L ∧ ∃ R : Subgroup G,
    SylowIn R (J ⊓ normalizer (centralizer (L : Set G) : Set G)) ∧
    omegaOneAmbient R ≤ centralizer (L : Set G) ⊔ L}

/-- The earlier mathematical inputs used at the start of §16.4. -/
structure StandardSetup [Finite G] (T : Sylow 2 G) (z : G) (L : Subgroup G) : Prop
    extends CentralComponentSetup T z L where
  sylow_normalizes : (T : Subgroup G) ≤ normalizer (L : Set G)
  tight : IsTightlyEmbedded (centralizer (L : Set G))
  normalizers_eq : normalizer (centralizer (L : Set G) : Set G) =
    normalizer (L : Set G)

/-- Notation 16.4.1 with a chosen conjugator, avoiding a choice-dependent L(K'). -/
structure IntersectionSetup [Finite G] (T : Sylow 2 G) (z : G)
    (L : Subgroup G) (g : G) (R : Subgroup G) : Prop
    extends StandardSetup T z L where
  mem_delta : (centralizer (L : Set G)).conjBy g ∈ delta L
  sylow : SylowIn R ((centralizer (L : Set G)).conjBy g ⊓
    normalizer (centralizer (L : Set G) : Set G))
  le_sylow : R ≤ (T : Subgroup G)

theorem SylowIn.le {R H : Subgroup G} (h : SylowIn R H) : R ≤ H := by
  obtain ⟨S, rfl⟩ := h
  exact map_subtype_le _

theorem SylowIn.isPGroup {R H : Subgroup G} (h : SylowIn R H) : IsPGroup 2 R := by
  obtain ⟨S, rfl⟩ := h
  exact S.isPGroup'.map _

/-- Maximality is transported along the subgroup inclusion, with its overgroup
kept explicit. -/
theorem SylowIn.maximal {R H Q : Subgroup G} (h : SylowIn R H)
    (hQ : IsPGroup 2 Q) (hQH : Q ≤ H) (hRQ : R ≤ Q) : Q = R := by
  obtain ⟨S, rfl⟩ := h
  have he := S.is_maximal' (hQ.of_equiv (subgroupOfEquivOfLe hQH).symm)
    (map_le_iff_le_comap.mp hRQ)
  rw [← map_subgroupOf_eq_of_le hQH, he]

/-- An isomorphism transports the odd-intersection definition of tight embedding. -/
theorem tight_map [Finite G] {K : Subgroup G} (hK : IsTightlyEmbedded K)
    (e : G ≃* G) : IsTightlyEmbedded (K.map e.toMonoidHom) := by
  refine ⟨?_, ?_⟩
  · simpa only [Subgroup.card_map_of_injective (f := e.toMonoidHom) e.injective]
      using hK.1
  · intro x hx
    have hn : e.symm x ∉ normalizer (K : Set G) := by
      intro hh
      apply hx
      rw [← map_equiv_normalizer_eq]
      exact ⟨e.symm x, hh, e.apply_symm_apply x⟩
    have he : (K.map (MulAut.conj (e.symm x)).toMonoidHom).map e.toMonoidHom =
        (K.map e.toMonoidHom).map (MulAut.conj x).toMonoidHom := by
      rw [map_map, map_map]
      congr 1
      ext y
      simp [MulAut.conj_apply]
    have hc : (K ⊓ K.map (MulAut.conj (e.symm x)).toMonoidHom).map e.toMonoidHom =
        K.map e.toMonoidHom ⊓ (K.map e.toMonoidHom).map
          (MulAut.conj x).toMonoidHom := by
      rw [map_inf _ _ _ e.injective, he]
    rw [← hc, Subgroup.card_map_of_injective e.injective]
    exact hK.2 (e.symm x) hn

variable [Finite G] {T : Sylow 2 G} {z g : G} {L R : Subgroup G}

/-- The component attached to a conjugate centralizer is independent of its
chosen conjugator, as asserted at the start of §16.4. -/
theorem StandardSetup.component_conjugate_eq (h : StandardSetup T z L)
    {a b : G} (hab : (centralizer (L : Set G)).conjBy a =
      (centralizer (L : Set G)).conjBy b) : L.conjBy a = L.conjBy b := by
  have hn : a⁻¹ * b ∈ normalizer (centralizer (L : Set G) : Set G) :=
    mem_normalizer_iff_map_conj_eq.mpr
      ((centralizer (L : Set G)).conjBy_inv_mul_cancel hab)
  rw [h.normalizers_eq] at hn
  have he : L.conjBy (a⁻¹ * b) = L := mem_normalizer_iff_map_conj_eq.mp hn
  have hh := congrArg (fun Q : Subgroup G => Q.conjBy a) he
  simpa only [conjBy_conjBy, mul_inv_cancel_left] using hh.symm

/-- Source 16.4.2(3). Normalizing K is inherited from T; Sylow maximality
then fills the whole intersection with the conjugate K'. -/
theorem IntersectionSetup.eq_intersection (h : IntersectionSetup T z L g R) :
    R = (centralizer (L : Set G)).conjBy g ⊓ (T : Subgroup G) := by
  apply Eq.symm
  apply h.sylow.maximal
  · exact T.isPGroup'.of_injective
      (inclusion inf_le_right) (inclusion_injective _)
  · apply le_inf inf_le_left
    exact inf_le_right.trans (h.normalizers_eq ▸ h.sylow_normalizes)
  · exact le_inf (h.sylow.le.trans inf_le_left) h.le_sylow

/-- Source 16.4.2(5), from tight embedding of the conjugate centralizer. -/
theorem IntersectionSetup.normalizer_le (h : IntersectionSetup T z L g R)
    {Q : Subgroup G} (hQ : Q ≠ ⊥) (hQR : Q ≤ R) :
    normalizer (Q : Set G) ≤
      normalizer ((centralizer (L : Set G)).conjBy g : Set G) :=
  (tight_map h.tight (MulAut.conj g)).normalizer_le
    (h.sylow.isPGroup.of_injective (inclusion hQR) (inclusion_injective _))
    hQ (hQR.trans (h.sylow.le.trans inf_le_left))

/-- The substantive normalizer step in 16.5.2(1). -/
theorem IntersectionSetup.sylow_normalizes_conjugate_of_central_intersection
    (h : IntersectionSetup T z L g R)
    (hne : R ⊓ centralizer (T : Set G) ≠ ⊥) :
    (T : Subgroup G) ≤ normalizer ((centralizer (L : Set G)).conjBy g : Set G) := by
  apply le_trans _ (h.normalizer_le hne inf_le_left)
  apply le_trans _ (centralizer_le_normalizer _)
  intro t ht
  rw [mem_centralizer_iff]
  intro x hx
  exact (mem_centralizer_iff.mp hx.2 t ht).symm

/-- Source 16.5.2(1): the chosen conjugator must normalize T.
The transport containment is the actual output of 16.4.2(4). -/
theorem IntersectionSetup.conjugator_normalizes_sylow
    (h : IntersectionSetup T z L g R)
    (hne : R ⊓ centralizer (T : Set G) ≠ ⊥)
    (htransport : (T : Subgroup G) ⊓
        normalizer ((centralizer (L : Set G)).conjBy g : Set G) ≤
      (T : Subgroup G).conjBy g) :
    g ∈ normalizer (T : Set G) := by
  have hle : (T : Subgroup G) ≤ (T : Subgroup G).conjBy g := by
    simpa only [inf_eq_left.mpr
      (h.sylow_normalizes_conjugate_of_central_intersection hne)] using htransport
  exact mem_normalizer_iff_map_conj_eq.mpr
    (T.is_maximal' (T.isPGroup'.map _) hle)

/-- Source 16.4.11(3), conditional on the substantive Sylow theorem 16.4.10.
It identifies the actual subgroup R with the transported commuting Sylow. -/
theorem IntersectionSetup.eq_conjugate_commutingSylow
    (h : IntersectionSetup T z L g R)
    (hR : SylowIn R ((centralizer (L : Set G)).conjBy g))
    (htransport : (T : Subgroup G) ⊓
        normalizer ((centralizer (L : Set G)).conjBy g : Set G) ≤
      (T : Subgroup G).conjBy g) :
    R = (commutingSylow T L).conjBy g := by
  have hRconj : R ≤ (T : Subgroup G).conjBy g :=
    (le_inf h.le_sylow (hR.le.trans
      ((centralizer (L : Set G)).conjBy g).le_normalizer)).trans htransport
  have he : (commutingSylow T L).conjBy g =
      (T : Subgroup G).conjBy g ⊓ (centralizer (L : Set G)).conjBy g :=
    map_inf _ _ _ (MulAut.conj g).injective
  rw [he]
  apply Eq.symm
  exact hR.maximal
    ((T.isPGroup'.map (MulAut.conj g).toMonoidHom).of_injective
      (inclusion inf_le_left) (inclusion_injective _))
    inf_le_right (le_inf hRconj hR.le)

end CFSG.Quasithin.Chapter16.Intersections
