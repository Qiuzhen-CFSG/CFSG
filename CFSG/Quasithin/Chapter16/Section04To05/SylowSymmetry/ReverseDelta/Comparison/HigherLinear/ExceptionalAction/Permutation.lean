module

public import Theory.SpecificGroups.SymmetricEight.InvolutionActions

/-!
# The two centralizer actions in the exceptional A₈ comparison

Explicit even permutations prove that the full S₈ centralizer of
C_A₈((01)(23)) consists of the identity and (01)(23). The center of
C_A₈((01)(23)(45)) instead has unique involution (01)(23)(45)(67).
The latter is characteristic in the actual fixed subgroup. These facts
provide the normalizer-action comparison used in 16.4.11(2).

The six-point orbit words follow the checked calculation in
InnerFamily/OrderTwo/CentralizerCases/BinaryLinear/EightModel.lean; here
they are applied directly to the full fixed subgroup. All finite checks
are on the displayed permutations and their eight points.

Source: Aschbacher–Smith, combined manuscript (1 March 2004),
16.1.4(3),(9), printed p.1171, and 16.4.11(2), printed p.1193.
-/

@[expose] public section

open Subgroup Equiv
open Theory.SpecificGroups.SymmetricEight.Involutions
namespace CFSG.Quasithin.Chapter16.Intersections.SylowSymmetry.ReverseDelta.Comparison.HigherLinear.ExceptionalAction.Permutation

def evenCentralizer (q : S) : Subgroup S := A ⊓ centralizer ({q} : Set S)

private def innerGenerators : Fin 6 → S :=
  ![twoPairs, swap 0 2 * swap 1 3, swap 0 1 * swap 4 5,
    swap 4 5 * swap 5 6, swap 4 5 * swap 5 7, swap 5 6 * swap 6 7]

private theorem innerGenerators_mem : ∀ i, innerGenerators i ∈ evenCentralizer twoPairs := by
  simp only [evenCentralizer, mem_inf, Perm.mem_alternatingGroup,
    mem_centralizer_singleton_iff]
  decide +kernel

/-- The full permutation centralizer of C_A8((01)(23)) is generated by (01)(23). -/
theorem inner_centralizer {q : S}
    (hq : q ∈ centralizer (evenCentralizer twoPairs : Set S)) : q = 1 ∨ q = twoPairs := by
  have hc (j : Fin 6) (i : Fin 8) : innerGenerators j (q i) = q (innerGenerators j i) :=
    congrArg (fun p : S => p i) (hq _ (innerGenerators_mem j))
  have hf (i : Fin 8) (j : Fin 6) :
      innerGenerators j i = i ↔ innerGenerators j (q i) = q i := by
    rw [hc j i, q.injective.eq_iff]
  have h0 : q 0 = 0 ∨ q 0 = 1 :=
    (by decide +kernel : ∀ y : Fin 8,
      (∀ j, innerGenerators j 0 = 0 ↔ innerGenerators j y = y) → y = 0 ∨ y = 1) _ (hf 0)
  have htail (i : Fin 8) (hi : 4 ≤ i.val) : q i = i :=
    (by decide +kernel : ∀ i y : Fin 8, 4 ≤ i.val →
      (∀ j, innerGenerators j i = i ↔ innerGenerators j y = y) → y = i) i _ hi (hf i)
  have h1 := (hc 0 0).symm
  have h2 := (hc 1 0).symm
  have h3 := (hc 1 1).symm
  change q 1 = twoPairs (q 0) at h1
  change q 2 = (swap 0 2 * swap 1 3 : S) (q 0) at h2
  change q 3 = (swap 0 2 * swap 1 3 : S) (q 1) at h3
  rcases h0 with h0 | h0
  · have h1' : q 1 = 1 := h1.trans (by rw [h0]; decide)
    have h2' : q 2 = 2 := h2.trans (by rw [h0]; decide)
    have h3' : q 3 = 3 := h3.trans (by rw [h1']; decide)
    left
    apply Equiv.ext
    intro i
    fin_cases i
    · exact h0
    · exact h1'
    · exact h2'
    · exact h3'
    all_goals exact htail _ (by decide)
  · have h1' : q 1 = 0 := h1.trans (by rw [h0]; decide)
    have h2' : q 2 = 3 := h2.trans (by rw [h0]; decide)
    have h3' : q 3 = 2 := h3.trans (by rw [h1']; decide)
    right
    apply Equiv.ext
    intro i
    fin_cases i
    · exact h0.trans (by decide)
    · exact h1'.trans (by decide)
    · exact h2'.trans (by decide)
    · exact h3'.trans (by decide)
    all_goals exact (htail _ (by decide)).trans (by decide)

private def first : S := swap 0 2 * swap 2 4 * (swap 1 3 * swap 3 5)
private def second : S := swap 0 2 * swap 2 5 * (swap 1 3 * swap 3 4)
private def stabilizerWord : S := second * first * second * first * second * second
private def orbitWord (i : Fin 6) : S :=
  ![1, first * second * second, first, first * first * second * second,
    first * second, second * second] i
private def fourWord (i : Fin 4) : S := ![1, threePairs, swap 6 7, threePairs * swap 6 7] i

private theorem first_mem : first ∈ evenCentralizer threePairs := by
  simp only [evenCentralizer, mem_inf, Perm.mem_alternatingGroup,
    mem_centralizer_singleton_iff]
  decide +kernel
private theorem second_mem : second ∈ evenCentralizer threePairs := by
  simp only [evenCentralizer, mem_inf, Perm.mem_alternatingGroup,
    mem_centralizer_singleton_iff]
  decide +kernel
private theorem stabilizerWord_mem : stabilizerWord ∈ evenCentralizer threePairs := by
  exact mul_mem (mul_mem (mul_mem (mul_mem (mul_mem second_mem first_mem) second_mem)
    first_mem) second_mem) second_mem
private theorem orbitWord_mem (i : Fin 6) : orbitWord i ∈ evenCentralizer threePairs := by
  fin_cases i
  · exact one_mem _
  · exact mul_mem (mul_mem first_mem second_mem) second_mem
  · exact first_mem
  · exact mul_mem (mul_mem (mul_mem first_mem first_mem) second_mem) second_mem
  · exact mul_mem first_mem second_mem
  · exact mul_mem second_mem second_mem
private theorem orbitWord_zero : ∀ i : Fin 6, orbitWord i 0 = i.castLE (by decide) := by decide +kernel

/-- The central involution in the exceptional fixed group. -/
def outerCentral : S := threePairs * swap 6 7

private theorem tail_commutes {x : S} (hx : threePairs * x = x * threePairs) :
    swap 6 7 * x = x * swap 6 7 := by
  have hf (i : Fin 8) (hi : i = 6 ∨ i = 7) : x i = 6 ∨ x i = 7 := by
    have hh := congrArg (fun g : S => g i) hx
    change threePairs (x i) = x (threePairs i) at hh
    have hfix : threePairs i = i := by rcases hi with rfl | rfl <;> decide
    rw [hfix] at hh
    exact (by decide : ∀ j : Fin 8, threePairs j = j → j = 6 ∨ j = 7) _ hh
  have h6 := hf 6 (Or.inl rfl)
  have h7 := hf 7 (Or.inr rfl)
  have hne : x 6 ≠ x 7 := x.injective.ne (by decide)
  have hconj : swap (x 6) (x 7) = swap (6 : Fin 8) 7 := by
    rcases h6 with h6 | h6 <;> rcases h7 with h7 | h7 <;> simp_all [swap_comm]
  have hm := Equiv.symm_trans_swap_trans (6 : Fin 8) 7 x
  change x * (swap 6 7 * x⁻¹) = _ at hm
  rw [← mul_assoc] at hm
  exact (mul_inv_eq_iff_eq_mul.mp (hm.trans hconj)).symm

private theorem fourWord_commutes (i : Fin 4) {x : S} (hx : x ∈ evenCentralizer threePairs) :
    x * fourWord i = fourWord i * x := by
  have h := mem_centralizer_singleton_iff.mp hx.2
  have ht := tail_commutes h.symm
  fin_cases i
  · exact mul_one x |>.trans (one_mul x).symm
  · exact h
  · exact ht.symm
  · change x * (threePairs * swap 6 7) = (threePairs * swap 6 7) * x
    rw [← mul_assoc, h, mul_assoc, ht.symm, ← mul_assoc]

private theorem outer_centralizer {q : S}
    (hq : q ∈ centralizer (evenCentralizer threePairs : Set S)) :
    ∃ k : Fin 4, fourWord k = q := by
  have hc (w : S) (hw : w ∈ evenCentralizer threePairs) (i : Fin 8) :
      w (q i) = q (w i) := congrArg (fun v : S => v i) (hq w hw)
  have h0 : q 0 = 0 ∨ q 0 = 1 := by
    have hs := hc stabilizerWord stabilizerWord_mem 0
    rw [show stabilizerWord 0 = 0 from by decide +kernel] at hs
    have hn : first (q 0) ≠ q 0 := by
      rw [hc first first_mem 0]
      exact q.injective.ne (by decide +kernel)
    exact (by decide +kernel : ∀ i : Fin 8,
      stabilizerWord i = i → first i ≠ i → i = 0 ∨ i = 1) _ hs hn
  have hfix (i : Fin 8) (hi : i = 6 ∨ i = 7) : q i = 6 ∨ q i = 7 := by
    have ha := hc first first_mem i
    have hb := hc second second_mem i
    have hia : first i = i := by rcases hi with rfl | rfl <;> decide +kernel
    have hib : second i = i := by rcases hi with rfl | rfl <;> decide +kernel
    rw [hia] at ha; rw [hib] at hb
    exact (by decide +kernel : ∀ j : Fin 8,
      first j = j → second j = j → j = 6 ∨ j = 7) _ ha hb
  obtain ⟨k, hk0, hk6⟩ := (by decide +kernel : ∀ i j : Fin 8,
    (i = 0 ∨ i = 1) → (j = 6 ∨ j = 7) →
      ∃ k : Fin 4, fourWord k 0 = i ∧ fourWord k 6 = j) _ _ h0 (hfix 6 (Or.inl rfl))
  refine ⟨k, Equiv.ext (fun i => ?_)⟩
  by_cases hi : i.val < 6
  · let j : Fin 6 := ⟨i.val, hi⟩
    have hj : orbitWord j 0 = i := orbitWord_zero j
    have hw := congrArg (fun v : S => v 0) (fourWord_commutes k (orbitWord_mem j))
    change orbitWord j (fourWord k 0) = fourWord k (orbitWord j 0) at hw
    rw [← hj, ← hw, hk0]
    exact hc _ (orbitWord_mem j) 0
  · have hi' : i = 6 ∨ i = 7 := by omega
    rcases hi' with rfl | rfl
    · exact hk6
    · have hne : q 6 ≠ q 7 := q.injective.ne (by decide)
      exact (by decide +kernel : ∀ k : Fin 4, ∀ i j : Fin 8,
        fourWord k 6 = i → i ≠ j → (j = 6 ∨ j = 7) → fourWord k 7 = j)
        k _ _ hk6 hne (hfix 7 (Or.inr rfl))

theorem outerCentral_mem : outerCentral ∈ evenCentralizer threePairs := by
  simp only [evenCentralizer, mem_inf, Perm.mem_alternatingGroup,
    mem_centralizer_singleton_iff]
  decide +kernel

theorem outerCentral_ne_one : outerCentral ≠ 1 := by decide +kernel

theorem outerCentral_square : outerCentral ^ 2 = 1 := by decide +kernel

theorem outerCentral_centralizes :
    outerCentral ∈ centralizer (evenCentralizer threePairs : Set S) := by
  intro x hx
  exact fourWord_commutes 3 hx

/-- The center of the actual exceptional fixed group has just two elements. -/
theorem outer_center {q : S} (he : q ∈ A)
    (hq : q ∈ centralizer (evenCentralizer threePairs : Set S)) :
    q = 1 ∨ q = outerCentral := by
  obtain ⟨k, rfl⟩ := outer_centralizer hq
  rw [Perm.mem_alternatingGroup] at he
  fin_cases k
  · exact Or.inl rfl
  · exact (by decide +kernel : Perm.sign (fourWord 1) ≠ 1) he |>.elim
  · exact (by decide +kernel : Perm.sign (fourWord 2) ≠ 1) he |>.elim
  · exact Or.inr rfl

end CFSG.Quasithin.Chapter16.Intersections.SylowSymmetry.ReverseDelta.Comparison.HigherLinear.ExceptionalAction.Permutation
