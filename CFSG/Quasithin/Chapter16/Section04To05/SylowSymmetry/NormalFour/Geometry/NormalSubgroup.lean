module

public import CFSG.Quasithin.Chapter16.Section04To05.SylowSymmetry.NormalFour.Contracts
public import Theory.GroupTheory.PGroup.NormalIndexTwoStep
public import Theory.GroupTheory.CardFourAutomorphismStabilizer

/-!
# The normal subgroup of order four and its centralizer

Between the central kernel `Z(L)` and the normal subgroup `S` of the finite
two-group `C`, choose a normal step of index two. Saturation of the actual
projection identifies this subgroup with the full inverse image of a cyclic
subgroup generated by an involution of `A`. The coordinate identity retains
the kernel: `E = ⟨s(v)⟩ Z(L)` and `v = s(v)l(v)`.

Conjugation on `E` fixes the nonidentity kernel element, so its image has order
at most two. Uniform centralizers and abelianness of `S` identify the action
kernel with `S`, which is proper and therefore has index exactly two.
The subgroup `E` is allowed to be cyclic of order four.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), proof of
Lemma 16.4.10, printed p.1193. The TI product and omega equalities are separate.
-/

@[expose] public section
namespace CFSG.Quasithin.Chapter16.Intersections.SylowSymmetry.NormalFour
open Subgroup
variable {G : Type*} [Group G] [Finite G] {C L A S : Subgroup G}

omit [Finite G] in
/-- A lifted cyclic subgroup is generated by its chosen coordinate and the
entire central kernel. -/
theorem inverseImage_zpowers_of_coordinate
    (d : SaturatedProjection C L A S) :
    let := d.configuration.overlap_normal
    ∀ (v : A) (s : S), d.projection.hom v = QuotientGroup.mk s →
    d.projection.inverseImage (zpowers v) = zpowers s ⊔ L.subgroupOf S := by
  let := d.configuration.overlap_normal
  dsimp only
  intro v s he
  change ((zpowers v).map d.projection.hom).comap (QuotientGroup.mk' _) = _
  rw [MonoidHom.map_zpowers, he]
  change (zpowers ((QuotientGroup.mk' (L.subgroupOf S)) s)).comap
    (QuotientGroup.mk' (L.subgroupOf S)) = _
  rw [← MonoidHom.map_zpowers, comap_map_eq, QuotientGroup.ker_mk']

/-- A nonidentity involution of the actual inner subgroup has a full inverse
image normal in `C` of order four, with explicit multiplication coordinates. -/
theorem exists_normal_four
    (d : SaturatedProjection C L A S) :
    let := d.configuration.overlap_normal
    ∃ v : A, v ≠ 1 ∧ v ^ 2 = 1 ∧
      let E := d.projection.inverseImage (zpowers v)
      ((E.map S.subtype).subgroupOf C).Normal ∧ Nat.card E = 4 ∧
      ∃ s : S, ∃ l : L, (s : G) * l = v ∧ E = zpowers s ⊔ L.subgroupOf S := by
  let := d.configuration.overlap_normal
  let W := L.subgroupOf C
  let H := S.subgroupOf C
  have hWC : W ≤ center C := by
    intro w hw
    apply mem_center_iff.mpr
    intro c
    apply Subtype.ext
    exact (mem_centralizer_iff.mp (d.configuration.centralizes c.property) w hw).symm
  let : W.Normal := ⟨fun w hw c => by
    have hc := mem_center_iff.mp (hWC hw) c
    simpa only [hc, mul_assoc, mul_inv_cancel, mul_one] using hw⟩
  let : H.Normal := d.normal_inside
  have hWH : W ≤ H := by
    intro w hw
    exact (d.configuration.overlap.symm ▸
      (show (w : G) ∈ L ⊓ centralizer (L : Set G) from
        ⟨hw, d.configuration.centralizes w.property⟩)).1
  have hWmap : W.map C.subtype = (L.subgroupOf S).map S.subtype := by
    rw [subgroupOf_map_subtype, subgroupOf_map_subtype]
    apply le_antisymm
    · intro x hx
      exact ⟨hx.1, hWH (show (⟨x, hx.2⟩ : C) ∈ W from hx.1)⟩
    · exact inf_le_inf_left _ d.configuration.proper.le
  have hWcard : Nat.card W = 2 := by
    rw [← card_map_of_injective C.subtype_injective, hWmap,
      card_map_of_injective S.subtype_injective, d.kernel_card]
  have hHcard : Nat.card H = 2 * Nat.card A :=
    (Nat.card_congr (subgroupOfEquivOfLe d.configuration.proper.le).toEquiv).trans d.card_eq
  have hWHlt : W < H := by
    refine lt_of_le_of_ne hWH ?_
    intro he
    have hp := A.one_lt_card_iff_ne_bot.mpr d.configuration.nontrivial
    have hh : Nat.card W = Nat.card H := congrArg (fun B : Subgroup C => Nat.card B) he
    rw [hWcard, hHcard] at hh
    omega
  obtain ⟨X, hXn, hWX, hXH, hXi⟩ := exists_normal_index_two_step C d.two_group W H hWHlt
  have hXcard : Nat.card X = 4 := by
    have hh := (W.subgroupOf X).card_mul_index
    rw [Nat.card_congr (subgroupOfEquivOfLe hWX).toEquiv, hWcard] at hh
    change 2 * W.relIndex X = Nat.card X at hh
    omega
  have hWXlt : W < X := by
    refine lt_of_le_of_ne hWX ?_
    intro he
    rw [he, relIndex_self] at hXi
    omega
  obtain ⟨c, hcX, hcW⟩ := SetLike.exists_of_lt hWXlt
  let s : S := ⟨c, hXH hcX⟩
  have hsfull : s ∈ d.projection.inverseImage ⊤ := d.full_image.symm ▸ mem_top _
  obtain ⟨v, _, hv⟩ := hsfull
  have hvne : v ≠ 1 := by
    intro he
    apply hcW
    have hsZ : s ∈ L.subgroupOf S := (QuotientGroup.eq_one_iff s).mp
      (hv.symm.trans (by rw [he, map_one]))
    exact hsZ
  have hv2 : v ^ 2 = 1 := by
    apply d.projection.injective
    rw [map_pow, hv, map_one, ← map_pow (QuotientGroup.mk' _)]
    apply (QuotientGroup.eq_one_iff _).mpr
    exact (W.subgroupOf X).sq_mem_of_index_two hXi ⟨c, hcX⟩
  let E := d.projection.inverseImage (zpowers v)
  have hE : E = zpowers s ⊔ L.subgroupOf S := inverseImage_zpowers_of_coordinate d v s hv
  have hEcard : Nat.card E = 4 := by
    rw [d.projection.card_inverseImage, d.kernel_card, Nat.card_zpowers,
      orderOf_eq_prime hv2 hvne]
  have hEmapC : E.map S.subtype ≤ C := (map_subtype_le _).trans d.configuration.proper.le
  have hEX : (E.map S.subtype).subgroupOf C ≤ X := by
    intro x hx
    obtain ⟨b, hb, he⟩ := hx
    rw [hE] at hb
    have hsub : zpowers s ⊔ L.subgroupOf S ≤ X.comap (inclusion d.configuration.proper.le) := by
      apply sup_le
      · exact zpowers_le.mpr hcX
      · intro z hz
        exact hWX hz
    have hh := hsub hb
    change (⟨(b : G), d.configuration.proper.le b.property⟩ : C) ∈ X at hh
    exact (show (⟨(b : G), d.configuration.proper.le b.property⟩ : C) = x from Subtype.ext he) ▸ hh
  have hEXeq : (E.map S.subtype).subgroupOf C = X := by
    apply eq_of_le_of_card_ge hEX
    rw [Nat.card_congr (subgroupOfEquivOfLe hEmapC).toEquiv,
      card_map_of_injective S.subtype_injective, hEcard, hXcard]
  have hsE : s ∈ E := hE.symm ▸ ((show zpowers s ≤ zpowers s ⊔ L.subgroupOf S from le_sup_left) (mem_zpowers s))
  obtain ⟨a, ha, l, hsl⟩ := (d.projection.mem_inverseImage_iff_factors
    d.configuration (zpowers v) s).mp hsE
  have hav : a = v := d.projection.injective ((d.projection.on_factors a s l hsl).trans hv.symm)
  exact ⟨v, hvne, hv2, hEXeq.symm ▸ hXn, hEcard, s, l, hav ▸ hsl, hE⟩

private theorem centralizer_index_le_two {P : Type*} [Group P] [Finite P]
    (W : Subgroup P) [W.Normal] (hW : Nat.card W = 4)
    (z : W) (hz : z ≠ 1) (hzc : (z : P) ∈ center P) :
    (centralizer (W : Set P)).index ≤ 2 := by
  let f : P →* MulAut W := MulAut.conjNormal
  have hker : f.ker = centralizer (W : Set P) := by
    ext c
    rw [MonoidHom.mem_ker, mem_centralizer_iff]
    constructor
    · intro hc w hw
      have he := congrArg (fun a : MulAut W => (a ⟨w, hw⟩ : P)) hc
      change c * w * c⁻¹ = w at he
      exact (mul_inv_eq_iff_eq_mul.mp he).symm
    · intro hc
      ext w
      change c * (w : P) * c⁻¹ = (w : P)
      rw [← hc w w.property, mul_inv_cancel_right]
  rw [← hker, index_ker]
  apply card_mulAut_subgroup_le_two_of_fixed_point hW z hz
  rintro a ⟨c, rfl⟩
  apply Subtype.ext
  change c * (z : P) * c⁻¹ = z
  rw [mem_center_iff.mp hzc c, mul_inv_cancel_right]

/-- Conjugation on the normal four fixes its central kernel, hence has image
of order at most two. Uniform centralizers identify its kernel with `S`. -/
theorem index_two (d : SaturatedProjection C L A S) : S.relIndex C = 2 := by
  let := d.configuration.overlap_normal
  let := d.abelian
  obtain ⟨v, hv, hv2, hEn, hEcard, s, l, hsl, hE⟩ := exists_normal_four d
  let E := d.projection.inverseImage (zpowers v)
  change E = _ at hE
  let F := (E.map S.subtype).subgroupOf C
  let : F.Normal := hEn
  have hEC : E.map S.subtype ≤ C := (map_subtype_le E).trans d.configuration.proper.le
  have hFc : Nat.card F = 4 := by
    rw [Nat.card_congr (subgroupOfEquivOfLe hEC).toEquiv,
      card_map_of_injective S.subtype_injective]
    exact hEcard
  obtain ⟨w, hw, _⟩ := (Nat.card_eq_two_iff' (1 : L.subgroupOf S)).mp d.kernel_card
  have hwE : (w : S) ∈ E := d.projection.kernel_le_inverseImage _ w.property
  let wC : C := ⟨((w : S) : G), d.configuration.proper.le (w : S).property⟩
  let wF : F := ⟨wC, ⟨w, hwE, rfl⟩⟩
  have hwF : wF ≠ 1 := by
    intro he
    apply hw
    apply Subtype.ext
    apply Subtype.ext
    exact congrArg (fun x : F => ((x : C) : G)) he
  have hwc : (wF : C) ∈ center C := by
    apply mem_center_iff.mpr
    intro c
    apply Subtype.ext
    exact (mem_centralizer_iff.mp (d.configuration.centralizes c.property) _ w.property).symm
  have hcent : centralizer (F : Set C) = S.subgroupOf C := by
    apply le_antisymm
    · intro c hc
      have hsE : s ∈ E := hE.symm ▸ ((show zpowers s ≤ zpowers s ⊔ L.subgroupOf S
        from le_sup_left) (mem_zpowers s))
      have hsF : (⟨s, d.configuration.proper.le s.property⟩ : C) ∈ F := ⟨s, hsE, rfl⟩
      have hcs : (s : G) * c = (c : G) * s := congrArg C.subtype
        (mem_centralizer_iff.mp hc _ hsF)
      have hcl := mem_centralizer_iff.mp (d.configuration.centralizes c.property) l l.property
      have hcv : (v : G) * c = (c : G) * v := by
        rw [← hsl, mul_assoc, hcl, ← mul_assoc, hcs, mul_assoc]
      have hcn : (c : G) ∈ C ⊓ centralizer ({(v : G)} : Set G) :=
        ⟨c.property, mem_centralizer_iff.mpr (by simpa using hcv)⟩
      rw [d.configuration.centralizers _ v.property (fun he => hv (Subtype.ext he))] at hcn
      exact hcn
    · intro c hc
      apply mem_centralizer_iff.mpr
      intro a ha
      obtain ⟨b, hb, he⟩ := ha
      apply Subtype.ext
      change (a : G) * c = (c : G) * a
      change (b : G) = (a : G) at he
      rw [← he]
      exact setLike_mul_comm (s := S) b.property hc
  have hi : S.relIndex C ≤ 2 := by
    change (S.subgroupOf C).index ≤ 2
    rw [← hcent]
    exact centralizer_index_le_two F hFc wF hwF hwc
  have hne : S.relIndex C ≠ 1 := fun he => d.configuration.proper.not_ge (relIndex_eq_one.mp he)
  have hp : S.relIndex C ≠ 0 := (S.subgroupOf C).index_ne_zero_of_finite
  omega

/-- An outside element of the index-two subgroup squares into it and,
together with it, generates the entire commuting Sylow subgroup. -/
theorem exists_mover (d : SaturatedProjection C L A S) :
    ∃ t ∈ C, t ∉ S ∧ t ^ 2 ∈ S ∧ S ⊔ zpowers t = C := by
  have hi := index_two d
  obtain ⟨t, ht, hout, hcoset⟩ := relIndex_eq_two_iff_exists_notMem_and.mp hi
  refine ⟨t, ht, hout, (S.subgroupOf C).sq_mem_of_index_two hi ⟨t, ht⟩, ?_⟩
  apply le_antisymm (sup_le d.configuration.proper.le (zpowers_le.mpr ht))
  intro c hc
  rcases hcoset c hc with hct | hcs
  · have hm := (S ⊔ zpowers t).mul_mem ((show S ≤ S ⊔ zpowers t from le_sup_left) hct)
      ((show zpowers t ≤ S ⊔ zpowers t from le_sup_right) ((zpowers t).inv_mem (mem_zpowers t)))
    simpa only [mul_inv_cancel_right] using hm
  · exact (show S ≤ S ⊔ zpowers t from le_sup_left) hcs

end CFSG.Quasithin.Chapter16.Intersections.SylowSymmetry.NormalFour
