module

public import CFSG.Quasithin.Chapter16.Section04To05.SylowSymmetry.NormalFour.Contracts
public import Theory.GroupTheory.PGroup.AbelianOmega

/-!
# The cyclic case remaining in the terminal TI argument

The fixed-point identity in `TIGeometry` centralizes `Ω₁(S)` in `C`.
Surjectivity of the saturated projection puts this omega subgroup in the
inverse image of `Ω₁(A)`. The corrected central-intersection formula then
identifies `Ω₁(S)` with the kernel, of order two. Consequently `S` is cyclic.

This is a reduction, not the terminal contradiction in Lemma 16.4.10.
In particular, centrality of omega does not establish centrality of the full
inverse image: the latter still has order four and is cyclic. The remaining
source argument must exclude this cyclic case using additional source facts.

Source: Aschbacher–Smith, combined manuscript (1 March 2004),
Lemma 16.4.10, printed p.1193, last paragraph of the proof.
-/

@[expose] public section
namespace CFSG.Quasithin.Chapter16.Intersections.SylowSymmetry.NormalFour
open Subgroup
variable {G : Type*} [Group G]
variable {C L A R S : Subgroup G}

/-- The fixed-point identity centralizes omega in the group generated by `S`
and the mover. This assertion concerns omega, not its larger inverse image. -/
theorem TIGeometry.omega_le_centralizer (b : TIGeometry C R S)
    [IsMulCommutative S] :
    omegaOneAmbient S ≤ centralizer (C : Set G) := by
  apply le_centralizer_iff.mpr
  rw [← b.generates]
  apply sup_le
  · exact le_centralizer_iff.mp ((omegaOneAmbient_le S).trans S.le_centralizer)
  · apply zpowers_le.mpr
    intro x hx
    have hxt := (b.omega_fixed ▸ hx).2
    exact (mem_centralizer_iff.mp hxt b.mover (by simp)).symm

/-- A surjective projection carries every involution of `S` into omega of
`A`. Its preimage can also contain elements of order four. -/
theorem SaturatedProjection.omega_le_inverseImage
    (d : SaturatedProjection C L A S) :
    letI := d.configuration.overlap_normal
    omega₁ S (p := 2) ≤ d.projection.inverseImage (omega₁ A (p := 2)) := by
  let := d.configuration.overlap_normal
  apply (Subgroup.closure_le _).mpr
  intro s hs
  have hs2 : s ^ 2 = 1 := by simpa only [Set.mem_ofPred_eq, pow_one] using hs
  have hsfull : s ∈ d.projection.inverseImage ⊤ := d.full_image.symm ▸ mem_top s
  obtain ⟨a, _, he⟩ := hsfull
  have ha2 : a ^ 2 = 1 := d.projection.injective (by
    rw [map_pow, he, ← map_pow, hs2, map_one, map_one])
  exact ⟨a, Subgroup.subset_closure (by simpa only [Set.mem_ofPred_eq, pow_one] using ha2), he⟩

/-- The actual consequence of the TI omega identity and order saturation:
the first omega subgroup is the central kernel of order two. -/
theorem SaturatedProjection.omega_eq_kernel
    (d : SaturatedProjection C L A S) (b : TIGeometry C R S) :
    omega₁ S (p := 2) = L.subgroupOf S := by
  let := d.configuration.overlap_normal
  let := d.abelian
  apply le_antisymm
  · rw [← d.projection.inverseImage_inf_centralizer d.configuration (omega₁ A (p := 2))]
    refine le_inf d.omega_le_inverseImage ?_
    intro s hs
    exact b.omega_le_centralizer (mem_map_of_mem S.subtype hs)
  · intro s hs
    apply Subgroup.subset_closure
    have hp := pow_card_eq_one' (x := (⟨s, hs⟩ : L.subgroupOf S))
    rw [d.kernel_card] at hp
    simpa only [Set.mem_ofPred_eq, pow_one] using (show s ^ 2 = 1 from congrArg (L.subgroupOf S).subtype hp)

variable [Finite G]

/-- The unresolved contrary case has a cyclic `S`, not an elementary full
inverse image of omega. -/
theorem SaturatedProjection.isCyclic_of_ti
    (d : SaturatedProjection C L A S) (b : TIGeometry C R S) : IsCyclic S := by
  let := d.abelian
  apply (d.two_group.to_le d.configuration.proper.le).isCyclic_of_card_omega_one_le_two
  rw [d.omega_eq_kernel b, d.kernel_card]

/-- The isomorphism in 16.4.2(1) transfers the cyclic reduction to `R`. -/
theorem SaturatedProjection.isCyclic_actor_of_ti
    (d : SaturatedProjection C L A S) (b : TIGeometry C R S) (e : R ≃* S) :
    IsCyclic R := by
  let := d.isCyclic_of_ti b
  exact isCyclic_of_surjective e.symm.toMonoidHom e.symm.surjective

/-- When `A` contains the involutions of `R`, as in Delta-zero, the full
inverse image in the remaining cyclic case has order four. -/
theorem SaturatedProjection.card_inverseImage_omega
    (d : SaturatedProjection C L A S) (b : TIGeometry C R S)
    (hAR : A ≤ R) (hO : omegaOneAmbient R ≤ A) (e : R ≃* S) :
    letI := d.configuration.overlap_normal
    Nat.card (d.projection.inverseImage (omega₁ A (p := 2))) = 4 := by
  let := d.configuration.overlap_normal
  rw [d.projection.card_inverseImage, omega_card_eq_of_inner hAR hO e,
    d.omega_eq_kernel b, d.kernel_card]

/-- The inverse image is a cyclic group of order four in the remaining case.
It must not be replaced by the elementary subgroup `Ω₁(S)`. -/
theorem SaturatedProjection.inverseImage_omega_cyclic_four
    (d : SaturatedProjection C L A S) (b : TIGeometry C R S)
    (hAR : A ≤ R) (hO : omegaOneAmbient R ≤ A) (e : R ≃* S) :
    letI := d.configuration.overlap_normal
    IsCyclic (d.projection.inverseImage (omega₁ A (p := 2))) ∧
      Nat.card (d.projection.inverseImage (omega₁ A (p := 2))) = 4 := by
  let := d.configuration.overlap_normal
  let := d.isCyclic_of_ti b
  exact ⟨inferInstance, d.card_inverseImage_omega b hAR hO e⟩

/-- The order-four subgroup has central intersection of order two. Thus the
last sentence of the printed argument requires a further contradiction; the
TI omega identity alone has not centralized this subgroup. -/
theorem SaturatedProjection.inverseImage_omega_not_central
    (d : SaturatedProjection C L A S) (b : TIGeometry C R S)
    (hAR : A ≤ R) (hO : omegaOneAmbient R ≤ A) (e : R ≃* S) :
    letI := d.configuration.overlap_normal
    ¬ d.projection.inverseImage (omega₁ A (p := 2)) ≤
      (centralizer (C : Set G)).subgroupOf S := by
  let := d.configuration.overlap_normal
  change ¬ d.projection.inverseImage (omega₁ A (p := 2)) ≤
    (centralizer (C : Set G)).subgroupOf S
  intro hc
  have he := d.projection.inverseImage_inf_centralizer d.configuration (omega₁ A (p := 2))
  rw [inf_eq_left.mpr hc] at he
  have hcard := d.card_inverseImage_omega b hAR hO e
  rw [he, d.kernel_card] at hcard
  norm_num at hcard

end CFSG.Quasithin.Chapter16.Intersections.SylowSymmetry.NormalFour

namespace CFSG.Quasithin.Chapter16.Intersections
open Subgroup SylowSymmetry.NormalFour
variable {G : Type*} [Group G] [Finite G]
variable {T : Sylow 2 G} {z g : G} {L R : Subgroup G}

/-- The remaining cyclic case for the genuine source setup. Chosen-Sylow
omega containment is proved from Delta-zero; it is not an additional premise.
This reduction does not prove the requested Sylow upgrade or rule out the
remaining case. -/
theorem IntersectionSetup.terminal_cyclic_reduction
    (h : IntersectionSetup T z L g R)
    (hd : (centralizer (L : Set G)).conjBy g ∈ deltaZero L)
    (d : SaturatedProjection (commutingSylow T L) L (innerPart L R)
      (commutingSylow T L ⊓ centralizer (R : Set G)))
    (b : TIGeometry (commutingSylow T L) R
      (commutingSylow T L ⊓ centralizer (R : Set G)))
    (e : R ≃* ↥(commutingSylow T L ⊓ centralizer (R : Set G))) :
    letI := d.configuration.overlap_normal
    IsCyclic R ∧
      IsCyclic (d.projection.inverseImage (omega₁ (innerPart L R) (p := 2))) ∧
      Nat.card (d.projection.inverseImage (omega₁ (innerPart L R) (p := 2))) = 4 := by
  let := d.configuration.overlap_normal
  have hO : omegaOneAmbient R ≤ innerPart L R :=
    le_inf (omegaOneAmbient_le R) (h.omega_le_of_mem_deltaZero hd)
  exact ⟨d.isCyclic_actor_of_ti b e, d.inverseImage_omega_cyclic_four b inf_le_left hO e⟩

end CFSG.Quasithin.Chapter16.Intersections
