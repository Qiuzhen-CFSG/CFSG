module

public import CFSG.Quasithin.Chapter16.Section04To05.IntersectionStructure.RankResidual.Local

/-!
# Comparing the core quotient with the fixed star image

The explicit map from C_G(i) onto its image in H/K has kernel C_K(i).
The rank-two calculation identifies this kernel with O_{p'}(C_G(i)),
giving an actual quotient isomorphism and hence an isomorphism of the
prime-to-p residuals. No equality of unrelated quotients is assumed.

Also L is generated by p-elements and has p-prime index in L C_K(i),
so its embedded prime-to-p residual equals L as an ambient subgroup.
This conclusion holds before selecting either A.3.18 alternative.

Source: Aschbacher–Smith, combined manuscript (1 March 2004),
Lemma 16.4.5, p.1184, and A.3.18, pp.51–52.
-/

@[expose] public section

open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter16.Intersections
variable {G : Type*} [Group G] [Finite G]
variable {T : Sylow 2 G} {z : G} {L : Subgroup G}

/-- The actual surjection from C_G(i) onto C_G(i)* inside the fixed H/K. -/
def StandardSetup.localStarMap (h : StandardSetup T z L) {i : G}
    (hi : i ∈ centralizer (L : Set G)) (hi2 : orderOf i = 2) :
    involutionCentralizer i →*
      starImage L (involutionCentralizer i) (h.involution_centralizer_le hi hi2) :=
  ((componentActionQuotientMap L).subgroupMap
    ((involutionCentralizer i).subgroupOf (normalizer (L : Set G)))).comp
      (subgroupOfEquivOfLe (h.involution_centralizer_le hi hi2)).symm.toMonoidHom

/-- The map onto the fixed star image is surjective. -/
theorem StandardSetup.localStarMap_surjective (h : StandardSetup T z L) {i : G}
    (hi : i ∈ centralizer (L : Set G)) (hi2 : orderOf i = 2) :
    Function.Surjective (h.localStarMap hi hi2) :=
  ((componentActionQuotientMap L).subgroupMap_surjective _).comp
    (subgroupOfEquivOfLe (h.involution_centralizer_le hi hi2)).symm.surjective

/-- Its kernel is the relative centralizer of L, not an arbitrary core. -/
theorem StandardSetup.localStarMap_ker (h : StandardSetup T z L) {i : G}
    (hi : i ∈ centralizer (L : Set G)) (hi2 : orderOf i = 2) :
    (h.localStarMap hi hi2).ker =
      centralizer (L.subgroupOf (involutionCentralizer i) :
        Set (involutionCentralizer i)) := by
  ext x
  constructor
  · intro hx
    have hh := congrArg Subtype.val (show h.localStarMap hi hi2 x = 1 from hx)
    change componentActionQuotientMap L
      (inclusion (h.involution_centralizer_le hi hi2) x) = 1 at hh
    have hK := (QuotientGroup.eq_one_iff _).mp hh
    intro l hl
    exact Subtype.ext (hK l hl)
  · intro hx
    apply Subtype.ext
    change componentActionQuotientMap L
      (inclusion (h.involution_centralizer_le hi hi2) x) = 1
    apply (QuotientGroup.eq_one_iff _).mpr
    intro l hl
    exact congrArg Subtype.val (hx (⟨l, (h.involution_component hi hi2).1 hl⟩ :
      involutionCentralizer i) hl)

/-- The A.3.18 quotient and the fixed star image are canonically isomorphic. -/
noncomputable def StandardSetup.localCoreQuotientEquivStar (h : StandardSetup T z L)
    {κ : GroupClass} (hG : Hypothesis1611 κ G)
    {p : ℕ} [Fact p.Prime] (hp : Odd p) (hr : 1 < primeRank p L)
    {i : G} (hi : i ∈ centralizer (L : Set G)) (hi2 : orderOf i = 2) :
    (involutionCentralizer i ⧸ pPrimeCore p (involutionCentralizer i)) ≃*
      starImage L (involutionCentralizer i) (h.involution_centralizer_le hi hi2) :=
  (QuotientGroup.quotientMulEquivOfEq
    ((h.local_primeCore_eq_centralizer hG hp hr hi hi2).trans
      (h.localStarMap_ker hi hi2).symm)).trans
    (QuotientGroup.quotientKerEquivOfSurjective _ (h.localStarMap_surjective hi hi2))

/-- The product-residual equality in 16.4.5(2), with the ambient embedding. -/
theorem StandardSetup.primeToResidual_product_centralizer (h : StandardSetup T z L) {κ : GroupClass}
    (hG : Hypothesis1611 κ G) {p : ℕ} [Fact p.Prime] (hp : Odd p)
    (hr : 1 < primeRank p L) {i : G}
    (hi : i ∈ centralizer (L : Set G)) (hi2 : orderOf i = 2) :
    primeToResidualIn p (L ⊔ (centralizer (L : Set G) ⊓ involutionCentralizer i)) = L := by
  let C := involutionCentralizer i
  let J := L.subgroupOf C
  let D := centralizer (J : Set C)
  have hL := h.involution_component hi hi2
  let : J.Normal := (normal_subgroupOf_iff_le_normalizer hL.1).mpr
    (h.involution_centralizer_le hi hi2)
  have hd : D.map C.subtype = centralizer (L : Set G) ⊓ C := by
    ext x
    constructor
    · rintro ⟨y, hy, rfl⟩
      refine ⟨?_, y.property⟩
      intro l hl
      exact congrArg Subtype.val (hy (⟨l, hL.1 hl⟩ : C) hl)
    · intro hx
      refine ⟨⟨x, hx.2⟩, ?_, rfl⟩
      intro l hl
      exact Subtype.ext (hx.1 l hl)
  have hprod : (J ⊔ D).map C.subtype = L ⊔ (centralizer (L : Set G) ⊓ C) := by
    rw [Subgroup.map_sup, map_subgroupOf_eq_of_le hL.1, hd]
  have hc : Nat.Coprime p (J.relIndex (J ⊔ D)) := by
    rw [relIndex_sup_left]
    exact (h.local_centralizer_coprime hG hp hr hi hi2).of_dvd_right
      (J.relIndex_dvd_card D)
  let P := L ⊔ (centralizer (L : Set G) ⊓ C)
  have hLP : L ≤ P := le_sup_left
  have hPC : P ≤ C := sup_le hL.1 inf_le_right
  let : (L.subgroupOf P).Normal := (normal_subgroupOf_iff_le_normalizer hLP).mpr
    (hPC.trans (h.involution_centralizer_le hi hi2))
  have hidx : Nat.Coprime p (L.subgroupOf P).index := by
    change Nat.Coprime p (L.relIndex P)
    change Nat.Coprime p (L.relIndex (L ⊔ (centralizer (L : Set G) ⊓ C)))
    rw [← hprod, ← map_subgroupOf_eq_of_le hL.1,
      relIndex_map_map_of_injective J (J ⊔ D) C.subtype_injective]
    exact hc
  have hgen : primeToResidual p (L.subgroupOf P) = ⊤ := by
    have hm := map_primeToResidual (p := p) (subgroupOfEquivOfLe hLP).symm
    rw [h.component_primeToResidual_eq_top hG hp (by omega),
      map_top_of_surjective _ (subgroupOfEquivOfLe hLP).symm.surjective] at hm
    exact hm.symm
  have he : primeToResidual p P = L.subgroupOf P :=
    le_antisymm (primeToResidual_le _ hidx)
      (le_primeToResidual_of_eq_top p _ hgen)
  change (primeToResidual p P).map P.subtype = L
  rw [he, map_subgroupOf_eq_of_le hLP]


/-- In particular, the residual in A.3.18 is transported to the residual
of C_G(i)* with both quotient conventions retained in the type. -/
noncomputable def StandardSetup.localResidualEquivStar (h : StandardSetup T z L)
    {κ : GroupClass} (hG : Hypothesis1611 κ G)
    {p : ℕ} [Fact p.Prime] (hp : Odd p) (hr : 1 < primeRank p L)
    {i : G} (hi : i ∈ centralizer (L : Set G)) (hi2 : orderOf i = 2) :
    primeToResidual p (involutionCentralizer i ⧸ pPrimeCore p (involutionCentralizer i)) ≃*
      primeToResidual p
        (starImage L (involutionCentralizer i) (h.involution_centralizer_le hi hi2)) :=
  primeToResidualEquiv p (h.localCoreQuotientEquivStar hG hp hr hi hi2)

/-- The first alternative of A.3.18 gives equality in the original
ambient group after applying the involution-centralizer inclusion. -/
theorem StandardSetup.ambient_residual_of_local
    (h : StandardSetup T z L) {p : ℕ} {i : G}
    (hi : i ∈ centralizer (L : Set G)) (hi2 : orderOf i = 2)
    (he : L.subgroupOf (involutionCentralizer i) =
      primeToResidual p (involutionCentralizer i)) :
    L = primeToResidualIn p (involutionCentralizer i) := by
  rw [primeToResidualIn, ← he,
    map_subgroupOf_eq_of_le (h.involution_component hi hi2).1]

end CFSG.Quasithin.Chapter16.Intersections
