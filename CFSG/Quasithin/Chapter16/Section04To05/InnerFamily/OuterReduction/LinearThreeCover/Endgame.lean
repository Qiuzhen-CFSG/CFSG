module

public import CFSG.Quasithin.Chapter16.Section04To05.InnerFamily.OuterReduction.LinearThreeCover.Basic

/-!
# Fusion from the field and graph constructions

For the graph action, the commutator map N_{T_L}(V) → U is a homomorphism:
the actors fix U pointwise. Its kernel is the kernel of the actual action
on V, since V is generated by r and the fixed axis. Equality of image and
U orders makes this map surjective. Consequently [N_{T_L}(V),r] = U,
and any nonidentity element gives the required residual fusion witness.
The three actual elementary models also show that every nonidentity action
fixes exactly the elementary-eight axis.

For the field action, choose a nonidentity element in the two-core of the
residual parabolic and use conjugacy under the cover parabolic two-core.
The general source separation (!) then contradicts either construction.
The existence of these two geometric configurations remains to be proved;
none of these conditional endgames asserts the source reduction by itself.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004, proof of
16.4.9(2), printed p.1191. All conjugation here is left conjugation.
-/

@[expose] public section

open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter16.Intersections.OuterReduction.LinearThreeCover
variable {G : Type*} [Group G] [Finite G]
variable {T : Sylow 2 G} {z g r : G} {L R : Subgroup G}

open scoped commutatorElement IsMulCommutative

/-- The actual restricted conjugation action. -/
private def normalizerAction (N V : Subgroup G) (hNV : N ≤ normalizer (V : Set G)) :
    N →* MulAut V := V.normalizerMonoidHom.comp (inclusion hNV)

private theorem commutator_surjective_of_fixed_axis
    (N U A V : Subgroup G) [IsMulCommutative U]
    (hNV : N ≤ normalizer (V : Set G)) (hV : V = zpowers r ⊔ A)
    (hUA : U ≤ A) (hfix : N ≤ centralizer (A : Set G))
    (hdisp : ∀ n ∈ N, ⁅n, r⁆ ∈ U)
    (hcard : Nat.card (normalizerAction N V hNV).range = Nat.card U) :
    ∀ u ∈ U, ∃ n ∈ N, ⁅n, r⁆ = u := by
  let d : N →* U := {
    toFun := fun n => ⟨⁅(n : G), r⁆, hdisp n n.property⟩
    map_one' := by apply Subtype.ext; simp
    map_mul' := by
      intro x y
      apply Subtype.ext
      change ⁅(x : G) * (y : G), r⁆ = ⁅(x : G), r⁆ * ⁅(y : G), r⁆
      rw [commutatorElement_mul_left_eq_conj_mul]
      have hc : (x : G) * ⁅(y : G), r⁆ = ⁅(y : G), r⁆ * (x : G) :=
        (mem_centralizer_iff.mp (hfix x.property) _ (hUA (hdisp y y.property))).symm
      rw [hc, mul_inv_cancel_right]
      exact congrArg Subtype.val (mul_comm
        (⟨⁅(y : G), r⁆, hdisp y y.property⟩ : U)
        (⟨⁅(x : G), r⁆, hdisp x x.property⟩ : U)) }
  have hk : d.ker = (normalizerAction N V hNV).ker := by
    ext n
    constructor
    · intro hn
      have hnr : Commute (n : G) r :=
        commutatorElement_eq_one_iff_mul_comm.mp (congrArg Subtype.val hn)
      have hnV : (n : G) ∈ centralizer (V : Set G) := by
        have hle : V ≤ centralizer ({(n : G)} : Set G) := by
          rw [hV]
          apply sup_le
          · exact zpowers_le.mpr (mem_centralizer_singleton_iff.mpr hnr.symm.eq)
          · intro a ha
            exact mem_centralizer_singleton_iff.mpr
              (mem_centralizer_iff.mp (hfix n.property) a ha)
        intro v hv
        exact mem_centralizer_singleton_iff.mp (hle hv)
      rw [MonoidHom.mem_ker]
      apply MulEquiv.ext
      intro v
      apply Subtype.ext
      change (n : G) * (v : G) * (n : G)⁻¹ = (v : G)
      rw [← mem_centralizer_iff.mp hnV v v.property, mul_inv_cancel_right]
    · intro hn
      have hrV : r ∈ V := hV.symm ▸ mem_sup_left (mem_zpowers r)
      have he := congrArg (fun a : MulAut V => (a ⟨r, hrV⟩ : G)) hn
      have hc : (n : G) * r = r * (n : G) := mul_inv_eq_iff_eq_mul.mp he
      apply Subtype.ext
      exact commutatorElement_eq_one_iff_mul_comm.mpr hc
  have hdcard : Nat.card d.range = Nat.card U := by
    rw [← index_ker, hk, index_ker, hcard]
  have hsurj : Function.Surjective d := by
    apply MonoidHom.range_eq_top.mp
    apply eq_top_of_card_eq
    exact hdcard
  intro u hu
  obtain ⟨n, hn⟩ := hsurj ⟨u, hu⟩
  exact ⟨n, n.property, congrArg Subtype.val hn⟩


private theorem commutator_eq_of_fixed_axis
    (N U A V : Subgroup G) [IsMulCommutative U]
    (hr2 : orderOf r = 2)
    (hNV : N ≤ normalizer (V : Set G)) (hV : V = zpowers r ⊔ A)
    (hUA : U ≤ A) (hfix : N ≤ centralizer (A : Set G))
    (hdisp : ∀ n ∈ N, ⁅n, r⁆ ∈ U)
    (hcard : Nat.card (normalizerAction N V hNV).range = Nat.card U) :
    ⁅N, zpowers r⁆ = U := by
  apply le_antisymm
  · apply commutator_le.mpr
    intro n hn s hs
    have hs' : s = 1 ∨ s = r := by
      classical
      rw [mem_zpowers_iff_mem_range_orderOf, hr2] at hs
      obtain ⟨k, hk, he⟩ := Finset.mem_image.mp hs
      have hk' := Finset.mem_range.mp hk
      have hk01 : k = 0 ∨ k = 1 := by omega
      rcases hk01 with rfl | rfl <;> simp_all
    rcases hs' with rfl | rfl
    · simp
    · exact hdisp n hn
  · intro u hu
    obtain ⟨n, hn, rfl⟩ := commutator_surjective_of_fixed_axis N U A V
      hNV hV hUA hfix hdisp hcard u hu
    exact commutator_mem_commutator hn (mem_zpowers r)

private theorem fusion_of_fixed_axis
    (N U A V : Subgroup G) [IsMulCommutative U]
    (hNL : N ≤ L) (hUR : U ≤ OuterResidual.involutionResidual L r)
    (hUne : U ≠ ⊥)
    (hNV : N ≤ normalizer (V : Set G)) (hV : V = zpowers r ⊔ A)
    (hUA : U ≤ A) (hfix : N ≤ centralizer (A : Set G))
    (hdisp : ∀ n ∈ N, ⁅n, r⁆ ∈ U)
    (hcard : Nat.card (normalizerAction N V hNV).range = Nat.card U) :
    ResidualFusionWitness L r := by
  obtain ⟨u, hu, hu1⟩ : ∃ u ∈ U, u ≠ 1 := by
    by_contra! hn
    exact hUne (le_bot_iff.mp (fun u hu => mem_bot.mpr (hn u hu)))
  obtain ⟨n, hn, hnu⟩ := commutator_surjective_of_fixed_axis N U A V
    hNV hV hUA hfix hdisp hcard u hu
  refine ⟨n, hNL hn, u, hUR hu, hu1, ?_⟩
  have he : MulAut.conj n r = u * r := mul_inv_eq_iff_eq_mul.mp hnu
  exact he.trans (mem_centralizer_singleton_iff.mp
    ((OuterResidual.involutionResidual_le L r) (hUR hu)).2)


omit [Finite G] in
private theorem GraphGeometry.u_card (d : GraphGeometry T z L r) :
    Nat.card (graphU T L r) = 4 := by
  obtain ⟨e⟩ := d.u_model
  calc
    Nat.card (graphU T L r) = Nat.card (BinarySpace 2) := Nat.card_congr e.toEquiv
    _ = 4 := by simp [BinarySpace]

omit [Finite G] in
private theorem GraphGeometry.u_commutative (d : GraphGeometry T z L r) :
    IsMulCommutative (graphU T L r) := by
  obtain ⟨e⟩ := d.u_model
  exact ⟨⟨fun x y => e.injective (by simp only [map_mul]; exact mul_comm _ _)⟩⟩

omit [Finite G] in
/-- Each nonidentity element of the actual normalizer action fixes exactly
the specified elementary-eight axis in the elementary-sixteen space. -/
theorem GraphGeometry.fixedSubgroup_eq_axis (d : GraphGeometry T z L r)
    (n : graphNormalizer T z L r) (hn : graphAction T z L r n ≠ 1) :
    (graphAction T z L r n).fixedSubgroup =
      (graphAxis T z L r).subgroupOf (graphSpace T z L r) := by
  let V := graphSpace T z L r
  let A := (graphAxis T z L r).subgroupOf V
  let F := (graphAction T z L r n).fixedSubgroup
  have hAV : graphAxis T z L r ≤ V := le_sup_right
  have hAcard : Nat.card A = 8 := by
    obtain ⟨e⟩ := d.axis_model
    calc
      Nat.card A = Nat.card (graphAxis T z L r) :=
        Nat.card_congr (subgroupOfEquivOfLe hAV).toEquiv
      _ = Nat.card (BinarySpace 3) := Nat.card_congr e.toEquiv
      _ = 8 := by simp [BinarySpace]
  have hVcard : Nat.card V = 16 := by
    obtain ⟨e⟩ := d.space_model
    calc
      Nat.card V = Nat.card (BinarySpace 4) := Nat.card_congr e.toEquiv
      _ = 16 := by simp [BinarySpace]
  have hindex : A.index = 2 := by
    have hh := A.index_mul_card
    rw [hAcard, hVcard] at hh
    omega
  have hAF : A ≤ F := by
    intro v hv
    apply (MulAut.mem_fixedSubgroup _ _).mpr
    apply Subtype.ext
    change (n : G) * (v : G) * (n : G)⁻¹ = (v : G)
    rw [← mem_centralizer_iff.mp (d.axis_fixed n.property) v hv,
      mul_inv_cancel_right]
  have hFne : F ≠ ⊤ := by
    intro he
    apply hn
    apply MulEquiv.ext
    intro v
    exact (MulAut.mem_fixedSubgroup _ _).mp (show v ∈ F from he.symm ▸ mem_top v)
  apply le_antisymm _ hAF
  have hm := relIndex_mul_index hAF
  rw [hindex] at hm
  have hp : (A.relIndex F * F.index).Prime := hm ▸ Nat.prime_two
  rcases Nat.prime_mul_iff.mp hp with ⟨_, hF⟩ | ⟨_, hrel⟩
  · exact (hFne (index_eq_one.mp hF)).elim
  · exact relIndex_eq_one.mp hrel

/-- Evaluation at r identifies the four-element acting image with U, hence
all of U consists of actual single commutators with r. -/
theorem GraphGeometry.commutator_eq (d : GraphGeometry T z L r) (hr2 : orderOf r = 2) :
    ⁅graphNormalizer T z L r, zpowers r⁆ = graphU T L r := by
  let := d.u_commutative
  exact commutator_eq_of_fixed_axis
    (graphNormalizer T z L r) (graphU T L r) (graphAxis T z L r) (graphSpace T z L r)
    hr2 inf_le_right rfl le_sup_right d.axis_fixed d.displacement
    (d.action_card.trans d.u_card.symm)

/-- The graph action produces an L-conjugator and a nonidentity element of
the actual two-residual. No orbit or fusion witness is an input. -/
theorem GraphGeometry.fusionWitness (d : GraphGeometry T z L r) :
    ResidualFusionWitness L r := by
  let := d.u_commutative
  refine fusion_of_fixed_axis
    (graphNormalizer T z L r) (graphU T L r) (graphAxis T z L r) (graphSpace T z L r)
    (inf_le_left.trans inf_le_right) inf_le_right ?_
    inf_le_right rfl le_sup_right d.axis_fixed d.displacement
    (d.action_card.trans d.u_card.symm)
  intro he
  have hc := d.u_card
  simp only [he, Subgroup.card_bot] at hc
  omega

omit [Finite G] in
/-- A nontrivial parabolic two-core supplies the residual element; the
conjugator remains in the two-core of the compatible cover parabolic. -/
theorem FieldParabolicGeometry.fusionWitness (d : FieldParabolicGeometry L r) :
    ResidualFusionWitness L r := by
  have hne : (pCore 2 d.residualParabolic).map d.residualParabolic.subtype ≠ ⊥ := by
    intro he
    exact d.core_nontrivial
      (((pCore 2 d.residualParabolic).map_eq_bot_iff_of_injective
        d.residualParabolic.subtype_injective).mp he)
  obtain ⟨v, hv, hv1⟩ : ∃ v ∈ (pCore 2 d.residualParabolic).map d.residualParabolic.subtype,
      v ≠ 1 := by
    by_contra! hn
    exact hne (le_bot_iff.mp (fun v hv => mem_bot.mpr (hn v hv)))
  obtain ⟨x, hx, he⟩ := d.conjugacy v hv
  exact ⟨x, d.cover_le (map_subtype_le _ hx), v,
    d.residual_le (map_subtype_le _ hv), hv1, he⟩

/-- Source (!) excludes every constructed field-parabolic configuration. -/
theorem not_fieldParabolicGeometry (h : IntersectionSetup T z L g R)
    (hsmall : OrderTwoOutsideDeltaZero L) (hempty : ¬ (deltaZero L).Nonempty)
    (hr : r ∈ R) (hr2 : orderOf r = 2)
    (hres : OuterResidual.involutionResidual L r ≤ L.conjBy g) :
    ¬ Nonempty (FieldParabolicGeometry L r) := by
  rintro ⟨d⟩
  exact no_residualFusionWitness h hsmall hempty hr hr2 hres d.fusionWitness

/-- The contradiction applies to geometry constructed using any suitable
Sylow subgroup; the original intersection setup is retained for (!). -/
theorem not_graphGeometry (h : IntersectionSetup T z L g R)
    (hsmall : OrderTwoOutsideDeltaZero L) (hempty : ¬ (deltaZero L).Nonempty)
    (hr : r ∈ R) (hr2 : orderOf r = 2)
    (hres : OuterResidual.involutionResidual L r ≤ L.conjBy g)
    (S : Sylow 2 G) : ¬ GraphGeometry S z L r := by
  intro d
  exact no_residualFusionWitness h hsmall hempty hr hr2 hres d.fusionWitness

end CFSG.Quasithin.Chapter16.Intersections.OuterReduction.LinearThreeCover
