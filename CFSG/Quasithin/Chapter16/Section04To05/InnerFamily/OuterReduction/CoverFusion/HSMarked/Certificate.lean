def forward (i : Fin 2) (j : Fin 5) (x : Fin 100) : Fin 100 :=
  ⟨(forwardCode i j >>> (7 * x.val)) % 128 % 100, Nat.mod_lt _ (by decide)⟩
def backward (i : Fin 2) (j : Fin 5) (x : Fin 100) : Fin 100 :=
  ⟨(backwardCode i j >>> (7 * x.val)) % 128 % 100, Nat.mod_lt _ (by decide)⟩
theorem left_check : ∀ i j x, backward i j (forward i j x) = x := by
  apply OrderCertificate.allFin
  decide +kernel
theorem right_check : ∀ i j x, forward i j (backward i j x) = x := by
  apply OrderCertificate.allFin
  decide +kernel
def perm (i : Fin 2) (j : Fin 5) : Equiv.Perm (Fin 100) where
  toFun := forward i j
  invFun := backward i j
  left_inv := left_check i j
  right_inv := right_check i j

theorem graph_check : ∀ i j, perm i j ∈ graphGroup := by
  change ∀ (i : Fin 2) (j : Fin 5) (x y : Fin 100),
    adjacency (perm i j x) (perm i j y) ↔ adjacency x y
  apply OrderCertificate.allFin
  decide +kernel
theorem sign_check : ∀ i j, Equiv.Perm.sign (perm i j) = 1 := by
  apply OrderCertificate.allFin
  decide +kernel

theorem perm_mem (i : Fin 2) (j : Fin 5) : perm i j ∈ generated := by
  by_contra h
  have he := sign_of_normalizer_not_mem
    ⟨perm i j, graphGroup_le_permutationNormalizer (graph_check i j)⟩ h
  rw [sign_check] at he
  exact (by decide : (1 : ℤˣ) ≠ -1) he

def element (i : Fin 2) (j : Fin 5) : Carrier := ⟨perm i j, perm_mem i j⟩
def actor (i : Fin 2) : PermutationNormalizer :=
  if i = 0 then elementaryNormalizer else symmetricNormalizer

theorem square_check : ∀ i : Fin 2, ∀ x : Fin 100,
    (perm i 1 ^ 2) x = x := by
  apply OrderCertificate.allFin
  decide +kernel
theorem nontrivial_check : ∀ i : Fin 2, perm i 1 0 ≠ 0 := by
  apply OrderCertificate.allFin
  decide +kernel
theorem fusion_check : ∀ i : Fin 2, ∀ x : Fin 100,
    ((actor i).val * perm i 0 * (actor i).val⁻¹ * (perm i 0)⁻¹) x = perm i 1 x := by
  apply OrderCertificate.allFin
  decide +kernel
theorem mark_check : ∀ i : Fin 2, ∀ x : Fin 100,
    (perm i 2 * inclusion EvenLocalCandidates.e0 * (perm i 2)⁻¹) x = perm i 1 x := by
  apply OrderCertificate.allFin
  decide +kernel
theorem fixed_check : ∀ i : Fin 2, ∀ j : Fin 2, ∀ x : Fin 100,
    ((actor i).val * perm i ⟨3 + j.val, by omega⟩ * (actor i).val⁻¹) x =
      perm i ⟨3 + j.val, by omega⟩ x := by
  apply OrderCertificate.allFin
  decide +kernel
def oddExponent (i : Fin 2) (j : Fin 2) : ℕ :=
  if i = 0 then 5 else if j = 0 then 3 else 7
theorem odd_check : ∀ i : Fin 2, ∀ j : Fin 2, ∀ x : Fin 100,
    (perm i ⟨3 + j.val, by omega⟩ ^ oddExponent i j) x = x := by
  apply OrderCertificate.allFin
  decide +kernel
theorem product_check : ∀ i : Fin 2, ∀ x : Fin 100,
    (perm i 4 * perm i 3) x = perm i 1 x := by
  apply OrderCertificate.allFin
  decide +kernel

