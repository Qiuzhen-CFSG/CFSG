module

public import CFSG.Quasithin.Chapter16.Section04To05.InnerFamily.OuterReduction.Setup
public import CFSG.Quasithin.Chapter16.Section04To05.InnerFamily.OuterReduction.Consequences
public import CFSG.Quasithin.Chapter16.Section01To02.LiePreliminaries.Basic
public import Theory.GroupTheory.DoubleCoverCentralizer.Basic

/-!
# Lifting the marked quotient fusion through a double cover

For the four remaining covers in the proof of 16.4.9, the center/core
identity and the commuting-Sylow dichotomy identify the nontrivial center
with ⟨z⟩. Its order bound is deduced from the complete 16.1.2(2) alternative
once the concrete quotient has been separated from Sz(8), PSL₃(4), and M₂₂.

A central two-group quotient maps O² of the actual fixed subgroup onto O²
of the quotient fixed subgroup. Thus a marked quotient involution has a
preimage in the actual residual, and I.2.2(5a), together with equality of
squares in a double-cover coset, proves that this preimage is involutory.
The conjugation equation lifts with error 1 or z. The order-four element
from I.2.2(5b) squares to z and removes this error by the existing correction
lemma in `Consequences`.

`TwoCentralResidualFusion` specifies the remaining intrinsic calculation,
not a source hypothesis or a theorem asserting that it holds. The final
reduction retains actual model equivalences, ambient conjugation, and the
complete earlier center alternative. It does not equate the image of the
full fixed subgroup with the fixed subgroup of the quotient. In particular,
the full fixed group G₂(2) must remain distinct from its two-residual.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004,
I.2.2(5a,b), printed p.409; 16.1.2(2), p.1170; proof of 16.4.9(2), p.1191.
The four concrete model calculations are separate prerequisites.
-/

@[expose] public section

open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter16.Intersections.OuterReduction.CoverFusion
open ComponentTransfer.Intrinsic LiePreliminaries DoubleCoverCentralizer
variable {G : Type*} [Group G] [Finite G]
variable {T : Sylow 2 G} {z g r : G} {L R : Subgroup G}

private theorem mem_zpowers_two {x z : G} (hz : orderOf z = 2)
    (hx : x ∈ zpowers z) : x = 1 ∨ x = z := by
  classical
  rw [mem_zpowers_iff_mem_range_orderOf, hz] at hx
  obtain ⟨n, hn, he⟩ := Finset.mem_image.mp hx
  have hn' := Finset.mem_range.mp hn
  interval_cases n <;> simp_all

/-- The two-group center lies in the actual commuting Sylow subgroup. -/
theorem center_image_le_commutingSylow (h : StandardSetup T z L)
    (hc : center L = pCore 2 L) :
    (center L).map L.subtype ≤ commutingSylow T L := by
  let Z := (center L).map L.subtype
  let K := centralizer (L : Set G)
  have hZL : Z ≤ L := map_subtype_le _
  have hZK : Z ≤ K := by
    rintro x ⟨c, hc, rfl⟩ y hy
    exact congrArg Subtype.val (mem_center_iff.mp hc ⟨y, hy⟩)
  have hKZ : K ≤ normalizer (Z : Set G) :=
    (centralizer_le hZL).trans (centralizer_le_normalizer _)
  let : (Z.subgroupOf K).Normal :=
    (normal_subgroupOf_iff_le_normalizer hZK).mpr hKZ
  have hpC : IsPGroup 2 (center L) := hc.symm ▸ pCore_isPGroup
  have hp : IsPGroup 2 Z := hpC.map _
  obtain ⟨S, hS⟩ := commutingSylow_sylow h
  have hle := (hp.of_equiv (subgroupOfEquivOfLe hZK).symm).le_sylow_of_normal S
  have hm := map_mono (f := K.subtype) hle
  rwa [map_subgroupOf_eq_of_le hZK, hS] at hm

/-- The nontrivial double-cover center is generated by the specified z.
The bound is the four-model specialization of source 16.1.2(2). -/
theorem center_eq_zpowers (h : StandardSetup T z L)
    (hc : center L = pCore 2 L) (hne : pCore 2 L ≠ ⊥)
    (hbound : Nat.card (center L) ≤ 2)
    (hd : CommutingSylowDichotomy T z L) :
    (center L).map L.subtype = zpowers z ∧ Nat.card (center L) = 2 := by
  have hcne : center L ≠ ⊥ := hc ▸ hne
  have hcard : Nat.card (center L) = 2 := by
    have hh := (one_lt_card_iff_ne_bot (center L)).mpr hcne
    omega
  refine ⟨?_, hcard⟩
  rcases hd with hd | ⟨hzL, _⟩
  · apply eq_of_le_of_card_ge
    · simpa only [hd] using center_image_le_commutingSylow h hc
    · rw [Nat.card_zpowers, h.involution, card_map_of_injective L.subtype_injective, hcard]
  · apply Eq.symm
    apply eq_of_le_of_card_ge
    · apply zpowers_le.mpr
      refine ⟨⟨z, hzL⟩, ?_, rfl⟩
      apply mem_center_iff.mpr
      intro x
      apply Subtype.ext
      exact mem_centralizer_singleton_iff.mp (h.component.1 x.property)
    · rw [Nat.card_zpowers, h.involution, card_map_of_injective L.subtype_injective, hcard]

omit [Finite G] in
/-- The given ambient actor is outer on L, rather than a separately chosen model action. -/
theorem action_not_inner (hn : r ∈ normalizer (L : Set G))
    (hout : r ∉ centralizer (L : Set G) ⊔ L) :
    ¬ ∃ l : L, action hn = MulAut.conj l := by
  rintro ⟨l, hl⟩
  let rN : normalizer (L : Set G) := ⟨r, hn⟩
  let lN : normalizer (L : Set G) := ⟨l, L.le_normalizer l.property⟩
  have hlN : L.normalizerMonoidHom lN = MulAut.conj l := by ext x; rfl
  have hk : lN⁻¹ * rN ∈ L.normalizerMonoidHom.ker := by
    rw [MonoidHom.mem_ker, map_mul, map_inv, hlN]
    change (MulAut.conj l)⁻¹ * action hn = 1
    rw [hl, inv_mul_cancel]
  rw [normalizerMonoidHom_ker] at hk
  apply hout
  have hh := (centralizer (L : Set G) ⊔ L).mul_mem
    (mem_sup_right l.property) (mem_sup_left hk)
  change (l : G) * ((l : G)⁻¹ * r) ∈ centralizer (L : Set G) ⊔ L at hh
  simpa only [mul_inv_cancel_left] using hh

omit [Finite G] in
/-- The outer actor of order two gives an automorphism of order exactly two. -/
theorem action_order_two (hn : r ∈ normalizer (L : Set G))
    (hr2 : orderOf r = 2) (hout : r ∉ centralizer (L : Set G) ⊔ L) :
    orderOf (action hn) = 2 := by
  apply orderOf_eq_prime
  · change L.normalizerMonoidHom (⟨r, hn⟩ : normalizer (L : Set G)) ^ 2 = 1
    rw [← map_pow, show (⟨r, hn⟩ : normalizer (L : Set G)) ^ 2 = 1 from
      Subtype.ext (hr2 ▸ pow_orderOf_eq_one r), map_one]
  · intro he
    apply action_not_inner hn hout
    exact ⟨1, by simpa using he⟩


/-- Precisely the lifting assertion of I.2.2(5a), using the actual central quotient. -/
def TwoCentralInvolutionLifting (H : Type*) [Group H] : Prop :=
  ∀ u : H ⧸ center H, orderOf u = 2 → TwoCentral u →
    ∃ v : H, QuotientGroup.mk' (center H) v = u ∧ orderOf v = 2

/-- The outer-inversion assertion of I.2.2(5b), retaining the non-two-central mark. -/
def OuterInvertsFourLift (H : Type*) [Group H] : Prop :=
  ∀ a : MulAut H, orderOf a = 2 → (¬ ∃ x : H, a = MulAut.conj x) →
    ∃ y : H, orderOf y = 4 ∧ orderOf (QuotientGroup.mk' (center H) y) = 2 ∧
      ¬ TwoCentral (QuotientGroup.mk' (center H) y) ∧ a y = y⁻¹

/-- The remaining intrinsic model calculation. For left conjugation by an
involution r, the equation is equivalent to l r l⁻¹ = r v. -/
def TwoCentralResidualFusion {S : Type*} [Group S] (b : MulAut S) : Prop :=
  ∃ l v : S, v ∈ fixedTwoResidual S b ∧ orderOf v = 2 ∧ TwoCentral v ∧
    b l * l⁻¹ = v

/-- Residual surjectivity and I.2.2(5a) give an involution in the actual
fixed residual upstairs. Full fixed-subgroup surjectivity is not used. -/
theorem lift_residual_involution {H : Type*} [Group H] [Finite H]
    (hZ : Nat.card (center H) = 2) (hp : IsPGroup 2 (center H))
    (a : MulAut H) (u : H ⧸ center H)
    (hu : u ∈ fixedTwoResidual _ ((center H).quotientAut a))
    (hu2 : orderOf u = 2) (hlift : ∃ w : H,
      QuotientGroup.mk' (center H) w = u ∧ orderOf w = 2) :
    ∃ v : H, v ∈ fixedTwoResidual H a ∧ orderOf v = 2 ∧
      QuotientGroup.mk' (center H) v = u := by
  let q := QuotientGroup.mk' (center H)
  have hmap := MulAut.map_embedded_fixedResidual_of_central_pgroup_ker
    2 a ((center H).quotientAut a) q (QuotientGroup.mk'_surjective _)
    (by simp only [q, QuotientGroup.ker_mk', le_refl])
    (hp.of_equiv (MulEquiv.subgroupCongr (QuotientGroup.ker_mk' _)).symm)
    (fun x => (quotientAut_apply_mk _ _ x).symm)
  obtain ⟨v, hv, hvq⟩ := hmap.ge hu
  obtain ⟨w, hwq, hw2⟩ := hlift
  refine ⟨v, hv, ?_, hvq⟩
  apply orderOf_eq_prime
  · rw [square_eq_of_quotient_eq hZ (hvq.trans hwq.symm)]
    simpa only [hw2] using pow_orderOf_eq_one w
  · intro hv1
    have hu1 : u = 1 := hvq.symm.trans (hv1 ▸ q.map_one)
    simp [hu1] at hu2

omit [Finite G] in
/-- The intrinsic fixed residual embeds as the source O²(C_L(r)). -/
theorem map_fixedTwoResidual_action (hn : r ∈ normalizer (L : Set G)) :
    (fixedTwoResidual L (action hn)).map L.subtype =
      OuterResidual.involutionResidual L r := by
  rw [fixedTwoResidual, ← map_pResidual 2 (centralizerEquivFixed hn), map_map, map_map]
  rfl

/-- The actual central kernel gives exactly the two possible lifted conjugates. -/
theorem lifted_conjugate_eq (hn : r ∈ normalizer (L : Set G))
    (hr2 : orderOf r = 2) (hz2 : orderOf z = 2)
    (hZ : (center L).map L.subtype = zpowers z) (l v : L)
    (hq : QuotientGroup.mk' (center L) (action hn l * l⁻¹) =
      QuotientGroup.mk' (center L) v) :
    MulAut.conj (l : G) r = r * v ∨ MulAut.conj (l : G) r = r * v * z := by
  have hk : v⁻¹ * (action hn l * l⁻¹) ∈ center L := QuotientGroup.eq.mp hq.symm
  have hk' := mem_map_of_mem L.subtype hk
  rw [hZ] at hk'
  have hrsq : r * r = 1 := by simpa only [pow_two, hr2] using pow_orderOf_eq_one r
  have hri : r⁻¹ = r := inv_eq_of_mul_eq_one_left hrsq
  have he : r * ((action hn l : G) * (l : G)⁻¹) = MulAut.conj (l : G) r := by
    change r * ((r * l * r⁻¹) * (l : G)⁻¹) = (l : G) * r * (l : G)⁻¹
    rw [hri]
    calc
      _ = (r * r) * l * r * (l : G)⁻¹ := by group
      _ = _ := by rw [hrsq, one_mul]
  rcases mem_zpowers_two hz2 hk' with hd | hd
  · left
    have hh : (action hn l : G) * (l : G)⁻¹ = v := (inv_mul_eq_one.mp hd).symm
    rw [← he, hh]
  · right
    have hh : (action hn l : G) * (l : G)⁻¹ = (v : G) * z :=
      (inv_mul_eq_iff_eq_mul).mp hd
    rw [← he, hh, ← mul_assoc]

/-- An order-four lift of a quotient involution squares to the specified z. -/
theorem square_eq_z (hz2 : orderOf z = 2)
    (hZ : (center L).map L.subtype = zpowers z) (y : L)
    (hy4 : orderOf y = 4) (hq2 : orderOf (QuotientGroup.mk' (center L) y) = 2) :
    (y : G) ^ 2 = z := by
  have hk : y ^ 2 ∈ center L := by
    apply (QuotientGroup.eq_one_iff _).mp
    change QuotientGroup.mk' (center L) (y ^ 2) = 1
    rw [map_pow, ← hq2, pow_orderOf_eq_one]
  have hk' := mem_map_of_mem L.subtype hk
  rw [hZ] at hk'
  rcases mem_zpowers_two hz2 hk' with hh | hh
  · have hh' : y ^ 2 = 1 := Subtype.ext hh
    have hd := orderOf_dvd_of_pow_eq_one hh'
    rw [hy4] at hd
    norm_num at hd
  · exact hh

/-- The cover argument with its sole new model calculation kept explicit.
I.2.2 supplies the two cover facts; the marked quotient fusion must still be
proved for each of the four concrete quotient models. -/
theorem residualFusionWitness_of_quotientFusion
    (h : StandardSetup T z L) (hn : r ∈ normalizer (L : Set G))
    (hr2 : orderOf r = 2) (hout : r ∉ centralizer (L : Set G) ⊔ L)
    (hc : center L = pCore 2 L) (hne : pCore 2 L ≠ ⊥)
    (hbound : Nat.card (center L) ≤ 2) (hd : CommutingSylowDichotomy T z L)
    (hlift : TwoCentralInvolutionLifting L) (hinvert : OuterInvertsFourLift L)
    (hfuse : TwoCentralResidualFusion ((center L).quotientAut (action hn))) :
    ResidualFusionWitness L r := by
  obtain ⟨hZ, hZcard⟩ := center_eq_zpowers h hc hne hbound hd
  obtain ⟨y, hy4, hyq2, _, hyinv⟩ :=
    hinvert _ (action_order_two hn hr2 hout) (action_not_inner hn hout)
  obtain ⟨lbar, vbar, hvbar, hvbar2, hvcentral, hf⟩ := hfuse
  have hp : IsPGroup 2 (center L) := hc.symm ▸ pCore_isPGroup
  obtain ⟨v, hv, hv2, hvq⟩ := lift_residual_involution hZcard hp _ _ hvbar hvbar2
    (hlift _ hvbar2 hvcentral)
  obtain ⟨l, hl⟩ := QuotientGroup.mk'_surjective (center L) lbar
  have hq : QuotientGroup.mk' (center L) (action hn l * l⁻¹) =
      QuotientGroup.mk' (center L) v := by
    rw [map_mul, map_inv, ← quotientAut_apply_mk, hl, hvq, hf]
  have hvR : (v : G) ∈ OuterResidual.involutionResidual L r := by
    rw [← map_fixedTwoResidual_action hn]
    exact mem_map_of_mem L.subtype hv
  have hv1 : (v : G) ≠ 1 := by
    intro he
    have he' : v = 1 := Subtype.ext he
    simp [he'] at hv2
  have hzC : z ∈ centralizer (L : Set G) := by
    intro x hx
    exact mem_centralizer_singleton_iff.mp (h.component.1 hx)
  exact residualFusionWitness_of_inverted_four_element hzC l.property y.property
    ((orderOf_coe y).trans hy4) (square_eq_z h.involution hZ y hy4 hyq2)
    (congrArg Subtype.val hyinv) hvR hv1 (lifted_conjugate_eq hn hr2 h.involution hZ l v hq)


/-- Two-centrality transports along an actual model isomorphism. -/
theorem twoCentral_map {H S : Type*} [Group H] [Group S] [Finite H]
    (e : H ≃* S) {u : H} (hu : TwoCentral u) : TwoCentral (e u) := by
  obtain ⟨P, huP, huC⟩ := hu
  refine ⟨P.mapSurjective (f := e.toMonoidHom) e.surjective, ⟨u, huP, rfl⟩, ?_⟩
  apply mem_center_iff.mpr
  intro x
  obtain ⟨v, hv, hve⟩ := x.property
  apply Subtype.ext
  change (x : S) * e u = e u * (x : S)
  change e v = (x : S) at hve
  rw [← hve, ← e.map_mul, ← e.map_mul]
  exact congrArg e (congrArg Subtype.val (mem_center_iff.mp huC ⟨v, hv⟩))

/-- Fixed residuals, marks, and the conjugation equation all survive transport.
A group-family tag without this equivalence would not suffice. -/
theorem TwoCentralResidualFusion.of_equiv {H S : Type*} [Group H] [Group S] [Finite S]
    (e : H ≃* S) (a : MulAut H) (h : TwoCentralResidualFusion (MulAut.congr e a)) :
    TwoCentralResidualFusion a := by
  have hm : (fixedTwoResidual H a).map e.toMonoidHom =
      fixedTwoResidual S (MulAut.congr e a) := by
    let : Finite H := Finite.of_equiv S e.symm.toEquiv
    have hk : e.toMonoidHom.ker = ⊥ :=
      (MonoidHom.ker_eq_bot_iff e.toMonoidHom).mpr e.injective
    have hp : IsPGroup 2 e.toMonoidHom.ker := hk.symm ▸ IsPGroup.of_bot
    exact MulAut.map_embedded_fixedResidual_of_central_pgroup_ker 2 a
      (MulAut.congr e a) e.toMonoidHom e.surjective (by rw [hk]; exact bot_le) hp
      (fun x => by
        change e (a x) = e (a (e.symm (e x)))
        rw [e.symm_apply_apply])
  obtain ⟨l, v, hv, hv2, hvC, hf⟩ := h
  obtain ⟨w, hw, rfl⟩ := hm.ge hv
  refine ⟨e.symm l, w, hw, ?_, ?_, ?_⟩
  · exact (orderOf_injective e.toMonoidHom e.injective w).symm.trans hv2
  · change TwoCentral (e w) at hvC
    simpa only [e.symm_apply_apply] using twoCentral_map e.symm hvC
  · apply e.injective
    change e (a (e.symm l)) * l⁻¹ = e w at hf
    simpa only [map_mul, map_inv, e.apply_symm_apply] using hf

/-- The complete output of source 16.1.2(2), before excluding any model. -/
def SourceCenterAlternative (H : Type*) [Group H] : Prop :=
  Nat.card (center H) ≤ 2 ∨
    ((Nonempty ((H ⧸ center H) ≃* BenderSuzuki.MatrixGroups.SuzukiMatrixGroup 1) ∨
      ClassicalGroup.IsPSL (H ⧸ center H) 3 4) ∧
      Nonempty (center H ≃* (Multiplicative (ZMod 2) × Multiplicative (ZMod 2)))) ∨
    (Nonempty ((H ⧸ center H) ≃* Sporadic.Mathieu.M22) ∧
      Nonempty (center H ≃* Multiplicative (ZMod 4)))

/-- Actual nonisomorphisms needed to specialize the earlier center alternative. -/
def ExcludesLargeCenterQuotients (S : Type*) [Group S] : Prop :=
  (¬ Nonempty (S ≃* BenderSuzuki.MatrixGroups.SuzukiMatrixGroup 1)) ∧
    (¬ ClassicalGroup.IsPSL S 3 4) ∧ (¬ Nonempty (S ≃* Sporadic.Mathieu.M22))

/-- Model separation specializes the complete earlier center alternative. -/
theorem center_bound_of_model {H S : Type*} [Group H] [Group S]
    (hcent : SourceCenterAlternative H) (e : (H ⧸ center H) ≃* S)
    (hsep : ExcludesLargeCenterQuotients S) : Nat.card (center H) ≤ 2 := by
  rcases hcent with hb | ⟨hs | hl, _⟩ | ⟨hm, _⟩
  · exact hb
  · exact False.elim (hsep.1 (hs.map fun f => e.symm.trans f))
  · exact False.elim (hsep.2.1 (hl.of_mulEquiv e.symm))
  · exact False.elim (hsep.2.2 (hm.map fun f => e.symm.trans f))

/-- A concrete quotient-model calculation plugs into the ambient cover argument.
The input model theorem may use simplicity and perfectness inherited from L. -/
theorem residualFusionWitness_of_model {𝒦 : GroupClass}
    (hG : Hypothesis1611 𝒦 G) (h : IntersectionSetup T z L g R)
    (hr : r ∈ R) (hr2 : orderOf r = 2)
    (hout : r ∉ centralizer (L : Set G) ⊔ L)
    (hne : pCore 2 L ≠ ⊥) (hcent : SourceCenterAlternative L)
    (hd : CommutingSylowDichotomy T z L)
    (hlift : TwoCentralInvolutionLifting L) (hinvert : OuterInvertsFourLift L)
    {S : Type*} [Group S] (e : (L ⧸ pCore 2 L) ≃* S)
    (hseparate : IsSimpleGroup S → Group.IsPerfect S → ExcludesLargeCenterQuotients S)
    (hmodel : IsSimpleGroup S → Group.IsPerfect S →
      ∀ b : MulAut S, orderOf b = 2 → (¬ ∃ s : S, b = MulAut.conj s) →
        TwoCentralResidualFusion b) : ResidualFusionWitness L r := by
  have hc := hG.evenType.component_center_eq_twoCore h.involution h.component
  let ec : (L ⧸ center L) ≃* S := (QuotientGroup.quotientMulEquivOfEq hc).trans e
  let : Finite S := Finite.of_equiv (L ⧸ center L) ec.toEquiv
  let : IsQuasisimple L := h.component.quasisimple
  have hsimple : IsSimpleGroup S := (MulEquiv.isSimpleGroup_congr ec).mp IsQuasisimple.simple
  have hperfect : Group.IsPerfect S := Group.IsPerfect.ofSurjective (f := ec.toMonoidHom) ec.surjective
  let hn := h.sylow_normalizes (h.le_sylow hr)
  let a := action hn
  let b := MulAut.centralQuotientAction ec a
  have hb2 : orderOf b = 2 :=
    (orderOf_injective (MulAut.centralQuotientAction ec)
      (MulAut.centralQuotientAction_injective ec) a).trans (action_order_two hn hr2 hout)
  have hbout : ¬ ∃ s : S, b = MulAut.conj s := by
    intro hi
    exact action_not_inner hn hout ((MulAut.centralQuotientAction_inner_iff ec a).mp hi)
  apply residualFusionWitness_of_quotientFusion h.toStandardSetup hn hr2 hout hc hne
    (center_bound_of_model hcent ec (hseparate hsimple hperfect)) hd hlift hinvert
  exact TwoCentralResidualFusion.of_equiv ec _ (hmodel hsimple hperfect b hb2 hbout)

end CFSG.Quasithin.Chapter16.Intersections.OuterReduction.CoverFusion
