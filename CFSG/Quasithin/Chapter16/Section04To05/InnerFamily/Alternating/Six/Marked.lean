module
public import CFSG.Quasithin.Chapter16.Section04To05.InnerFamily.Alternating.Coordinates
public import Theory.ElementaryAbelian.Quotient
import Mathlib.Tactic
/-!
# The marked elementary sixteen-group in the A₆ argument

Three disjoint transpositions and the independent central involution give an
injective binary-coordinate homomorphism into the supplied, actual LE model.
Its image is elementary abelian of order sixteen, generated by the four marked
elements. The three noncentral generators are conjugate to r under L: an odd
permutation conjugator can be corrected by r to make it even.

The corrected set β is the intersection of the ambient class of z with A.
The binary enumeration proves that pair and triple exclusions leave only the
four generators and their total product. Those exclusions, and the fusion of
the total product, remain explicit inputs here and must be proved in the two
source branches. In particular this module does not put A inside the chosen T;
that requires compatible Sylow choices in the geometric application.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004,
proof of 16.4.9(2), printed p.1192 (PDF p.1209). See SixSetCorrection for the
explicit permutation identity explaining the printed β = zᴳ ∩ T error.
-/

@[expose] public section
namespace CFSG.Quasithin.Chapter16.Intersections.Six
open Equiv Equiv.Perm Subgroup
set_option maxRecDepth 100000
set_option maxHeartbeats 4000000
abbrev Binary := Multiplicative (Fin 4 → ZMod 2)
abbrev Product := Perm (Fin 6) × Multiplicative (ZMod 2)
def coordinateHom : Binary →* Product where
  toFun v := ((if v.toAdd 0 = 0 then 1 else swap 0 1) *
    (if v.toAdd 1 = 0 then 1 else swap 2 3) *
    (if v.toAdd 2 = 0 then 1 else swap 4 5), Multiplicative.ofAdd (v.toAdd 3))
  map_one' := by decide +kernel
  map_mul' := by decide +kernel

theorem coordinateHom_injective : Function.Injective coordinateHom := by decide +kernel

def basis (i : Fin 4) : Binary := Multiplicative.ofAdd (Pi.single i 1)
def totalVector : Binary := Multiplicative.ofAdd (fun _ => 1)
theorem basis_injective : Function.Injective basis := by decide +kernel
theorem basis_ne_one (i : Fin 4) : basis i ≠ 1 := by revert i; decide +kernel
theorem basis_pair_ne_basis (i j k : Fin 4) (hij : i ≠ j) :
    basis i * basis j ≠ basis k := by revert i j k; decide +kernel

theorem vector_exp (v : Binary) : v ^ 2 = 1 := by revert v; decide +kernel
instance binary_elementary : IsElementaryAbelian 2 Binary where
  toIsMulCommutative := inferInstance
  exponent_dvd_p := Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr vector_exp

def partialVector (s : Finset (Fin 4)) : Binary := ∏ i ∈ s, basis i

theorem partialVector_surjective : Function.Surjective partialVector := by decide +kernel

theorem partialVector_injective : Function.Injective partialVector := by decide +kernel

theorem totalVector_eq : totalVector = partialVector Finset.univ := by decide +kernel

theorem coordinateHom_basis_three : coordinateHom (basis 3) = (1, Multiplicative.ofAdd 1) := by
  decide +kernel

variable {G : Type*} [Group G] {L : Subgroup G} {z r : G}
def lift (M : AlternatingProductModel L z r 6) : Product →* G :=
  (AlternatingOvergroup L z r).subtype.comp M.equiv.symm.toMonoidHom

theorem lift_injective (M : AlternatingProductModel L z r 6) : Function.Injective (lift M) :=
  Subtype.val_injective.comp M.equiv.symm.injective

theorem lift_even_mem (M : AlternatingProductModel L z r 6) (k : Perm (Fin 6))
    (hk : k ∈ alternatingGroup (Fin 6)) : lift M (k, 1) ∈ L := by
  change (M.equiv.symm (k, 1) : G) ∈ L
  rw [M.component_iff, M.equiv.apply_symm_apply]
  exact ⟨hk, rfl⟩

def outerPermutation (M : AlternatingProductModel L z r 6) : Perm (Fin 6) :=
  (M.equiv ⟨r, mem_sup_left (mem_sup_right (mem_zpowers r))⟩).1

theorem outerPermutation_cycleType (M : AlternatingProductModel L z r 6) :
    (outerPermutation M).cycleType = {2} :=
  M.outer_cycleType.resolve_right (fun h => by omega)

theorem lift_outer (M : AlternatingProductModel L z r 6) :
    lift M (outerPermutation M, 1) = r := by
  have he : (outerPermutation M, 1) =
      M.equiv ⟨r, mem_sup_left (mem_sup_right (mem_zpowers r))⟩ :=
    Prod.ext rfl M.outer_second.symm
  change (M.equiv.symm (outerPermutation M, 1) : G) = r
  rw [he, M.equiv.symm_apply_apply]

def embedding (M : AlternatingProductModel L z r 6) : Binary →* G :=
  (AlternatingOvergroup L z r).subtype.comp (M.equiv.symm.toMonoidHom.comp coordinateHom)
theorem embedding_injective (M : AlternatingProductModel L z r 6) :
    Function.Injective (embedding M) :=
  Subtype.val_injective.comp (M.equiv.symm.injective.comp coordinateHom_injective)
def elementary (M : AlternatingProductModel L z r 6) : Subgroup G := (embedding M).range
noncomputable def elementaryEquiv (M : AlternatingProductModel L z r 6) : Binary ≃* elementary M :=
  MonoidHom.ofInjective (embedding_injective M)
theorem elementary_card (M : AlternatingProductModel L z r 6) : Nat.card (elementary M) = 16 := by
  rw [← Nat.card_congr (elementaryEquiv M).toEquiv]
  rw [Nat.card_eq_fintype_card]
  decide +kernel
instance elementary_elementary (M : AlternatingProductModel L z r 6) : IsElementaryAbelian 2 (elementary M) :=
  IsElementaryAbelian.of_surjective (elementaryEquiv M).toMonoidHom (elementaryEquiv M).surjective

def generator (M : AlternatingProductModel L z r 6) (i : Fin 4) : G := embedding M (basis i)
noncomputable def alpha (M : AlternatingProductModel L z r 6) : Finset G :=
  by classical exact Finset.univ.image (generator M)
def total (M : AlternatingProductModel L z r 6) : G := embedding M totalVector

theorem generator_three (M : AlternatingProductModel L z r 6) : generator M 3 = z := by
  change (M.equiv.symm (coordinateHom (basis 3)) : G) = z
  rw [coordinateHom_basis_three, ← M.central_image, M.equiv.symm_apply_apply]

theorem generator_injective (M : AlternatingProductModel L z r 6) : Function.Injective (generator M) :=
  (embedding_injective M).comp basis_injective

theorem alpha_card (M : AlternatingProductModel L z r 6) : (alpha M).card = 4 := by
  classical
  rw [alpha, Finset.card_image_of_injective _ (generator_injective M)]
  decide

theorem generator_mem (M : AlternatingProductModel L z r 6) (i : Fin 4) : generator M i ∈ elementary M :=
  ⟨basis i, rfl⟩

theorem elementary_le (M : AlternatingProductModel L z r 6) : elementary M ≤ AlternatingOvergroup L z r := by
  rintro _ ⟨v, rfl⟩
  exact (M.equiv.symm (coordinateHom v)).property

theorem elementary_eq_closure (M : AlternatingProductModel L z r 6) :
    elementary M = closure (alpha M : Set G) := by
  classical
  apply le_antisymm
  · rintro _ ⟨v, rfl⟩
    obtain ⟨s, rfl⟩ := partialVector_surjective v
    induction s using Finset.induction_on with
    | empty => simp [partialVector]
    | @insert i s hi ih =>
      rw [partialVector, Finset.prod_insert hi, map_mul]
      apply mul_mem _ ih
      exact subset_closure (Finset.mem_image.mpr ⟨i, Finset.mem_univ _, rfl⟩)
  · apply (Subgroup.closure_le _).mpr
    intro x hx
    obtain ⟨i, _, rfl⟩ := Finset.mem_image.mp hx
    exact generator_mem M i

theorem generator_ne_one (M : AlternatingProductModel L z r 6) (i : Fin 4) :
    generator M i ≠ 1 := by
  intro h
  exact basis_ne_one i (embedding_injective M (h.trans (map_one (embedding M)).symm))

theorem generator_pair_ne_generator (M : AlternatingProductModel L z r 6)
    (i j k : Fin 4) (hij : i ≠ j) : generator M i * generator M j ≠ generator M k := by
  rw [generator, generator, generator, ← map_mul]
  exact fun h => basis_pair_ne_basis i j k hij (embedding_injective M h)

theorem totalVector_ne_basis (i : Fin 4) : totalVector ≠ basis i := by
  revert i; decide +kernel

theorem total_not_mem_alpha (M : AlternatingProductModel L z r 6) : total M ∉ alpha M := by
  classical
  intro h
  obtain ⟨i, _, hi⟩ := Finset.mem_image.mp h
  exact totalVector_ne_basis i (embedding_injective M hi.symm)

theorem vector_cases (v : Binary) :
    v = 1 ∨ (∃ i, v = basis i) ∨
      (∃ i j, i ≠ j ∧ v = basis i * basis j) ∨
      (∃ i j k, i ≠ j ∧ i ≠ k ∧ j ≠ k ∧ v = basis i * basis j * basis k) ∨
      v = totalVector := by
  revert v; decide +kernel

/-- The corrected marked class, inside the actual elementary subgroup. -/
def beta (M : AlternatingProductModel L z r 6) : Set G :=
  {a | a ∈ elementary M ∧ IsConj z a}

theorem beta_subset (M : AlternatingProductModel L z r 6)
    (hpairs : ∀ i j, i ≠ j → ¬ IsConj z (generator M i * generator M j))
    (htriples : ∀ i j k, i ≠ j → i ≠ k → j ≠ k →
      ¬ IsConj z (generator M i * generator M j * generator M k)) :
    beta M ⊆ (alpha M : Set G) ∪ {total M} := by
  classical
  rintro a ⟨⟨v, rfl⟩, hconj⟩
  rcases vector_cases v with h | ⟨i, h⟩ | ⟨i, j, hij, h⟩ |
    ⟨i, j, k, hij, hik, hjk, h⟩ | h
  · rw [h, map_one] at hconj
    exact (generator_ne_one M 3 (by rw [generator_three]; exact isConj_one_right.mp hconj.symm)).elim
  · left
    exact Finset.mem_image.mpr ⟨i, Finset.mem_univ _, congrArg (embedding M) h.symm⟩
  · exact (hpairs i j hij (by simpa only [h, map_mul, generator] using hconj)).elim
  · exact (htriples i j k hij hik hjk (by simpa only [h, map_mul, generator] using hconj)).elim
  · exact Or.inr (congrArg (embedding M) h)

/-- Odd permutations with one two-cycle are conjugate by an even permutation. -/
theorem exists_even_conjugator {p q : Perm (Fin 6)}
    (hp : p.cycleType = {2}) (hq : q.cycleType = {2}) :
    ∃ k ∈ alternatingGroup (Fin 6), MulAut.conj k p = q := by
  obtain ⟨k, hk⟩ := isConj_iff.mp (isConj_iff_cycleType_eq.mpr (hp.trans hq.symm))
  have hpSign : sign p = -1 := by
    rw [← isSwap_iff_cycleType] at hp
    exact hp.sign_eq
  rcases Int.units_eq_one_or (sign k) with hs | hs
  · exact ⟨k, mem_alternatingGroup.mpr hs, hk⟩
  · refine ⟨k * p, ?_, ?_⟩
    · rw [mem_alternatingGroup, map_mul, hs, hpSign]
      decide
    · change k * p * p * (k * p)⁻¹ = q
      simpa [mul_assoc] using hk


theorem coordinateHom_basis_cycleType (i : Fin 4) (hi : i ≠ 3) :
    (coordinateHom (basis i)).1.cycleType = {2} := by
  revert i; decide +kernel

theorem coordinateHom_basis_second (i : Fin 4) (hi : i ≠ 3) :
    (coordinateHom (basis i)).2 = 1 := by
  revert i; decide +kernel

/-- The noncentral marked generators are conjugates under the actual component. -/
theorem generator_component_conjugate (M : AlternatingProductModel L z r 6)
    (i : Fin 4) (hi : i ≠ 3) :
    ∃ l ∈ L, MulAut.conj l r = generator M i := by
  obtain ⟨k, hk, he⟩ := exists_even_conjugator (outerPermutation_cycleType M)
    (coordinateHom_basis_cycleType i hi)
  refine ⟨lift M (k, 1), lift_even_mem M k hk, ?_⟩
  conv_lhs => arg 2; rw [← lift_outer M]
  change lift M (k, 1) * lift M (outerPermutation M, 1) * (lift M (k, 1))⁻¹ = _
  rw [← map_inv, ← map_mul, ← map_mul]
  change lift M ((k, 1) * (outerPermutation M, 1) * (k, 1)⁻¹) =
    lift M (coordinateHom (basis i))
  apply congrArg (lift M)
  apply Prod.ext
  · exact he
  · simpa using (coordinateHom_basis_second i hi).symm

theorem alpha_subset_beta (M : AlternatingProductModel L z r 6) (hr : IsConj z r) :
    (alpha M : Set G) ⊆ beta M := by
  classical
  intro a ha
  obtain ⟨i, _, rfl⟩ := Finset.mem_image.mp ha
  refine ⟨generator_mem M i, ?_⟩
  by_cases hi : i = 3
  · subst i
    exact (generator_three M).symm ▸ IsConj.refl z
  · obtain ⟨l, _, hl⟩ := generator_component_conjugate M i hi
    exact hr.trans (isConj_iff.mpr ⟨l, hl⟩)

theorem beta_eq_of_total_conjugate (M : AlternatingProductModel L z r 6)
    (hr : IsConj z r)
    (hpairs : ∀ i j, i ≠ j → ¬ IsConj z (generator M i * generator M j))
    (htriples : ∀ i j k, i ≠ j → i ≠ k → j ≠ k →
      ¬ IsConj z (generator M i * generator M j * generator M k))
    (ht : IsConj z (total M)) : beta M = (alpha M : Set G) ∪ {total M} := by
  apply Set.Subset.antisymm (beta_subset M hpairs htriples)
  rintro a (ha | rfl)
  · exact alpha_subset_beta M hr ha
  · exact ⟨⟨totalVector, rfl⟩, ht⟩

theorem beta_card_of_total_conjugate (M : AlternatingProductModel L z r 6)
    (hr : IsConj z r)
    (hpairs : ∀ i j, i ≠ j → ¬ IsConj z (generator M i * generator M j))
    (htriples : ∀ i j k, i ≠ j → i ≠ k → j ≠ k →
      ¬ IsConj z (generator M i * generator M j * generator M k))
    (ht : IsConj z (total M)) : Nat.card (beta M) = 5 := by
  classical
  rw [beta_eq_of_total_conjugate M hr hpairs htriples ht, Set.union_comm,
    ← Set.insert_eq, ← Finset.coe_insert]
  rw [Nat.card_coe_set_eq, Set.ncard_coe_finset,
    Finset.card_insert_of_notMem (total_not_mem_alpha M), alpha_card]

end CFSG.Quasithin.Chapter16.Intersections.Six
