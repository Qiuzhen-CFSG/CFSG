module

public import Mathlib.GroupTheory.SpecificGroups.Alternating

/-!
# The marked set in the A₆ fusion argument

Printed p.1192 defines β as zᴳ ∩ T and then asserts β = α ∪ {t} ⊆ A.
The five-point action needs β = zᴳ ∩ A. The printed T cannot be used in
that local calculation: (01)(23)(45) is A₆-conjugate to (02)(13)(45).
Both belong to the usual Sylow subgroup generated by the three disjoint
swaps and (02)(13), but the second does not belong to the abelian subgroup
generated by the disjoint swaps. Multiplying both by the central z preserves
this conjugacy and the failure of containment in A.

The explicit identities below certify the permutation calculation behind
this correction. The last lemma keeps membership in an ambient subgroup
and centralization by the marked abelian subgroup as explicit hypotheses;
applying it to the chapter's T still requires constructing its model.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004,
proof of 16.4.9(2), printed p.1192 (PDF p.1209).
-/

@[expose] public section

namespace CFSG.Quasithin.Chapter16.Intersections.SixSetCorrection

open Equiv Equiv.Perm Subgroup

/-- The product of the three source disjoint transpositions. -/
def disjointTriple : Perm (Fin 6) := swap 0 1 * swap 2 3 * swap 4 5

/-- The interchange of the first two pairs in the usual Sylow subgroup. -/
def blockSwap : Perm (Fin 6) := swap 0 2 * swap 1 3

/-- A second triple transposition in that Sylow subgroup. -/
def crossingTriple : Perm (Fin 6) := blockSwap * swap 4 5

/-- A three-cycle transporting the disjoint triple to the crossing triple. -/
def evenConjugator : Perm (Fin 6) := swap 1 2 * swap 2 3

theorem evenConjugator_mem : evenConjugator ∈ alternatingGroup (Fin 6) := by
  rw [mem_alternatingGroup]
  decide +kernel

theorem triple_conjugation : MulAut.conj evenConjugator disjointTriple = crossingTriple := by
  decide +kernel

theorem crossingTriple_not_commute : ¬ Commute crossingTriple (swap 0 1) := by
  change crossingTriple * swap 0 1 ≠ swap 0 1 * crossingTriple
  decide +kernel

/-- The triple-transposition class has a member outside the marked abelian
subgroup whenever the overgroup contains the indicated Sylow generators. -/
theorem exists_conjugate_outside_marked {T A : Subgroup (Perm (Fin 6))}
    (hb : blockSwap ∈ T) (h45 : swap 4 5 ∈ T)
    (hA : A ≤ centralizer ({swap 0 1} : Set (Perm (Fin 6)))) :
    ∃ u ∈ T, u ∉ A ∧ ∃ k : alternatingGroup (Fin 6),
      MulAut.conj (k : Perm (Fin 6)) disjointTriple = u := by
  refine ⟨crossingTriple, T.mul_mem hb h45, ?_, ⟨evenConjugator, evenConjugator_mem⟩,
    triple_conjugation⟩
  intro hu
  exact crossingTriple_not_commute (mem_centralizer_singleton_iff.mp (hA hu))

end CFSG.Quasithin.Chapter16.Intersections.SixSetCorrection
