module
public import CFSG.Quasithin.Chapter16.Section04To05.InnerFamily.GraphField.ModelData
public import CFSG.Quasithin.Chapter16.Section04To05.InnerFamily.GraphField.NormalizerModels.Marking
public import CFSG.Quasithin.Chapter16.Section04To05.InnerFamily.GraphField.NormalizerModels.DoubleCoverConstruction
public import Theory.SpecificGroups.PSL3Four.CentralCover.InnerFamilyNormalizer.DoubleCover.QuaternionLift

/-!
# The covered quaternion normalizer and its transvection

Lift the concrete projective quaternion subgroup through the marked covering
of the actual component L, embed it back in G, and adjoin E = ⟨r,z⟩.
The projective fixed-group decomposition gives N_LE(E) = DQ. Its faithful
quaternion action on the residual image gives C_Q(D) = E. The restricted
covering has kernel E ∩ P, so the second isomorphism theorem identifies the
relative quotient Q/E with Q₈. Surjectivity of the lifted displacement
supplies t ∈ Q conjugating r to rz; all of Q fixes z.

`sourceLocalNormalizerData` constructs these witnesses from the standing
source hypotheses, the exact E₉ residual input of 16.1.4(5), and the
involution-lifting clause of I.2.2(3b). The cyclic-four centralizer quotient
and its irreducibility remain further obligations of the double-cover
assembly. No ambient residual-fixer field is assumed or constructed here.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004,
16.4.9(2), printed p.1191, and I.2.2(3b), printed pp.409–410.
-/

@[expose] public section
noncomputable section
open Subgroup Theory.GroupTheory
open scoped Pointwise
namespace CFSG.Quasithin.Chapter16.Intersections.GraphField.NormalizerModels.DoubleCoverConstruction
open Matrix.PSL3Four ExtendedCentralizer.ProjectiveFixer
open InnerFamilyNormalizer.DoubleCover
variable {G : Type*} [Group G] [Finite G]
variable {T : Sylow 2 G} {z g r : G} {L R : Subgroup G}

/-- The quaternion inverse image embedded through the original component. -/
def componentQuaternion (d : MarkedCover L r) : Subgroup G :=
  (quaternionPreimage d.cover).map L.subtype

/-- The actual candidate Q is generated by that inverse image and E. -/
def localQuaternion (d : MarkedCover L r) (z : G) : Subgroup G :=
  componentQuaternion d ⊔ fourGroup r z

omit [Finite G] in
theorem componentQuaternion_le_component (d : MarkedCover L r) :
    componentQuaternion d ≤ L := map_subtype_le _

omit [Finite G] in
theorem componentQuaternion_two (d : MarkedCover L r) :
    IsPGroup 2 (componentQuaternion d) :=
  (quaternionPreimage_two d.cover d.kernel_two).map L.subtype

theorem componentQuaternion_normalizes_four (h : IntersectionSetup T z L g R)
    (hr : r ∈ R) (hr2 : orderOf r = 2) (hout : r ∉ centralizer (L : Set G) ⊔ L)
    (hZ : (center L).map L.subtype = zpowers z) (d : MarkedCover L r) :
    componentQuaternion d ≤ normalizer (fourGroup r z : Set G) := by
  rintro x ⟨y, hy, rfl⟩
  have hf := quaternionPreimage_le_fixed d.cover hy
  change y ∈ graphField.fixedSubgroup.comap d.cover.toMonoidHom at hf
  rw [← component_normalizer_eq_preimage h hr hr2 hout hZ d] at hf
  exact hf

theorem localQuaternion_normalizes_four (h : IntersectionSetup T z L g R)
    (hr : r ∈ R) (hr2 : orderOf r = 2) (hout : r ∉ centralizer (L : Set G) ⊔ L)
    (hZ : (center L).map L.subtype = zpowers z) (d : MarkedCover L r) :
    localQuaternion d z ≤ normalizer (fourGroup r z : Set G) :=
  sup_le (componentQuaternion_normalizes_four h hr hr2 hout hZ d) (fourGroup r z).le_normalizer

omit [Finite G] in
theorem localQuaternion_le_product (d : MarkedCover L r) :
    localQuaternion d z ≤ L ⊔ fourGroup r z :=
  sup_le_sup_right (componentQuaternion_le_component d) _

theorem localQuaternion_two (h : IntersectionSetup T z L g R)
    (hr : r ∈ R) (hr2 : orderOf r = 2) (hout : r ∉ centralizer (L : Set G) ⊔ L)
    (hZ : (center L).map L.subtype = zpowers z) (d : MarkedCover L r) :
    IsPGroup 2 (localQuaternion d z) := by
  let := (fourGroup_elementary_card h hr hr2 hout).1
  exact (componentQuaternion_two d).to_sup_of_normal_right'
    (IsElementaryAbelian.isPGroup 2 (fourGroup r z))
    (componentQuaternion_normalizes_four h hr hr2 hout hZ d)

theorem localQuaternion_normalizes_residual (h : IntersectionSetup T z L g R)
    (hr : r ∈ R) (hr2 : orderOf r = 2) (hout : r ∉ centralizer (L : Set G) ⊔ L)
    (hZ : (center L).map L.subtype = zpowers z) (d : MarkedCover L r) :
    localQuaternion d z ≤ normalizer (residual L r : Set G) :=
  (le_inf (localQuaternion_le_product d)
    (localQuaternion_normalizes_four h hr hr2 hout hZ d)).trans
      (normalizer_normalizes_residual h hr)

omit [Finite G] in
theorem center_le_componentQuaternion (d : MarkedCover L r) :
    (center L).map L.subtype ≤ componentQuaternion d := by
  apply map_mono
  rw [← d.kernel_center]
  exact ker_le_comap d.cover.toMonoidHom InnerFamilyNormalizer.Centerless.quaternion

theorem localQuaternion_normalizer_eq (h : IntersectionSetup T z L g R)
    (hr : r ∈ R) (hr2 : orderOf r = 2) (hout : r ∉ centralizer (L : Set G) ⊔ L)
    (hZ : (center L).map L.subtype = zpowers z) (d : MarkedCover L r) :
    (L ⊔ fourGroup r z) ⊓ normalizer (fourGroup r z : Set G) =
      residual L r ⊔ localQuaternion d z := by
  rw [normalizer_eq_preimage_sup h hr hr2 hout hZ d]
  change (fixedPreimage d.cover).map L.subtype ⊔ zpowers r = _
  rw [fixedPreimage_eq_sup d.cover _ d.residual_image, Subgroup.map_sup,
    map_subgroupOf_eq_of_le ((residual_le_centralizer L r).trans inf_le_left)]
  have hzP : zpowers z ≤ componentQuaternion d := hZ ▸ center_le_componentQuaternion d
  change (residual L r ⊔ componentQuaternion d) ⊔ zpowers r =
    residual L r ⊔ (componentQuaternion d ⊔ (zpowers r ⊔ zpowers z))
  rw [← sup_assoc (componentQuaternion d), sup_eq_left.mpr (hzP.trans le_sup_left), sup_assoc]

omit [Finite G] in
theorem componentQuaternion_inf_centralizer
    (hZ : (center L).map L.subtype = zpowers z) (d : MarkedCover L r) :
    componentQuaternion d ⊓ centralizer (residual L r : Set G) ≤ zpowers z := by
  rintro x ⟨⟨y, hy, rfl⟩, hx⟩
  have hc : d.cover.toMonoidHom y ∈ centralizer (model : Set PSL) := by
    intro m hm
    obtain ⟨w, hw, rfl⟩ := d.residual_image.symm ▸ hm
    have hh : w * y = y * w := Subtype.ext (hx w hw)
    simpa only [map_mul] using congrArg d.cover.toMonoidHom hh
  have hz : y ∈ center L := by
    rw [← d.kernel_center, MonoidHom.mem_ker]
    exact mem_bot.mp (InnerFamilyNormalizer.Centerless.quaternion_inf_centralizer_model.le ⟨hy, hc⟩)
  rw [← hZ]
  exact mem_map_of_mem L.subtype hz

theorem localQuaternion_centralizer_eq (h : IntersectionSetup T z L g R)
    (hr : r ∈ R) (hr2 : orderOf r = 2) (hout : r ∉ centralizer (L : Set G) ⊔ L)
    (hZ : (center L).map L.subtype = zpowers z) (d : MarkedCover L r) :
    localQuaternion d z ⊓ centralizer (residual L r : Set G) = fourGroup r z := by
  have hED : fourGroup r z ≤ centralizer (residual L r : Set G) :=
    le_centralizer_iff.mp (residual_le_fourGroup_centralizer h)
  apply le_antisymm
  · intro x hx
    have hp : x ∈ (componentQuaternion d : Set G) * (fourGroup r z : Set G) := by
      rw [← coe_mul_of_left_le_normalizer_right _ _
        (componentQuaternion_normalizes_four h hr hr2 hout hZ d)]
      exact hx.1
    obtain ⟨p, hp, e, he, rfl⟩ := hp
    have hpc : p ∈ centralizer (residual L r : Set G) := by
      have hh := (centralizer (residual L r : Set G)).mul_mem hx.2 (hED ((fourGroup r z).inv_mem he))
      simpa only [mul_inv_cancel_right] using hh
    exact (fourGroup r z).mul_mem
      (mem_sup_right (componentQuaternion_inf_centralizer hZ d ⟨hp, hpc⟩)) he
  · exact le_inf le_sup_right hED

/-- Restrict the original projective covering to the embedded quaternion inverse image. -/
def componentProjection (d : MarkedCover L r) :
    componentQuaternion d →* InnerFamilyNormalizer.Centerless.quaternion :=
  (quaternionProjection d.cover).comp
    ((quaternionPreimage d.cover).equivMapOfInjective L.subtype L.subtype_injective).symm.toMonoidHom

omit [Finite G] in
theorem componentProjection_surjective (d : MarkedCover L r) :
    Function.Surjective (componentProjection d) :=
  (quaternionProjection_surjective d.cover).comp
    ((quaternionPreimage d.cover).equivMapOfInjective L.subtype L.subtype_injective).symm.surjective

omit [Finite G] in
@[simp] theorem componentProjection_apply (d : MarkedCover L r) (x : quaternionPreimage d.cover) :
    componentProjection d ⟨(x : L), mem_map_of_mem L.subtype x.property⟩ =
      quaternionProjection d.cover x := by
  change quaternionProjection d.cover
    (((quaternionPreimage d.cover).equivMapOfInjective L.subtype L.subtype_injective).symm
      (((quaternionPreimage d.cover).equivMapOfInjective L.subtype L.subtype_injective) x)) = _
  rw [MulEquiv.symm_apply_apply]

theorem componentProjection_kernel (h : IntersectionSetup T z L g R)
    (hr : r ∈ R) (hr2 : orderOf r = 2) (hout : r ∉ centralizer (L : Set G) ⊔ L)
    (hZ : (center L).map L.subtype = zpowers z) (d : MarkedCover L r) :
    (componentProjection d).ker = (fourGroup r z).subgroupOf (componentQuaternion d) := by
  ext x
  obtain ⟨y, hy, he⟩ := x.property
  have hx : x = ⟨(y : G), mem_map_of_mem L.subtype hy⟩ := Subtype.ext he.symm
  rw [hx, MonoidHom.mem_ker, componentProjection_apply d ⟨y, hy⟩, Subtype.ext_iff]
  change d.cover.toMonoidHom y = 1 ↔ (y : G) ∈ fourGroup r z
  rw [← MonoidHom.mem_ker, d.kernel_center]
  constructor
  · intro hyZ
    exact mem_sup_right (hZ ▸ mem_map_of_mem L.subtype hyZ)
  · intro hyE
    have hyz := (four_inter_component h hr hr2 hout hZ).le ⟨y.property, hyE⟩
    rw [← hZ] at hyz
    obtain ⟨w, hw, he⟩ := hyz
    exact (Subtype.ext he : w = y) ▸ hw

/-- The quotient is by E restricted to Q, and is the concrete Q₈. -/
theorem localQuaternion_quotient (h : IntersectionSetup T z L g R)
    (hr : r ∈ R) (hr2 : orderOf r = 2) (hout : r ∉ centralizer (L : Set G) ⊔ L)
    (hZ : (center L).map L.subtype = zpowers z) (d : MarkedCover L r) :
    letI : ((fourGroup r z).subgroupOf (localQuaternion d z)).Normal :=
      normal_subgroupOf_of_le_normalizer (localQuaternion_normalizes_four h hr hr2 hout hZ d)
    Nonempty (((localQuaternion d z) ⧸ (fourGroup r z).subgroupOf (localQuaternion d z)) ≃*
      QuaternionGroup 2) := by
  let hPN := componentQuaternion_normalizes_four h hr hr2 hout hZ d
  let : ((fourGroup r z).subgroupOf (componentQuaternion d)).Normal :=
    normal_subgroupOf_of_le_normalizer hPN
  let : ((fourGroup r z).subgroupOf (componentQuaternion d ⊔ fourGroup r z)).Normal :=
    normal_subgroupOf_sup_of_le_normalizer hPN
  let e := QuotientGroup.quotientInfEquivProdNormalizerQuotient (componentQuaternion d) (fourGroup r z) hPN
  obtain ⟨eB⟩ := InnerFamilyNormalizer.Centerless.quaternion_equiv
  exact ⟨e.symm.trans ((QuotientGroup.quotientMulEquivOfEq
    (componentProjection_kernel h hr hr2 hout hZ d).symm).trans
      ((QuotientGroup.quotientKerEquivOfSurjective (componentProjection d)
        (componentProjection_surjective d)).trans eB))⟩

/-- Surjective central displacement gives the actual transvection r ↦ rz. -/
theorem localQuaternion_transvection (h : IntersectionSetup T z L g R)
    (hr : r ∈ R) (hr2 : orderOf r = 2)
    (hZ : (center L).map L.subtype = zpowers z) (d : MarkedCover L r)
    (hcard : Nat.card (center L) = 2)
    (hlift : NontrivialDisplacement.InvolutionLifting d.cover) :
    ∃ t ∈ localQuaternion d z, MulAut.conj t r = r * z := by
  obtain ⟨zL, hzL, hz⟩ := (show z ∈ (center L).map L.subtype by rw [hZ]; exact mem_zpowers z)
  let a := L.normalizerMonoidHom ⟨r, d.actor_mem⟩
  have ha2 : a ^ 2 = 1 := by
    change (L.normalizerMonoidHom ⟨r, d.actor_mem⟩) ^ 2 = 1
    rw [← map_pow]
    have hrn : (⟨r, d.actor_mem⟩ : normalizer (L : Set G)) ^ 2 = 1 :=
      Subtype.ext (hr2 ▸ pow_orderOf_eq_one r)
    rw [hrn, map_one]
  obtain ⟨x, hx⟩ := quaternion_displacement_surjective d.cover a d.compatible
    d.kernel_center hcard ha2 hlift ⟨zL, hzL⟩
  have hxz : (((displacement d.cover a d.compatible
      (inclusion (quaternionPreimage_le_fixed d.cover) x) : center L) : L) : G) = z := by
    exact (congrArg (fun w : center L => ((w : L) : G)) hx).trans hz
  refine ⟨((x : L) : G), mem_sup_left (mem_map_of_mem L.subtype x.property), ?_⟩
  calc
    _ = (((displacement d.cover a d.compatible
      (inclusion (quaternionPreimage_le_fixed d.cover) x) : center L) : L) : G)⁻¹ * r :=
        displacement_conjugates_actor d (inclusion (quaternionPreimage_le_fixed d.cover) x)
    _ = r * z := by
      rw [hxz]
      have hz2 : z ^ 2 = 1 := h.involution ▸ pow_orderOf_eq_one z
      have hzinv : z⁻¹ = z := inv_eq_of_mul_eq_one_right (by simpa only [pow_two] using hz2)
      rw [hzinv]
      exact (mem_centralizer_singleton_iff.mp (h.sylow_centralizes (h.le_sylow hr))).symm

/-- All normalizer witnesses for the double-cover branch, before adjoining the
independently owned ambient residual-fixer bound and cyclic-four action. -/
structure LocalNormalizerData (L : Subgroup G) (r z : G) where
  Q : Subgroup G
  two_group : IsPGroup 2 Q
  four_le : fourGroup r z ≤ Q
  le_product : Q ≤ L ⊔ fourGroup r z
  normalizes_four : Q ≤ normalizer (fourGroup r z : Set G)
  normalizes_residual : Q ≤ normalizer (residual L r : Set G)
  normalizer_eq : (L ⊔ fourGroup r z) ⊓ normalizer (fourGroup r z : Set G) = residual L r ⊔ Q
  centralizer_eq : Q ⊓ centralizer (residual L r : Set G) = fourGroup r z
  quotient_quaternion :
    letI : ((fourGroup r z).subgroupOf Q).Normal :=
      normal_subgroupOf_of_le_normalizer normalizes_four
    Nonempty ((Q ⧸ (fourGroup r z).subgroupOf Q) ≃* QuaternionGroup 2)
  fixes_z : Q ≤ centralizer ({z} : Set G)
  transvection : ∃ t ∈ Q, MulAut.conj t r = r * z

/-- Construct the actual normalizer and transvection from a compatible marked cover. -/
def localNormalizerData (h : IntersectionSetup T z L g R)
    (hr : r ∈ R) (hr2 : orderOf r = 2) (hout : r ∉ centralizer (L : Set G) ⊔ L)
    (hZ : (center L).map L.subtype = zpowers z) (d : MarkedCover L r)
    (hcard : Nat.card (center L) = 2)
    (hlift : NontrivialDisplacement.InvolutionLifting d.cover) : LocalNormalizerData L r z where
  Q := localQuaternion d z
  two_group := localQuaternion_two h hr hr2 hout hZ d
  four_le := le_sup_right
  le_product := localQuaternion_le_product d
  normalizes_four := localQuaternion_normalizes_four h hr hr2 hout hZ d
  normalizes_residual := localQuaternion_normalizes_residual h hr hr2 hout hZ d
  normalizer_eq := localQuaternion_normalizer_eq h hr hr2 hout hZ d
  centralizer_eq := localQuaternion_centralizer_eq h hr hr2 hout hZ d
  quotient_quaternion := localQuaternion_quotient h hr hr2 hout hZ d
  fixes_z := (localQuaternion_le_product d).trans (product_le_centralizer_z h hr)
  transvection := localQuaternion_transvection h hr hr2 hZ d hcard hlift

/-- The permitted 16.1.4(5) and I.2.2(3b) inputs construct every normalizer
field and the transvection; the cyclic-four action is a further obligation. -/
def sourceLocalNormalizerData {𝒦 : GroupClass}
    (hG : Hypothesis1611 𝒦 G) (h : IntersectionSetup T z L g R)
    (hr : r ∈ R) (hr2 : orderOf r = 2) (hout : r ∉ centralizer (L : Set G) ⊔ L)
    (hTC : commutingSylow T L = zpowers z) (hcore : pCore 2 L ≠ ⊥)
    (hmodel : IsL3FourGraphField L r)
    (hD : IsElementaryAbelian 3 (residual L r)) (h9 : Nat.card (residual L r) = 9)
    (hlift : NontrivialDisplacement.InvolutionLifting (markedCover hG h hmodel hD h9).cover) :
    LocalNormalizerData L r z := by
  have hcenter := hG.evenType.component_center_eq_twoCore h.involution h.component
  exact localNormalizerData h hr hr2 hout
    (center_eq_zpowers_of_nontrivial_core h hTC hcenter hcore) (markedCover hG h hmodel hD h9)
    (center_card_two h hTC hcenter hcore) hlift

end CFSG.Quasithin.Chapter16.Intersections.GraphField.NormalizerModels.DoubleCoverConstruction
