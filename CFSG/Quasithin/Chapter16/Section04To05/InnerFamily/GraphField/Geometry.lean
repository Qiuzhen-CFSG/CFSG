module

public import CFSG.Quasithin.Chapter16.Section04To05.InnerFamily.Cases
public import CFSG.Quasithin.Chapter16.Section04To05.InnerFamily.EmptyCase
public import CFSG.Quasithin.Chapter16.Section04To05.InnerFamily.Transport
public import CFSG.Quasithin.Chapter16.Section04To05.InnerFamily.Elementary
public import Theory.GroupTheory.PrimeRankFixedJoin
public import Theory.GroupTheory.SylowNormalizerConjugate

/-!
# Marked four-group and source choices for the graph-field branch

The actual group E is generated by r and z. The centrality of z in T and
r outside C_G(L)L prove that E is elementary abelian of order four.
Conjugation inside N_G(L) arranges that N_T(R) is Sylow in N_H(R), without
changing T, z or L. The graph-field quotient identification is transported
through the induced automorphism of L/O₂(L).

Sylow conjugacy in H′ constructs a representative g for the same K′ and L′
with N_T(K′) ≤ T^g. When T_C = ⟨z⟩ this implies z^g = r. It does not assert
that g swaps r and z, or that it normalizes E.

These are preparatory deductions for Aschbacher–Smith 16.4.9(2), combined
manuscript of 1 March 2004, printed pp.1191–1192, using 16.4.2(4), p.1183.
The intrinsic quaternion normalizer and both exceptional contradictions
remain separate obligations.
-/

@[expose] public section

open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter16.Intersections.GraphField

variable {G : Type*} [Group G] [Finite G]
variable {T : Sylow 2 G} {z g r : G} {L R : Subgroup G}

/-- The actual source four-group ⟨r,z⟩, not an independently chosen carrier. -/
def fourGroup (r z : G) : Subgroup G := zpowers r ⊔ zpowers z

/-- The distinguished involution centralizes the actual component. -/
theorem central_involution_mem_centralizer (h : IntersectionSetup T z L g R) :
    z ∈ centralizer (L : Set G) := by
  intro x hx
  exact mem_centralizer_singleton_iff.mp (h.component.1 hx)

/-- Both marked generators belong to the chosen Sylow subgroup. -/
theorem fourGroup_le_sylow (h : IntersectionSetup T z L g R) (hr : r ∈ R) :
    fourGroup r z ≤ (T : Subgroup G) :=
  sup_le (zpowers_le.mpr (h.le_sylow hr)) (zpowers_le.mpr h.mem_sylow)

/-- The outside-product hypothesis makes the two commuting involutions independent. -/
theorem fourGroup_elementary_card (h : IntersectionSetup T z L g R)
    (hr : r ∈ R) (hr2 : orderOf r = 2)
    (hout : r ∉ centralizer (L : Set G) ⊔ L) :
    IsElementaryAbelian 2 (fourGroup r z) ∧ Nat.card (fourGroup r z) = 4 := by
  let : IsElementaryAbelian 2 (zpowers z) :=
    IsElementaryAbelian.zpowers_of_pow_eq_one (h.involution ▸ pow_orderOf_eq_one z)
  have hrout : r ∉ zpowers z := by
    intro hh
    exact hout (mem_sup_left ((zpowers_le.mpr (central_involution_mem_centralizer h)) hh))
  have hzcomm : Commute z r :=
    (mem_centralizer_singleton_iff.mp (h.sylow_centralizes (h.le_sylow hr))).symm
  have hfix : zpowers z ≤ centralizer ({r} : Set G) :=
    zpowers_le.mpr (mem_centralizer_singleton_iff.mpr hzcomm.eq)
  have hh := IsElementaryAbelian.fixed_join_card (zpowers z) r hr2
    ((zpowers z).disjoint_zpowers_of_prime_order_not_mem r hr2 hrout) hfix
    (show Nat.card (zpowers z) = 2 ^ 1 by rw [Nat.card_zpowers, h.involution]; rfl)
  rw [fourGroup, sup_comm]
  exact hh

/-- Construct source 16.4.2(4), retaining both K′ and its attached component L′. -/
theorem exists_compatible_conjugator (h : IntersectionSetup T z L g R) :
    ∃ a : G, (centralizer (L : Set G)).conjBy a =
        (centralizer (L : Set G)).conjBy g ∧
      L.conjBy a = L.conjBy g ∧
      (T : Subgroup G) ⊓ normalizer ((centralizer (L : Set G)).conjBy g : Set G) ≤
        (T : Subgroup G).conjBy a := by
  let J := (centralizer (L : Set G)).conjBy g
  let H := normalizer (J : Set G)
  let U := T.mapSurjective (f := (MulAut.conj g).toMonoidHom) (MulAut.conj g).surjective
  have hTN : (T : Subgroup G) ≤ normalizer (centralizer (L : Set G) : Set G) :=
    h.normalizers_eq ▸ h.sylow_normalizes
  have hUH : (U : Subgroup G) ≤ H := by
    change (T : Subgroup G).map (MulAut.conj g).toMonoidHom ≤ _
    have hh := map_mono (f := (MulAut.conj g).toMonoidHom) hTN
    rwa [map_equiv_normalizer_eq] at hh
  have hSU : SylowIn (U : Subgroup G) H :=
    ⟨U.subtype hUH, map_subgroupOf_eq_of_le hUH⟩
  have hp : IsPGroup 2 ((T : Subgroup G).subgroupOf H) :=
    T.isPGroup'.comap_of_injective H.subtype H.subtype_injective
  obtain ⟨S, hS⟩ := hp.exists_le_sylow
  have hSS : SylowIn ((S : Subgroup H).map H.subtype) H := ⟨S, rfl⟩
  obtain ⟨y, hy, he⟩ := hSU.exists_conjugator hSS
  have hJy : J.conjBy y = J := mem_normalizer_iff_map_conj_eq.mp hy
  have hJnew : (centralizer (L : Set G)).conjBy (y * g) = J := by
    rw [← conjBy_conjBy]
    exact hJy
  refine ⟨y * g, hJnew, h.toStandardSetup.component_conjugate_eq hJnew, ?_⟩
  have hle := map_mono (f := H.subtype) hS
  rw [subgroupOf_map_subtype, ← he] at hle
  change (T : Subgroup G) ⊓ H ≤ ((T : Subgroup G).conjBy g).conjBy y at hle
  simpa only [conjBy_conjBy] using hle

/-- The source transport choice identifies the conjugate of z with the specified r. -/
theorem compatible_conjugator_sends_z (h : IntersectionSetup T z L g R)
    (hTC : commutingSylow T L = zpowers z)
    (htransport : (T : Subgroup G) ⊓
        normalizer ((centralizer (L : Set G)).conjBy g : Set G) ≤
      (T : Subgroup G).conjBy g)
    (hr : r ∈ R) (hr2 : orderOf r = 2) : MulAut.conj g z = r := by
  classical
  have hrJ : r ∈ (centralizer (L : Set G)).conjBy g := (h.sylow.le hr).1
  have hrTg : r ∈ (T : Subgroup G).conjBy g :=
    htransport ⟨h.le_sylow hr, ((centralizer (L : Set G)).conjBy g).le_normalizer hrJ⟩
  have hm : r ∈ (commutingSylow T L).conjBy g := by
    change r ∈ ((T : Subgroup G) ⊓ centralizer (L : Set G)).map (MulAut.conj g).toMonoidHom
    rw [map_inf _ _ _ (MulAut.conj g).injective]
    exact ⟨hrTg, hrJ⟩
  rw [hTC] at hm
  obtain ⟨x, hx, hxr⟩ := hm
  obtain ⟨n, hn, hnx⟩ := Finset.mem_image.mp (mem_zpowers_iff_mem_range_orderOf.mp hx)
  have hn2 : n < 2 := by simpa only [Finset.mem_range, h.involution] using hn
  rcases (show n = 0 ∨ n = 1 by omega) with rfl | rfl
  · have hr1 : r = 1 := by simpa [← hnx] using hxr.symm
    simp [hr1] at hr2
  · have hxz : x = z := by simpa using hnx.symm
    exact hxz ▸ hxr

/-- Choose a conjugate of R whose normalizer in T is Sylow in its normalizer in H. -/
theorem exists_saturated_intersection (h : IntersectionSetup T z L g R) :
    ∃ n ∈ normalizer (L : Set G),
      IntersectionSetup T z L (n * g) (R.conjBy n) ∧
      SylowIn ((T : Subgroup G) ⊓ normalizer (R.conjBy n : Set G))
        (normalizer (L : Set G) ⊓ normalizer (R.conjBy n : Set G)) := by
  let H := normalizer (L : Set G)
  obtain ⟨n, hn, hindex⟩ := T.exists_conjugate_normalizer_not_dvd_relIndex H R
    h.sylow_normalizes
  let N := H ⊓ normalizer (R.conjBy n : Set G)
  have hp : IsPGroup 2 ((T : Subgroup G).subgroupOf N) :=
    T.isPGroup'.comap_of_injective N.subtype N.subtype_injective
  let S : Sylow 2 N := hp.toSylow hindex
  have hRnH : R.conjBy n ≤ H := by
    have hh := map_mono (f := (MulAut.conj n).toMonoidHom)
      (h.le_sylow.trans h.sylow_normalizes)
    have hNH : H.conjBy n = H := mem_normalizer_iff_map_conj_eq.mp (H.le_normalizer hn)
    exact hNH ▸ hh
  have hRnN : R.conjBy n ≤ N := le_inf hRnH (R.conjBy n).le_normalizer
  let : ((R.conjBy n).subgroupOf N).Normal :=
    normal_subgroupOf_of_le_normalizer inf_le_right
  have hps : IsPGroup 2 ((R.conjBy n).subgroupOf N) :=
    (h.sylow.isPGroup.map (MulAut.conj n).toMonoidHom).comap_of_injective
      N.subtype N.subtype_injective
  have hRnT : R.conjBy n ≤ (T : Subgroup G) := by
    have hh := map_mono (f := N.subtype) (hps.le_sylow_of_normal S)
    rw [map_subgroupOf_eq_of_le hRnN] at hh
    apply hh.trans
    change ((T : Subgroup G).subgroupOf N).map N.subtype ≤ _
    rw [subgroupOf_map_subtype]
    exact inf_le_left
  have hnL : L.conjBy n = L := mem_normalizer_iff_map_conj_eq.mp hn
  have hnK : (centralizer (L : Set G)).conjBy n = centralizer (L : Set G) :=
    mem_normalizer_iff_map_conj_eq.mp (h.normalizers_eq ▸ hn)
  refine ⟨n, hn, ?_, ?_⟩
  · refine { toStandardSetup := h.toStandardSetup, mem_delta := ?_, sylow := ?_,
             le_sylow := hRnT }
    · have hd := mem_delta_map h.mem_delta (MulAut.conj n)
      change ((centralizer (L : Set G)).conjBy g).conjBy n ∈ delta (L.conjBy n) at hd
      simpa only [conjBy_conjBy, hnL] using hd
    · have hs := h.sylow.map (MulAut.conj n)
      rw [map_inf _ _ _ (MulAut.conj n).injective, map_equiv_normalizer_eq] at hs
      change SylowIn (R.conjBy n) (((centralizer (L : Set G)).conjBy g).conjBy n ⊓
        normalizer ((centralizer (L : Set G)).conjBy n : Set G)) at hs
      simpa only [conjBy_conjBy, hnK] using hs
  · refine ⟨S, ?_⟩
    change ((T : Subgroup G).subgroupOf N).map N.subtype = _
    rw [subgroupOf_map_subtype]
    change (T : Subgroup G) ⊓ (H ⊓ _) = _
    rw [← inf_assoc, inf_eq_left.mpr h.sylow_normalizes]

omit [Finite G] in
/-- Repositioning the actor in N_G(L) preserves its actual graph-field quotient model. -/
theorem graphField_conj_of_normalizes {n : G}
    (hmodel : IsL3FourGraphField L r) (hn : n ∈ normalizer (L : Set G)) :
    IsL3FourGraphField L (MulAut.conj n r) := by
  obtain ⟨hrN, e, he⟩ := hmodel
  have hnr : MulAut.conj n r ∈ normalizer (L : Set G) :=
    (normalizer (L : Set G)).mul_mem
      ((normalizer (L : Set G)).mul_mem hn hrN)
      ((normalizer (L : Set G)).inv_mem hn)
  let a := L.normalizerMonoidHom ⟨n, hn⟩
  let q := QuotientGroup.mk' (pCore 2 L)
  let b := QuotientGroup.congr (pCore 2 L) (pCore 2 L) a.symm
    (pCore_map_iso 2 a.symm)
  refine ⟨hnr, b.trans e, ?_⟩
  intro x
  change e (q (a.symm (L.normalizerMonoidHom ⟨MulAut.conj n r, hnr⟩ x))) =
    (Matrix.PSL3.OuterSolvable.graph Matrix.PSL3Four.F * Matrix.PSL3Four.pslFrobenius)
      (e (q (a.symm x)))
  have hc : a.symm (L.normalizerMonoidHom ⟨MulAut.conj n r, hnr⟩ x) =
      L.normalizerMonoidHom ⟨r, hrN⟩ (a.symm x) := by
    have hi : a.symm = L.normalizerMonoidHom (⟨n, hn⟩ : normalizer (L : Set G))⁻¹ :=
      (map_inv L.normalizerMonoidHom _).symm
    rw [hi]
    apply Subtype.ext
    change n⁻¹ * ((n * r * n⁻¹) * (x : G) * (n * r * n⁻¹)⁻¹) * n⁻¹⁻¹ =
      r * (n⁻¹ * (x : G) * n⁻¹⁻¹) * r⁻¹
    group
  rw [hc]
  exact he (a.symm x)

end CFSG.Quasithin.Chapter16.Intersections.GraphField
