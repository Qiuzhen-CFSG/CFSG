module

public import CFSG.Quasithin.Chapter16.Section04To05.Fusion
public import CFSG.Quasithin.Chapter16.Section01To02.ComponentTransfer.Intrinsic.Action
public import CFSG.Quasithin.Chapter16.Section01To02.ComponentTransfer.Intrinsic.Residual
public import Theory.GroupTheory.PResidual.PrimeToMonotone
public import Theory.GroupTheory.TightlyEmbedded.InvolutionGeneration
public import Theory.GroupTheory.QuasithinBasic

/-!
# Residual transfer in the conjugate-centralizer configuration

We retain the actual subgroup Lᵣ = O²(C_L(r)) and the subgroup
Λ_L(D) generated by O^{p′}(D), for odd primes p with m_p(L) > 1.
Functoriality transfers these generators into L′ whenever the ordinary
alternative of 16.4.5 identifies O^{p′}(C_G(r)) with L′. Conjugacy
preserves the prime-rank condition needed to apply that earlier lemma.

Tight embedding also rules out D ≤ K′ when the centralizers in L of the
involutions of D generate L. This is the last contradiction of the
PSL₂ field-involution branch, once its intrinsic generation and component
placement have been proved. The outer PGL₂ and M₂₂ exclusions and the
exceptional linear/unitary-three analysis are not asserted here.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004,
Notation 16.4.1 and the proof of 16.4.8, printed pp.1183, 1187–1188.
-/

@[expose] public section

namespace CFSG.Quasithin.Chapter16.Intersections.OuterResidual

open Subgroup Theory.GroupTheory
open ComponentTransfer

variable {G : Type*} [Group G]

/-- The source action quotient H* = N_G(L)/C_G(L). The centralizer is
normal in this normalizer, not asserted to be normal in G. -/
abbrev componentActionQuotient (L : Subgroup G) :=
  normalizer (L : Set G) ⧸
    (centralizer (L : Set G)).subgroupOf (normalizer (L : Set G))

/-- The embedded two-residual of the actual centralizer C_L(r). -/
abbrev involutionResidual (L : Subgroup G) (r : G) : Subgroup G :=
  Intrinsic.centralizerTwoResidual L r

/-- The primes indexing Λ on p.1187. -/
def residualPrimes (L : Subgroup G) : Set ℕ :=
  {p | p.Prime ∧ Odd p ∧ 1 < primeRank p L}

/-- The source subgroup Λ_L(D), embedded in G. -/
noncomputable def rankResidualSpan (L D : Subgroup G) : Subgroup G :=
  ⨆ (p : ℕ) (_ : p ∈ residualPrimes L), (primeToResidual p D).map D.subtype

/-- Every generator of Λ_L(D) remains in D. -/
theorem rankResidualSpan_le (L D : Subgroup G) : rankResidualSpan L D ≤ D := by
  exact iSup_le fun _ => iSup_le fun _ => map_subtype_le _

/-- The two-residual lies in the actual centralizer, hence in L. -/
theorem involutionResidual_le (L : Subgroup G) (r : G) :
    involutionResidual L r ≤ L ⊓ involutionCentralizer r :=
  map_subtype_le _

/-- A two-group centralizer has trivial two-residual. This applies to the
inner PSL₂(q) rows once their centralizer calculation has been supplied. -/
theorem involutionResidual_eq_bot_of_isPGroup (L : Subgroup G) (r : G)
    (hc : IsPGroup 2 (centralizerIn L r)) : involutionResidual L r = ⊥ := by
  have he : pResidual 2 (centralizerIn L r) = ⊥ := by
    apply le_bot_iff.mp
    exact sInf_le ⟨inferInstance, hc.of_surjective
      (QuotientGroup.mk' (⊥ : Subgroup (centralizerIn L r)))
      (QuotientGroup.mk'_surjective _)⟩
  change (pResidual 2 (centralizerIn L r)).map _ = ⊥
  rw [he, Subgroup.map_bot]

variable [Finite G]

/-- The rank test in 16.4.5 survives passage from L to its conjugate L′. -/
theorem residualPrimes_conjBy (L : Subgroup G) (g : G) :
    residualPrimes (L.conjBy g) = residualPrimes L := by
  ext p
  have he : primeRank p L = primeRank p (L.conjBy g) :=
    primeRank_equiv p ((MulAut.conj g).subgroupMap L)
  simp only [residualPrimes, Set.mem_ofPred_eq, he]

/-- Monotonicity transfers each O^{p′}(D) through its centralizer into L′.
The displayed identities are the ordinary outputs of source 16.4.5. -/
theorem rankResidualSpan_le_of_centralizer_residuals
    {L D : Subgroup G} {g r : G} (hD : D ≤ involutionCentralizer r)
    (hres : ∀ p ∈ residualPrimes (L.conjBy g),
      (primeToResidual p (involutionCentralizer r)).map
        (involutionCentralizer r).subtype = L.conjBy g) :
    rankResidualSpan L D ≤ L.conjBy g := by
  refine iSup_le fun p => iSup_le fun hp => ?_
  have hp' : p ∈ residualPrimes (L.conjBy g) := by
    rwa [residualPrimes_conjBy]
  exact (embedded_primeToResidual_mono p hD).trans (hres p hp').le

variable {T : Sylow 2 G} {z g r : G} {L R : Subgroup G}

/-- The automorphism is the restriction of conjugation by the given r,
not an independently chosen member of an automorphism family. -/
abbrev involutionAction (h : IntersectionSetup T z L g R) (hr : r ∈ R) : MulAut L :=
  Intrinsic.action (h.sylow_normalizes (h.le_sylow hr))

/-- The model action retains the ambient conjugation equation. -/
theorem involutionAction_apply (h : IntersectionSetup T z L g R) (hr : r ∈ R)
    (x : L) : (involutionAction h hr x : G) = r * x * r⁻¹ := rfl

/-- The faithfulness output R ∩ K = 1 of 16.4.2(1) ensures that an
involution of R induces an automorphism of order exactly two. -/
theorem involutionAction_order (h : IntersectionSetup T z L g R)
    (hfaith : R ⊓ centralizer (L : Set G) = ⊥)
    (hr : r ∈ R) (hr2 : orderOf r = 2) : orderOf (involutionAction h hr) = 2 := by
  let a : normalizer (L : Set G) := ⟨r, h.sylow_normalizes (h.le_sylow hr)⟩
  have ha : a ^ 2 = 1 := Subtype.ext (hr2 ▸ pow_orderOf_eq_one r)
  have hp : involutionAction h hr ^ 2 = 1 := by
    change L.normalizerMonoidHom a ^ 2 = 1
    rw [← map_pow, ha, map_one]
  apply orderOf_eq_prime hp
  intro he
  have hk : a ∈ L.normalizerMonoidHom.ker := he
  rw [normalizerMonoidHom_ker] at hk
  have hr1 : r = 1 := by
    have hm : r ∈ R ⊓ centralizer (L : Set G) := ⟨hr, hk⟩
    rwa [hfaith, mem_bot] at hm
  simp [hr1] at hr2

/-- The residual of the embedded centralizer is isomorphic to the residual
of the fixed subgroup for the very same action. -/
noncomputable def involutionResidualEquivFixed
    (h : IntersectionSetup T z L g R) (hr : r ∈ R) :
    involutionResidual L r ≃* pResidual 2 (involutionAction h hr).fixedSubgroup :=
  ((pResidual 2 (centralizerIn L r)).equivMapOfInjective
    (centralizerIn L r).subtype (centralizerIn L r).subtype_injective).symm.trans
    (((Intrinsic.centralizerEquivFixed (h.sylow_normalizes (h.le_sylow hr))).subgroupMap _).trans
      (MulEquiv.subgroupCongr (map_pResidual 2
        (Intrinsic.centralizerEquivFixed (h.sylow_normalizes (h.le_sylow hr))))))

/-- The full centralizer of an involution of R normalizes K′. -/
theorem centralizer_le_conjugate_normalizer (h : IntersectionSetup T z L g R)
    (hr : r ∈ R) (hr2 : orderOf r = 2) :
    involutionCentralizer r ≤
      normalizer ((centralizer (L : Set G)).conjBy g : Set G) :=
  (tight_map h.tight (MulAut.conj g)).involution_centralizer_le_normalizer
    (h.sylow.le hr).1 hr2

/-- The initial placement Lᵣ ≤ H′ in each of 16.4.6–8. -/
theorem involutionResidual_le_conjugate_normalizer
    (h : IntersectionSetup T z L g R) (hr : r ∈ R) (hr2 : orderOf r = 2) :
    involutionResidual L r ≤
      normalizer ((centralizer (L : Set G)).conjBy g : Set G) :=
  (involutionResidual_le L r).trans
    (inf_le_right.trans (centralizer_le_conjugate_normalizer h hr hr2))

/-- The other fixed involution z centralizes Lᵣ because it centralizes L. -/
theorem involutionResidual_le_original_centralizer
    (h : IntersectionSetup T z L g R) :
    involutionResidual L r ≤ involutionCentralizer z :=
  (involutionResidual_le L r).trans (inf_le_left.trans h.component.1)

/-- Tight embedding rules out the alternative Lᵣ ≤ K′ in the rank-one
field branch, from its intrinsic centralizer-generation equality. -/
theorem involutionResidual_not_le_conjugate_centralizer
    (h : IntersectionSetup T z L g R)
    (hnot : ¬ L ≤ normalizer ((centralizer (L : Set G)).conjBy g : Set G))
    (hgen : (⨆ (i : G) (_ : i ∈ involutionResidual L r) (_ : orderOf i = 2),
      L ⊓ involutionCentralizer i) = L) :
    ¬ involutionResidual L r ≤ (centralizer (L : Set G)).conjBy g :=
  (tight_map h.tight (MulAut.conj g)).not_le_of_involution_centralizers_generate hnot hgen

/-- The opening R₀ = 1 step in 16.4.6. This lemma supplies the ambient
argument; the PGL₂ and S₆ generation calculations remain model inputs. -/
theorem two_subgroup_eq_bot_of_pair_generation
    (h : IntersectionSetup T z L g R)
    (hnot : ¬ L ≤ normalizer ((centralizer (L : Set G)).conjBy g : Set G))
    (hr : r ∈ R) (hr2 : orderOf r = 2) {D : Subgroup G} (hDR : D ≤ R)
    (hgen : ∀ i : G, i ∈ D → orderOf i = 2 →
      (L ⊓ involutionCentralizer r) ⊔ (L ⊓ involutionCentralizer i) = L) : D = ⊥ :=
  (tight_map h.tight (MulAut.conj g)).two_subgroup_eq_bot_of_pair_generation
    hnot (h.sylow.le hr).1 hr2
    (h.sylow.isPGroup.of_injective (inclusion hDR) (inclusion_injective _))
    (hDR.trans (h.sylow.le.trans inf_le_left)) hgen

end CFSG.Quasithin.Chapter16.Intersections.OuterResidual
