module

public import CFSG.Quasithin.Chapter16.Section04To05.OuterResidual.PGLShadow.Transvections.Geometry
public import CFSG.Quasithin.Chapter16.Section04To05.OuterResidual.PGLShadow.Transvections.ActionImages.Coordinates

/-!
# The actual S₃ and S₄ transvection action images

For the elementary eight in the PGL₂ shadow, the subgroup generated by the
normalizer actions of s and t is identified with S₃ by its faithful action on
the three nonidentity points of ⟨u,v⟩. The plane has order four and is invariant;
the common fixed subgroup is the order-two line ⟨vz⟩ = ⟨ur⟩. Together with
`EightConfig.plane_sup_line` and `EightConfig.plane_disjoint_line` from
Geometry, this gives the source decomposition of V.

The separate `AlgebraicData` interface assumes only the elementary eight,
generation and the marked conjugation equations. Adding an actual normalizer
fixing z,v and sending r to rz generates the full stabilizer of vz, with an
actual S₄ equivalence and transitivity outside ⟨vz⟩. No weak-closure premise
enters that recognition. The contradiction using weak closure remains the
independent `EightConfig.no_extra_transvection` from Geometry.

The proof transports the actual normalizer homomorphisms through marked binary
coordinates. The S₃ equivalence restricts to the nonidentity plane points; the
S₄ equivalence uses the faithful action on four characters nontrivial on vz.
The local construction of the third normalizer and both transfer quotients are
separate obligations of the Lemma 16.4.6 assembly.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004, Lemma 16.4.6,
printed pp.1185–1186. Conjugations are left conjugations, as in Geometry.
-/

public section

open Subgroup
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter16.Intersections.OuterResidual.PGLShadow.Transvections
variable {G : Type*} [Group G]

/-- Purely algebraic marked actions on an elementary eight. In particular this
record has no weak-closure or ambient fusion premise. -/
structure AlgebraicData (V : Subgroup G) (r z v s t : G) : Prop where
  elementary : IsElementaryAbelian 2 V
  card : Nat.card V = 8
  r_mem : r ∈ V
  z_mem : z ∈ V
  v_mem : v ∈ V
  span : V = zpowers r ⊔ (zpowers z ⊔ zpowers v)
  s_normalizes : s ∈ normalizer (V : Set G)
  t_normalizes : t ∈ normalizer (V : Set G)
  s_r : MulAut.conj s r = r
  s_z : MulAut.conj s z = z * (r * (z * v))
  s_u : MulAut.conj s (r * (z * v)) = r * (z * v)
  t_r : MulAut.conj t r = r * v
  t_z : MulAut.conj t z = z
  t_v : MulAut.conj t v = v

namespace AlgebraicData
variable {V : Subgroup G} {r z v s t : G} (h : AlgebraicData V r z v s t)
include h

/-- The action on the third marked basis vector follows from fixation of u. -/
theorem s_v : MulAut.conj s v = (r * (z * v)) * v := by
  have hs := h.s_u
  rw [map_mul, map_mul, h.s_r, h.s_z] at hs
  have hh : (r * (z*v)) * MulAut.conj s v = v := by
    apply mul_left_cancel (a := z)
    apply mul_left_cancel (a := r)
    simpa only [mul_assoc] using hs
  have hsquare : (r*(z*v)) * (r*(z*v)) = 1 := by
    let := h.elementary
    simpa only [pow_two] using elemPow_eq_one_of_isElementaryAbelian (p := 2)
      (r*(z*v)) (V.mul_mem h.r_mem (V.mul_mem h.z_mem h.v_mem))
  calc
    MulAut.conj s v = (r*(z*v)) * ((r*(z*v)) * MulAut.conj s v) := by
      rw [← mul_assoc, hsquare, one_mul]
    _ = (r*(z*v)) * v := by rw [hh]

@[expose] def sPlus : MulAut V := V.normalizerMonoidHom ⟨s,h.s_normalizes⟩
@[expose] def tPlus : MulAut V := V.normalizerMonoidHom ⟨t,h.t_normalizes⟩
abbrev image3 : Subgroup (MulAut V) := zpowers h.sPlus ⊔ zpowers h.tPlus
abbrev image4 (a : G) (ha : a ∈ normalizer (V : Set G)) : Subgroup (MulAut V) :=
  h.image3 ⊔ zpowers (V.normalizerMonoidHom ⟨a,ha⟩)

private theorem gen : zpowers (⟨r,h.r_mem⟩ : V) ⊔
    (zpowers (⟨z,h.z_mem⟩ : V) ⊔ zpowers (⟨v,h.v_mem⟩ : V)) = ⊤ := by
  apply Subgroup.map_injective V.subtype_injective
  simp only [Subgroup.map_sup, MonoidHom.map_zpowers, subtype_apply, ← MonoidHom.range_eq_map, range_subtype]
  exact h.span.symm

private noncomputable def coordinates : ActionModel.E ≃* V := by
  let := h.elementary
  exact ActionCoordinates.coordinates ⟨r,h.r_mem⟩ ⟨z,h.z_mem⟩ ⟨v,h.v_mem⟩ h.card h.gen

private theorem coord_r : h.coordinates ActionModel.r = ⟨r,h.r_mem⟩ := by
  let := h.elementary
  exact ActionCoordinates.coordinates_r _ _ _ h.card h.gen
private theorem coord_z : h.coordinates ActionModel.z = ⟨z,h.z_mem⟩ := by
  let := h.elementary
  exact ActionCoordinates.coordinates_z _ _ _ h.card h.gen
private theorem coord_v : h.coordinates ActionModel.v = ⟨v,h.v_mem⟩ := by
  let := h.elementary
  exact ActionCoordinates.coordinates_v _ _ _ h.card h.gen
private theorem coord_u : (h.coordinates ActionModel.u : G) = r * (z*v) := by
  simp only [ActionModel.u, map_mul, h.coord_r, h.coord_z, h.coord_v, coe_mul]
private theorem coord_w : (h.coordinates ActionModel.w : G) = v*z := by
  simp only [ActionModel.w, map_mul, h.coord_z, h.coord_v, coe_mul]

private theorem conjugate_s : MulAut.congr h.coordinates.symm h.sPlus = ActionModel.s := by
  apply ActionCoordinates.transport_s
  · apply Subtype.ext
    simpa only [h.coord_r, sPlus, normalizerMonoidHom_apply_apply_coe, MulAut.conj_apply] using h.s_r
  · apply Subtype.ext
    simpa only [map_mul, h.coord_z, coe_mul, h.coord_u, sPlus,
      normalizerMonoidHom_apply_apply_coe, MulAut.conj_apply] using h.s_z
  · apply Subtype.ext
    simpa only [map_mul, h.coord_v, coe_mul, h.coord_u, sPlus,
      normalizerMonoidHom_apply_apply_coe, MulAut.conj_apply] using h.s_v

private theorem conjugate_t : MulAut.congr h.coordinates.symm h.tPlus = ActionModel.t := by
  apply ActionCoordinates.transport_t
  · apply Subtype.ext
    simpa only [map_mul, h.coord_r, h.coord_v, coe_mul, tPlus,
      normalizerMonoidHom_apply_apply_coe, MulAut.conj_apply] using h.t_r
  · apply Subtype.ext
    simpa only [h.coord_z, tPlus, normalizerMonoidHom_apply_apply_coe, MulAut.conj_apply] using h.t_z
  · apply Subtype.ext
    simpa only [h.coord_v, tPlus, normalizerMonoidHom_apply_apply_coe, MulAut.conj_apply] using h.t_v

private theorem conjugate_a (a : G) (ha : a ∈ normalizer (V : Set G))
    (har : MulAut.conj a r = r*z) (haz : MulAut.conj a z = z)
    (hav : MulAut.conj a v = v) :
    MulAut.congr h.coordinates.symm (V.normalizerMonoidHom ⟨a,ha⟩) = ActionModel.a := by
  apply ActionCoordinates.transport_a
  · apply Subtype.ext
    simpa only [map_mul, h.coord_r, h.coord_z, coe_mul,
      normalizerMonoidHom_apply_apply_coe, MulAut.conj_apply] using har
  · apply Subtype.ext
    simpa only [h.coord_z, normalizerMonoidHom_apply_apply_coe, MulAut.conj_apply] using haz
  · apply Subtype.ext
    simpa only [h.coord_v, normalizerMonoidHom_apply_apply_coe, MulAut.conj_apply] using hav

private noncomputable def imageCoordinates3 : h.image3 ≃* ActionModel.H3 :=
  (h.image3.equivMapOfInjective (MulAut.congr h.coordinates.symm).toMonoidHom
    (MulAut.congr h.coordinates.symm).injective).trans
  (MulEquiv.subgroupCongr (by
    simp only [image3, Subgroup.map_sup, MonoidHom.map_zpowers, MulEquiv.coe_toMonoidHom,
      h.conjugate_s, h.conjugate_t]))

private noncomputable def imageCoordinates4 (a : G) (ha : a ∈ normalizer (V : Set G))
    (har : MulAut.conj a r = r*z) (haz : MulAut.conj a z = z)
    (hav : MulAut.conj a v = v) : h.image4 a ha ≃* ActionModel.H4 :=
  ((h.image4 a ha).equivMapOfInjective (MulAut.congr h.coordinates.symm).toMonoidHom
    (MulAut.congr h.coordinates.symm).injective).trans
  (MulEquiv.subgroupCongr (by
    simp only [image4, image3, Subgroup.map_sup, MonoidHom.map_zpowers, MulEquiv.coe_toMonoidHom,
      h.conjugate_s, h.conjugate_t, h.conjugate_a a ha har haz hav]))

/-- The equivalence is induced by the faithful permutation action on the three
nonidentity points of the invariant plane. -/
noncomputable def equivS3 : h.image3 ≃* Equiv.Perm (Fin 3) :=
  h.imageCoordinates3.trans ActionModel.equiv3

theorem card_image3 : Nat.card h.image3 = 6 :=
  (Nat.card_congr h.imageCoordinates3.toEquiv).trans ActionModel.card3

theorem not_dihedral_four : ¬ Nonempty (h.image3 ≃* DihedralGroup 4) := by
  rintro ⟨e⟩
  have hh := Nat.card_congr e.toEquiv
  rw [h.card_image3, DihedralGroup.nat_card] at hh
  contradiction

private theorem plane_map : ActionModel.plane.map (V.subtype.comp h.coordinates.toMonoidHom) =
    zpowers (r*(z*v)) ⊔ zpowers v := by
  rw [ActionModel.plane_eq, Subgroup.map_sup, MonoidHom.map_zpowers, MonoidHom.map_zpowers]
  simp only [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, subtype_apply, h.coord_u,
    h.coord_v]

private theorem line_map : ActionModel.line.map (V.subtype.comp h.coordinates.toMonoidHom) =
    zpowers (v*z) := by
  rw [ActionModel.line_eq, MonoidHom.map_zpowers]
  simp only [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, subtype_apply, h.coord_w]

theorem plane_card : Nat.card (zpowers (r*(z*v)) ⊔ zpowers v : Subgroup G) = 4 := by
  rw [← h.plane_map, Subgroup.card_map_of_injective (f := V.subtype.comp h.coordinates.toMonoidHom)
    (fun x y he => h.coordinates.injective (Subtype.ext he))]
  exact ActionModel.plane_card

theorem line_card : Nat.card (zpowers (v*z)) = 2 := by
  rw [← h.line_map, Subgroup.card_map_of_injective (f := V.subtype.comp h.coordinates.toMonoidHom)
    (fun x y he => h.coordinates.injective (Subtype.ext he))]
  exact ActionModel.line_card

private theorem mem_plane (x : V) : (x : G) ∈ zpowers (r*(z*v)) ⊔ zpowers v ↔
    h.coordinates.symm x ∈ ActionModel.plane := by
  rw [← h.plane_map]
  constructor
  · rintro ⟨y,hy,he⟩
    have he' : h.coordinates y = x := Subtype.ext he
    simpa only [SetLike.mem_coe, ← he', h.coordinates.symm_apply_apply] using hy
  · intro hx
    exact ⟨h.coordinates.symm x, hx, by simp⟩

private theorem mem_line (x : V) : (x : G) ∈ zpowers (v*z) ↔
    h.coordinates.symm x ∈ ActionModel.line := by
  rw [← h.line_map]
  constructor
  · rintro ⟨y,hy,he⟩
    have he' : h.coordinates y = x := Subtype.ext he
    simpa only [SetLike.mem_coe, ← he', h.coordinates.symm_apply_apply] using hy
  · intro hx
    exact ⟨h.coordinates.symm x, hx, by simp⟩

theorem plane_invariant (b : h.image3) (x : V) :
    ((b : MulAut V) x : G) ∈ zpowers (r*(z*v)) ⊔ zpowers v ↔
      (x : G) ∈ zpowers (r*(z*v)) ⊔ zpowers v := by
  rw [h.mem_plane, h.mem_plane]
  have he := ActionModel.preserves_plane (h.imageCoordinates3 b) (h.coordinates.symm x)
  change h.coordinates.symm ((b : MulAut V) (h.coordinates (h.coordinates.symm x))) ∈
      ActionModel.plane ↔ _ at he
  simpa only [h.coordinates.apply_symm_apply] using he

theorem fixes_product3 (b : h.image3) :
    ((b : MulAut V) ⟨v*z,V.mul_mem h.v_mem h.z_mem⟩ : G) = v*z := by
  have he := ActionModel.fixes_line (h.imageCoordinates3 b)
  have he' := congrArg (fun x => (h.coordinates x : G)) he
  change (h.coordinates (h.coordinates.symm ((b : MulAut V) (h.coordinates ActionModel.w))) : G) =
    (h.coordinates ActionModel.w : G) at he'
  rw [h.coordinates.apply_symm_apply, h.coord_w] at he'
  have hw : h.coordinates ActionModel.w = ⟨v*z,V.mul_mem h.v_mem h.z_mem⟩ := Subtype.ext h.coord_w
  simpa only [hw] using he'

theorem fixes_product4 (a : G) (ha : a ∈ normalizer (V : Set G))
    (har : MulAut.conj a r = r*z) (haz : MulAut.conj a z = z)
    (hav : MulAut.conj a v = v) (b : h.image4 a ha) :
    ((b : MulAut V) ⟨v*z,V.mul_mem h.v_mem h.z_mem⟩ : G) = v*z := by
  have he := ActionModel.fixes4 (h.imageCoordinates4 a ha har haz hav b)
  have he' := congrArg (fun x => (h.coordinates x : G)) he
  change (h.coordinates (h.coordinates.symm ((b : MulAut V) (h.coordinates ActionModel.w))) : G) =
    (h.coordinates ActionModel.w : G) at he'
  rw [h.coordinates.apply_symm_apply, h.coord_w] at he'
  have hw : h.coordinates ActionModel.w = ⟨v*z,V.mul_mem h.v_mem h.z_mem⟩ := Subtype.ext h.coord_w
  simpa only [hw] using he'

/-- Algebraic S₄ recognition, independently of all weak-closure assumptions.
The final equivalence uses the faithful action on the four characters that are
nontrivial on the fixed line. -/
noncomputable def equivS4 (a : G) (ha : a ∈ normalizer (V : Set G))
    (har : MulAut.conj a r = r*z) (haz : MulAut.conj a z = z)
    (hav : MulAut.conj a v = v) : h.image4 a ha ≃* Equiv.Perm (Fin 4) := by
  let := h.elementary
  let : Finite V := Nat.finite_of_card_ne_zero (h.card ▸ by decide)
  have hc : Nat.card (h.image4 a ha) = 24 :=
    (Nat.card_congr (h.imageCoordinates4 a ha har haz hav).toEquiv).trans ActionModel.card4
  have hn : (⟨v*z,V.mul_mem h.v_mem h.z_mem⟩ : V) ≠ 1 := by
    intro hh
    have hvg : v*z = 1 := congrArg Subtype.val hh
    have hl := h.line_card
    rw [hvg] at hl
    simp at hl
  exact (elementaryEight_fixed_point_order24_equiv_S4 h.card
    ⟨v*z,V.mul_mem h.v_mem h.z_mem⟩ hn (h.image4 a ha) hc
    (fun b => Subtype.ext (h.fixes_product4 a ha har haz hav b))).some

/-- The three generated actions fill the full stabilizer of the marked point. -/
theorem image4_eq_stabilizer (a : G) (ha : a ∈ normalizer (V : Set G))
    (har : MulAut.conj a r = r*z) (haz : MulAut.conj a z = z)
    (hav : MulAut.conj a v = v) :
    h.image4 a ha = MulAction.stabilizer (MulAut V) (⟨v*z,V.mul_mem h.v_mem h.z_mem⟩ : V) := by
  let := h.elementary
  let : Finite V := Nat.finite_of_card_ne_zero (h.card ▸ by decide)
  let wV : V := ⟨v*z,V.mul_mem h.v_mem h.z_mem⟩
  let A := MulAction.stabilizer (MulAut V) wV
  have hn : wV ≠ 1 := by
    intro hh
    have hvg : v*z = 1 := congrArg Subtype.val hh
    have hl := h.line_card
    rw [hvg] at hl
    simp at hl
  have hle : h.image4 a ha ≤ A := by
    intro b hb
    exact Subtype.ext (h.fixes_product4 a ha har haz hav ⟨b,hb⟩)
  have hc : Nat.card (h.image4 a ha) = 24 :=
    (Nat.card_congr (h.imageCoordinates4 a ha har haz hav).toEquiv).trans ActionModel.card4
  have hd : Nat.card A ∣ 24 := elementaryEight_fixed_point_image_card_dvd_twentyfour
    h.card wV hn A (fun b => b.property)
  exact Subgroup.eq_of_le_of_card_ge hle (by rw [hc]; exact Nat.le_of_dvd (by decide) hd)

theorem transitive_outside_line (a : G) (ha : a ∈ normalizer (V : Set G))
    (har : MulAut.conj a r = r*z) (haz : MulAut.conj a z = z)
    (hav : MulAut.conj a v = v) (x y : V)
    (hx : (x : G) ∉ zpowers (v*z)) (hy : (y : G) ∉ zpowers (v*z)) :
    ∃ b : h.image4 a ha, (b : MulAut V) x = y := by
  obtain ⟨b,hb⟩ := ActionModel.transitive4 (h.coordinates.symm x) (h.coordinates.symm y)
    (fun hh => hx ((h.mem_line x).mpr hh)) (fun hh => hy ((h.mem_line y).mpr hh))
  obtain ⟨c,rfl⟩ := (h.imageCoordinates4 a ha har haz hav).surjective b
  refine ⟨c, h.coordinates.symm.injective ?_⟩
  change h.coordinates.symm ((c : MulAut V) (h.coordinates (h.coordinates.symm x))) =
    h.coordinates.symm y at hb
  simpa only [h.coordinates.apply_symm_apply] using hb

end AlgebraicData

namespace EightConfig
variable [Finite G]
variable {V : Subgroup G} {r z v u s t : G} (h : EightConfig V r z v u s t)
include h

theorem algebraicData : AlgebraicData V r z v s t := {
  elementary := h.elementary
  card := h.card
  r_mem := h.r_mem
  z_mem := h.z_mem
  v_mem := h.v_mem
  span := h.span
  s_normalizes := h.s_normalizes
  t_normalizes := h.t_normalizes
  s_r := h.s_r
  s_z := by rw [← h.u_eq]; exact h.s_z
  s_u := by rw [← h.u_eq]; exact h.s_u
  t_r := h.t_r
  t_z := h.t_z
  t_v := h.t_v }

abbrev sPlus : MulAut V := V.normalizerMonoidHom ⟨s,h.s_normalizes⟩
abbrev tPlus : MulAut V := V.normalizerMonoidHom ⟨t,h.t_normalizes⟩
abbrev actionImage : Subgroup (MulAut V) := zpowers h.sPlus ⊔ zpowers h.tPlus

noncomputable def actionEquivS3 : h.actionImage ≃* Equiv.Perm (Fin 3) := h.algebraicData.equivS3

theorem no_dihedral_four : ¬ Nonempty (h.actionImage ≃* DihedralGroup 4) :=
  h.algebraicData.not_dihedral_four

theorem plane_card : Nat.card (zpowers u ⊔ zpowers v : Subgroup G) = 4 := by
  simpa only [← h.u_eq] using h.algebraicData.plane_card

theorem line_card : Nat.card (zpowers (v*z)) = 2 := h.algebraicData.line_card

theorem plane_invariant (b : h.actionImage) (x : V) :
    ((b : MulAut V) x : G) ∈ zpowers u ⊔ zpowers v ↔ (x : G) ∈ zpowers u ⊔ zpowers v := by
  simpa only [← h.u_eq] using h.algebraicData.plane_invariant b x

theorem common_fixed_subgroup (x : V) :
    (∀ b : h.actionImage, (b : MulAut V) x = x) ↔ (x : G) ∈ zpowers (v*z) := by
  constructor
  · intro hx
    have ht := congrArg Subtype.val (hx ⟨h.tPlus,mem_sup_right (mem_zpowers _)⟩)
    have hs := congrArg Subtype.val (hx ⟨h.sPlus,mem_sup_left (mem_zpowers _)⟩)
    have hh := (h.common_fixed_iff x x.property).mp ⟨ht,hs⟩
    rcases hh with hh | hh
    · rw [hh]; exact one_mem _
    · rw [hh]; exact mem_zpowers _
  · intro hx b
    have hf := h.algebraicData.fixes_product3 b
    have hf' : (b : MulAut V) (⟨v*z,V.mul_mem h.v_mem h.z_mem⟩ : V) =
        ⟨v*z,V.mul_mem h.v_mem h.z_mem⟩ := Subtype.ext hf
    apply (MulAut.mem_fixedSubgroup _ _).mp
    apply (zpowers_le.mpr ((MulAut.mem_fixedSubgroup _ _).mpr hf'))
    obtain ⟨n,hn⟩ := hx
    exact ⟨n, Subtype.ext hn⟩

theorem line_markings : zpowers (v*z) = zpowers (u*r) := by rw [h.fixed_line_relation]

end EightConfig
end CFSG.Quasithin.Chapter16.Intersections.OuterResidual.PGLShadow.Transvections
