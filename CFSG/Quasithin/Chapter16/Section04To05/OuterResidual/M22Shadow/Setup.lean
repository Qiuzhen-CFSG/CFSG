module

public import CFSG.Quasithin.Chapter16.Section04To05.OuterResidual.Basic

/-!
# The actual subgroups and action in the M₂₂ shadow argument

We retain Q = O₂(O²(C_L(r))), R₀ = R ∩ LC_G(L), V = Q⟨r,z⟩, and
M = ⟨N_H(V), N_{H′}(V)⟩ as subgroups of the original group. The action on
V is ambient conjugation; its kernel is precisely the relative centralizer
C_M(V). In particular its quotient and faithful image have a canonical
isomorphism. No dimension, model recognition, or outer exclusion is assumed
by these definitions.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004,
proof of Lemma 16.4.7, printed pp.1186–1187. We use H = N_G(L), equal to
N_G(C_G(L)) in `IntersectionSetup`, and H′ = N_G(C_G(L)^g).
-/

@[expose] public section

namespace CFSG.Quasithin.Chapter16.Intersections.OuterResidual.M22Shadow

open Subgroup Theory.GroupTheory

variable {G : Type*} [Group G]

/-- The subgroup of R acting inner on L, once the faithful action has been
established; the definition itself is the literal source intersection. -/
def innerPart (L R : Subgroup G) : Subgroup G :=
  R ⊓ (L ⊔ centralizer (L : Set G))

/-- Q = O₂(Lᵣ), embedded in the original ambient group. -/
noncomputable def residualCore (L : Subgroup G) (r : G) : Subgroup G :=
  (pCore 2 (involutionResidual L r)).map (involutionResidual L r).subtype

/-- The subgroup called V in the six-dimensional argument. -/
noncomputable def shadowSpace (L : Subgroup G) (r z : G) : Subgroup G :=
  residualCore L r ⊔ (zpowers r ⊔ zpowers z)

/-- The source overgroup generated by the two relative normalizers. -/
noncomputable def shadowOvergroup (L : Subgroup G) (g r z : G) : Subgroup G :=
  (normalizer (L : Set G) ⊓ normalizer (shadowSpace L r z : Set G)) ⊔
    (normalizer ((centralizer (L : Set G)).conjBy g : Set G) ⊓
      normalizer (shadowSpace L r z : Set G))

theorem residualCore_le_residual (L : Subgroup G) (r : G) :
    residualCore L r ≤ involutionResidual L r := map_subtype_le _

theorem residualCore_le_component (L : Subgroup G) (r : G) :
    residualCore L r ≤ L :=
  (residualCore_le_residual L r).trans ((involutionResidual_le L r).trans inf_le_left)

theorem residualCore_le_centralizer (L : Subgroup G) (r : G) :
    residualCore L r ≤ involutionCentralizer r :=
  (residualCore_le_residual L r).trans ((involutionResidual_le L r).trans inf_le_right)

theorem shadowOvergroup_le_normalizer (L : Subgroup G) (g r z : G) :
    shadowOvergroup L g r z ≤ normalizer (shadowSpace L r z : Set G) :=
  sup_le inf_le_right inf_le_right

/-- Conjugation by an element of M, restricted to the actual subgroup V. -/
noncomputable def shadowAction (L : Subgroup G) (g r z : G) :
    shadowOvergroup L g r z →* MulAut (shadowSpace L r z) :=
  (shadowSpace L r z).normalizerMonoidHom.comp
    (inclusion (shadowOvergroup_le_normalizer L g r z))

theorem shadowAction_apply (L : Subgroup G) (g r z : G)
    (m : shadowOvergroup L g r z) (v : shadowSpace L r z) :
    (shadowAction L g r z m v : G) = m * v * (m : G)⁻¹ := rfl

/-- The action kernel is normal in M, and is the relative centralizer C_M(V). -/
theorem shadowAction_ker (L : Subgroup G) (g r z : G) :
    (shadowAction L g r z).ker =
      (centralizer (shadowSpace L r z : Set G)).subgroupOf (shadowOvergroup L g r z) := by
  ext m
  change (shadowSpace L r z).normalizerMonoidHom
    (inclusion (shadowOvergroup_le_normalizer L g r z) m) = 1 ↔ _
  change inclusion (shadowOvergroup_le_normalizer L g r z) m ∈
    (shadowSpace L r z).normalizerMonoidHom.ker ↔ _
  rw [normalizerMonoidHom_ker]
  rfl

/-- M⁺, with the kernel identified with C_M(V) by `shadowAction_ker`. -/
abbrev shadowActionQuotient (L : Subgroup G) (g r z : G) :=
  shadowOvergroup L g r z ⧸ (shadowAction L g r z).ker

/-- The quotient is identified with the image of the very same conjugation action. -/
noncomputable def shadowActionQuotientEquivRange (L : Subgroup G) (g r z : G) :
    shadowActionQuotient L g r z ≃* (shadowAction L g r z).range :=
  QuotientGroup.quotientKerEquivRange (shadowAction L g r z)

variable [Finite G] {T : Sylow 2 G} {z g r : G} {L R : Subgroup G}

/-- Both marked involutions centralize Q; this is the z half. -/
theorem residualCore_le_original_centralizer (h : IntersectionSetup T z L g R) :
    residualCore L r ≤ involutionCentralizer z :=
  (residualCore_le_residual L r).trans (involutionResidual_le_original_centralizer h)

/-- The actual Q lies in H′ before any M₂₂-specific placement in L′ is proved. -/
theorem residualCore_le_conjugate_normalizer (h : IntersectionSetup T z L g R)
    (hr : r ∈ R) (hr2 : orderOf r = 2) :
    residualCore L r ≤ normalizer ((centralizer (L : Set G)).conjBy g : Set G) :=
  (residualCore_le_residual L r).trans
    (involutionResidual_le_conjugate_normalizer h hr hr2)

end CFSG.Quasithin.Chapter16.Intersections.OuterResidual.M22Shadow
