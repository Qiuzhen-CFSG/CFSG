module

public import CFSG.Quasithin.Chapter16.Section03.EnlargementSieve.Sylow

/-!
# Identifying the embedded two-core of the enlargement

The center equals the two-core by the earlier even-type component theorem.
Its ambient image is a central two-subgroup of C_G(t) ∩ C_G(K), so it lies
in the Sylow subgroup ⟨t⟩. Nontriviality then forces equality, in the actual
ambient group. In particular, t belongs to K.

Source: Aschbacher–Smith, the first reduction in 16.3.11(3), printed p.1181.
-/

public section
open Subgroup Theory.GroupTheory

namespace CFSG.Quasithin.Chapter16.EnlargementSieve
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {z t : G} {L : Subgroup G}

/-- In the nonsimple component branch, the second Sylow centralizer forces
its nontrivial two-core to be exactly the ambient subgroup generated by t. -/
theorem twoCore_image_eq (h : TerminalCounterexample T z L t)
    (hshape : ∀ a : G, TerminalCounterexample T z L a →
      NonterminalCentralizerShape T z L a)
    (hK : IsCentralizerComponent t (enlargement t L))
    (hcomm : ⁅enlargement t L, zpowers z⁆ = enlargement t L)
    (hZ : center (enlargement t L) = pCore 2 (enlargement t L))
    (hne : pCore 2 (enlargement t L) ≠ ⊥) :
    (pCore 2 (enlargement t L)).map (enlargement t L).subtype = zpowers t := by
  let K := enlargement t L
  let R := (pCore 2 K).map K.subtype
  let H := involutionCentralizer t ⊓ centralizer (K : Set G)
  have hRH : R ≤ H := by
    rintro x ⟨r, hr, rfl⟩
    refine ⟨enlargement_le h r.property, ?_⟩
    rw [← hZ] at hr
    intro a ha
    exact congrArg Subtype.val (mem_center_iff.mp hr ⟨a, ha⟩)
  have hRcent : R.subgroupOf H ≤ center H := by
    intro r hr
    apply mem_center_iff.mpr
    intro a
    apply Subtype.ext
    obtain ⟨k, -, hk⟩ := hr
    change (a : G) * (r : G) = (r : G) * (a : G)
    change (k : G) = (r : G) at hk
    rw [← hk]
    exact (a.property.2 k k.property).symm
  let : (R.subgroupOf H).Normal := ⟨fun x hx g => by
    have hc := mem_center_iff.mp (hRcent hx) g
    simpa only [hc, mul_assoc, mul_inv_cancel, mul_one] using hx⟩
  obtain ⟨Q, hQ⟩ := (both_sylow_centralizers h hshape hK hcomm).2
  have hRp : IsPGroup 2 (R.subgroupOf H) :=
    ((pCore_isPGroup (p := 2) (G := K)).map K.subtype).comap_subtype
  have hRle : R ≤ zpowers t := by
    rw [← hQ]
    intro r hr
    refine ⟨⟨r, hRH hr⟩, ?_, rfl⟩
    exact hRp.le_sylow_of_normal (G := H) (N := R.subgroupOf H) Q
      (show (⟨r, hRH hr⟩ : H) ∈ R.subgroupOf H from hr)
  have hRne : R ≠ ⊥ := by
    intro he
    exact hne ((pCore 2 K).map_eq_bot_iff_of_injective K.subtype_injective |>.mp he)
  have hlo : 2 ≤ Nat.card R := by
    have hp := Nat.card_pos (α := R)
    have hn : Nat.card R ≠ 1 := fun hc => hRne ((R.eq_bot_iff_card).mpr hc)
    omega
  apply eq_of_le_of_card_ge hRle
  simpa only [Nat.card_zpowers, h.involution] using hlo

omit [Finite G] in
/-- The equality identifies t as an element of the actual component K. -/
theorem mem_enlargement_of_twoCore_image
    (he : (pCore 2 (enlargement t L)).map (enlargement t L).subtype = zpowers t) :
    t ∈ enlargement t L := by
  have ht : t ∈ (pCore 2 (enlargement t L)).map (enlargement t L).subtype :=
    he.symm ▸ mem_zpowers t
  obtain ⟨a, -, ha⟩ := ht
  change (a : G) = t at ha
  exact (congrArg (fun x : G => x ∈ enlargement t L) ha).mp a.property

/-- The sporadic alternative supplies nontriviality; the earlier even-type
component theorem supplies the equality of the center and the two-core. -/
theorem sporadic_twoCore_image_eq (hEven : HasEvenTypeCentralizers G)
    (h : TerminalCounterexample T z L t)
    (hshape : ∀ a : G, TerminalCounterexample T z L a →
      NonterminalCentralizerShape T z L a)
    (hK : IsCentralizerComponent t (enlargement t L))
    (hcomm : ⁅enlargement t L, zpowers z⁆ = enlargement t L)
    (hcover : SporadicCoverAlternative (enlargement t L) L) :
    (pCore 2 (enlargement t L)).map (enlargement t L).subtype = zpowers t :=
  twoCore_image_eq h hshape hK hcomm
    (hEven.component_center_eq_twoCore h.involution hK) hcover.1

omit [Finite G] in
/-- The ambient identification gives the corresponding intrinsic center,
so quotienting by the center really is quotienting by the embedded t. -/
theorem center_eq_zpowers_of_twoCore_image
    (hZ : center (enlargement t L) = pCore 2 (enlargement t L))
    (he : (pCore 2 (enlargement t L)).map (enlargement t L).subtype = zpowers t) :
    center (enlargement t L) =
      zpowers (⟨t, mem_enlargement_of_twoCore_image he⟩ : enlargement t L) := by
  have hmap : (zpowers (⟨t, mem_enlargement_of_twoCore_image he⟩ : enlargement t L)).map
      (enlargement t L).subtype = zpowers t := by
    rw [MonoidHom.map_zpowers]
    rfl
  apply le_antisymm
  · apply (map_le_map_iff_of_injective (enlargement t L).subtype_injective).mp
    rw [hZ, he, hmap]
  · apply (map_le_map_iff_of_injective (enlargement t L).subtype_injective).mp
    rw [hZ, he, hmap]

end CFSG.Quasithin.Chapter16.EnlargementSieve
