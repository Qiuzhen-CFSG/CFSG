module

public import Theory.Frattini.OmegaAmbient
public import CFSG.Quasithin.ChapterB.Section02.Thompson
public import Theory.GroupTheory.SylowCentralizerObstruction

/-!
# Maximal-rank Thompson embeddings and the Sylow obstruction

The elementary Thompson subgroup is generated by elementary abelian subgroups
of largest order. An inclusion of groups with equal maximum two-rank therefore
induces an inclusion of their Thompson subgroups. The finite two-group Frattini
comparison and first-omega monotonicity give the corresponding Ω₁(Φ(J(-)))
inclusion.

Place P itself in a conjugate of the ambient Sylow group T. If the two ranks
agree and Ω₁(Φ(J(T))) is centralized by T, this conjugate Sylow centralizes
Ω₁(Φ(J(P))). Normalization by P follows from the characteristic constructions.
The Sylow normalizer/centralizer lemma then excludes a noncentral P-action.
No equality Φ(J(T)) = Ω₁(Φ(J(T))) is used.

This is the general final inference of Aschbacher–Smith, Theorem 16.3.7,
printed p.1182 / PDF p.1199. The source-specific rank, centrality and noncentral
action hypotheses still require the actual calculations of Lemma 16.3.12 and
the C₂ × (D₈ wreath C₂) model; this module does not assert those calculations.
-/

@[expose] public section

namespace CFSG.Quasithin.Chapter16.ThompsonObstruction
open Subgroup Stellmacher ChapterB
open scoped Pointwise
variable {G : Type*} [Group G] [Finite G]

/-- Ω₁(Φ(J(S))) for the actual maximum-elementary Thompson subgroup. -/
noncomputable def thompsonFrattiniOmega (S : Subgroup G) : Subgroup G :=
  (elementaryAbelianMaxJ S).omegaFrattini

omit [Finite G] in
/-- The elementary Thompson subgroup lies in its defining group. -/
theorem maxJ_le (S : Subgroup G) : elementaryAbelianMaxJ S ≤ S :=
  sSup_le fun _ hA => hA.1

omit [Finite G] in
/-- The Thompson subgroup of a two-group is a two-group. -/
theorem maxJ_isPGroup (S : Subgroup G) (hS : IsPGroup 2 S) :
    IsPGroup 2 (elementaryAbelianMaxJ S) :=
  hS.of_injective (inclusion (maxJ_le S)) (inclusion_injective _)

/-- Equal maximum rank makes the elementary Thompson construction monotone. -/
theorem maxJ_le_of_rank_eq {S R : Subgroup G} (hSR : S ≤ R)
    (hr : twoRank S = twoRank R) : elementaryAbelianMaxJ S ≤ elementaryAbelianMaxJ R := by
  apply (elementaryAbelianMaxOrder_le_and_j_le_of_eq S R hSR).2
  rw [maxOrder_eq_two_pow_rank, maxOrder_eq_two_pow_rank, hr]

/-- The Frattini-omega comparison uses equal elementary ranks and two-group structure. -/
theorem thompsonFrattiniOmega_mono_of_rank_eq {S R : Subgroup G}
    (hS : IsPGroup 2 S) (hR : IsPGroup 2 R) (hSR : S ≤ R)
    (hr : twoRank S = twoRank R) : thompsonFrattiniOmega S ≤ thompsonFrattiniOmega R :=
  omegaFrattini_mono (maxJ_isPGroup S hS) (maxJ_isPGroup R hR)
    (maxJ_le_of_rank_eq hSR hr)

/-- Ambient automorphisms preserve maximum elementary two-rank. -/
theorem twoRank_map_equiv (e : G ≃* G) (S : Subgroup G) :
    twoRank (S.map e.toMonoidHom) = twoRank S := by
  unfold twoRank
  rw [elementaryAbelianMaxOrder_map_equiv]

/-- The local group normalizes Ω₁(Φ(J(-))); normalization is not an extra input. -/
theorem normalizes_thompsonFrattiniOmega (S : Subgroup G) (hS : IsPGroup 2 S) :
    S ≤ normalizer (thompsonFrattiniOmega S : Set G) := by
  have hn : S ≤ normalizer (elementaryAbelianMaxJ S : Set G) := by
    intro g hg
    apply mem_normalizer_iff_map_conj_eq.mpr
    exact (elementaryAbelianMaxJ_map_equiv (MulAut.conj g) S).symm.trans
      (congrArg elementaryAbelianMaxJ (mem_normalizer_iff_map_conj_eq.mp (S.le_normalizer hg)))
  exact hn.trans (normalizer_le_normalizer_omegaFrattini _ (maxJ_isPGroup S hS))

/-- A two-subgroup of full elementary rank embeds, with its Thompson subgroup,
in a conjugate of the chosen ambient Sylow subgroup. -/
theorem exists_sylow_overgroup_with_maxJ_le (T : Sylow 2 G) (P : Subgroup G)
    (hP : IsPGroup 2 P) (hr : twoRank P = twoRank (T : Subgroup G)) :
    ∃ (g : G), P ≤ (g • T : Sylow 2 G) ∧
      elementaryAbelianMaxJ P ≤ elementaryAbelianMaxJ (g • T : Sylow 2 G) := by
  obtain ⟨S, hPS⟩ := hP.exists_le_sylow
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq G T S
  refine ⟨g, hg.symm ▸ hPS, ?_⟩
  apply maxJ_le_of_rank_eq (hg.symm ▸ hPS)
  exact hr.trans (twoRank_map_equiv (MulAut.conj g) (T : Subgroup G)).symm

/-- Transport the Frattini-omega comparison through an ambient automorphism. -/
theorem map_thompsonFrattiniOmega_le_of_rank_eq (e : G ≃* G)
    {P R : Subgroup G} (hP : IsPGroup 2 P) (hR : IsPGroup 2 R)
    (hPR : P.map e.toMonoidHom ≤ R) (hr : twoRank P = twoRank R) :
    (thompsonFrattiniOmega P).map e.toMonoidHom ≤ thompsonFrattiniOmega R := by
  have hJ : (elementaryAbelianMaxJ P).map e.toMonoidHom ≤ elementaryAbelianMaxJ R :=
    (elementaryAbelianMaxJ_map_equiv e P).symm.le.trans
      (maxJ_le_of_rank_eq hPR ((twoRank_map_equiv e P).trans hr))
  exact map_omegaFrattini_le e.toMonoidHom
    (S := elementaryAbelianMaxJ P) (R := elementaryAbelianMaxJ R)
    (maxJ_isPGroup P hP) (maxJ_isPGroup R hR) hJ

/-- Central Frattini-omega in a Sylow subgroup forces the same centrality
in every two-subgroup of equal maximum elementary rank. -/
theorem centralizes_thompsonFrattiniOmega_of_sylow (T : Sylow 2 G) (P : Subgroup G)
    (hP : IsPGroup 2 P) (hr : twoRank P = twoRank (T : Subgroup G))
    (hT : (T : Subgroup G) ≤ centralizer (thompsonFrattiniOmega (T : Subgroup G) : Set G)) :
    P ≤ centralizer (thompsonFrattiniOmega P : Set G) := by
  obtain ⟨S, hPS⟩ := hP.exists_le_sylow
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq G S T
  let e : G ≃* G := MulAut.conj g
  have hST : (S : Subgroup G).map e.toMonoidHom = T := by
    change ((g • S : Sylow 2 G) : Subgroup G) = T
    rw [hg]
  have hPT : P.map e.toMonoidHom ≤ T := (map_mono (f := e.toMonoidHom) hPS).trans hST.le
  have hO : (thompsonFrattiniOmega P).map e.toMonoidHom ≤
      thompsonFrattiniOmega (T : Subgroup G) :=
    map_thompsonFrattiniOmega_le_of_rank_eq e hP T.isPGroup' hPT hr
  intro p hp u hu
  apply e.injective
  simpa only [map_mul, MulEquiv.coe_toMonoidHom] using
    hT (hPT (mem_map_of_mem e.toMonoidHom hp)) (e u)
      (hO (mem_map_of_mem e.toMonoidHom hu))

/-- Construct the ambient Sylow subgroup centralizing the local Frattini-omega,
together with the actual maximal-rank Thompson embedding. -/
theorem exists_sylow_centralizes_thompsonFrattiniOmega (T : Sylow 2 G) (P : Subgroup G)
    (hP : IsPGroup 2 P) (hr : twoRank P = twoRank (T : Subgroup G))
    (hT : (T : Subgroup G) ≤ centralizer (thompsonFrattiniOmega (T : Subgroup G) : Set G)) :
    ∃ g : G, P ≤ (g • T : Sylow 2 G) ∧
      elementaryAbelianMaxJ P ≤ elementaryAbelianMaxJ (g • T : Sylow 2 G) ∧
      ((g • T : Sylow 2 G) : Subgroup G) ≤ centralizer (thompsonFrattiniOmega P : Set G) := by
  obtain ⟨g, hPg, hJg⟩ := exists_sylow_overgroup_with_maxJ_le T P hP hr
  let S : Sylow 2 G := g • T
  have hSP : IsPGroup 2 (S : Subgroup G) := S.isPGroup'
  have hSRank : twoRank (S : Subgroup G) = twoRank (T : Subgroup G) :=
    twoRank_map_equiv (MulAut.conj g) (T : Subgroup G)
  have hOg : thompsonFrattiniOmega P ≤ thompsonFrattiniOmega (S : Subgroup G) :=
    thompsonFrattiniOmega_mono_of_rank_eq hP hSP hPg (hr.trans hSRank.symm)
  have hSC : (S : Subgroup G) ≤
      centralizer (thompsonFrattiniOmega (S : Subgroup G) : Set G) :=
    centralizes_thompsonFrattiniOmega_of_sylow T (S : Subgroup G) hSP hSRank hT
  refine ⟨g, hPg, hJg, ?_⟩
  intro x hx u hu
  exact hSC hx u (hOg hu)

/-- The final Sylow obstruction, with the source-specific computations explicit. -/
theorem impossible_noncentral_thompsonFrattiniOmega (T : Sylow 2 G) (P : Subgroup G)
    (hP : IsPGroup 2 P) (hr : twoRank P = twoRank (T : Subgroup G))
    (hT : (T : Subgroup G) ≤ centralizer (thompsonFrattiniOmega (T : Subgroup G) : Set G))
    (hnoncentral : ¬ P ≤ centralizer (thompsonFrattiniOmega P : Set G)) : False := by
  obtain ⟨g, _, _, hcentral⟩ := exists_sylow_centralizes_thompsonFrattiniOmega T P hP hr hT
  exact hnoncentral ((g • T : Sylow 2 G).normalizing_pSubgroup_le_centralizer
    (thompsonFrattiniOmega P) P hcentral hP (normalizes_thompsonFrattiniOmega P hP))
end CFSG.Quasithin.Chapter16.ThompsonObstruction
