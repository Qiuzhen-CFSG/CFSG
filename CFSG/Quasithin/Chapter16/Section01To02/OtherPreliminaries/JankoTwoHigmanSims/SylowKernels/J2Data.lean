/-- The full symmetric-group restriction kernel consists of even permutations. -/
theorem candidate_sign (i : Index) : Equiv.Perm.sign (candidate i) = 1 := by
  rw [candidate_product]
  simp only [map_mul, single0_sign, single1_sign, single2_sign, single3_sign, single4_sign, single5_sign, one_mul]

theorem centralizer_sign (p : Equiv.Perm (Fin 100)) (hp : ∀ i, Commute p (gen i)) :
    Equiv.Perm.sign p = 1 := by
  obtain ⟨i, rfl⟩ := centralizer_cover p hp
  exact candidate_sign i

