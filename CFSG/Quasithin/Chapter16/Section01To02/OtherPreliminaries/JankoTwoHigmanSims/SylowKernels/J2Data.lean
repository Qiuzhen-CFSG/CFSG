theorem candidate_spec : ∀ i x,
    candidate i x = evalWord gen (orbitWord x) (target i (orbit x)) := by
  decide +kernel

/-- Every permutation commuting with the actual seed generators is in the list. -/
theorem centralizer_cover (p : Equiv.Perm (Fin 100)) (hp : ∀ i, Commute p (gen i)) :
    ∃ i, p = candidate i := by
  obtain ⟨i0, hi0⟩ := allowed0_cover (p (base 0)) (profile_invariant p hp (base 0))
  obtain ⟨i1, hi1⟩ := allowed1_cover (p (base 1)) (profile_invariant p hp (base 1))
  obtain ⟨i2, hi2⟩ := allowed2_cover (p (base 2)) (profile_invariant p hp (base 2))
  obtain ⟨i3, hi3⟩ := allowed3_cover (p (base 3)) (profile_invariant p hp (base 3))
  obtain ⟨i4, hi4⟩ := allowed4_cover (p (base 4)) (profile_invariant p hp (base 4))
  obtain ⟨i5, hi5⟩ := allowed5_cover (p (base 5)) (profile_invariant p hp (base 5))
  let i : Index := ⟨i0, i1, i2, i3, i4, i5⟩
  refine ⟨i, eq_of_orbit_images gen base orbit orbitWord orbitWord_spec
    candidate target candidate_spec p hp i ?_⟩
  intro j
  fin_cases j
  · exact hi0
  · exact hi1
  · exact hi2
  · exact hi3
  · exact hi4
  · exact hi5

