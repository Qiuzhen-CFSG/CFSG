def forward (i : Fin 10) (x : Fin 100) : Fin 100 :=
  ⟨(forwardCode i >>> (7 * x.val)) % 128 % 100, Nat.mod_lt _ (by decide)⟩

def backward (i : Fin 10) (x : Fin 100) : Fin 100 :=
  ⟨(inverseCode i >>> (7 * x.val)) % 128 % 100, Nat.mod_lt _ (by decide)⟩

private theorem left_inverse : ∀ i x, backward i (forward i x) = x := by
  apply allFin
  decide +kernel

private theorem right_inverse : ∀ i x, forward i (backward i x) = x := by
  apply allFin
  decide +kernel

/-- The ten specified permutations, with both inverse identities checked. -/
def generatorPermutation (i : Fin 10) : Equiv.Perm (Fin 100) where
  toFun := forward i
  invFun := backward i
  left_inv := by exact left_inverse i
  right_inv := by exact right_inverse i

private theorem generator_graph : ∀ i, generatorPermutation i ∈ graphGroup := by
  change ∀ i : Fin 10, ∀ x y : Fin 100,
    adjacency (generatorPermutation i x) (generatorPermutation i y) ↔ adjacency x y
  apply allFin
  decide +kernel

/-- Each generator lies in the actual permutation normalizer. -/
def generator (i : Fin 10) : PermutationNormalizer :=
  ⟨generatorPermutation i, by exact graphGroup_le_permutationNormalizer (generator_graph i)⟩

/-- The subgroup to be certified as a Sylow two-subgroup of the normalizer. -/
def candidate : Subgroup PermutationNormalizer := closure (Set.range generator)

/-- Binary products, with the first generator selected by bit zero. -/
def normalForm (n : Fin 1024) : PermutationNormalizer :=
  (List.ofFn (fun i : Fin 10 => generator i ^ (n.val / 2 ^ i.val % 2))).prod

theorem normalForm_mem (n : Fin 1024) : normalForm n ∈ candidate := by
  apply candidate.list_prod_mem
  intro x hx
  obtain ⟨i, rfl⟩ := List.mem_ofFn.mp hx
  exact candidate.pow_mem (subset_closure (Set.mem_range_self i)) _

end CFSG.Quasithin.Chapter16.OtherPreliminaries.JankoTwoHigmanSims.HSOuter.PermutationFusion
