private theorem squares (i : Fin 10) :
    generator i * generator i = ((squareWord i).map generator).prod := by
  have h : ∀ i : Fin 10, ∀ x : Fin 100,
      (generator i * generator i).val x = (((squareWord i).map generator).prod).val x := by
    apply allFin
    decide +kernel
  exact Subtype.ext (Equiv.ext (h i))

private theorem conjugates (i j : Fin 10) (hij : i.val < j.val) :
    (generator i)⁻¹ * generator j * generator i = ((conjugateWord i j).map generator).prod := by
  have h : ∀ i j : Fin 10, i.val < j.val → ∀ x : Fin 100,
      ((generator i)⁻¹ * generator j * generator i).val x =
        (((conjugateWord i j).map generator).prod).val x := by
    apply allFin
    decide +kernel
  exact Subtype.ext (Equiv.ext (h i j hij))

private theorem triangular9 : triangular ([9].map generator) := by
  apply triangular_cons_of_words generator 9 [] (squareWord 9)
    (conjugateWord 9) (squares 9)
  · intro j hj
    have h : ∀ j : Fin 10, j ∈ [] → 9 < j.val := by decide +kernel
    exact conjugates 9 j (h j hj)
  · decide +kernel
  · decide +kernel
  · trivial

