public theorem normalForm_surjective : ∀ x ∈ candidate, ∃ i, normalForm i = x := by
  exact cover_ofFn generator (by
    convert triangular0 using 1
    simp only [List.ofFn_succ, List.ofFn_zero, List.map_cons, List.map_nil]
    rfl)

