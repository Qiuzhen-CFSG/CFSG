private def squareWord (i : Fin 10) : List (Fin 10) :=
  [[], [], [], [], [], [], [], [], [], []][i.val]!

private def conjugateWord (i j : Fin 10) : List (Fin 10) :=
  ([[[0], [2, 6], [1, 6], [3, 8, 9], [3, 4, 5, 7, 8], [5, 6, 8], [6], [6, 7, 9], [8], [9]],
