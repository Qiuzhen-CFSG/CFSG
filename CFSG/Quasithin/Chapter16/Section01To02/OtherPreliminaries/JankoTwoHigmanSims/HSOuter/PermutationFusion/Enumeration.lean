private theorem recover_normalForm : ∀ i : Fin 1024, recover (normalForm i).val = i.val := by
  apply allFin
  decide +kernel

public theorem normalForm_injective : Function.Injective normalForm := by
  intro i j h
  apply Fin.ext
  rw [← recover_normalForm i, ← recover_normalForm j, h]

public theorem candidate_card : Nat.card candidate = 1024 := by
  let f : Fin 1024 → candidate := fun i => ⟨normalForm i, normalForm_mem i⟩
  have hi : Function.Injective f := fun i j h => normalForm_injective (congrArg Subtype.val h)
  have hs : Function.Surjective f := by
    intro x
    obtain ⟨i, hi⟩ := normalForm_surjective x.val x.property
    exact ⟨i, Subtype.ext hi⟩
  exact (Nat.card_congr (Equiv.ofBijective f ⟨hi, hs⟩)).symm.trans (Nat.card_fin 1024)

