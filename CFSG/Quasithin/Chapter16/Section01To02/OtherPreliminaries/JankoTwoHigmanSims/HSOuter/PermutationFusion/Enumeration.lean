   [[0, 3, 5, 8, 9], [1, 3, 4, 6, 9], [2, 4, 5, 7, 8], [3, 6, 7], [4], [5, 7, 9], [6, 7, 8], [8], [7], [7, 8, 9]],
   [[0, 6, 8], [1, 3, 4], [2, 4, 5, 7, 8], [3, 6, 9], [4, 7, 9], [5], [6, 8, 9], [7, 8, 9], [9], [8]],
   [[0], [1], [2], [3, 6, 8], [4, 7, 8], [5, 8, 9], [6], [7], [8], [9]],
   [[0, 6, 9], [1], [2], [3, 6, 8], [4, 7, 8], [5, 8, 9], [6], [7], [8], [9]],
