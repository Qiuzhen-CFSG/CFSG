theorem transition6_pointwise : ∀ (i : Fin 1920) (j : Fin 3),
    screen color6 base6 (prefix5 i * rep5 j) = true →
    ∀ x : Fin 100, (prefix5 i * rep5 j) x = prefix6 (next6 i j) x := by
  have h : ∀ (i : Fin 1920) (j : Fin 3),
      fastScreen color6 base6 (prefix5 i * fastRep5 j) = true →
      ∀ x : Fin 100, (prefix5 i * fastRep5 j) x = prefix6 (next6 i j) x := by
    apply allFin_blocks (t := 60)
    exact transition6_blocks
  simpa only [fastScreen_eq, fastRep5_eq] using h

theorem transition6 (i : Fin 1920) (j : Fin 3)
    (h : screen color6 base6 (prefix5 i * rep5 j) = true) :
    prefix5 i * rep5 j = prefix6 (next6 i j) := by
  apply Equiv.ext
  exact transition6_pointwise i j h

