def next6 (i : Fin 1920) (j : Fin 3) : Fin 1920 :=
  ⟨(row6 i / 2 ^ (11 * j.val)) % 2048 % 1920,
    Nat.mod_lt _ (by decide)⟩

def transition6Check (b : Fin 60) : Prop :=
  ∀ (i : Fin 32) (j : Fin 3),
    fastScreen color6 base6 (prefix5 (blockIndex b i) * fastRep5 j) = true →
    ∀ x : Fin 100, (prefix5 (blockIndex b i) * fastRep5 j) x =
      prefix6 (next6 (blockIndex b i) j) x

