module
public import CFSG.Quasithin.Chapter16.Section01To02.OtherPreliminaries.JankoTwoHigmanSims.HSOuter.ElementaryCentralizer.Data
public import CFSG.Quasithin.Chapter16.Section01To02.OtherPreliminaries.JankoTwoHigmanSims.KernelExclusion

/-!
# A concrete elementary subgroup in the outer HS centralizer

Binary words in four explicitly certified commuting involutions give a
homomorphism from E16 into the centralizer of `elementaryPermutation` in the
exact HS carrier. Evaluation at letter zero distinguishes all sixteen words,
so the homomorphism is injective. Its image Q therefore has an actual
multiplicative equivalence with E16 and is a two-group of order sixteen.
The image equals the subgroup generated by the four words and lies in the
nine-generator candidate centralizer from `Data`.

The exhaustive centralizer calculation and the quotient/kernel-action
calculation are separate obligations. Normality here is not inferred from
GAP's description or from the abstract extension shape.

Source: Aschbacher–Smith 16.1.5(10), printed p.1172; GLS3 Table 5.3m,
class 2C. See `source/` for the untrusted witness generation.
-/

@[expose] public section
namespace CFSG.Quasithin.Chapter16.OtherPreliminaries.JankoTwoHigmanSims.HSOuter.ElementaryCentralizer
open Subgroup
open Sporadic.LeechRelated.HS
open Sporadic.LeechRelated.HS.OrderCertificate (allFin)
set_option maxRecDepth 100000
set_option Elab.async false

/-- The four specified kernel generators commute pairwise. -/
theorem kernelGenerator_commute : ∀ i j, Commute (kernelGenerator i) (kernelGenerator j) := by
  intro i j
  change kernelGenerator i * kernelGenerator j = kernelGenerator j * kernelGenerator i
  apply Subtype.ext
  apply Subtype.ext
  apply Equiv.ext
  have h : ∀ i j : Fin 4, ∀ k : Fin 100,
      (kernelGenerator i).val.val ((kernelGenerator j).val.val k) =
      (kernelGenerator j).val.val ((kernelGenerator i).val.val k) := by
    apply allFin
    decide +kernel
  exact h i j

/-- Each specified kernel generator is an involution or the identity. -/
theorem kernelGenerator_square (i : Fin 4) : kernelGenerator i * kernelGenerator i = 1 := by
  apply Subtype.ext
  apply Subtype.ext
  apply Equiv.ext
  have h : ∀ i : Fin 4, ∀ k : Fin 100,
      (kernelGenerator i).val.val ((kernelGenerator i).val.val k) = k := by
    apply allFin
    decide +kernel
  exact h i

/-- Binary words in the four ordered kernel generators. -/
def kernelWord (x : E16) : C :=
  kernelGenerator 0 ^ (x 0).toAdd.val * kernelGenerator 1 ^ (x 1).toAdd.val *
    kernelGenerator 2 ^ (x 2).toAdd.val * kernelGenerator 3 ^ (x 3).toAdd.val

/-- The faithful binary-coordinate map into the actual centralizer. -/
def kernelHom : E16 →* C where
  toFun := kernelWord
  map_one' := by simp [kernelWord]
  map_mul' x y := by
    apply Subtype.ext
    apply Subtype.ext
    apply Equiv.ext
    have h : ∀ x y : E16, ∀ k : Fin 100,
        (kernelWord (x * y)).val.val k =
        (kernelWord x).val.val ((kernelWord y).val.val k) := by
      decide +kernel
    exact h x y

private theorem word_zero_injective :
    Function.Injective (fun x : E16 => (kernelWord x).val.val 0) := by
  decide +kernel

theorem kernelHom_injective : Function.Injective kernelHom := by
  intro x y h
  apply word_zero_injective
  exact congrArg (fun g : C => g.val.val 0) h

/-- The concrete elementary kernel candidate, as a subgroup of the centralizer. -/
def Q : Subgroup C := kernelHom.range

/-- Actual coordinates on the concrete kernel subgroup. -/
noncomputable def kernelEquiv : Q ≃* E16 := (MonoidHom.ofInjective kernelHom_injective).symm

theorem kernel_card : Nat.card Q = 16 := by
  rw [Nat.card_congr kernelEquiv.toEquiv, Nat.card_eq_fintype_card]
  decide

theorem kernel_isPGroup : IsPGroup 2 Q :=
  IsPGroup.of_card (n := 4) kernel_card

/-- The i-th coordinate vector in the specified E16 model. -/
def kernelBasis (i : Fin 4) : E16 :=
  fun j => if j = i then Multiplicative.ofAdd 1 else 1

theorem kernelHom_basis (i : Fin 4) : kernelHom (kernelBasis i) = kernelGenerator i := by
  apply Subtype.ext
  apply Subtype.ext
  apply Equiv.ext
  have h : ∀ i : Fin 4, ∀ k : Fin 100,
      (kernelWord (kernelBasis i)).val.val k = (kernelGenerator i).val.val k := by
    apply allFin
    decide +kernel
  exact h i

/-- Each of the four specified generators lies in the image. -/
theorem kernelGenerator_mem (i : Fin 4) : kernelGenerator i ∈ Q :=
  ⟨kernelBasis i, kernelHom_basis i⟩

/-- The coordinate image is exactly the subgroup generated by the four words. -/
theorem kernel_eq_closure : Q = closure (Set.range kernelGenerator) := by
  apply le_antisymm
  · rintro _ ⟨x, rfl⟩
    let R := closure (Set.range kernelGenerator)
    have hg (i : Fin 4) : kernelGenerator i ∈ R := Subgroup.subset_closure ⟨i, rfl⟩
    exact R.mul_mem (R.mul_mem (R.mul_mem
      (R.pow_mem (hg 0) _) (R.pow_mem (hg 1) _))
      (R.pow_mem (hg 2) _)) (R.pow_mem (hg 3) _)
  · exact (closure_le _).mpr (by rintro _ ⟨i, rfl⟩; exact kernelGenerator_mem i)

theorem kernel_le_candidate : Q ≤ candidate := by
  rintro _ ⟨x, rfl⟩
  have hg (i : Fin 4) : kernelGenerator i ∈ candidate := by
    apply Subgroup.subset_closure
    refine ⟨⟨i.val, lt_trans i.isLt (by decide)⟩, ?_⟩
    fin_cases i <;> rfl
  exact candidate.mul_mem (candidate.mul_mem (candidate.mul_mem
    (candidate.pow_mem (hg 0) _) (candidate.pow_mem (hg 1) _))
    (candidate.pow_mem (hg 2) _)) (candidate.pow_mem (hg 3) _)

/-- The same kernel regarded inside the finitely generated candidate. -/
def kernelInCandidate : Subgroup candidate := Q.subgroupOf candidate

/-- The kernel restriction retains the exact binary coordinates. -/
noncomputable def kernelInCandidateEquiv : kernelInCandidate ≃* E16 :=
  (Subgroup.subgroupOfEquivOfLe kernel_le_candidate).trans kernelEquiv


end CFSG.Quasithin.Chapter16.OtherPreliminaries.JankoTwoHigmanSims.HSOuter.ElementaryCentralizer
