def image2 (j : Fin 512) (x : Fin 100) : Fin 100 :=
  ⟨(forward2 j >>> (7 * x.val)) % 128 % 100, Nat.mod_lt _ (by decide)⟩

def preimage2 (j : Fin 512) (x : Fin 100) : Fin 100 :=
  ⟨(backward2 j >>> (7 * x.val)) % 128 % 100, Nat.mod_lt _ (by decide)⟩

theorem inverse2 : ∀ j x, preimage2 j (image2 j x) = x := by
  apply allFin
  decide +kernel

def prefix2 (j : Fin 512) : Perm :=
  tablePerm (image2 j) (preimage2 j) (inverse2 j)
    (rightInverse_of_leftInverse_fin (inverse2 j))

def next2 (i : Fin 32) (j : Fin 22) : Fin 512 :=
  ⟨( >>> (9 * (22 * i.val + j.val))) % 512 % 512,
    Nat.mod_lt _ (by decide)⟩

theorem transition2 : ∀ (i : Fin 32) (j : Fin 22),
    screen color2 base2 (prefix1 i * rep1 j) = true →
    prefix1 i * rep1 j = prefix2 (next2 i j) := by
  have h : ∀ (i : Fin 32) (j : Fin 22),
      screen color2 base2 (prefix1 i * rep1 j) = true →
      ∀ x : Fin 100, (prefix1 i * rep1 j) x = prefix2 (next2 i j) x := by
    apply allFin
    decide +kernel
  intro i j hij
  exact Equiv.ext (h i j hij)

