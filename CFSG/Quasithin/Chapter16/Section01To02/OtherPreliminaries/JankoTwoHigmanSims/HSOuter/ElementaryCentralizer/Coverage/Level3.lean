def image3 (j : Fin 1920) (x : Fin 100) : Fin 100 :=
  ⟨(forward3 j >>> (7 * x.val)) % 128 % 100, Nat.mod_lt _ (by decide)⟩

def preimage3 (j : Fin 1920) (x : Fin 100) : Fin 100 :=
  ⟨(backward3 j >>> (7 * x.val)) % 128 % 100, Nat.mod_lt _ (by decide)⟩

theorem inverse3 : ∀ j x, preimage3 j (image3 j x) = x := by
  apply allFin
  decide +kernel

def prefix3 (j : Fin 1920) : Perm :=
  tablePerm (image3 j) (preimage3 j) (inverse3 j)
    (rightInverse_of_leftInverse_fin (inverse3 j))

def next3 (i : Fin 512) (j : Fin 21) : Fin 1920 :=
  ⟨( >>> (11 * (21 * i.val + j.val))) % 2048 % 1920,
    Nat.mod_lt _ (by decide)⟩

theorem transition3_pointwise : ∀ (i : Fin 512) (j : Fin 21),
    screen color3 base3 (prefix2 i * rep2 j) = true →
    ∀ x : Fin 100, (prefix2 i * rep2 j) x = prefix3 (next3 i j) x := by
  apply allFin
  decide +kernel

theorem transition3 (i : Fin 512) (j : Fin 21)
    (h : screen color3 base3 (prefix2 i * rep2 j) = true) :
    prefix2 i * rep2 j = prefix3 (next3 i j) := by
  apply Equiv.ext
  exact transition3_pointwise i j h

