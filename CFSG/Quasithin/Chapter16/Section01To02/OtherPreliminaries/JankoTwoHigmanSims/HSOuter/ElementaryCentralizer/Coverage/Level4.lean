def next4 (i : Fin 1920) (j : Fin 20) : Fin 3840 :=
  ⟨(row4 i / 2 ^ (12 * j.val)) % 4096 % 3840,
    Nat.mod_lt _ (by decide)⟩

def transition4Check (b : Fin 60) : Prop :=
  ∀ (i : Fin 32) (j : Fin 20),
    fastScreen color4 base4 (fastPrefix3 (blockIndex b i) * fastRep3 j) = true →
    ∀ x : Fin 100, (fastPrefix3 (blockIndex b i) * fastRep3 j) x =
      prefix4 (next4 (blockIndex b i) j) x

