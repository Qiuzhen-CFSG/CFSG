theorem transition4_pointwise : ∀ (i : Fin 1920) (j : Fin 20),
    screen color4 base4 (prefix3 i * rep3 j) = true →
    ∀ x : Fin 100, (prefix3 i * rep3 j) x = prefix4 (next4 i j) x := by
  have h : ∀ (i : Fin 1920) (j : Fin 20),
      fastScreen color4 base4 (fastPrefix3 i * fastRep3 j) = true →
      ∀ x : Fin 100, (fastPrefix3 i * fastRep3 j) x = prefix4 (next4 i j) x := by
    apply allFin_blocks (t := 60)
    exact transition4_blocks
  simpa only [fastScreen_eq, fastRep3_eq, fastPrefix3_eq] using h

theorem transition4 (i : Fin 1920) (j : Fin 20)
    (h : screen color4 base4 (prefix3 i * rep3 j) = true) :
    prefix3 i * rep3 j = prefix4 (next4 i j) := by
  apply Equiv.ext
  exact transition4_pointwise i j h

