module
public import CFSG.Quasithin.Chapter16.Section01To02.OtherPreliminaries.JankoTwoHigmanSims.HSOuter.ElementaryCentralizer.Kernel
public import Mathlib.Algebra.Group.Subgroup.Pointwise
public import Mathlib.Data.Fintype.EquivFin

/-!
# Certified five-point action and transversal witnesses

The five marked elements of the concrete elementary subgroup have coordinate
codes 3, 5, 7, 10, 11. Conjugation by each short representative permutes them.
The signed-generator transition table expresses every generated element as a
kernel word times one of 120 representatives. The packed integers are only
witnesses: all permutation identities below are checked by Lean's kernel.

Source: Aschbacher–Smith 16.1.5(10), printed p.1172; GLS3 Table 5.3m,
class 2C. The untrusted data comes from ElementaryCentralizer/source/structure.py.
-/

public section
namespace CFSG.Quasithin.Chapter16.OtherPreliminaries.JankoTwoHigmanSims.HSOuter.ElementaryCentralizer
namespace StructureWitnesses
open Subgroup
open Sporadic.LeechRelated.HS.OrderCertificate (allFin checkFin)
set_option maxRecDepth 100000
set_option Elab.async false


private theorem allFin₂ {n m : Nat} (P : Fin n → Fin m → Prop)
    [∀ i j, Decidable (P i j)]
    (h : checkFin (fun i => checkFin (fun j => decide (P i j))) = true) :
    ∀ i j, P i j := by
  intro i
  apply allFin
  exact allFin (fun i => checkFin (fun j => decide (P i j)) = true)
    (by simpa only [Bool.decide_eq_true] using h) i

private theorem allFin₃ {n m l : Nat} (P : Fin n → Fin m → Fin l → Prop)
    [∀ i j k, Decidable (P i j k)]
    (h : checkFin (fun i => checkFin (fun j => checkFin (fun k => decide (P i j k))))
      = true) : ∀ i j k, P i j k := by
  intro i
  apply allFin₂
  exact allFin (fun i => checkFin (fun j => checkFin (fun k => decide (P i j k))) = true)
    (by simpa only [Bool.decide_eq_true] using h) i

/-- Binary coordinates in the already published E16 model. -/
@[expose] def coordinates (c : Fin 16) : E16 :=
  fun i => Multiplicative.ofAdd ((c.val >>> i.val) % 2 : ZMod 2)

theorem coordinates_surjective : Function.Surjective coordinates := by
  decide +kernel

/-- The nine generators and their inverses, in alternating order. -/
@[expose] def signedGenerator (i : Fin 18) : C :=
  let g := candidateGenerator ⟨i.val / 2, by omega⟩
  if i.val % 2 = 0 then g else g⁻¹

private def letter (i : Fin 19) : C :=
  if h : i.val < 18 then signedGenerator ⟨i.val, h⟩ else 1

private def repLetter (j : Fin 120) (k : Fin 4) : Fin 19 :=
  ⟨( >>> (5 * (4 * j.val + k.val))) % 32 % 19,
    Nat.mod_lt _ (by decide)⟩

/-- A word of length at most four in the signed generators. -/
def representative (j : Fin 120) : C :=
  letter (repLetter j 0) * letter (repLetter j 1) *
    letter (repLetter j 2) * letter (repLetter j 3)

private def actionMap (j : Fin 120) (i : Fin 5) : Fin 5 :=
  ⟨( >>> (3 * (5 * j.val + i.val))) % 8 % 5,
    Nat.mod_lt _ (by decide)⟩

private def actionInvMap (j : Fin 120) (i : Fin 5) : Fin 5 :=
  ⟨( >>> (3 * (5 * j.val + i.val))) % 8 % 5,
    Nat.mod_lt _ (by decide)⟩

private theorem action_left : ∀ j i, actionInvMap j (actionMap j i) = i := by
  apply allFin₂
  decide +kernel

/-- The actual five-point permutation associated to a representative. -/
def representativeAction (j : Fin 120) : S5 :=
  Theory.GroupTheory.tablePerm (actionMap j) (actionInvMap j) (action_left j)
    (Theory.GroupTheory.rightInverse_of_leftInverse_fin (action_left j))

/-- The five specified kernel elements on which conjugation acts. -/
@[expose] def marked (i : Fin 5) : C :=
  kernelHom (coordinates (![3, 5, 7, 10, 11] i))

theorem marked_mem (i : Fin 5) : marked i ∈ Q := ⟨_, rfl⟩

theorem marked_injective : Function.Injective marked := by
  have h : Function.Injective (fun i => (marked i).val.val 0) := by decide +kernel
  exact fun _ _ e => h (congrArg (fun g : C => g.val.val 0) e)

theorem representative_zero : representative 0 = 1 := by
  change 1 * 1 * 1 * 1 = (1 : C)
  simp

theorem representativeAction_zero : representativeAction 0 = 1 := by
  apply Equiv.ext
  decide +kernel

theorem representativeAction_injective : Function.Injective representativeAction := by
  have h : ∀ j k : Fin 120,
      (∀ i : Fin 5, actionMap j i = actionMap k i) → j = k := by
    apply allFin₂
    decide +kernel
  exact fun j k e => h j k (fun i => Equiv.congr_fun e i)

theorem representativeAction_surjective : Function.Surjective representativeAction := by
  apply (Fintype.bijective_iff_injective_and_card representativeAction).mpr
    ⟨representativeAction_injective, by decide⟩ |>.surjective


private def kernelMap (c : Fin 16) (k : Fin 100) : Fin 100 :=
  ⟨( >>> (7 * (100 * c.val + k.val))) % 128 % 100,
    Nat.mod_lt _ (by decide)⟩

private theorem kernel_eval : ∀ c : Fin 16, ∀ k : Fin 100,
    (kernelHom (coordinates c)).val.val k = kernelMap c k := by
  apply allFin₂
  decide +kernel

private def representativeMap (j : Fin 120) (k : Fin 100) : Fin 100 :=
  ⟨( >>> (7 * (100 * j.val + k.val))) % 128 % 100,
    Nat.mod_lt _ (by decide)⟩

private theorem representative_eval : ∀ j : Fin 120, ∀ k : Fin 100,
    (representative j).val.val k = representativeMap j k := by
  apply allFin₂
  decide +kernel

theorem representative_conjugates (j : Fin 120) (i : Fin 5) :
    representative j * marked i = marked (representativeAction j i) * representative j := by
  apply Subtype.ext
  apply Subtype.ext
  apply Equiv.ext
  have h : ∀ j : Fin 120, ∀ i : Fin 5, ∀ k : Fin 100,
      (representative j).val.val ((marked i).val.val k) =
      (marked (representativeAction j i)).val.val ((representative j).val.val k) := by
    simp only [marked, representative_eval, kernel_eval]
    apply allFin₃
    decide +kernel
  exact h j i

private def conjugateCode (s : Fin 18) (c : Fin 16) : Fin 16 :=
  ⟨( >>> (4 * (16 * s.val + c.val))) % 16,
    Nat.mod_lt _ (by decide)⟩

private theorem signed_conjugates_code (s : Fin 18) (c : Fin 16) :
    signedGenerator s * kernelHom (coordinates c) =
      kernelHom (coordinates (conjugateCode s c)) * signedGenerator s := by
  apply Subtype.ext
  apply Subtype.ext
  apply Equiv.ext
  have h : ∀ s : Fin 18, ∀ c : Fin 16, ∀ k : Fin 100,
      (signedGenerator s).val.val ((kernelHom (coordinates c)).val.val k) =
      (kernelHom (coordinates (conjugateCode s c))).val.val ((signedGenerator s).val.val k) := by
    simp only [kernel_eval]
    apply allFin₃
    decide +kernel
  exact h s c

theorem signed_conjugates (s : Fin 18) (x : E16) :
    ∃ y : E16, signedGenerator s * kernelHom x = kernelHom y * signedGenerator s := by
  obtain ⟨c, rfl⟩ := coordinates_surjective x
  exact ⟨_, signed_conjugates_code s c⟩

/-- Next representative in the certified left multiplication table. -/
def nextRepresentative (s : Fin 18) (j : Fin 120) : Fin 120 :=
  ⟨( >>> (7 * (120 * s.val + j.val))) % 128 % 120,
    Nat.mod_lt _ (by decide)⟩

/-- Kernel correction in the same table. -/
def transitionCode (s : Fin 18) (j : Fin 120) : Fin 16 :=
  ⟨( >>> (4 * (120 * s.val + j.val))) % 16,
    Nat.mod_lt _ (by decide)⟩

set_option maxHeartbeats 1000000 in
theorem signed_transition (s : Fin 18) (j : Fin 120) :
    signedGenerator s * representative j =
      kernelHom (coordinates (transitionCode s j)) * representative (nextRepresentative s j) := by
  apply Subtype.ext
  apply Subtype.ext
  apply Equiv.ext
  have h : ∀ s : Fin 18, ∀ j : Fin 120, ∀ k : Fin 100,
      (signedGenerator s).val.val ((representative j).val.val k) =
      (kernelHom (coordinates (transitionCode s j))).val.val
        ((representative (nextRepresentative s j)).val.val k) := by
    simp only [representative_eval, kernel_eval]
    intro s
    fin_cases s <;> apply allFin₂ <;> decide +kernel
  exact h s j

end StructureWitnesses
end CFSG.Quasithin.Chapter16.OtherPreliminaries.JankoTwoHigmanSims.HSOuter.ElementaryCentralizer
