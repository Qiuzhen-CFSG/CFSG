def fastRep3Image (j : Fin 20) (x : Fin 100) : Fin 100 :=
  ⟨(fastRep3Forward j / 2 ^ (7 * x.val)) % 128 % 100, Nat.mod_lt _ (by decide)⟩

def fastRep3Preimage (j : Fin 20) (x : Fin 100) : Fin 100 :=
  ⟨(fastRep3Backward j / 2 ^ (7 * x.val)) % 128 % 100, Nat.mod_lt _ (by decide)⟩

theorem fastRep3_inverse : ∀ j x, fastRep3Preimage j (fastRep3Image j x) = x := by
  apply allFin
  decide +kernel

def fastRep3 (j : Fin 20) : Perm :=
  tablePerm (fastRep3Image j) (fastRep3Preimage j) (fastRep3_inverse j)
    (rightInverse_of_leftInverse_fin (fastRep3_inverse j))

theorem fastRep3_eq (j : Fin 20) : fastRep3 j = rep3 j := by
  have h : ∀ (j : Fin 20) (x : Fin 100), fastRep3 j x = rep3 j x := by
    apply allFin
    decide +kernel
  exact Equiv.ext (h j)

