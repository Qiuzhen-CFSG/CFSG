module

public import CFSG.Quasithin.Chapter16.Section01To02.OtherPreliminaries.JankoTwoHigmanSims.HSOuter.ElementaryCentralizer.Coverage.Level3

/-!
# Fast tables for the original HS chain permutations

Finite witnesses for the centralizer of the specified outer HS involution.
The existing HS order certificate supplies a stabilizer chain. Orbit colors
of its residual groups restrict each successive representative. All finite
identities are checked by Lean's kernel; the generator supplies no trusted facts.

Source: ATLAS HSG1-p100B0; GLS volume 3, Table 5.3m, printed p.274;
Aschbacher–Smith 16.1.5(10), printed p.1172; GLS3 class 2C.
-/

@[expose] public section
namespace CFSG.Quasithin.Chapter16.OtherPreliminaries.JankoTwoHigmanSims.HSOuter.ElementaryCentralizer.Coverage
open Theory.GroupTheory Sporadic.LeechRelated.HS.OrderCertificate
set_option maxRecDepth 100000
set_option Elab.async false

def fastPrefix3Image (i : Fin 1920) (x : Fin 100) : Fin 100 :=
  ⟨(forward3 i / 2 ^ (7 * x.val)) % 128 % 100, Nat.mod_lt _ (by decide)⟩

def fastPrefix3Preimage (i : Fin 1920) (x : Fin 100) : Fin 100 :=
  ⟨(backward3 i / 2 ^ (7 * x.val)) % 128 % 100, Nat.mod_lt _ (by decide)⟩

theorem fastPrefix3Image_eq (i : Fin 1920) (x : Fin 100) :
    fastPrefix3Image i x = image3 i x := by
  simp only [fastPrefix3Image, image3, Nat.shiftRight_eq_div_pow]

theorem fastPrefix3Preimage_eq (i : Fin 1920) (x : Fin 100) :
    fastPrefix3Preimage i x = preimage3 i x := by
  simp only [fastPrefix3Preimage, preimage3, Nat.shiftRight_eq_div_pow]

theorem fastPrefix3_inverse (i : Fin 1920) (x : Fin 100) :
    fastPrefix3Preimage i (fastPrefix3Image i x) = x := by
  rw [fastPrefix3Preimage_eq, fastPrefix3Image_eq]
  exact inverse3 i x

def fastPrefix3 (i : Fin 1920) : Perm :=
  tablePerm (fastPrefix3Image i) (fastPrefix3Preimage i) (fastPrefix3_inverse i)
    (rightInverse_of_leftInverse_fin (fastPrefix3_inverse i))

theorem fastPrefix3_eq (i : Fin 1920) : fastPrefix3 i = prefix3 i :=
  Equiv.ext (fastPrefix3Image_eq i)

