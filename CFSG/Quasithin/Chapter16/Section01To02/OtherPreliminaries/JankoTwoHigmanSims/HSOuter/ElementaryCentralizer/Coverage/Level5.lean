theorem transition5_pointwise : ∀ (i : Fin 3840) (j : Fin 16),
    screen color5 base5 (prefix4 i * rep4 j) = true →
    ∀ x : Fin 100, (prefix4 i * rep4 j) x = prefix5 (next5 i j) x := by
  have h : ∀ (i : Fin 3840) (j : Fin 16),
      fastScreen color5 base5 (prefix4 i * fastRep4 j) = true →
      ∀ x : Fin 100, (prefix4 i * fastRep4 j) x = prefix5 (next5 i j) x := by
    apply allFin_blocks (t := 120)
    exact transition5_blocks
  simpa only [fastScreen_eq, fastRep4_eq] using h

theorem transition5 (i : Fin 3840) (j : Fin 16)
    (h : screen color5 base5 (prefix4 i * rep4 j) = true) :
    prefix4 i * rep4 j = prefix5 (next5 i j) := by
  apply Equiv.ext
  exact transition5_pointwise i j h

