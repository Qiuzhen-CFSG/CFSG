private theorem signature22 : ∀ x, signature c22 x = s22 x := by
  apply allFin
  decide +kernel

private theorem discriminate22 :
    ∀ x y, c22 x = c22 y → s22 x = s22 y → c23 x = c23 y := by
  apply allFin
  decide +kernel

private theorem preserved23 : Preserves [2, 1, 0, 54, 46, 15, 13, 4] c23 :=
  preserves_refine preserved22 signature22 discriminate22

private theorem discrete : Function.Injective c23 := by
  have h : ∀ x y, c23 x = c23 y → x = y := by
    apply allFin
    decide +kernel
  exact h

