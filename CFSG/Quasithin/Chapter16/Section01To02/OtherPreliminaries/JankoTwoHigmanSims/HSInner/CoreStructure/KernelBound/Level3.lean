def color3 (x : Fin 100) : Nat :=
  (41451098636131685411745988631626041747742627687686114557686666267601859764996139051798710521578483674183262863747457990935895051801973829551320230634761280928139798982625959709640935206422610692910413235912832 >>> (7 * x.val)) % 128

def base3 : List (Fin 100) := [0, 4, 2]

theorem residual3_spec {h : Perm} (hh : h ∈ H3) :
    (∀ b ∈ base3, h b = b) ∧ (∀ x, color3 (h x) = color3 x) := by
  exact word_properties gen3 inv3 inv3_spec color3 base3
    (by apply allFin; decide +kernel) hh

