def base2 : List (Fin 100) := [0, 4]

theorem residual2_spec {h : Perm} (hh : h ∈ H2) :
    (∀ b ∈ base2, h b = b) ∧ (∀ x, color2 (h x) = color2 x) := by
  exact word_properties gen2 inv2 inv2_spec color2 base2
    (by apply allFin; decide +kernel) hh

