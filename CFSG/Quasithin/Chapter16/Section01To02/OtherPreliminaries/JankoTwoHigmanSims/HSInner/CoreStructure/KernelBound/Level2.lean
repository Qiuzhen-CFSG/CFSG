def image2 (j : Fin 16) (x : Fin 100) : Fin 100 :=
  ⟨(forward2 j >>> (7 * x.val)) % 128 % 100, Nat.mod_lt _ (by decide)⟩

def preimage2 (j : Fin 16) (x : Fin 100) : Fin 100 :=
  ⟨(backward2 j >>> (7 * x.val)) % 128 % 100, Nat.mod_lt _ (by decide)⟩

theorem inverse2 : ∀ j x, preimage2 j (image2 j x) = x := by
  apply allFin
  decide +kernel

def prefix2 (j : Fin 16) : Perm :=
  tablePerm (image2 j) (preimage2 j) (inverse2 j)
    (rightInverse_of_leftInverse_fin (inverse2 j))

def next2 (i : Fin 2) (j : Fin 22) : Fin 16 :=
