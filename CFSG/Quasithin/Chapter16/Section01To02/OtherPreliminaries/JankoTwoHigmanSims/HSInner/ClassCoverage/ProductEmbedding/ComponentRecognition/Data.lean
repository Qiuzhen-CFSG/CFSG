/-- Breadth-first candidate words, with the identity first. -/
def word (r : Fin 360) : List (Fin 4) := wordList[r.val]!

def transitionCodes : List ℕ :=
  [,
   ,
   ,
   ]

/-- Candidate index of the product of a letter with a row, on the left. -/
def next (i : Fin 4) (r : Fin 360) : Fin 360 :=
  ⟨(transitionCodes[i.val]! >>> (9 * r.val)) % 512 % 360,
    Nat.mod_lt _ (by decide)⟩

/-- The first six-letter generator, a five-cycle. -/
def six0 : Equiv.Perm (Fin 6) :=
  tablePerm ![1, 3, 0, 4, 2, 5] ![2, 0, 4, 1, 3, 5]
    (by decide +kernel) (by decide +kernel)

/-- The second six-letter generator, a double transposition. -/
def six1 : Equiv.Perm (Fin 6) :=
  tablePerm ![0, 3, 2, 1, 5, 4] ![0, 3, 2, 1, 5, 4]
    (by decide +kernel) (by decide +kernel)

theorem six0_even : six0 ∈ alternatingGroup (Fin 6) := by
  change Equiv.Perm.sign six0 = 1
  decide +kernel

theorem six1_even : six1 ∈ alternatingGroup (Fin 6) := by
  change Equiv.Perm.sign six1 = 1
  decide +kernel

/-- The even permutations and their inverses, in the same alphabet as `dLetter`. -/
def sixLetter : Fin 4 → A6 :=
  ![⟨six0, six0_even⟩, ⟨six1, six1_even⟩,
    ⟨six0, six0_even⟩⁻¹, ⟨six1, six1_even⟩⁻¹]

/-- Paired generators: the actual HS words and their proposed six-letter images. -/
def letter (i : Fin 4) : Carrier × A6 := (dLetter i, sixLetter i)

def inverseLetter : Fin 4 → Fin 4 := ![2, 3, 0, 1]

theorem letter_inv (i : Fin 4) : letter (inverseLetter i) = (letter i)⁻¹ := by
  fin_cases i <;> simp [letter, inverseLetter, dLetter, sixLetter]

/-- Each row is an actual word in the paired generators. -/
def row (r : Fin 360) : Carrier × A6 := evalWord letter (word r)

/-- Three images distinguishing the degree-100 rows. -/
def hsKey (p : Equiv.Perm (Fin 100)) : ℕ :=
  (p 0).val + 100 * (p 1).val + 10000 * (p 2).val

/-- Four images distinguishing the degree-six rows. -/
def sixKey (p : Equiv.Perm (Fin 6)) : ℕ :=
  (p 0).val + 6 * (p 1).val + 36 * (p 2).val + 216 * (p 3).val

