  ⟨(inverseLetterRow s >>> (7 * p.val)) % 128 % 100, Nat.mod_lt _ (by decide)⟩
def baseValue (p : Fin 100) : Fin 100 :=
  ⟨(843811775927196729673947449532593537317089694329741588645302424499113013666370232743570134327630271594551697855651270633486469289367328714577583008291430189422105834590648646854016936155603689580554456133930381 >>> (7 * p.val)) % 128 % 100, Nat.mod_lt _ (by decide)⟩
theorem letterValue_spec : ∀ (s : Fin 3) (p : Fin 100),
    letterValue s p = inclusion (ambientLetter s) p := by
  apply allFin
  decide +kernel

theorem inverseLetterValue_spec : ∀ (s : Fin 3) (p : Fin 100),
