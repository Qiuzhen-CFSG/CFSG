module

public import CFSG.Quasithin.Chapter16.Section01To02.OtherPreliminaries.Conventions
public import CFSG.Quasithin.Chapter16.Section01To02.OtherPreliminaries.JankoTwoHigmanSims.KernelExclusion
public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.HS.EvenLocalCandidates.CentralInvolutionCore
public import Theory.GroupAction.AutomorphismFixedTransport
public import Theory.GroupTheory.CharacteristicCentralizerFusion

/-!
# The kernel in the central HS involution class

The first explicit elementary subgroup is generated by the involution `e0`.
Its normalizer is therefore exactly the centralizer of `e0`. This identifies
the entire representative centralizer with the local group on which the
checked pair-kernel construction gives a self-centralizing normal two-subgroup.
Transport along conjugation gives the same kernel condition, and hence excludes
components, for every member of this class.

Source: Aschbacher–Smith, 16.1.5(10) and 16.1.7(h), printed pp.1172–1173;
GLS3, Table 5.3m. The exact extension shape and coverage of the other class
are separate model obligations.
-/

public section
namespace CFSG.Quasithin.Chapter16.OtherPreliminaries.JankoTwoHigmanSims.HSInner
open Subgroup Theory.GroupTheory
open Sporadic.LeechRelated.HS Sporadic.LeechRelated.HS.EvenLocalCandidates
open Sporadic.LeechRelated.HS.EvenLocalCandidates.CentralInvolutionCore

/-- The explicit central-class representative is an involution in the fixed carrier. -/
theorem central_involution_order : orderOf e0 = 2 :=
  orderOf_eq_prime_iff.mpr ⟨by simpa [pow_two] using e0_mul, e0_nontrivial⟩

/-- The first elementary candidate is precisely the subgroup generated by `e0`. -/
theorem elementary_zero_eq_zpowers : elementary 0 = zpowers e0 := by
  rw [zpowers_eq_closure]
  unfold elementary
  congr 1
  ext x
  constructor
  · rintro ⟨j, hj, rfl⟩
    have hj0 : j = 0 := Fin.ext (by simpa using hj)
    subst j
    rfl
  · rintro rfl
    exact ⟨(0 : Fin 3), by simp, rfl⟩

/-- The full local normalizer is the representative involution centralizer. -/
theorem localGroup_zero_eq_centralizer :
    localGroup 0 = centralizer ({e0} : Set Carrier) := by
  rw [localGroup, elementary_zero_eq_zpowers]
  exact normalizer_zpowers_eq_centralizer_of_order_two e0 central_involution_order

/-- A group isomorphism transports the normal kernel and its centralizer condition. -/
theorem selfCentralizing_transport {C D : Type*} [Group C] [Group D] (e : C ≃* D)
    (h : HasSelfCentralizingNormalTwoSubgroup C) :
    HasSelfCentralizingNormalTwoSubgroup D := by
  obtain ⟨Q, hN, hp, hc⟩ := h
  refine ⟨Q.map e.toMonoidHom, hN.map e.toMonoidHom e.surjective,
    hp.of_equiv (e.subgroupMap Q), ?_⟩
  intro d hd
  refine ⟨e.symm d, hc ?_, e.apply_symm_apply d⟩
  intro c hc
  apply e.injective
  simpa only [map_mul, e.apply_symm_apply] using
    hd (e c) (mem_map_of_mem e.toMonoidHom hc)

/-- The representative centralizer has a proved normal self-centralizing two-kernel. -/
theorem centralizer_selfCentralizing :
    HasSelfCentralizingNormalTwoSubgroup (centralizer ({e0} : Set Carrier)) := by
  rw [← localGroup_zero_eq_centralizer]
  obtain ⟨Q, hN, hp, hc⟩ := exists_normal_selfCentralizing_two_subgroup
  exact ⟨Q, hN, hp, hc⟩

/-- Conjugate elements have isomorphic full fixed subgroups of their inner actions. -/
theorem fixed_equiv_centralizer_of_isConj {x y : Carrier} (h : IsConj x y) :
    Nonempty ((MulAut.conj y).fixedSubgroup ≃* centralizer ({x} : Set Carrier)) := by
  obtain ⟨g, hg⟩ := isConj_iff.mp h
  have he : MulAut.conj y = MulAut.congr (MulAut.conj g) (MulAut.conj x) := by
    rw [MulAut.congr_conj]
    exact congrArg MulAut.conj hg.symm
  rw [he]
  exact ⟨(MulAut.fixedSubgroupCongr (MulAut.conj g) (MulAut.conj x)).symm.trans
    (MulEquiv.subgroupCongr (MulAut.fixedSubgroup_conj x))⟩

/-- The actual fixed subgroup in the entire central class inherits the kernel. -/
theorem central_class_selfCentralizing {x : Carrier} (hx : IsConj e0 x) :
    HasSelfCentralizingNormalTwoSubgroup (MulAut.conj x).fixedSubgroup := by
  obtain ⟨e⟩ := fixed_equiv_centralizer_of_isConj hx
  exact selfCentralizing_transport e.symm centralizer_selfCentralizing

/-- No component occurs in the central inner class. -/
theorem central_class_not_isComponent {x : Carrier} (hx : IsConj e0 x)
    (K : Subgroup (MulAut.conj x).fixedSubgroup) :
    ¬ IsComponent (MulAut.conj x).fixedSubgroup K :=
  (central_class_selfCentralizing hx).not_isComponent K

end CFSG.Quasithin.Chapter16.OtherPreliminaries.JankoTwoHigmanSims.HSInner
