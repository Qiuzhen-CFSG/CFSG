module

public import CFSG.Quasithin.Chapter16.Defs
public import CFSG.Quasithin.Chapter16.Section01To02.SourceHypothesis
public import Theory.GroupTheory.SolvableResidual
public import Theory.GroupAction.SubgroupConjugation

/-!
# The group-theoretic setup for component transfer

The enlargement in Aschbacher–Smith, 16.1.7–16.1.8 (printed pp.1172–1173)
is the subgroup generated by the conjugates of L under E(C_G(i)). Components,
centralizers, and the solvable residual are retained as actual subgroups of G.

The elementary deductions here restrict components to overgroups, restrict a
Sylow subgroup to a subnormal subgroup, and compare the two centralizer indices.
No classification of involutory automorphisms or component-transfer conclusion
is assumed by these deductions.
-/

@[expose] public section

namespace CFSG.Quasithin.Chapter16.ComponentTransfer

open Subgroup Theory.GroupTheory

variable {G : Type*} [Group G]

/-- Component membership relative to an overgroup, including containment. -/
def IsComponentIn (L H : Subgroup G) : Prop :=
  L ≤ H ∧ IsComponent H (L.subgroupOf H)

/-- The centralizer C_H(t), embedded in the original group. -/
def centralizerIn (H : Subgroup G) (t : G) : Subgroup G :=
  H ⊓ involutionCentralizer t

/-- The actual solvable residual C_H(t)^∞, embedded in G. -/
def centralizerResidual (H : Subgroup G) (t : G) : Subgroup G :=
  (solvableResidual (centralizerIn H t)).map (centralizerIn H t).subtype

/-- The actual layer E(H), embedded in G. -/
def layerIn (H : Subgroup G) : Subgroup G :=
  (componentLayer H).map H.subtype

/-- The normal closure under E(H) used in I.3.2 when O(H) is trivial. -/
def layerClosure (H L : Subgroup G) : Subgroup G :=
  componentOrbit L (layerIn H)

/-- The local input of 16.1.7, without any of its conclusions. -/
structure Setup (t i : G) (L : Subgroup G) : Prop where
  involution_t : orderOf t = 2
  involution_i : orderOf i = 2
  component : IsCentralizerComponent t L
  centralizes : i ∈ centralizer ((zpowers t ⊔ L : Subgroup G) : Set G)

variable {L H J : Subgroup G} {t i : G}

/-- Relative component membership gives quasisimplicity of the actual subgroup. -/
theorem IsComponentIn.quasisimple (h : IsComponentIn L H) : IsQuasisimple L := by
  let := h.2.2
  exact IsQuasisimple.of_mulEquiv (subgroupOfEquivOfLe h.1)

/-- Components remain components upon restriction to an intermediate overgroup. -/
theorem IsComponentIn.restrict (h : IsComponentIn L H) (hLJ : L ≤ J) (hJH : J ≤ H) :
    IsComponentIn L J := by
  let e := subgroupOfEquivOfLe hJH
  have hc := (h.2.subgroupOf (show L.subgroupOf H ≤ J.subgroupOf H from
    fun _ hx => hLJ hx)).map_equiv e
  have he : ((L.subgroupOf H).subgroupOf (J.subgroupOf H)).map e.toMonoidHom =
      L.subgroupOf J := by
    ext x
    constructor
    · rintro ⟨y, hy, rfl⟩
      exact hy
    · intro hx
      exact ⟨⟨⟨x, hJH x.property⟩, x.property⟩, hx, rfl⟩
  exact ⟨hLJ, he ▸ hc⟩

/-- Commutation of the two involutions places t in C_G(i). -/
theorem Setup.t_mem (h : Setup t i L) : t ∈ involutionCentralizer i := by
  exact mem_centralizer_singleton_iff.mpr
    (mem_centralizer_iff.mp h.centralizes t
      ((le_sup_left : zpowers t ≤ zpowers t ⊔ L) (mem_zpowers t)))

/-- The seed component is contained in C_G(i). -/
theorem Setup.le_centralizer (h : Setup t i L) : L ≤ involutionCentralizer i := by
  intro x hx
  exact mem_centralizer_singleton_iff.mpr
    (mem_centralizer_iff.mp h.centralizes x
      ((le_sup_right : L ≤ zpowers t ⊔ L) hx))

/-- L is a component of the joint centralizer, the input to I.3.2. -/
theorem Setup.component_in_jointCentralizer (h : Setup t i L) :
    IsComponentIn L (centralizerIn (involutionCentralizer i) t) :=
  IsComponentIn.restrict h.component (le_inf h.le_centralizer h.component.1) inf_le_right

/-- An embedded layer lies in its overgroup. -/
theorem layerIn_le (H : Subgroup G) : layerIn H ≤ H := by
  rintro _ ⟨x, _, rfl⟩
  exact x.property

/-- The closure contains its seed. -/
theorem le_layerClosure (H L : Subgroup G) : L ≤ layerClosure H L :=
  le_componentOrbit L (layerIn H)

/-- The actual layer closure stays in the specified overgroup. -/
theorem layerClosure_le (hLH : L ≤ H) : layerClosure H L ≤ H :=
  (componentOrbit_le_sup L (layerIn H)).trans (sup_le hLH (layerIn_le H))

/-- In particular the source enlargement stays inside C_G(i). -/
theorem Setup.closure_le_centralizer (h : Setup t i L) :
    layerClosure (involutionCentralizer i) L ≤ involutionCentralizer i :=
  layerClosure_le h.le_centralizer

/-- Restrict a supplied Sylow subgroup of H to a subgroup subnormal in H,
retaining the literal intersection under the ambient inclusion. -/
theorem exists_restricted_sylow [Finite G] (hJH : J ≤ H)
    (hJ : (J.subgroupOf H).IsSubnormal) (S : Sylow 2 H) :
    ∃ R : Sylow 2 J,
      (R : Subgroup J).map J.subtype =
        ((S : Subgroup H).map H.subtype) ⊓ J := by
  obtain ⟨R, hR⟩ := S.exists_subgroupOf_eq_of_subnormal (J.subgroupOf H) hJ
  let e := subgroupOfEquivOfLe hJH
  refine ⟨R.mapSurjective (f := e.toMonoidHom) e.surjective, ?_⟩
  change ((R : Subgroup (J.subgroupOf H)).map e.toMonoidHom).map J.subtype = _
  rw [hR]
  ext x
  constructor
  · rintro ⟨y, ⟨z, hz, rfl⟩, rfl⟩
    exact ⟨⟨z.val, hz, rfl⟩, z.property⟩
  · rintro ⟨⟨y, hy, rfl⟩, hx⟩
    exact ⟨⟨y, hx⟩, ⟨⟨y, hx⟩, hy, rfl⟩, rfl⟩

/-- The centralizer index cannot increase on restriction to a subgroup.
This does not require t to normalize either subgroup. -/
theorem centralizer_index_le [Finite G] (A B : Subgroup G) (hAB : A ≤ B) (t : G) :
    (involutionCentralizer t).relIndex A ≤ (involutionCentralizer t).relIndex B :=
  relIndex_le_of_le_right hAB Subgroup.index_ne_zero_of_finite

/-- The exact Sylow restriction and index comparison used in 16.1.8. -/
theorem exists_restricted_sylow_with_index_le [Finite G] (hJH : J ≤ H)
    (hJ : (J.subgroupOf H).IsSubnormal) (S : Sylow 2 H) (t : G) :
    ∃ R : Sylow 2 J,
      (R : Subgroup J).map J.subtype = ((S : Subgroup H).map H.subtype) ⊓ J ∧
      (involutionCentralizer t).relIndex ((R : Subgroup J).map J.subtype) ≤
        (involutionCentralizer t).relIndex ((S : Subgroup H).map H.subtype) := by
  obtain ⟨R, hR⟩ := exists_restricted_sylow hJH hJ S
  exact ⟨R, hR, centralizer_index_le _ _ (hR.le.trans inf_le_left) t⟩

/-- A normalized quasisimple subgroup is either centralized by t or is generated
by its commutators with t. This supplies the commutator clause of 16.1.7(3). -/
theorem quasisimple_commutator_dichotomy (K : Subgroup G) [IsQuasisimple K]
    (t : G) (hn : t ∈ normalizer K) :
    K ≤ involutionCentralizer t ∨ ⁅K, zpowers t⁆ = K := by
  let N := ⁅K, zpowers t⁆
  have hNK : N ≤ K := le_normalizer_iff_commutator_le_left.mp (zpowers_le.mpr hn)
  let : (N.subgroupOf K).Normal :=
    (normal_subgroupOf_iff_le_normalizer hNK).mpr
      (normalizer_commutator_ge_left K (zpowers t))
  rcases IsQuasisimple.normal_le_center_or_eq_top (N.subgroupOf K) with hc | he
  · left
    have hb : ⁅N.subgroupOf K, (⊤ : Subgroup K)⁆ = ⊥ :=
      commutator_top_right_eq_bot_iff_le_center.mpr hc
    have hm := congrArg (Subgroup.map K.subtype) hb
    have hb' : ⁅N, K⁆ = ⊥ := by
      simpa only [map_commutator, map_subgroupOf_eq_of_le hNK,
        ← MonoidHom.range_eq_map, range_subtype, Subgroup.map_bot] using hm
    have hzero : ⁅zpowers t, K⁆ = ⊥ :=
      commutator_eq_bot_of_iterated_eq_bot (zpowers t) K (by
        simpa only [N, commutator_comm (zpowers t) K] using hb')
    have ht : t ∈ centralizer (K : Set G) :=
      (commutator_eq_bot_iff_le_centralizer.mp hzero) (mem_zpowers t)
    exact fun x hx => mem_centralizer_singleton_iff.mpr (mem_centralizer_iff.mp ht x hx)
  · exact Or.inr (le_antisymm hNK (subgroupOf_eq_top.mp he))

/-- If the centralizer component is properly contained in a quasisimple
normalized overgroup, the involution cannot centralize that whole overgroup. -/
theorem commutator_eq_self_of_proper (hL : IsCentralizerComponent t L)
    (K : Subgroup G) [IsQuasisimple K] (hLK : L < K) (htK : t ∈ normalizer K) :
    ⁅K, zpowers t⁆ = K := by
  rcases quasisimple_commutator_dichotomy K t htK with hc | he
  · have hcomp : IsComponentIn L K :=
      IsComponentIn.restrict hL hLK.le hc
    rcases IsQuasisimple.subnormal_le_center_or_eq_top (L.subgroupOf K) hcomp.2.1 with
      hcentral | htop
    · let := hcomp.2.2
      have hcomm : ⁅L.subgroupOf K, L.subgroupOf K⁆ = ⊥ :=
        le_bot_iff.mp ((commutator_mono hcentral le_top).trans
          (commutator_center_left (⊤ : Subgroup K)).le)
      rw [commutator_eq_self] at hcomm
      let : IsSimpleGroup ((L.subgroupOf K) ⧸ center (L.subgroupOf K)) :=
        IsQuasisimple.simple
      have : Nontrivial (L.subgroupOf K) :=
        (QuotientGroup.mk'_surjective (center (L.subgroupOf K))).nontrivial
      exact ((nontrivial_iff_ne_bot _).mp inferInstance hcomm).elim
    · exact (hLK.not_ge (subgroupOf_eq_top.mp htop)).elim
  · exact he

end CFSG.Quasithin.Chapter16.ComponentTransfer
