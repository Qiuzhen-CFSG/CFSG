module
public import CFSG.Quasithin.Chapter16.Section01To02.CounterexampleGeometry.Basic

/-!
# The intersection-generated subgroup in 16.2.10

The group H₀ is generated by all conjugators producing a nonidentity
intersection between either pair of the two Sylow intersections. Conjugating
both members back to the second one reduces every generator to a self
intersection. The even-intersection conclusion of 16.2.8(1) then puts it in H.
This construction is independent of the fusion theorem in Aschbacher (1975),
Lemma 3.4, and does not presume that H₀ equals H.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*,
Lemma 16.2.10, printed pp.1175–1176.
-/

@[expose] public section
namespace CFSG.Quasithin.Chapter16.CounterexampleGeometry.StrongClosure
open Subgroup Theory.GroupTheory

variable {G : Type*} [Group G]

/-- The actual subgroup generated by nontrivial pair-intersection conjugators. -/
def intersectionGenerated (A B : Subgroup G) : Subgroup G :=
  closure {g | ∃ C ∈ ({A, B} : Set (Subgroup G)),
    ∃ D ∈ ({A, B} : Set (Subgroup G)), conjugate C g ⊓ D ≠ ⊥}

/-- A nontrivial member of the pair lies in its intersection-generated group. -/
theorem left_le_intersectionGenerated {A B : Subgroup G} (hA : A ≠ ⊥) :
    A ≤ intersectionGenerated A B := by
  intro x hx
  apply Subgroup.subset_closure
  refine ⟨A, by simp, A, by simp, ?_⟩
  rw [(mem_normalizer_iff_conjugate_eq A x).mp (Subgroup.le_normalizer hx), inf_idem]
  exact hA

/-- The same containment for the second nontrivial member. -/
theorem right_le_intersectionGenerated {A B : Subgroup G} (hB : B ≠ ⊥) :
    B ≤ intersectionGenerated A B := by
  intro x hx
  apply Subgroup.subset_closure
  refine ⟨B, by simp, B, by simp, ?_⟩
  rw [(mem_normalizer_iff_conjugate_eq B x).mp (Subgroup.le_normalizer hx), inf_idem]
  exact hB

/-- All generators lie in H after normalizing both members of the pair. -/
theorem intersectionGenerated_le {A B H : Subgroup G} {u : G}
    (hu : u ∈ H) (hAB : conjugate A u = B)
    (hself : ∀ g : G, conjugate B g ⊓ B ≠ ⊥ → g ∈ H) :
    intersectionGenerated A B ≤ H := by
  have repr : ∀ C ∈ ({A, B} : Set (Subgroup G)),
      ∃ w ∈ H, C = conjugate B w := by
    intro C hC
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hC
    rcases hC with hC | hC
    · subst C
      refine ⟨u⁻¹, H.inv_mem hu, ?_⟩
      rw [← hAB, conjugate_conjugate, mul_inv_cancel, conjugate_one]
    · subst C
      exact ⟨1, H.one_mem, (conjugate_one B).symm⟩
  apply (closure_le H).mpr
  rintro g ⟨C, hC, D, hD, hcap⟩
  obtain ⟨w, hw, rfl⟩ := repr C hC
  obtain ⟨v, hv, rfl⟩ := repr D hD
  have hn : conjugate (conjugate (conjugate B w) g ⊓ conjugate B v) v⁻¹ ≠ ⊥ := by
    intro he
    apply hcap
    apply conjugate_injective v⁻¹
    simpa [conjugate] using he
  have he : conjugate (conjugate (conjugate B w) g ⊓ conjugate B v) v⁻¹ =
      conjugate B (w * g * v⁻¹) ⊓ B := by
    rw [conjugate, map_inf _ _ _ (MulAut.conj (v⁻¹)⁻¹).injective]
    change conjugate (conjugate (conjugate B w) g) v⁻¹ ⊓
      conjugate (conjugate B v) v⁻¹ = _
    simp only [conjugate_conjugate, mul_inv_cancel, conjugate_one]
  rw [he] at hn
  have hg := hself (w * g * v⁻¹) hn
  simpa [mul_assoc] using H.mul_mem (H.mul_mem (H.inv_mem hw) hg) hv

/-- A nontrivial intersection of Sylow two-subgroups gives an even
intersection of the source containers. -/
theorem self_intersection_mem [Finite G] {T : Sylow 2 G} {L H : Subgroup G}
    {u z : G}
    (intersection : ∀ g : G,
      Even (Nat.card (involutionContainer z L u ⊓
        conjugate (involutionContainer z L u) g : Subgroup G)) → g ∈ H)
    (g : G)
    (hcap : conjugate (componentSylow T (conjugate L u)) g ⊓
      componentSylow T (conjugate L u) ≠ ⊥) : g ∈ H := by
  apply intersection
  let P := conjugate (componentSylow T (conjugate L u)) g ⊓
    componentSylow T (conjugate L u)
  have hP : IsPGroup 2 P :=
    (T.isPGroup'.to_le (show componentSylow T (conjugate L u) ≤ T from
      inf_le_left)).to_inf_right
  have hle : P ≤ involutionContainer z L u ⊓ conjugate (involutionContainer z L u) g := by
    apply le_inf
    · exact inf_le_right.trans (inf_le_right.trans le_sup_right)
    · exact inf_le_left.trans (map_mono (inf_le_right.trans le_sup_right))
  rcases hP.card_eq_or_dvd with hone | heven
  · exact (hcap (Subgroup.card_eq_one.mp hone)).elim
  · exact even_iff_two_dvd.mpr (heven.trans (Subgroup.card_dvd_of_le hle))

end CFSG.Quasithin.Chapter16.CounterexampleGeometry.StrongClosure
end
