module

public import CFSG.Quasithin.Chapter16.Section01To02.CounterexampleGeometry.StrongClosure.SourceStatements
public import CFSG.Quasithin.Chapter16.Section01To02.CounterexampleGeometry.StrongClosure.GlobalClosure.ContraryFusion.CentralImage
public import CFSG.Quasithin.Chapter16.Section01To02.CounterexampleGeometry.StrongClosure.GlobalClosure.ContraryFusion.CentralDiagonal

/-!
# Eliminating the actual central diagonal by quotient induction

For the source diagonal y = u uᵗ, with u of order four, the order-two
intersection is generated by u². The central involution y lies outside
both factors, so the quotient map by ⟨y⟩ is injective on each. Their image
ranks and orders are therefore preserved. The common order-four image of u
excludes the exceptional conclusion in the quotient. `central_image_factors_eq`
constructs the genuine quotient hypotheses and eliminates every other
alternative except equality of the image factors.

That equality forces A₁ into the cyclic group generated by u. Its elementary
four-subgroup then contradicts the order of u. All quotient rank, kernel,
Sylow, and intersection premises are discharged here from the central diagonal.

Source: Aschbacher, *On finite groups of component type* (1975), Lemma 3.4,
printed p.95, from “Thus y ∈ Z(G)” through the conclusion of (e).
-/

@[expose] public section
open Subgroup Theory.GroupTheory BenderSuzuki.PFchapter1section1
namespace CFSG.Quasithin.Chapter16.CounterexampleGeometry.StrongClosure.Asc75
universe u
variable {G : Type u} [Group G] [Finite G] {S : Sylow 2 G} {A₁ A₂ : Subgroup G}

private theorem mem_involution_powers {y x : G} (hy : orderOf y = 2)
    (hx : x ∈ zpowers y) : x = 1 ∨ x = y := by
  classical
  rw [mem_zpowers_iff_mem_range_orderOf, hy] at hx
  obtain ⟨n, hn, rfl⟩ := Finset.mem_image.mp hx
  have hnlt : n < 2 := Finset.mem_range.mp hn
  interval_cases n <;> simp

omit [Finite G] in
private theorem rank_of_equiv {B : Type*} [Group B] (e : G ≃* B)
    (h : TwoRankAtLeastTwo G) : TwoRankAtLeastTwo B := by
  obtain ⟨E, hE, hs⟩ := h
  refine ⟨E.map e.toMonoidHom, (card_map_of_injective e.injective).trans hE, ?_⟩
  intro x
  obtain ⟨v, hv, he⟩ := x.property
  apply Subtype.ext
  change (x : B) ^ 2 = 1
  rw [← he, ← map_pow]
  have hv2 : v ^ 2 = 1 := congrArg Subtype.val (hs ⟨v, hv⟩)
  rw [hv2, map_one]

theorem MinimalCounterexample.not_centralDiagonal
    (m : MinimalCounterexample S A₁ A₂) (l : LocalControl S A₁ A₂)
    {t : G} (ht : t ∈ S) (d : CentralDiagonal A₁ A₂ t) : False := by
  obtain ⟨u, huA, hu4, hy2, hyZ⟩ := d.diagonal
  let v := t⁻¹ * u * t
  let y := u * v
  have hvB : v ∈ A₂ := by
    rw [← d.swaps]
    exact mem_map.mpr ⟨u, huA, by simp [v]⟩
  have hv4 : orderOf v = 4 := by
    simpa only [v, MulAut.conj_apply, inv_inv] using (MulAut.conj t⁻¹).orderOf_eq u |>.trans hu4
  have hcomm : Commute u v :=
    (mem_centralizer_iff.mp (commutator_eq_bot_iff_le_centralizer.mp m.setup.commute huA) v hvB).symm
  have hprod : u ^ 2 * v ^ 2 = 1 := by
    rw [← hcomm.mul_pow]
    exact (orderOf_eq_prime_iff.mp hy2).1
  have hu2B : u ^ 2 ∈ A₂ := by
    rw [eq_inv_of_mul_eq_one_left hprod]
    exact A₂.inv_mem (A₂.pow_mem hvB 2)
  have hu22 : orderOf (u ^ 2) = 2 := by
    rw [orderOf_pow' u (n := 2) (by decide), hu4]
    norm_num
  have hcap : A₁ ⊓ A₂ = zpowers (u ^ 2) := by
    have hle : zpowers (u ^ 2) ≤ A₁ ⊓ A₂ := zpowers_le.mpr ⟨A₁.pow_mem huA 2, hu2B⟩
    apply (eq_of_le_of_card_ge hle ?_).symm
    rw [Nat.card_zpowers, hu22, d.intersection_card]
  have hyA : y ∉ A₁ := by
    intro hyA
    have hvA : v ∈ A₁ := by
      simpa only [y, inv_mul_cancel_left] using A₁.mul_mem (A₁.inv_mem huA) hyA
    have hh := orderOf_dvd_natCard (⟨v, hvA, hvB⟩ : (A₁ ⊓ A₂ : Subgroup G))
    rw [← Subgroup.orderOf_coe (⟨v, hvA, hvB⟩ : (A₁ ⊓ A₂ : Subgroup G)), hv4,
      d.intersection_card] at hh
    norm_num at hh
  have hyB : y ∉ A₂ := by
    intro hyB
    have huB : u ∈ A₂ := by
      simpa only [y, mul_inv_cancel_right] using A₂.mul_mem hyB (A₂.inv_mem hvB)
    have hh := orderOf_dvd_natCard (⟨u, huA, huB⟩ : (A₁ ⊓ A₂ : Subgroup G))
    rw [← Subgroup.orderOf_coe (⟨u, huA, huB⟩ : (A₁ ⊓ A₂ : Subgroup G)), hu4,
      d.intersection_card] at hh
    norm_num at hh
  let Z := zpowers y
  have hZ : Z ≤ center G := zpowers_le.mpr hyZ
  let : Z.Normal := ⟨by
    intro z hz g
    have hc := mem_center_iff.mp (hZ hz) g
    simpa only [hc, mul_inv_cancel_right] using hz⟩
  let q := QuotientGroup.mk' Z
  have hq : Function.Surjective q := QuotientGroup.mk'_surjective Z
  have hker : q.ker = Z := QuotientGroup.ker_mk' Z
  have hyS : y ∈ S := (S : Subgroup G).mul_mem (m.setup.left_le huA)
    ((S : Subgroup G).mul_mem ((S : Subgroup G).mul_mem
      ((S : Subgroup G).inv_mem ht) (m.setup.left_le huA)) ht)
  have hZS : q.ker ≤ (S : Subgroup G) := by
    rw [hker]
    exact zpowers_le.mpr hyS
  have hinj (B : Subgroup G) (hyB : y ∉ B) :
      Function.Injective (q.subgroupMap B) := by
    apply (injective_iff_map_eq_one _).mpr
    intro a ha
    have haZ : (a : G) ∈ Z := by
      have he := congrArg Subtype.val ha
      exact (QuotientGroup.eq_one_iff _).mp he
    rcases mem_involution_powers hy2 haZ with he | he
    · exact Subtype.ext he
    · apply (hyB ?_).elim
      have he' : (a : G) = y := he
      rw [← he']
      exact a.property
  let e₁ := MulEquiv.ofBijective (q.subgroupMap A₁) ⟨hinj A₁ hyA, q.subgroupMap_surjective A₁⟩
  let e₂ := MulEquiv.ofBijective (q.subgroupMap A₂) ⟨hinj A₂ hyB, q.subgroupMap_surjective A₂⟩
  have hr₁ := rank_of_equiv e₁ m.setup.left_rank
  have hr₂ := rank_of_equiv e₂ m.setup.right_rank
  have hcard : Nat.card (A₁.map q) = Nat.card (A₂.map q) := by
    rw [← Nat.card_congr e₁.toEquiv, ← Nat.card_congr e₂.toEquiv, ← d.swaps]
    exact (card_map_of_injective (MulAut.conj t⁻¹).injective).symm
  have hqu4 : orderOf (q u) = 4 := by
    have hh := e₁.orderOf_eq (⟨u, huA⟩ : A₁)
    change orderOf (e₁ ⟨u, huA⟩) = orderOf (⟨u, huA⟩ : A₁) at hh
    rw [← Subgroup.orderOf_coe (e₁ ⟨u, huA⟩), Subgroup.orderOf_mk] at hh
    exact hh.trans hu4
  have hyq : q y = 1 := (QuotientGroup.eq_one_iff _).mpr (mem_zpowers y)
  have hquB : q u ∈ A₂.map q := by
    have he : q u * q v = 1 := by simpa only [y, map_mul] using hyq
    rw [eq_inv_of_mul_eq_one_left he]
    exact (A₂.map q).inv_mem (mem_map_of_mem q hvB)
  have hcapq : Nat.card (A₁.map q ⊓ A₂.map q : Subgroup (G ⧸ Z)) ≠ 2 := by
    intro he
    have hd := orderOf_dvd_natCard (⟨q u, mem_map_of_mem q huA, hquB⟩ :
      (A₁.map q ⊓ A₂.map q : Subgroup (G ⧸ Z)))
    rw [← Subgroup.orderOf_coe (⟨q u, mem_map_of_mem q huA, hquB⟩ :
      (A₁.map q ⊓ A₂.map q : Subgroup (G ⧸ Z))), hqu4, he] at hd
    norm_num at hd
  have hsmall : Nat.card (G ⧸ Z) < Nat.card G := by
    have hh := card_eq_card_quotient_mul_card_subgroup Z
    have hzcard : Nat.card Z = 2 := (Nat.card_zpowers y).trans hy2
    rw [hzcard] at hh
    have hpos := Nat.card_pos (α := G ⧸ Z)
    omega
  have himages := m.central_image_factors_eq l q hq (by rw [hker]; exact hZ)
    hZS hsmall hr₁ hr₂ hcard hcapq
  have hAcyclic : A₁ ≤ zpowers u := by
    intro a ha
    have haq : q a ∈ A₂.map q := himages ▸ mem_map_of_mem q ha
    obtain ⟨b, hb, hba⟩ := haq
    have habZ : a * b⁻¹ ∈ Z := by
      apply (QuotientGroup.eq_one_iff _).mp
      change q (a * b⁻¹) = 1
      rw [map_mul, map_inv, hba, mul_inv_cancel]
    rcases mem_involution_powers hy2 habZ with he | he
    · have hab : a = b := mul_inv_eq_one.mp he
      have hacap : a ∈ A₁ ⊓ A₂ := ⟨ha, hab ▸ hb⟩
      rw [hcap] at hacap
      exact (zpowers_le.mpr (pow_mem (mem_zpowers u) 2)) hacap
    · have hauB : a * u⁻¹ ∈ A₂ := by
        have heq : a * u⁻¹ = v * b := by
          have hab : a = y * b := (mul_inv_eq_iff_eq_mul).mp he
          rw [hab]
          have hub : Commute u b :=
            (mem_centralizer_iff.mp (commutator_eq_bot_iff_le_centralizer.mp m.setup.commute huA) b hb).symm
          calc
            y * b * u⁻¹ = (u * v) * (u⁻¹ * b) := by
              change (u * v) * b * u⁻¹ = _
              rw [mul_assoc, hub.inv_left.eq]
            _ = v * b := by rw [hcomm.eq]; group
        rw [heq]
        exact A₂.mul_mem hvB hb
      have haucap : a * u⁻¹ ∈ A₁ ⊓ A₂ := ⟨A₁.mul_mem ha (A₁.inv_mem huA), hauB⟩
      rw [hcap] at haucap
      have hau : a * u⁻¹ ∈ zpowers u :=
        (zpowers_le.mpr (pow_mem (mem_zpowers u) 2)) haucap
      simpa only [inv_mul_cancel_right] using (zpowers u).mul_mem hau (mem_zpowers u)
  have hAcard : Nat.card A₁ ≤ 4 := by
    simpa only [Nat.card_zpowers, hu4] using card_le_of_le hAcyclic
  obtain ⟨E, hE, hs⟩ := m.setup.left_rank
  have hEtop : E = ⊤ := E.eq_top_of_card_eq (by
    have hh := card_le_card_group E
    omega)
  have huE : (⟨u, huA⟩ : A₁) ∈ E := by rw [hEtop]; exact mem_top _
  have hu2 : u ^ 2 = 1 := congrArg (fun x : E => ((x : A₁) : G)) (hs ⟨⟨u, huA⟩, huE⟩)
  have hd := orderOf_dvd_of_pow_eq_one hu2
  rw [hu4] at hd
  norm_num at hd

end CFSG.Quasithin.Chapter16.CounterexampleGeometry.StrongClosure.Asc75
end
