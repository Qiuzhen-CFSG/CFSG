module

public import CFSG.Quasithin.Chapter16.Section01To02.CounterexampleGeometry.StrongClosure.SourceStatements


/-!
# The involution set for the terminal step of Asc75 Lemma 3.4

Take every ambient conjugate of an involution in either factor. Global set
strong closure puts any member of this set lying in the fixed Sylow subgroup
back in the factor union. A commuting pair can be conjugated into that Sylow
subgroup simultaneously. The factor and mixed-product uniqueness assertions
then give unique conjugate membership for its nonidentity product whenever
that product lies in the intersection-generated subgroup. This verifies all
of Definition ZD, including the clause where the two factors are outside it.

An elementary four in the first factor embeds in the subgroup generated by
the involution set, with every nonidentity element still in the set. Thus
ZD's rank-one alternative is excluded and its full structural conclusion
applies. The deduction of the source alternatives from that structure remains
separate; no strong embedding in the normal closure is asserted here.

Source: M. Aschbacher, *On finite groups of component type* (1975),
Lemma 3.4, pp.94–96, especially the final paragraph on p.96;
GLS, Volume 4, Chapter 2, Definition ZD and Theorem ZD.
-/

@[expose] public section

namespace CFSG.Quasithin.Chapter16.CounterexampleGeometry.StrongClosure.Asc75
open Subgroup Theory.GroupTheory BenderSuzuki.PFchapter1section1 BenderSuzuki.PFAppendixIII
open scoped Pointwise
universe u
variable {G : Type u} [Group G] {S : Sylow 2 G} {A₁ A₂ : Subgroup G}

/-- The ambient conjugacy closure of the involutions in the factor union. -/
def terminalInvolutions (A₁ A₂ : Subgroup G) : Set G :=
  {z | ∃ g a, a ∈ (A₁ : Set G) ∪ A₂ ∧ IsInvolution a ∧ MulAut.conj g a = z}

/-- A factor involution belongs to the distinguished set. -/
theorem mem_terminalInvolutions {a : G} (ha : a ∈ (A₁ : Set G) ∪ A₂)
    (hai : IsInvolution a) : a ∈ terminalInvolutions A₁ A₂ :=
  ⟨1, a, ha, hai, by simp⟩

/-- The distinguished set is invariant under ambient conjugation. -/
theorem terminalInvolutions_invariant (g : G) {z : G}
    (hz : z ∈ terminalInvolutions A₁ A₂) : MulAut.conj g z ∈ terminalInvolutions A₁ A₂ := by
  obtain ⟨h, a, ha, hai, rfl⟩ := hz
  exact ⟨g * h, a, ha, hai, by simp [MulAut.conj_apply, mul_assoc]⟩

/-- Every member of the distinguished set has order two. -/
theorem terminalInvolutions_involutions {z : G}
    (hz : z ∈ terminalInvolutions A₁ A₂) : IsInvolution z := by
  obtain ⟨g, a, _, hai, rfl⟩ := hz
  exact BenderSuzuki.IsInvolution.map_of_injective hai
    (MulAut.conj g).toMonoidHom (MulAut.conj g).injective

private theorem unique_conj {H : Subgroup G} {a g : G}
    (ha : UniqueConjugateMembership H a) (hga : MulAut.conj g a ∈ H) :
    UniqueConjugateMembership H (MulAut.conj g a) := by
  have hg : g ∈ H := by
    simpa only [inv_inv] using H.inv_mem ((ha.2 g⁻¹).mp
      (by simpa [MulAut.conj_apply] using hga))
  refine ⟨hga, fun k => ?_⟩
  have he : k⁻¹ * MulAut.conj g a * k = (g⁻¹ * k)⁻¹ * a * (g⁻¹ * k) := by
    simp [MulAut.conj_apply, mul_assoc]
  rw [he, ha.2]
  constructor
  · intro hk
    simpa using H.mul_mem hg hk
  · exact fun hk => H.mul_mem (H.inv_mem hg) hk

private theorem unique_centralizer {H : Subgroup G} {a : G}
    (ha : UniqueConjugateMembership H a) : centralizer ({a} : Set G) ≤ H := by
  intro g hg
  apply (ha.2 g).mp
  have hc := mem_centralizer_singleton_iff.mp hg
  simpa [← hc, mul_assoc] using ha.1

/-- Distinguished involutions in H have unique conjugate membership in H. -/
theorem terminalInvolutions_unique (f : FusionConclusion S A₁ A₂) {z : G}
    (hz : z ∈ terminalInvolutions A₁ A₂) (hzH : z ∈ intersectionGenerated A₁ A₂) :
    UniqueConjugateMembership (intersectionGenerated A₁ A₂) z := by
  obtain ⟨g, a, ha, hai, rfl⟩ := hz
  exact unique_conj (f.unique a ha hai.ne_one) hzH

/-- Strong closure recovers the factor union inside the fixed Sylow subgroup. -/
theorem terminalInvolutions_mem_union (f : FusionConclusion S A₁ A₂) {z : G}
    (hz : z ∈ terminalInvolutions A₁ A₂) (hzS : z ∈ (S : Subgroup G)) : z ∈ (A₁ : Set G) ∪ A₂ := by
  obtain ⟨g, a, ha, _, rfl⟩ := hz
  simpa only [inv_inv, MulAut.conj_apply] using
    f.closed.2 a ha g⁻¹ (mem_top _) (by simpa [MulAut.conj_apply] using hzS)

private theorem pair_conjugate_into_sylow [Finite G] {x y : G}
    (hx : IsInvolution x) (hy : IsInvolution y) (hc : Commute x y) :
    ∃ g : G, MulAut.conj g x ∈ (S : Subgroup G) ∧
      MulAut.conj g y ∈ (S : Subgroup G) := by
  have hn : zpowers x ≤ normalizer (zpowers y : Set G) := by
    apply le_trans _ (centralizer_le_normalizer (zpowers y : Set G))
    intro a ha
    rw [mem_centralizer_iff]
    rintro b ⟨n, rfl⟩
    obtain ⟨m, rfl⟩ := ha
    exact (hc.zpow_zpow m n).eq.symm
  have hp := IsPGroup.to_sup_of_normal_right'
    (BenderSuzuki.isPGroup_zpowers_of_involution hx)
    (BenderSuzuki.isPGroup_zpowers_of_involution hy) hn
  obtain ⟨P, hP⟩ := hp.exists_le_sylow
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq G P S
  have hmem : ∀ a ∈ (P : Subgroup G), MulAut.conj g a ∈ (S : Subgroup G) := by
    intro a ha
    rw [← hg, Sylow.coe_subgroup_smul]
    exact Set.mem_smul_set.mpr ⟨a, ha, rfl⟩
  exact ⟨g, hmem x (hP ((le_sup_left : zpowers x ≤ zpowers x ⊔ zpowers y) (mem_zpowers x))),
    hmem y (hP ((le_sup_right : zpowers y ≤ zpowers x ⊔ zpowers y) (mem_zpowers y)))⟩

private theorem union_product_unique (f : FusionConclusion S A₁ A₂) {x y : G}
    (hx : x ∈ (A₁ : Set G) ∪ A₂) (hy : y ∈ (A₁ : Set G) ∪ A₂)
    (hxi : IsInvolution x) (hyi : IsInvolution y) (hc : Commute x y) (hne : x * y ≠ 1) :
    UniqueConjugateMembership (intersectionGenerated A₁ A₂) (x * y) := by
  rcases hx with hx | hx <;> rcases hy with hy | hy
  · exact f.unique _ (Or.inl (A₁.mul_mem hx hy)) hne
  · exact f.product_unique x hx y hy
      (orderOf_eq_prime hxi.sq_eq_one hxi.ne_one)
      (orderOf_eq_prime hyi.sq_eq_one hyi.ne_one) hne
  · rw [hc.eq]
    exact f.product_unique y hy x hx
      (orderOf_eq_prime hyi.sq_eq_one hyi.ne_one)
      (orderOf_eq_prime hxi.sq_eq_one hxi.ne_one) (hc.eq ▸ hne)
  · exact f.unique _ (Or.inr (A₂.mul_mem hx hy)) hne

/-- A product in H has unique conjugate membership even when its two
factors are arbitrary members of the ambient invariant set. -/
theorem terminalInvolutions_product_unique [Finite G]
    (f : FusionConclusion S A₁ A₂) {x y : G}
    (hx : x ∈ terminalInvolutions A₁ A₂) (hy : y ∈ terminalInvolutions A₁ A₂)
    (hxy : IsInvolution (x * y)) (hxyH : x * y ∈ intersectionGenerated A₁ A₂) :
    UniqueConjugateMembership (intersectionGenerated A₁ A₂) (x * y) := by
  have hxi := terminalInvolutions_involutions hx
  have hyi := terminalInvolutions_involutions hy
  have hc : Commute x y := by
    have hi := hxy.inv_eq_self
    rw [mul_inv_rev, hxi.inv_eq_self, hyi.inv_eq_self] at hi
    exact hi.symm
  obtain ⟨g, hxS, hyS⟩ := pair_conjugate_into_sylow (S := S) hxi hyi hc
  have hxZ := terminalInvolutions_invariant g hx
  have hyZ := terminalInvolutions_invariant g hy
  have hu := union_product_unique f
    (terminalInvolutions_mem_union f hxZ hxS) (terminalInvolutions_mem_union f hyZ hyS)
    (terminalInvolutions_involutions hxZ) (terminalInvolutions_involutions hyZ)
    (hc.map (MulAut.conj g)) (by
      rw [← map_mul]
      exact fun he => hxy.ne_one ((MulAut.conj g).injective (by simpa using he)))
  rw [← map_mul] at hu
  have he : MulAut.conj g⁻¹ (MulAut.conj g (x * y)) = x * y := by
    simp [MulAut.conj_apply, mul_assoc]
  rw [← he] at hxyH ⊢
  exact unique_conj hu hxyH

private theorem rank_involution {A : Subgroup G} (h : TwoRankAtLeastTwo A) :
    ∃ a : G, a ∈ A ∧ IsInvolution a := by
  obtain ⟨E, hE, hsq⟩ := h
  have hne : E ≠ ⊥ := by intro he; simp [he] at hE
  obtain ⟨a, ha, hane⟩ := (E.bot_or_exists_ne_one.resolve_left hne)
  refine ⟨a, a.property, ?_⟩
  exact BenderSuzuki.IsInvolution.map_of_injective
    ⟨hane, congrArg Subtype.val (hsq ⟨a, ha⟩)⟩ A.subtype Subtype.val_injective

/-- A seed involution in the first factor, with its membership in Z. -/
theorem terminalInvolutions_left_seed (h : TwoRankAtLeastTwo A₁) :
    ∃ a : G, a ∈ A₁ ∧ a ∈ terminalInvolutions A₁ A₂ ∧ IsInvolution a := by
  obtain ⟨a, ha, hai⟩ := rank_involution h
  exact ⟨a, ha, mem_terminalInvolutions (Or.inl ha) hai, hai⟩

/-- All six fields of the exact product-disconnection interface. -/
theorem terminalInvolutions_productDisconnected [Finite G]
    (h : Hypotheses S A₁ A₂) (f : FusionConclusion S A₁ A₂)
    (hp : intersectionGenerated A₁ A₂ ≠ ⊤) :
    IsProductDisconnected (terminalInvolutions A₁ A₂) (intersectionGenerated A₁ A₂) := by
  refine ⟨fun _ hz => terminalInvolutions_involutions hz,
    fun g _ hz => terminalInvolutions_invariant g hz, hp, ?_, ?_, ?_⟩
  · obtain ⟨a, ha, hai⟩ := rank_involution h.left_rank
    exact ⟨a, mem_terminalInvolutions (Or.inl ha) hai,
      (f.unique a (Or.inl ha) hai.ne_one).1⟩
  · intro z hz hzH g
    have hu := terminalInvolutions_unique f hz hzH
    simpa [MulAut.conj_apply] using (hu.2 g⁻¹)
  · intro x hx y hy hxy hxyH
    exact unique_centralizer (terminalInvolutions_product_unique f hx hy hxy hxyH)


/-- The first factor supplies an actual elementary four in the generated
group, and all three of its involutions belong to the distinguished set. -/
theorem terminalInvolutions_four (h : TwoRankAtLeastTwo A₁) :
    ∃ E : Subgroup (closure (terminalInvolutions A₁ A₂)),
      Nat.card E = 4 ∧ (∀ x : E, x ^ 2 = 1) ∧
      ∀ x : E, x ≠ 1 → (((x : closure (terminalInvolutions A₁ A₂)) : G)) ∈
        terminalInvolutions A₁ A₂ := by
  obtain ⟨E, hE, hsq⟩ := h
  let L := closure (terminalInvolutions A₁ A₂)
  have hZmem : ∀ x : E, x ≠ 1 → ((x : A₁) : G) ∈ terminalInvolutions A₁ A₂ := by
    intro x hx
    apply mem_terminalInvolutions (Or.inl (x : A₁).property)
    refine ⟨?_, ?_⟩
    · exact fun he => hx (Subtype.ext (Subtype.ext he))
    · exact congrArg (fun y : E => ((y : A₁) : G)) (hsq x)
  have hmem : ∀ x : E, ((x : A₁) : G) ∈ L := by
    intro x
    by_cases hx : x = 1
    · subst x; exact L.one_mem
    · exact Subgroup.subset_closure (hZmem x hx)
  let φ : E →* L :=
    { toFun := fun x => ⟨((x : A₁) : G), hmem x⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl }
  have hφ : Function.Injective φ := by
    intro x y he
    exact Subtype.ext (Subtype.ext (congrArg (fun z : L => (z : G)) he))
  refine ⟨(⊤ : Subgroup E).map φ, ?_, ?_, ?_⟩
  · rw [card_map_of_injective hφ, card_top, hE]
  · rintro ⟨x, a, _, rfl⟩
    apply Subtype.ext
    change φ a ^ 2 = 1
    rw [← map_pow, hsq, map_one]
  · rintro ⟨x, a, _, rfl⟩ hx
    apply hZmem a
    intro ha
    apply hx
    apply Subtype.ext
    change φ a = 1
    rw [ha, map_one]

/-- The generated group has two-rank at least two. -/
theorem terminalInvolutions_rank (h : TwoRankAtLeastTwo A₁) :
    TwoRankAtLeastTwo (closure (terminalInvolutions A₁ A₂)) := by
  obtain ⟨E, hE, hsq, _⟩ := terminalInvolutions_four (A₂ := A₂) h
  exact ⟨E, hE, hsq⟩

/-- The verified product-disconnection hypotheses and four-group exclusion
select the full five-clause structural alternative of ZD. -/
theorem terminal_structure_of_theoremZD [Finite G]
    (zd : TheoremZD.{u}) (h : Hypotheses S A₁ A₂) (f : FusionConclusion S A₁ A₂)
    (hp : intersectionGenerated A₁ A₂ ≠ ⊤) :
    BenderSuzuki.ZD.StructureConclusion (terminalInvolutions A₁ A₂)
      (intersectionGenerated A₁ A₂) := by
  exact (zd _ _ (terminalInvolutions_productDisconnected h f hp)).resolve_left
    (not_not.mpr (terminalInvolutions_rank (A₂ := A₂) h.left_rank))

end CFSG.Quasithin.Chapter16.CounterexampleGeometry.StrongClosure.Asc75
end
