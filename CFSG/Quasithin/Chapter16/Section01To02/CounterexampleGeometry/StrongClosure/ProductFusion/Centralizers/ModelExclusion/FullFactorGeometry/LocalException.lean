module

public import CFSG.Quasithin.Chapter16.Section01To02.CounterexampleGeometry.StrongClosure.SourceStatements
public import CFSG.Quasithin.Chapter16.Section01To02.CounterexampleGeometry.StrongClosure.ProductFusion.Centralizers.Reduction
public import CFSG.Quasithin.Chapter16.Section01To02.CounterexampleGeometry.StrongClosure.ProductFusion.Centralizers.ModelExclusion.Recognition
public import CFSG.Quasithin.Chapter16.Section01To02.CounterexampleGeometry.StrongClosure.GlobalClosure.LocalGeometry.CentralizerReselection.Selection
public import Theory.GroupTheory.NormalizingInvolutionCard
public import Theory.GroupTheory.NormalizedSupCard

/-!
# The exceptional alternative in a mixed centralizer

Suppose the union of the two commuting factors is strongly closed in the
fixed Sylow subgroup. A central involution in their product, outside both
factors, excludes the exceptional alternative of Aschbacher's Lemma 3.4.

For nonabelian models, the order-two intersection equals each factor center;
writing the central involution as a product puts it in a factor. For four-groups,
the product has order eight and is generated by either factor and the central
involution. Its normalizer permutes the factors by strong closure. The specified
fused conjugator normalizes that product. Sylow conjugacy inside its normalizer
moves the conjugator into the factor union, whose elements preserve both factors.
This contradicts its interchange of the two distinct four-groups.

The consumer in `FullFactorGeometry` applies this result to the actual restricted
factors after centralizer Sylow reselection. Every clause of the local exception
is retained; no conjugacy of full ambient factors is inferred from restricted
conjugacy.

Source: M. Aschbacher, *On finite groups of component type*, Illinois J.
Math. 19 (1975), Lemma 3.4(g), printed pp.95–96, DOI 10.1215/ijm/1256050927.
-/

@[expose] public section
open Subgroup Theory.GroupTheory BenderSuzuki.PFchapter1section1
open scoped Pointwise
namespace CFSG.Quasithin.Chapter16.CounterexampleGeometry.StrongClosure.Asc75
universe u
variable {G : Type u} [Group G] [Finite G] {S : Sylow 2 G} {A B : Subgroup G}

private theorem normalizer_product_permutes
    (h : Hypotheses S A B)
    (hc : IsStronglyClosedSet ((A : Set G) ∪ B) (S : Subgroup G) ⊤)
    (hA : Nat.card A = 4) (hB : Nat.card B = 4) (hne : A ≠ B)
    {g : G} (hg : g ∈ normalizer ((A ⊔ B : Subgroup G) : Set G)) :
    (conjugate A g = A ∧ conjugate B g = B) ∨
      (conjugate A g = B ∧ conjugate B g = A) := by
  have hE : conjugate (A ⊔ B) g = A ⊔ B :=
    (mem_normalizer_iff_conjugate_eq _ _).mp hg
  have himage {X : Subgroup G} (hX : X = A ∨ X = B) :
      conjugate X g = A ∨ conjugate X g = B := by
    have hXU : (X : Set G) ⊆ (A : Set G) ∪ B := by
      rcases hX with rfl | rfl
      · exact fun _ hx => Or.inl hx
      · exact fun _ hx => Or.inr hx
    have hXcard : Nat.card X = 4 := hX.elim (fun he => he ▸ hA) (fun he => he ▸ hB)
    have hXle : X ≤ A ⊔ B := hX.elim (fun he => he ▸ le_sup_left) (fun he => he ▸ le_sup_right)
    have hSU : (conjugate X g : Set G) ⊆ (A : Set G) ∪ B := by
      rintro _ ⟨x, hx, rfl⟩
      change g⁻¹ * x * (g⁻¹)⁻¹ ∈ (A : Set G) ∪ B
      simp only [inv_inv]
      apply hc.2 x (hXU hx) g (mem_top _)
      apply (sup_le h.left_le h.right_le)
      rw [← hE]
      exact mem_map.mpr ⟨x, hXle hx, by simp⟩
    have hcX : Nat.card (conjugate X g) = 4 :=
      (card_map_of_injective (MulAut.conj g⁻¹).injective).trans hXcard
    exact (SubgroupClass.subset_union.mp hSU).imp
      (fun hh => eq_of_le_of_card_ge hh (by rw [hA, hcX]))
      (fun hh => eq_of_le_of_card_ge hh (by rw [hB, hcX]))
  have hdiff : conjugate A g ≠ conjugate B g := by
    intro he
    exact hne (map_injective (MulAut.conj g⁻¹).injective he)
  rcases himage (Or.inl rfl : A = A ∨ A = B) with hga | hga <;>
    rcases himage (Or.inr rfl : B = A ∨ B = B) with hgb | hgb
  · exact (hdiff (hga.trans hgb.symm)).elim
  · exact Or.inl ⟨hga, hgb⟩
  · exact Or.inr ⟨hga, hgb⟩
  · exact (hdiff (hga.trans hgb.symm)).elim

private theorem no_four_exceptional
    (h : Hypotheses S A B)
    (hc : IsStronglyClosedSet ((A : Set G) ∪ B) (S : Subgroup G) ⊤)
    (hperm : ∀ s ∈ S, (conjugate A s = A ∧ conjugate B s = B) ∨
      (conjugate A s = B ∧ conjugate B s = A))
    (u : G) (hu : u ∈ A ⊔ B) (hu2 : orderOf u = 2) (huz : u ∈ center G)
    (huA : u ∉ A) (huB : u ∉ B) (hA : Nat.card A = 4)
    (he : Exceptional A B) : False := by
  obtain ⟨⟨g, hg, k, hk⟩, _hm, hi⟩ := he
  have hB : Nat.card B = 4 := by
    rw [← hg]
    exact (card_map_of_injective (MulAut.conj g⁻¹).injective).trans hA
  have hne : A ≠ B := by
    intro hab
    rw [hab, inf_idem, hB] at hi
    omega
  have hEcard : Nat.card (A ⊔ B : Subgroup G) = 8 := by
    have hh := card_mul_eq_card_inf_mul_card_sup_of_normalizes A B
      ((commutator_eq_bot_iff_le_centralizer.mp
        (by simpa only [commutator_comm] using h.commute)).trans
        (Subgroup.centralizer_le_normalizer _))
    rw [hA, hB, hi] at hh
    omega
  have huN (X : Subgroup G) : u ∈ normalizer (X : Set G) := by
    apply Subgroup.centralizer_le_normalizer
    exact mem_centralizer_iff.mpr (fun x _ => mem_center_iff.mp huz x)
  have hAE : A ⊔ zpowers u = A ⊔ B :=
    eq_of_le_of_card_ge (sup_le le_sup_left (zpowers_le.mpr hu)) (by
      rw [hEcard, card_sup_zpowers_of_normalizing_involution A u
        (orderOf_eq_prime_iff.mp hu2).1 huA (huN A), hA])
  have hBE : B ⊔ zpowers u = A ⊔ B :=
    eq_of_le_of_card_ge (sup_le le_sup_right (zpowers_le.mpr hu)) (by
      rw [hEcard, card_sup_zpowers_of_normalizing_involution B u
        (orderOf_eq_prime_iff.mp hu2).1 huB (huN B), hB])
  let N := normalizer ((A ⊔ B : Subgroup G) : Set G)
  have hSN : (S : Subgroup G) ≤ N := by
    intro s hs
    apply (mem_normalizer_iff_conjugate_eq _ _).mpr
    change (A ⊔ B).map (MulAut.conj s⁻¹).toMonoidHom = A ⊔ B
    rw [Subgroup.map_sup]
    rcases hperm s hs with hh | hh
    · change conjugate A s ⊔ conjugate B s = A ⊔ B
      rw [hh.1, hh.2]
    · change conjugate A s ⊔ conjugate B s = A ⊔ B
      rw [hh.1, hh.2, sup_comm]
  have hgN : g ∈ N := by
    apply (mem_normalizer_iff_conjugate_eq _ _).mpr
    conv_lhs => rw [← hAE]
    change (A ⊔ zpowers u).map (MulAut.conj g⁻¹).toMonoidHom = A ⊔ B
    rw [Subgroup.map_sup, MonoidHom.map_zpowers]
    simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply, inv_inv]
    change conjugate A g ⊔ zpowers (g⁻¹ * u * g) = A ⊔ B
    have hfix : g⁻¹ * u * g = u := by
      rw [(mem_center_iff.mp huz g⁻¹), mul_assoc, inv_mul_cancel, mul_one]
    rw [hg, hfix, hBE]
  have hxS : k⁻¹ * g * k ∈ S := h.left_le hk
  obtain ⟨n, hn⟩ := S.isPGroup'.exists_orderOf_eq_pow
    (⟨k⁻¹ * g * k, hxS⟩ : S)
  have hgo : orderOf (⟨g, hgN⟩ : N) = 2 ^ n := by
    rw [Subgroup.orderOf_mk]
    have heq := (MulAut.conj k⁻¹).orderOf_eq g
    simpa only [MulAut.conj_apply, inv_inv, Subgroup.orderOf_mk] using heq.symm.trans (by simpa only [Subgroup.orderOf_mk, MulAut.conj_apply, inv_inv] using hn)
  obtain ⟨y, hy⟩ := (S.subtype hSN).exists_isConj_of_orderOf_eq_prime_pow hgo
  obtain ⟨r, hr⟩ := isConj_iff.mp hy
  have hry : (r : G) * g * (r : G)⁻¹ = ((y : N) : G) := congrArg Subtype.val hr
  have hyS : ((y : N) : G) ∈ S := by
    have hh := y.property
    change (y : N) ∈ (S.subtype hSN : Subgroup N) at hh
    rw [Sylow.coe_subtype] at hh
    exact hh
  have hyU : ((y : N) : G) ∈ (A : Set G) ∪ B := by
    have hconj : (k⁻¹ * (r : G)⁻¹)⁻¹ * (k⁻¹ * g * k) *
        (k⁻¹ * (r : G)⁻¹) = ((y : N) : G) := by
      rw [← hry]
      group
    exact hconj ▸ hc.2 _ (Or.inl hk) _ (mem_top _) (hconj.symm ▸ hyS)
  have hyA : conjugate A ((y : N) : G) = A :=
    (mem_normalizer_iff_conjugate_eq _ _).mp (h.closed_in_left_normalizer.1 hyU).2
  have hyB : conjugate B ((y : N) : G) = B :=
    (mem_normalizer_iff_conjugate_eq _ _).mp (h.closed_in_right_normalizer.1 hyU).2
  have hrperm := normalizer_product_permutes h hc hA hB hne (N.inv_mem r.property)
  have hfix : conjugate (conjugate A (r : G)⁻¹) ((y : N) : G) =
      conjugate A (r : G)⁻¹ := by
    rcases hrperm with hh | hh
    · rw [hh.1, hyA]
    · rw [hh.1, hyB]
  have hgA : conjugate A g = A := by
    have hh := congrArg (fun X => conjugate X (r : G)) hfix
    have heq : (r : G)⁻¹ * ((y : N) : G) * (r : G) = g := by
      rw [← hry]
      group
    simpa only [conjugate_conjugate, heq, inv_mul_cancel, conjugate_one] using hh
  exact hne (hgA.symm.trans hg)


/-- A central involution in the factor product but outside their strongly closed
union rules out the exceptional alternative. Pair permutation is supplied by
source (b) in the centralizer consumer. -/
theorem Hypotheses.not_exceptional_of_closed_central_involution
    (h : Hypotheses S A B)
    (hc : IsStronglyClosedSet ((A : Set G) ∪ B) (S : Subgroup G) ⊤)
    (hperm : ∀ s ∈ S, (conjugate A s = A ∧ conjugate B s = B) ∨
      (conjugate A s = B ∧ conjugate B s = A))
    (u : G) (hu : u ∈ A ⊔ B) (hu2 : orderOf u = 2) (huz : u ∈ center G)
    (huA : u ∉ A) (huB : u ∉ B) : ¬ Exceptional A B := by
  intro he
  rcases he.2.1.four_or_center_two with ⟨hfour, _⟩ | hcenter
  · exact no_four_exceptional h hc hperm u hu hu2 huz huA huB hfour he
  · obtain ⟨g, hg, _⟩ := he.1
    let e : A ≃* B := ((MulAut.conj g⁻¹).subgroupMap A).trans (MulEquiv.subgroupCongr hg)
    have hcenterB : Nat.card (center B) = 2 :=
      (Nat.card_congr (centerCongr e).toEquiv).symm.trans hcenter
    have hcomm : ∀ x ∈ A, ∀ y ∈ B, Commute x y := by
      intro x hx y hy
      exact (mem_centralizer_iff.mp (commutator_eq_bot_iff_le_centralizer.mp h.commute hx) y hy).symm
    have hIZ : A ⊓ B ≤ (center B).map B.subtype := by
      intro x hx
      refine ⟨⟨x, hx.2⟩, mem_center_iff.mpr ?_, rfl⟩
      intro y
      exact Subtype.ext (hcomm x hx.1 y y.property).symm.eq
    have heq : A ⊓ B = (center B).map B.subtype :=
      eq_of_le_of_card_ge hIZ (by
        rw [card_map_of_injective B.subtype_injective, hcenterB, he.2.2])
    obtain ⟨a, ha, b, hb, hab, _, _⟩ := centralizer_reselection_factorization h.commute hu
    have hbZ : (⟨b, hb⟩ : B) ∈ center B := by
      apply mem_center_iff.mpr
      intro y
      apply Subtype.ext
      change (y : G) * b = b * (y : G)
      apply mul_left_cancel (a := a)
      calc
        a * ((y : G) * b) = (y : G) * u := by
          rw [← mul_assoc, (hcomm a ha y y.property).eq, mul_assoc, hab]
        _ = u * (y : G) := mem_center_iff.mp huz y
        _ = a * (b * (y : G)) := by rw [← mul_assoc, hab]
    have hbA : b ∈ A := by
      have hh := mem_map_of_mem B.subtype hbZ
      rw [← heq] at hh
      exact hh.1
    exact huA (hab ▸ A.mul_mem ha hbA)

end CFSG.Quasithin.Chapter16.CounterexampleGeometry.StrongClosure.Asc75

end
