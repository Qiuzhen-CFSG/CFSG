module

public import CFSG.Quasithin.ChapterJ.Section04To05.FiveDecomposition.Basic
public import CFSG.Quasithin.ChapterJ.Section04To05.Inverter

/-!
# The selected five-displacement contains the conjugate action

The unchanged source element v inverts the chosen Sylow five-subgroup.
It therefore normalizes Q₅ = [Q,B₅], while v ∈ K makes it fix C_Q(B₅)
modulo U. The coprime splitting of Q then places [Q,v] inside Q₅. The
actual star image of Uα has order two and is generated by v*, so
Uα ≤ Q⟨v⟩. Since Q/U is abelian and U ≤ Q₅, this proves [Q,Uα] ≤ Q₅,
and hence the literal quotient conclusion in J.4.1(7).

The final existence theorem consumes the earlier construction of a Sylow
five-subgroup inverted by the same v; no replacement of the source choice
or displacement conclusion is assumed.

Source: Aschbacher–Smith J.4.1(7), printed p.440 (PDF p.451).
-/

public section
noncomputable section

open Subgroup Representation
open scoped commutatorElement
namespace CFSG.Quasithin.ChapterJ.RuSubgroup
open Centralizers.Choices
variable {G : Type*} [Group G] [Finite G] {d : LocalSetup G} {p : Plane d}

abbrev SourceChoice.Uα (s : SourceChoice p) : Subgroup G :=
  d.toTypeRuSetup.U.conjBy s.g

theorem SourceChoice.Uα_le_K (s : SourceChoice p) : s.Uα ≤ d.toTypeRuSetup.K :=
  (ConjugateIntersections.conjugateU_le_S d s.g (p.L₂_le_L s.in_residual)).trans
    (d.S_le_L₁.trans (embedded_pResidual_mono 2 inf_le_right))

theorem SourceChoice.Uα_le_Q_sup_v (s : SourceChoice p) :
    s.Uα ≤ d.toTypeRuSetup.Q ⊔ zpowers s.v := by
  let A := (s.Uα.subgroupOf d.toTypeRuSetup.H).map d.ru2.quotientMap
  have hA : Nat.card A = 2 := s.conjugate_properties.2.1
  let vH : d.toTypeRuSetup.H := ⟨s.v,d.toTypeRuSetup.K_le_H s.v_mem_K⟩
  have hvA : d.ru2.quotientMap vH ∈ A := mem_map.mpr ⟨vH,s.v_mem,rfl⟩
  have hv1 : d.ru2.quotientMap vH ≠ 1 := by
    intro he
    have hh : vH ∈ d.ru2.quotientMap.ker := he
    rw [d.ru2.quotient_kernel] at hh
    exact s.v_not_Q hh
  obtain ⟨a,ha,huniq⟩ := (Nat.card_eq_two_iff' (1:A)).mp hA
  intro u hu
  let uH : d.toTypeRuSetup.H := ⟨u,d.toTypeRuSetup.K_le_H (s.Uα_le_K hu)⟩
  have huA : d.ru2.quotientMap uH ∈ A := mem_map.mpr ⟨uH,hu,rfl⟩
  by_cases hu1 : d.ru2.quotientMap uH = 1
  · have hq : uH ∈ d.ru2.quotientMap.ker := hu1
    rw [d.ru2.quotient_kernel] at hq
    exact mem_sup_left hq
  have he : d.ru2.quotientMap uH = d.ru2.quotientMap vH := congrArg Subtype.val
    ((huniq ⟨_,huA⟩ (fun h => hu1 (congrArg Subtype.val h))).trans
      (huniq ⟨_,hvA⟩ (fun h => hv1 (congrArg Subtype.val h))).symm)
  have hm : uH*vH⁻¹ ∈ d.ru2.quotientMap.ker := by
    rw [MonoidHom.mem_ker,map_mul,map_inv,he,mul_inv_cancel]
  rw [d.ru2.quotient_kernel] at hm
  have hmem := (d.toTypeRuSetup.Q ⊔ zpowers s.v).mul_mem
    (mem_sup_left hm) (mem_sup_right (mem_zpowers s.v))
  change (u*s.v⁻¹)*s.v ∈ d.toTypeRuSetup.Q ⊔ zpowers s.v at hmem
  simpa only [mul_assoc,inv_mul_cancel,mul_one] using hmem

private theorem Q_self_commutator_le_U :
    ⁅d.toTypeRuSetup.Q,d.toTypeRuSetup.Q⁆ ≤ d.toTypeRuSetup.U := by
  apply commutator_le.mpr
  intro x hx y hy
  apply (d.ru2.six.coordinates_eq_one_iff ⁅(⟨x,hx⟩:d.toTypeRuSetup.Q),⟨y,hy⟩⁆).mp
  rw [map_commutatorElement,commutatorElement_eq_one_iff_mul_comm]
  exact mul_comm _ _

theorem Q₅_normalized_of_inverts (B5 : Sylow 5 d.toTypeRuSetup.H)
    {v:G} (hv:v∈d.toTypeRuSetup.H)
    (hi:∀a∈B5Image B5,v*a*v⁻¹=a⁻¹) : v ∈ normalizer (Q₅ d B5) := by
  have hB : v ∈ normalizer (B5Image B5) := by
    apply mem_normalizer_iff_map_conj_eq.mpr
    apply eq_of_le_of_card_ge ?_
      (card_map_of_injective (MulAut.conj v).injective (K := B5Image B5)).ge
    rintro x ⟨a,ha,rfl⟩
    change v*a*v⁻¹ ∈ B5Image B5
    rw [hi a ha]
    exact inv_mem ha
  apply mem_normalizer_iff_map_conj_eq.mpr
  rw [Q₅,map_commutator,mem_normalizer_iff_map_conj_eq.mp (d.ru2.six.normalized hv),
    mem_normalizer_iff_map_conj_eq.mp hB]

theorem commutator_Q_v_le_Q₅ (B5 : Sylow 5 d.toTypeRuSetup.H)
    {v:G} (hv:v∈d.toTypeRuSetup.K)
    (hi:∀a∈B5Image B5,v*a*v⁻¹=a⁻¹) :
    ⁅d.toTypeRuSetup.Q,zpowers v⁆ ≤ Q₅ d B5 := by
  have hCQ : ⁅CQ B5,zpowers v⁆ ≤ Q₅ d B5 := by
    rw [commutator_comm]
    apply commutator_le.mpr
    intro k hk c hc
    exact U_le_Q₅ d B5 (d.HC_commutator_K_mem_U
      ⟨c,five_centralizer_le_HC B5 hc⟩ ⟨k,(zpowers_le.mpr hv) hk⟩)
  have h5 : ⁅Q₅ d B5,zpowers v⁆ ≤ Q₅ d B5 :=
    le_normalizer_iff_commutator_le_left.mp
      (zpowers_le.mpr (Q₅_normalized_of_inverts B5 (d.toTypeRuSetup.K_le_H hv) hi))
  have hQ : d.toTypeRuSetup.Q ≤ commutatorPreimage d.toTypeRuSetup.Q (zpowers v) (Q₅ d B5) := by
    conv_lhs => rw [Q_eq_Q₅_sup_CQ d B5]
    exact sup_le (le_commutatorPreimage (Q₅_le_Q d B5) h5)
      (le_commutatorPreimage inf_le_left hCQ)
  exact (commutator_mono hQ le_rfl).trans
    (commutator_commutatorPreimage_le _ _ _ (Q₅_normalized d B5))

/-- The selected conjugate has all of its Q-displacement in the actual five-commutator. -/
theorem SourceChoice.commutator_Q_Uα_le_Q₅ (s : SourceChoice p)
    (B5 : Sylow 5 d.toTypeRuSetup.H)
    (hi:∀a∈B5Image B5,s.v*a*s.v⁻¹=a⁻¹) :
    ⁅d.toTypeRuSetup.Q,s.Uα⁆ ≤ Q₅ d B5 := by
  let A := d.toTypeRuSetup.Q ⊔ zpowers s.v
  have hn : A ≤ normalizer (Q₅ d B5) :=
    sup_le (Q₅_normalized d B5) (zpowers_le.mpr
      (Q₅_normalized_of_inverts B5 (d.toTypeRuSetup.K_le_H s.v_mem_K) hi))
  have hQ : ⁅d.toTypeRuSetup.Q,d.toTypeRuSetup.Q⁆ ≤ Q₅ d B5 :=
    Q_self_commutator_le_U.trans (U_le_Q₅ d B5)
  have hv : ⁅zpowers s.v,d.toTypeRuSetup.Q⁆ ≤ Q₅ d B5 := by
    rw [commutator_comm]
    exact commutator_Q_v_le_Q₅ B5 s.v_mem_K hi
  have hA : A ≤ commutatorPreimage A d.toTypeRuSetup.Q (Q₅ d B5) :=
    sup_le (le_commutatorPreimage le_sup_left hQ) (le_commutatorPreimage le_sup_right hv)
  rw [commutator_comm]
  exact (commutator_mono (s.Uα_le_Q_sup_v.trans hA) le_rfl).trans
    (commutator_commutatorPreimage_le _ _ _ hn)

/-- J.4.1(7) in the literal quotient H/U. -/
theorem SourceChoice.hat_commutator_le_Q₅ (s : SourceChoice p)
    (B5 : Sylow 5 d.toTypeRuSetup.H)
    (hi:∀a∈B5Image B5,s.v*a*s.v⁻¹=a⁻¹) :
    ⁅hat d d.toTypeRuSetup.Q,hat d s.Uα⁆ ≤ hat d (Q₅ d B5) := by
  rw [← hat_commutator d (pCoreIn_le 2 _) (s.Uα_le_K.trans d.toTypeRuSetup.K_le_H)]
  exact hat_mono d (s.commutator_Q_Uα_le_Q₅ B5 hi)

/-- The same literal source element chooses B₅ and satisfies J.4.1(7). -/
theorem SourceChoice.exists_five_displacement (s : SourceChoice p) :
    ∃ B5 : Sylow 5 d.toTypeRuSetup.H,
      (∀a∈B5Image B5,s.v*a*s.v⁻¹=a⁻¹) ∧
      ⁅hat d d.toTypeRuSetup.Q,hat d s.Uα⁆ ≤ hat d (Q₅ d B5) := by
  obtain ⟨B5,hi⟩ := s.inverts_sylow_five
  exact ⟨B5,hi,s.hat_commutator_le_Q₅ B5 hi⟩

end CFSG.Quasithin.ChapterJ.RuSubgroup
