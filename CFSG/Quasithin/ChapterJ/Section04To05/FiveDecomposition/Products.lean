module

public import CFSG.Quasithin.ChapterJ.Section04To05.FiveDecomposition.Basic
public import CFSG.Quasithin.ChapterJ.Section04To05.Setup.CoreProduct

/-!
# The five-commutator supplements in the original parabolics

Coprime decomposition gives Q=Q₅C_Q(B₅). The fixed quaternion group lies
in HC≤S, so R₁=Q₅S; since S≤R₂ and T=R₂Q, also T=R₂Q₅. These retain
the original B₅ and both embedded two-cores.

Source: Aschbacher–Smith, J.4.4, opening argument, printed p.441.
-/

public section
noncomputable section
open Subgroup
namespace CFSG.Quasithin.ChapterJ.RuSubgroup
open Centralizers.Choices
variable {G : Type*} [Group G] [Finite G] (d : LocalSetup G)
  (B5 : Sylow 5 d.toTypeRuSetup.H)

private theorem HC_le_S : d.toTypeRuSetup.HC ≤ d.toTypeRuSetup.S := by
  have h : d.toTypeRuSetup.HC ≤ centralizer (d.V : Set G) :=
    inf_le_right.trans (centralizer_le (le_conjugateSpan _ _))
  rwa [d.ru1.centralizer_V] at h

theorem Q₅_sup_HC : Q₅ d B5 ⊔ d.toTypeRuSetup.HC = d.toTypeRuSetup.Q := by
  apply le_antisymm (sup_le (Q₅_le_Q d B5) d.toTypeRuSetup.HC_le_Q)
  rw [Q_eq_Q₅_sup_CQ d B5]
  exact sup_le_sup_left (five_centralizer_le_HC B5) _

/-- The original first core is generated by Q₅ and S. -/
theorem Q₅_sup_S : Q₅ d B5 ⊔ d.toTypeRuSetup.S = d.toTypeRuSetup.R₁ := by
  rw [← d.parabolic_core_eq_R₁,← d.Q_sup_S_eq_parabolic_core]
  apply le_antisymm (sup_le_sup_right (Q₅_le_Q d B5) _)
  rw [← Q₅_sup_HC d B5]
  exact sup_le (sup_le le_sup_left ((HC_le_S d).trans le_sup_right)) le_sup_right

/-- The five-commutator itself has order 512. -/
theorem card_Q₅ : Nat.card (Q₅ d B5) = 512 := by
  have h := hat_card d (Q₅ d B5) ((Q₅_le_Q d B5).trans (pCoreIn_le 2 _))
  rw [hat_Q₅_card,inf_eq_right.mpr (U_le_Q₅ d B5),d.ru2.card_U d.card_Z] at h
  exact h.symm

variable {d} (p : Plane d)

/-- The original kernel S lies in the second two-core. -/
theorem Plane.S_le_R₂ : d.toTypeRuSetup.S ≤ p.R₂ := by
  rw [p.R₂_eq]
  apply le_pCoreIn_of_normalizes (isPGroup_pCoreIn 2 d.L) p.S_le_parabolic
  exact (show p.parabolic ≤ d.L from fun x hx => ((p.mem_parabolic x).mp hx).1).trans
    d.ru1.steinberg.normalized

/-- The original Q₅ supplements R₂ in the selected Sylow subgroup. -/
theorem Plane.R₂_sup_Q₅ : p.R₂ ⊔ Q₅ d B5 = (d.T : Subgroup G) := by
  rw [← p.R₂_sup_Q]
  apply le_antisymm (sup_le_sup_left (Q₅_le_Q d B5) _)
  rw [← Q₅_sup_HC d B5]
  exact sup_le le_sup_left (sup_le le_sup_right
    (((HC_le_S d).trans p.S_le_R₂).trans le_sup_left))

end CFSG.Quasithin.ChapterJ.RuSubgroup
