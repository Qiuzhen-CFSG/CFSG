module



public import Theory.SpecificGroups.Tits.ExceptionalParabolics.FullRee.LongRootPaths.InvariantFives
public import CFSG.Quasithin.ChapterJ.Section04To05.FiveHexagon.MarkedReflection
public import Theory.GroupTheory.SpecificGroups.KleinFourGenerators

/-!
# Source transitivity for the marked five-subgroups

The transported C4 x C4 has omega subgroup generated by z and u. Its
four-group is identified directly from the marked involutions, and the
certified first parabolic normalizer supplies the original Sylow argument:
every order-five subgroup normalized by this four-group is obtained from the
marked B5 by an element normalizing the same four-group. This is the exact
first paragraph of J.4.10; no six-five closure or complement conjugacy is used.
-/

public section

open Subgroup
namespace CFSG.Quasithin.ChapterJ.RuSubgroup.FiveHexagon.MarkedNormalizer
open Centralizers Centralizers.Choices MarkedInverter
open Tits.ExceptionalParabolics.FullRee
open Tits.ExceptionalParabolics.FullRee.LongRootPaths.FiveNormalizer
open Theory.GroupTheory.NormalizedSylowTransitivity
variable {G : Type*} [Group G] [Finite G] {d : LocalSetup G}
  (c : Choices d) (B5 : Sylow 5 d.toTypeRuSetup.H)
  {F : Subgroup G} (e : first ≃* F)

/-- The original marked plane is exactly the omega subgroup of I. -/
theorem source_omega_plane (hz : (e modelZ:G)=c.z) :
    Stellmacher.omegaOneCenterAmbient (sourceI e) = zpowers c.z ⊔ zpowers (sourceU e) := by
  obtain ⟨ei⟩ := sourceI_equiv e
  have hm := source_marks_mem c e hz
  have hc (x y : G) (hx : x∈sourceI e) (hy : y∈sourceI e) : Commute x y := by
    have hh : (⟨x,hx⟩:sourceI e)*⟨y,hy⟩=⟨y,hy⟩*(⟨x,hx⟩:sourceI e) :=
      ei.injective (by rw [map_mul,map_mul,mul_comm])
    exact congrArg Subtype.val hh
  have hz2 : c.z^2=1 := (orderOf_eq_prime_iff.mp (SourceCompletion.z_order c)).1
  have hz1 : c.z≠1 := (orderOf_eq_prime_iff.mp (SourceCompletion.z_order c)).2
  obtain ⟨hu2,hu1,huz⟩ := source_involution_marks c e hz
  have hle : zpowers c.z ⊔ zpowers (sourceU e) ≤ Stellmacher.omegaOneCenterAmbient (sourceI e) := by
    apply sup_le <;> apply zpowers_le.mpr
    · exact (Stellmacher.mem_omegaOneCenterAmbient_iff _ _).mpr
        ⟨hm.1,hz2,fun q hq => (hc q _ hq hm.1).eq⟩
    · exact (Stellmacher.mem_omegaOneCenterAmbient_iff _ _).mpr
        ⟨hm.2,hu2,fun q hq => (hc q _ hq hm.2).eq⟩
  have hcl : zpowers c.z ⊔ zpowers (sourceU e) = closure ({c.z,sourceU e}:Set G) := by
    rw [zpowers_eq_closure,zpowers_eq_closure,← Subgroup.closure_union]
    rfl
  have hk := isKleinFour_closure_pair c.z (sourceU e)
    (by simpa only [pow_two] using hz2) (by simpa only [pow_two] using hu2)
    hz1 hu1 huz.symm (hc _ _ hm.1 hm.2)
  have hcard : Nat.card (zpowers c.z ⊔ zpowers (sourceU e) : Subgroup G)=4 := by
    rw [hcl]
    exact hk.card_four
  exact (eq_of_le_of_card_ge hle (by rw [hcard]; exact omega_card_le_four _ ei)).symm

/-- The actual endpoint normalizer of the marked four-group is transitive on its invariant fives. -/
theorem source_invariant_five_conjugator
    (hz : (e modelZ:G)=c.z)
    (hfive : (zpowers modelRotation).map (F.subtype.comp e.toMonoidHom)=B5Image B5)
    (D : Subgroup G) (hDF : D≤F) (hD : Nat.card D=5)
    (hVD : zpowers c.z ⊔ zpowers (sourceU e) ≤ normalizer (D : Set G)) :
    ∃ n ∈ F ⊓ normalizer ((zpowers c.z ⊔ zpowers (sourceU e) : Subgroup G) : Set G),
      (B5Image B5).conjBy n = D := by
  let φ := F.subtype.comp e.toMonoidHom
  have hφ : Function.Injective φ := F.subtype_injective.comp e.injective
  let D₀ := D.comap φ
  have hDm : D₀.map φ = D := by
    apply le_antisymm (map_comap_le _ _)
    intro x hx
    obtain ⟨a,ha⟩ := e.surjective ⟨x,hDF hx⟩
    have he : φ a = x := congrArg Subtype.val ha
    exact mem_map.mpr ⟨a,by change φ a∈D; rwa [he],he⟩
  have hD₀ : Nat.card D₀=5 := by
    rw [← hD,← hDm,card_map_of_injective hφ]
  let W := Stellmacher.omegaOneCenterAmbient (I.subgroupOf first)
  have hW : W.map φ = zpowers c.z ⊔ zpowers (sourceU e) := by
    rw [← Stellmacher.omegaOneCenterAmbient_map_injective φ hφ]
    exact source_omega_plane c e hz
  have hn₀ : W ≤ normalizer (D₀ : Set first) := by
    apply le_normalizer_iff.mpr
    intro a ha x hx
    change φ (a*x*a⁻¹)∈D
    rw [map_mul,map_mul,map_inv]
    exact (mem_normalizer_iff.mp (hVD (hW ▸ mem_map_of_mem φ ha)) (φ x)).mp hx
  obtain ⟨n,hn,hnD⟩ := exists_model_normalizing_conjugator D₀ hD₀ hn₀
  have hmap (A : Subgroup first) : (A.conjBy n).map φ = (A.map φ).conjBy (φ n) := by
    simp only [conjBy,map_map]
    congr 1
    ext x
    simp [MulAut.conj_apply]
  have hnW : (W.map φ).conjBy (φ n) = W.map φ := by
    rw [← hmap]
    have hfix : W.conjBy n = W :=
      mem_normalizer_iff_map_conj_eq.mp hn
    exact congrArg (fun A : Subgroup first => A.map φ) hfix
  have hB : (five.subgroupOf first).map φ=B5Image B5 := by
    rw [← hfive]
    congr 1
    apply map_injective first.subtype_injective
    have hf : five ≤ first := zpowers_le.mpr LongRootPaths.rotation_mem_first
    rw [map_subgroupOf_eq_of_le hf,MonoidHom.map_zpowers]
    rfl
  refine ⟨φ n,⟨(e n).property,?_⟩,?_⟩
  · apply mem_normalizer_iff_map_conj_eq.mpr
    rw [← hW]
    exact hnW
  · rw [← hB,← hmap,hnD,hDm]
end CFSG.Quasithin.ChapterJ.RuSubgroup.FiveHexagon.MarkedNormalizer
