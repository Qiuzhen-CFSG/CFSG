module
public import CFSG.Quasithin.ChapterJ.Section04To05.FiveHexagon.NormalizerSource
public import Theory.SpecificGroups.Tits.ExceptionalParabolics.FullRee.LongRootPaths.PlaneNormalizer

/-!
# The source endpoint plane normalizer centralizes its plane

The actual first-endpoint equivalence transports the intrinsic separation
u not conjugate to zu. An endpoint element fixes its central involution z,
so if it normalizes the four-group generated by z and u, it fixes u as well.
Thus the whole relative normalizer centralizes the original plane. This is
the genuine endpoint-action input in the direct J.4.10 parabolic argument;
no global subgroup recognition or permutation-action conclusion is assumed.
-/

public section
open Subgroup
namespace CFSG.Quasithin.ChapterJ.RuSubgroup.FiveHexagon.MarkedNormalizer
open Centralizers Centralizers.Choices MarkedInverter
open Tits.ExceptionalParabolics.FullRee
variable {G : Type*} [Group G] [Finite G] {d : LocalSetup G}
  (c : Choices d) {F : Subgroup G} (e : first ≃* F)

/-- The original endpoint retains the exact no-switch fusion statement. -/
theorem source_no_switch (hz : (e modelZ:G)=c.z) (g : G) (hg : g∈F) :
    g*sourceU e*g⁻¹ ≠ c.z*sourceU e := by
  intro h
  let φ := F.subtype.comp e.toMonoidHom
  have hφ : Function.Injective φ := F.subtype_injective.comp e.injective
  obtain ⟨a,ha⟩ := e.surjective ⟨g,hg⟩
  have hga : φ a=g := congrArg Subtype.val ha
  have he : a*modelU*a⁻¹=modelZ*modelU := by
    apply hφ
    simp only [map_mul,map_inv]
    change φ a*sourceU e*(φ a)⁻¹=(e modelZ:G)*sourceU e
    rw [hga,hz]
    exact h
  exact LongRootPaths.first_no_switch a.val a.property (congrArg Subtype.val he)

/-- The whole endpoint normalizer fixes the two original plane generators. -/
theorem source_plane_normalizer_centralizes (hz : (e modelZ:G)=c.z) :
    F ⊓ normalizer ((zpowers c.z ⊔ zpowers (sourceU e) : Subgroup G) : Set G) ≤
      centralizer ((zpowers c.z ⊔ zpowers (sourceU e) : Subgroup G) : Set G) := by
  rintro g ⟨hg,hn⟩
  have hz2 : c.z^2=1 := (orderOf_eq_prime_iff.mp (SourceCompletion.z_order c)).1
  obtain ⟨hu2,hu1,huz⟩ := source_involution_marks c e hz
  have hgfix : MulAut.conj g c.z=c.z := by
    obtain ⟨a,ha⟩ := e.surjective ⟨g,hg⟩
    have haz : a*modelZ*a⁻¹=modelZ := by
      apply Subtype.ext
      exact mul_inv_eq_of_eq_mul (mem_centralizer_singleton_iff.mp
        (LongRootPaths.first_eq_centralizer_z ▸ a.property))
    have he := congrArg (fun x:F => (x:G)) (congrArg e haz)
    simpa only [map_mul,map_inv,coe_mul,coe_inv,ha,hz,MulAut.conj_apply] using he
  have hzu : Commute c.z (sourceU e) := by
    have h := (source_marks_mem c e hz)
    obtain ⟨ei⟩ := sourceI_equiv e
    exact congrArg Subtype.val (ei.injective (by
      rw [map_mul,map_mul,mul_comm]) :
        (⟨c.z,h.1⟩:sourceI e)*⟨sourceU e,h.2⟩=⟨sourceU e,h.2⟩*(⟨c.z,h.1⟩:sourceI e))
  have hu : MulAut.conj g (sourceU e)=sourceU e := by
    have hm := (mem_normalizer_iff.mp hn (sourceU e)).mp (mem_sup_right (mem_zpowers _))
    have hcl : zpowers c.z ⊔ zpowers (sourceU e)=closure ({c.z,sourceU e}:Set G) := by
      rw [zpowers_eq_closure,zpowers_eq_closure,← Subgroup.closure_union]
      rfl
    rw [hcl] at hm
    rcases (mem_closure_pair_iff c.z (sourceU e)
      (by simpa only [pow_two] using hz2) (by simpa only [pow_two] using hu2) hzu _).mp hm with
      h1 | hz' | hu' | hzu'
    · exact False.elim (hu1 ((MulAut.conj g).injective (h1.trans (map_one _).symm)))
    · exact False.elim (huz ((MulAut.conj g).injective (hz'.trans hgfix.symm)))
    · exact hu'
    · exact False.elim (source_no_switch c e hz g hg hzu')
  have hfixed : zpowers c.z ⊔ zpowers (sourceU e) ≤
      (MulAut.conj g).toMonoidHom.eqLocus (MonoidHom.id G) :=
    sup_le (zpowers_le.mpr hgfix) (zpowers_le.mpr hu)
  intro x hx
  exact (mul_inv_eq_iff_eq_mul.mp (hfixed hx)).symm
end CFSG.Quasithin.ChapterJ.RuSubgroup.FiveHexagon.MarkedNormalizer
