module

public import Theory.SpecificGroups.SL2.FiveGeneratorRecognition
public import Theory.SpecificGroups.ReeTwo.ParabolicMarkedComparison.Verified

/-!
# Five-generated plane actions in a first-parabolic overgroup

A group generated by two order-five subgroups, acting on a five-plane with
a five-group kernel, is a five-group unless its order is divisible by three.
Indeed distinct nontrivial images generate SL₂(5); otherwise the image is
cyclic of order at most five. In the actual first Ree parabolic neither
three nor twenty-five divides its order, so the original five-subgroups
must coincide. This gives the linear contradiction in J.4.10, printed p.444,
without an intermediate assertion about a noncentral two-core.
-/

public section
noncomputable section
namespace CFSG.Quasithin.ChapterJ.RuSubgroup.FiveHexagon.ParabolicFiveUniqueness
open Subgroup Matrix
open scoped MatrixGroups
private instance : Fact (Nat.Prime 3) := ⟨by decide⟩
private instance : Fact (Nat.Prime 5) := ⟨by decide⟩

private theorem three_dvd_sl2 : 3∣Nat.card SL(2,ZMod 5) := by
  let t:SL(2,ZMod 5):=⟨!![0,-1;1,-1],by decide⟩
  have ht:t^3=1 := by decide +kernel
  have hn:t≠1 := by
    intro hh
    have hh:=congrArg (fun x:SL(2,ZMod 5)=>x.val 0 0) hh
    norm_num [t] at hh
  have ho:orderOf t=3 := orderOf_eq_prime_iff.mpr ⟨ht,hn⟩
  exact ho ▸ orderOf_dvd_natCard t

/-- The prime-plane image of two five-subgroups is a five-group when no
three divides the acting group. -/
theorem linear_range_isFive {K:Type*} [Group K] [Finite K]
    (A B:Subgroup K) (hA:Nat.card A=5) (hB:Nat.card B=5) (hgen:A⊔B=⊤)
    (h3:¬3∣Nat.card K) (ρ:K→*GL (Fin 2) (ZMod 5)) : IsPGroup 5 ρ.range := by
  let f:=ρ.rangeRestrict
  let A':=A.map f
  let B':=B.map f
  have hg:A'⊔B'=⊤ := by
    dsimp only [A',B']
    rw [← Subgroup.map_sup,hgen,map_top_of_surjective _ ρ.rangeRestrict_surjective]
  have hAd:Nat.card A'∣5 := by simpa only [hA] using A.card_map_dvd f
  have hBd:Nat.card B'∣5 := by simpa only [hB] using B.card_map_dvd f
  have hAP:IsPGroup 5 A':=IsPGroup.of_card_dvd_pow (n:=1) hAd
  have hBP:IsPGroup 5 B':=IsPGroup.of_card_dvd_pow (n:=1) hBd
  have topcase (U:Subgroup ρ.range) (hU:U=⊤) (hp:IsPGroup 5 U) : IsPGroup 5 ρ.range := by
    rw [hU] at hp
    exact hp.of_equiv (topEquiv : (⊤:Subgroup ρ.range)≃*ρ.range)
  rcases (Nat.dvd_prime (by decide : Nat.Prime 5)).mp hAd with hAc|hAc
  · have ha:A'=⊥:=card_eq_one.mp hAc
    exact topcase B' (by simpa only [ha,bot_sup_eq] using hg) hBP
  rcases (Nat.dvd_prime (by decide : Nat.Prime 5)).mp hBd with hBc|hBc
  · have hb:B'=⊥:=card_eq_one.mp hBc
    exact topcase A' (by simpa only [hb,sup_bot_eq] using hg) hAP
  by_cases he:A'=B'
  · exact topcase B' (by simpa only [he,sup_idem] using hg) hBP
  obtain ⟨e⟩:=Matrix.GeneralLinearGroup.equiv_sl2_of_five_generators
    A' B' hAc hBc he hg ρ.range.subtype ρ.range.subtype_injective
  exfalso
  apply h3
  have hd:3∣Nat.card ρ.range := (Nat.card_congr e.toEquiv).symm ▸ three_dvd_sl2
  exact hd.trans (card_range_dvd ρ)

/-- A five-group action kernel preserves the five-group conclusion. -/
theorem isFive_of_plane_action {K:Type*} [Group K] [Finite K]
    (A B:Subgroup K) (hA:Nat.card A=5) (hB:Nat.card B=5) (hgen:A⊔B=⊤)
    (h3:¬3∣Nat.card K) (ρ:K→*GL (Fin 2) (ZMod 5)) (hker:IsPGroup 5 ρ.ker) :
    IsPGroup 5 K := by
  have hp:=(linear_range_isFive A B hA hB hgen h3 ρ).comap_of_ker_isPGroup ρ hker
  have he:ρ.range.comap ρ=⊤ := by ext x; simp
  rw [he] at hp
  exact hp.of_equiv (topEquiv : (⊤:Subgroup K)≃*K)

/-- The two endpoint order obstructions force equality once the literal
five-plane action and its five-group kernel have been constructed. -/
theorem eq_of_plane_action {K:Type*} [Group K] [Finite K]
    (A B:Subgroup K) (hA:Nat.card A=5) (hB:Nat.card B=5) (hgen:A⊔B=⊤)
    (h3:¬3∣Nat.card K) (h25:¬25∣Nat.card K)
    (ρ:K→*GL (Fin 2) (ZMod 5)) (hker:IsPGroup 5 ρ.ker) : A=B := by
  have hp:=isFive_of_plane_action A B hA hB hgen h3 ρ hker
  obtain ⟨n,hn⟩:=IsPGroup.iff_card.mp hp
  have hle:n≤1 := by
    by_contra hnot
    apply h25
    rw [hn]
    exact pow_dvd_pow 5 (by omega : 2≤n)
  have hcard:Nat.card K≤5 := by rw [hn]; exact Nat.pow_le_pow_right (by decide) hle
  have hAt:A=⊤ := eq_of_le_of_card_ge le_top (by simpa only [card_top,hA] using hcard)
  have hBt:B=⊤ := eq_of_le_of_card_ge le_top (by simpa only [card_top,hB] using hcard)
  exact hAt.trans hBt.symm

/-- These obstructions come from the actual first endpoint, not a classifier tag. -/
theorem first_endpoint_order_obstructions {E:Type*} [Group E]
    (e:E≃*Tits.ExceptionalParabolics.FullRee.first) :
    ¬3∣Nat.card E ∧ ¬25∣Nat.card E := by
  have hc:Nat.card E=20480 := (Nat.card_congr e.toEquiv).trans
    ((Nat.card_congr ReeTwo.ParabolicMarkedComparison.Verified.firstEquiv.toEquiv).symm.trans
      ReeTwo.Centralizer.card)
  rw [hc]
  decide

end CFSG.Quasithin.ChapterJ.RuSubgroup.FiveHexagon.ParabolicFiveUniqueness
