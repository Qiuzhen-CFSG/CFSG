module
public import CFSG.Quasithin.ChapterJ.Section04To05.FiveHexagon.DiagonalCentralizer.Quotient

/-!
# The full original centralizer of the marked cyclic four

Its containment in H and exact Q-kernel are already proved. The actual
SL₂(5) contributes A₅ to H/Q and the marked I contributes an odd element,
so I, U and K exhaust the centralizer. Source: J.4.8 preparation, p.443.
-/

public section
noncomputable section
namespace CFSG.Quasithin.ChapterJ.RuSubgroup.FiveHexagon.DiagonalCentralizer
open Subgroup Centralizers Centralizers.Choices MarkedNormalizer MarkedInverter
open Tits.ExceptionalParabolics.FullRee
open scoped Pointwise
variable {G : Type*} [Group G] [Finite G] {d : LocalSetup G}
  (c : Choices d) (B5 : Sylow 5 d.toTypeRuSetup.H)
  {F : Subgroup G} (e : first ≃* F)

/-- The full original cyclic-four centralizer is generated by I, U and the
actual SL2(5) containing B5. Its whole-centralizer assertion is derived. -/
theorem centralizer_eq (hz : (e modelZ:G)=c.z)
    (hfive : (zpowers modelRotation).map (F.subtype.comp e.toMonoidHom)=B5Image B5)
    (K : Subgroup G) (hBK : B5Image B5≤K)
    (hKC : K≤centralizer (sourceIz e:Set G))
    (eK : K≃*Matrix.SpecialLinearGroup (Fin 2) (ZMod 5)) :
    centralizer (sourceIz e:Set G) = sourceI e ⊔ d.toTypeRuSetup.U ⊔ K := by
  let C := centralizer (sourceIz e:Set G)
  let A := sourceI e ⊔ d.toTypeRuSetup.U ⊔ K
  have hIC : sourceI e≤C := by
    obtain ⟨f⟩ := sourceI_equiv e
    intro i hi j hj
    have hjI := sourceIz_le_I e hj
    have hh : (⟨j,hjI⟩:sourceI e)*⟨i,hi⟩=⟨i,hi⟩*⟨j,hjI⟩ :=
      f.injective (by simp only [map_mul,mul_comm])
    exact congrArg Subtype.val hh
  have hUC : d.toTypeRuSetup.U≤C := by
    apply le_centralizer_iff.mpr
    exact (sourceIz_le_CQ c B5 e hz hfive).trans
      ((five_centralizer_le_HC B5).trans inf_le_right)
  have hAC : A≤C := sup_le (sup_le hIC hUC) hKC
  have hCH : C≤d.toTypeRuSetup.H := centralizer_le_H c e hz
  have hKH : K≤d.toTypeRuSetup.H := hKC.trans hCH
  have hAH : A≤d.toTypeRuSetup.H := hAC.trans hCH
  have hr := (componentMap_structure B5 K hKH hBK eK).2
  obtain ⟨t,htI,htodd⟩ := exists_odd_image c B5 e hz hfive
  have hex (x : d.toTypeRuSetup.H) :
      ∃ a : A, d.ru2.quotientMap (inclusion hAH a)=d.ru2.quotientMap x := by
    let q := d.ru2.quotientMap
    by_cases hx : (q x).sign=1
    · have hm : q x∈(componentMap K hKH).range :=
        hr.symm ▸ Equiv.Perm.mem_alternatingGroup.mpr hx
      obtain ⟨k,hk⟩ := hm
      exact ⟨⟨k,mem_sup_right k.property⟩,hk⟩
    · have hxneg : (q x).sign=-1 := (Int.units_eq_one_or _).resolve_left hx
      have htneg : (q t).sign=-1 := (Int.units_eq_one_or _).resolve_left htodd
      have hs : (q (x*t⁻¹)).sign=1 := by rw [map_mul,map_inv,map_mul,map_inv,hxneg,htneg]; decide
      have hm : q (x*t⁻¹)∈(componentMap K hKH).range :=
        hr.symm ▸ Equiv.Perm.mem_alternatingGroup.mpr hs
      obtain ⟨k,hk⟩ := hm
      refine ⟨⟨(k:G)*(t:G),A.mul_mem (mem_sup_right k.property)
        (mem_sup_left (mem_sup_left htI))⟩,?_⟩
      change q ((inclusion hKH k)*t)=q x
      rw [map_mul,show q (inclusion hKH k)=q (x*t⁻¹) from hk,← map_mul]
      simp only [inv_mul_cancel_right]
  apply le_antisymm _ hAC
  intro x hx
  obtain ⟨a,ha⟩ := hex ⟨x,hCH hx⟩
  have hmQ : (a:G)⁻¹*x∈d.toTypeRuSetup.Q := by
    have hk : (inclusion hAH a)⁻¹*(⟨x,hCH hx⟩:d.toTypeRuSetup.H)∈d.ru2.quotientMap.ker := by
      rw [MonoidHom.mem_ker,map_mul,map_inv,ha,inv_mul_cancel]
    rw [d.ru2.quotient_kernel] at hk
    exact hk
  have hmC : (a:G)⁻¹*x∈C := C.mul_mem (C.inv_mem (hAC a.property)) hx
  have hmA : (a:G)⁻¹*x∈A := by
    have hh : (a:G)⁻¹*x∈sourceIz e⊔d.toTypeRuSetup.U :=
      Q_inf_centralizer c B5 e hz hfive ▸ (show (a:G)⁻¹*x∈d.toTypeRuSetup.Q⊓C from ⟨hmQ,hmC⟩)
    exact (sup_le (le_sup_of_le_left ((sourceIz_le_I e).trans le_sup_left))
      (le_sup_of_le_left le_sup_right)) hh
  simpa only [mul_inv_cancel_left] using A.mul_mem a.property hmA

/-- The equality is the literal ordered product I·U·K, with actual elements. -/
theorem mem_centralizer_iff_product (hz : (e modelZ:G)=c.z)
    (hfive : (zpowers modelRotation).map (F.subtype.comp e.toMonoidHom)=B5Image B5)
    (K : Subgroup G) (hBK : B5Image B5≤K)
    (hKC : K≤centralizer (sourceIz e:Set G))
    (hIK : sourceI e≤normalizer K)
    (eK : K≃*Matrix.SpecialLinearGroup (Fin 2) (ZMod 5)) (x : G) :
    x∈centralizer (sourceIz e:Set G) ↔
      ∃ i∈sourceI e, ∃ u∈d.toTypeRuSetup.U, ∃ k∈K, i*u*k=x := by
  have hKH := hKC.trans (centralizer_le_H c e hz)
  have hKU := hKH.trans d.ru2.natural.normalized
  have hIU := (sourceI_le_H c e hz).trans d.ru2.natural.normalized
  have hIN : sourceI e≤normalizer ((d.toTypeRuSetup.U⊔K : Subgroup G):Set G) :=
    (le_inf hIU hIK).trans
      (normalizer_inf_normalizer_le_normalizer_sup d.toTypeRuSetup.U K)
  rw [centralizer_eq c B5 e hz hfive K hBK hKC eK,sup_assoc]
  constructor
  · intro hx
    have hp : x∈(sourceI e:Set G)*((d.toTypeRuSetup.U⊔K : Subgroup G):Set G) := by
      rw [← coe_mul_of_left_le_normalizer_right _ _ hIN]
      exact hx
    obtain ⟨i,hi,v,hv,he⟩ := hp
    have hvp : v∈(d.toTypeRuSetup.U:Set G)*(K:Set G) := by
      rw [← coe_mul_of_right_le_normalizer_left _ _ hKU]
      exact hv
    obtain ⟨u,hu,k,hk,huk⟩ := hvp
    change u*k=v at huk
    change i*v=x at he
    exact ⟨i,hi,u,hu,k,hk,by rw [mul_assoc,huk,he]⟩
  · rintro ⟨i,hi,u,hu,k,hk,rfl⟩
    exact mul_mem (mul_mem (mem_sup_left hi) (mem_sup_right (mem_sup_left hu)))
      (mem_sup_right (mem_sup_right hk))

end CFSG.Quasithin.ChapterJ.RuSubgroup.FiveHexagon.DiagonalCentralizer
