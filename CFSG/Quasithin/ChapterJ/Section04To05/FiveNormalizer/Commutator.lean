module

public import CFSG.Quasithin.ChapterJ.Section04To05.FiveDecomposition.Basic
public import CFSG.Quasithin.ChapterJ.Section04To05.Inverter
public import Theory.GroupTheory.PResidual.PerfectCover
public import Theory.GroupTheory.CentralBinaryInvolutionLift

/-!
# The original Q is generated by its K-displacements

The earlier Ru1 argument puts Q inside K=O²(H). Modulo [Q,K], its image
is central elementary binary: U already lies in [Q,B₅] and Q/U is binary.
The actual escaping conjugate involution maps nontrivially into K/Q=A₅.
Central Sylow transfer and A₅ involution fusion kill the central kernel.
Thus Q=[Q,K], supplying the full action required in J.4.4(3).

Indecomposability of an abstract six-dimensional S₅ module alone does not
imply this conclusion; the source containment Q≤K and the original involution
are both retained. Source: Aschbacher–Smith J.2.2(1), J.4.4(3), pp.432,441.
-/

public section
noncomputable section
open Subgroup
open scoped commutatorElement
namespace CFSG.Quasithin.ChapterJ.RuSubgroup
open Centralizers.Choices
variable {G : Type*} [Group G] [Finite G] (d : LocalSetup G)

theorem B5Image_le_K (B5 : Sylow 5 d.toTypeRuSetup.H) : B5Image B5 ≤ d.toTypeRuSetup.K := by
  have hc : Nat.card B5=5 := by
    have h := B5Image_card d.card_Z B5
    change Nat.card ((B5:Subgroup d.toTypeRuSetup.H).map d.toTypeRuSetup.H.subtype)=5 at h
    rwa [card_map_of_injective d.toTypeRuSetup.H.subtype_injective] at h
  rintro _ ⟨b,hb,rfl⟩
  have ho : orderOf b∣5 := by
    let x : (B5:Subgroup d.toTypeRuSetup.H) := ⟨b,hb⟩
    have hh := orderOf_dvd_natCard x
    change orderOf x ∣ Nat.card (B5:Subgroup d.toTypeRuSetup.H) at hh
    rw [hc] at hh
    exact (Subgroup.orderOf_coe x).symm ▸ hh
  exact mem_map.mpr ⟨b,mem_pResidual_of_orderOf_coprime
    ((by decide : Nat.Coprime 2 5).of_dvd_right ho),rfl⟩

theorem U_le_commutator_Q_K :
    d.toTypeRuSetup.U ≤ ⁅d.toTypeRuSetup.Q,d.toTypeRuSetup.K⁆ := by
  let B5 : Sylow 5 d.toTypeRuSetup.H := Classical.choice inferInstance
  exact (U_le_Q₅ d B5).trans (commutator_mono le_rfl (B5Image_le_K d B5))

theorem commutator_Q_K : ⁅d.toTypeRuSetup.Q,d.toTypeRuSetup.K⁆=d.toTypeRuSetup.Q := by
  let K := d.toTypeRuSetup.K
  let f := d.toTypeRuSetup.alternatingMap
  let N := ⁅f.ker,(⊤:Subgroup K)⁆
  have hm : N.map K.subtype=⁅d.toTypeRuSetup.Q,K⁆ := by
    rw [Subgroup.map_commutator,d.toTypeRuSetup.alternatingMap_kernel,
      map_subgroupOf_eq_of_le d.Q_le_K,←MonoidHom.range_eq_map,range_subtype]
  have hs (x:K) (hx:x∈f.ker) : x^2∈N := by
    have hxQ : (x:G)∈d.toTypeRuSetup.Q := by
      rw [d.toTypeRuSetup.alternatingMap_kernel] at hx
      exact hx
    let q : d.toTypeRuSetup.Q := ⟨x,hxQ⟩
    have hsq : ((q^2:d.toTypeRuSetup.Q):G)∈d.toTypeRuSetup.U := by
      apply (d.ru2.six.coordinates_eq_one_iff (q^2)).mp
      rw [map_pow]
      change (2:ℕ) • (d.ru2.six.coordinates q).toAdd=0
      rw [←Nat.cast_smul_eq_nsmul (ZMod 2),ZMod.natCast_self,zero_smul]
    have he : ((x^2:K):G)∈N.map K.subtype := by
      rw [hm]
      exact U_le_commutator_Q_K d hsq
    exact (mem_map_iff_mem K.subtype_injective).mp he
  obtain ⟨p⟩ := exists_plane d
  obtain ⟨s⟩ := p.exists_sourceChoice
  let v:K := ⟨s.v,s.v_mem_K⟩
  have hv:v^2=1 := Subtype.ext (by
    change s.v^2=1
    rw [←s.v_order]
    exact pow_orderOf_eq_one s.v)
  have hfv:f v≠1 := by
    intro h
    have hk:v∈f.ker:=h
    rw [d.toTypeRuSetup.alternatingMap_kernel] at hk
    exact s.v_not_Q hk
  have he := CentralBinaryInvolutionLift.alternating_five_commutator_kernel f
    d.toTypeRuSetup.alternatingMap_surjective
    (isPPerfect_embedded_pResidual 2 d.toTypeRuSetup.H) hs v hv hfv
  have hh := congrArg (Subgroup.map K.subtype) he
  rw [hm,d.toTypeRuSetup.alternatingMap_kernel,map_subgroupOf_eq_of_le d.Q_le_K] at hh
  exact hh

end CFSG.Quasithin.ChapterJ.RuSubgroup
