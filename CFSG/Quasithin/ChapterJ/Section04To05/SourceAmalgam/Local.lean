module

public import CFSG.Quasithin.ChapterJ.Section04To05.FiveNormalizer.Source
public import CFSG.Quasithin.ChapterJ.Section04To05.SecondParabolic.Local
public import CFSG.Quasithin.ChapterJ.Section04To05.ParabolicGeneration.CoreObstruction.TwoCore
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.BinaryRee.LocalData

/-!
# The actual binary Ree source amalgam in a group of type Ru

The unchanged source choices construct both endpoints and their common Sylow
subgroup. The first endpoint has Suzuki quotient of order twenty, the second
has symmetric quotient of order six, and both have characteristic two. The
original escaping involution forces the generated group's two-core to vanish.
Thus all original F.1.1 hypotheses, the exact endpoint intersection, and
faithfulness hold for the literal inclusions in the original ambient group.

This supplies the local input of J.4.5. Identification with the full binary Ree
amalgam is the separate F.1.12 recognition theorem; it is not asserted here.
Source: Aschbacher–Smith, J.4.4–5, printed pp.441–442.
-/

@[expose] public section
noncomputable section
open Subgroup
namespace CFSG.Quasithin.ChapterJ.RuSubgroup
open Centralizers.Choices
variable {G : Type*} [Group G] [Finite G] {d : LocalSetup G} (p : Plane d)

/-- The original group generated by the two constructed source endpoints. -/
def Plane.F (B5 : Sylow 5 d.toTypeRuSetup.H) (X : Sylow 3 p.parabolic) : Subgroup G :=
  p.F₁ B5 ⊔ p.F₂ B5 X

/-- The original source choices discharge every binary Ree local hypothesis. -/
theorem SourceChoice.exists_source_local (s : SourceChoice p)
    (B5 : Sylow 5 d.toTypeRuSetup.H) (hi : ∀ a ∈ B5Image B5, s.v*a*s.v⁻¹=a⁻¹) :
    ∃ X : Sylow 3 p.parabolic,
      p.F₂ B5 X ⊔ d.toTypeRuSetup.S = p.parabolic ∧
      ChapterF.Source.BinaryRee.LocalData (p.F₁ B5) (p.T_F B5) (p.F₂ B5 X) := by
  obtain ⟨X,hgen,_,hq,hchar,hSyl,hN⟩ := s.exists_second_local p B5 hi
  refine ⟨X,hgen,{
    le_left := p.T_F_le_F₁ B5
    le_right := p.T_F_le_F₂ B5 X
    sylow_left := s.T_F_sylow_F₁ p B5 hi
    sylow_right := hSyl
    normalizer_left := s.T_F_selfNormalizing_F₁ p B5 hi
    normalizer_right := hN
    quotient_left := s.F₁_quotient p B5 hi
    quotient_right := hq
    characteristic_left := s.F₁_characteristic_two p B5 hi
    characteristic_right := hchar
    core_free := ?_
    card_overlap := s.card_T_F p B5 hi }⟩
  exact s.joined_core_eq_bot B5 (p.F₁ B5) (p.F₂ B5 X) le_sup_right
    (le_sup_right.trans le_sup_left)
    ((p.S₂_le_A B5).trans (le_sup_left.trans le_sup_left)) hgen
    (s.F₁_twoCore_le_Q p B5 hi)

/-- The generated source group contains its ambient centralizer. -/
theorem Plane.centralizer_F_le (B5 : Sylow 5 d.toTypeRuSetup.H)
    (X : Sylow 3 p.parabolic) : centralizer (p.F B5 X : Set G) ≤ p.F B5 X := by
  have hfive : Q₅ d B5 ≤ p.F B5 X := le_sup_right.trans (le_sup_left.trans le_sup_left)
  apply le_trans (centralizer_le hfive)
  rw [centralizer_Q₅ d B5]
  exact d.ru2.natural.kernel_le.trans ((U_le_Q₅ d B5).trans hfive)

/-- A finite group of type Ru supplies the source F.1.1 data, with all choices
made in its original ambient group and no additional local premise. -/
theorem source_local_of_typeRu (h : IsTypeRu G) :
    ∃ (d : LocalSetup G) (p : Plane d) (s : SourceChoice p)
      (B5 : Sylow 5 d.toTypeRuSetup.H) (X : Sylow 3 p.parabolic),
      (∀ a ∈ B5Image B5, s.v*a*s.v⁻¹=a⁻¹) ∧
      p.F₂ B5 X ⊔ d.toTypeRuSetup.S = p.parabolic ∧
      ChapterF.Source.BinaryRee.LocalData (p.F₁ B5) (p.T_F B5) (p.F₂ B5 X) := by
  obtain ⟨d,p,⟨s⟩⟩ := source_J4_choice h
  obtain ⟨B5,hi⟩ := s.inverts_sylow_five
  obtain ⟨X,hgen,hl⟩ := s.exists_source_local p B5 hi
  exact ⟨d,p,s,B5,X,hi,hgen,hl⟩

/-- Original TypeRu yields the literal faithful inclusion amalgam and its
source F.1.1 contract. The public endpoint and middle maps are unchanged. -/
theorem source_faithful_amalgam_of_typeRu (h : IsTypeRu G) :
    ∃ (d : LocalSetup G) (p : Plane d)
      (B5 : Sylow 5 d.toTypeRuSetup.H) (X : Sylow 3 p.parabolic),
      ChapterF.Source.HypothesisF11 ![p.F₁ B5,p.F₂ B5 X] (p.T_F B5) ∧
      p.F₁ B5 ⊓ p.F₂ B5 X = p.T_F B5 ∧
      Theory.GroupTheory.RankTwoAmalgam.Faithful
        (Theory.GroupTheory.RankTwoAmalgam.ofSubgroups (p.F₁ B5) (p.T_F B5) (p.F₂ B5 X)
          (p.T_F_le_F₁ B5) (p.T_F_le_F₂ B5 X)) ∧
      Nat.card (p.T_F B5) = 4096 ∧
      Nat.card (p.F₁ B5) = 20480 ∧ Nat.card (p.F₂ B5 X) = 12288 := by
  obtain ⟨d,p,s,B5,X,hi,hgen,hl⟩ := source_local_of_typeRu h
  exact ⟨d,p,B5,X,hl.source_hypothesis,hl.intersection,hl.faithful,
    hl.card_overlap,hl.orders.2.1,hl.orders.2.2.2⟩

end CFSG.Quasithin.ChapterJ.RuSubgroup
