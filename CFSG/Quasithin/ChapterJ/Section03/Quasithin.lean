module
public import CFSG.Quasithin.ChapterJ.Section03.Source
public import CFSG.Quasithin.Defs
public import Theory.GroupTheory.PrimeRankNonabelianCube

/-!
# Quasithinness of an arbitrary TypeRu group

The original J.3.1 order shows that the only odd primes whose cubes divide
the group order are three and five. The actual Sylow subgroups supplied by
J.2.7 and J.3.6 are extraspecial of orders 27 and 125. Their nonabelian
prime-cube structure bounds their prime ranks by two. The remaining odd
prime ranks satisfy the elementary cube-free order bound.

Thus the original TypeRu group is strongly quasithin, and every actual
subgroup is quasithin. In particular this discharges the quasithin input
for the group generated by the J.4 parabolics before applying F.1.12; no
recognition as a concrete Rudvalis group is used.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*,
J.2.7(11), J.3.1 and J.3.6, printed pp.437–439.
-/

public section
open Subgroup
namespace CFSG.Quasithin.ChapterJ.Section03
open Centralizers
variable {G : Type*} [Group G] [Finite G]

private theorem cube_not_dvd_ru_order {p : ℕ} (hp : p.Prime)
    (hp2 : p≠2) (hp3 : p≠3) (hp5 : p≠5) :
    ¬p^3 ∣ 2^14*3^3*5^3*7*13*29 := by
  intro h
  have hd := (dvd_pow_self p (by decide : 3≠0)).trans h
  simp only [hp.dvd_mul,
    Nat.prime_dvd_prime_iff_eq hp (by decide : Nat.Prime 7),
    Nat.prime_dvd_prime_iff_eq hp (by decide : Nat.Prime 13),
    Nat.prime_dvd_prime_iff_eq hp (by decide : Nat.Prime 29)] at hd
  rcases hd with ((((h2 | h3) | h5) | h7) | h13) | h29
  · exact hp2 ((Nat.prime_dvd_prime_iff_eq hp Nat.prime_two).mp (hp.dvd_of_dvd_pow h2))
  · exact hp3 ((Nat.prime_dvd_prime_iff_eq hp Nat.prime_three).mp (hp.dvd_of_dvd_pow h3))
  · exact hp5 ((Nat.prime_dvd_prime_iff_eq hp (by decide : Nat.Prime 5)).mp
      (hp.dvd_of_dvd_pow h5))
  · subst p; norm_num at h
  · subst p; norm_num at h
  · subst p; norm_num at h

private theorem noncommutative_of_extraspecial {P : Type*} [Group P] {p : ℕ}
    (h : IsExtraspecial p P) : ¬IsMulCommutative P := by
  intro hab
  exact QuotientGroup.nontrivial_iff.mp h.quotient_nontrivial
    (center_eq_top_iff.mpr hab)

/-- The original local setup already bounds every odd prime rank. -/
theorem stronglyQuasithin_source {d : LocalSetup G} (c : Choices d) :
    IsStronglyQuasithin G := by
  intro p hp ho
  let : Fact p.Prime := ⟨hp⟩
  by_cases h3 : p=3
  · subst p
    obtain ⟨S,hS,he,_⟩ := SourceCompletion.cubic_sylow_source c
    exact primeRank_le_two_of_nonabelian_sylow_cube S (by simpa using hS)
      (noncommutative_of_extraspecial he)
  by_cases h5 : p=5
  · subst p
    obtain ⟨B5⟩ := (inferInstance : Nonempty (Sylow 5 d.toTypeRuSetup.H))
    obtain ⟨S,_,hS,he⟩ := five_oddPart_sylow c B5 (order_source c)
    exact primeRank_le_two_of_nonabelian_sylow_cube S (by simpa using hS)
      (noncommutative_of_extraspecial he)
  apply primeRank_le_two_of_cube_not_dvd
  rw [order_source c]
  exact cube_not_dvd_ru_order hp (by rintro rfl; norm_num at ho) h3 h5

/-- An arbitrary TypeRu group is strongly quasithin. -/
theorem stronglyQuasithin_of_typeRu (h : IsTypeRu G) : IsStronglyQuasithin G := by
  obtain ⟨d,⟨c⟩⟩ := SourceCompletion.local_choices_of_typeRu h
  exact stronglyQuasithin_source c

/-- The original TypeRu hypotheses imply quasithinness. -/
theorem quasithin_of_typeRu (h : IsTypeRu G) : IsQuasithin G :=
  (stronglyQuasithin_of_typeRu h).quasithin

/-- In particular the subgroup generated by the actual J.4 parabolics is quasithin. -/
theorem quasithin_subgroup_of_typeRu (h : IsTypeRu G) (F : Subgroup G) : IsQuasithin F :=
  ((stronglyQuasithin_of_typeRu h).subgroup F).quasithin

end CFSG.Quasithin.ChapterJ.Section03
