module

public import Theory.Representation.BinaryConjugationSection
public import Theory.Representation.PSL3Two.SmallModules
public import Theory.Representation.SL2FourNaturalOrbits.Model
public import Theory.GroupTheory.PCoreLocalSetup
public import Theory.GroupTheory.PResidual.Defs
public import Mathlib.GroupTheory.Frattini
public import Mathlib.GroupTheory.SpecificGroups.Alternating

/-!
# The source hypotheses for groups of type Ru

Ru1 retains L = N_G(V), S = O₂(L), the equalities
Z(S) = Φ(S) = [S,S] = V, and the natural and Steinberg conjugation
sections with a common actual L/S ≃ SL₃(2) marking. Ru2 retains
Z = Z(T), H = C_G(Z), Q = O₂(H), U = ⟨Vᴴ⟩, an actual H/Q ≃ S₅
marking, the restricted natural SL₂(4) action on U/Z, and the
six-dimensional indecomposable binary action on Q/U.

Surjective coordinate maps specify the literal subgroup kernels. Thus these
are module identifications, rather than dimension labels. The SL₂(4) action
is the restriction to the actual alternating subgroup of S₅; it is not the
different deleted five-point permutation module. K and L₁ below use the
two-residual O², while S, Q and R₁ use the two-core O₂.

`LocalSetup` additionally records the Sylow choice made at the start of J.2.
No recognition, local structural conclusion, or order of the ambient group
is included in these hypotheses. The terminal recognition theorem belongs
to J.5.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004,
§J.1–J.2, printed pp.431–438 (PDF pp.442–449).
-/

@[expose] public section
noncomputable section
namespace CFSG.Quasithin.ChapterJ
open Subgroup Representation
variable {G : Type*} [Group G]

abbrev S5 := Equiv.Perm (Fin 5)
abbrev FourSpace := Representation.SL2FourNatural.V
abbrev SixSpace := Fin 6 → ZMod 2

/-- The actual restricted natural SL₂(4) action, inside an S₅ action. -/
structure L2FourAction where
  action : Representation (ZMod 2) S5 FourSpace
  marking : Representation.SL2FourNatural.SL ≃* alternatingGroup (Fin 5)
  restriction (g : Representation.SL2FourNatural.SL) (v : FourSpace) :
    action (marking g) v = Representation.SL2FourNatural.action g v

/-- No nontrivial direct sum of invariant binary subspaces. -/
def Indecomposable (ρ : Representation (ZMod 2) S5 SixSpace) : Prop :=
  ∀ (A B : Submodule (ZMod 2) SixSpace),
    (∀ g v, v ∈ A → ρ g v ∈ A) →
    (∀ g v, v ∈ B → ρ g v ∈ B) →
    IsCompl A B → A = ⊥ ∨ B = ⊥

/-- Ru1, with one common L/S marking for the natural and Steinberg actions. -/
structure RuOne (L V : Subgroup G) where
  normalizer_eq : L = normalizer V
  center_eq : (center (L.pCoreIn 2)).map (L.pCoreIn 2).subtype = V
  frattini_eq : (frattini (L.pCoreIn 2)).map (L.pCoreIn 2).subtype = V
  derived_eq : (commutator (L.pCoreIn 2)).map (L.pCoreIn 2).subtype = V
  quotientMap : L →* BinaryLinearThree.Group
  quotient_surjective : Function.Surjective quotientMap
  quotient_kernel : quotientMap.ker = (L.pCoreIn 2).subgroupOf L
  natural : BinaryConjugationSection L V ⊥ (BinaryLinearThree.W.comp quotientMap)
  steinberg : BinaryConjugationSection L (L.pCoreIn 2) V
    (BinaryLinearThree.S.comp quotientMap)

/-- Z(T), in the ambient group. -/
def sylowCenter (T : Sylow 2 G) : Subgroup G :=
  (center T).map (T : Subgroup G).subtype

/-- The literal centralizer of Z(T). -/
def centralizerOfSylowCenter (T : Sylow 2 G) : Subgroup G :=
  centralizer (sylowCenter T : Set G)

/-- The subgroup generated by all H-conjugates of V. -/
def conjugateSpan (H V : Subgroup G) : Subgroup G :=
  ⨆ h : H, V.map (MulAut.conj (h : G)).toMonoidHom

/-- Ru2; the binary sections retain their actual kernels and conjugation action. -/
structure RuTwo (V : Subgroup G) (T : Sylow 2 G) where
  quotientMap : centralizerOfSylowCenter T →* S5
  quotient_surjective : Function.Surjective quotientMap
  quotient_kernel : quotientMap.ker =
    ((centralizerOfSylowCenter T).pCoreIn 2).subgroupOf (centralizerOfSylowCenter T)
  naturalAction : L2FourAction
  natural : BinaryConjugationSection (centralizerOfSylowCenter T)
    (conjugateSpan (centralizerOfSylowCenter T) V) (sylowCenter T)
    (naturalAction.action.comp quotientMap)
  sixAction : Representation (ZMod 2) S5 SixSpace
  indecomposable : Indecomposable sixAction
  six : BinaryConjugationSection (centralizerOfSylowCenter T)
    ((centralizerOfSylowCenter T).pCoreIn 2)
    (conjugateSpan (centralizerOfSylowCenter T) V) (sixAction.comp quotientMap)

/-- The source's Ru1/Ru2 hypotheses, without any recognition conclusion. -/
structure TypeRuSetup (G : Type*) [Group G] [Finite G] where
  L : Subgroup G
  V : Subgroup G
  T : Sylow 2 G
  ru1 : RuOne L V
  ru2 : RuTwo V T

/-- A group of type Ru, as defined on printed p.431. -/
def IsTypeRu (G : Type*) [Group G] [Finite G] : Prop := Nonempty (TypeRuSetup G)

/-- The compatible Sylow choice made at the start of J.2. -/
structure LocalSetup (G : Type*) [Group G] [Finite G] extends TypeRuSetup G where
  sylowInL : Sylow 2 L
  intersection_eq : (T : Subgroup G) ⊓ L = (sylowInL : Subgroup L).map L.subtype

namespace TypeRuSetup
variable [Finite G] (d : TypeRuSetup G)

/-- The special two-core of L. -/
abbrev S : Subgroup G := d.L.pCoreIn 2
/-- The center of the chosen Sylow two-group, in G. -/
abbrev Z : Subgroup G := sylowCenter d.T
/-- The centralizer of Z(T). -/
abbrev H : Subgroup G := centralizerOfSylowCenter d.T
/-- The two-core of H. -/
abbrev Q : Subgroup G := d.H.pCoreIn 2
/-- The H-conjugate span of V. -/
abbrev U : Subgroup G := conjugateSpan d.H d.V
/-- The two-residual of H, not its two-core. -/
def K : Subgroup G := (pResidual 2 d.H).map d.H.subtype
/-- The two-residual of C_L(Z). -/
def L₁ : Subgroup G :=
  (pResidual 2 ↥(d.L ⊓ d.H)).map (d.L ⊓ d.H).subtype
/-- The two-core of L₁. -/
abbrev R₁ : Subgroup G := d.L₁.pCoreIn 2
/-- The centralizer of U inside H. -/
abbrev HC : Subgroup G := d.H ⊓ centralizer (d.U : Set G)

end TypeRuSetup
end CFSG.Quasithin.ChapterJ
