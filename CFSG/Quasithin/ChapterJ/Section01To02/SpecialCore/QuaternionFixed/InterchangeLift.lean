module

public import CFSG.Quasithin.ChapterJ.Section01To02.SpecialCore.QuaternionFixed.CyclicLifts
public import CFSG.Quasithin.ChapterJ.Section01To02.SpecialCore.QuaternionFixed.Recognition

/-!
# From a moved cubic fixed vector to the second cyclic-four lift

Conjugate the first lift by an element of L representing the given model
normalizer element. Its Steinberg coordinate is again cubic fixed, so coprime
lifting supplies an element of C_S(B) with that coordinate. Two lifts of one
Steinberg coordinate have equal squares, since V is central of exponent two.
The new fixed lift therefore has order four. Its changed nonzero coordinate
puts it outside the cyclic group generated by the first lift.

Only the particular movement assertion in the actual Steinberg module remains
explicit in the final conditional application. Neither an ambient lift of an
outer automorphism nor an assumed second cyclic-four element is used.
The model calculation is the outer-involution argument on printed p.434.

Source: Aschbacher–Smith J.2.3(7), printed p.434 (PDF p.445),
combined manuscript of 1 March 2004.
-/

public section
noncomputable section
open Subgroup Representation Representation.BinaryOffender
open Representation.RegularCyclicNormalClosure
namespace CFSG.Quasithin.ChapterJ.SpecialCore
variable {G : Type*} [Group G] [Finite G]
local instance : AddCommGroup BinaryLinearThree.Steinberg := inferInstance
local instance : Module (ZMod 2) BinaryLinearThree.Steinberg := inferInstance

/-- Squares depend only on the actual Steinberg coordinate. -/
theorem steinberg_equal_coordinates_square (d : TypeRuSetup G) (x y : d.S)
    (hxy : d.ru1.steinberg.coordinates x = d.ru1.steinberg.coordinates y) :
    (x : G) ^ 2 = (y : G) ^ 2 := by
  let z := x⁻¹ * y
  have hz : (z : G) ∈ d.V := by
    apply (d.ru1.steinberg.coordinates_eq_one_iff z).mp
    change d.ru1.steinberg.coordinates (x⁻¹ * y) = 1
    rw [map_mul, map_inv, hxy]
    exact inv_mul_cancel _
  have hz2 : (z : G) ^ 2 = 1 := congrArg Subtype.val
    (d.ru1.natural.square_eq_one_of_trivial_kernel rfl ⟨z,hz⟩)
  have hxz : Commute (x : G) (z : G) := d.ru1.central_V hz x x.property
  calc
    (x : G) ^ 2 = (x : G) ^ 2 * (z : G) ^ 2 := by rw [hz2,mul_one]
    _ = ((x : G) * (z : G)) ^ 2 := (hxz.mul_pow 2).symm
    _ = (y : G) ^ 2 := by simp [z]

/-- A model normalizer moving the first fixed line constructs the second
order-four element in the literal cubic fixed subgroup. -/
theorem second_cyclicFour_of_model_movement (d : LocalSetup G)
    (B : Sylow 3 d.toTypeRuSetup.L₁)
    (hQK : d.toTypeRuSetup.Q ≤ d.toTypeRuSetup.K)
    (t : cubicFixedQ d.toTypeRuSetup B) (ht4 : orderOf t = 4)
    (g : BinaryLinearThree.Group) (hg : g ∈ normalizer (cubicImage d.toTypeRuSetup B))
    (hmove : BinaryLinearThree.S g
      (d.ru1.steinberg.coordinates ⟨t,cubicFixedQ_le_S d B hQK t.property⟩).toAdd ≠
      (d.ru1.steinberg.coordinates ⟨t,cubicFixedQ_le_S d B hQK t.property⟩).toAdd) :
    ∃ e : cubicFixedQ d.toTypeRuSetup B, orderOf e = 4 ∧ e ∉ zpowers t := by
  classical
  let D := d.toTypeRuSetup
  let tS : D.S := ⟨t,cubicFixedQ_le_S d B hQK t.property⟩
  let v := (D.ru1.steinberg.coordinates tS).toAdd
  have hv : v ∈ fixedSpace BinaryLinearThree.S (cubicImage D B) :=
    (cubicFixedSCoordinates D B ⟨t,tS.property,t.property.2⟩).toAdd.property
  have hv0 : v ≠ 0 := by
    intro he
    apply hmove
    change BinaryLinearThree.S g v = v
    rw [he,map_zero]
  have hw : BinaryLinearThree.S g v ∈ fixedSpace BinaryLinearThree.S (cubicImage D B) := by
    intro a
    have ha : g⁻¹ * (a : BinaryLinearThree.Group) * g ∈ cubicImage D B := by
      simpa only [inv_inv] using (mem_normalizer_iff.mp
        ((normalizer (cubicImage D B : Set BinaryLinearThree.Group)).inv_mem hg)
          (a : BinaryLinearThree.Group)).mp a.property
    have hh := hv ⟨g⁻¹ * a * g,ha⟩
    change BinaryLinearThree.S a (BinaryLinearThree.S g v) = BinaryLinearThree.S g v
    calc
      _ = BinaryLinearThree.S g (BinaryLinearThree.S (g⁻¹ * a * g) v) := by
        simp only [map_mul, Module.End.mul_apply]
        simp
      _ = _ := congrArg (BinaryLinearThree.S g) hh
  obtain ⟨y,hy⟩ := cubicFixedSCoordinates_surjective D B (Multiplicative.ofAdd ⟨_,hw⟩)
  let yS : D.S := ⟨y,y.property.1⟩
  have hycoord : (D.ru1.steinberg.coordinates yS).toAdd = BinaryLinearThree.S g v :=
    congrArg (fun w => w.toAdd.val) hy
  obtain ⟨l,hl⟩ := D.ru1.quotient_surjective g
  let xS : D.S := ⟨(l : G) * t * (l : G)⁻¹,
    (mem_normalizer_iff.mp (D.ru1.steinberg.normalized l.property) t).mp tS.property⟩
  have hxcoord : D.ru1.steinberg.coordinates xS = D.ru1.steinberg.coordinates yS := by
    apply Multiplicative.toAdd.injective
    refine (D.ru1.steinberg.equivariant l tS).trans ?_
    change BinaryLinearThree.S (D.ru1.quotientMap l) v = _
    rw [hl,hycoord]
  have hx2 : (xS : G) ^ 2 ≠ 1 := by
    intro he
    have ht2 : (t : G) ^ 2 = 1 := by
      apply (MulAut.conj (l : G)).injective
      rw [map_pow,map_one]
      exact he
    have hh : t ^ 2 = 1 := Subtype.ext ht2
    have hd := orderOf_dvd_of_pow_eq_one hh
    norm_num [ht4] at hd
  have hy2 : (yS : G) ^ 2 ≠ 1 := by
    rw [← steinberg_equal_coordinates_square D xS yS hxcoord]
    exact hx2
  have hyQ : (y : G) ∈ cubicFixedQ D B := by
    rw [cubicFixedQ_eq_cubicFixedS d B hQK]
    exact y.property
  let e : cubicFixedQ D B := ⟨y,hyQ⟩
  have he4 : orderOf e = 4 := by
    apply orderOf_eq_prime_pow (p := 2) (n := 1)
    · intro hh
      exact hy2 (congrArg Subtype.val hh)
    · exact Subtype.ext (congrArg (fun x : D.S => (x : G)) (D.ru1.pow_four yS))
  refine ⟨e,he4,?_⟩
  intro he
  rw [mem_zpowers_iff_mem_range_orderOf, ht4] at he
  obtain ⟨k,hk,heq⟩ := Finset.mem_image.mp he
  have hk4 : k < 4 := Finset.mem_range.mp hk
  have hcoord : D.ru1.steinberg.coordinates yS = D.ru1.steinberg.coordinates (tS ^ k) := by
    apply congrArg D.ru1.steinberg.coordinates
    apply Subtype.ext
    exact (congrArg Subtype.val heq).symm
  have ht2coord : D.ru1.steinberg.coordinates (tS ^ 2) = 1 :=
    (D.ru1.steinberg.coordinates_eq_one_iff _).mpr (D.ru1.square_mem_V tS)
  have ht3coord : D.ru1.steinberg.coordinates (tS ^ 3) = D.ru1.steinberg.coordinates tS := by
    rw [pow_succ, map_mul, ht2coord, one_mul]
  have hw0 : BinaryLinearThree.S g v ≠ 0 := by
    intro he
    exact hv0 ((BinaryLinearThree.S.apply_bijective g).injective (he.trans (map_zero _).symm))
  interval_cases k
  · have he : D.ru1.steinberg.coordinates yS = 1 := by simpa only [pow_zero,map_one] using hcoord
    exact hw0 (hycoord.symm.trans (congrArg Multiplicative.toAdd he))
  · have he : D.ru1.steinberg.coordinates yS = D.ru1.steinberg.coordinates tS := by
      simpa only [pow_one] using hcoord
    exact hmove (hycoord.symm.trans (congrArg Multiplicative.toAdd he))
  · exact hw0 (hycoord.symm.trans (congrArg Multiplicative.toAdd (hcoord.trans ht2coord)))
  · exact hmove (hycoord.symm.trans (congrArg Multiplicative.toAdd (hcoord.trans ht3coord)))

/-- The remaining model-only premise for the source quaternion conclusion.
The moving vector is supplied by the actual nonabelian Suzuki factor; all
orders, intersections, fixed lifts and noncommutativity are discharged here. -/
theorem cubicFixedQ_equiv_quaternion_of_model_interchange (d : LocalSetup G)
    (B : Sylow 3 d.toTypeRuSetup.L₁) (c : SingerChoice d.toTypeRuSetup B)
    (hQK : d.toTypeRuSetup.Q ≤ d.toTypeRuSetup.K)
    (hfull : ∀ t : d.toTypeRuSetup.S, (t : G) ∉ d.V →
      ⁅zpowers (t : G),d.toTypeRuSetup.S⁆ = d.V)
    (s : G) (hs : s ∈ fixedCore d.toTypeRuSetup c.B7) (hs1 : s ≠ 1)
    (hmove : ∀ v : BinaryLinearThree.Steinberg,
      v ∈ displacementSpan BinaryLinearThree.S (singerImage d.toTypeRuSetup B c)
        (sectionImage d.toTypeRuSetup (d.toTypeRuSetup.S ⊓ centralizer ({s} : Set G))) →
      v ≠ 0 → v ∈ fixedSpace BinaryLinearThree.S (cubicImage d.toTypeRuSetup B) →
      ∃ g : BinaryLinearThree.Group, g ∈ normalizer (cubicImage d.toTypeRuSetup B) ∧
        BinaryLinearThree.S g v ≠ v) :
    Nonempty (cubicFixedQ d.toTypeRuSetup B ≃* QuaternionGroup 2) := by
  let D := d.toTypeRuSetup
  obtain ⟨t,ht,htM,htV⟩ := c.exists_cubicFixed_order_four d B hQK hfull s hs hs1
  let tS : D.S := ⟨t,cubicFixedQ_le_S d B hQK t.property⟩
  let v := (D.ru1.steinberg.coordinates tS).toAdd
  have hvM := c.movingCore_coordinates_mem D B s tS htM
  have hv0 : v ≠ 0 := fun h => htV ((D.ru1.steinberg.coordinates_eq_one_iff tS).mp h)
  have hv : v ∈ fixedSpace BinaryLinearThree.S (cubicImage D B) :=
    (cubicFixedSCoordinates D B ⟨t,tS.property,t.property.2⟩).toAdd.property
  obtain ⟨g,hg,hgv⟩ := hmove v hvM hv0 hv
  obtain ⟨e,he,het⟩ := second_cyclicFour_of_model_movement d B hQK t ht g hg hgv
  have hinter : Nat.card (cubicFixedQ D B ⊓ d.V : Subgroup G) = 2 := by
    rw [cubicFixedQ_inf_V d B,d.card_Z]
  have hnoncomm := cubicFixedQ_not_commutative d B (cubicFixedQ_eq_cubicFixedS d B hQK)
    (cubicFixedQ_card d B hQK) hinter hfull
  exact QuaternionGroup.equiv_of_card_eight_two_cyclic_four (cubicFixedQ_card d B hQK)
    hnoncomm t e ht he het

end CFSG.Quasithin.ChapterJ.SpecialCore
