/-!
# The parabolic core equalities and residual containment in J.2.2(1)

The image of Q in the actual S₄ parabolic quotient is a nontrivial normal
two-subgroup: triviality would give Q ≤ S, hence Q = S by their equal orders.
The normal-subgroup dichotomy for the S₄ two-core identifies this image with
the entire four-group. Taking its preimage gives O₂(L ∩ H) = QS.

The common Ru1 marking also identifies the action on S/Φ(S) with the
Steinberg action. Its full parabolic commutator space and Frattini lifting
give [L ∩ H,S] = S. Passing to the nilpotent quotient by O²(L ∩ H) therefore
puts S in L₁. The model parabolic core lies in its two-residual; lifting
through the now-absorbed kernel puts O₂(L ∩ H) in L₁. Relative normality
identifies this core with R₁, and residual functoriality gives Q ≤ O²(H).

Source: Aschbacher–Smith, combined manuscript of 1 March 2004,
J.2.2(1), printed p.432 (PDF p.443).
-/

@[expose] public section
noncomputable section
namespace CFSG.Quasithin.ChapterJ
open Subgroup Representation Matrix.PSL3Two
open scoped commutatorElement
variable {G : Type*} [Group G] [Finite G]

/-- The two special cores have equal order but are distinct. -/
theorem LocalSetup.not_Q_le_S (d : LocalSetup G) :
    ¬ d.toTypeRuSetup.Q ≤ d.toTypeRuSetup.S := by
  intro h
  exact d.Q_ne_S (eq_of_le_of_card_ge h (by
    rw [d.ru1.card_S, d.ru2.card_Q d.card_Z]))

/-- The literal parabolic two-core is QS. -/
theorem LocalSetup.parabolic_core_eq_Q_sup_S (d : LocalSetup G) :
    d.parabolic.pCoreIn 2 = d.toTypeRuSetup.Q ⊔ d.toTypeRuSetup.S := by
  let P := d.parabolic
  let f := d.parabolicMap.rangeRestrict
  let Q := d.toTypeRuSetup.Q.subgroupOf P
  have hQP : d.toTypeRuSetup.Q ≤ P := le_inf d.Q_le_L (pCoreIn_le 2 _)
  have hSP : d.toTypeRuSetup.S ≤ P := le_inf (pCoreIn_le 2 _) d.S_le_H
  have hk : f.ker = d.toTypeRuSetup.S.subgroupOf P := by
    rw [MonoidHom.ker_rangeRestrict]
    exact d.parabolicMap_kernel
  have hp : IsPGroup 2 f.ker := by
    rw [hk]
    exact (isPGroup_pCoreIn 2 d.L).comap_subtype
  have hqn : Q.Normal := normal_subgroupOf_of_le_normalizer
    (inf_le_right.trans d.ru2.six.normalized)
  let : Q.Normal := hqn
  have himgn : (Q.map f).Normal := hqn.map f d.parabolicMap.rangeRestrict_surjective
  let : (Q.map f).Normal := himgn
  have himgp : IsPGroup 2 (Q.map f) :=
    ((isPGroup_pCoreIn 2 d.toTypeRuSetup.H).comap_subtype).map f
  have himgle : Q.map f ≤ pCore 2 d.parabolicMap.range := le_sSup ⟨himgn, himgp⟩
  have himgne : Q.map f ≠ ⊥ := by
    intro he
    have hle := (Q.map_eq_bot_iff).mp he
    rw [hk] at hle
    exact d.not_Q_le_S (fun q hq => hle (show (⟨q, hQP hq⟩ : P) ∈ Q from hq))
  have himg : Q.map f = pCore 2 d.parabolicMap.range :=
    (Matrix.PSL3Two.ParabolicCoreModel.normal_le_core d.parabolicImageEquivS4
      (Q.map f) himgle).resolve_left himgne
  have he := f.comap_pCore_of_ker_isPGroup d.parabolicMap.rangeRestrict_surjective hp
  rw [← himg, comap_map_eq, hk] at he
  have hm := congrArg (fun A : Subgroup P => A.map P.subtype) he.symm
  rw [Subgroup.map_sup, map_subgroupOf_eq_of_le hQP, map_subgroupOf_eq_of_le hSP] at hm
  exact hm

/-- The first remaining equality in J.2.2(1). -/
theorem LocalSetup.Q_sup_S_eq_parabolic_core (d : LocalSetup G) :
    d.toTypeRuSetup.Q ⊔ d.toTypeRuSetup.S =
      (d.toTypeRuSetup.L₁ ⊔ (d.T : Subgroup G)).pCoreIn 2 := by
  rw [← d.H_inf_L, inf_comm]
  exact d.parabolic_core_eq_Q_sup_S.symm

/-- The Steinberg section of the actual overlap is generated by its displacements. -/
theorem LocalSetup.parabolic_steinberg_commutator (d : LocalSetup G) :
    BinaryOffender.subspaceCommutator BinaryLinearThree.S ⊤ d.parabolicMap.range = ⊤ := by
  obtain ⟨g, hg⟩ := d.parabolic_image
  rw [hg]
  exact BinaryLinearThree.SteinbergStructure.LocalActions.point_conjugate_commutator_eq_top g

/-- Frattini lifting of the Steinberg commutator calculation. -/
theorem LocalSetup.commutator_parabolic_S (d : LocalSetup G) :
    ⁅d.parabolic, d.toTypeRuSetup.S⁆ = d.toTypeRuSetup.S := by
  let S := d.toTypeRuSetup.S
  let C := ⁅d.parabolic, S⁆
  have hCS : C ≤ S := le_normalizer_iff_commutator_le_right.mp
    (inf_le_left.trans d.ru1.steinberg.normalized)
  let D := C.subgroupOf S
  let f : S →* Multiplicative BinaryLinearThree.Steinberg := d.ru1.steinberg.coordinates
  let W : Submodule (ZMod 2) BinaryLinearThree.Steinberg :=
    AddSubgroup.toZModSubmodule 2 (Subgroup.toAddSubgroup' (D.map f))
  have hspan : BinaryOffender.subspaceCommutator BinaryLinearThree.S ⊤
      d.parabolicMap.range ≤ W := by
    apply Submodule.span_le.mpr
    rintro w ⟨a, ⟨l, rfl⟩, v, _, rfl⟩
    obtain ⟨s, rfl⟩ := d.ru1.steinberg.onto (Multiplicative.ofAdd v)
    let c : S := ⟨(l : G) * s * (l : G)⁻¹,
      le_normalizer_iff.mp d.ru1.steinberg.normalized l l.property.1 s s.property⟩
    have he : (f c).toAdd = BinaryLinearThree.S (d.parabolicMap l) (f s).toAdd :=
      d.ru1.steinberg.equivariant ⟨l, l.property.1⟩ s
    change Multiplicative.ofAdd (BinaryLinearThree.S (d.parabolicMap l) (f s).toAdd -
      (f s).toAdd) ∈ D.map f
    refine mem_map.mpr ⟨c * s⁻¹, ?_, ?_⟩
    · exact commutator_mem_commutator l.property s.property
    · apply Multiplicative.toAdd.injective
      rw [map_mul, map_inv]
      change (f c).toAdd + -(f s).toAdd = _
      rw [he, toAdd_ofAdd]
      exact (sub_eq_add_neg (BinaryLinearThree.S (d.parabolicMap l) (f s).toAdd)
        (f s).toAdd).symm
  rw [d.parabolic_steinberg_commutator] at hspan
  have hmap : (D.map f : Subgroup (Multiplicative BinaryLinearThree.Steinberg)) = ⊤ := by
    apply top_unique
    intro v _
    exact hspan (show v.toAdd ∈ (⊤ : Submodule (ZMod 2) BinaryLinearThree.Steinberg) from trivial)
  have hker : f.ker = frattini S := by
    change d.ru1.steinberg.coordinates.ker = _
    rw [d.ru1.steinberg.kernel_eq, ← d.ru1.frattini_eq]
    exact comap_map_eq_self_of_injective S.subtype_injective _
  have hsup := congrArg (fun B : Subgroup (Multiplicative BinaryLinearThree.Steinberg) =>
    B.comap f) hmap
  rw [comap_map_eq, hker, comap_top] at hsup
  have hD : D = ⊤ := frattini_nongenerating hsup
  have hm := congrArg (fun B : Subgroup S => B.map S.subtype) hD
  rw [map_subgroupOf_eq_of_le hCS, ← MonoidHom.range_eq_map, range_subtype] at hm
  exact hm

private theorem le_residual_of_full_commutator {X : Type*} [Group X] [Finite X]
    (A : Subgroup X) (h : ⁅(⊤ : Subgroup X), A⁆ = A) : A ≤ pResidual 2 X := by
  let q := QuotientGroup.mk' (pResidual 2 X)
  let B := A.map q
  have hB : ⁅(⊤ : Subgroup (X ⧸ pResidual 2 X)), B⁆ = B := by
    have hm := congrArg (fun U : Subgroup X => U.map q) h
    rw [map_commutator, ← MonoidHom.range_eq_map,
      MonoidHom.range_eq_top_of_surjective q (QuotientGroup.mk'_surjective _)] at hm
    exact hm
  have hn := (isPGroup_quotient_pResidual (G := X) 2).isNilpotent
  obtain ⟨n, hn⟩ := Subgroup.nilpotent_iff_lowerCentralSeries.mp hn
  have hseries : ∀ n, B ≤ (⊤ : Subgroup (X ⧸ pResidual 2 X)).lowerCentralSeries n := by
    intro n
    induction n with
    | zero => exact le_top
    | succ n ih =>
      rw [Subgroup.lowerCentralSeries_succ, ← hB, commutator_comm ⊤ B]
      exact commutator_mono ih le_rfl
  have hbot : B = ⊥ := le_bot_iff.mp (hn ▸ hseries n)
  have hk := (A.map_eq_bot_iff).mp hbot
  simpa only [q, QuotientGroup.ker_mk'] using hk

/-- The special core is absorbed by the two-residual of the overlap. -/
theorem LocalSetup.S_le_L₁ (d : LocalSetup G) :
    d.toTypeRuSetup.S ≤ d.toTypeRuSetup.L₁ := by
  have hSP : d.toTypeRuSetup.S ≤ d.parabolic := le_inf (pCoreIn_le 2 _) d.S_le_H
  let A := d.toTypeRuSetup.S.subgroupOf d.parabolic
  have hcomm : ⁅(⊤ : Subgroup d.parabolic), A⁆ = A := by
    apply Subgroup.map_injective d.parabolic.subtype_injective
    rw [map_commutator, ← MonoidHom.range_eq_map, range_subtype,
      map_subgroupOf_eq_of_le hSP, d.commutator_parabolic_S]
  have hm := Subgroup.map_mono (f := d.parabolic.subtype)
    (le_residual_of_full_commutator A hcomm)
  rwa [map_subgroupOf_eq_of_le hSP] at hm

private theorem core_le_residual_of_symmetric_four {X : Type*} [Group X] [Finite X]
    (e : X ≃* Equiv.Perm (Fin 4)) : pCore 2 X ≤ pResidual 2 X := by
  have hmodel : pCore 2 pointParabolicSL ≤ pResidual 2 pointParabolicSL := by
    apply (Subgroup.map_le_map_iff_of_injective pointParabolicSL.subtype_injective).mp
    change pointParabolicSL.pCoreIn 2 ≤ MarkedAutomorphisms.residual pointParabolicSL
    rw [MarkedProduct.pointParabolic_core, MarkedAutomorphisms.point_residual]
    exact MarkedAutomorphisms.pointV_le
  let e' := e.trans MarkedAutomorphisms.pointEquivSymmetric.symm
  apply (Subgroup.map_le_map_iff_of_injective (f := e'.toMonoidHom) e'.injective).mp
  rw [pCore_map_iso, map_pResidual_of_surjective 2 e'.toMonoidHom e'.surjective]
  exact hmodel

/-- The entire parabolic two-core is contained in its two-residual. -/
theorem LocalSetup.parabolic_core_le_L₁ (d : LocalSetup G) :
    d.parabolic.pCoreIn 2 ≤ d.toTypeRuSetup.L₁ := by
  let f := d.parabolicMap.rangeRestrict
  have hk : f.ker = d.toTypeRuSetup.S.subgroupOf d.parabolic := by
    rw [MonoidHom.ker_rangeRestrict]
    exact d.parabolicMap_kernel
  have hkle : f.ker ≤ pResidual 2 d.parabolic := by
    rw [hk]
    intro s hs
    have hm := d.S_le_L₁ hs
    obtain ⟨r, hr, he⟩ := hm
    have hrs : r = s := Subtype.ext he
    rwa [hrs] at hr
  have hmap : (pCore 2 d.parabolic).map f ≤ pResidual 2 d.parabolicMap.range := by
    apply le_trans _ (core_le_residual_of_symmetric_four d.parabolicImageEquivS4)
    exact le_sSup ⟨Subgroup.Normal.map inferInstance f d.parabolicMap.rangeRestrict_surjective,
      pCore_isPGroup.map f⟩
  have hc := Subgroup.comap_mono (f := f) hmap
  rw [← map_pResidual_of_surjective 2 f d.parabolicMap.rangeRestrict_surjective,
    comap_map_eq_self hkle] at hc
  exact Subgroup.map_mono ((le_comap_map f _).trans hc)

/-- The second remaining core equality in J.2.2(1). -/
theorem LocalSetup.parabolic_core_eq_R₁ (d : LocalSetup G) :
    (d.toTypeRuSetup.L₁ ⊔ (d.T : Subgroup G)).pCoreIn 2 = d.toTypeRuSetup.R₁ := by
  rw [← d.H_inf_L, inf_comm]
  exact (pCoreIn_embedded_pResidual_eq_of_core_le 2 d.parabolic d.parabolic_core_le_L₁).symm

/-- The final residual-containment assertion of J.2.2(1). -/
theorem LocalSetup.Q_le_K (d : LocalSetup G) : d.toTypeRuSetup.Q ≤ d.toTypeRuSetup.K := by
  have hQcore : d.toTypeRuSetup.Q ≤ d.parabolic.pCoreIn 2 := by
    rw [d.parabolic_core_eq_Q_sup_S]
    exact le_sup_left
  exact (hQcore.trans d.parabolic_core_le_L₁).trans
    (embedded_pResidual_mono 2 inf_le_right)

end CFSG.Quasithin.ChapterJ
