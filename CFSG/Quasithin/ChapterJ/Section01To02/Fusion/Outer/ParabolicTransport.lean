module

public import CFSG.Quasithin.ChapterJ.Section01To02.ParabolicStructure.CoreEquality
public import CFSG.Quasithin.ChapterJ.Section01To02.Fusion.Statements
public import Theory.SpecificGroups.PSL3Two.InvolutionConjugacy

/-!
# Transport from L outside S to H outside K in J.2.6

The literal Ru1 image of L ∩ H is a point parabolic, hence S₄. The preceding
J.2.2(1) calculation gives S ≤ L₁ ≤ K. Therefore its intersection with K has
a proper image in S₄: otherwise kernel absorption would put all of T in K,
contradicting O²(S₅) = A₅ and the residual/Sylow supplement in H.

Since S₄ is generated by transpositions, that proper image omits an
involution. All involutions in SL₃(2) are conjugate. Lifting a conjugator
through the actual Ru1 map sends each involution of L outside S into H
outside K. Membership in H is checked with the natural fixed-vector
criterion; no normalization of a chosen cubic subgroup is inferred from
quotient conjugacy.

This is an intrinsic proof of the transport used in J.2.6, printed p.435
(PDF p.446 of `refs/quasithin.pdf`, Aschbacher–Smith, 1 March 2004).
The earlier results are imported from `ParabolicStructure.CoreEquality`
(producer `qt-j12-parabolic-core-equality`, assembled by
`qt-j12-parabolic-structure`); no extra preceding-source premise remains.
-/

public section
open Subgroup
noncomputable section
namespace CFSG.Quasithin.ChapterJ.Fusion.Outer
variable {G : Type*} [Group G] [Finite G]

private theorem exists_involution_outside {X : Type*} [Group X]
    (e : X ≃* Equiv.Perm (Fin 4)) (A : Subgroup X) (hA : A ≠ ⊤) :
    ∃ b : X, b ∉ A ∧ orderOf b = 2 := by
  classical
  by_contra hn
  have hall (b : X) (hb : orderOf b = 2) : b ∈ A := by
    by_contra hbA
    exact hn ⟨b, hbA, hb⟩
  apply hA
  apply top_unique
  intro x _
  have hperm (σ : Equiv.Perm (Fin 4)) : e.symm σ ∈ A := by
    induction σ using Equiv.Perm.swap_induction_on with
    | one => simpa only [map_one] using A.one_mem
    | swap_mul σ a b hab ih =>
      rw [map_mul]
      apply A.mul_mem _ ih
      apply hall
      rw [e.symm.orderOf_eq]
      exact (show (Equiv.swap a b).IsSwap from ⟨a, b, hab, rfl⟩).orderOf
  simpa only [e.symm_apply_apply] using hperm (e x)

private theorem not_T_le_K (d : LocalSetup G) :
    ¬ (d.T : Subgroup G) ≤ d.toTypeRuSetup.K := by
  intro h
  have hTR : (d.T.subtype d.toTypeRuSetup.T_le_H : Subgroup d.toTypeRuSetup.H) ≤
      pResidual 2 d.toTypeRuSetup.H := by
    intro t ht
    obtain ⟨r, hr, he⟩ := h ht
    have he' : r = t := Subtype.ext he
    exact he' ▸ hr
  have hR : pResidual 2 d.toTypeRuSetup.H = ⊤ := by
    simpa only [sup_eq_left.mpr hTR] using
      pResidual_sup_sylow_eq_top (d.T.subtype d.toTypeRuSetup.T_le_H)
  have hA := map_pResidual_of_surjective 2 d.ru2.quotientMap d.ru2.quotient_surjective
  rw [hR, ← MonoidHom.range_eq_map,
    MonoidHom.range_eq_top_of_surjective _ d.ru2.quotient_surjective,
    Equiv.Perm.twoResidual_eq_alternating] at hA
  have hs : Equiv.swap (0 : Fin 5) 1 ∈ alternatingGroup (Fin 5) := by
    rw [← hA]
    trivial
  have hs' := hs
  change Equiv.Perm.sign (Equiv.swap (0 : Fin 5) 1) = 1 at hs'
  norm_num [Equiv.Perm.sign_swap] at hs'

private theorem parabolic_kernel_le_K (d : LocalSetup G) :
    d.parabolicMap.rangeRestrict.ker ≤ d.toTypeRuSetup.K.subgroupOf d.parabolic := by
  rw [MonoidHom.ker_rangeRestrict, d.parabolicMap_kernel]
  exact fun x hx => (d.S_le_L₁.trans (embedded_pResidual_mono 2 inf_le_right)) hx

private theorem parabolic_K_image_ne_top (d : LocalSetup G) :
    (d.toTypeRuSetup.K.subgroupOf d.parabolic).map d.parabolicMap.rangeRestrict ≠ ⊤ := by
  intro he
  have hc := congrArg (fun A : Subgroup d.parabolicMap.range =>
    A.comap d.parabolicMap.rangeRestrict) he
  rw [comap_map_eq_self (parabolic_kernel_le_K d), comap_top] at hc
  apply not_T_le_K d
  intro t ht
  have hm : (⟨t, d.T_le_L ht, d.toTypeRuSetup.T_le_H ht⟩ : d.parabolic) ∈
      d.toTypeRuSetup.K.subgroupOf d.parabolic := by rw [hc]; trivial
  exact hm

/-- Intrinsic transport through the actual point-parabolic image. -/
theorem transport_involutions (d : LocalSetup G) :
    ∀ i ∈ involutionsOutside d.L d.toTypeRuSetup.S,
      ∃ j ∈ involutionsOutside d.toTypeRuSetup.H d.toTypeRuSetup.K, IsConj i j := by
  intro i hi
  let iL : d.L := ⟨i, hi.1⟩
  have hi2 : orderOf (d.ru1.quotientMap iL) = 2 := by
    apply orderOf_eq_prime
    · rw [← map_pow]
      have hipow : iL ^ 2 = 1 := Subtype.ext (hi.2.2 ▸ pow_orderOf_eq_one i)
      rw [hipow, map_one]
    · intro he
      have hk : iL ∈ d.ru1.quotientMap.ker := he
      rw [d.ru1.quotient_kernel] at hk
      exact hi.2.1 hk
  obtain ⟨b, hbK, hb2⟩ := exists_involution_outside d.parabolicImageEquivS4
    ((d.toTypeRuSetup.K.subgroupOf d.parabolic).map d.parabolicMap.rangeRestrict)
    (parabolic_K_image_ne_top d)
  have hbSL : orderOf (b : BinaryLinearThree.Group) = 2 :=
    (orderOf_injective d.parabolicMap.range.subtype d.parabolicMap.range.subtype_injective b).trans hb2
  have hconj : IsConj (d.ru1.quotientMap iL) (b : BinaryLinearThree.Group) := by
    let e := Matrix.PSL3Two.equiv
    have hp := Matrix.PSL3Two.isConj_of_orderOf_eq_two _ _
      ((e.orderOf_eq _).trans hi2) ((e.orderOf_eq _).trans hbSL)
    simpa only [MulEquiv.coe_toMonoidHom, MulEquiv.symm_apply_apply] using
      e.symm.toMonoidHom.map_isConj hp
  obtain ⟨g, hg⟩ := isConj_iff.mp hconj
  obtain ⟨l, hl⟩ := d.ru1.quotient_surjective g
  let jL : d.L := l * iL * l⁻¹
  have hjb : d.ru1.quotientMap jL = b := by
    change d.ru1.quotientMap (l * iL * l⁻¹) = _
    rw [map_mul, map_mul, map_inv, hl]
    exact hg
  obtain ⟨w, hw, hfix⟩ := d.exists_parabolic_fixed_vector
  have hjH : (jL : G) ∈ d.toTypeRuSetup.H := by
    apply (hfix jL).mpr
    rw [hjb]
    obtain ⟨p, hp⟩ := b.property
    rw [← hp]
    exact (hfix ⟨p, p.property.1⟩).mp p.property.2
  have hjK : (jL : G) ∉ d.toTypeRuSetup.K := by
    intro hk
    apply hbK
    exact mem_map.mpr ⟨⟨jL, jL.property, hjH⟩, hk, Subtype.ext hjb⟩
  refine ⟨jL, ⟨hjH, hjK, ?_⟩, ?_⟩
  · exact ((MulAut.conj (l : G)).orderOf_eq i).trans hi.2.2
  · exact isConj_iff.mpr ⟨(l : G), rfl⟩

end CFSG.Quasithin.ChapterJ.Fusion.Outer
