module

public import CFSG.Quasithin.ChapterJ.Section01To02.Fusion.Outer.Defs
public import Theory.Representation.FirstCohomologyDuality.Indecomposable
public import CFSG.Quasithin.ChapterJ.Section01To02.Fusion.Outer.ModuleActions.Sections
public import CFSG.Quasithin.ChapterJ.Section01To02.Fusion.Outer.ModuleActions.Natural
public import CFSG.Quasithin.ChapterJ.Section01To02.Fusion.Outer.ModuleActions.Indecomposable.Coordinates

/-!
# Indecomposability and movement on the fixed kernel in J.2.5

The natural head is commutator-generated. If any odd permutation fixes the
A₅-fixed kernel, the entire S₅ action fixes it. Indecomposability then makes
the six-dimensional representation a cover, whose two-dimensional kernel
is bounded by H¹ of the contragredient natural head.

The semilinear normalizer puts the given outer involution in Frobenius
coordinates, and the natural cohomology calculation gives
`dim H¹(S₅, FourSpace*) ≤ 1`. The kernel therefore cannot be fixed.
This proves the independent module step of J.2.5 and applies it to the literal
Q/U → Q/HC projection. The earlier commutator premise retained in that
consumer is precisely J.2.2(3); the full OuterActionData assembly is separate.

Source: Aschbacher–Smith, J.2.2(3) and J.2.5, printed pp.432, 434
(PDF pp.443, 445 of `refs/quasithin.pdf`).
-/

public section

open Representation Representation.OneCohomology
open scoped commutatorElement
noncomputable section
namespace CFSG.Quasithin.ChapterJ.Fusion.Outer

/-- The marked natural head is generated by action differences. -/
theorem natural_commutator_eq_top (r : L2FourAction) :
    Coinvariants.ker r.action = ⊤ := by
  let b : S5 := Equiv.swap 0 1 * Equiv.swap 1 2
  have hb : b ∈ alternatingGroup (Fin 5) :=
    Equiv.Perm.mem_alternatingGroup.mpr (by decide +kernel)
  have hb3 : (⟨b, hb⟩ : alternatingGroup (Fin 5)) ^ 3 = 1 := by
    apply Subtype.ext
    change b ^ 3 = 1
    decide +kernel
  have hb1 : (⟨b, hb⟩ : alternatingGroup (Fin 5)) ≠ 1 := by
    intro h
    exact (show b ≠ 1 by decide +kernel) (congrArg Subtype.val h)
  let f : FourSpace →ₗ[ZMod 2] FourSpace := r.action b - 1
  have hfi : Function.Injective f := by
    apply LinearMap.ker_eq_bot.mp
    apply bot_unique
    intro v hv
    exact natural_cubic_fixed_free r ⟨b, hb⟩ hb3 hb1 v (sub_eq_zero.mp hv)
  have hfs := LinearMap.surjective_of_injective hfi
  apply top_unique
  intro v _
  obtain ⟨w, rfl⟩ := hfs v
  exact Coinvariants.sub_mem_ker b w

/-- Since A₅ has index two, one odd actor fixing the kernel makes the whole
S₅ action trivial there. -/
theorem kernel_fixed_of_alternating_and_outer
    (ρ : Representation (ZMod 2) S5 SixSpace) (p : SixSpace →ₗ[ZMod 2] FourSpace)
    (hA : ∀ a : alternatingGroup (Fin 5), ∀ v ∈ p.ker, ρ a v = v)
    (t : S5) (ht : t ∉ alternatingGroup (Fin 5))
    (hfix : ∀ v ∈ p.ker, ρ t v = v) : p.ker ≤ fixed ρ := by
  have hts : t.sign = -1 := (Int.units_eq_one_or _).resolve_left
    (fun h => ht (Equiv.Perm.mem_alternatingGroup.mpr h))
  intro v hv g
  by_cases hg : g ∈ alternatingGroup (Fin 5)
  · exact hA ⟨g, hg⟩ v hv
  · have hgs : g.sign = -1 := (Int.units_eq_one_or _).resolve_left
      (fun h => hg (Equiv.Perm.mem_alternatingGroup.mpr h))
    have hgt : g * t⁻¹ ∈ alternatingGroup (Fin 5) := by
      rw [Equiv.Perm.mem_alternatingGroup, map_mul, map_inv, hgs, hts]
      simp
    have he := hA ⟨g * t⁻¹, hgt⟩ v hv
    calc
      ρ g v = ρ (g * t⁻¹) (ρ t v) := by
        rw [← Module.End.mul_apply, ← map_mul]
        simp
      _ = ρ (g * t⁻¹) v := by rw [hfix v hv]
      _ = v := he

/-- Rank-nullity for any surjection onto the marked natural four-space. -/
theorem finrank_kernel_six_to_four
    (p : SixSpace →ₗ[ZMod 2] FourSpace) (hp : Function.Surjective p) :
    Module.finrank (ZMod 2) p.ker = 2 := by
  have h := p.finrank_range_add_finrank_ker
  rw [LinearMap.range_eq_top.mpr hp, finrank_top, SL2FourNatural.finrank_vector] at h
  have hsix : Module.finrank (ZMod 2) SixSpace = 6 := by simp [SixSpace]
  omega

/-- The cohomological reduction of the independent module step in J.2.5.
The bound concerns the full S₅ contragredient, not only its A₅ restriction. -/
theorem kernel_moved_of_H1_bound
    (r : L2FourAction) (ρ : Representation (ZMod 2) S5 SixSpace)
    (p : SixSpace →ₗ[ZMod 2] FourSpace) (hind : Indecomposable ρ)
    (hp : Function.Surjective p)
    (he : ∀ g v, p (ρ g v) = r.action g (p v))
    (hA : ∀ a : alternatingGroup (Fin 5), ∀ v ∈ p.ker, ρ a v = v)
    (hH1 : Module.finrank (ZMod 2) (H1 r.action.dual) ≤ 1)
    (t : S5) (ht : t ∉ alternatingGroup (Fin 5)) :
    ∃ v ∈ p.ker, ρ t v ≠ v := by
  by_contra! hfix
  let P : ρ.IntertwiningMap r.action := p.intertwiningMap_of_isIntertwiningMap _ _ he
  have hf : P.toLinearMap.ker ≤ fixed ρ :=
    kernel_fixed_of_alternating_and_outer ρ p hA t ht hfix
  have hc : IsCover P := isCover_of_indecomposable P hp hf
    (natural_commutator_eq_top r) hind
  have hd := finrank_ker_le_H1_of_cover P hc
  have hk : Module.finrank (ZMod 2) P.toLinearMap.ker = 2 :=
    finrank_kernel_six_to_four p hp
  omega

/-- An outer involution moves a vector of the A₅-fixed kernel of an
indecomposable six-dimensional extension of the actual natural SL₂(4) module.
The semilinear coordinates and cohomology bound are both discharged. -/
theorem kernel_moved
    (r : L2FourAction) (ρ : Representation (ZMod 2) S5 SixSpace)
    (p : SixSpace →ₗ[ZMod 2] FourSpace) (hind : Indecomposable ρ)
    (hp : Function.Surjective p)
    (he : ∀ g v, p (ρ g v) = r.action g (p v))
    (hA : ∀ a : alternatingGroup (Fin 5), ∀ v ∈ p.ker, ρ a v = v)
    (t : S5) (ht : t ∉ alternatingGroup (Fin 5)) (ht2 : t * t = 1) :
    ∃ v ∈ p.ker, ρ t v ≠ v :=
  kernel_moved_of_H1_bound r ρ p hind hp he hA
    (r.finrank_dual_H1_le_one t ht ht2) t ht

variable {G : Type*} [Group G] [Finite G]

/-- Apply the cohomological reduction to the literal Q/U → Q/HC projection.
The commutator premise is the earlier J.2.2(3) input owned by the parabolic
structure proof. The H¹ bound remains a separate representation calculation. -/
theorem NaturalHead.sixProjection_kernel_moved_of_H1_bound
    (d : LocalSetup G) (head : NaturalHead d.toTypeRuSetup)
    (hfixed : ∀ q ∈ d.toTypeRuSetup.HC, ∀ k ∈ d.toTypeRuSetup.K,
      ⁅k, q⁆ ∈ d.toTypeRuSetup.U)
    (hH1 : Module.finrank (ZMod 2) (H1 head.action.action.dual) ≤ 1)
    (t : S5) (ht : t ∉ alternatingGroup (Fin 5)) :
    ∃ v ∈ (head.sixProjection d).ker, d.ru2.sixAction t v ≠ v :=
  kernel_moved_of_H1_bound head.action d.ru2.sixAction (head.sixProjection d)
    d.ru2.indecomposable (head.sixProjection_surjective d)
    (head.sixProjection_equivariant d) (head.sixProjection_kernel_fixed d hfixed)
    hH1 t ht

/-- The J.2.5 module step on the literal Q/U → Q/HC projection. The sole
earlier-source premise is that K centralizes HC/U, from J.2.2(3). -/
theorem NaturalHead.sixProjection_kernel_moved
    (d : LocalSetup G) (head : NaturalHead d.toTypeRuSetup)
    (hfixed : ∀ q ∈ d.toTypeRuSetup.HC, ∀ k ∈ d.toTypeRuSetup.K,
      ⁅k, q⁆ ∈ d.toTypeRuSetup.U)
    (t : S5) (ht : t ∉ alternatingGroup (Fin 5)) (ht2 : t * t = 1) :
    ∃ v ∈ (head.sixProjection d).ker, d.ru2.sixAction t v ≠ v :=
  kernel_moved head.action d.ru2.sixAction (head.sixProjection d)
    d.ru2.indecomposable (head.sixProjection_surjective d)
    (head.sixProjection_equivariant d) (head.sixProjection_kernel_fixed d hfixed)
    t ht ht2

end CFSG.Quasithin.ChapterJ.Fusion.Outer
