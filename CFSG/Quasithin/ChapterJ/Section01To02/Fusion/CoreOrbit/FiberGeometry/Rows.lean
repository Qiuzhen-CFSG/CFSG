module

public import CFSG.Quasithin.ChapterJ.Section01To02.SpecialCore.Basic

/-!
# Restricted commutator rows in the special two-core

The class-two commutator homomorphism of S restricts to every A ≤ S.
Its image, transported through the actual inclusion S → G, is [⟨w⟩,A],
and its kernel is the literal centralizer C_A(w). The first isomorphism
theorem computes the product of the image and kernel orders.

These are the row calculations used with A = U and A = HC in J.2.8.
They reuse `Subgroup.ClassTwo.commutatorHom`; no ambient normality of A
is asserted or needed.

Source: Aschbacher–Smith, J.2.8, printed p.437 / PDF p.448,
using the special-group calculation in J.2.3 on printed p.433.
-/

@[expose] public section
noncomputable section
open Subgroup
open scoped commutatorElement
namespace CFSG.Quasithin.ChapterJ.Fusion.CoreOrbit.GeometryRows
variable {G : Type*} [Group G] [Finite G]

/-- Restrict the actual S-commutator homomorphism and embed its values in G. -/
def row (d : LocalSetup G) (w : d.toTypeRuSetup.S)
    (A : Subgroup G) (hA : A ≤ d.toTypeRuSetup.S) : A →* G :=
  d.toTypeRuSetup.S.subtype.comp
    ((ClassTwo.commutatorHom d.ru1.classTwo w).comp (inclusion hA))

/-- The restricted homomorphism evaluates to the ambient commutator. -/
theorem row_apply (d : LocalSetup G) (w : d.toTypeRuSetup.S)
    (A : Subgroup G) (hA : A ≤ d.toTypeRuSetup.S) (a : A) :
    row d w A hA a = ⁅(w : G), (a : G)⁆ := rfl

/-- The image is the subgroup generated by the literal commutators with A. -/
theorem row_range (d : LocalSetup G) (w : d.toTypeRuSetup.S)
    (A : Subgroup G) (hA : A ≤ d.toTypeRuSetup.S) :
    (row d w A hA).range = ⁅zpowers (w : G), A⁆ := by
  let f := (ClassTwo.commutatorHom d.ru1.classTwo w).comp (inclusion hA)
  have hc : f.range ≤ center d.toTypeRuSetup.S := by
    rintro _ ⟨a, rfl⟩
    exact d.ru1.classTwo (commutator_mem_commutator (mem_top _) (mem_top _))
  let : f.range.Normal := ⟨fun x hx g => by
    rw [mem_center_iff.mp (hc hx) g, mul_inv_cancel_right]
    exact hx⟩
  let π := QuotientGroup.mk' f.range
  have ht (a : A) : Commute (π w) (π (inclusion hA a)) := by
    apply commutatorElement_eq_one_iff_mul_comm.mp
    rw [← map_commutatorElement]
    exact (QuotientGroup.eq_one_iff _).mpr ⟨a, rfl⟩
  have he : f.range = ⁅zpowers w, A.subgroupOf d.toTypeRuSetup.S⁆ := by
    apply le_antisymm
    · rintro _ ⟨a, rfl⟩
      exact commutator_mem_commutator (mem_zpowers _) a.property
    · apply commutator_le.mpr
      intro z hz a ha
      obtain ⟨n, rfl⟩ := mem_zpowers_iff.mp hz
      apply (QuotientGroup.eq_one_iff _).mp
      change π ⁅w ^ n, a⁆ = 1
      rw [map_commutatorElement, map_zpow]
      exact commutatorElement_eq_one_iff_mul_comm.mpr
        ((ht ⟨a, ha⟩).zpow_left n).eq
  change (d.toTypeRuSetup.S.subtype.comp f).range = _
  rw [MonoidHom.range_comp, he, map_commutator, MonoidHom.map_zpowers,
    map_subgroupOf_eq_of_le hA]
  rfl

/-- Kernel-image counting with the centralizer embedded in G. -/
theorem row_card (d : LocalSetup G) (w : d.toTypeRuSetup.S)
    (A : Subgroup G) (hA : A ≤ d.toTypeRuSetup.S) :
    Nat.card (⁅zpowers (w : G), A⁆ : Subgroup G) *
      Nat.card (A ⊓ centralizer ({(w : G)} : Set G) : Subgroup G) = Nat.card A := by
  let f := row d w A hA
  have hk : f.ker = (centralizer ({(w : G)} : Set G)).subgroupOf A := by
    ext a
    change ⁅(w : G), (a : G)⁆ = 1 ↔ _
    rw [commutatorElement_eq_one_iff_mul_comm]
    exact eq_comm.trans mem_centralizer_singleton_iff.symm
  have hh := f.ker.index_mul_card
  rw [index_ker, row_range, hk, ← inf_subgroupOf_left,
    Nat.card_congr (subgroupOfEquivOfLe inf_le_left).toEquiv] at hh
  exact hh

end CFSG.Quasithin.ChapterJ.Fusion.CoreOrbit.GeometryRows
