module

public import CFSG.Quasithin.ChapterJ.Section01To02.Centralizers.Defs
public import Theory.GroupTheory.FullAutomizerNormalizerControl
public import Theory.GroupTheory.OddThreeCentralizerContainment

/-!
# Conditional completion of the odd-prime deductions in J.2.10

The odd complement is generated by its three four-group centralizers,
so the local centralizer calculations force it into Y. This gives
C_G(Y) = Y S₀. A full automizer inside N_G(S₀) then traps N_G(Y) there.
The order |N_G(S₀)| = 12 |Sz(8)| = 349440 promotes the chosen local
prime subgroup to a Sylow subgroup of G, for p = 7 or 13. The actual
conjugation image is cyclic of order p-1.

The complement, its three centralizers, the normalizer order and the full
local action remain explicit inputs. They must come from Burnside's
normal-complement theorem and the preceding J.2.9 identification; this
conditional deduction alone is not J.2.10 from the Ru hypotheses.

The printed proof's equality C_G(Y) ∩ N_G(S₀) = S₀ cannot be used:
Y lies in that intersection. The valid odd-complement calculation below
does not require that equality.

Source: Aschbacher–Smith, J.2.10, printed p.438 (PDF p.449).
-/

public section
noncomputable section
open Subgroup
namespace CFSG.Quasithin.ChapterJ.Centralizers
variable {G : Type*} [Group G] [Finite G]

/-- The generation step with the actual ambient centralizers and odd complement. -/
theorem centralizer_eq_of_odd_complement (Y E P : Subgroup G) [IsMulCommutative Y]
    (hodd : Odd (Nat.card P)) (a b : normalizer (P : Set G))
    (ha : a ^ 2 = 1) (hb : b ^ 2 = 1) (hab : Commute a b)
    (hdecomp : centralizer (Y : Set G) = P ⊔ E)
    (hfix : ∀ t ∈ ({(a : G), (b : G), ((a * b : normalizer (P : Set G)) : G)} : Set G),
      P ⊓ centralizer ({t} : Set G) ≤ Y) :
    centralizer (Y : Set G) = Y ⊔ E := by
  have hPY := le_of_three_odd_centralizers P Y hodd a b ha hb hab hfix
  apply le_antisymm
  · rw [hdecomp]
    exact sup_le_sup_right hPY E
  · exact sup_le (le_centralizer Y) (by rw [hdecomp]; exact le_sup_right)

namespace Choices
variable {d : LocalSetup G} (c : Choices d)

/-- J.2.10's Sylow, normalizer, centralizer and automizer outputs after the
specified odd-complement and local Sz(8) calculations. The Sylow subgroup
of L_s is sent to G by its literal inclusion. -/
theorem oddPrime_conclusions_of_odd_complement {p : ℕ} [Fact p.Prime]
    (hp : p = 7 ∨ p = 13) (Y : Sylow p c.Ls) (hY : Nat.card Y = p)
    (P : Subgroup G) (hodd : Odd (Nat.card P))
    (a b : normalizer (P : Set G))
    (ha : a ^ 2 = 1) (hb : b ^ 2 = 1) (hab : Commute a b)
    (hdecomp : centralizer ((Y : Subgroup c.Ls).map c.Ls.subtype : Set G) = P ⊔ c.S0)
    (hfix : ∀ t ∈ ({(a : G), (b : G), ((a * b : normalizer (P : Set G)) : G)} : Set G),
      P ⊓ centralizer ({t} : Set G) ≤ (Y : Subgroup c.Ls).map c.Ls.subtype)
    (hNcard : Nat.card (normalizer (c.S0 : Set G)) = 349440)
    (haction : ∀ α : MulAut ((Y : Subgroup c.Ls).map c.Ls.subtype),
      ∃ n : normalizer ((Y : Subgroup c.Ls).map c.Ls.subtype : Set G),
        (n : G) ∈ normalizer (c.S0 : Set G) ∧
        ((Y : Subgroup c.Ls).map c.Ls.subtype).normalizerMonoidHom n = α) :
    let YG := (Y : Subgroup c.Ls).map c.Ls.subtype
    Nat.card YG = p ∧
      (∃ S : Sylow p G, (S : Subgroup G) = YG) ∧
      normalizer (YG : Set G) ≤ normalizer (c.S0 : Set G) ∧
      centralizer (YG : Set G) = YG ⊔ c.S0 ∧
      IsCyclic YG.normalizerMonoidHom.range ∧
      Nat.card YG.normalizerMonoidHom.range = p - 1 := by
  let YG := (Y : Subgroup c.Ls).map c.Ls.subtype
  let M := normalizer (c.S0 : Set G)
  have hYG : Nat.card YG = p := by
    rw [card_map_of_injective c.Ls.subtype_injective]
    exact hY
  let : IsCyclic YG := isCyclic_of_prime_card hYG
  have hC : centralizer (YG : Set G) = YG ⊔ c.S0 :=
    centralizer_eq_of_odd_complement YG c.S0 P hodd a b ha hb hab hdecomp hfix
  have hE : c.S0 ≤ centralizer (YG : Set G) := hC ▸ le_sup_right
  have hYM : YG ≤ M := (le_centralizer_iff.mp hE).trans (centralizer_le_normalizer _)
  have hCM : centralizer (YG : Set G) ≤ M := by
    rw [hC]
    exact sup_le hYM le_normalizer
  have hNM : normalizer (YG : Set G) ≤ M :=
    normalizer_le_of_full_action YG M hCM haction
  have hindex : ¬ p ∣ YG.relIndex M := by
    have hi := (YG.subgroupOf M).index_mul_card
    rw [Nat.card_congr (subgroupOfEquivOfLe hYM).toEquiv, hYG] at hi
    change YG.relIndex M * p = Nat.card M at hi
    rw [hNcard] at hi
    rcases hp with rfl | rfl <;> omega
  have hSylow := exists_sylow_of_local_index YG M (Y.isPGroup'.map c.Ls.subtype) hindex hNM
  have hA : Function.Surjective YG.normalizerMonoidHom := by
    intro α
    obtain ⟨n, _, hn⟩ := haction α
    exact ⟨n, hn⟩
  exact ⟨hYG, hSylow, hNM, hC, prime_full_automizer YG hYG hA⟩

end Choices
end CFSG.Quasithin.ChapterJ.Centralizers
