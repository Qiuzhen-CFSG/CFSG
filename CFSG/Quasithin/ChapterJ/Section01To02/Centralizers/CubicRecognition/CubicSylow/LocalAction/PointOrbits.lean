module

public import CFSG.Quasithin.ChapterJ.Section01To02.Centralizers.CubicRecognition.CubicSylow.LocalAction.PointOrbits.GeometryInputs
public import CFSG.Quasithin.ChapterJ.Section01To02.Centralizers.CubicRecognition.CubicSylow.LocalAction.PointOrbits.ProjectiveGeometry

/-!
# Fixed subgroups and subgroup points in the cubic action

`marked_fixed_data` in the `PointOrbits` namespace proves
both fixed-subgroup orders, the actual ordered setwise product and ambient
fusion of the first factor to B, under the primitive placement and
transposition hypotheses. `GeometryInputs` retains the literal action on
all order-three subgroups, identifies the fixed singleton B and the
C_R(f) point, and counts all thirteen points in the abelian branch.

`projective_geometry_of_abelian` gives the exhaustive, pairwise disjoint
1,4,8 orbit partition and identifies the literal C_R(f) point stabilizer
with the subgroup generated by z and f, of index four. The theorem below
assembles this with the fixed-subgroup orders, setwise product and fusion.
The geometry uses rotation periods and the thirteen-point count, deriving
exponent three from the original action. It does not use the subsequent
abelian-branch exclusion. The unconditional marked placement remains with
the local-action owner.

Source: Aschbacher–Smith, J.2.7, printed p.437 (PDF p.448).
-/

public section

open Subgroup
open scoped Pointwise

namespace CFSG.Quasithin.ChapterJ.Centralizers.CubicSylow.LocalAction.PointOrbits
variable {G : Type*} [Group G] [Finite G] {d : LocalSetup G} (c : Choices d)

/-- The fixed-factor and point-orbit conclusions for the original abelian R.
The orders of both centralizer intersections, their ordered setwise product
with B, and the ambient conjugator are supplied together with the exhaustive
point partition. Only the primitive marked placement remains an input. -/
theorem marked_fixed_and_point_data_of_abelian
    (hB : Nat.card c.B = 3)
    (P : Sylow 3 d.toTypeRuSetup.H)
    (hP : (P : Subgroup d.toTypeRuSetup.H).map d.toTypeRuSetup.H.subtype = c.B)
    (hz : orderOf c.z = 2)
    (e : c.NormalizerQuotient ≃* MulAut (alternatingGroup (Fin 6)))
    (hM : c.centralizerImage.map e.toMonoidHom = AlternatingSix.M10.extension)
    (h7 : TranspositionFusion c e)
    (R : Sylow 3 c.NB) [IsMulCommutative (ambient c R)] (Tplus : Sylow 2 c.NB)
    (r f : TR c R Tplus) (hr : orderOf r = 8) (hf : orderOf f = 2)
    (hr4 : (r : G) ^ 4 = c.z) (hTR : Nat.card (TR c R Tplus) = 16)
    (hcenter : (center (TR c R Tplus)).map (TR c R Tplus).subtype = zpowers c.z)
    (ht : TranspositionMark c e (inclusion (TR_le_NB c R Tplus) f))
    (ht' : TranspositionMark c e
      ((inclusion (TR_le_NB c R Tplus) f) * ⟨c.z, c.GB_le_NB c.z_mem_GB⟩)) :
    let z : TR c R Tplus := ⟨c.z, hr4 ▸ (TR c R Tplus).pow_mem r.property 4⟩
    ∃ hcf : Nat.card (fixed c R (f : G)) = 3,
      Nat.card (fixed c R ((f : G) * c.z)) = 3 ∧
      (ambient c R : Set G) = (fixed c R (f : G) : Set G) *
        (fixed c R ((f : G) * c.z) : Set G) * (c.B : Set G) ∧
      (∃ g : G, (fixed c R (f : G)).map (MulAut.conj g).toMonoidHom = c.B) ∧
      MulAction.orbit (TR c R Tplus) (basePoint c hB R) = {basePoint c hB R} ∧
      Nat.card (MulAction.orbit (TR c R Tplus) (basePoint c hB R)) = 1 ∧
      Nat.card (MulAction.orbit (TR c R Tplus) (fixedPoint c R Tplus f hcf)) = 4 ∧
      MulAction.stabilizer (TR c R Tplus) (fixedPoint c R Tplus f hcf) =
        closure ({z, f} : Set (TR c R Tplus)) ∧
      (MulAction.stabilizer (TR c R Tplus) (fixedPoint c R Tplus f hcf)).index = 4 ∧
      ∃ U : Points c R,
        Nat.card (MulAction.orbit (TR c R Tplus) U) = 8 ∧
        Disjoint (MulAction.orbit (TR c R Tplus) (basePoint c hB R))
          (MulAction.orbit (TR c R Tplus) (fixedPoint c R Tplus f hcf)) ∧
        Disjoint (MulAction.orbit (TR c R Tplus) (basePoint c hB R))
          (MulAction.orbit (TR c R Tplus) U) ∧
        Disjoint (MulAction.orbit (TR c R Tplus) (fixedPoint c R Tplus f hcf))
          (MulAction.orbit (TR c R Tplus) U) ∧
        MulAction.orbit (TR c R Tplus) (basePoint c hB R) ∪
          MulAction.orbit (TR c R Tplus) (fixedPoint c R Tplus f hcf) ∪
          MulAction.orbit (TR c R Tplus) U = Set.univ := by
  obtain ⟨hcf, hcfz, hprod, hfusion⟩ :=
    marked_fixed_data c hB P hP hz e h7 R Tplus r f hr4 hf hcenter ht ht'
  refine ⟨hcf, hcfz, hprod, hfusion, ?_⟩
  obtain ⟨_, hgeometry⟩ := projective_geometry_of_abelian c hB P hP hz e hM h7
    R Tplus r f hr hf hr4 hTR hcenter ht ht'
  exact hgeometry

end CFSG.Quasithin.ChapterJ.Centralizers.CubicSylow.LocalAction.PointOrbits
