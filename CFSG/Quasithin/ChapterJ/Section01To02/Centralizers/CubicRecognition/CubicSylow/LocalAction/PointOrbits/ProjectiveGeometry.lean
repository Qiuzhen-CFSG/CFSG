module

public import CFSG.Quasithin.ChapterJ.Section01To02.Centralizers.CubicRecognition.CubicSylow.LocalAction.PointOrbits.GeometryInputs
public import Theory.GroupAction.SemidihedralTernaryPoints

/-!
# The exhaustive projective geometry in the abelian branch of J.2.7

For the original conjugation action of T_R on R, the order-three
subgroup points form disjoint orbits of lengths one, four and eight.
The singleton is B, and the orbit of length four contains C_R(f).
Its literal stabilizer in T_R is the subgroup generated by z and f.

The marked rotation supplies elementary abelian structure. Transposition
fusion supplies the order of C_R(f), while compatibility with the given
M₁₀ marking supplies inversion of B. These facts instantiate the reusable
semidihedral point theorem with the published action and subgroup points.
The primitive placement and the abelian-branch assumption remain explicit;
the resulting geometry is the input to the later abelian-branch exclusion.

Source: Aschbacher–Smith, J.2.7, printed p.437 (PDF p.448).
-/

public section

open Subgroup

namespace CFSG.Quasithin.ChapterJ.Centralizers.CubicSylow.LocalAction.PointOrbits
variable {G : Type*} [Group G] [Finite G] {d : LocalSetup G} (c : Choices d)

/-- The complete point partition and literal stabilizer in the abelian branch. -/
theorem projective_geometry_of_abelian
    (hB : Nat.card c.B = 3)
    (P : Sylow 3 d.toTypeRuSetup.H)
    (hP : (P : Subgroup d.toTypeRuSetup.H).map d.toTypeRuSetup.H.subtype = c.B)
    (hz : orderOf c.z = 2)
    (e : c.NormalizerQuotient ≃* MulAut (alternatingGroup (Fin 6)))
    (hM : c.centralizerImage.map e.toMonoidHom = AlternatingSix.M10.extension)
    (h7 : TranspositionFusion c e)
    (R : Sylow 3 c.NB) [IsMulCommutative (ambient c R)] (Tplus : Sylow 2 c.NB)
    (r f : TR c R Tplus) (hr : orderOf r = 8) (hf : orderOf f = 2)
    (hr4 : (r : G) ^ 4 = c.z) (hTR : Nat.card (TR c R Tplus) = 16)
    (hcenter : (center (TR c R Tplus)).map (TR c R Tplus).subtype = zpowers c.z)
    (ht : TranspositionMark c e (inclusion (TR_le_NB c R Tplus) f))
    (ht' : TranspositionMark c e
      ((inclusion (TR_le_NB c R Tplus) f) * ⟨c.z, c.GB_le_NB c.z_mem_GB⟩)) :
    let z : TR c R Tplus := ⟨c.z, hr4 ▸ (TR c R Tplus).pow_mem r.property 4⟩
    ∃ hcf : Nat.card (fixed c R (f : G)) = 3,
      MulAction.orbit (TR c R Tplus) (basePoint c hB R) = {basePoint c hB R} ∧
      Nat.card (MulAction.orbit (TR c R Tplus) (basePoint c hB R)) = 1 ∧
      Nat.card (MulAction.orbit (TR c R Tplus) (fixedPoint c R Tplus f hcf)) = 4 ∧
      MulAction.stabilizer (TR c R Tplus) (fixedPoint c R Tplus f hcf) =
        closure ({z, f} : Set (TR c R Tplus)) ∧
      (MulAction.stabilizer (TR c R Tplus) (fixedPoint c R Tplus f hcf)).index = 4 ∧
      ∃ U : Points c R,
        Nat.card (MulAction.orbit (TR c R Tplus) U) = 8 ∧
        Disjoint (MulAction.orbit (TR c R Tplus) (basePoint c hB R))
          (MulAction.orbit (TR c R Tplus) (fixedPoint c R Tplus f hcf)) ∧
        Disjoint (MulAction.orbit (TR c R Tplus) (basePoint c hB R))
          (MulAction.orbit (TR c R Tplus) U) ∧
        Disjoint (MulAction.orbit (TR c R Tplus) (fixedPoint c R Tplus f hcf))
          (MulAction.orbit (TR c R Tplus) U) ∧
        MulAction.orbit (TR c R Tplus) (basePoint c hB R) ∪
          MulAction.orbit (TR c R Tplus) (fixedPoint c R Tplus f hcf) ∪
          MulAction.orbit (TR c R Tplus) U = Set.univ := by
  let z : TR c R Tplus := ⟨c.z, hr4 ▸ (TR c R Tplus).pow_mem r.property 4⟩
  have hr8 : r ^ 8 = 1 := hr ▸ pow_orderOf_eq_one r
  have hr8G : (r : G) ^ 8 = 1 := congrArg Subtype.val hr8
  let := elementary_of_abelian_rotation c hB P hP e R Tplus r hr8G hr4
  have hcf := (marked_fixed_data c hB P hP hz e h7 R Tplus r f hr4 hf hcenter ht ht').1
  refine ⟨hcf, ?_⟩
  have hzc : z ∈ center (TR c R Tplus) :=
    mem_center_iff.mpr (commute_z_of_center c R Tplus hcenter z.property)
  apply SemidihedralTernaryPoints.partition (action c R Tplus) hTR
    (ambient_card c hB e R) r z f hr8 (Subtype.ext hr4)
    ((orderOf_injective (TR c R Tplus).subtype (TR c R Tplus).subtype_injective z).symm.trans hz)
    hf hzc (basePoint c hB R) (fixedPoint c R Tplus f hcf)
    (action_preserves_B c R Tplus) (z_fixedSubgroup_eq c hB P hP R Tplus z.property) rfl
  intro b hb
  apply Subtype.ext
  exact marked_inverts_B c hB e hM (inclusion (TR_le_NB c R Tplus) f)
    (by rw [← map_pow, show f ^ 2 = 1 from hf ▸ pow_orderOf_eq_one f, map_one]) ht
    (b : G) hb

end CFSG.Quasithin.ChapterJ.Centralizers.CubicSylow.LocalAction.PointOrbits
