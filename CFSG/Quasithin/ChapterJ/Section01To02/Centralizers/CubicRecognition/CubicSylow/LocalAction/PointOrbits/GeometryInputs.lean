module

public import CFSG.Quasithin.ChapterJ.Section01To02.Centralizers.CubicRecognition.CubicSylow.LocalAction.PointOrbits.FixedProducts
public import CFSG.Quasithin.ChapterJ.Section01To02.Centralizers.CubicRecognition.CubicSylow.LocalAction.Rotation
public import CFSG.Quasithin.ChapterJ.Section01To02.Centralizers.CubicRecognition.CubicSylow.LocalAction.Quotient
public import Theory.GroupAction.PrimeOrderPoints

/-!
# The literal subgroup points in the abelian cubic branch

The point action is induced by the original conjugation homomorphism on R.
The point B is fixed, and the point defined by C_R(f) maps back to that
same ambient centralizer intersection. Commuting actors stabilize this point.
In the abelian branch, the proved rotation theorem supplies exponent three;
projective counting therefore gives exactly thirteen points.

These are input interfaces for the exhaustive 1,4,8 orbit calculation.
They do not assert that calculation or the exclusion of the abelian branch.

Source: Aschbacher–Smith, J.2.7, printed p.437 (PDF p.448).
-/

@[expose] public section
noncomputable section
namespace CFSG.Quasithin.ChapterJ.Centralizers.CubicSylow.LocalAction.PointOrbits
open Subgroup
variable {G : Type*} [Group G] [Finite G] {d : LocalSetup G} (c : Choices d)

/-- All actual order-three subgroups of the ambient R. -/
abbrev Points (R : Sylow 3 c.NB) := OrderPoints 3 (ambient c R)

/-- The original TR conjugation action on the actual subgroup points. -/
instance pointsAction (R : Sylow 3 c.NB) (Tplus : Sylow 2 c.NB) :
    MulAction (TR c R Tplus) (Points c R) :=
  OrderPoints.action (action c R Tplus)

theorem point_smul (R : Sylow 3 c.NB) (Tplus : Sylow 2 c.NB)
    (t : TR c R Tplus) (U : Points c R) :
    (t • U).val = U.val.map (action c R Tplus t).toMonoidHom := rfl

/-- The source's singleton point, retaining the original B inclusion. -/
def basePoint (hB : Nat.card c.B = 3) (R : Sylow 3 c.NB) : Points c R :=
  ⟨c.B.subgroupOf (ambient c R),
    (Nat.card_congr (subgroupOfEquivOfLe (B_le c hB R)).toEquiv).trans hB⟩

theorem basePoint_fixed (hB : Nat.card c.B = 3) (R : Sylow 3 c.NB)
    (Tplus : Sylow 2 c.NB) (t : TR c R Tplus) :
    t • basePoint c hB R = basePoint c hB R :=
  Subtype.ext (action_preserves_B c R Tplus t)

theorem basePoint_orbit (hB : Nat.card c.B = 3) (R : Sylow 3 c.NB)
    (Tplus : Sylow 2 c.NB) :
    MulAction.orbit (TR c R Tplus) (basePoint c hB R) = {basePoint c hB R} := by
  ext U
  constructor
  · rintro ⟨t, rfl⟩
    exact Set.mem_singleton_iff.mpr (basePoint_fixed c hB R Tplus t)
  · intro h
    rw [Set.mem_singleton_iff] at h
    subst U
    exact MulAction.mem_orbit_self _

theorem basePoint_orbit_card (hB : Nat.card c.B = 3) (R : Sylow 3 c.NB)
    (Tplus : Sylow 2 c.NB) :
    Nat.card (MulAction.orbit (TR c R Tplus) (basePoint c hB R)) = 1 := by
  rw [basePoint_orbit]
  simp

/-- The f-fixed point, whose cardinal hypothesis is supplied by marked_fixed_data. -/
def fixedPoint (R : Sylow 3 c.NB) (Tplus : Sylow 2 c.NB) (f : TR c R Tplus)
    (hcard : Nat.card (fixed c R (f : G)) = 3) : Points c R :=
  ⟨(action c R Tplus f).fixedSubgroup, (action_fixed_card c R Tplus f).trans hcard⟩

/-- Embedding this point back into G gives exactly the source fixed subgroup. -/
theorem fixedPoint_image (R : Sylow 3 c.NB) (Tplus : Sylow 2 c.NB) (f : TR c R Tplus)
    (hcard : Nat.card (fixed c R (f : G)) = 3) :
    (fixedPoint c R Tplus f hcard).val.map (ambient c R).subtype = fixed c R (f : G) := by
  ext x
  constructor
  · rintro ⟨y, hy, rfl⟩
    exact (fixedEquiv c R Tplus f ⟨y, (MulAut.mem_fixedSubgroup _ _).mp hy⟩).property
  · intro hx
    let y := (fixedEquiv c R Tplus f).symm ⟨x, hx⟩
    exact ⟨y.val, (MulAut.mem_fixedSubgroup _ _).mpr y.property, rfl⟩

theorem fixedPoint_fixed_of_commute (R : Sylow 3 c.NB) (Tplus : Sylow 2 c.NB)
    (f t : TR c R Tplus) (hcomm : Commute f t)
    (hcard : Nat.card (fixed c R (f : G)) = 3) :
    t • fixedPoint c R Tplus f hcard = fixedPoint c R Tplus f hcard := by
  apply Subtype.ext
  change ((action c R Tplus f).fixedSubgroup).map (action c R Tplus t).toMonoidHom =
    (action c R Tplus f).fixedSubgroup
  apply eq_of_le_of_card_ge
  · rintro _ ⟨y, hy, rfl⟩
    apply (MulAut.mem_fixedSubgroup _ _).mpr
    have he := congrArg (fun a : MulAut (ambient c R) => a y)
      ((hcomm.map (action c R Tplus)).eq)
    change action c R Tplus f (action c R Tplus t y) =
      action c R Tplus t (action c R Tplus f y) at he
    exact he.trans (congrArg (action c R Tplus t) ((MulAut.mem_fixedSubgroup _ _).mp hy))
  · rw [card_map_of_injective (f := (action c R Tplus t).toMonoidHom)
      (action c R Tplus t).injective]

/-- The actual subgroup generated by z and f lies in the literal point stabilizer. -/
theorem generated_le_fixedPoint_stabilizer (R : Sylow 3 c.NB) (Tplus : Sylow 2 c.NB)
    (f : TR c R Tplus) (hzT : c.z ∈ TR c R Tplus)
    (hcenter : (center (TR c R Tplus)).map (TR c R Tplus).subtype = zpowers c.z)
    (hcard : Nat.card (fixed c R (f : G)) = 3) :
    closure ({⟨c.z, hzT⟩, f} : Set (TR c R Tplus)) ≤
      MulAction.stabilizer (TR c R Tplus) (fixedPoint c R Tplus f hcard) := by
  apply (closure_le _).mpr
  intro t ht
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at ht
  rcases ht with ht | ht
  · rw [ht]
    exact fixedPoint_fixed_of_commute c R Tplus f ⟨c.z, hzT⟩
      (commute_z_of_center c R Tplus hcenter hzT f) hcard
  · rw [ht]
    exact fixedPoint_fixed_of_commute c R Tplus f f (Commute.refl f) hcard

/-- The z-fixed line is literally the original subgroup B in R. -/
theorem z_fixedSubgroup_eq (hB : Nat.card c.B = 3)
    (P : Sylow 3 d.toTypeRuSetup.H)
    (hP : (P : Subgroup d.toTypeRuSetup.H).map d.toTypeRuSetup.H.subtype = c.B)
    (R : Sylow 3 c.NB) (Tplus : Sylow 2 c.NB) (hzT : c.z ∈ TR c R Tplus) :
    (action c R Tplus ⟨c.z, hzT⟩).fixedSubgroup = c.B.subgroupOf (ambient c R) := by
  ext x
  rw [MulAut.mem_fixedSubgroup]
  constructor
  · intro hx
    have hm := (fixedEquiv c R Tplus ⟨c.z, hzT⟩ ⟨x, hx⟩).property
    change (x : G) ∈ ambient c R ⊓ centralizer ({c.z} : Set G) at hm
    rw [centralizer_z_eq c hB P hP R] at hm
    exact hm
  · exact action_z_fixed_of_mem_B c R Tplus hzT x

/-- The marked f-fixed point is distinct from the singleton B point. -/
theorem fixedPoint_ne_basePoint (hB : Nat.card c.B = 3)
    (e : c.NormalizerQuotient ≃* MulAut (alternatingGroup (Fin 6)))
    (hM : c.centralizerImage.map e.toMonoidHom = AlternatingSix.M10.extension)
    (R : Sylow 3 c.NB) (Tplus : Sylow 2 c.NB) (f : TR c R Tplus)
    (ht : TranspositionMark c e (inclusion (TR_le_NB c R Tplus) f))
    (hcard : Nat.card (fixed c R (f : G)) = 3) :
    fixedPoint c R Tplus f hcard ≠ basePoint c hB R := by
  intro he
  apply marked_not_mem_GB c e hM (inclusion (TR_le_NB c R Tplus) f) ht
  intro b hb
  let x : ambient c R := ⟨b, B_le c hB R hb⟩
  have hx : x ∈ (action c R Tplus f).fixedSubgroup := by
    change x ∈ (fixedPoint c R Tplus f hcard).val
    rw [he]
    exact hb
  have hf := congrArg Subtype.val ((MulAut.mem_fixedSubgroup _ _).mp hx)
  change (f : G) * b * (f : G)⁻¹ = b at hf
  exact (mul_inv_eq_iff_eq_mul.mp hf).symm

/-- In the abelian branch exponent three follows from the original marked rotation. -/
theorem elementary_of_abelian_rotation
    (hB : Nat.card c.B = 3)
    (P : Sylow 3 d.toTypeRuSetup.H)
    (hP : (P : Subgroup d.toTypeRuSetup.H).map d.toTypeRuSetup.H.subtype = c.B)
    (e : c.NormalizerQuotient ≃* MulAut (alternatingGroup (Fin 6)))
    (R : Sylow 3 c.NB) [IsMulCommutative (ambient c R)] (Tplus : Sylow 2 c.NB) (r : TR c R Tplus)
    (hr8 : (r : G) ^ 8 = 1) (hr4 : (r : G) ^ 4 = c.z) :
    IsElementaryAbelian 3 (ambient c R) where
  exponent_dvd_p := Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr
    (cube_eq_one_of_rotation c hB P hP e R Tplus r hr8 hr4)

/-- Counting the full set of points does not assume any orbit conclusion. -/
theorem points_card_thirteen
    (hB : Nat.card c.B = 3)
    (P : Sylow 3 d.toTypeRuSetup.H)
    (hP : (P : Subgroup d.toTypeRuSetup.H).map d.toTypeRuSetup.H.subtype = c.B)
    (e : c.NormalizerQuotient ≃* MulAut (alternatingGroup (Fin 6)))
    (R : Sylow 3 c.NB) [IsMulCommutative (ambient c R)]
    (Tplus : Sylow 2 c.NB) (r : TR c R Tplus)
    (hr8 : (r : G) ^ 8 = 1) (hr4 : (r : G) ^ 4 = c.z) : Nat.card (Points c R) = 13 := by
  let := elementary_of_abelian_rotation c hB P hP e R Tplus r hr8 hr4
  exact OrderPoints.card_thirteen (ambient_card c hB e R)

end CFSG.Quasithin.ChapterJ.Centralizers.CubicSylow.LocalAction.PointOrbits
