module

public import CFSG.Quasithin.ChapterJ.Section01To02.Centralizers.CubicRecognition.CubicSylow.LocalAction.Rotation
public import CFSG.Quasithin.ChapterJ.Section01To02.Centralizers.CubicRecognition.CubicSylow.LocalAction.Quotient
public import CFSG.Quasithin.ChapterJ.Section01To02.Centralizers.CubicRecognition.CubicSylow.LocalAction.Placement
public import CFSG.Quasithin.ChapterJ.Section01To02.Centralizers.CubicRecognition.CubicSylow.LocalAction.PointOrbits

/-!
# The cubic normalizer action in J.2.7

`exists_data` constructs the marked Sylow subgroups and all their local
action properties from the earlier Aut(A₆) quotient, M₁₀ compatibility,
Sylow placement of B in H, and the transposition part of J.2.7(7).
`Data` packages the output; its existence is proved, not assumed.

`Placement` constructs T_R as the literal normalizer intersection, with
center generated by the original z and both transposition markings.
`Rotation` and `Quotient` then give exponent three and the faithful,
transitive conjugation action on (R/B)#. `PointOrbits` supplies the two
fixed subgroups, their ordered product with B, fusion of C_R(f) to B,
and the exhaustive 1,4,8 point partition in the abelian branch.

All placement premises are discharged here. Earlier-source recognition
inputs belong to `qt-j12-cubic-recognition`; exclusion of the abelian
branch and final element fusion belong to `qt-j12-cubic-sylow-geometry`.

Source: Aschbacher–Smith, J.2.7, printed p.437 (PDF p.448).
-/

public section

namespace CFSG.Quasithin.ChapterJ.Centralizers.CubicSylow.LocalAction
open Subgroup PointOrbits
open scoped Pointwise

variable {G : Type*} [Group G] [Finite G] {d : LocalSetup G} (c : Choices d)

/-- The constructed local configuration for the final cubic argument of J.2.7.
Every action, fixed subgroup, quotient and point uses its original ambient map.
The abelian clause is an implication, ready for the subsequent E₂₇ exclusion. -/
structure Data (hB : Nat.card c.B = 3)
    (e : c.NormalizerQuotient ≃* MulAut (alternatingGroup (Fin 6))) where
  R : Sylow 3 c.NB
  Tplus : Sylow 2 c.NB
  r : TR c R Tplus
  f : TR c R Tplus
  rotation_order : orderOf r = 8
  flip_order : orderOf f = 2
  flip_rotation : f * r * f⁻¹ = r ^ 3
  generated : closure ({r, f} : Set (TR c R Tplus)) = ⊤
  rotation_four : (r : G) ^ 4 = c.z
  z_mem : c.z ∈ TR c R Tplus
  flip_z_mem : (f : G) * c.z ∈ TR c R Tplus
  tr_card : Nat.card (TR c R Tplus) = 16
  semidihedralEquiv : TR c R Tplus ≃* Semidihedral.StandardModel 4 (by decide)
  embedded_center : (center (TR c R Tplus)).map (TR c R Tplus).subtype = zpowers c.z
  flip_ambient_order : orderOf (f : G) = 2
  flip_z_order : orderOf ((f : G) * c.z) = 2
  marked_flip : TranspositionMark c e (inclusion (TR_le_NB c R Tplus) f)
  marked_flip_z : TranspositionMark c e
    ((inclusion (TR_le_NB c R Tplus) f) * Placement.zInNB c)
  flip_fusion : ∃ g : G, g * (f : G) * g⁻¹ = c.z
  flip_z_fusion : ∃ g : G, g * ((f : G) * c.z) * g⁻¹ = c.z
  normalizer_product :
    ((c.NB ⊓ normalizer (ambient c R : Set G) : Subgroup G) : Set G) =
      (ambient c R : Set G) * (TR c R Tplus : Set G)
  sylow_two : ∃ S : Sylow 2 ↥(c.NB ⊓ normalizer (ambient c R : Set G)),
    (S : Subgroup ↥(c.NB ⊓ normalizer (ambient c R : Set G))).map
      (c.NB ⊓ normalizer (ambient c R : Set G)).subtype = TR c R Tplus
  r_card : Nat.card (ambient c R) = 27
  base_le : c.B ≤ ambient c R
  base_central : c.B.subgroupOf (ambient c R) ≤ center (ambient c R)
  quotientEquiv : Quotient c R ≃* AlternatingSix.M10.LocalGeometry.NineCoordinates
  fixed_z : ambient c R ⊓ centralizer ({c.z} : Set G) = c.B
  fixed_card : Nat.card (fixed c R (f : G)) = 3
  fixed_flip_z_card : Nat.card (fixed c R ((f : G) * c.z)) = 3
  fixed_product : (ambient c R : Set G) = (fixed c R (f : G) : Set G) *
    (fixed c R ((f : G) * c.z) : Set G) * (c.B : Set G)
  fixed_fusion : ∃ g : G, (fixed c R (f : G)).map (MulAut.conj g).toMonoidHom = c.B
  cube_eq_one : ∀ x : ambient c R, x ^ 3 = 1
  faithful : Function.Injective (action c R Tplus)
  quotient_faithful : Function.Injective (quotientAction c R Tplus)
  quotient_transitive : ∀ u v : Quotient c R, u ≠ 1 → v ≠ 1 →
    ∃ t : TR c R Tplus, quotientAction c R Tplus t u = v
  abelian_points : IsMulCommutative (ambient c R) →
    IsElementaryAbelian 3 (ambient c R) ∧ Nat.card (Points c R) = 13 ∧
    MulAction.orbit (TR c R Tplus) (basePoint c hB R) = {basePoint c hB R} ∧
    Nat.card (MulAction.orbit (TR c R Tplus) (basePoint c hB R)) = 1 ∧
    Nat.card (MulAction.orbit (TR c R Tplus) (fixedPoint c R Tplus f fixed_card)) = 4 ∧
    MulAction.stabilizer (TR c R Tplus) (fixedPoint c R Tplus f fixed_card) =
      closure ({⟨c.z, z_mem⟩, f} : Set (TR c R Tplus)) ∧
    (MulAction.stabilizer (TR c R Tplus) (fixedPoint c R Tplus f fixed_card)).index = 4 ∧
    ∃ U : Points c R,
      Nat.card (MulAction.orbit (TR c R Tplus) U) = 8 ∧
      Disjoint (MulAction.orbit (TR c R Tplus) (basePoint c hB R))
        (MulAction.orbit (TR c R Tplus) (fixedPoint c R Tplus f fixed_card)) ∧
      Disjoint (MulAction.orbit (TR c R Tplus) (basePoint c hB R))
        (MulAction.orbit (TR c R Tplus) U) ∧
      Disjoint (MulAction.orbit (TR c R Tplus) (fixedPoint c R Tplus f fixed_card))
        (MulAction.orbit (TR c R Tplus) U) ∧
      MulAction.orbit (TR c R Tplus) (basePoint c hB R) ∪
        MulAction.orbit (TR c R Tplus) (fixedPoint c R Tplus f fixed_card) ∪
        MulAction.orbit (TR c R Tplus) U = Set.univ

/-- Construct the full local action from the earlier-source inputs. In particular,
neither a semidihedral placement, exponent assumption, point-orbit conclusion,
nor an abelian-branch exclusion is an additional premise. -/
theorem exists_data (hB : Nat.card c.B = 3)
    (P : Sylow 3 d.toTypeRuSetup.H)
    (hP : (P : Subgroup d.toTypeRuSetup.H).map d.toTypeRuSetup.H.subtype = c.B)
    (hz : orderOf c.z = 2)
    (e : c.NormalizerQuotient ≃* MulAut (alternatingGroup (Fin 6)))
    (hM : c.centralizerImage.map e.toMonoidHom = AlternatingSix.M10.extension)
    (h7 : TranspositionFusion c e) : Nonempty (Data c hB e) := by
  obtain ⟨σ, R, Tplus, r, f, hr, hf, hfr, hgen, hr4, hzT, hTR, ⟨sd⟩,
    hcenter, hfG, hfzG, ht, ht', hmark, hmark', hprod, _, hSyl⟩ :=
    Placement.exists_marked_placement c hB hz e hM
  have htf : TranspositionMark c e (inclusion (TR_le_NB c R Tplus) f) :=
    ⟨Placement.Lift.firstSwap (σ := σ), ht, hmark⟩
  have htfz : TranspositionMark c e
      ((inclusion (TR_le_NB c R Tplus) f) * Placement.zInNB c) :=
    ⟨Placement.Lift.secondSwap (σ := σ), ht', hmark'⟩
  obtain ⟨hcf, hcfz, hfixedprod, hfixedfusion⟩ :=
    marked_fixed_data c hB P hP hz e h7 R Tplus r f hr4 hf hcenter htf htfz
  have hr8 : (r : G) ^ 8 = 1 :=
    congrArg Subtype.val (show r ^ 8 = 1 from hr ▸ pow_orderOf_eq_one r)
  refine ⟨{
    R := R
    Tplus := Tplus
    r := r
    f := f
    rotation_order := hr
    flip_order := hf
    flip_rotation := hfr
    generated := hgen
    rotation_four := hr4
    z_mem := hzT
    flip_z_mem := (TR c R Tplus).mul_mem f.property hzT
    tr_card := hTR
    semidihedralEquiv := sd
    embedded_center := hcenter
    flip_ambient_order := hfG
    flip_z_order := hfzG
    marked_flip := htf
    marked_flip_z := htfz
    flip_fusion := ?_
    flip_z_fusion := ?_
    normalizer_product := hprod
    sylow_two := hSyl
    r_card := ambient_card c hB e R
    base_le := B_le c hB R
    base_central := B_le_center c hB e hM R
    quotientEquiv := ambientQuotientEquiv c e R
    fixed_z := centralizer_z_eq c hB P hP R
    fixed_card := hcf
    fixed_flip_z_card := hcfz
    fixed_product := hfixedprod
    fixed_fusion := hfixedfusion
    cube_eq_one := cube_eq_one_of_rotation c hB P hP e R Tplus r hr8 hr4
    faithful := action_injective_of_center c hB P hP hz e R Tplus hcenter
    quotient_faithful := quotientAction_injective_of_center c hB P hP hz e R Tplus hcenter
    quotient_transitive := quotient_transitive_of_rotation c hB P hP hz e R Tplus r hr8 hr4
    abelian_points := ?_ }⟩
  · exact h7 (inclusion (TR_le_NB c R Tplus) f)
      ((orderOf_injective c.NB.subtype c.NB.subtype_injective _).symm.trans hfG) htf
  · exact h7 ((inclusion (TR_le_NB c R Tplus) f) * Placement.zInNB c)
      ((orderOf_injective c.NB.subtype c.NB.subtype_injective _).symm.trans hfzG) htfz
  · intro hc
    let := hc
    refine ⟨elementary_of_abelian_rotation c hB P hP e R Tplus r hr8 hr4,
      points_card_thirteen c hB P hP e R Tplus r hr8 hr4, ?_⟩
    obtain ⟨_, hgeometry⟩ := projective_geometry_of_abelian c hB P hP hz e hM h7
      R Tplus r f hr hf hr4 hTR hcenter htf htfz
    exact hgeometry

end CFSG.Quasithin.ChapterJ.Centralizers.CubicSylow.LocalAction
