module
public import CFSG.Quasithin.Chapter1.Section02.LocalComponents.Classification.CenterFrattiniSource.Representation.Certificate
public import Theory.AtlasPort.LinearGroups.SL2Order
public import Mathlib.Algebra.Field.ZMod
import Mathlib.Tactic.NormNum

/-!
# The concrete complement is SL₂(5)

The subgroup generated by the prescribed matrices over `ZMod 121` is
multiplicatively equivalent to `SL₂(ZMod 5)` and has order 120. The
equivalence sends `x` to `!![0,1;4,0]` and `y` to `!![0,4;1,1]`.

The finite graph certificate proves that both coordinate projections of
the paired-generator subgroup are injective. Its first projection is onto
the prescribed complement by generation. Its second projection contains
120 distinct matrices and is onto by the independently proved SL₂ order
formula. Composing these two projection equivalences gives the required
multiplicative equivalence.

Source: the fixed center–Frattini candidate in `CenterFrattiniSource.Model`
and its paired enumeration, verified in `Representation.Certificate`.
This is the concrete representation input for the separate investigation
of Aschbacher–Smith A.3.6 and 1.2.1(4d).
-/

public section
open Subgroup
namespace CFSG.Quasithin.Chapter1.Section02.CenterFrattiniSource
open RepresentationCertificate

private def firstProjection : graph →* complement where
  toFun g := ⟨g.1.1, fst_mem g.1 g.2⟩
  map_one' := rfl
  map_mul' _ _ := rfl

private def secondProjection : graph →* SL5 :=
  (MonoidHom.snd SL121 SL5).comp graph.subtype

private theorem firstProjection_bijective : Function.Bijective firstProjection := by
  constructor
  · intro g h he
    obtain ⟨i, hi⟩ := exists_row g.1 g.2
    obtain ⟨j, hj⟩ := exists_row h.1 h.2
    have hij : i = j := row121_injective (by
      change (row i).1 = (row j).1
      rw [hi, hj]
      exact congrArg Subtype.val he)
    apply Subtype.ext
    exact hi.symm.trans (hij ▸ hj)
  · have hle : complement ≤ graph.map (MonoidHom.fst SL121 SL5) := by
      apply (closure_le _).mpr
      rintro g (rfl | rfl)
      · exact ⟨(x, x5), subset_closure (by simp), rfl⟩
      · exact ⟨(y, y5), subset_closure (by simp), rfl⟩
    intro g
    obtain ⟨h, hh, he⟩ := hle g.2
    exact ⟨⟨h, hh⟩, Subtype.ext he⟩

private theorem card_sl5 : Nat.card SL5 = 120 := by
  let : Fact (Nat.Prime 5) := ⟨by decide⟩
  calc
    Nat.card SL5 = Nat.card (ZMod 5) * (Nat.card (ZMod 5) ^ 2 - 1) :=
      Atlas.card_sl_two (F := ZMod 5)
    _ = 120 := by norm_num

private theorem secondProjection_bijective : Function.Bijective secondProjection := by
  constructor
  · intro g h he
    obtain ⟨i, hi⟩ := exists_row g.1 g.2
    obtain ⟨j, hj⟩ := exists_row h.1 h.2
    have hij : i = j := row5_injective (by
      change (row i).2 = (row j).2
      rw [hi, hj]
      exact he)
    apply Subtype.ext
    exact hi.symm.trans (hij ▸ hj)
  · have hs : Function.Surjective (fun i => (row i).2) :=
      (row5_injective.bijective_of_nat_card_le (by rw [card_sl5, Nat.card_fin])).2
    intro g
    obtain ⟨i, hi⟩ := hs g
    exact ⟨⟨row i, row_mem i⟩, hi⟩

/-- The subgroup generated by the two specified matrices over `ZMod 121`
is multiplicatively equivalent to the actual matrix group `SL₂(5)`. -/
noncomputable def complementEquivSL5 : complement ≃* SL5 :=
  (MulEquiv.ofBijective firstProjection firstProjection_bijective).symm.trans
    (MulEquiv.ofBijective secondProjection secondProjection_bijective)

private theorem equiv_apply_graph (g : graph) :
    complementEquivSL5 ⟨g.1.1, fst_mem g.1 g.2⟩ = g.1.2 := by
  exact congrArg (MulEquiv.ofBijective secondProjection secondProjection_bijective)
    ((MulEquiv.ofBijective firstProjection firstProjection_bijective).symm_apply_apply g)

/-- The equivalence has the first generator image from the paired enumeration. -/
theorem complementEquivSL5_x :
    complementEquivSL5 ⟨x, subset_closure (by simp)⟩ = x5 :=
  equiv_apply_graph ⟨(x, x5), subset_closure (by simp)⟩

/-- The equivalence has the second generator image from the paired enumeration. -/
theorem complementEquivSL5_y :
    complementEquivSL5 ⟨y, subset_closure (by simp)⟩ = y5 :=
  equiv_apply_graph ⟨(y, y5), subset_closure (by simp)⟩

/-- The concrete matrix complement has exactly 120 elements. -/
theorem complement_card : Nat.card complement = 120 :=
  (Nat.card_congr complementEquivSL5.toEquiv).trans card_sl5

end CFSG.Quasithin.Chapter1.Section02.CenterFrattiniSource
