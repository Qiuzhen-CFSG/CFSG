private def decode5 (g : SL5) : Index :=
  decodeKey5 ((g.1 0 0).val + 5 * (g.1 0 1).val + 25 * (g.1 1 0).val + 125 * (g.1 1 1).val)

private theorem decode5_spec : ∀ i, decode5 (row i).2 = i := by
  decide +kernel

/-- The matrices over `ZMod 5` in the table are distinct. -/
theorem row5_injective : Function.Injective (fun i => (row i).2) :=
  Function.LeftInverse.injective decode5_spec

private theorem row_zero : row 0 = 1 := by decide +kernel

set_option maxHeartbeats 800000 in
private theorem next_spec : ∀ i j, row (next i j) = row i * generator j := by decide +kernel

private theorem parent_lt : ∀ i : Index, i ≠ 0 → (parent i).val < i.val := by decide +kernel

private theorem parent_spec : ∀ i : Index, i ≠ 0 → next (parent i) (lastGen i) = i := by
  decide +kernel


/-- The subgroup generated by the paired matrices in the two actual matrix groups. -/
@[expose] def graph : Subgroup (SL121 × SL5) := closure {(x, x5), (y, y5)}

private theorem generator_mem (j : Fin 4) : generator j ∈ graph := by
  have hx : (x, x5) ∈ graph := subset_closure (by simp)
  have hy : (y, y5) ∈ graph := subset_closure (by simp)
  fin_cases j
  · exact hx
  · exact hy
  · exact graph.inv_mem hx
  · exact graph.inv_mem hy

/-- Every row is reached from the identity by the paired generators. -/
theorem row_mem (i : Index) : row i ∈ graph := by
  have h : ∀ n, ∀ i : Index, i.val = n → row i ∈ graph := by
    intro n
    induction n using Nat.strong_induction_on with
    | h n ih =>
      intro i hi
      by_cases hz : i = 0
      · rw [hz, row_zero]
        exact graph.one_mem
      · rw [← parent_spec i hz, next_spec]
        exact graph.mul_mem
          (ih (parent i).val (hi ▸ parent_lt i hz) (parent i) rfl) (generator_mem _)
  exact h i.val i rfl

/-- The right-transition checks exhaust the generated subgroup. -/
theorem exists_row (g : SL121 × SL5) (hg : g ∈ graph) : ∃ i, row i = g := by
  induction hg using Subgroup.closure_induction_right with
  | one => exact ⟨0, row_zero⟩
  | mul_right q hq r hr ih =>
    obtain ⟨i, rfl⟩ := ih
    rcases hr with rfl | rfl
    · exact ⟨next i 0, next_spec i 0⟩
    · exact ⟨next i 1, next_spec i 1⟩
  | mul_inv_cancel q hq r hr ih =>
    obtain ⟨i, rfl⟩ := ih
    rcases hr with rfl | rfl
    · exact ⟨next i 2, next_spec i 2⟩
    · exact ⟨next i 3, next_spec i 3⟩

/-- The first coordinate of the graph lies in the prescribed complement. -/
theorem fst_mem (g : SL121 × SL5) (hg : g ∈ graph) : g.1 ∈ complement := by
  have hle : graph ≤ complement.comap (MonoidHom.fst SL121 SL5) := by
    apply (closure_le _).mpr
    rintro g (rfl | rfl)
    · exact subset_closure (by simp)
    · exact subset_closure (by simp)
  exact hle hg

