module

public import Mathlib.LinearAlgebra.Matrix.SpecialLinearGroup
public import Theory.GroupTheory.PGroup.Homocyclic
public import Theory.GroupTheory.GeneralizedFitting.ComponentCalculus
public import Theory.AtlasPort.OtherSporadic.GroupTheory.SemidirectPerfect
import Mathlib.Tactic.FinCases
import Mathlib.Tactic.NormNum
import Mathlib.Tactic.Ring

/-!
# A fixed higher-exponent candidate for the center–Frattini source gap

We construct `(C₁₂₁ × C₁₂₁) ⋊ ⟨x,y⟩` using explicit determinant-one
matrices over `ZMod 121`. The action is faithful and the vector subgroup is
self-centralizing. Consequently the center, the two-core and the ordinary
component layer are trivial. The Fitting subgroup is the 11-core; if the
complement has order prime to 11, it is exactly the vector subgroup.

These facts do not identify the complement with `SL₂(5)` or establish the
SQTK and C-component hypotheses. The triangle relations alone are not such
an identification. Those remaining certificates must concern this exact
model, including all common A.3.6 conclusions, before it can certify a
counterexample to the intrinsic stronger implication. No QTKE ambient
realization is asserted.

Source: Aschbacher–Smith, combined 1 March 2004 manuscript, A.3.6 and its
proof, printed pp.43–45; compare the additional equality in 1.2.1(4d), p.504.
The explicit candidate was suggested by the saved paired matrix enumeration
in `Scratch/qt1202_center_frattini/IcosahedralCandidate.json`; all assertions
in this module are proved independently of that unchecked enumeration.
-/

@[expose] public section

open Matrix Subgroup
namespace CFSG.Quasithin.Chapter1.Section02.CenterFrattiniSource

/-- The matrix group over the ring of integers modulo 121. -/
abbrev SL121 := SpecialLinearGroup (Fin 2) (ZMod 121)
/-- The concrete comparison group; no isomorphism to the complement is assumed. -/
abbrev SL5 := SpecialLinearGroup (Fin 2) (ZMod 5)

/-- The order-four matrix used in the proposed binary icosahedral action. -/
def x : SL121 := ⟨!![0, 1; 120, 0], by decide⟩
/-- The second generator over the same ring. -/
def y : SL121 := ⟨!![0, 40; 3, 1], by decide⟩
/-- The square of the first generator is the scalar minus identity. -/
theorem x_mul_x : x * x = (⟨!![120, 0; 0, 120], by decide⟩ : SL121) := by
  apply Subtype.ext
  change (!![0, 1; 120, 0] : Matrix (Fin 2) (Fin 2) (ZMod 121)) *
    !![0, 1; 120, 0] = !![120, 0; 0, 120]
  decide

/-- The two generator powers agree, as in the binary triangle relations. -/
theorem y_cube : y ^ 3 = x ^ 2 := by
  apply Subtype.ext
  change (!![0, 40; 3, 1] : Matrix (Fin 2) (Fin 2) (ZMod 121)) ^ 3 =
    !![0, 1; 120, 0] ^ 2
  decide

/-- The product satisfies the remaining triangle relation. -/
theorem xy_fifth : (x * y) ^ 5 = 1 := by
  apply Subtype.ext
  change ((!![0, 1; 120, 0] : Matrix (Fin 2) (Fin 2) (ZMod 121)) *
    !![0, 40; 3, 1]) ^ 5 = 1
  decide

/-- The actual subgroup generated by the two displayed matrices. -/
def complement : Subgroup SL121 := closure {x, y}
/-- The abelian group C₁₂₁ × C₁₂₁ on which the matrices act. -/
abbrev Vector := Multiplicative (Fin 2 → ZMod 121)

/-- The natural matrix action on the multiplicative version of the vector group. -/
def action : complement →* MulAut Vector where
  toFun g :=
    { toFun := fun v => Multiplicative.ofAdd (g.1 • v.toAdd)
      invFun := fun v => Multiplicative.ofAdd (g.1⁻¹ • v.toAdd)
      left_inv := fun v => by simp
      right_inv := fun v => by simp
      map_mul' := fun v w => by
        change Multiplicative.ofAdd (g.1 • (v.toAdd + w.toAdd)) = _
        simp [smul_add] }
  map_one' := by
    apply MulEquiv.ext
    intro v
    exact congrArg Multiplicative.ofAdd (one_smul SL121 v.toAdd)
  map_mul' g h := by
    apply MulEquiv.ext
    intro v
    exact congrArg Multiplicative.ofAdd (mul_smul g.1 h.1 v.toAdd)

/-- The fixed finite group proposed for testing the stronger source implication. -/
abbrev Candidate := Vector ⋊[action] complement

instance candidate_finite : Finite Candidate :=
  Finite.of_equiv (Vector × complement) SemidirectProduct.equivProd.symm

/-- The normal vector subgroup, defined as the kernel of the complement projection. -/
def kernel : Subgroup Candidate := SemidirectProduct.rightHom.ker

/-- The coordinate isomorphism for the normal vector subgroup. -/
noncomputable def kernelEquiv : kernel ≃* Vector :=
  (MulEquiv.subgroupCongr SemidirectProduct.range_inl_eq_ker_rightHom.symm).trans
    (MonoidHom.ofInjective (f := (SemidirectProduct.inl : Vector →* Candidate))
      SemidirectProduct.inl_injective).symm

/-- The complement element whose matrix is minus identity. -/
def inverter : Candidate := SemidirectProduct.inr
  ⟨x * x, mul_mem (subset_closure (by simp)) (subset_closure (by simp))⟩

/-- The chosen complement element acts by inversion on both coordinates. -/
theorem inverter_action (v : Vector) :
    action inverter.right v = v⁻¹ := by
  change Multiplicative.ofAdd ((x * x) • v.toAdd) = v⁻¹
  rw [x_mul_x]
  apply congrArg Multiplicative.ofAdd
  change !![120, 0; 0, 120] *ᵥ v.toAdd = -v.toAdd
  ext i
  fin_cases i <;>
    simp [Matrix.mulVec, dotProduct, Fin.sum_univ_two,
      show (120 : ZMod 121) = -1 from by decide]

/-- Inversion expressed as conjugation inside the semidirect product. -/
theorem inverter_conjugates (v : Vector) :
    inverter * SemidirectProduct.inl v * inverter⁻¹ =
      SemidirectProduct.inl v⁻¹ := by
  rw [← inverter_action]
  exact (SemidirectProduct.inl_aut _ _).symm

/-- Coordinate basis vectors detect every matrix, so the action is faithful. -/
theorem action_injective : Function.Injective action := by
  intro g h he
  apply Subtype.ext
  apply Subtype.ext
  ext i j
  have hv := congrArg (fun a : MulAut Vector =>
    (a (Multiplicative.ofAdd (Pi.single j 1))).toAdd i) he
  change (g.1.1 *ᵥ Pi.single j 1) i = (h.1.1 *ᵥ Pi.single j 1) i at hv
  simpa using hv

instance kernel_normal : kernel.Normal := inferInstanceAs SemidirectProduct.rightHom.ker.Normal

/-- Membership in the vector subgroup is detected by the right coordinate. -/
theorem kernel_mem (g : Candidate) : g ∈ kernel ↔ g.right = 1 := Iff.rfl

/-- Every kernel element is its own vector-coordinate inclusion. -/
theorem kernel_eq_inl (g : kernel) : (g : Candidate) = SemidirectProduct.inl g.1.left := by
  apply SemidirectProduct.ext
  · rfl
  · exact g.property

/-- Faithfulness and commutativity make the vector subgroup self-centralizing. -/
theorem centralizer_kernel : centralizer (kernel : Set Candidate) = kernel := by
  apply le_antisymm
  · intro g hg
    change g.right = 1
    apply action_injective
    apply MulEquiv.ext
    intro v
    have he := congrArg SemidirectProduct.left
      (mem_centralizer_iff.mp hg (SemidirectProduct.inl v) (by simp [kernel_mem]))
    simp only [SemidirectProduct.mul_left, SemidirectProduct.left_inl,
      SemidirectProduct.right_inl, map_one, MulAut.one_apply] at he
    simpa only [map_one, MulAut.one_apply] using
      (mul_left_cancel ((mul_comm g.left v).trans he)).symm
  · intro g hg
    rw [mem_centralizer_iff]
    intro h hh
    apply SemidirectProduct.ext
    · simpa only [SemidirectProduct.mul_left, (kernel_mem g).mp hg,
        (kernel_mem h).mp hh, map_one, MulAut.one_apply] using mul_comm h.left g.left
    · simp only [SemidirectProduct.mul_right, (kernel_mem g).mp hg,
        (kernel_mem h).mp hh]

/-- The vector subgroup is an 11-group. -/
theorem kernel_isPGroup : IsPGroup 11 kernel := by
  let : Fact (Nat.Prime 11) := ⟨by decide⟩
  exact (standardHomocyclicCover_isPGroup (Fin 2) 11 2).of_equiv kernelEquiv.symm

/-- Normality puts the vector subgroup inside the 11-core. -/
theorem kernel_le_elevenCore : kernel ≤ pCore 11 Candidate :=
  le_sSup ⟨inferInstance, kernel_isPGroup⟩

/-- The same inversion identity for intrinsic kernel elements. -/
theorem inverter_conjugates_kernel (v : kernel) :
    inverter * (v : Candidate) * inverter⁻¹ = (v : Candidate)⁻¹ := by
  rw [kernel_eq_inl v, inverter_conjugates, map_inv]

/-- A central element lies in the vector subgroup and is fixed by inversion. -/
theorem center_eq_bot : center Candidate = ⊥ := by
  apply eq_bot_iff.mpr
  intro g hg
  have hkg : g ∈ kernel := centralizer_kernel ▸ center_le_centralizer _ hg
  have hc : inverter * g * inverter⁻¹ = g := by
    rw [mem_center_iff.mp hg, mul_assoc, mul_inv_cancel, mul_one]
  have hi := inverter_conjugates_kernel ⟨g, hkg⟩
  rw [hc] at hi
  have hiL : g.left = g.left⁻¹ := by
    simpa only [SemidirectProduct.inv_left, (kernel_mem g).mp hkg, inv_one,
      map_one, MulAut.one_apply] using congrArg SemidirectProduct.left hi
  have hv : g.left = 1 := by
    apply congrArg Multiplicative.ofAdd
    ext i
    have he := congrArg (fun v : Vector => v.toAdd i) hiL
    change g.left.toAdd i = -g.left.toAdd i at he
    have he2 : (2 : ZMod 121) * g.left.toAdd i = 0 := by
      rw [two_mul]
      exact eq_neg_iff_add_eq_zero.mp he
    have he61 := congrArg (fun z : ZMod 121 => 61 * z) he2
    norm_num [← mul_assoc] at he61
    change g.left.toAdd i = 0
    simpa only [show (122 : ZMod 121) = 1 from by decide, one_mul] using he61
  change g = 1
  exact SemidirectProduct.ext hv ((kernel_mem g).mp hkg)

/-- The quotient by the vector subgroup is the actual matrix complement. -/
noncomputable def quotientKernelEquiv : Candidate ⧸ kernel ≃* complement :=
  QuotientGroup.quotientKerEquivOfSurjective SemidirectProduct.rightHom
    (fun g => ⟨SemidirectProduct.inr g, rfl⟩)

/-- An ordinary component would centralize the solvable kernel and hence lie in it. -/
theorem componentLayer_eq_bot : Theory.GroupTheory.componentLayer Candidate = ⊥ := by
  apply eq_bot_iff.mpr
  apply sSup_le
  intro L hL
  have hle : L ≤ kernel := by
    rcases hL.normal_dichotomy kernel with hle | hc
    · exact hle
    · rw [← centralizer_kernel]
      exact commutator_eq_bot_iff_le_centralizer.mp hc
  let : Group.IsSolvable kernel := Group.isSolvable_of_isSolvable_injective
    (f := kernelEquiv.toMonoidHom) kernelEquiv.injective
  let : Group.IsSolvable L := Group.isSolvable_of_isSolvable_injective
    (f := inclusion hle) (inclusion_injective hle)
  let := hL.2
  let := hL.2.simple
  let : Nontrivial L := (QuotientGroup.mk'_surjective (center L)).nontrivial
  exact (Group.IsPerfect.not_isSolvable L inferInstance).elim

/-- There are no ordinary components contributing to the generalized Fitting subgroup. -/
theorem generalizedFitting_eq_fitting :
    Theory.GroupTheory.generalizedFitting Candidate = fittingSubgroup Candidate := by
  rw [Theory.GroupTheory.generalizedFitting, componentLayer_eq_bot, sup_bot_eq]

/-- Inversion supplies all vector elements as action differences; perfectness of the complement suffices. -/
theorem perfect_of_complement_perfect (hp : Group.IsPerfect complement) :
    Group.IsPerfect Candidate := by
  let := hp
  apply Atlas.GroupTheory.semidirect_isPerfect_of_action_differences
  intro v
  refine ⟨inverter.right, Multiplicative.ofAdd (fun i => 60 * v.toAdd i), ?_⟩
  rw [inverter_action]
  apply congrArg Multiplicative.ofAdd
  change (fun i => -(60 * v.toAdd i) + -(60 * v.toAdd i)) = v.toAdd
  ext i
  calc
    -(60 * v.toAdd i) + -(60 * v.toAdd i) =
        (-120 : ZMod 121) * v.toAdd i := by ring
    _ = v.toAdd i := by rw [show (-120 : ZMod 121) = 1 from by decide, one_mul]

/-- Every other prime core centralizes the vector subgroup and is therefore trivial. -/
theorem primeCore_eq_bot_of_ne_eleven (p : ℕ) [Fact p.Prime] (hp : p ≠ 11) :
    pCore p Candidate = ⊥ := by
  let : Fact (Nat.Prime 11) := ⟨by decide⟩
  have hle : pCore p Candidate ≤ kernel := by
    rw [← centralizer_kernel]
    intro g hg
    exact mem_centralizer_iff.mpr fun h hh =>
      (pCore_commute_of_ne p 11 hp g hg h (kernel_le_elevenCore hh)).symm
  exact le_bot_iff.mp ((le_inf le_rfl (hle.trans kernel_le_elevenCore)).trans
    (pCore_disjoint_of_ne (G := Candidate) p 11 hp).eq_bot.le)

/-- The candidate has trivial two-core without using a complement identification. -/
theorem twoCore_eq_bot : pCore 2 Candidate = ⊥ :=
  primeCore_eq_bot_of_ne_eleven 2 (by decide)

/-- Only the 11-core contributes to the Fitting subgroup. -/
theorem fitting_eq_elevenCore : fittingSubgroup Candidate = pCore 11 Candidate := by
  let : Fact (Nat.Prime 11) := ⟨by decide⟩
  refine le_antisymm ?_ (pCore_le_fitting Candidate 11)
  rw [fitting_eq_sup_pCore]
  refine iSup_le fun p => ?_
  by_cases hp : p.1.1 = 11
  · rw [hp]
  · rw [primeCore_eq_bot_of_ne_eleven p.1.1 hp]
    exact bot_le

/-- If the complement order is prime to 11, the vector subgroup is the entire Fitting subgroup. -/
theorem fitting_eq_kernel_of_coprime (hc : Nat.Coprime 11 (Nat.card complement)) :
    fittingSubgroup Candidate = kernel := by
  rw [fitting_eq_elevenCore]
  refine le_antisymm ?_ kernel_le_elevenCore
  intro g hg
  change g.right = 1
  obtain ⟨n, hn⟩ := (pCore_isPGroup (p := 11) (G := Candidate)).exists_pow_pow_eq_one ⟨g, hg⟩
  have hpow : g.right ^ (11 ^ n) = 1 := by
    have hn' : g ^ (11 ^ n) = 1 := congrArg Subtype.val hn
    simpa only [map_pow, map_one, SemidirectProduct.rightHom_eq_right] using congrArg
      (SemidirectProduct.rightHom : Candidate →* complement) hn'
  exact orderOf_eq_one_iff.mp (Nat.eq_one_of_dvd_coprimes (hc.pow_left n)
    (orderOf_dvd_of_pow_eq_one hpow) (orderOf_dvd_natCard g.right))

/-- Under the same arithmetic condition, the vector subgroup is the generalized Fitting subgroup. -/
theorem generalizedFitting_eq_kernel_of_coprime (hc : Nat.Coprime 11 (Nat.card complement)) :
    Theory.GroupTheory.generalizedFitting Candidate = kernel := by
  rw [generalizedFitting_eq_fitting, fitting_eq_kernel_of_coprime hc]

end CFSG.Quasithin.Chapter1.Section02.CenterFrattiniSource
