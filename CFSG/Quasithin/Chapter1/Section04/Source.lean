module

public import CFSG.Quasithin.Chapter1.Defs
public import Theory.GroupTheory.TwoLocalCharacteristicControl
public import Theory.GroupTheory.Commutator.ConjugateGeneration

/-!
# The constructions and elementary implications in source §1.4

In Lemma 1.4.1 of Aschbacher–Smith (1 March 2004, pp. 514–515),
`L₀ = ⟨L^T⟩` is generated by the T-conjugates of L, whereas the local group
is `L₀T`. Its two-core is Q; the other two-core is that of `M = N_G(L₀)`.
All four groups below are defined, rather than supplied as unrelated fields.

The conditional theorem at the end proves characteristic-normalizer control,
uniqueness for `N_G(Q)`, and the ambient centralizer sandwich. Its remaining
inputs are uniqueness from 1.2.7(3) or 1.3.7, nontriviality of Q, and relative
characteristic two from 1.1.4(6). It does not assert family membership or the
signalizer and reduced-module conclusions of 1.4.1(2),(4),(5).
-/

@[expose] public section

namespace CFSG.Quasithin.Chapter1.Section04.Source

open Subgroup

variable {G : Type*} [Group G]

/-- The source's `L₀ = ⟨L^T⟩`; this does not adjoin `T`. -/
def tClosure (L T : Subgroup G) : Subgroup G :=
  ⨆ t : T, L.map (MulAut.conj (t : G)).toMonoidHom

/-- The local group `L₀T`, with `T` now adjoined. -/
def localJoin (L T : Subgroup G) : Subgroup G := tClosure L T ⊔ T

/-- The source's `Q = O₂(L₀T)`, embedded in `G`. -/
def localCore (L T : Subgroup G) : Subgroup G := (localJoin L T).pCoreIn 2

/-- The source's `M = N_G(L₀)`. -/
def uniquenessNormalizer (L T : Subgroup G) : Subgroup G :=
  normalizer (tClosure L T : Set G)

/-- The source's `O₂(M)`, embedded in `G`. -/
def normalizerCore (L T : Subgroup G) : Subgroup G :=
  (uniquenessNormalizer L T).pCoreIn 2

/-- The corrected control condition quantifies over characteristic subgroups
of `Q`, not characteristic subgroups of the ambient group. -/
def ControlsCharacteristicNormalizers (Q M : Subgroup G) : Prop :=
  ∀ R : Subgroup Q, R.Characteristic → R ≠ ⊥ →
    normalizer (R.map Q.subtype : Set G) ≤ M

theorem controlsCharacteristicNormalizers_iff (Q M : Subgroup G) :
    ControlsCharacteristicNormalizers Q M ↔ characteristicNormalizerClosure Q ≤ M :=
  (characteristicNormalizerClosure_le_iff Q M).symm

theorem le_tClosure (L T : Subgroup G) : L ≤ tClosure L T := by
  intro x hx
  apply le_iSup (fun t : T => L.map (MulAut.conj (t : G)).toMonoidHom) (1 : T)
  exact mem_map.mpr ⟨x, hx, by simp⟩

/-- Conjugate generation makes `T` normalize `L₀`, hence `L₀T ≤ M`. -/
theorem localJoin_le_uniquenessNormalizer (L T : Subgroup G) :
    localJoin L T ≤ uniquenessNormalizer L T :=
  sup_le (tClosure L T).le_normalizer (le_normalizer_iSup_conjugates L T)

/-- `Q` is characteristic inside `L₀T`; no ambient characteristicness is used. -/
theorem localJoin_le_normalizer_localCore (L T : Subgroup G) :
    localJoin L T ≤ normalizer (localCore L T : Set G) :=
  (localJoin L T).le_normalizer.trans
    (normalizer_le_normalizer_characteristic_image (localJoin L T)
      (pCore 2 (localJoin L T)))

/-- The elementary implications of source uniqueness. The displayed uniqueness
and characteristic-two premises must be discharged by the earlier chapter
results before this can be used to assemble Lemma 1.4.1. -/
theorem control_and_centralizer_of_uniqueness [Finite G]
    (L : Subgroup G) (T : Sylow 2 G)
    (hmax : IsMaximalTwoLocal (uniquenessNormalizer L T))
    (hunique : ∀ N : Subgroup G, IsMaximalTwoLocal N → localJoin L T ≤ N →
      N = uniquenessNormalizer L T)
    (hQne : localCore L T ≠ ⊥)
    (hchar : uniquenessNormalizer L T ∈ He G) :
    ControlsCharacteristicNormalizers (localCore L T) (uniquenessNormalizer L T) ∧
      {N : Subgroup G | IsMaximalTwoLocal N ∧
        normalizer (localCore L T : Set G) ≤ N} = {uniquenessNormalizer L T} ∧
      centralizer (localCore L T : Set G) ≤ normalizerCore L T ∧
      normalizerCore L T ≤ localCore L T := by
  have hQ := isPGroup_pCoreIn 2 (localJoin L T)
  have hN := localJoin_le_normalizer_localCore L T
  refine ⟨(controlsCharacteristicNormalizers_iff _ _).mpr
    (characteristicNormalizerClosure_le_of_unique_twoLocal hQ hN hunique),
    unique_twoLocal_overgroup_normalizer hQ hQne hN hmax hunique, ?_⟩
  exact centralizer_pCoreIn_le_of_unique_twoLocal T le_sup_right
    (localJoin_le_uniquenessNormalizer L T) hQne hunique hchar

end CFSG.Quasithin.Chapter1.Section04.Source
