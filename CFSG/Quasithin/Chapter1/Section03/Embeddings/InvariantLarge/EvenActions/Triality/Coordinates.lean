module

public import Theory.SpecificGroups.Triality.LeviRankOneMatrices
public import Mathlib.LinearAlgebra.Matrix.IsDiag

/-!
# Torus coordinates in the genuine binary triality construction

The proved pinned SL₂ maps identify a simple-coroot word with a diagonal
rank-one matrix. On the full 28-dimensional Geck lattice its weights are
1 on the Cartan coordinates, t² and t⁻² on the distinguished roots,
t and t⁻¹ on the eight natural blocks, and 1 on the six fixed roots.
Thus the subgroup generated by these words is diagonal and abelian.
Restriction to elementary graph-field fixed points and the actual central
quotient defines its finite torus image; commutativity survives this descent.

This calculation does not identify the torus image with an arbitrary source
Cartan, or assert a Sylow normalizer decomposition. Those geometric facts
are needed separately for the source action in Proposition 1.3.4.

Source: GLS3 §§2.4 and 2.6, especially Proposition 2.6.2,
`refs/KGroup/GLS3/chapter2.tex`; Aschbacher–Smith, combined 1 March 2004
manuscript, Lemma A.3.15(5), pp.50–51 and proof of Proposition 1.3.4, p.511.
-/

@[expose] public section

open Matrix
open scoped MatrixGroups
open Theory.AlgebraicGroup.StandardRootSystem
open Triality.Standard.Parabolics
open Triality.Standard.Parabolics.RankOneMatrices

noncomputable section
namespace Triality.Standard.CartanAction
local instance : DecidableEq LatticeIndex := fun a b => instDecidableEqSum a b
variable {F : Type*} [Field F]

private def rankOneDiagonal (t : Fˣ) : SL(2, F) :=
  ⟨!![(t : F), 0; 0, (t⁻¹ : Fˣ)], by simp⟩

def blockWeights (t : Fˣ) : BlockIndex → F
  | .inl (.inl _) => 1
  | .inl (.inr r) => if r = 0 then (t : F) ^ 2 else (t⁻¹ : Fˣ) ^ 2
  | .inr (.inl (r, _)) => if r = 0 then (t : F) else (t⁻¹ : Fˣ)
  | .inr (.inr _) => 1

private lemma diagonal_entry (t : Fˣ) (r s : Fin 2) :
    (rankOneDiagonal t).val r s =
      Matrix.diagonal (fun r : Fin 2 => if r = 0 then (t : F) else (t⁻¹ : Fˣ)) r s := by
  fin_cases r <;> fin_cases s <;> simp [rankOneDiagonal, Matrix.diagonal]

private lemma blockMatrix_diagonal [CharP F 2] (i : Fin 4) (t : Fˣ) :
    blockMatrix i (rankOneDiagonal t) = Matrix.diagonal (blockWeights t) := by
  ext r s
  rcases r with (k | r) | (⟨r, a⟩ | a) <;>
    rcases s with (j | s) | (⟨s, b⟩ | b)
  all_goals simp [blockMatrix, specialBlock, diagonal_entry, blockWeights,
    Matrix.diagonal, Matrix.blockDiagonal, Matrix.one_apply]
  all_goals first | (split_ifs <;> simp_all) | omega

private lemma rankOne_word (t : Fˣ) :
    (SpecialLinearGroup.transvection (i := (0 : Fin 2)) (j := 1) (by decide) (t : F) *
      SpecialLinearGroup.transvection (i := (1 : Fin 2)) (j := 0) (by decide) (-(t : F)⁻¹) *
      SpecialLinearGroup.transvection (i := (0 : Fin 2)) (j := 1) (by decide) (t : F)) *
    (SpecialLinearGroup.transvection (i := (0 : Fin 2)) (j := 1) (by decide) (-1 : F) *
      SpecialLinearGroup.transvection (i := (1 : Fin 2)) (j := 0) (by decide) (-(-1 : F)⁻¹) *
      SpecialLinearGroup.transvection (i := (0 : Fin 2)) (j := 1) (by decide) (-1 : F)) =
    rankOneDiagonal t := by
  apply Subtype.ext
  simp only [SpecialLinearGroup.coe_mul, SpecialLinearGroup.transvection_coe]
  ext r s
  fin_cases r <;> fin_cases s <;>
    simp [Matrix.mul_apply, Fin.sum_univ_succ, Matrix.single, Matrix.one_apply,
      rankOneDiagonal]

private lemma torusWord_eq_rankOne (P : Parameters) (hp : P.prime = 2)
    (i : Fin 4) (t : (ExtensionField P)ˣ) :
    torusWord P i t = (pinnedRankOneMaps P hp).hom i (rankOneDiagonal t) := by
  rw [← rankOne_word]
  simp only [map_mul, PinnedRankOneMaps.positive, PinnedRankOneMaps.negative,
    torusWord, weylWord]

lemma torusWord_coordinates (P : Parameters) (hp : P.prime = 2)
    (i : Fin 4) (t : (ExtensionField P)ˣ) (r s : BlockIndex) :
    (torusWord P i t).val.val (latticeEquiv i r) (latticeEquiv i s) =
      Matrix.diagonal (blockWeights t) r s := by
  let := rankOneExtensionCharTwo P hp
  rw [torusWord_eq_rankOne P hp]
  change (ambientHom i (rankOneDiagonal t)).val _ _ = _
  rw [ambientHom_entry, blockMatrix_diagonal]


/-- Diagonal matrix units, pulled back to the genuine split group. -/
def splitDiagonal (P : Parameters) : Subgroup (SplitGroup P) :=
  ((Units.map (Matrix.diagonalRingHom LatticeIndex (ExtensionField P)).toMonoidHom).range).comap
    (RootPairing.SimpleGeckGroup.subgroup (typeDRootPairing_base 2) (ExtensionField P)).subtype

lemma mem_splitDiagonal_iff (P : Parameters) (g : SplitGroup P) :
    g ∈ splitDiagonal P ↔ g.val.val.IsDiag := by
  constructor
  · rintro ⟨d, hd⟩
    have hm := congrArg Units.val hd
    change Matrix.diagonal d.val = g.val.val at hm
    rw [← hm]
    exact Matrix.isDiag_diagonal _
  · intro hd
    have hu : IsUnit (Matrix.diag g.val.val) :=
      Matrix.isUnit_diagonal.mp (hd.diagonal_diag.symm ▸ g.val.isUnit)
    obtain ⟨d, he⟩ := hu
    refine ⟨d, Units.ext ?_⟩
    change Matrix.diagonal d.val = g.val.val
    rw [he]
    exact hd.diagonal_diag

lemma torusWord_diagonal (P : Parameters) (hp : P.prime = 2)
    (i : Fin 4) (t : (ExtensionField P)ˣ) :
    torusWord P i t ∈ splitDiagonal P := by
  apply (mem_splitDiagonal_iff P _).mpr
  intro r s hrs
  obtain ⟨r, rfl⟩ := (latticeEquiv i).surjective r
  obtain ⟨s, rfl⟩ := (latticeEquiv i).surjective s
  rw [torusWord_coordinates P hp]
  exact Matrix.diagonal_apply_ne _ (fun h => hrs (congrArg (latticeEquiv i) h))

/-- The subgroup generated by the four genuine simple-coroot words. -/
def splitTorus (P : Parameters) : Subgroup (SplitGroup P) :=
  Subgroup.closure {g | ∃ i t, g = torusWord P i t}

lemma splitTorus_le_diagonal (P : Parameters) (hp : P.prime = 2) :
    splitTorus P ≤ splitDiagonal P := by
  apply (Subgroup.closure_le _).mpr
  rintro g ⟨i, t, rfl⟩
  exact torusWord_diagonal P hp i t

lemma splitTorus_commutes (P : Parameters) (hp : P.prime = 2)
    {g h : SplitGroup P} (hg : g ∈ splitTorus P) (hh : h ∈ splitTorus P) :
    g * h = h * g := by
  have hg' := (mem_splitDiagonal_iff P g).mp (splitTorus_le_diagonal P hp hg)
  have hh' := (mem_splitDiagonal_iff P h).mp (splitTorus_le_diagonal P hp hh)
  apply Subtype.ext
  apply Units.ext
  change g.val.val * h.val.val = h.val.val * g.val.val
  rw [← hg'.diagonal_diag, ← hh'.diagonal_diag, Matrix.diagonal_mul_diagonal',
    Matrix.diagonal_mul_diagonal']
  congr 1
  funext r
  exact mul_comm _ _

/-- Its image after elementary fixed-point restriction and central quotient. -/
def torus (P : Parameters) : Subgroup (Carrier P) := descendSubgroup P (splitTorus P)

private lemma map_comap_commutes {G L K : Type*} [Group G] [Group L] [Group K]
    (f : L →* G) (hf : Function.Injective f) (q : L →* K)
    (T : Subgroup G) (hT : ∀ g ∈ T, ∀ h ∈ T, g * h = h * g)
    {g h : K} (hg : g ∈ (T.comap f).map q) (hh : h ∈ (T.comap f).map q) :
    g * h = h * g := by
  obtain ⟨g, hg, rfl⟩ := hg
  obtain ⟨h, hh, rfl⟩ := hh
  rw [← map_mul, ← map_mul]
  apply congrArg q
  apply hf
  simpa only [map_mul] using hT _ hg _ hh

lemma torus_commutes (P : Parameters) (hp : P.prime = 2)
    {g h : Carrier P} (hg : g ∈ torus P) (hh : h ∈ torus P) : g * h = h * g :=
  map_comap_commutes (elementaryInclusion P)
    ((fixedSubgroup P).subtype_injective.comp (elementarySubgroup P).subtype_injective)
    (toCarrier P) (splitTorus P) (fun _ hg _ hh => splitTorus_commutes P hp hg hh) hg hh

lemma torus_le_borel (P : Parameters) : torus P ≤ borel P :=
  descendSubgroup_mono P le_sup_right

end Triality.Standard.CartanAction
