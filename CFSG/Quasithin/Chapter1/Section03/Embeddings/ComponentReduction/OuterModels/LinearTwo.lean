/-!
# The PSL₂ cases of the outer-automorphism inspection

Inner–diagonal–field coverage gives a cyclic normal diagonal image in the
actual outer group, with cyclic quotient generated by field automorphisms.
This supplies the restriction needed for the PSL₂ entries of Theorem C.
In characteristic two the field group already surjects onto the outer group;
over a prime field the diagonal group does. Both outer groups are therefore
cyclic, in particular abelian as required for the nonnormal-component list.

All coverage premises are discharged by the imported matrix proofs, including
odd field order nine. The prime-field proof also covers order three using the
proved normalization and root-parameter reconstruction. Model transport uses
the actual matrix quotient and entrywise field equivalence. In particular the
abelian-outer statements require no simplicity instance on the quasisimple
group in Proposition 1.2.1(3).

Source: Aschbacher–Smith, combined 1 March 2004 manuscript, printed p.510,
Theorem C on p.33 and Proposition 1.2.1(3) on p.504. The semilinear
automorphism descriptions are GLS3, Theorem 2.5.12 and §2.7 (odd fields),
and GLS4, Chapter 4, Lemma 3.1(a) (binary fields), as proved in the imports.
-/

public section
namespace CFSG.Quasithin.Chapter1.XiEmbedding.OuterModels
open Subgroup Theory.GroupTheory Theory.PSL2 Theory.PSL2.OuterSolvable

private theorem cyclicNormalOddQuotient_of_semilinearCoverage
    {K : Type*} [Field K] [Finite K]
    (hcoverage : ∀ a : MulAut (Theory.PSL2.Group K),
      ∃ (g : Theory.PSL2.Group K) (u : Kˣ) (σ : K ≃+* K),
        a = MulAut.conj g * diagonalAutHom u * projectiveFieldAutHom σ) :
    HasCyclicNormalOddQuotient (MulAut.Outer (Theory.PSL2.Group K)) := by
  let f := semilinearOuterHom (K := K)
  have hf : Function.Surjective f := semilinearOuterHom_surjective_of_coverage hcoverage
  let D := (SemidirectProduct.inl : Kˣ →* SemilinearParameters K).range
  have hD : D.Normal := by
    dsimp [D]
    rw [SemidirectProduct.range_inl_eq_ker_rightHom]
    infer_instance
  let N := D.map f
  let : N.Normal := hD.map f hf
  let d : Kˣ →* MulAut.Outer (Theory.PSL2.Group K) := f.comp SemidirectProduct.inl
  have hN : N = d.range := MonoidHom.map_range f SemidirectProduct.inl
  have hNc : IsCyclic N := by
    rw [hN]
    exact isCyclic_of_surjective d.rangeRestrict d.rangeRestrict_surjective
  let := hNc
  let q := QuotientGroup.mk' N
  let j : (K ≃+* K) →* MulAut.Outer (Theory.PSL2.Group K) ⧸ N :=
    (q.comp f).comp SemidirectProduct.inr
  have hj : Function.Surjective j := by
    intro x
    obtain ⟨y, rfl⟩ := QuotientGroup.mk'_surjective N x
    obtain ⟨⟨u, σ⟩, rfl⟩ := hf y
    refine ⟨σ, ?_⟩
    change q (f (SemidirectProduct.inr σ)) = q (f ⟨u, σ⟩)
    rw [SemidirectProduct.mk_eq_inl_mul_inr, map_mul, map_mul]
    have hu : q (f (SemidirectProduct.inl u)) = 1 :=
      (QuotientGroup.eq_one_iff _).mpr ⟨_, ⟨u, rfl⟩, rfl⟩
    rw [hu, one_mul]
  let : IsCyclic (K ≃+* K) := finiteFieldAut_isCyclic
  let : IsCyclic (MulAut.Outer (Theory.PSL2.Group K) ⧸ N) := isCyclic_of_surjective j hj
  exact ⟨N, inferInstance, inferInstance, fun _ _ _ _ _ => inferInstance⟩

private theorem binary_outer_isCyclic {K : Type*} [Field K] [Finite K] [CharP K 2] :
    IsCyclic (MulAut.Outer (Theory.PSL2.Group K)) := by
  let I := MulAut.innerSubgroup (Theory.PSL2.Group K)
  let f := (QuotientGroup.mk' I).comp (projectiveFieldAutHom (K := K))
  have hf : Function.Surjective f := by
    intro q
    obtain ⟨a, rfl⟩ := QuotientGroup.mk'_surjective I q
    obtain ⟨g, σ, ha⟩ := BenderSuzuki.ZD.Linear.semilinear_coverage a
    have hσ : BenderSuzuki.ZD.Linear.fieldAut σ = projectiveFieldAutHom σ := by
      rw [projectiveFieldAutHom_eq_fieldAut]
      rfl
    rw [hσ] at ha
    refine ⟨σ, ?_⟩
    have hg : QuotientGroup.mk' I (MulAut.conj g) = 1 :=
      (QuotientGroup.eq_one_iff _).mpr ⟨g, rfl⟩
    change QuotientGroup.mk' I (projectiveFieldAutHom σ) = _
    rw [ha, map_mul, hg, one_mul]
  let : IsCyclic (K ≃+* K) := finiteFieldAut_isCyclic
  exact isCyclic_of_surjective f hf

private theorem binary_model_outer_isCyclic {G : Type*} [Group G]
    (f : ℕ) (hmodel : ClassicalGroup.IsPSL G 2 (2 ^ f)) :
    IsCyclic (MulAut.Outer G) := by
  obtain ⟨F, _, _, hF, ⟨i⟩⟩ := hmodel
  let : Fintype F := Fintype.ofFinite F
  let : CharP F 2 := charP_of_card_eq_prime_pow
    (by simpa only [Nat.card_eq_fintype_card] using hF)
  let := binary_outer_isCyclic (K := F)
  exact isCyclic_of_injective (MulAut.outerCongr i).toMonoidHom
    (MulAut.outerCongr i).injective

private theorem prime_outer_isCyclic (p : ℕ) [Fact p.Prime] (ho : Odd p) :
    IsCyclic (MulAut.Outer (Theory.PSL2.Group (ZMod p))) := by
  have hchar : ringChar (ZMod p) ≠ 2 := by
    rw [ZMod.ringChar_zmod_n]
    obtain ⟨k, hk⟩ := ho
    omega
  -- These proved reductions include p = 3, so no additional size premise is needed.
  have hc (a : MulAut (Theory.PSL2.Group (ZMod p))) :
      ∃ (g : Theory.PSL2.Group (ZMod p)) (u : (ZMod p)ˣ) (σ : ZMod p ≃+* ZMod p),
        a = MulAut.conj g * diagonalAutHom u * projectiveFieldAutHom σ :=
    OddCoverage.semilinear_coverage_of_root_reductions
      (OddCoverage.exists_root_weyl_one_normalization hchar)
      (fun b hU _ h1 => OddCoverage.rootParameter_mul hchar b hU h1) a
  let I := MulAut.innerSubgroup (Theory.PSL2.Group (ZMod p))
  let f := (QuotientGroup.mk' I).comp (diagonalAutHom (K := ZMod p))
  have hf : Function.Surjective f := by
    intro q
    obtain ⟨a, rfl⟩ := QuotientGroup.mk'_surjective I q
    obtain ⟨g, u, σ, ha⟩ := hc a
    have hσ : σ = 1 := Subsingleton.elim _ _
    simp only [hσ, map_one, mul_one] at ha
    refine ⟨u, ?_⟩
    have hg : QuotientGroup.mk' I (MulAut.conj g) = 1 :=
      (QuotientGroup.eq_one_iff _).mpr ⟨g, rfl⟩
    change QuotientGroup.mk' I (diagonalAutHom u) = _
    rw [ha, map_mul, hg, one_mul]
  exact isCyclic_of_surjective f hf

/-- The binary PSL₂ entries of Theorem C satisfy the first outer restriction on p.510. -/
theorem psl2_binary_model_outer_cyclicNormalOddQuotient
    {S : Type*} [Group S] [Finite S] [IsSimpleGroup S] [Group.IsPerfect S]
    (f : ℕ) (_hf : 2 ≤ f) (hmodel : ClassicalGroup.IsPSL S 2 (2 ^ f)) :
    HasCyclicNormalOddQuotient (MulAut.Outer S) := by
  let := binary_model_outer_isCyclic f hmodel
  exact hasCyclicNormalOddQuotient_of_isCyclic

/-- The odd PSL₂ entries of Theorem C, including field order nine. -/
theorem psl2_odd_model_outer_cyclicNormalOddQuotient
    {S : Type*} [Group S] [Finite S] [IsSimpleGroup S] [Group.IsPerfect S]
    (r e : ℕ) (hr : r.Prime) (ho : Odd r) (_he : e = 1 ∨ e = 2)
    (hq : 4 ≤ r ^ e) (hmodel : ClassicalGroup.IsPSL S 2 (r ^ e)) :
    HasCyclicNormalOddQuotient (MulAut.Outer S) := by
  obtain ⟨F, _, _, hF, ⟨i⟩⟩ := hmodel
  let : Fintype F := Fintype.ofFinite F
  let : Fact r.Prime := ⟨hr⟩
  let : CharP F r := charP_of_card_eq_prime_pow
    (by simpa only [Nat.card_eq_fintype_card] using hF)
  have hchar : ringChar F ≠ 2 := by
    rw [ringChar.eq F r]
    obtain ⟨k, hk⟩ := ho
    omega
  have hcard : 3 < Nat.card F := by omega
  exact (cyclicNormalOddQuotient_of_semilinearCoverage
    (odd_semilinear_coverage hchar hcard)).of_injective
      (MulAut.outerCongr i).toMonoidHom (MulAut.outerCongr i).injective

/-- The binary alternative in 1.2.1(3) has abelian outer group. -/
theorem psl2_binary_model_outer_isMulCommutative
    {Q : Type*} [Group Q] [Finite Q] [IsQuasisimple Q]
    (f : ℕ) (_hf : 2 ≤ f) (hmodel : ClassicalGroup.IsPSL Q 2 (2 ^ f)) :
    IsMulCommutative (MulAut.Outer Q) := by
  let := binary_model_outer_isCyclic f hmodel
  exact IsCyclic.isMulCommutative

/-- The odd prime-field alternative in 1.2.1(3) has abelian outer group,
without imposing a simplicity instance on the quasisimple input. -/
theorem psl2_prime_model_outer_isMulCommutative
    {Q : Type*} [Group Q] [Finite Q] [IsQuasisimple Q]
    (p : ℕ) (hp : p.Prime) (ho : Odd p) (hmodel : ClassicalGroup.IsPSL Q 2 p) :
    IsMulCommutative (MulAut.Outer Q) := by
  obtain ⟨F, _, _, hF, ⟨i⟩⟩ := hmodel
  let : Fintype F := Fintype.ofFinite F
  let : Fact p.Prime := ⟨hp⟩
  let e : F ≃+* ZMod p := (ZMod.ringEquivOfPrime F hp
    (by simpa only [Nat.card_eq_fintype_card] using hF)).symm
  let E : Q ≃* Theory.PSL2.Group (ZMod p) := i.trans (projectiveRingEquiv e)
  let := prime_outer_isCyclic p ho
  let : IsCyclic (MulAut.Outer Q) := isCyclic_of_injective (MulAut.outerCongr E).toMonoidHom
    (MulAut.outerCongr E).injective
  exact IsCyclic.isMulCommutative

end CFSG.Quasithin.Chapter1.XiEmbedding.OuterModels
