/-!
# Linear and unitary cases of the outer-group inspection

The linear and unitary alternatives needed from Theorem C satisfy the cyclic
normal odd-quotient condition on their actual outer automorphism groups.
For PSL₃ over binary or odd-prime fields, standard automorphism coverage makes
the cyclic diagonal image normal and its quotient abelian, generated by a
cyclic field image and a graph involution. Thus every odd-prime subgroup of
that quotient is cyclic, including at field orders two, three and four.

For PSU₃ over binary fields of order at least four or odd-prime fields,
arbitrary-automorphism semilinear coverage makes the cyclic unitary diagonal
image normal with cyclic quotient. Hermitian-basis transport retains the
matrix-field order q² and fixed-field order q. The earlier conditional
even-unitary adapter is preserved; the unconditional theorem discharges it.

For PSL₄(2) and PSL₅(2), the outer group itself is cyclic. A genuine field
isomorphism identifies every binary model with the proved ZMod 2 carrier.
All branches transport through actual group and outer-group equivalences.

Source: Aschbacher–Smith, combined 1 March 2004 manuscript, printed p.510,
Theorem C and Remark A.2.4 (p.33); GLS3, Theorem 2.5.12 and §2.7.
-/

public section

namespace CFSG.Quasithin.Chapter1.XiEmbedding.OuterModels
open Theory.GroupTheory BenderSuzuki.MatrixGroups
open HermitianForm.OddPrimeSylow.NormalizedOuter

/-- Every odd-prime PSU₃ model satisfies the outer-group condition used in
1.3.4. Simplicity is inherited from the input group, not separately certified. -/
theorem unitary_three_odd_outer_cyclicNormalOddQuotient
    {S : Type*} [Group S] [IsSimpleGroup S]
    (p : ℕ) (hp : p.Prime) (ho : Odd p)
    (hS : ClassicalGroup.IsPSU S 3 p) :
    HasCyclicNormalOddQuotient (MulAut.Outer S) := by
  obtain ⟨F, hF, hfin, J, hcard, hconj, ⟨e⟩⟩ := hS
  let : Fact p.Prime := ⟨hp⟩
  have hfixed : Nat.card {x : F // J.conj x = x} = p := by
    simpa only [pow_one] using
      FiniteField.card_fixed_of_quadratic_frobenius J.conj p 1 (by decide)
        (by simpa only [pow_one] using hcard) (by simpa only [pow_one] using hconj)
  obtain ⟨eJ⟩ := FormTransport.exists_projectiveEquiv J p hcard hfixed
  let eS := e.trans eJ
  let : IsSimpleGroup (ProjectiveSpecialUnitaryMatrixGroup (FormTransport.standardForm J)) :=
    eS.symm.isSimpleGroup
  have h := (FormTransport.standardForm J).outer_cyclicNormalOddQuotient_of_semilinear_coverage
    rfl (Coverage.semilinear_coverage_odd (FormTransport.standardForm J) rfl hp ho hcard hfixed)
  exact h.of_injective (MulAut.outerCongr eS).toMonoidHom (MulAut.outerCongr eS).injective

/-- The even-unitary case reduces only to arbitrary-automorphism coverage
on the antidiagonal model. All fixed-field and actual-model transports are
proved here; the unconditional theorem below supplies coverage. -/
theorem unitary_three_even_outer_cyclicNormalOddQuotient_of_coverage
    (hcoverage : ∀ (E : Type) [Field E] [Finite E] (J : HermitianForm 3 E)
      (f : ℕ), 2 ≤ f → J.form = !![0, 0, 1; 0, 1, 0; 1, 0, 0] →
      Nat.card E = (2 ^ f) ^ 2 → Nat.card {x : E // J.conj x = x} = 2 ^ f →
      ∀ a : MulAut (ProjectiveSpecialUnitaryMatrixGroup J),
        ∃ σ : E ≃+* E, J.HasUnitarySemilinearForm a σ)
    {S : Type*} [Group S] (f : ℕ) (hf : 2 ≤ f)
    (hS : ClassicalGroup.IsPSU S 3 (2 ^ f)) :
    HasCyclicNormalOddQuotient (MulAut.Outer S) := by
  obtain ⟨F, hF, hfin, J, hcard, hconj, ⟨e⟩⟩ := hS
  have hfixed : Nat.card {x : F // J.conj x = x} = 2 ^ f :=
    FiniteField.card_fixed_of_quadratic_frobenius J.conj 2 f (by omega) hcard hconj
  obtain ⟨eJ⟩ := FormTransport.exists_projectiveEquiv J (2 ^ f) hcard hfixed
  let eS := e.trans eJ
  have h := (FormTransport.standardForm J).outer_cyclicNormalOddQuotient_of_semilinear_coverage
    rfl (hcoverage F (FormTransport.standardForm J) f hf rfl hcard hfixed)
  exact h.of_injective (MulAut.outerCongr eS).toMonoidHom (MulAut.outerCongr eS).injective

open Matrix.PSL3.OuterSolvable
open scoped MatrixGroups

private theorem linear_three_outer_of_coverage
    (F : Type*) [Field F] [Finite F] (hcover : standard F = ⊤) :
    HasCyclicNormalOddQuotient (MulAut.Outer PSL(3, F)) := by
  let := innerDiagonalOuter_normal_of_coverage F hcover
  let := outerDiagonalQuotient_isMulCommutative_of_coverage F hcover
  exact outer_cyclicNormalOddQuotient_of_standard_inputs F hcover

/-- The binary PSL₃ branch of Remark A.2.4, including fields of orders two
and four. Coverage, diagonal normality and quotient commutativity are discharged. -/
theorem linear_three_even_outer_cyclicNormalOddQuotient
    {S : Type*} [Group S] (f : ℕ) (hf : 1 ≤ f)
    (hS : ClassicalGroup.IsPSL S 3 (2 ^ f)) :
    HasCyclicNormalOddQuotient (MulAut.Outer S) := by
  obtain ⟨F, _, _, hF, ⟨e⟩⟩ := hS
  have h := linear_three_outer_of_coverage F
    (standard_eq_top_of_two_power_card F (by omega) hF)
  exact h.of_injective (MulAut.outerCongr e).toMonoidHom (MulAut.outerCongr e).injective

/-- The odd-prime PSL₃ branch of Theorem C, including the prime three.
The model inherits simplicity and perfectness from the source component. -/
theorem linear_three_odd_outer_cyclicNormalOddQuotient
    {S : Type*} [Group S] [IsSimpleGroup S] [Group.IsPerfect S]
    (p : ℕ) (hp : p.Prime) (ho : Odd p)
    (hS : ClassicalGroup.IsPSL S 3 p) :
    HasCyclicNormalOddQuotient (MulAut.Outer S) := by
  obtain ⟨F, _, _, hF, ⟨e⟩⟩ := hS
  let : IsSimpleGroup PSL(3, F) := e.symm.isSimpleGroup
  let : Group.IsPerfect PSL(3, F) :=
    Group.IsPerfect.ofSurjective (f := e.toMonoidHom) e.surjective
  have h := linear_three_outer_of_coverage F
    (standard_eq_top_of_odd_prime_card F (Group.IsPerfect.not_isSolvable _) hp ho hF)
  exact h.of_injective (MulAut.outerCongr e).toMonoidHom (MulAut.outerCongr e).injective

/-- The binary PSU₃ branch of Remark A.2.4. The proved arbitrary-automorphism
coverage discharges the remaining premise of the preserved conditional adapter. -/
theorem unitary_three_even_outer_cyclicNormalOddQuotient
    {S : Type*} [Group S] (f : ℕ) (hf : 2 ≤ f)
    (hS : ClassicalGroup.IsPSU S 3 (2 ^ f)) :
    HasCyclicNormalOddQuotient (MulAut.Outer S) := by
  apply unitary_three_even_outer_cyclicNormalOddQuotient_of_coverage ?_ f hf hS
  intro E _ _ J n hn hJ hcard hfixed
  exact J.semilinear_coverage n hn hJ hcard hfixed

/-- Both signs of the literal `three_odd` alternative in Theorem C. -/
theorem three_odd_outer_cyclicNormalOddQuotient
    {S : Type*} [Group S] [IsSimpleGroup S] [Group.IsPerfect S]
    (p : ℕ) (hp : p.Prime) (ho : Odd p) (unitary : Bool)
    (hS : Section02.LocalModels.IsPSLSign S unitary 3 p) :
    HasCyclicNormalOddQuotient (MulAut.Outer S) := by
  cases unitary with
  | false => exact linear_three_odd_outer_cyclicNormalOddQuotient p hp ho hS
  | true => exact unitary_three_odd_outer_cyclicNormalOddQuotient p hp ho hS

/-- The literal `binary_linear` alternative in Theorem C, transported from
the actual binary matrix group through entrywise field transport. -/
theorem binary_linear_outer_cyclicNormalOddQuotient
    {S : Type*} [Group S] (n : ℕ) (hn : n = 4 ∨ n = 5)
    (hS : ClassicalGroup.IsPSL S n 2) :
    HasCyclicNormalOddQuotient (MulAut.Outer S) := by
  obtain ⟨F, _, _, hF, ⟨e⟩⟩ := hS
  let : Fintype F := Fintype.ofFinite F
  let eF : F ≃+* ZMod 2 := FiniteField.ringEquivOfCardEq (by
    simpa only [← Nat.card_eq_fintype_card, Nat.card_zmod] using hF)
  let eS := e.trans (Atlas.fieldEquivPSL n eF)
  let := BinaryLinear.OuterCyclic.psl_outer_isCyclic hn
  have h : HasCyclicNormalOddQuotient (MulAut.Outer PSL(n, ZMod 2)) :=
    hasCyclicNormalOddQuotient_of_isCyclic
  exact h.of_injective (MulAut.outerCongr eS).toMonoidHom (MulAut.outerCongr eS).injective

end CFSG.Quasithin.Chapter1.XiEmbedding.OuterModels
