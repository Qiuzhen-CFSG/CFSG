module

public import CFSG.Quasithin.Chapter1.Section03.Embeddings.InvariantThree.LocalPair
public import Theory.GroupTheory.SylowKernelCore

/-!
# Central kernels and invariant subgroups of an odd classical pair

An invariant proper subgroup of R which is not contained in Φ(R) gives a
proper nonzero invariant subgroup of R/Φ(R). This applies both to intersections
with characteristic ambient subgroups and to Oₚ(RS) ∩ R, with the core taken
inside the subgroup generated by R and S. In the extraspecial order-27 case,
an intersection of order nine suffices; R itself is not assumed elementary.

For a nonreducible pair, R ∩ Z(Q) lies in Φ(R). An elementary complement
therefore embeds in Q/Z(Q); an extraspecial complement has central kernel
of order at most three. Consequently its image has order nine or 27 and
exponent dividing three. Cyclic Sylow three-subgroups of the central quotient
exclude such a pair, independently of its central-cover multiplicity.

These are reductions for the odd-characteristic cases in Aschbacher–Smith,
combined 1 March 2004 manuscript, proof of Proposition 1.3.4, printed p.511
(PDF p.528). The model-specific Sylow and local-core computations remain
separate obligations; these lemmas do not assert the complete model sieve.
-/

@[expose] public section

open Subgroup Theory.GroupTheory
open scoped Pointwise commutatorElement
namespace CFSG.Quasithin.Chapter1.XiEmbedding.InvariantThree.OddClassical
universe u
variable {Q : Type u} [Group Q] [Finite Q]

theorem reducible_of_invariant_subgroup (S R : Subgroup Q) (A : Subgroup R)
    (hn : ¬ A ≤ frattini R) (ht : A ≠ ⊤)
    (ha : ∀ b ∈ pairAutomizer S R, ∀ x ∈ A, b x ∈ A) :
    PairReducible S R := by
  let q := QuotientGroup.mk' (frattini R)
  apply pairReducible_of_invariant
  refine ⟨A.map q, ?_, ?_, ?_⟩
  · intro he
    exact hn (by simpa [q] using (map_eq_bot_iff A).mp he)
  · intro he
    apply ht
    apply frattini_nongenerating
    have hh := congrArg (fun B : Subgroup (R ⧸ frattini R) => B.comap q) he
    simpa [q, comap_map_eq, sup_comm] using hh
  · intro b hb x hx
    obtain ⟨x, hx, rfl⟩ := hx
    rw [quotientAut_apply_mk]
    exact mem_map_of_mem q (ha b hb x hx)

theorem reducible_of_characteristic_intersection (S R N : Subgroup Q)
    [N.Characteristic] (hn : ¬ N.subgroupOf R ≤ frattini R)
    (ht : N.subgroupOf R ≠ ⊤) : PairReducible S R := by
  apply reducible_of_invariant_subgroup S R (N.subgroupOf R) hn ht
  intro b hb x hx
  obtain ⟨a, _, he⟩ := hb
  change (b x : Q) ∈ N
  rw [he]
  exact characteristic_iff_le_comap.mp (inferInstance : N.Characteristic) a hx

/-- A prime core is taken inside the subgroup generated by the pair. -/
theorem reducible_of_local_core_intersection (S R : Subgroup Q) (p : ℕ)
    (hn : ¬ ((R ⊔ S).pCoreIn p).subgroupOf R ≤ frattini R)
    (ht : ((R ⊔ S).pCoreIn p).subgroupOf R ≠ ⊤) : PairReducible S R := by
  apply reducible_of_invariant_subgroup S R _ hn ht
  intro b hb x hx
  obtain ⟨a, hS, he⟩ := hb
  have hs : S.map a.toMonoidHom = S := by
    ext y
    constructor
    · rintro ⟨z, hz, rfl⟩
      exact (hS z).mpr hz
    · intro hy
      exact ⟨a.symm y, (hS _).mp (by simpa using hy), a.apply_symm_apply y⟩
  have hr : R.map a.toMonoidHom = R := by
    ext y
    constructor
    · rintro ⟨z, hz, rfl⟩
      change a z ∈ R
      rw [← he ⟨z, hz⟩]
      exact (b ⟨z, hz⟩).property
    · intro hy
      refine ⟨b.symm ⟨y, hy⟩, (b.symm ⟨y, hy⟩).property, ?_⟩
      change a ((b.symm ⟨y, hy⟩ : R) : Q) = y
      rw [← he]
      exact congrArg Subtype.val (b.apply_symm_apply ⟨y, hy⟩)
  change (b x : Q) ∈ (R ⊔ S).pCoreIn p
  rw [he]
  have hx' : (x : Q) ∈ (R ⊔ S).pCoreIn p := hx
  have hh := mem_map_of_mem a.toMonoidHom hx'
  rw [map_pCoreIn_of_injective p (R ⊔ S) a.toMonoidHom a.injective,
    Subgroup.map_sup, hr, hs] at hh
  exact hh

theorem reducible_of_extraspecial_local_core_nine {S : Sylow 2 Q} {R : Subgroup Q}
    (h : PairInput S R) (hR : Nat.card R = 27)
    (hA : Nat.card (((R ⊔ (S : Subgroup Q)).pCoreIn 3).subgroupOf R) = 9) :
    PairReducible (S : Subgroup Q) R := by
  have he : IsExtraspecial 3 R := by
    rcases h.oddComplement with ⟨_, hc⟩ | ⟨he, _, _⟩
    · norm_num at hc
      omega
    · exact he
  let _ := he
  let _ := IsExtraspecial.quotient_elementary_abelian 3 R
  let _ : Fact (IsPGroup 3 (R ⧸ center R)) :=
    ⟨h.oddComplement.isPGroup.to_quotient _⟩
  have hphi : frattini R ≤ center R := by
    have hh := frattini_le_comap_frattini_of_surjective
      (QuotientGroup.mk'_surjective (center R))
    rw [frattini_eq_bot_of_isElementaryAbelian (R := R ⧸ center R) (p := 3)] at hh
    simpa using hh
  apply reducible_of_local_core_intersection (S : Subgroup Q) R 3
  · intro ha
    have hd := card_dvd_of_le (ha.trans hphi)
    rw [hA, IsExtraspecial.center_order_p 3 R] at hd
    norm_num at hd
  · intro ha
    rw [ha, Nat.card_congr (Subgroup.topEquiv).toEquiv, hR] at hA
    omega

omit [Finite Q] in
theorem center_intersection_ne_top {S : Sylow 2 Q} {R : Subgroup Q}
    (h : PairInput S R) : (center Q).subgroupOf R ≠ ⊤ := by
  intro ht
  have hr : R ≤ center Q := by
    intro r hr
    have hh : (⟨r, hr⟩ : R) ∈ (center Q).subgroupOf R := ht ▸ mem_top _
    exact hh
  have hc : ⁅(⊤ : Subgroup Q), R⁆ = ⊥ := by
    apply le_bot_iff.mp
    apply commutator_le.mpr
    intro x _ r hr'
    exact mem_bot.mpr (show Commute x r from mem_center_iff.mp (hr hr') x).commutator_eq
  have htop : (⊤ : Subgroup Q) = ⊥ := h.commutator.symm.trans hc
  have hrbot : R = ⊥ := bot_unique (htop ▸ le_top)
  have hh := h.oddComplement.one_lt_card Nat.prime_three
  rw [hrbot, Subgroup.card_bot] at hh
  omega

theorem center_intersection_le_frattini {S : Sylow 2 Q} {R : Subgroup Q}
    (h : PairInput S R) (hn : ¬ PairReducible (S : Subgroup Q) R) :
    (center Q).subgroupOf R ≤ frattini R := by
  by_contra hh
  exact hn (reducible_of_characteristic_intersection _ _ _ hh (center_intersection_ne_top h))

theorem central_image_card {S : Sylow 2 Q} {R : Subgroup Q}
    (h : PairInput S R) (hn : ¬ PairReducible (S : Subgroup Q) R) :
    Nat.card (R.map (QuotientGroup.mk' (center Q))) = 9 ∨
      Nat.card (R.map (QuotientGroup.mk' (center Q))) = 27 := by
  let q := QuotientGroup.mk' (center Q)
  have hk : (q.subgroupMap R).ker = (center Q).subgroupOf R := by
    rw [Subgroup.ker_subgroupMap, QuotientGroup.ker_mk']
  have hprod := (q.subgroupMap R).ker.card_mul_index
  rw [index_ker, MonoidHom.range_eq_top.mpr (q.subgroupMap_surjective R),
    Nat.card_congr (Subgroup.topEquiv).toEquiv, hk] at hprod
  rcases h.oddComplement with ⟨he, hcard⟩ | ⟨he, hcard, _⟩
  · let _ := he
    let _ : Fact (IsPGroup 3 R) := ⟨h.oddComplement.isPGroup⟩
    have hz : (center Q).subgroupOf R = ⊥ := by
      apply bot_unique
      simpa only [frattini_eq_bot_of_isElementaryAbelian (R := R) (p := 3)] using
        center_intersection_le_frattini h hn
    rw [hz, Subgroup.card_bot] at hprod
    exact Or.inl (by simpa [q, hcard] using hprod)
  · let _ := he
    have hz : (center Q).subgroupOf R ≤ center R := by
      intro r hr
      rw [mem_center_iff]
      intro x
      apply Subtype.ext
      exact mem_center_iff.mp hr (x : Q)
    have hd := card_dvd_of_le hz
    rw [IsExtraspecial.center_order_p 3 R] at hd
    rcases (Nat.dvd_prime Nat.prime_three).mp hd with hc | hc
    · rw [hc] at hprod
      exact Or.inr (by simpa [q, hcard] using hprod)
    · rw [hc] at hprod
      left
      norm_num at hcard
      dsimp [q] at hprod
      omega

omit [Finite Q] in
theorem central_image_exponent {S : Sylow 2 Q} {R : Subgroup Q}
    (h : PairInput S R) :
    Monoid.exponent (R.map (QuotientGroup.mk' (center Q))) ∣ 3 := by
  have he : Monoid.exponent R ∣ 3 := by
    rcases h.oddComplement with ⟨he, _⟩ | ⟨_, _, he⟩
    · exact he.exponent_dvd_p
    · rw [he]
  apply Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr
  intro x
  obtain ⟨y, rfl⟩ := (QuotientGroup.mk' (center Q)).subgroupMap_surjective R x
  rw [← map_pow, Monoid.exponent_dvd_iff_forall_pow_eq_one.mp he y, map_one]

theorem reducible_of_cyclic_three_subgroups {S : Sylow 2 Q} {R : Subgroup Q}
    (h : PairInput S R)
    (hc : ∀ U : Subgroup (Q ⧸ center Q), IsPGroup 3 U → IsCyclic U) :
    PairReducible (S : Subgroup Q) R := by
  by_contra hn
  let U := R.map (QuotientGroup.mk' (center Q))
  let _ := hc U (h.oddComplement.isPGroup.map _)
  have hd := central_image_exponent h
  rw [IsCyclic.exponent_eq_card] at hd
  rcases central_image_card h hn with hh | hh <;> rw [hh] at hd <;> norm_num at hd

theorem reducible_of_cyclic_three_sylow {S : Sylow 2 Q} {R : Subgroup Q}
    (h : PairInput S R)
    (hc : ∀ U : Sylow 3 (Q ⧸ center Q), IsCyclic U) :
    PairReducible (S : Subgroup Q) R := by
  apply reducible_of_cyclic_three_subgroups h
  intro U hU
  obtain ⟨P, hP⟩ := hU.exists_le_sylow
  let _ := hc P
  exact Subgroup.isCyclic_of_le hP

end CFSG.Quasithin.Chapter1.XiEmbedding.InvariantThree.OddClassical
