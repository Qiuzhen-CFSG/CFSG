@[expose] public def r1s2 (x : Fin 4060) : Nat :=
  (r1s2Data[x.val / 64]! >>> (15 * (x.val % 64))) % 32768

@[expose] public def r1s2Cell : List (Fin 4060) := [1028, 1738, 2249]

@[expose] public def r1s2Rows : List Nat := [
,
,
]

private theorem r1s2_rows : r1s2Rows = r1s2Cell.map row := by decide +kernel

private theorem r1s2_nodup : r1s2Cell.Nodup := by decide +kernel

private theorem r1s2_facts : ∀ x : Fin 4060,
    (x ∈ r1s2Cell ↔ r1s1 x = 3041) ∧
    r1s2 x = r1s1 x * 4 + bitCount r1s2Rows x := by
  apply allFinBlocks
  intro b
  fin_cases b <;> decide +kernel

public theorem r1s2_preserved (g : Model) (hg : g ∈ seedStabilizer)
    (hf : ∀ x : Fin 4060, x.val < 1 → g • x = x) :
    ∀ x, r1s2 (g • x) = r1s2 x :=
  refine_preserved g.val
    (model_le_relationAut aPerm_mem_relationAut bPerm_mem_relationAut g.property)
    r1s1 r1s2 r1s2Cell 3041 4
    r1s2_nodup (fun x => (r1s2_facts x).1)
    (fun x => ((r1s2_facts x).2).trans
      (congrArg (fun n => r1s1 x * 4 + n)
        (bitCount_eq r1s2Cell r1s2Rows r1s2_rows x)))
    (r1s1_preserved g hg hf)

