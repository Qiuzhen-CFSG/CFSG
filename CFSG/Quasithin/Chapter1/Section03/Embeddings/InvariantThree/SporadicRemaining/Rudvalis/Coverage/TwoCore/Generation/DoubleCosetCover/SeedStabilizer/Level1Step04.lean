private theorem r1s4_rows : r1s4Rows = r1s4Cell.map row := by decide +kernel

private theorem r1s4_nodup : r1s4Cell.Nodup := by decide +kernel

private theorem r1s4_facts : ∀ x : Fin 4060,
    (x ∈ r1s4Cell ↔ r1s3 x = 157052) ∧
    r1s4 x = r1s3 x * 13 + bitCount r1s4Rows x := by
  apply allFinBlocks
  intro b
  fin_cases b <;> decide +kernel

public theorem r1s4_preserved (g : Model) (hg : g ∈ seedStabilizer)
    (hf : ∀ x : Fin 4060, x.val < 1 → g • x = x) :
    ∀ x, r1s4 (g • x) = r1s4 x :=
  refine_preserved g.val
    (model_le_relationAut aPerm_mem_relationAut bPerm_mem_relationAut g.property)
    r1s3 r1s4 r1s4Cell 157052 13
    r1s4_nodup (fun x => (r1s4_facts x).1)
    (fun x => ((r1s4_facts x).2).trans
      (congrArg (fun n => r1s3 x * 13 + n)
        (bitCount_eq r1s4Cell r1s4Rows r1s4_rows x)))
    (r1s3_preserved g hg hf)

end Rudvalis.SylowOvergroups.TwoCore.Generation.DoubleCosetCover.SeedStabilizerCertificate
