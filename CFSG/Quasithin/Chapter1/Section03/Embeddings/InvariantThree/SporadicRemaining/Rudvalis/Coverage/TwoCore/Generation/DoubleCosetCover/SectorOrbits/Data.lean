/-- The complete row at a natural-number address. Only addresses below 424125 are used. -/
@[expose] public def row (i : Nat) : Nat :=
  (packedBlock (i / 256) >>> (397 * (i % 256))) % (2 ^ 397)

/-- The low 336 bits encode the 28 point labels. -/
@[expose] public def pointCode (i : Nat) : Nat := row i % (2 ^ 336)

