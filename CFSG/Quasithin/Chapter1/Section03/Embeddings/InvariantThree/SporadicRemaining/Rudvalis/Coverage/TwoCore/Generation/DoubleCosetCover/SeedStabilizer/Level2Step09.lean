@[expose] public def r2s9 (x : Fin 4060) : Nat :=
  (r2s9Data[x.val / 64]! >>> (22 * (x.val % 64))) % 4194304

@[expose] public def r2s9Cell : List (Fin 4060) := [2433]

@[expose] public def r2s9Rows : List Nat := [
]

private theorem r2s9_rows : r2s9Rows = r2s9Cell.map row := by decide +kernel

private theorem r2s9_nodup : r2s9Cell.Nodup := by decide +kernel

private theorem r2s9_facts : ∀ x : Fin 4060,
    (x ∈ r2s9Cell ↔ r2s8 x = 1161271) ∧
    r2s9 x = r2s8 x * 2 + bitCount r2s9Rows x := by
  apply allFinBlocks
  intro b
  fin_cases b <;> decide +kernel

public theorem r2s9_preserved (g : Model) (hg : g ∈ seedStabilizer)
    (hf : ∀ x : Fin 4060, x.val < 2 → g • x = x) :
    ∀ x, r2s9 (g • x) = r2s9 x :=
  refine_preserved g.val
    (model_le_relationAut aPerm_mem_relationAut bPerm_mem_relationAut g.property)
    r2s8 r2s9 r2s9Cell 1161271 2
    r2s9_nodup (fun x => (r2s9_facts x).1)
    (fun x => ((r2s9_facts x).2).trans
      (congrArg (fun n => r2s8 x * 2 + n)
        (bitCount_eq r2s9Cell r2s9Rows r2s9_rows x)))
    (r2s8_preserved g hg hf)

end Rudvalis.SylowOvergroups.TwoCore.Generation.DoubleCosetCover.SeedStabilizerCertificate
