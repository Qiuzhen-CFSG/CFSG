@[expose] public def r2s8 (x : Fin 4060) : Nat :=
  (r2s8Data[x.val / 64]! >>> (21 * (x.val % 64))) % 2097152

@[expose] public def r2s8Cell : List (Fin 4060) := [1434]

@[expose] public def r2s8Rows : List Nat := [
]

private theorem r2s8_rows : r2s8Rows = r2s8Cell.map row := by decide +kernel

private theorem r2s8_nodup : r2s8Cell.Nodup := by decide +kernel

private theorem r2s8_facts : ∀ x : Fin 4060,
    (x ∈ r2s8Cell ↔ r2s7 x = 580634) ∧
    r2s8 x = r2s7 x * 2 + bitCount r2s8Rows x := by
  apply allFinBlocks
  intro b
  fin_cases b <;> decide +kernel

public theorem r2s8_preserved (g : Model) (hg : g ∈ seedStabilizer)
    (hf : ∀ x : Fin 4060, x.val < 2 → g • x = x) :
    ∀ x, r2s8 (g • x) = r2s8 x :=
  refine_preserved g.val
    (model_le_relationAut aPerm_mem_relationAut bPerm_mem_relationAut g.property)
    r2s7 r2s8 r2s8Cell 580634 2
    r2s8_nodup (fun x => (r2s8_facts x).1)
    (fun x => ((r2s8_facts x).2).trans
      (congrArg (fun n => r2s7 x * 2 + n)
        (bitCount_eq r2s8Cell r2s8Rows r2s8_rows x)))
    (r2s7_preserved g hg hf)

end Rudvalis.SylowOvergroups.TwoCore.Generation.DoubleCosetCover.SeedStabilizerCertificate
