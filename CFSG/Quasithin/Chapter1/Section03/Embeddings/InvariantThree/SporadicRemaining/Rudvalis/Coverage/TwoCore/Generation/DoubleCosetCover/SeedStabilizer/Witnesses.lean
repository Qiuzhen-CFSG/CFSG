@[expose] public def witness0Code (x : Fin 4060) : Nat :=
  (witness0CodeData[x.val / 64]! >>> (16 * (x.val % 64))) % 65536

@[expose] public def witness0 (x : Fin 4060) : Fin 21 × Fin 16384 :=
  (Fin.ofNat 21 (witness0Code x / 16384), Fin.ofNat 16384 (witness0Code x))

private theorem witness0_checked : ∀ x : Fin 4060,
    (seedColor 0) x = (seedColor 0) 0 →
      witnessMap (witness0 x) 0 = x := by
  apply allFinBlocks
  intro b
  fin_cases b <;> decide +kernel

public theorem image_zero (g : Model) (hg : g ∈ seedStabilizer) :
    ∃ h : Model, h ∈ max4 ∧ h • (0 : Fin 4060) = g • (0 : Fin 4060) := by
  refine ⟨witnessValue (witness0 (g • 0)), witnessValue_mem _, ?_⟩
  rw [witnessValue_smul]
  exact witness0_checked _ (seedColor_preserved 0 g hg (by intro x hx; omega) 0)

