@[expose] public def witness1Code (x : Fin 4060) : Nat :=
  (witness1CodeData[x.val / 64]! >>> (19 * (x.val % 64))) % 524288

@[expose] public def witness1 (x : Fin 4060) : Fin 21 × Fin 16384 :=
  (Fin.ofNat 21 (witness1Code x / 16384), Fin.ofNat 16384 (witness1Code x))

private theorem witness1_checked : ∀ x : Fin 4060,
    r1s4 x = r1s4 1 →
      witnessMap (witness1 x) 0 = 0 ∧
      witnessMap (witness1 x) 1 = x := by
  apply allFinBlocks
  intro b
  fin_cases b <;> decide +kernel

public theorem image_one (g : Model) (hg : g ∈ seedStabilizer)
    (hf : ∀ x : Fin 4060, x.val < 1 → g • x = x) :
    ∃ h : Model, h ∈ max4 ∧ h • (0 : Fin 4060) = 0 ∧
      h • (1 : Fin 4060) = g • (1 : Fin 4060) := by
  have hw := witness1_checked _ (r1s4_preserved g hg hf 1)
  exact ⟨witnessValue (witness1 (g • 1)), witnessValue_mem _,
    (witnessValue_smul _ _).trans hw.1, (witnessValue_smul _ _).trans hw.2⟩

private theorem first_five_separated : ∀ (x : Fin 4060) (j : Fin 5),
    r2s10 x = r2s10 (j.castLE (by decide)) → x = j.castLE (by decide) := by
  apply allFinBlocks
  intro b
  fin_cases b <;> decide +kernel

public theorem fix_two_eq_one (g : Model) (hg : g ∈ seedStabilizer)
    (hf : ∀ x : Fin 4060, x.val < 2 → g • x = x) : g = 1 := by
  apply eq_one_of_fixes_first_five
  intro x hx
  exact first_five_separated (g • x) ⟨x.val, hx⟩ (r2s10_preserved g hg hf x)

end Rudvalis.SylowOvergroups.TwoCore.Generation.DoubleCosetCover.SeedStabilizerCertificate
