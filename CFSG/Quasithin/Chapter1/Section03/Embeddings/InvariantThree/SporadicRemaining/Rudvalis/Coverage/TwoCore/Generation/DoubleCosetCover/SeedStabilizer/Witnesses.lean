/-!
# Point-image witnesses in max4

The first two point images are matched by explicit binary candidate words
followed by one of the published local words. With both points fixed, the
refinement distinguishes points 0 through 4, which form a model base.

For the degree-4060 ATLAS action and the exact zero-based seed in
`SectorGeometry`. Source application: Aschbacher--Smith, printed p.511
(PDF p.528), citing Aschbacher (1986), no.343. Attribution and the inverse
action convention are retained in `Rudvalis.Model.PermutationData`.
The untrusted witness generator is `SeedStabilizer/source/Generate.py`;
every finite assertion below is checked by the Lean kernel.
-/

namespace Rudvalis.SylowOvergroups.TwoCore.Generation.DoubleCosetCover.SeedStabilizerCertificate
open OuterNormalizer OuterNormalizer.RigidityCertificate
open OuterNormalizer.InvarianceCertificate
open Representatives RadicalCoverage.SylowCertificate

set_option maxRecDepth 30000
set_option Elab.async false

@[expose] public def witnessValue (w : Fin 21 × Fin 16384) : Model :=
  candidateNormalForm w.2 * localValue (localWords w.1)

@[expose] public def witnessMap (w : Fin 21 × Fin 16384) (x : Fin 4060) : Fin 4060 :=
  LocalOrder.normalMap w.2 (localMap (localWords w.1) x)

public theorem witnessValue_smul (w : Fin 21 × Fin 16384) (x : Fin 4060) :
    witnessValue w • x = witnessMap w x := by
  simp only [witnessValue, witnessMap, mul_smul, LocalOrder.normal_smul, localValue_smul]

public theorem witnessValue_mem (w : Fin 21 × Fin 16384) : witnessValue w ∈ max4 := by
  apply max4.mul_mem (candidate_le_max4 (candidateNormalForm_mem w.2))
  apply max4.list_prod_mem
  intro g hg
  obtain ⟨j, _, rfl⟩ := List.mem_map.mp hg
  have hx : max4Generators.1 ∈ max4 := Subgroup.subset_closure (Set.mem_insert _ _)
  have hy : max4Generators.2 ∈ max4 :=
    Subgroup.subset_closure (Set.mem_insert_of_mem _ (Set.mem_singleton _))
  fin_cases j
  · exact hx
  · exact hy
  · exact max4.inv_mem hx
  · exact max4.inv_mem hy

