module

public import CFSG.Quasithin.Chapter1.Section03.Embeddings.InvariantThree.SporadicRemaining.Rudvalis.Coverage.TwoCore.Generation.DoubleCosetCover.Local

/-!
# Reduction of all local-sector products to the published representatives

For each of the 21 local words and 76 sector words, the retained certificate
specifies a representative and two candidate normal forms. All 1596 identities
are checked on the five-point base of the actual Rudvalis model. The normal
forms lie in the candidate subgroup by construction, so these are actual
double-coset factorizations, with both subgroup memberships proved.

The discovery script in `Reduction/source/Generate.py` uses transporters on
right cosets inside max4, and exports only normal-form indices. Its GAP orbit,
intersection and transporter claims are not proof inputs. The Lean check uses
the existing certified action maps and the five-point rigidity theorem.

Source application: Aschbacher--Smith, printed p.511 (PDF p.528), citing
Aschbacher (1986), no.343. ATLAS attribution and multiplication convention
are retained in `Representatives.WordLanguage` and `Sylow.Candidate`.
-/

namespace Rudvalis.SylowOvergroups.TwoCore.Generation.DoubleCosetCover
open Representatives RadicalCoverage.SylowCertificate

/-- Ten bits for the representative, then fourteen bits for each normal form. -/
private def reductionPacked : Nat := 

private def reductionAt (i : Fin 21) (s : Fin 76) : Index × Fin 16384 × Fin 16384 :=
  let n := reductionPacked >>> (38 * (s.val * 21 + i.val))
  (⟨n % 1024 % 847, Nat.mod_lt _ (by decide)⟩,
    ⟨(n >>> 10) % 16384, Nat.mod_lt _ (by decide)⟩,
    ⟨(n >>> 24) % 16384, Nat.mod_lt _ (by decide)⟩)

set_option maxRecDepth 10000 in
private theorem reductionMaps :
    ∀ (i : Fin 21) (s : Fin 76) (x : Fin 5),
      localMap (localWords i) (wordMap (sectorWords s) (x.castLE (by decide))) =
        LocalOrder.normalMap (reductionAt i s).2.1
          (representativeMap (reductionAt i s).1
            (LocalOrder.normalMap (reductionAt i s).2.2 (x.castLE (by decide)))) := by
  apply Rudvalis.OrderCertificate.allFin₃
  decide +kernel

/-- Every local-sector product lies in a published candidate double coset. -/
public theorem local_sector_reduction (i : Fin 21) (s : Fin 76) :
    ∃ k l r, l ∈ candidate ∧ r ∈ candidate ∧
      localValue (localWords i) * wordValue (sectorWords s) = l * representative k * r := by
  refine ⟨(reductionAt i s).1, candidateNormalForm (reductionAt i s).2.1,
    candidateNormalForm (reductionAt i s).2.2,
    candidateNormalForm_mem _, candidateNormalForm_mem _, ?_⟩
  apply eq_of_smul_first_five
  intro x
  simp only [mul_smul, localValue_smul, wordValue_smul, representative_smul, LocalOrder.normal_smul]
  exact reductionMaps i s x

end Rudvalis.SylowOvergroups.TwoCore.Generation.DoubleCosetCover
