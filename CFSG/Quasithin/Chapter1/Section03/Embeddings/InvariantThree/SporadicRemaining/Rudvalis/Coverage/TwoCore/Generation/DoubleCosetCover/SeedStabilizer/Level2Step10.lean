@[expose] public def r2s10 (x : Fin 4060) : Nat :=
  (r2s10Data[x.val / 64]! >>> (23 * (x.val % 64))) % 8388608

@[expose] public def r2s10Cell : List (Fin 4060) := [3385]

@[expose] public def r2s10Rows : List Nat := [
]

private theorem r2s10_rows : r2s10Rows = r2s10Cell.map row := by decide +kernel

private theorem r2s10_nodup : r2s10Cell.Nodup := by decide +kernel

private theorem r2s10_facts : ∀ x : Fin 4060,
    (x ∈ r2s10Cell ↔ r2s9 x = 2322564) ∧
    r2s10 x = r2s9 x * 2 + bitCount r2s10Rows x := by
  apply allFinBlocks
  intro b
  fin_cases b <;> decide +kernel

public theorem r2s10_preserved (g : Model) (hg : g ∈ seedStabilizer)
    (hf : ∀ x : Fin 4060, x.val < 2 → g • x = x) :
    ∀ x, r2s10 (g • x) = r2s10 x :=
  refine_preserved g.val
    (model_le_relationAut aPerm_mem_relationAut bPerm_mem_relationAut g.property)
    r2s9 r2s10 r2s10Cell 2322564 2
    r2s10_nodup (fun x => (r2s10_facts x).1)
    (fun x => ((r2s10_facts x).2).trans
      (congrArg (fun n => r2s9 x * 2 + n)
        (bitCount_eq r2s10Cell r2s10Rows r2s10_rows x)))
    (r2s9_preserved g hg hf)

end Rudvalis.SylowOvergroups.TwoCore.Generation.DoubleCosetCover.SeedStabilizerCertificate
