module

public import Theory.SpecificGroups.Rudvalis.Model.SylowOvergroups.TwoCore.Definitions
public import Theory.SpecificGroups.Rudvalis.Model.SylowOvergroups.RadicalCoverage.Sylow.LocalOrder

/-!
# A fixed Sylow subgroup for Rudvalis generator recovery

The fourteen word generators in `SylowCertificate.Candidate` generate a
subgroup of order 2^14. The checked ambient two-part bound excludes 2^15,
so this subgroup has odd index in the actual degree-4060 model. Restricting
the resulting ambient Sylow subgroup to max4 gives a specific witness for
the intrinsic Sylow choice in `TwoCore.GeneratorRecovery`.

This construction uses neither the max4/max6 cardinality bounds nor any
maximal-subgroup coverage assertion. It fixes the subgroup against which
the remaining double-coset and word-recovery certificates can be checked.

Source application: Aschbacher--Smith, printed p.511 (PDF p.528), citing
Aschbacher, *Overgroups of Sylow subgroups in sporadic groups* (1986),
no.343. The concrete words and their ATLAS attribution are preserved in
`Theory.SpecificGroups.Rudvalis.Model.SylowOvergroups.RadicalCoverage.Sylow.Candidate`.
-/

namespace Rudvalis.SylowOvergroups.TwoCore.Generation

open Subgroup RadicalCoverage.SylowCertificate

/-- The fixed word subgroup already contains the full ambient two-part. -/
public theorem candidate_index_odd : ¬ 2 ∣ candidate.index := by
  intro h
  apply not_two_pow_fifteen_dvd_card_model
  rw [← candidate.card_mul_index, candidate_card]
  exact Nat.mul_dvd_mul_left 16384 h

/-- The intrinsic Sylow subgroup of max4 used in the recovery calculation. -/
@[expose] public noncomputable def fixedSylow : Sylow 2 max4 :=
  (LocalOrder.candidate_isTwoGroup.toSylow candidate_index_odd).subtype candidate_le_max4

/-- Its ambient image is exactly the subgroup generated by the fourteen
preserved words, rather than a subgroup specified only up to isomorphism. -/
public theorem sylowImage_fixedSylow : sylowImage fixedSylow = candidate := by
  change (candidate.subgroupOf max4).map max4.subtype = candidate
  exact map_subgroupOf_eq_of_le candidate_le_max4

end Rudvalis.SylowOvergroups.TwoCore.Generation
