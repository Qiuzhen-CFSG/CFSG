@[expose] public def r2s5 (x : Fin 4060) : Nat :=
  (r2s5Data[x.val / 64]! >>> (18 * (x.val % 64))) % 262144

@[expose] public def r2s5Cell : List (Fin 4060) := [268]

@[expose] public def r2s5Rows : List Nat := [
]

private theorem r2s5_rows : r2s5Rows = r2s5Cell.map row := by decide +kernel

private theorem r2s5_nodup : r2s5Cell.Nodup := by decide +kernel

private theorem r2s5_facts : ∀ x : Fin 4060,
    (x ∈ r2s5Cell ↔ r2s4 x = 72578) ∧
    r2s5 x = r2s4 x * 2 + bitCount r2s5Rows x := by
  apply allFinBlocks
  intro b
  fin_cases b <;> decide +kernel

public theorem r2s5_preserved (g : Model) (hg : g ∈ seedStabilizer)
    (hf : ∀ x : Fin 4060, x.val < 2 → g • x = x) :
    ∀ x, r2s5 (g • x) = r2s5 x :=
  refine_preserved g.val
    (model_le_relationAut aPerm_mem_relationAut bPerm_mem_relationAut g.property)
    r2s4 r2s5 r2s5Cell 72578 2
    r2s5_nodup (fun x => (r2s5_facts x).1)
    (fun x => ((r2s5_facts x).2).trans
      (congrArg (fun n => r2s4 x * 2 + n)
        (bitCount_eq r2s5Cell r2s5Rows r2s5_rows x)))
    (r2s4_preserved g hg hf)

end Rudvalis.SylowOvergroups.TwoCore.Generation.DoubleCosetCover.SeedStabilizerCertificate
