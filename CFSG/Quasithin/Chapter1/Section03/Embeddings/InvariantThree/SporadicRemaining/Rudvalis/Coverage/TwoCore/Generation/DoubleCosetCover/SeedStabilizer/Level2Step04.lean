@[expose] public def r2s4 (x : Fin 4060) : Nat :=
  (r2s4Data[x.val / 64]! >>> (17 * (x.val % 64))) % 131072

@[expose] public def r2s4Cell : List (Fin 4060) := [868]

@[expose] public def r2s4Rows : List Nat := [
]

private theorem r2s4_rows : r2s4Rows = r2s4Cell.map row := by decide +kernel

private theorem r2s4_nodup : r2s4Cell.Nodup := by decide +kernel

private theorem r2s4_facts : ∀ x : Fin 4060,
    (x ∈ r2s4Cell ↔ r2s3 x = 36292) ∧
    r2s4 x = r2s3 x * 2 + bitCount r2s4Rows x := by
  apply allFinBlocks
  intro b
  fin_cases b <;> decide +kernel

public theorem r2s4_preserved (g : Model) (hg : g ∈ seedStabilizer)
    (hf : ∀ x : Fin 4060, x.val < 2 → g • x = x) :
    ∀ x, r2s4 (g • x) = r2s4 x :=
  refine_preserved g.val
    (model_le_relationAut aPerm_mem_relationAut bPerm_mem_relationAut g.property)
    r2s3 r2s4 r2s4Cell 36292 2
    r2s4_nodup (fun x => (r2s4_facts x).1)
    (fun x => ((r2s4_facts x).2).trans
      (congrArg (fun n => r2s3 x * 2 + n)
        (bitCount_eq r2s4Cell r2s4Rows r2s4_rows x)))
    (r2s3_preserved g hg hf)

end Rudvalis.SylowOvergroups.TwoCore.Generation.DoubleCosetCover.SeedStabilizerCertificate
