private theorem r1s3_rows : r1s3Rows = r1s3Cell.map row := by decide +kernel

private theorem r1s3_nodup : r1s3Cell.Nodup := by decide +kernel

private theorem r1s3_facts : ∀ x : Fin 4060,
    (x ∈ r1s3Cell ↔ r1s2 x = 12112) ∧
    r1s3 x = r1s2 x * 13 + bitCount r1s3Rows x := by
  apply allFinBlocks
  intro b
  fin_cases b <;> decide +kernel

public theorem r1s3_preserved (g : Model) (hg : g ∈ seedStabilizer)
    (hf : ∀ x : Fin 4060, x.val < 1 → g • x = x) :
    ∀ x, r1s3 (g • x) = r1s3 x :=
  refine_preserved g.val
    (model_le_relationAut aPerm_mem_relationAut bPerm_mem_relationAut g.property)
    r1s2 r1s3 r1s3Cell 12112 13
    r1s3_nodup (fun x => (r1s3_facts x).1)
    (fun x => ((r1s3_facts x).2).trans
      (congrArg (fun n => r1s2 x * 13 + n)
        (bitCount_eq r1s3Cell r1s3Rows r1s3_rows x)))
    (r1s2_preserved g hg hf)

end Rudvalis.SylowOvergroups.TwoCore.Generation.DoubleCosetCover.SeedStabilizerCertificate
