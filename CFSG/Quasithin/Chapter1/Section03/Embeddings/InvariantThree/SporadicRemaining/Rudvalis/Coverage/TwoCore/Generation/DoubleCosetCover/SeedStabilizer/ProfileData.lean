-- Each case checks one fiber; the local allowance covers the 259 case splits.
set_option maxHeartbeats 800000 in
private theorem profileIds_count : ∀ i : Fin 259,
    profileSize i = profileIds.countP (fun n => n == i.val) := by
  intro i
  fin_cases i <;> decide +kernel

public theorem profileSize_eq (i : Fin 259) :
    profileSize i = vertices.countP (fun x => profileId x == i) := by
  rw [profileIds_count, ← profileIds_eq, List.countP_map]
  apply List.countP_congr
  intro x _
  simp only [Function.comp_apply, beq_iff_eq, Fin.val_inj]

end Rudvalis.SylowOvergroups.TwoCore.Generation.DoubleCosetCover.SeedStabilizerCertificate
