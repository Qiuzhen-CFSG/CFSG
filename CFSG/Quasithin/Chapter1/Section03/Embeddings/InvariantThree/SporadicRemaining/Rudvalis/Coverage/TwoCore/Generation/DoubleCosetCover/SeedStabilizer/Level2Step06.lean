@[expose] public def r2s6 (x : Fin 4060) : Nat :=
  (r2s6Data[x.val / 64]! >>> (19 * (x.val % 64))) % 524288

@[expose] public def r2s6Cell : List (Fin 4060) := [4030]

@[expose] public def r2s6Rows : List Nat := [
]

private theorem r2s6_rows : r2s6Rows = r2s6Cell.map row := by decide +kernel

private theorem r2s6_nodup : r2s6Cell.Nodup := by decide +kernel

private theorem r2s6_facts : ∀ x : Fin 4060,
    (x ∈ r2s6Cell ↔ r2s5 x = 145152) ∧
    r2s6 x = r2s5 x * 2 + bitCount r2s6Rows x := by
  apply allFinBlocks
  intro b
  fin_cases b <;> decide +kernel

public theorem r2s6_preserved (g : Model) (hg : g ∈ seedStabilizer)
    (hf : ∀ x : Fin 4060, x.val < 2 → g • x = x) :
    ∀ x, r2s6 (g • x) = r2s6 x :=
  refine_preserved g.val
    (model_le_relationAut aPerm_mem_relationAut bPerm_mem_relationAut g.property)
    r2s5 r2s6 r2s6Cell 145152 2
    r2s6_nodup (fun x => (r2s6_facts x).1)
    (fun x => ((r2s6_facts x).2).trans
      (congrArg (fun n => r2s5 x * 2 + n)
        (bitCount_eq r2s6Cell r2s6Rows r2s6_rows x)))
    (r2s5_preserved g hg hf)

end Rudvalis.SylowOvergroups.TwoCore.Generation.DoubleCosetCover.SeedStabilizerCertificate
