@[expose] public def r2s3 (x : Fin 4060) : Nat :=
  (r2s3Data[x.val / 64]! >>> (16 * (x.val % 64))) % 65536

@[expose] public def r2s3Cell : List (Fin 4060) := [2434, 3362, 3493, 3577, 3807]

@[expose] public def r2s3Rows : List Nat := [
,
,
,
,
]

private theorem r2s3_rows : r2s3Rows = r2s3Cell.map row := by decide +kernel

private theorem r2s3_nodup : r2s3Cell.Nodup := by decide +kernel

private theorem r2s3_facts : ∀ x : Fin 4060,
    (x ∈ r2s3Cell ↔ r2s2 x = 6075) ∧
    r2s3 x = r2s2 x * 6 + bitCount r2s3Rows x := by
  apply allFinBlocks
  intro b
  fin_cases b <;> decide +kernel

public theorem r2s3_preserved (g : Model) (hg : g ∈ seedStabilizer)
    (hf : ∀ x : Fin 4060, x.val < 2 → g • x = x) :
    ∀ x, r2s3 (g • x) = r2s3 x :=
  refine_preserved g.val
    (model_le_relationAut aPerm_mem_relationAut bPerm_mem_relationAut g.property)
    r2s2 r2s3 r2s3Cell 6075 6
    r2s3_nodup (fun x => (r2s3_facts x).1)
    (fun x => ((r2s3_facts x).2).trans
      (congrArg (fun n => r2s2 x * 6 + n)
        (bitCount_eq r2s3Cell r2s3Rows r2s3_rows x)))
    (r2s2_preserved g hg hf)

end Rudvalis.SylowOvergroups.TwoCore.Generation.DoubleCosetCover.SeedStabilizerCertificate
