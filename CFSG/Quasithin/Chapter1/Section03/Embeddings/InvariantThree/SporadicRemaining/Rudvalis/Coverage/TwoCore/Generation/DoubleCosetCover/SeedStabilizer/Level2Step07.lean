@[expose] public def r2s7 (x : Fin 4060) : Nat :=
  (r2s7Data[x.val / 64]! >>> (20 * (x.val % 64))) % 1048576

@[expose] public def r2s7Cell : List (Fin 4060) := [1130]

@[expose] public def r2s7Rows : List Nat := [
]

private theorem r2s7_rows : r2s7Rows = r2s7Cell.map row := by decide +kernel

private theorem r2s7_nodup : r2s7Cell.Nodup := by decide +kernel

private theorem r2s7_facts : ∀ x : Fin 4060,
    (x ∈ r2s7Cell ↔ r2s6 x = 290306) ∧
    r2s7 x = r2s6 x * 2 + bitCount r2s7Rows x := by
  apply allFinBlocks
  intro b
  fin_cases b <;> decide +kernel

public theorem r2s7_preserved (g : Model) (hg : g ∈ seedStabilizer)
    (hf : ∀ x : Fin 4060, x.val < 2 → g • x = x) :
    ∀ x, r2s7 (g • x) = r2s7 x :=
  refine_preserved g.val
    (model_le_relationAut aPerm_mem_relationAut bPerm_mem_relationAut g.property)
    r2s6 r2s7 r2s7Cell 290306 2
    r2s7_nodup (fun x => (r2s7_facts x).1)
    (fun x => ((r2s7_facts x).2).trans
      (congrArg (fun n => r2s6 x * 2 + n)
        (bitCount_eq r2s7Cell r2s7Rows r2s7_rows x)))
    (r2s6_preserved g hg hf)

end Rudvalis.SylowOvergroups.TwoCore.Generation.DoubleCosetCover.SeedStabilizerCertificate
