/-- The element whose order must be checked, evaluated in the actual carrier. -/
def obstruction (i : Fin 72) : Carrier :=
  evalWord (localGenerator i) (obstructionWords[i.val]!)

/-- The candidate obstruction belongs to every overgroup containing its letters. -/
theorem obstruction_mem (H : Subgroup Carrier) (hS : Seed.s ≤ H)
    (i : Fin 72) (hi : representative i ∈ H) : obstruction i ∈ H := by
  apply evalWord_mem
  intro j
  unfold localGenerator
  split
  · exact hS (Subgroup.subset_closure ⟨_, rfl⟩)
  · exact hi

