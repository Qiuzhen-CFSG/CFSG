theorem transversal_factor (j : Fin 4725) : ∃ (i : Fin 72) (a : Carrier),
    a ∈ Seed.s ∧ transversal j = a * representative i :=
  ⟨_, _, subgroupElement_mem _, rfl⟩

set_option maxRecDepth 100000 in
theorem transversal_key (j : Fin 4725) : cosetKey (transversal j) =
    explicitKey (transversalMap j) := by
  rw [cosetKey_explicit]
  congr 1
  exact funext (transversal_apply j)

end CFSG.Quasithin.Chapter1.XiEmbedding.InvariantThree.SporadicActions.J2Placement.CoverageCertificate
