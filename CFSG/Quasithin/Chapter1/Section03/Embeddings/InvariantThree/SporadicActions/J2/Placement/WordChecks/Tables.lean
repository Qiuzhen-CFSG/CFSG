def repInvMap (i : Fin 72) : Fin 100 → Fin 100 :=
  packedMap (repInvCode i)

theorem rep_left : ∀ i x, repInvMap i (repMap i x) = x := by
  apply allFin
  decide +kernel

def repTable (i : Fin 72) : Equiv.Perm (Fin 100) :=
  tablePerm (repMap i) (repInvMap i) (rep_left i)
    (rightInverse_of_leftInverse_fin (rep_left i))

/-- Evaluate a word as a composition of maps. -/
def wordMap {n : Nat} (gen : Fin n → Fin 100 → Fin 100) :
    List (Fin n) → Fin 100 → Fin 100
  | [], x => x
  | i :: w, x => gen i (wordMap gen w x)

theorem evalWord_apply {n : Nat} (gen : Fin n → Equiv.Perm (Fin 100))
    (maps : Fin n → Fin 100 → Fin 100) (h : ∀ i x, gen i x = maps i x)
    (w : List (Fin n)) (x : Fin 100) :
    evalWord gen w x = wordMap maps w x := by
  induction w with
  | nil => rfl
  | cons i w ih =>
    change gen i (evalWord gen w x) = maps i (wordMap maps w x)
    rw [ih, h]

theorem map_evalWord {G H : Type*} [Group G] [Group H] {n : Nat}
    (f : G →* H) (gen : Fin n → G) (w : List (Fin n)) :
    f (evalWord gen w) = evalWord (fun i => f (gen i)) w := by
  induction w with
  | nil => exact map_one f
  | cons i w ih => simp only [evalWord, map_mul, ih]

theorem localWord_apply (w : List (Fin 3)) (x : Fin 100) :
    inclusion (Seed.localWord w) x = wordMap letterMap w x := by
  unfold Seed.localWord
  rw [map_evalWord]
  apply evalWord_apply
  intro i y
  have h : (fun j => inclusion (![a, b, b⁻¹] j)) =
      ![tableA, tableB, tableB⁻¹] := by
    funext j
    fin_cases j <;> simp [a, b, inclusion, generatorA_eq_table, generatorB_eq_table]
  rw [congrFun h i]
  exact (by decide +kernel : ∀ j z, (![tableA, tableB, tableB⁻¹] j) z = letterMap j z) i y

theorem s_words : ∀ i x, wordMap letterMap (Seed.sWords i) x = sMap i x := by
  apply allFin
  decide +kernel

theorem q_words : ∀ i x, wordMap letterMap (Seed.q₂Words i) x = qMap i x := by
  apply allFin
  decide +kernel

theorem rep_words : ∀ i : Fin 72, ∀ x,
    wordMap letterMap (representativeWords[i.val]!) x = repMap i x := by
  apply allFin
  decide +kernel

theorem s_eq (i : Fin 7) : inclusion (Seed.sGenerator i) = sTable i := by
  apply Equiv.ext
  intro x
  exact (localWord_apply (Seed.sWords i) x).trans (s_words i x)

theorem q_eq (i : Fin 6) : inclusion (Seed.q₂Generator i) = qTable i := by
  apply Equiv.ext
  intro x
  exact (localWord_apply (Seed.q₂Words i) x).trans (q_words i x)

theorem rep_eq (i : Fin 72) : inclusion (representative i) = repTable i := by
  apply Equiv.ext
  intro x
  exact (localWord_apply (representativeWords[i.val]!) x).trans (rep_words i x)

