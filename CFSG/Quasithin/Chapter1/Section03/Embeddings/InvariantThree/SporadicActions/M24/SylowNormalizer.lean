module

public import CFSG.Quasithin.Chapter1.Section03.Embeddings.InvariantThree.SporadicActions.M24.LocalData
public import Theory.Mathieu.M24.LocalGeometry.SylowNormalizer.Automorphisms
public import Theory.Mathieu.M24.LocalGeometry.SylowNormalizer.Order
public import Theory.Mathieu.M24.LocalGeometry.SylowNormalizer.Reduction

/-!
# Self-normalizing Sylow two-subgroups of M₂₄

The subgroup generated by four explicitly marked Witt-design automorphisms
has order 1024 and a two-group automorphism group. Its centralizer is also a
two-group, so the intrinsic reduction makes this Sylow subgroup self-normalizing.
Sylow conjugacy transports the result to every Sylow two-subgroup of the actual
M₂₄ carrier. Both local computations are discharged in `sylowNormalizerControl`.

Source: Aschbacher–Smith, printed p.511 (PDF p.528), and GLS3, Table 5.3e.
-/

public section
namespace CFSG.Quasithin.Chapter1.XiEmbedding.InvariantThree.SporadicActions.M24PairAction

open Sporadic.Mathieu.M24LocalGeometry.SylowNormalizer

/-- The order and automorphism-group computations suffice for normalizer control. -/
theorem sylowNormalizerControl_of_card_of_aut
    (hcard : Nat.card candidate = 1024) (haut : IsPGroup 2 (MulAut candidate)) :
    SylowNormalizerControl :=
  sylow_normalizer_le hcard haut

/-- Every Sylow two-subgroup of the Witt-design M₂₄ is self-normalizing. -/
theorem sylowNormalizerControl : SylowNormalizerControl :=
  sylowNormalizerControl_of_card_of_aut candidate_card
    (candidate_automorphisms_isPGroup candidate_card)

end CFSG.Quasithin.Chapter1.XiEmbedding.InvariantThree.SporadicActions.M24PairAction
