module

public import CFSG.Quasithin.Chapter1.Section03.Embeddings.InvariantThree.SporadicActions.J4.PairActions.Overgroups
public import Theory.SpecificGroups.Janko4.Model.AutomorphismReduction.FirstGenerator.OddIndex.SylowCandidate

/-!
# Fixing the Sylow subgroup in the J₄ overgroup calculation

The subgroup `Janko4.OuterReduction.OddIndex.twoSubgroup` is the specified
order-2²¹ subgroup generated by fifteen certified matrix words. Its ambient
Sylow property follows from odd index of the literal max1 subgroup. Once
that property holds, Sylow conjugacy reduces arbitrary-pair coverage to
coverage with this fixed two-subgroup.

Transport retains every `PairInput` hypothesis, including setwise
permutability and both alternatives for the odd complement. Pullback of an
overgroup transports its actual multiplicative equivalence to max4.
Neither the ambient odd-index assertion nor fixed-subgroup coverage is
proved here. They are independent inputs to the conditional assembly.

Source: Aschbacher–Smith, proof of Proposition 1.3.4, printed p.511
(PDF p.528 of `refs/quasithin.pdf`), citing Aschbacher's *Overgroups of Sylow
subgroups in sporadic groups* (1986). The fixed two-subgroup's matrix-word
provenance and order certificate are in `OddIndex.SylowCandidate`.
-/

@[expose] public section

open Subgroup
open Janko4.LocalStructure.SymmetricLinear
open Janko4.OuterReduction.OddIndex Janko4.Cardinality

namespace CFSG.Quasithin.Chapter1.XiEmbedding.InvariantThree.SporadicActions.J4Reduction

/-- The remaining incidence calculation at the specified two-subgroup.
The ambient Sylow witness is an explicit input, so this calculation does
not require the separate odd-index certificate to be available first. -/
def FixedTwoSubgroupPairCoverage : Prop :=
  ∀ [Finite Janko4.Model] [IsSimpleGroup Janko4.Model] [Group.IsPerfect Janko4.Model]
    (S : Sylow 2 Janko4.Model), (S : Subgroup Janko4.Model) = twoSubgroup →
    ∀ R : Subgroup Janko4.Model, PairInput S R →
      Nonempty (PairOvergroups twoSubgroup R)

/-- Pull back an actual overgroup and its isomorphism along an ambient automorphism. -/
theorem pairOvergroups_nonempty_of_map (e : MulAut Janko4.Model)
    (S R : Subgroup Janko4.Model)
    (h : Nonempty (PairOvergroups (S.map e.toMonoidHom) (R.map e.toMonoidHom))) :
    Nonempty (PairOvergroups S R) := by
  obtain ⟨M, hS, hR, ⟨f⟩⟩ := h
  refine ⟨⟨M.map e.symm.toMonoidHom, ?_, ?_,
    ⟨(e.symm.subgroupMap M).symm.trans f⟩⟩⟩
  · intro x hx
    exact ⟨e x, hS (mem_map_of_mem _ hx), e.symm_apply_apply x⟩
  · intro x hx
    exact ⟨e x, hR (mem_map_of_mem _ hx), e.symm_apply_apply x⟩

/-- Coverage at one genuine Sylow subgroup implies coverage at every Sylow subgroup. -/
theorem pairCoverage_of_one_sylow [Finite Janko4.Model] (T : Sylow 2 Janko4.Model)
    (hT : ∀ R : Subgroup Janko4.Model, PairInput T R →
      Nonempty (PairOvergroups (T : Subgroup Janko4.Model) R))
    (S : Sylow 2 Janko4.Model) (R : Subgroup Janko4.Model) (h : PairInput S R) :
    Nonempty (PairOvergroups (S : Subgroup Janko4.Model) R) := by
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq Janko4.Model S T
  let e := MulAut.conj g
  have hh := pairInput_map e h
  have hmap : S.mapSurjective (f := e.toMonoidHom) e.surjective = T := by
    apply Sylow.ext
    change (g • S : Sylow 2 Janko4.Model).toSubgroup = T.toSubgroup
    rw [hg]
  rw [hmap] at hh
  have he : (S : Subgroup Janko4.Model).map e.toMonoidHom =
      (T : Subgroup Janko4.Model) := congrArg Sylow.toSubgroup hmap
  apply pairOvergroups_nonempty_of_map e
  rw [he]
  exact hT _ hh

/-- The certified odd local index transfers max1's ambient odd index to
the fixed order-2²¹ subgroup. -/
theorem twoSubgroup_odd_index_of_max1
    (hi : ¬ 2 ∣ (max1Subgroup Janko4.matrixA_mul_self Janko4.matrixB_pow_four).index) :
    ¬ 2 ∣ twoSubgroup.index := by
  have he := relIndex_mul_index twoSubgroup_le
  rw [twoSubgroup_relIndex] at he
  rw [← he]
  simp only [Nat.prime_two.dvd_mul, show ¬ 2 ∣ 239085 by decide, false_or]
  exact hi

end CFSG.Quasithin.Chapter1.XiEmbedding.InvariantThree.SporadicActions.J4Reduction
