module

public import CFSG.Quasithin.Chapter1.Section03.Embeddings.InvariantThree.SporadicActions.J4.PairActions.Coverage.FixedTwoSubgroup.Elementary.Reduction
public import Theory.SpecificGroups.Janko4.Model.AutomorphismReduction.FixedGenerator.NormalizerSquares.LocalAction.TwoCoreCentralizer.Generation.Conjugacy

/-!
# Quotient reduction for elementary pairs in the J₄ involution centralizer

Let H be the subgroup generated by the original ATLAS max2 words, and
Q = O₂(H). An ambient Sylow two-subgroup contained in H contains Q. Thus
the pair product is the full preimage of its image in H/Q. The elementary
group of order nine injects into this quotient, and setwise permutability
survives both restriction to H and passage to H/Q.

The remaining incidence contract asks for an actual max4 conjugate whose
intersection with H contains Q and covers the quotient pair. Lifting then
places the original pair. It does not assume normalization of either member
of the pair. Nor does it identify H with a centralizer: that requires the
separate full-generation theorem and its certified conjugacy bridge.

Source context: Aschbacher–Smith, proof of Proposition 1.3.4, printed p.511
(PDF p.528 of `refs/quasithin.pdf`), citing Aschbacher, *Overgroups of Sylow
subgroups in sporadic groups* (1986); GLS3, Table 5.3i, printed p.270.
The quotient below is the literal quotient of the matrix subgroup, with
no unproved identification with a named group.
-/

@[expose] public section

open Subgroup
open scoped Pointwise
open Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreCentralizerData
open Janko4.LocalStructure.SymmetricLinear

namespace CFSG.Quasithin.Chapter1.XiEmbedding.InvariantThree.SporadicActions.J4Reduction

attribute [local irreducible] Janko4.modelGroup max4Subgroup

/-- The actual two-core quotient of the original ATLAS max2 word subgroup. -/
abbrev InvolutionSourceQuotient := sourceSubgroup ⧸ pCore 2 sourceSubgroup

/-- The canonical quotient map, with its actual kernel. -/
def involutionSourceQuotientMap : sourceSubgroup →* InvolutionSourceQuotient :=
  QuotientGroup.mk' (pCore 2 sourceSubgroup)

/-- Restrict an ambient subgroup to the word subgroup, then take its image. -/
def involutionSourceQuotientImage (K : Subgroup Janko4.Model) :
    Subgroup InvolutionSourceQuotient :=
  (K.subgroupOf sourceSubgroup).map involutionSourceQuotientMap

/-- The intersection with an actual max4 conjugate, viewed inside max2. -/
def involutionSourceMax4Overlap (g : Janko4.Model) : Subgroup sourceSubgroup :=
  (max4Subgroup.map (MulAut.conj g).toMonoidHom).subgroupOf sourceSubgroup

/-- Ambient Sylow maximality already puts the entire local two-core in S. -/
theorem involutionSource_twoCore_le_sylow (S : Sylow 2 Janko4.Model)
    (hS : (S : Subgroup Janko4.Model) ≤ sourceSubgroup) :
    pCore 2 sourceSubgroup ≤ (S : Subgroup Janko4.Model).subgroupOf sourceSubgroup :=
  pCore_isPGroup.le_sylow_of_normal (S.subtype hS)

/-- The pair product is recovered exactly from its quotient image. -/
theorem involutionSource_pair_preimage (S : Sylow 2 Janko4.Model)
    (R : Subgroup Janko4.Model)
    (hS : (S : Subgroup Janko4.Model) ≤ sourceSubgroup) (hR : R ≤ sourceSubgroup) :
    ((involutionSourceQuotientImage (R ⊔ (S : Subgroup Janko4.Model))).comap
      involutionSourceQuotientMap).map sourceSubgroup.subtype =
        R ⊔ (S : Subgroup Janko4.Model) := by
  have hcore : pCore 2 sourceSubgroup ≤
      (R ⊔ (S : Subgroup Janko4.Model)).subgroupOf sourceSubgroup :=
    (involutionSource_twoCore_le_sylow S hS).trans (comap_mono le_sup_right)
  rw [involutionSourceQuotientImage, comap_map_eq_self
    (by simpa only [involutionSourceQuotientMap, QuotientGroup.ker_mk'] using hcore),
    map_subgroupOf_eq_of_le (sup_le hR hS)]

/-- The odd complement meets the local two-core trivially, so no element
of the complement is lost on passing to the quotient. -/
theorem involutionSource_complement_injective {R : Subgroup Janko4.Model}
    (hR : R ≤ sourceSubgroup) (hE : IsElementaryAbelian 3 R) :
    Function.Injective (involutionSourceQuotientMap.comp (inclusion hR)) := by
  let _ := hE
  have hd : Disjoint (R.subgroupOf sourceSubgroup) (pCore 2 sourceSubgroup) :=
    IsPGroup.disjoint_of_coprime
      ((IsElementaryAbelian.isPGroup 3 R).of_equiv (subgroupOfEquivOfLe hR).symm)
      pCore_isPGroup (by decide : Nat.Coprime 3 2)
  apply (MonoidHom.ker_eq_bot_iff _).mp
  apply eq_bot_iff.mpr
  intro r hr
  have hi : inclusion hR r ∈ pCore 2 sourceSubgroup :=
    (QuotientGroup.eq_one_iff (inclusion hR r)).mp hr
  have hr1 := disjoint_def.mp hd r.property hi
  exact mem_bot.mpr ((inclusion_injective hR)
    (by simpa only [map_one] using hr1))

/-- Explicitly identify the complement with its quotient image. -/
noncomputable def involutionSourceComplementEquiv {R : Subgroup Janko4.Model}
    (hR : R ≤ sourceSubgroup) (hE : IsElementaryAbelian 3 R) :
    R ≃* involutionSourceQuotientImage R :=
  (MonoidHom.ofInjective (involutionSource_complement_injective hR hE)).trans
      (MulEquiv.subgroupCongr (by
        rw [MonoidHom.range_comp, inclusion_range]
        rfl))

/-- The quotient complement is still elementary abelian. -/
theorem involutionSource_quotient_elementary {R : Subgroup Janko4.Model}
    (hR : R ≤ sourceSubgroup) (hE : IsElementaryAbelian 3 R) :
    IsElementaryAbelian 3 (involutionSourceQuotientImage R) := by
  let _ : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  let _ := hE
  let _ := IsElementaryAbelian.subgroupOf (p := 3) hR
  exact IsElementaryAbelian.map involutionSourceQuotientMap

/-- In particular, the elementary order-nine hypothesis survives the quotient. -/
theorem involutionSource_quotient_card {R : Subgroup Janko4.Model}
    (hR : R ≤ sourceSubgroup) (hE : IsElementaryAbelian 3 R)
    (hcard : Nat.card R = 3 ^ 2) :
    Nat.card (involutionSourceQuotientImage R) = 3 ^ 2 :=
  (Nat.card_congr (involutionSourceComplementEquiv hR hE).toEquiv).symm.trans hcard

/-- The image of S is a genuine Sylow subgroup of the quotient. -/
def involutionSourceQuotientSylow (S : Sylow 2 Janko4.Model)
    (hS : (S : Subgroup Janko4.Model) ≤ sourceSubgroup) :
    Sylow 2 InvolutionSourceQuotient :=
  (S.subtype hS).mapSurjective (QuotientGroup.mk'_surjective (pCore 2 sourceSubgroup))

theorem involutionSourceQuotientSylow_coe (S : Sylow 2 Janko4.Model)
    (hS : (S : Subgroup Janko4.Model) ≤ sourceSubgroup) :
    (involutionSourceQuotientSylow S hS : Subgroup InvolutionSourceQuotient) =
      involutionSourceQuotientImage (S : Subgroup Janko4.Model) := rfl

/-- Restriction and quotient preserve the source's setwise permutability;
neither operation replaces it by a normalization assumption. -/
theorem involutionSource_quotient_permutes (S : Sylow 2 Janko4.Model)
    (R : Subgroup Janko4.Model) (h : PairInput S R)
    (hS : (S : Subgroup Janko4.Model) ≤ sourceSubgroup) (hR : R ≤ sourceSubgroup) :
    (involutionSourceQuotientImage R : Set InvolutionSourceQuotient) *
        (involutionSourceQuotientImage (S : Subgroup Janko4.Model) : Set _) =
      (involutionSourceQuotientImage (S : Subgroup Janko4.Model) : Set _) *
        (involutionSourceQuotientImage R : Set _) := by
  have hp : (R.subgroupOf sourceSubgroup : Set sourceSubgroup) *
        ((S : Subgroup Janko4.Model).subgroupOf sourceSubgroup : Set sourceSubgroup) =
      ((S : Subgroup Janko4.Model).subgroupOf sourceSubgroup : Set sourceSubgroup) *
        (R.subgroupOf sourceSubgroup : Set sourceSubgroup) := by
    apply Set.image_injective.mpr sourceSubgroup.subtype_injective
    simpa only [Set.image_mul, ← coe_map, map_subgroupOf_eq_of_le hR,
      map_subgroupOf_eq_of_le hS, Sylow.coe_coe] using h.permutes
  simpa only [involutionSourceQuotientImage, coe_map, Set.image_mul] using
    congrArg (Set.image involutionSourceQuotientMap) hp

/-- Lift containment from the quotient, retaining the essential assertion that
the entire local two-core belongs to the chosen max4 overlap. -/
theorem involutionSource_pair_le_max4_of_quotient (S : Sylow 2 Janko4.Model)
    (R : Subgroup Janko4.Model)
    (hS : (S : Subgroup Janko4.Model) ≤ sourceSubgroup) (hR : R ≤ sourceSubgroup)
    (g : Janko4.Model)
    (hcore : pCore 2 sourceSubgroup ≤ involutionSourceMax4Overlap g)
    (himage : involutionSourceQuotientImage (R ⊔ (S : Subgroup Janko4.Model)) ≤
      (involutionSourceMax4Overlap g).map involutionSourceQuotientMap) :
    (S : Subgroup Janko4.Model) ≤ max4Subgroup.map (MulAut.conj g).toMonoidHom ∧
      R ≤ max4Subgroup.map (MulAut.conj g).toMonoidHom := by
  have hp := comap_mono (f := involutionSourceQuotientMap) himage
  rw [comap_map_eq_self
    (by simpa only [involutionSourceQuotientMap, QuotientGroup.ker_mk'] using hcore)] at hp
  have hm := map_mono (f := sourceSubgroup.subtype) hp
  rw [involutionSource_pair_preimage S R hS hR] at hm
  have hle : R ⊔ (S : Subgroup Janko4.Model) ≤
      max4Subgroup.map (MulAut.conj g).toMonoidHom := by
    rw [involutionSourceMax4Overlap, subgroupOf_map_subtype] at hm
    exact hm.trans inf_le_left
  exact ⟨le_sup_right.trans hle, le_sup_left.trans hle⟩

/-- The remaining local incidence calculation. All source hypotheses are
retained. The overlap is an actual ambient intersection, and its two-core
containment is a proof obligation independent of containment of quotient images. -/
def ElementaryInvolutionQuotientIncidence : Prop :=
  ∀ [Finite Janko4.Model] [IsSimpleGroup Janko4.Model] [Group.IsPerfect Janko4.Model]
    (S : Sylow 2 Janko4.Model) (R : Subgroup Janko4.Model), PairInput S R →
      IsElementaryAbelian 3 R → Nat.card R = 3 ^ 2 →
      (S : Subgroup Janko4.Model) ≤ sourceSubgroup → R ≤ sourceSubgroup →
      ∃ g : Janko4.Model,
        pCore 2 sourceSubgroup ≤ involutionSourceMax4Overlap g ∧
        involutionSourceQuotientImage (R ⊔ (S : Subgroup Janko4.Model)) ≤
          (involutionSourceMax4Overlap g).map involutionSourceQuotientMap

end CFSG.Quasithin.Chapter1.XiEmbedding.InvariantThree.SporadicActions.J4Reduction
