private theorem representative_trace_check : ∀ i,
    (traceCheck 2148 (representativeInstructions i) (representativeTraces i).1 (rootCodes i).1.toNat = true ∧
      traceCheck 2163 (representativeInstructions i) (representativeTraces i).2 (rootCodes i).2.toNat = true) ∨
    (traceCheck 2148 (representativeInstructions i) (representativeTraces i).1 (rootCodes i).2.toNat = true ∧
      traceCheck 2163 (representativeInstructions i) (representativeTraces i).2 (rootCodes i).1.toNat = true) := by
  apply forall_fin_of_range
  decide +kernel

private theorem representative_rows_check (i : Fin 110) :
    (run 2148 (representativeInstructions i) = (rootCodes i).1.toNat ∧
      run 2163 (representativeInstructions i) = (rootCodes i).2.toNat) ∨
    (run 2148 (representativeInstructions i) = (rootCodes i).2.toNat ∧
      run 2163 (representativeInstructions i) = (rootCodes i).1.toNat) := by
  rcases representative_trace_check i with ⟨h1,h2⟩ | ⟨h1,h2⟩
  · exact Or.inl ⟨run_eq_of_trace h1, run_eq_of_trace h2⟩
  · exact Or.inr ⟨run_eq_of_trace h1, run_eq_of_trace h2⟩

theorem representative_pair (i : Fin 110) :
