def xRows : Vector ℕ 12 := #v[2533,3688,2585,58,3283,649,4075,1447,616,3160,2130,2384]
def yRows : Vector ℕ 12 := #v[895,124,359,4005,2616,2695,1446,24,2224,645,4013,2327]
def yiRows : Vector ℕ 12 := #v[749,3035,1525,1032,1160,2542,3225,1437,2480,133,2989,2555]
def originalRows (z : Bool × ℤ) : Vector ℕ 12 :=
  if z.1 then if z.2 = 1 then yRows else yiRows else xRows

def original (z : Bool × ℤ) : A :=
  (if z.1 then (⟨quotientY, quotientY_mem⟩ : A) else ⟨quotientX, quotientX_mem⟩) ^ z.2

def Signed (w : List (Bool × ℤ)) : Prop := ∀ z ∈ w, z.2 = 1 ∨ z.2 = -1
instance (w : List (Bool × ℤ)) : Decidable (Signed w) :=
  inferInstanceAs (Decidable (∀ z ∈ w, z.2 = 1 ∨ z.2 = -1))

theorem original_val (z : Bool × ℤ) (hz : z.2 = 1 ∨ z.2 = -1) :
    (original z).val.val = quotientDecode (originalRows z) := by
  rcases z with ⟨b,e⟩
  rcases hz with rfl | rfl
  · simp only [original, zpow_one]
    cases b <;> rfl
  · simp only [original, zpow_neg_one]
    cases b <;> rfl

def run (v : ℕ) : List (Bool × ℤ) → ℕ
  | [] => v
  | z :: w => run (packedRow v (originalRows z)) w

def nrow (n : ℕ) : Row := fun j => bit n j.val

theorem evaluate_cons (z : Bool × ℤ) (w : List (Bool × ℤ)) :
    evaluate (z :: w) = original z * evaluate w := rfl

theorem run_spec (w : List (Bool × ℤ)) (hs : Signed w) (n : ℕ) :
    nrow (run n w) = right (nrow n) (evaluate w).val := by
  induction w generalizing n with
  | nil => exact (right_one _).symm
  | cons z w ih =>
    have hz := hs z (by simp)
    have hw : Signed w := fun a ha => hs a (List.mem_cons_of_mem _ ha)
    rw [run, ih hw, evaluate_cons]
    change right (nrow (packedRow n (originalRows z))) (evaluate w).val =
      right (nrow n) ((original z).val * (evaluate w).val)
    rw [right_mul]
    congr 1
    funext j
    change bit (packedRow n (originalRows z)) j.val =
      Matrix.vecMul (nrow n) (original z).val.val j
    rw [original_val z hz]
    exact packedRow_spec n (originalRows z) j

def traceCheck (v : ℕ) (w : List (Bool × ℤ)) (steps : List ℕ) (out : ℕ) : Bool :=
  match w, steps with
  | [], [] => v == out
  | z :: w, r :: rs => (packedRow v (originalRows z) == r) && traceCheck r w rs out
  | _, _ => false

theorem run_eq_of_trace {v out : ℕ} {w : List (Bool × ℤ)} {steps : List ℕ}
    (h : traceCheck v w steps out = true) : run v w = out := by
  induction w generalizing v steps with
  | nil =>
    cases steps with
    | nil => exact of_decide_eq_true h
    | cons r rs => simp [traceCheck] at h
  | cons z w ih =>
    cases steps with
    | nil => simp [traceCheck] at h
    | cons r rs =>
      simp only [traceCheck, Bool.and_eq_true, beq_iff_eq] at h
      rw [run, h.1]
      exact ih h.2

attribute [local irreducible] run

private theorem basis : ∀ i : Fin 12, nrow (2 ^ i.val) = (1 : QuotientMatrix) i := by
  have h : ∀ i j : Fin 12, nrow (2 ^ i.val) j = (1 : QuotientMatrix) i j := by
    simp only [nrow, bit, Matrix.one_apply]
    decide +kernel
  intro i
  funext j
  exact h i j

theorem evaluate_val (w : List (Bool × ℤ)) (hs : Signed w) (rows : Vector ℕ 12)
    (hr : ∀ i : Fin 12, run (2 ^ i.val) w = rows.get i) :
    (evaluate w).val.val = quotientDecode rows := by
  funext i j
  have h := run_spec w hs (2 ^ i.val)
  rw [hr i, basis i] at h
  have hj := congrFun h j
  change bit (rows.get i) j.val = ((1 : QuotientMatrix) * (evaluate w).val.val) i j at hj
  simpa only [Matrix.one_mul, quotientDecode, bit] using hj.symm

theorem word_pair (w : List (Bool × ℤ)) (hs : Signed w) (p q : Code)
    (h : (run p.1.toNat w = q.1.toNat ∧ run p.2.toNat w = q.2.toNat) ∨
      (run p.1.toNat w = q.2.toNat ∧ run p.2.toNat w = q.1.toNat)) :
    pairRight (point p) (evaluate w) = point q := by
  have h1 := (run_spec w hs p.1.toNat).symm
  have h2 := (run_spec w hs p.2.toNat).symm
  change right (row p.1) (evaluate w).val = nrow (run p.1.toNat w) at h1
  change right (row p.2) (evaluate w).val = nrow (run p.2.toNat w) at h2
  change s(right (row p.1) (evaluate w).val, right (row p.2) (evaluate w).val) = _
  rw [h1,h2]
  rcases h with ⟨h1,h2⟩ | ⟨h1,h2⟩
  · rw [h1,h2]
    rfl
  · rw [h1,h2]
    exact Sym2.eq_swap



