private theorem sylow_trace_check : ∀ i k,
    traceCheck (2 ^ k.val) (sylowInstructions i) (sylowTraces i k) ((sylowRows i).get k) = true := by
  apply forall_fin_of_range
  decide +kernel

private theorem sylow_rows_check (i : Fin 4) (k : Fin 12) :
    run (2 ^ k.val) (sylowInstructions i) = (sylowRows i).get k :=
  run_eq_of_trace (sylow_trace_check i k)

theorem sylowGenerator_val (i : Fin 4) :
    (sylowGenerator i).val.val = quotientDecode (sylowRows i) :=
  evaluate_val _ (sylow_signed i) _ (sylow_rows_check i)

private theorem sylow_fix_check : ∀ i, Step (2148,2163) (2148,2163) (sylowRows i) := by
  apply forall_fin_of_range
  decide +kernel

theorem base_fixes : baseSubgroup ≤ fixer := by
  apply (baseSubgroup_le_iff fixer).mpr
  intro i
