module

public import CFSG.Quasithin.Chapter1.Section03.Embeddings.InvariantThree.SporadicActions.J4.PairActions.Coverage.FixedTwoSubgroup.Extraspecial.QuotientExclusion.ActionImage.Frattini
public import CFSG.Quasithin.Chapter1.Section03.Embeddings.InvariantThree.SporadicActions.J4.PairActions.Coverage.FixedTwoSubgroup.Extraspecial.QuotientExclusion.ActionImage.Candidates.Data
public import CFSG.Quasithin.Chapter1.Section03.Embeddings.InvariantThree.SporadicActions.J4.PairActions.Coverage.FixedTwoSubgroup.Extraspecial.QuotientExclusion.ActionImage.Candidates.Words

/-!
# Concrete candidates for the remaining large J₄ conjugation images

All candidates are subgroups of the original `Janko4.Model`, generated by
explicit words in the specified two-subgroup. The remaining independent
obligations are coverage outside the proved small-Frattini-quotient branch,
and the three-part bound for each candidate's actual normalizer action.

The candidate lists arose from an exploratory GAP census. This module
certifies their containment in the actual two-subgroup, but does not assume
that the census is complete or that its reported ranks are correct. The
coverage contract explicitly requests the missing mathematical proof.
Source context: Aschbacher–Smith 1.3.4, printed p.511/PDF p.528, citing
Aschbacher's Sylow-overgroup analysis (1986).
-/

@[expose] public section

open Subgroup
open Janko4.OuterReduction.OddIndex

namespace CFSG.Quasithin.Chapter1.XiEmbedding.InvariantThree.SporadicActions.J4Reduction

namespace ActionImageCandidates

/-- Each candidate uses the actual subgroup operations, not an abstract group tag. -/
noncomputable def candidate (i : Fin 193) : Subgroup Janko4.Model :=
  (Subgroup.closure (product '' {m | m ∈ generatorMasks i})).map twoSubgroup.subtype

theorem candidate_le (i : Fin 193) : candidate i ≤ twoSubgroup := map_subtype_le _

end ActionImageCandidates

/-- Only candidates outside the already proved small-Frattini branch need a census. -/
def FixedTwoLargeFrattiniCandidateCoverage : Prop :=
  ∀ K : Subgroup Janko4.Model, K ≤ twoSubgroup →
    twoSubgroup ≤ normalizer (K : Set Janko4.Model) →
    K.relIndex twoSubgroup ≤ 32 →
    Nat.card (K ⧸ frattini K) ≤ 32 ∨
      ∃ i : Fin 193, ActionImageCandidates.candidate i = K

/-- The finite candidate problem retains the actual ambient normalizer action.
The inherited radical and Sylow hypotheses remain available to its proof. -/
def FixedTwoCandidateFrattiniThreePartBound : Prop :=
  ∀ [Finite Janko4.Model] [IsSimpleGroup Janko4.Model] [Group.IsPerfect Janko4.Model]
    (S : Sylow 2 Janko4.Model), (S : Subgroup Janko4.Model) = twoSubgroup →
    ∀ i : Fin 193,
      twoSubgroup ≤ normalizer (ActionImageCandidates.candidate i : Set Janko4.Model) →
      (ActionImageCandidates.candidate i).relIndex twoSubgroup ≤ 32 →
      (ActionImageCandidates.candidate i).IsPRadical 2 →
      ¬ 27 ∣ Nat.card (fixedTwoFrattiniAction (ActionImageCandidates.candidate i)).range

end CFSG.Quasithin.Chapter1.XiEmbedding.InvariantThree.SporadicActions.J4Reduction
