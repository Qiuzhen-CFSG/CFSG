module

public import CFSG.Quasithin.Chapter1.Section03.Embeddings.InvariantThree.SporadicActions.J4.PairActions.Coverage.FixedTwoSubgroup.Elementary.InvolutionAbsorption.QuotientIncidence.Geometry

/-!
# Word lifts for the second max2 quotient candidate

The displayed words in the matrix quotient can be evaluated in the original
ATLAS max2 generators. Their images are exactly the second candidate generators.
Consequently the candidate's full inverse image is the join of these word lifts
and O₂(H). This reduces its placement to containment of the actual two-core and
three explicit elements, without confusing representatives with a full preimage.

Source context: Aschbacher–Smith, Proposition 1.3.4, printed p.511 of
`refs/quasithin.pdf`, and its reference [Asc86b]. The words and the proved
matrix-quotient comparison are in the imported `Geometry` module.
-/

@[expose] public section

open Subgroup
open Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreCentralizerData

namespace CFSG.Quasithin.Chapter1.XiEmbedding.InvariantThree.SporadicActions.J4Reduction

attribute [local irreducible] Janko4.modelGroup

/-- The thirteen certified core generators, transported back to the original
ATLAS max2 subgroup by the proved conjugacy equivalence. -/
noncomputable def involutionSourceCoreGenerator (i : Fin 13) : sourceSubgroup :=
  sourceSubgroupEquivLocal.symm (NormalClosureControl.basis i)

/-- The transported generator is the explicit original-model word obtained
by undoing the certified max2 conjugacy. -/
theorem involutionSourceCoreGenerator_coe (i : Fin 13) :
    (involutionSourceCoreGenerator i : Janko4.Model) =
      NormalClosureControl.unconjugate (NormalClosureControl.basis i) := by
  have he := sourceSubgroupEquivLocal_apply (involutionSourceCoreGenerator i)
  change centralizerToModel (sourceSubgroupEquivLocal
    (sourceSubgroupEquivLocal.symm (NormalClosureControl.basis i))) = _ at he
  rw [MulEquiv.apply_symm_apply] at he
  calc
    (involutionSourceCoreGenerator i : Janko4.Model) =
        h * (h⁻¹ * (involutionSourceCoreGenerator i : Janko4.Model) * h) * h⁻¹ := by
          simp only [mul_assoc, mul_inv_cancel_left, mul_inv_cancel, mul_one]
    _ = h * centralizerToModel (NormalClosureControl.basis i) * h⁻¹ := by rw [← he]
    _ = NormalClosureControl.unconjugate (NormalClosureControl.basis i) := rfl

/-- These thirteen source elements generate the actual two-core. -/
theorem involutionSource_twoCore_eq_closure :
    pCore 2 sourceSubgroup = closure (Set.range involutionSourceCoreGenerator) := by
  apply map_injective (f := sourceSubgroupEquivLocal.toMonoidHom)
    sourceSubgroupEquivLocal.injective
  rw [pCore_map_iso, ← involutionLocal_normalClosure_eq_twoCore,
    localNormalClosure_eq_span, MonoidHom.map_closure, ← Set.range_comp]
  simp only [Function.comp_def, MulEquiv.coe_toMonoidHom,
    involutionSourceCoreGenerator, MulEquiv.apply_symm_apply]
  rfl

/-- Core containment is a finite list of memberships, retaining every core
factor rather than only representatives of quotient elements. -/
theorem involutionSource_twoCore_le_iff (K : Subgroup sourceSubgroup) :
    pCore 2 sourceSubgroup ≤ K ↔
      ∀ i : Fin 13, involutionSourceCoreGenerator i ∈ K := by
  rw [involutionSource_twoCore_eq_closure, closure_le, Set.range_subset_iff]
  rfl

/-- Evaluating a displayed word commutes with any group homomorphism. -/
theorem involutionSecondWord_map {G A : Type*} [Group G] [Group A]
    (f : G →* A) (x y : G) (i : Fin 3) :
    f (involutionSecondWord x y i) = involutionSecondWord (f x) (f y) i := by
  simp only [involutionSecondWord, map_list_prod, List.map_map]
  congr 2
  funext z
  simp only [Function.comp_apply, map_zpow]
  split <;> rfl

/-- The three words evaluated in the literal original max2 subgroup. -/
def involutionSourceSecondGenerator (i : Fin 3) : sourceSubgroup :=
  involutionSecondWord LowerBound.sourceX LowerBound.sourceY i

/-- The subgroup generated by these actual source lifts. -/
def involutionSourceSecondSubgroup : Subgroup sourceSubgroup :=
  closure (Set.range involutionSourceSecondGenerator)

/-- Each chosen source word maps to the corresponding quotient generator. -/
@[simp] theorem involutionSourceMatrixMap_secondGenerator (i : Fin 3) :
    involutionSourceMatrixMap (involutionSourceSecondGenerator i) =
      involutionMatrixSecondGenerator i := by
  have hx : involutionSourceMatrixMap LowerBound.sourceX =
      (⟨LowerBound.quotientX, LowerBound.quotientX_mem⟩ : LowerBound.quotientSubgroup) :=
    Subtype.ext LowerBound.quotientMap_sourceX
  have hy : involutionSourceMatrixMap LowerBound.sourceY =
      (⟨LowerBound.quotientY, LowerBound.quotientY_mem⟩ : LowerBound.quotientSubgroup) :=
    Subtype.ext LowerBound.quotientMap_sourceY
  rw [involutionSourceSecondGenerator, involutionSecondWord_map, hx, hy]
  rfl

/-- The images of the lifted words generate precisely the second candidate. -/
theorem involutionSourceMatrixMap_secondSubgroup :
    involutionSourceSecondSubgroup.map involutionSourceMatrixMap =
      involutionMatrixSecondSubgroup := by
  rw [involutionSourceSecondSubgroup, MonoidHom.map_closure, ← Set.range_comp]
  simp only [Function.comp_def, involutionSourceMatrixMap_secondGenerator,
    involutionMatrixSecondSubgroup]

/-- The full inverse image retains the entire two-core as well as the word lifts. -/
theorem involutionMatrixSecondSubgroup_preimage :
    involutionMatrixSecondSubgroup.comap involutionSourceMatrixMap =
      pCore 2 sourceSubgroup ⊔ involutionSourceSecondSubgroup := by
  rw [← involutionSourceMatrixMap_secondSubgroup, comap_map_eq,
    involutionSourceMatrixMap_ker, sup_comm]

/-- The second overlap obligation is equivalent to one core containment and
three literal word memberships. -/
theorem involutionMatrixSecondSubgroup_preimage_le_iff (g : Janko4.Model) :
    involutionMatrixSecondSubgroup.comap involutionSourceMatrixMap ≤
        involutionSourceMax4Overlap g ↔
      pCore 2 sourceSubgroup ≤ involutionSourceMax4Overlap g ∧
        ∀ i : Fin 3, involutionSourceSecondGenerator i ∈ involutionSourceMax4Overlap g := by
  rw [involutionMatrixSecondSubgroup_preimage, sup_le_iff,
    involutionSourceSecondSubgroup, closure_le, Set.range_subset_iff]
  rfl

end CFSG.Quasithin.Chapter1.XiEmbedding.InvariantThree.SporadicActions.J4Reduction
