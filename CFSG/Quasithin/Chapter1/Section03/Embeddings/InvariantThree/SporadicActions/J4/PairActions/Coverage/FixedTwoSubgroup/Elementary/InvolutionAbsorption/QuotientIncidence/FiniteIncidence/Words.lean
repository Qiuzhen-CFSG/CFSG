/-- Four elements of the actual matrix subgroup. -/
def sylowGenerator (i : Fin 4) : LowerBound.quotientSubgroup :=
  evaluate (sylowInstructions i)

/-- The subgroup used by the proposed finite certificate. -/
def baseSubgroup : Subgroup LowerBound.quotientSubgroup :=
  Subgroup.closure (Set.range sylowGenerator)

/-- Actual matrix-group representatives for the proposed double-coset cover. -/
def representative (i : Fin 110) : LowerBound.quotientSubgroup :=
  evaluate (representativeInstructions i)

theorem sylowGenerator_mem (i : Fin 4) : sylowGenerator i ∈ baseSubgroup :=
  Subgroup.subset_closure ⟨i, rfl⟩

/-- Four memberships suffice to place the whole generated subgroup. -/
theorem baseSubgroup_le_iff (K : Subgroup LowerBound.quotientSubgroup) :
    baseSubgroup ≤ K ↔ ∀ i, sylowGenerator i ∈ K := by
  constructor
  · intro h i
    exact h (sylowGenerator_mem i)
  · intro h
    apply (Subgroup.closure_le K).mpr
    rintro _ ⟨i, rfl⟩
    exact h i

end CFSG.Quasithin.Chapter1.XiEmbedding.InvariantThree.SporadicActions.J4Reduction.FiniteIncidence
