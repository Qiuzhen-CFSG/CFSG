module

public import CFSG.Quasithin.Chapter1.Section03.Embeddings.InvariantThree.SporadicActions.J4.PairActions.Parity.Conjugacy.Reduction
public import CFSG.Quasithin.Chapter1.Section03.Embeddings.InvariantThree.SporadicActions.J4.PairActions.Parity.Conjugacy.CentralizerExclusion.Local
public import Theory.SpecificGroups.Janko4.Model.AutomorphismReduction.FixedGenerator.NormalizerSquares.LocalAction.TwoCoreCentralizer.Generation.Conjugacy

/-!
# Order 35 in the full J₄ involution centralizer: generation reduction

The entire subgroup H generated by the certified max2 words omits order 35:
`CentralizerExclusion.Local` constructs its genuine action in the fixed binary
model, proves its kernel is a two-group, and transports the checked order
exclusion. The range of the literal matrix-centralizer inclusion is exactly
C_Model(a). Thus H = C gives the full-centralizer exclusion by two actual
multiplicative equivalences.

The only remaining premise is `localSubgroup = ⊤`, owned by the existing
full-generation development. This module does not yet assert the unconditional
`involutionCentralizerOmitsThirtyFive`; its source-theorem assembly remains
here until generation is proved.

Source motivation: GLS3, Table 5.3i, printed p.270,
`refs/KGroup/GLS3/Chapter5(sec3-).tex`. The conjugacy application is
`refs/quasithin.pdf`, printed p.511 (PDF p.528), citing Aschbacher (1986).
-/

public section

namespace CFSG.Quasithin.Chapter1.XiEmbedding.InvariantThree.SporadicActions.J4Reduction.Max4Conjugacy

open Janko4.OuterReduction.FixedGenerator.NormalizerSquares
open TwoCoreCentralizerData

private theorem omits_thirtyFive_of_equiv {G H : Type*} [Group G] [Group H]
    (e : G ≃* H) (h : ∀ x : G, orderOf x ≠ 35) : ∀ x : H, orderOf x ≠ 35 := by
  intro x hx
  exact h (e.symm x) ((e.symm.orderOf_eq x).trans hx)

set_option maxRecDepth 4000 in
/-- Full generation upgrades the proved max2 exclusion to the exact centralizer contract. -/
theorem involutionCentralizerOmitsThirtyFive_of_localSubgroup_eq_top
    (hgen : localSubgroup = ⊤) : InvolutionCentralizerOmitsThirtyFive := by
  intro _ _ _
  let e : localSubgroup ≃* involutionCentralizer :=
    (MulEquiv.subgroupCongr hgen).trans Subgroup.topEquiv
  let c : involutionCentralizer ≃* Subgroup.centralizer ({Janko4.a} : Set Janko4.Model) :=
    (MonoidHom.ofInjective centralizerToModel_injective).trans
      (MulEquiv.subgroupCongr centralizerToModel_range)
  have hi : ∀ x : involutionCentralizer, orderOf x ≠ 35 :=
    omits_thirtyFive_of_equiv (G := localSubgroup) (H := involutionCentralizer) e
      CentralizerExclusion.localSubgroup_orderOf_ne_thirtyFive
  exact omits_thirtyFive_of_equiv (G := involutionCentralizer)
    (H := Subgroup.centralizer ({Janko4.a} : Set Janko4.Model)) c hi

end CFSG.Quasithin.Chapter1.XiEmbedding.InvariantThree.SporadicActions.J4Reduction.Max4Conjugacy
