module

public import CFSG.Quasithin.Chapter1.Section03.Embeddings.InvariantThree.SporadicActions.J4.PairActions.Coverage.FixedTwoSubgroup.Elementary.InvolutionAbsorption.QuotientIncidence.SourceLifts
import Mathlib.Tactic.FinCases

/-!
# Two word lifts for the specified quotient line

The two words below are Schreier words for the line {23, 1024, 1047}.
They can be evaluated both in the original ATLAS max2 subgroup and in its
certified matrix quotient. This module proves the compatibility of those
lifts; membership in and generation of the stabilizer are checked separately.

Source context: Aschbacher–Smith, Proposition 1.3.4, printed p.511;
GLS3 Table 5.3i, printed p.270. The untrusted word search and its provenance
are retained in `LineOverlap/source/`. No GAP result is used as a premise.
-/

@[expose] public section
open Subgroup
open Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreCentralizerData
namespace CFSG.Quasithin.Chapter1.XiEmbedding.InvariantThree.SporadicActions.J4Reduction

attribute [local irreducible] Janko4.modelGroup

/-- Two fixed words, in a form that also specifies their original-model lifts. -/
def involutionLineWord {G : Type*} [Group G] (x y : G) : Fin 2 → G :=
  ![x * y⁻¹ * x * y * x * y * x * y * x * y⁻¹ * x * y * x * y⁻¹,
    x * y⁻¹ * x * y * x * y⁻¹ * x * y⁻¹ * x * y * x * y⁻¹ * x * y⁻¹ * x * y⁻¹ * x * y * x * y⁻¹]

theorem involutionLineWord_map {G A : Type*} [Group G] [Group A]
    (f : G →* A) (x y : G) (i : Fin 2) :
    f (involutionLineWord x y i) = involutionLineWord (f x) (f y) i := by
  fin_cases i <;> dsimp [involutionLineWord] <;> simp only [map_mul, map_inv]

/-- The two words evaluated in the literal matrix quotient. -/
def involutionMatrixLineGenerator : Fin 2 → LowerBound.quotientSubgroup :=
  involutionLineWord ⟨LowerBound.quotientX, LowerBound.quotientX_mem⟩
    ⟨LowerBound.quotientY, LowerBound.quotientY_mem⟩

/-- The subgroup generated by the two proposed line-stabilizer generators. -/
def involutionMatrixLineGenerated : Subgroup LowerBound.quotientSubgroup :=
  closure (Set.range involutionMatrixLineGenerator)

/-- The same words, evaluated in the actual original max2 subgroup. -/
def involutionSourceLineGenerator : Fin 2 → sourceSubgroup :=
  involutionLineWord LowerBound.sourceX LowerBound.sourceY

/-- The subgroup generated by the two source lifts. -/
def involutionSourceLineGenerated : Subgroup sourceSubgroup :=
  closure (Set.range involutionSourceLineGenerator)

/-- Compatibility of both source lifts with the proved quotient homomorphism. -/
@[simp] theorem involutionSourceMatrixMap_lineGenerator (i : Fin 2) :
    involutionSourceMatrixMap (involutionSourceLineGenerator i) =
      involutionMatrixLineGenerator i := by
  have hx : involutionSourceMatrixMap LowerBound.sourceX =
      (⟨LowerBound.quotientX, LowerBound.quotientX_mem⟩ : LowerBound.quotientSubgroup) :=
    Subtype.ext LowerBound.quotientMap_sourceX
  have hy : involutionSourceMatrixMap LowerBound.sourceY =
      (⟨LowerBound.quotientY, LowerBound.quotientY_mem⟩ : LowerBound.quotientSubgroup) :=
    Subtype.ext LowerBound.quotientMap_sourceY
  rw [involutionSourceLineGenerator, involutionLineWord_map, hx, hy]
  rfl

theorem involutionSourceMatrixMap_lineGenerated :
    involutionSourceLineGenerated.map involutionSourceMatrixMap =
      involutionMatrixLineGenerated := by
  rw [involutionSourceLineGenerated, MonoidHom.map_closure, ← Set.range_comp]
  simp only [Function.comp_def, involutionSourceMatrixMap_lineGenerator,
    involutionMatrixLineGenerated]

/-- The inverse image of the generated quotient subgroup contains the entire core. -/
theorem involutionMatrixLineGenerated_preimage :
    involutionMatrixLineGenerated.comap involutionSourceMatrixMap =
      pCore 2 sourceSubgroup ⊔ involutionSourceLineGenerated := by
  rw [← involutionSourceMatrixMap_lineGenerated, comap_map_eq,
    involutionSourceMatrixMap_ker, sup_comm]

/-- The source lifts have these literal words in the ambient matrix carrier. -/
theorem involutionSourceLineGenerator_coe (i : Fin 2) :
    (involutionSourceLineGenerator i : Janko4.Model) = involutionLineWord w10 w14 i :=
  involutionLineWord_map sourceSubgroup.subtype _ _ i

end CFSG.Quasithin.Chapter1.XiEmbedding.InvariantThree.SporadicActions.J4Reduction
