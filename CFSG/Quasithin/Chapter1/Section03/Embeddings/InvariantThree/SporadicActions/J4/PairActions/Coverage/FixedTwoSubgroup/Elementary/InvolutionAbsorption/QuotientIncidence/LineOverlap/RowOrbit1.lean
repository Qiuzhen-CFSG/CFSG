module

public import CFSG.Quasithin.Chapter1.Section03.Embeddings.InvariantThree.SporadicActions.J4.PairActions.Coverage.FixedTwoSubgroup.Elementary.InvolutionAbsorption.QuotientIncidence.LineOverlap.Generators

/-!
# Certified right-row orbit tree of length 12

The packed points have a checked left inverse, so they are distinct.
Table entries are extracted from natural-number bit fields; the finite checks
use a natural-number loop to avoid dependent enumeration overhead.
Every non-root point has a smaller parent and is its parent's right product
by a generator in the required stabilizer. The general tree lemma therefore
gives 12 distinct cosets. See `source/README.md` and `source/generate.py`.
-/

set_option maxRecDepth 100000
@[expose] public section
open Subgroup
open Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreCentralizerData.LowerBound
open Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreCentralizerData.LowerBound.QuotientOrderCertificate
namespace CFSG.Quasithin.Chapter1.XiEmbedding.InvariantThree.SporadicActions.J4Reduction.LineOverlapCertificate

private theorem forall_fin_of_range {n : ℕ} [NeZero n]
    (P : Fin n → Prop) [DecidablePred P]
    (h : (List.range n).all (fun i => decide (P (Fin.ofNat n i))) = true) : ∀ i, P i := by
  intro i
  have hi := of_decide_eq_true (List.all_eq_true.mp h i.val (List.mem_range.mpr i.isLt))
  simpa only [Fin.ofNat_val_eq_self] using hi

private def pointTable : ℕ := 0x3d72e35343701fdce420de507f0b94a51001

private def parentTable : ℕ := 0x622211000000

private def letterTable : ℕ := 0x550a6b440

private def indexTable : ℕ := 

private def code (i : Fin 12) : BitVec 12 :=
  BitVec.ofNat 12 (pointTable >>> (12 * i.val))
private def point (i : Fin 12) : Row := row (code i)
private def parent (i : Fin 12) : Fin 12 :=
  Fin.ofNat 12 ((parentTable >>> (4 * i.val)) % 16)
private def letter (i : Fin 12) : Fin 6 :=
  Fin.ofNat 6 ((letterTable >>> (3 * i.val)) % 8)
private def index (v : BitVec 12) : Fin 12 :=
  Fin.ofNat 12 ((indexTable >>> (4 * v.toNat)) % 16)

private theorem parent_lt : ∀ i, i ≠ 0 → parent i < i := by
  apply forall_fin_of_range
  decide +kernel

private theorem edge : ∀ i, i ≠ 0 →
    right (point (parent i)) (gen1 (letter i)) = point i := by
  have h : ∀ i, i ≠ 0 →
      packedRow (code (parent i)).toNat (genRows1 (letter i)) =
        (code i).toNat := by
    apply forall_fin_of_range
    decide +kernel
  intro i hi
  change Matrix.vecMul (row (code (parent i))) (gen1 (letter i)).val =
    row (code i)
  rw [gen1_val]
  exact vecMul_eq_of_packed _ _ _ (h i hi)

private theorem point_injective : Function.Injective point := by
  have h : Function.LeftInverse index code := by
    apply forall_fin_of_range
    decide +kernel
  exact row_injective.comp h.injective

theorem level1_bound : 12 ≤ Nat.card rowStabilizer := by
  have h := tree_card_mul_le rowStabilizer ⊥ bot_le gen1 gen1_mem
    point parent letter parent_lt edge point_injective
    (fun g => by
      have hg := g.property
      simp only [Subgroup.mem_bot] at hg
      simp only [hg, right_one])
  simpa using h

end CFSG.Quasithin.Chapter1.XiEmbedding.InvariantThree.SporadicActions.J4Reduction.LineOverlapCertificate
