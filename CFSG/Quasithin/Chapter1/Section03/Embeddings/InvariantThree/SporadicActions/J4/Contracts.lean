module

public import CFSG.Quasithin.Chapter1.Section03.Embeddings.InvariantThree.SporadicActions.Covers
public import Theory.SpecificGroups.Janko4.Model.LocalStructure.SymmetricLinear.Model

/-!
# Remaining symmetric-linear local inputs for the J₄ pair

The quotient certificate concerns only the fixed subgroup generated by the
literal ATLAS max4 program. The placement assertion concerns every source
Sylow pair, and requires an actual conjugation into that subgroup together
with preservation by all extending automorphisms of the transported pair.
These are independent structural obligations, not asserted results or
assumptions of an invariant line. Their conjunction feeds the conditional
assembly in `SporadicActions.J4`.

The preservation clause is necessary: existence of an overgroup with the
right quotient does not imply that an arbitrary extending automorphism
acts on that quotient. No global J₄ order or outer-automorphism assertion
is assumed here.

Source: Aschbacher–Smith, proof of Proposition 1.3.4, printed p.511
(PDF p.528), citing Aschbacher, *Overgroups of Sylow subgroups in sporadic
groups* (1986); ATLAS program `J4G1-max4W1`.
-/

@[expose] public section

open Subgroup
open Janko4.LocalStructure.SymmetricLinear
namespace CFSG.Quasithin.Chapter1.XiEmbedding.InvariantThree.SporadicActions.J4Reduction

/-- The exact local quotient certificate, not a group-order tag. -/
def MaximalFourQuotient : Prop :=
  Nonempty ((max4Subgroup ⧸ pCore 2 max4Subgroup) ≃* QuotientModel)

/-- Placement of every source pair in the fixed local model, with control
of the actual ambient automorphisms that preserve the transported pair. -/
def MaximalFourPairPlacement : Prop :=
  ∀ [Finite Janko4.Model] [IsSimpleGroup Janko4.Model] [Group.IsPerfect Janko4.Model]
    (S : Sylow 2 Janko4.Model) (R : Subgroup Janko4.Model), PairInput S R →
    ∃ g : Janko4.Model,
      let e := MulAut.conj g
      let S' := (S : Subgroup Janko4.Model).map e.toMonoidHom
      let R' := R.map e.toMonoidHom
      S' ≤ max4Subgroup ∧ R' ≤ max4Subgroup ∧
        ∀ b : MulAut Janko4.Model,
          (∀ x, b x ∈ S' ↔ x ∈ S') →
          (∀ x, b x ∈ R' ↔ x ∈ R') →
          ∀ x, b x ∈ max4Subgroup ↔ x ∈ max4Subgroup

/-- The sufficient placement contract for each acting two-group. The local
overgroup may depend on that group. The comparison is an actual multiplicative
equivalence, and its automorphisms must agree with the given action on R.
No invariant Frattini subgroup is assumed. -/
def MaximalFourPairActions : Prop :=
  ∀ [Finite Janko4.Model] [IsSimpleGroup Janko4.Model] [Group.IsPerfect Janko4.Model]
    (S : Sylow 2 Janko4.Model) (R : Subgroup Janko4.Model), PairInput S R →
    ∀ D : Subgroup (MulAut R), D ≤ pairAutomizer (S : Subgroup Janko4.Model) R →
      IsPGroup 2 D →
      ∃ (M : Subgroup Janko4.Model) (hRM : R ≤ M),
        (S : Subgroup Janko4.Model) ≤ M ∧ Nonempty (M ≃* max4Subgroup) ∧
          ∀ a ∈ D, ∃ c : MulAut M,
            ∀ r : R, inclusion hRM (a r) = c (inclusion hRM r)

end CFSG.Quasithin.Chapter1.XiEmbedding.InvariantThree.SporadicActions.J4Reduction
