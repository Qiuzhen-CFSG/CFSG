module
public import CFSG.Quasithin.Chapter1.Section03.Embeddings.InvariantThree.SporadicActions.J4.PairActions.Coverage.FixedTwoSubgroup.Elementary.InvolutionAbsorption.QuotientIncidence.SourceLifts
import Mathlib.Tactic.FinCases

/-!
# Literal ambient generators of the second quotient preimage

The full preimage in the original ATLAS max2 subgroup is generated by thirteen
core words and the three words displayed in `Geometry`. This module identifies
its ambient image with the closure of those sixteen literal matrix-model words.
Thus a matrix calculation on these generators concerns the entire preimage,
including the core, without assuming full involution-centralizer generation.

The requested placement in a conjugate of the literal max4 subgroup is not
established here. `SecondOverlap/source/diagnose.py` records an untrusted
invariant-subspace obstruction: the preimage has a unique invariant four-space
with image of order 192, whereas max4 has an invariant four-space with image of
order 120. The README explains the resulting incompatibility if the GAP
submodule enumeration is certified. No output of that calculation is a premise
of the Lean theorems below.

Source context: Aschbacher–Smith, Proposition 1.3.4, printed p.511 (PDF p.528 of
`refs/quasithin.pdf`), and GLS3 Table 5.3i. The actual ATLAS word programs and
matrix provenance are documented in the imported source modules.
-/

@[expose] public section
open Subgroup
open Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreCentralizerData
namespace CFSG.Quasithin.Chapter1.XiEmbedding.InvariantThree.SporadicActions.J4Reduction
attribute [local irreducible] Janko4.modelGroup

set_option linter.unusedSimpArgs false in
/-- Undoing the max2 bridge gives the original thirteen literal core words. -/
theorem involutionSourceCoreGenerator_coe_word (i : Fin 13) :
    (involutionSourceCoreGenerator i : Janko4.Model) =
      NormalClosureControl.conjugates w10 w14 (xyxyy ^ 11) t i := by
  rw [involutionSourceCoreGenerator_coe]
  fin_cases i <;>
    simp only [NormalClosureControl.basis, NormalClosureControl.conjugates,
      Matrix.cons_val_zero', Matrix.cons_val_succ', map_mul, map_inv,
      NormalClosureControl.unconjugate_x, NormalClosureControl.unconjugate_y,
      NormalClosureControl.unconjugate_seed, NormalClosureControl.unconjugate_involution]

/-- The three source lifts evaluate the same displayed instructions in the ambient model. -/
theorem involutionSourceSecondGenerator_coe_word (i : Fin 3) :
    (involutionSourceSecondGenerator i : Janko4.Model) =
      involutionSecondWord w10 w14 i := by
  exact involutionSecondWord_map sourceSubgroup.subtype LowerBound.sourceX LowerBound.sourceY i

/-- Exact ambient generation of the full preimage, retaining every core factor. -/
theorem involutionMatrixSecond_preimage_ambient :
    (involutionMatrixSecondSubgroup.comap involutionSourceMatrixMap).map
        sourceSubgroup.subtype =
      closure (Set.range (NormalClosureControl.conjugates w10 w14 (xyxyy ^ 11) t) ∪
        Set.range (involutionSecondWord w10 w14)) := by
  rw [involutionMatrixSecondSubgroup_preimage, Subgroup.map_sup,
    involutionSource_twoCore_eq_closure, involutionSourceSecondSubgroup,
    MonoidHom.map_closure, MonoidHom.map_closure, ← Set.range_comp, ← Set.range_comp]
  simp only [Function.comp_def, Subgroup.coe_subtype,
    involutionSourceCoreGenerator_coe_word, involutionSourceSecondGenerator_coe_word]
  exact (closure_union _ _).symm
end CFSG.Quasithin.Chapter1.XiEmbedding.InvariantThree.SporadicActions.J4Reduction
