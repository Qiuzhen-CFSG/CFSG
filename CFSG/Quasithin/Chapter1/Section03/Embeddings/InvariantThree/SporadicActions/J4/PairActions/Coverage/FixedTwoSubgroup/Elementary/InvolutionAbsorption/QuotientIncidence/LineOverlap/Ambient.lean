module

public import CFSG.Quasithin.Chapter1.Section03.Embeddings.InvariantThree.SporadicActions.J4.PairActions.Coverage.FixedTwoSubgroup.Elementary.InvolutionAbsorption.QuotientIncidence.LineOverlap.Words
public import CFSG.Quasithin.Chapter1.Section03.Embeddings.InvariantThree.SporadicActions.J4.PairActions.Coverage.FixedTwoSubgroup.Elementary.InvolutionAbsorption.QuotientIncidence.LineOverlap.Ambient.Memberships
import Mathlib.Tactic.FinCases

/-!
# Fifteen actual memberships in one ATLAS max4 conjugate

The thirteen source-core generators and the two specified line words lie in
one conjugate of the actual subgroup generated by `J4G1-max4W1`. The witnesses
are products and inverses of its two generators. All word equalities are
checked on the full faithful 112-dimensional binary representation; a quotient
calculation is used only by the untrusted search, never as a proof premise.

The conjugator and its word evaluations are in `Ambient.Evaluations`;
`Ambient.Memberships` certifies the subgroup words, including every residual
factor. The final transport checks `m * q = q * e` for each source element `e`,
where `m` is a certified max4 member and `q` is `rightConjugator`.

Source context: Aschbacher–Smith, Proposition 1.3.4, printed p.511 (PDF p.528);
GLS3 Table 5.3i; Aschbacher, *Overgroups of Sylow subgroups in sporadic groups*
(1986). This is the finite ambient placement contract used by the parent
line-stabilizer argument. Witness provenance is retained in `Ambient/source/`.
-/

public section

open Janko4 Janko4.GeneratorCertificates Janko4.LocalStructure.SymmetricLinear
open Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreCentralizerData

namespace CFSG.Quasithin.Chapter1.XiEmbedding.InvariantThree.SporadicActions.J4Reduction

open AmbientLineCertificates

attribute [local irreducible] Janko4.modelGroup

private theorem eval_sourceCore (i : Fin 13) :
    toMatrix (involutionSourceCoreGenerator i : Model) =
      decodeRows (NormalClosureControl.Certificates.basisRows i) := by
  rw [involutionSourceCoreGenerator_coe]
  exact NormalClosureControl.representation_basis i

private theorem core_mem (i : Fin 13) :
    involutionSourceCoreGenerator i ∈ involutionSourceMax4Overlap rightConjugator⁻¹ := by
  change (involutionSourceCoreGenerator i : Model) ∈
    max4Subgroup.map (MulAut.conj rightConjugator⁻¹).toMonoidHom
  fin_cases i
  · exact conjugate_mem eval_rightConjugator (eval_sourceCore 0)
      member_283 product_394 product_395
  · exact conjugate_mem eval_rightConjugator (eval_sourceCore 1)
      member_307 product_397 product_398
  · exact conjugate_mem eval_rightConjugator (eval_sourceCore 2)
      member_308 product_400 product_401
  · exact conjugate_mem eval_rightConjugator (eval_sourceCore 3)
      member_158 product_402 product_403
  · exact conjugate_mem eval_rightConjugator (eval_sourceCore 4)
      member_309 product_405 product_406
  · exact conjugate_mem eval_rightConjugator (eval_sourceCore 5)
      member_180 product_407 product_408
  · exact conjugate_mem eval_rightConjugator (eval_sourceCore 6)
      member_310 product_410 product_411
  · exact conjugate_mem eval_rightConjugator (eval_sourceCore 7)
      member_311 product_413 product_414
  · exact conjugate_mem eval_rightConjugator (eval_sourceCore 8)
      member_215 product_415 product_416
  · exact conjugate_mem eval_rightConjugator (eval_sourceCore 9)
      member_227 product_417 product_418
  · exact conjugate_mem eval_rightConjugator (eval_sourceCore 10)
      member_312 product_420 product_421
  · exact conjugate_mem eval_rightConjugator (eval_sourceCore 11)
      member_313 product_423 product_424
  · exact conjugate_mem eval_rightConjugator (eval_sourceCore 12)
      member_314 product_426 product_427

private theorem line_mem (i : Fin 2) :
    involutionSourceLineGenerator i ∈ involutionSourceMax4Overlap rightConjugator⁻¹ := by
  change (involutionSourceLineGenerator i : Model) ∈
    max4Subgroup.map (MulAut.conj rightConjugator⁻¹).toMonoidHom
  fin_cases i
  · have he : toMatrix (involutionSourceLineGenerator 0 : Model) =
        decodeRows r78 := by
      rw [involutionSourceLineGenerator_coe]
      exact eval_v96
    exact conjugate_mem eval_rightConjugator he
      member_315 product_429 product_430
  · have he : toMatrix (involutionSourceLineGenerator 1 : Model) =
        decodeRows r93 := by
      rw [involutionSourceLineGenerator_coe]
      exact eval_v115
    exact conjugate_mem eval_rightConjugator he
      member_316 product_432 product_433

/-- All fifteen prescribed generators lie in one conjugate of the actual ATLAS max4. -/
theorem involutionLine_ambient_word_placement :
    ∃ g : Janko4.Model,
      (∀ i : Fin 13, involutionSourceCoreGenerator i ∈ involutionSourceMax4Overlap g) ∧
      (∀ i : Fin 2, involutionSourceLineGenerator i ∈ involutionSourceMax4Overlap g) :=
  ⟨rightConjugator⁻¹, core_mem, line_mem⟩

end CFSG.Quasithin.Chapter1.XiEmbedding.InvariantThree.SporadicActions.J4Reduction
