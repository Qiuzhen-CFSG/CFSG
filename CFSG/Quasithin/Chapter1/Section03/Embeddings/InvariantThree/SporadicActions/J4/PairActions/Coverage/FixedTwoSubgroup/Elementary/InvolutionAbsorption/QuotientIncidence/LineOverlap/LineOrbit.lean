module

public import CFSG.Quasithin.Chapter1.Section03.Embeddings.InvariantThree.SporadicActions.J4.PairActions.Coverage.FixedTwoSubgroup.Elementary.InvolutionAbsorption.QuotientIncidence.LineOverlap.Generators

/-!
# The 231 distinct translates of the specified quotient line

A rooted tree gives 231 line translates under the two quotient generators.
Packed arithmetic checks every edge. A lookup table assigns all three rows
of each line back to that line, proving distinctness. Multiplication then
embeds 231 copies of the actual line stabilizer into the matrix quotient.
Only a lower bound for this orbit is needed; no orbit-exhaustion assertion
or external group computation is assumed. See `source/README.md`.
-/

set_option maxRecDepth 100000
@[expose] public section
open Subgroup
open scoped Pointwise
open Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreCentralizerData
open LowerBound
open LowerBound.QuotientOrderCertificate
namespace CFSG.Quasithin.Chapter1.XiEmbedding.InvariantThree.SporadicActions.J4Reduction.LineOverlapCertificate

private abbrev V := Multiplicative OuterImageComparison.BinaryVector
private def rightLine (L : Set V) (g : U) : Set V :=
  OuterImageComparison.rowAction g⁻¹ • L

private theorem rightLine_one (L : Set V) : rightLine L 1 = L := by
  simp only [rightLine, inv_one, map_one, one_smul]

private theorem rightLine_mul (L : Set V) (g h : U) :
    rightLine L (g * h) = rightLine (rightLine L g) h := by
  simp only [rightLine, mul_inv_rev, map_mul, mul_smul]

private theorem tree_reaches {n k : ℕ} [NeZero n]
    (gen : Fin k → U) (hgen : ∀ j, gen j ∈ quotientSubgroup)
    (point : Fin n → Set V) (parent : Fin n → Fin n) (letter : Fin n → Fin k)
    (hlt : ∀ i, i ≠ 0 → parent i < i)
    (hedge : ∀ i, i ≠ 0 → rightLine (point (parent i)) (gen (letter i)) = point i) :
    ∀ i, ∃ g : quotientSubgroup, rightLine (point 0) g.val = point i := by
  intro i
  induction i using WellFoundedLT.induction with
  | ind i ih =>
    by_cases hi : i = 0
    · subst i
      exact ⟨1, rightLine_one _⟩
    · obtain ⟨g, hg⟩ := ih (parent i) (hlt i hi)
      refine ⟨⟨g.val * gen (letter i), quotientSubgroup.mul_mem g.property (hgen _)⟩, ?_⟩
      change rightLine (point 0) (g.val * gen (letter i)) = point i
      rw [rightLine_mul, hg, hedge i hi]

private theorem forall_fin_of_range {n : ℕ} [NeZero n]
    (P : Fin n → Prop) [DecidablePred P]
    (h : (List.range n).all (fun i => decide (P (Fin.ofNat n i))) = true) : ∀ i, P i := by
  intro i
  have hi := of_decide_eq_true (List.all_eq_true.mp h i.val (List.mem_range.mpr i.isLt))
  simpa only [Fin.ofNat_val_eq_self] using hi

private def quotientGen : Fin 3 → U := ![quotientX, quotientY, quotientY⁻¹]
private theorem quotientGen_mem : ∀ i, quotientGen i ∈ quotientSubgroup := by
  intro i
  fin_cases i
  · exact quotientX_mem
  · exact quotientY_mem
  · exact quotientSubgroup.inv_mem quotientY_mem

private def quotientGenRows : Fin 3 → Vector ℕ 12 :=
  ![#v[2533, 3688, 2585, 58, 3283, 649, 4075, 1447, 616, 3160, 2130, 2384],
    #v[895, 124, 359, 4005, 2616, 2695, 1446, 24, 2224, 645, 4013, 2327],
    #v[749, 3035, 1525, 1032, 1160, 2542, 3225, 1437, 2480, 133, 2989, 2555]]

private theorem quotientGen_val : ∀ i,
    (quotientGen i).val = quotientDecode (quotientGenRows i) := by
  intro i
  fin_cases i <;> rfl

private def pointTable : ℕ := 

private def parentTable : ℕ := 

private def letterTable : ℕ := 0xa000269999990000000026666659a66666666640000000000266666666666666666640000000009999966599000000099999990000999900990

private def permTable : ℕ := 

private def indexTable : ℕ := 

private def code (i : Fin 231) (j : Fin 3) : BitVec 12 :=
  BitVec.ofNat 12 (pointTable >>> (12 * (3 * i.val + j.val)))
private def vector (v : BitVec 12) : V := Multiplicative.ofAdd (row v)
private def point (i : Fin 231) : Set V := Set.range (fun j : Fin 3 => vector (code i j))
private def parent (i : Fin 231) : Fin 231 :=
  Fin.ofNat 231 ((parentTable >>> (8 * i.val)) % 256)
private def letter (i : Fin 231) : Fin 3 :=
  Fin.ofNat 3 ((letterTable >>> (2 * i.val)) % 4)
private def perm (i : Fin 231) (j : Fin 3) : Fin 3 :=
  Fin.ofNat 3 ((permTable >>> (2 * (3 * i.val + j.val))) % 4)
private def index (v : BitVec 12) : Fin 231 :=
  Fin.ofNat 231 ((indexTable >>> (8 * v.toNat)) % 256)

private theorem vector_injective : Function.Injective vector := by
  intro a b hab
  exact row_injective (congrArg Multiplicative.toAdd hab)

private theorem point_zero : point 0 = involutionMatrixLine := by
  have h : (fun j : Fin 3 => vector (code 0 j)) =
      ![involutionMatrixVector 23, involutionMatrixVector 1024, involutionMatrixVector 1047] := by
    funext j
    fin_cases j <;> rfl
  rw [point, h]
  ext v
  simp only [Set.mem_range, involutionMatrixLine, Set.mem_insert_iff, Set.mem_singleton_iff]
  constructor
  · rintro ⟨j, rfl⟩
    fin_cases j <;> simp
  · rintro (rfl | rfl | rfl)
    · exact ⟨0, rfl⟩
    · exact ⟨1, rfl⟩
    · exact ⟨2, rfl⟩

private theorem parent_lt : ∀ i, i ≠ 0 → parent i < i := by
  apply forall_fin_of_range
  decide +kernel

private theorem perm_surjective : ∀ i, Function.Surjective (perm i) := by
  apply forall_fin_of_range
  decide +kernel

private theorem edge : ∀ i, i ≠ 0 →
    rightLine (point (parent i)) (quotientGen (letter i)) = point i := by
  have h : ∀ i, i ≠ 0 → ∀ j,
      packedRow (code (parent i) j).toNat (quotientGenRows (letter i)) =
        (code i (perm i j)).toNat := by
    apply forall_fin_of_range
    decide +kernel
  intro i hi
  have hv (j : Fin 3) :
      OuterImageComparison.rowAction (quotientGen (letter i))⁻¹
        (vector (code (parent i) j)) = vector (code i (perm i j)) := by
    change Matrix.vecMul (row (code (parent i) j))
      ((quotientGen (letter i))⁻¹)⁻¹.val = row (code i (perm i j))
    rw [inv_inv, quotientGen_val]
    exact vecMul_eq_of_packed _ _ _ (h i hi j)
  change (fun v => OuterImageComparison.rowAction (quotientGen (letter i))⁻¹ v) ''
    Set.range (fun j : Fin 3 => vector (code (parent i) j)) =
      Set.range (fun j : Fin 3 => vector (code i j))
  rw [← Set.range_comp]
  ext v
  constructor
  · rintro ⟨j, rfl⟩
    exact ⟨perm i j, (hv j).symm⟩
  · rintro ⟨j, rfl⟩
    obtain ⟨k, rfl⟩ := perm_surjective i j
    exact ⟨k, hv k⟩

private theorem point_injective : Function.Injective point := by
  have h : ∀ i j, index (code i j) = i := by
    apply forall_fin_of_range
    decide +kernel
  intro i j hij
  have hm : vector (code i 0) ∈ point j := by
    rw [← hij]
    exact ⟨0, rfl⟩
  obtain ⟨k, hk⟩ := hm
  have hc := congrArg index (vector_injective hk)
  simpa only [h] using hc.symm

/-- The fixed line has at least 231 translates, so its stabilizer has this bound. -/
theorem line_stabilizer_bound :
    231 * Nat.card involutionMatrixLineStabilizer ≤ Nat.card quotientSubgroup := by
  classical
  choose rep hrep using tree_reaches quotientGen quotientGen_mem point parent letter
    parent_lt edge
  have hfix (k : involutionMatrixLineStabilizer) :
      rightLine involutionMatrixLine (k.val : U) = involutionMatrixLine := by
    have hk := involutionMatrixLineStabilizer.inv_mem k.property
    exact hk
  let f : Fin 231 × involutionMatrixLineStabilizer → quotientSubgroup :=
    fun p => p.2.val * rep p.1
  have hf : Function.Injective f := by
    rintro ⟨i, k⟩ ⟨j, l⟩ h
    have hp := congrArg (fun z : quotientSubgroup => (z : U)) h
    change (k.val : U) * (rep i).val = (l.val : U) * (rep j).val at hp
    have hij : i = j := by
      apply point_injective
      have hv := congrArg (rightLine involutionMatrixLine) hp
      rw [rightLine_mul, rightLine_mul, hfix k, hfix l, ← point_zero, hrep, hrep] at hv
      exact hv
    subst j
    have hkl : k = l := Subtype.ext (mul_right_cancel h)
    subst l
    rfl
  simpa only [Nat.card_prod, Nat.card_fin] using Nat.card_le_card_of_injective f hf

end CFSG.Quasithin.Chapter1.XiEmbedding.InvariantThree.SporadicActions.J4Reduction.LineOverlapCertificate
