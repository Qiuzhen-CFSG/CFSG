module

public import CFSG.Quasithin.Chapter1.Section03.Radical.Normalizers.Embedding.Marked
public import Theory.GroupTheory.GeneralizedFitting.ComponentCalculus
public import Theory.GroupTheory.SolvableRadical.SolvableKernel

/-!
# Quotients used to eliminate the embedding alternatives

A surjection with two-group kernel induces an isomorphism after removing both
two-cores. Proper containment of the local C-component survives the ambient
two-core quotient: equality of the images would put the containing component
inside the local group generated by the smaller component and the Sylow group,
where distinct C-components cannot contain one another.

These are the quotient identifications needed in the proof of Proposition
1.3.8, Aschbacher–Smith, combined manuscript of 1 March 2004, printed p.513.
-/

@[expose] public section
noncomputable section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter1.RadicalNormalizers.Embedding.Alternatives

/-- Removing two-cores is unchanged by a surjection with two-group kernel. -/
def coreQuotientEquiv {A B : Type*} [Group A] [Group B]
    [Finite A] [Finite B] (f : A →* B) (hf : Function.Surjective f)
    (hk : IsPGroup 2 f.ker) :
    (A ⧸ pCore 2 A) ≃* (B ⧸ pCore 2 B) := by
  let q := (QuotientGroup.mk' (pCore 2 B)).comp f
  have he : q.ker = pCore 2 A := by
    rw [show q = (QuotientGroup.mk' (pCore 2 B)).comp f from rfl,
      ← MonoidHom.comap_ker, QuotientGroup.ker_mk']
    exact f.comap_pCore_of_ker_isPGroup hf hk
  exact (QuotientGroup.quotientMulEquivOfEq he.symm).trans
    (QuotientGroup.quotientKerEquivOfSurjective q
      ((QuotientGroup.mk'_surjective _).comp hf))

/-- The actual image of any subgroup has the same quotient by its two-core. -/
def imageCoreQuotientEquiv {G : Type*} [Group G] [Finite G] (Y : Subgroup G) :
    (Y ⧸ pCore 2 Y) ≃*
      ((Y.map (QuotientGroup.mk' (pCore 2 G))) ⧸
        pCore 2 (Y.map (QuotientGroup.mk' (pCore 2 G)))) := by
  let q := QuotientGroup.mk' (pCore 2 G)
  apply coreQuotientEquiv (q.subgroupMap Y) (q.subgroupMap_surjective Y)
  rw [ker_subgroupMap, QuotientGroup.ker_mk']
  exact pCore_isPGroup.comap_subtype

/-- Nonquasisimplicity transports through the actual two-core quotient. -/
theorem imageCore_not_quasisimple {G : Type*} [Group G] [Finite G]
    (Y : Subgroup G) (hY : ¬ IsQuasisimple (Y ⧸ pCore 2 Y)) :
    ¬ IsQuasisimple ((Y.map (QuotientGroup.mk' (pCore 2 G))) ⧸
      pCore 2 (Y.map (QuotientGroup.mk' (pCore 2 G)))) := by
  intro h
  let := h
  exact hY (IsQuasisimple.of_mulEquiv (imageCoreQuotientEquiv Y).symm)

/-- Strictness follows from local C-component maximality, not from injectivity
of the quotient map. -/
theorem image_lt_of_local_component {G : Type*} [Group G] [Finite G]
    (T : Sylow 2 G) {Y K : Subgroup G}
    (hY : (Y.subgroupOf (Y ⊔ T)).IsCComponent)
    (hK : K.IsCComponent) (hYK : Y < K) :
    Y.map (QuotientGroup.mk' (pCore 2 G)) <
      K.map (QuotientGroup.mk' (pCore 2 G)) := by
  apply lt_of_le_of_ne (map_mono hYK.le)
  intro he
  have hKY : K ≤ Y ⊔ pCore 2 G := by
    have hh := map_le_iff_le_comap.mp he.ge
    simpa only [comap_map_eq, QuotientGroup.ker_mk'] using hh
  have hKT : K ≤ Y ⊔ T := hKY.trans
    (sup_le_sup_left (pCore_isPGroup.le_sylow_of_normal T) Y)
  have hh := hY.eq_of_le (hK.subgroupOf hKT) (comap_mono hYK.le)
  have hm := congrArg (map (Y ⊔ T).subtype) hh
  rw [map_subgroupOf_eq_of_le le_sup_left, map_subgroupOf_eq_of_le hKT] at hm
  exact hYK.ne hm

/-- A two-group kernel lifts containment in the embedded solvable radical. -/
theorem le_radical_of_image_le_radical {A H : Type*} [Group A] [Group H]
    [Finite A] [Finite H] (f : A →* H) (hk : IsPGroup 2 f.ker)
    {X K : Subgroup A} (hXK : X ≤ K)
    (hX : X.map f ≤ (solvableRadical (K.map f)).map (K.map f).subtype) :
    X ≤ (solvableRadical K).map K.subtype := by
  let g := f.subgroupMap K
  have hg : IsPGroup 2 g.ker := by
    rw [show g = f.subgroupMap K from rfl, ker_subgroupMap]
    exact hk.comap_subtype
  let : Group.IsNilpotent g.ker := hg.isNilpotent
  have hr := comap_solvableRadical_eq_of_solvable_ker g (f.subgroupMap_surjective K)
  intro x hx
  have hm : g ⟨x, hXK hx⟩ ∈ solvableRadical (K.map f) := by
    obtain ⟨z, hz, he⟩ := hX (mem_map_of_mem f hx)
    have he' : z = g ⟨x, hXK hx⟩ := Subtype.ext he
    exact he' ▸ hz
  have hx' : (⟨x, hXK hx⟩ : K) ∈ solvableRadical K := by
    rw [← hr]
    exact hm
  exact ⟨⟨x, hXK hx⟩, hx', rfl⟩

/-- The radical obstruction survives the inclusion into N and its two-core quotient. -/
theorem actual_image_not_le_radical {G : Type*} [Group G] [Finite G]
    {X K N : Subgroup G} (hXK : X ≤ K) (hKN : K ≤ N)
    (hX : ¬ X ≤ (solvableRadical K).map K.subtype) :
    ¬ (X.subgroupOf N).map (QuotientGroup.mk' (pCore 2 N)) ≤
      (solvableRadical ((K.subgroupOf N).map (QuotientGroup.mk' (pCore 2 N)))).map
        ((K.subgroupOf N).map (QuotientGroup.mk' (pCore 2 N))).subtype := by
  intro he
  have hk : IsPGroup 2 (QuotientGroup.mk' (pCore 2 N)).ker := by
    rw [QuotientGroup.ker_mk']
    exact pCore_isPGroup
  have hr := le_radical_of_image_le_radical (QuotientGroup.mk' (pCore 2 N)) hk
    (comap_mono hXK) he
  apply hX
  have hm := map_mono (f := N.subtype) hr
  change (X.subgroupOf N).map N.subtype ≤
    ((solvableRadical (K.subgroupOf N)).map (K.subgroupOf N).subtype).map N.subtype at hm
  rw [map_subgroupOf_eq_of_le (hXK.trans hKN), map_map] at hm
  let e := subgroupOfEquivOfLe hKN
  have hrad := map_solvableRadical_equiv e
  have hh := congrArg (map K.subtype) hrad
  rw [map_map] at hh
  exact hm.trans_eq hh

/-- Both source obstructions transport to the same actual quotient images. -/
theorem actual_image_strict_and_not_quasisimple {G : Type*} [Group G] [Finite G]
    (T : Sylow 2 G) {Y K N : Subgroup G} (hTN : (T : Subgroup G) ≤ N)
    (hY : Y ∈ CFSG.Quasithin.Chapter1.L G T) (hKN : K ≤ N) (hK : (K.subgroupOf N).IsCComponent)
    (hYK : Y < K) (hYq : ¬ IsQuasisimple (Y ⧸ pCore 2 Y)) :
    let B := (Y.subgroupOf N).map (QuotientGroup.mk' (pCore 2 N))
    let Kbar := (K.subgroupOf N).map (QuotientGroup.mk' (pCore 2 N))
    B < Kbar ∧ ¬ IsQuasisimple (B ⧸ pCore 2 B) := by
  have hYN : Y ≤ N := hYK.le.trans hKN
  let S : Sylow 2 N := T.subtype hTN
  have hYL : Y.subgroupOf N ∈ CFSG.Quasithin.Chapter1.L N S := by
    change Y.subgroupOf N ∈ CFSG.Quasithin.Chapter1.L N ((T : Subgroup G).subgroupOf N)
    exact (mem_LIn_iff_subgroupOf hTN hYN).mp ⟨hYN, hY⟩
  have hlt : Y.subgroupOf N < K.subgroupOf N := by
    refine lt_of_le_of_ne (comap_mono hYK.le) ?_
    intro he
    have hh := congrArg (map N.subtype) he
    rw [map_subgroupOf_eq_of_le hYN, map_subgroupOf_eq_of_le hKN] at hh
    exact hYK.ne hh
  refine ⟨image_lt_of_local_component S hYL.1 hK hlt, ?_⟩
  apply imageCore_not_quasisimple
  intro h
  let := h
  let e := subgroupOfEquivOfLe hYN
  exact hYq (IsQuasisimple.of_mulEquiv (QuotientGroup.congr _ _ e (pCore_map_iso 2 e)))

end CFSG.Quasithin.Chapter1.RadicalNormalizers.Embedding.Alternatives
