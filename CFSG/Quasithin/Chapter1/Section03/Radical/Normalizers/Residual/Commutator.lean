module

public import CFSG.Quasithin.Chapter1.Section03.Radical.Normalizers.Residual.Frattini
public import CFSG.Quasithin.Chapter1.Section03.Radical.Normalizers.Thompson.Setup
public import Theory.GroupTheory.GeneralizedFitting.ComponentCalculus

/-!
# Residual containment and nonquasisimplicity from commutator generation

The radical factor X normalizes Y = N_L(R)^∞, so [X,Y] = X puts X in Y.
If Y/O₂(Y) were quasisimple, the image of the solvable normal subgroup X
would be central. Its commutator with Y would then lie in O₂(Y), making
X a two-group, contrary to its nontrivial odd quotient.

The action identity [X,Y] = X remains an explicit input. Its construction
from the source radical actions belongs to the residual assembly and is not
asserted by these conditional deductions.
Source: Aschbacher–Smith, combined manuscript of 1 March 2004, proof of
Proposition 1.3.8, printed p.512.
-/

@[expose] public section

open Subgroup Theory.GroupTheory
open CFSG.Quasithin.Chapter1

namespace CFSG.Quasithin.Chapter1.RadicalNormalizers

private theorem twoGroup_of_solvable_commutator_in_quasisimple_quotient
    {G : Type*} [Group G] [Finite G] (X : Subgroup G) [X.Normal]
    [Group.IsSolvable X] [IsQuasisimple (G ⧸ pCore 2 G)]
    (hcomm : ⁅X, (⊤ : Subgroup G)⁆ = X) : IsPGroup 2 X := by
  let q := QuotientGroup.mk' (pCore 2 G)
  let B := X.map q
  let g : X →* B := (q.comp X.subtype).codRestrict B (fun x => mem_map_of_mem q x.property)
  have hg : Function.Surjective g := by
    rintro ⟨b, x, hx, rfl⟩
    exact ⟨⟨x, hx⟩, rfl⟩
  have hsol : Group.IsSolvable B := Group.isSolvable_of_surjective hg
  have hcentral : B ≤ center (G ⧸ pCore 2 G) := by
    rcases IsQuasisimple.normal_le_center_or_eq_top B with hc | ht
    · exact hc
    · have hs : Group.IsSolvable (G ⧸ pCore 2 G) := by
        have hsol' : Group.IsSolvable (⊤ : Subgroup (G ⧸ pCore 2 G)) := ht ▸ hsol
        let := hsol'
        let e : (⊤ : Subgroup (G ⧸ pCore 2 G)) ≃* (G ⧸ pCore 2 G) := Subgroup.topEquiv
        exact Group.isSolvable_of_surjective (f := e.toMonoidHom) e.surjective
      let : IsSimpleGroup ((G ⧸ pCore 2 G) ⧸ center (G ⧸ pCore 2 G)) := IsQuasisimple.simple
      let : Nontrivial (G ⧸ pCore 2 G) := Function.Surjective.nontrivial
        (QuotientGroup.mk'_surjective (center (G ⧸ pCore 2 G)))
      exact (Group.IsPerfect.not_isSolvable (G ⧸ pCore 2 G) hs).elim
  have hm := congrArg (map q) hcomm
  rw [map_commutator, ← MonoidHom.range_eq_map,
    MonoidHom.range_eq_top.mpr (QuotientGroup.mk'_surjective (pCore 2 G))] at hm
  have hz : B = ⊥ := hm.symm.trans (commutator_top_right_eq_bot_iff_le_center.mpr hcentral)
  have hle : X ≤ pCore 2 G := by
    simpa only [B, Subgroup.map_eq_bot_iff, q, QuotientGroup.ker_mk'] using hz
  exact (pCore_isPGroup (p := 2) (G := G)).of_injective
    (Subgroup.inclusion hle) (Subgroup.inclusion_injective hle)

variable {G : Type*} [Group G] [Finite G]

omit [Finite G] in
/-- Commutator generation forces X into the actual normalizer residual Y. -/
theorem XiP_le_Y_of_commutator (p : ℕ) (L T : Subgroup G)
    (hcomm : ⁅XiP p L, normalizerResidual L (radicalCore p L T)⁆ = XiP p L) :
    XiP p L ≤ normalizerResidual L (radicalCore p L T) := by
  rw [← hcomm]
  exact le_normalizer_iff_commutator_le_right.mp
    (le_normalizer_normalizerResidual ((XiP_le p L).trans L.le_normalizer)
      (le_sup_left.trans (join_le_normalizer_radicalCore p L T)))

/-- The solvable radical factor generated by its commutators with Y rules out
a quasisimple two-core quotient of Y. -/
theorem Y_not_quasisimple_of_commutator
    (p : ℕ) [Fact p.Prime] (hp : Odd p) (L T : Subgroup G)
    [Nontrivial (XiQuotient (XiP p L))]
    (hcomm : ⁅XiP p L, normalizerResidual L (radicalCore p L T)⁆ = XiP p L) :
    ¬ IsQuasisimple (XiQuotient (normalizerResidual L (radicalCore p L T))) := by
  intro hq
  let X := XiP p L
  let Y := normalizerResidual L (radicalCore p L T)
  have hXY : X ≤ Y := XiP_le_Y_of_commutator p L T hcomm
  let : IsQuasisimple (Y ⧸ pCore 2 Y) := hq
  let : (X.subgroupOf Y).Normal := normal_subgroupOf_of_le_normalizer
    ((normalizerResidual_le _ _).trans (L.le_normalizer.trans (normalizer_le_normalizer_XiP p L)))
  let : Group.IsSolvable X := XiP_solvable p hp L
  let : Group.IsSolvable (X.subgroupOf Y) := Group.isSolvable_of_isSolvable_injective
    (f := (subgroupOfEquivOfLe hXY).toMonoidHom) (subgroupOfEquivOfLe hXY).injective
  have hc : ⁅X.subgroupOf Y, (⊤ : Subgroup Y)⁆ = X.subgroupOf Y := by
    apply map_injective Y.subtype_injective
    rw [map_commutator, map_subgroupOf_eq_of_le hXY,
      ← MonoidHom.range_eq_map, range_subtype]
    exact hcomm
  have ht : IsPGroup 2 X :=
    (twoGroup_of_solvable_commutator_in_quasisimple_quotient (X.subgroupOf Y) hc).of_equiv
      (subgroupOfEquivOfLe hXY)
  have hi : IsPGroup 2 (XiQuotient X) := ht.to_quotient _
  have hd := (hi.to_subgroup ⊤).disjoint_of_coprime
    ((XiP_quotient_isPGroup p hp L).to_subgroup ⊤) (Nat.coprime_two_left.mpr hp)
  have he : (⊤ : Subgroup (XiQuotient X)) = ⊥ := disjoint_top.mp hd
  exact top_ne_bot he

end CFSG.Quasithin.Chapter1.RadicalNormalizers
