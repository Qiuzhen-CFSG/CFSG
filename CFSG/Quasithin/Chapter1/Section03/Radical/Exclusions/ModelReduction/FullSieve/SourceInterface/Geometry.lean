module

public import CFSG.Quasithin.Chapter1.Section03.Radical.Exclusions.ModelReduction.FullSieve.ModelCases
public import Theory.SpecificGroups.SymplecticFour.Flag
public import Theory.AtlasPort.LinearGroups.G2.Borel
public import Theory.AtlasPort.LinearGroups.G2.WeylMaps
public import Mathlib.GroupTheory.SpecificGroups.Dihedral

/-!
# Concrete geometry for the alternatives of C.2.7

Partitions are actual partitions of the permutation domain; parabolics are
stabilizers of subspaces or flags in the indicated matrix groups. For G₂(2)
the two parabolics are generated by the positive roots and the respective
simple reflection. Its natural module is the trace-zero octonions modulo
scalars, not the eight-dimensional octonion algebra.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), C.1.30,
printed p.135, and C.2.7(3), pp.145–147.
-/

@[expose] public section

namespace CFSG.Quasithin.Chapter1.RadicalExclusions.ModelReduction.FullSieve.SourceInterface
open Subgroup ChapterC
open scoped Pointwise
universe u
variable {G : Type u} [Group G]

/-- A partition, with its sizes in the supplied order. Equal-sized parts may
be permuted by the setwise stabilizer. -/
structure Partition (n k : ℕ) (sizes : Fin k → ℕ) where
  part : Fin k → Finset (Fin n)
  card : ∀ i, (part i).card = sizes i
  disjoint : Pairwise (fun i j => Disjoint (part i) (part j))
  cover : ∀ x, ∃ i, x ∈ part i

/-- The whole partition is stabilized, rather than each of its parts. -/
def Partition.stabilizer {n k : ℕ} {sizes : Fin k → ℕ}
    (p : Partition n k sizes) : Subgroup (Equiv.Perm (Fin n)) :=
  MulAction.stabilizer (Equiv.Perm (Fin n)) (Set.range p.part)

/-- In the rank-one groups of (a), a Borel is the normalizer of a Sylow
two-subgroup. The surrounding alternative specifies the rank-one model. -/
def IsRankOneBorel (A B : Subgroup G) : Prop :=
  ∃ S : Sylow 2 A, B = (normalizer (S : Set A)).map A.subtype

/-- A subspace stabilizer in the full special linear group. -/
def linearStabilizer {F : Type*} [Field F] {n : ℕ}
    (W : Submodule F (Fin n → F)) : Subgroup (Matrix.SpecialLinearGroup (Fin n) F) :=
  (MulAction.stabilizer ((Fin n → F) ≃ₗ[F] (Fin n → F)) W).comap
    Matrix.SpecialLinearGroup.toLin'

/-- In type A, maximal parabolics are exactly the stabilizers of nonzero
proper subspaces. The isomorphism is part of the assertion. -/
def IsLinearMaximalParabolic {A : Type*} [Group A] (P : Subgroup A)
    (n : ℕ) (F : Type*) [Field F] : Prop :=
  ∃ e : A ≃* Matrix.SpecialLinearGroup (Fin n) F,
    ∃ W : Submodule F (Fin n → F), W ≠ ⊥ ∧ W ≠ ⊤ ∧
      P.map e.toMonoidHom = linearStabilizer W

/-- The two parabolic types in A₆ = Sp₄(2)′: a duad and its complement,
or a partition into three duads. -/
def IsA6MaximalParabolic {A : Type*} [Group A] (P : Subgroup A) : Prop :=
  ∃ e : A ≃* alternatingGroup (Fin 6),
    (∃ d : Partition 6 2 ![2, 4],
      (P.map e.toMonoidHom).map (alternatingGroup (Fin 6)).subtype =
        alternatingGroup (Fin 6) ⊓ d.stabilizer) ∨
    (∃ d : Partition 6 3 ![2, 2, 2],
      (P.map e.toMonoidHom).map (alternatingGroup (Fin 6)).subtype =
        alternatingGroup (Fin 6) ⊓ d.stabilizer)

/-- Both types of maximal isotropic stabilizer in Sp₄(4). Inner conjugacy
is absorbed in the actual model isomorphism. -/
def IsSp4FourMaximalParabolic {A : Type*} [Group A] (P : Subgroup A) : Prop :=
  ∃ (F : Type) (_ : Field F) (_ : Finite F), Nat.card F = 4 ∧
    ∃ e : A ≃* Matrix.symplecticGroup (Fin 2) F,
      P.map e.toMonoidHom = Theory.SpecificGroups.SymplecticFour.pointParabolic ∨
      P.map e.toMonoidHom = Theory.SpecificGroups.SymplecticFour.planeParabolic

/-- The two standard binary G₂ parabolics, defined by their roots. -/
def g2Parabolic (short : Bool) : Subgroup (Atlas.G2.Model (ZMod 2)) :=
  Atlas.G2.borel ⊔ closure {if short then Atlas.G2.weylS else Atlas.G2.weylR}

/-- Conjugates of either actual binary G₂ parabolic. -/
def IsG2MaximalParabolic (P : Subgroup (Atlas.G2.Model (ZMod 2))) : Prop :=
  ∃ (g : Atlas.G2.Model (ZMod 2)) (short : Bool),
    P = (g2Parabolic short).map (MulAut.conj g).toMonoidHom

/-- A proper partial flag. A flag with k proper members in dimension n has
semisimple rank n-1-k, so k ≤ n-2 is the source's positive-rank condition. -/
structure LinearFlag (F : Type*) [Field F] (n k : ℕ) where
  space : Fin k → Submodule F (Fin n → F)
  nonzero : ∀ i, space i ≠ ⊥
  proper : ∀ i, space i ≠ ⊤
  increasing : StrictMono space

/-- The simultaneous stabilizer of all subspaces of the flag. -/
def LinearFlag.stabilizer {F : Type*} [Field F] {n k : ℕ}
    (f : LinearFlag F n k) : Subgroup (Matrix.SpecialLinearGroup (Fin n) F) :=
  ⨅ i, linearStabilizer (f.space i)

/-- The projective flag stabilizer in the literal binary matrix model.
This retains both properness and positive semisimple rank. -/
def IsBinaryPositiveRankParabolic {A : Type*} [Group A]
    (P : Subgroup A) (n : ℕ) : Prop :=
  ∃ e : A ≃* Matrix.ProjectiveSpecialLinearGroup (Fin n) (ZMod 2),
    ∃ k : ℕ, 1 ≤ k ∧ k ≤ n - 2 ∧ ∃ f : LinearFlag (ZMod 2) n k,
      P.map e.toMonoidHom = f.stabilizer.map
        (QuotientGroup.mk' (center (Matrix.SpecialLinearGroup (Fin n) (ZMod 2))))

/-- The seven-dimensional trace-zero subspace of the split octonions. -/
def octonionTraceZero : Submodule (ZMod 2) (Atlas.SplitOctonion.Carrier (ZMod 2)) where
  carrier := {x | Atlas.SplitOctonion.trace x = 0}
  zero_mem' := by rfl
  add_mem' := by
    intro x y hx hy
    change x 3 + x 4 = 0 at hx
    change y 3 + y 4 = 0 at hy
    change (x 3 + y 3) + (x 4 + y 4) = 0
    linear_combination hx + hy
  smul_mem' := by
    intro a x hx
    change x 3 + x 4 = 0 at hx
    change a * x 3 + a * x 4 = 0
    rw [← mul_add, hx, mul_zero]

/-- The scalar line inside the trace-zero space, in characteristic two. -/
def octonionScalarLine : Submodule (ZMod 2) octonionTraceZero :=
  Submodule.span (ZMod 2) {⟨Atlas.SplitOctonion.unit, by change Atlas.SplitOctonion.trace Atlas.SplitOctonion.unit = 0; decide +kernel⟩}

/-- A G₂(2)-block uses G₂(2)′ and the natural six-dimensional quotient of
the trace-zero octonions by scalars. A quotient map and its intertwining
law specify the module; merely its dimension or a group-family tag would
not do so. -/
def IsG2TwoBlock (L : Type*) [Group L] : Prop :=
  IsShort L ∧
    ∃ rho : commutator (Atlas.G2.Model (ZMod 2)) →*
        MulAut (Multiplicative (Fin 6 → ZMod 2)),
      Nonempty (BlockModuleModel L rho) ∧
      ∃ pi : octonionTraceZero →ₗ[ZMod 2] (Fin 6 → ZMod 2),
        Function.Surjective pi ∧ pi.ker = octonionScalarLine ∧
        ∀ (g : commutator (Atlas.G2.Model (ZMod 2))) (x y : octonionTraceZero),
          y.val = g.val.val x.val →
          pi y = Multiplicative.toAdd (rho g (Multiplicative.ofAdd (pi x)))

/-- Extract only the core model, after retaining the full natural-module
assertion in `IsG2TwoBlock`. -/
theorem IsG2TwoBlock.quotient_model {L : Type*} [Group L] (h : IsG2TwoBlock L) :
    Nonempty ((L ⧸ pCore 2 L) ≃* commutator (Atlas.G2.Model (ZMod 2))) := by
  obtain ⟨_, rho, ⟨model⟩, _⟩ := h
  exact ⟨model.quotientIso⟩

/-- The actual projective model is retained by the flag formulation. -/
theorem IsBinaryPositiveRankParabolic.model {A : Type*} [Group A]
    {P : Subgroup A} {n : ℕ} (h : IsBinaryPositiveRankParabolic P n) :
    ClassicalGroup.IsPSL A n 2 := by
  obtain ⟨e, _⟩ := h
  exact ⟨ZMod 2, inferInstance, inferInstance, Nat.card_zmod 2, ⟨e⟩⟩

end CFSG.Quasithin.Chapter1.RadicalExclusions.ModelReduction.FullSieve.SourceInterface
