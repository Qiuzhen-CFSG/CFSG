module

public import CFSG.Quasithin.Chapter1.Section03.Radical.Exclusions.BlockContract
public import Theory.GroupTheory.DisjointCommutingProduct

/-!
# The center quotient of the two commuting radical factors

If X is generated by commuting subgroups A and B, their images in X/Z(X)
commute and have trivial intersection. Indeed, if a and b have the same image,
then a differs from b by a central element, so a centralizes both factors and
hence X. Multiplication therefore gives the actual direct-product equivalence.
The quotient preimage identifies each image with the source subgroup WZ(X).

This algebraic step assumes neither direct indecomposability nor a permutation
of the factors by automorphisms; those require the binary model analysis.
Source: Aschbacher–Smith, combined manuscript of 1 March 2004, proof of
Proposition 1.3.8, printed p.514.
-/

@[expose] public section

open Subgroup
namespace CFSG.Quasithin.Chapter1.RadicalExclusions

private theorem center_quotient_product {D : Type*} [Group D]
    (A B : Subgroup D) (hgen : A ⊔ B = ⊤) (hcomm : ⁅A, B⁆ = ⊥) :
    let q := QuotientGroup.mk' (center D)
    ∃ e : A.map q × B.map q ≃* (D ⧸ center D),
      ∀ a b, e (a, b) = (a : D ⧸ center D) * (b : D ⧸ center D) := by
  intro q
  have hAB : A ≤ centralizer (B : Set D) := commutator_eq_bot_iff_le_centralizer.mp hcomm
  have hBA := le_centralizer_iff.mp hAB
  have hd : Disjoint (A.map q) (B.map q) := by
    apply disjoint_def.mpr
    rintro x ⟨a, ha, rfl⟩ ⟨b, hb, he⟩
    have hz : a * b⁻¹ ∈ center D := by
      apply (QuotientGroup.eq_one_iff _).mp
      change q (a * b⁻¹) = 1
      rw [map_mul, map_inv, he, mul_inv_cancel]
    have haCA : a ∈ centralizer (A : Set D) := by
      have hh := (centralizer (A : Set D)).mul_mem (center_le_centralizer _ hz) (hBA hb)
      simpa only [inv_mul_cancel_right] using hh
    have haCB : a ∈ centralizer (B : Set D) := hAB ha
    have hzA : zpowers a ≤ centralizer (A : Set D) := zpowers_le.mpr haCA
    have hzB : zpowers a ≤ centralizer (B : Set D) := zpowers_le.mpr haCB
    have htop : (⊤ : Subgroup D) ≤ centralizer (zpowers a : Set D) :=
      hgen ▸ sup_le (le_centralizer_iff.mp hzA) (le_centralizer_iff.mp hzB)
    apply (QuotientGroup.eq_one_iff a).mpr
    apply mem_center_iff.mpr
    intro g
    exact ((mem_centralizer_iff.mp (htop (mem_top g))) a (mem_zpowers a)).symm
  have hc : A.map q ≤ centralizer (B.map q : Set (D ⧸ center D)) := by
    apply commutator_eq_bot_iff_le_centralizer.mp
    rw [← map_commutator, hcomm, Subgroup.map_bot]
  have hs : A.map q ⊔ B.map q = ⊤ := by
    rw [← Subgroup.map_sup, hgen]
    exact map_top_of_surjective q (QuotientGroup.mk'_surjective _)
  obtain ⟨e, he⟩ := exists_mulEquiv_prod_sup_of_disjoint_of_commuting _ _ hd hc
  refine ⟨e.trans ((MulEquiv.subgroupCongr hs).trans topEquiv), ?_⟩
  exact he

variable {G : Type*} [Group G]

/-- The actual image WZ(X)/Z(X) in X/Z(X). -/
def centerFactor (X W : Subgroup G) : Subgroup (X ⧸ center X) :=
  (W.subgroupOf X).map (QuotientGroup.mk' (center X))

/-- Commuting factors of X give a direct product on quotienting by Z(X).
The equivalence is multiplication of the two specified quotient images. -/
theorem centerFactor_product {X A B : Subgroup G}
    (hgen : A ⊔ B = X) (hcomm : ⁅A, B⁆ = ⊥) :
    ∃ e : centerFactor X A × centerFactor X B ≃* (X ⧸ center X),
      ∀ a b, e (a, b) = (a : X ⧸ center X) * (b : X ⧸ center X) := by
  have hAX : A ≤ X := le_sup_left.trans_eq hgen
  have hBX : B ≤ X := le_sup_right.trans_eq hgen
  have hs : A.subgroupOf X ⊔ B.subgroupOf X = ⊤ := by
    apply map_injective X.subtype_injective
    rw [Subgroup.map_sup, map_subgroupOf_eq_of_le hAX, map_subgroupOf_eq_of_le hBX,
      hgen, ← MonoidHom.range_eq_map, range_subtype]
  have hc : ⁅A.subgroupOf X, B.subgroupOf X⁆ = ⊥ := by
    apply map_injective X.subtype_injective
    rw [map_commutator, map_subgroupOf_eq_of_le hAX, map_subgroupOf_eq_of_le hBX,
      hcomm, Subgroup.map_bot]
  exact center_quotient_product _ _ hs hc

/-- Pulling the quotient factor back into G is exactly WZ(X). -/
theorem centerFactor_preimage {X W : Subgroup G} (hWX : W ≤ X) :
    ((centerFactor X W).comap (QuotientGroup.mk' (center X))).map X.subtype =
      W ⊔ (center X).map X.subtype := by
  rw [centerFactor, comap_map_eq, QuotientGroup.ker_mk', Subgroup.map_sup,
    map_subgroupOf_eq_of_le hWX]

end CFSG.Quasithin.Chapter1.RadicalExclusions
