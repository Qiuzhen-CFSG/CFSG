module

public import CFSG.Quasithin.Chapter1.Section03.Terminal.AlternatingFiveActions.ForcedOuter.Setup
public import Theory.GroupTheory.FrattiniConjugateFactors

/-!
# The Frattini contradiction in the terminal A₅ argument

The actual complement P is generated by A = P ∩ B and its specified
conjugate Aᵗ. If squares in N_T(P) normalize B and the B-stabilizer
centralizes A, the Frattini subgroup centralizes both factors. This
contradicts the source identity P = [P, Φ(N_T(P))].

The square-normalization assertion and the implication from inner action
on B/O₂(B) to centralization of A remain explicit premises. This module
proves the action reduction, not the unconditional A₅ source assertion.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*,
combined manuscript of 1 March 2004, Lemma 1.3.9(1), printed p.514.
-/

@[expose] public section

open Subgroup
namespace CFSG.Quasithin.Chapter1.Terminal.ForcedOuter
open XiEmbedding
variable {G : Type*} [Group G] [Finite G]
variable {p : ℕ} {T X P H B : Subgroup G}

/-- The source Frattini action prevents the component stabilizer from
centralizing the first factor, once squares preserve the component. -/
theorem stabilizer_not_le_centralizer
    (h : LocalInput p T X P H) (hswap : SwappedFactors T P B)
    (hsquares : ∀ s ∈ T ⊓ normalizer P, s ^ 2 ∈ normalizer B) :
    ¬ (T ⊓ normalizer P) ⊓ normalizer B ≤ centralizer (P ⊓ B : Set G) := by
  intro hc
  obtain ⟨t, ht, _, hgen, _, _⟩ := hswap.2
  have hphi := h.two_group.to_inf_left.frattini_map_le_centralizer_conjugate_sup
    ht hgen hsquares hc
  have hbot : P = ⊥ := h.frattini_commutator.trans (by
    rw [commutator_comm]
    exact commutator_eq_bot_iff_le_centralizer.mpr hphi)
  apply h.complement_not_cyclic
  rw [hbot]
  infer_instance

/-- The remaining two local action assertions suffice for the forced outer
action, retaining the actual normalizer and intrinsic quotient. -/
theorem not_le_inner_of_squares_of_inner_stabilizer
    (h : LocalInput p T X P H) (hswap : SwappedFactors T P B)
    (hsquares : ∀ s ∈ T ⊓ normalizer P, s ^ 2 ∈ normalizer B)
    (hinner : ((T ⊓ normalizer P) ⊓ normalizer B) ⊓ innerTwoQuotientNormalizer B ≤
      centralizer (P ⊓ B : Set G)) :
    ¬ T ⊓ normalizer B ≤ innerTwoQuotientNormalizer B := by
  intro hle
  apply stabilizer_not_le_centralizer h hswap hsquares
  intro s hs
  exact hinner ⟨hs, hle ⟨hs.1.1, hs.2⟩⟩

omit [Finite G] in
/-- An actual index-two relative normalizer supplies square normalization.
The index is relative to the specified overgroup H. -/
theorem squares_normalize_of_relative_index_two
    (hTH : T ≤ H) (hBH : B ≤ H)
    (hi : (normalizer (B.subgroupOf H : Set H)).index = 2) :
    ∀ s ∈ T ⊓ normalizer P, s ^ 2 ∈ normalizer B := by
  intro s hs
  have hm := (normalizer (B.subgroupOf H : Set H)).sq_mem_of_index_two hi
    (⟨s, hTH hs.1⟩ : H)
  rw [← subgroupOf_normalizer_eq hBH] at hm
  exact hm

end CFSG.Quasithin.Chapter1.Terminal.ForcedOuter
