  apply rank_certificate _ (fun i : Fin 24 => basis i.val)
    (fun i => fromRows i.val) (fun i => fromBasis i.val) pivots
  · have h : ∀ i : Fin 24, scan (fromRows i.val) pairRows 112 0 = basis i.val := by decide +kernel
