module
public import CFSG.Quasithin.Chapter1.Section03.Terminal.LinearFourActions.JankoFourStabilizer.InvariantMathieuGeometry.Max1Placement.Existence.SylowCover.Structure.OrderSpectrum.OutsideKernelOrders.MatrixCertificates.Coordinates
import Mathlib.Tactic.FinCases
/-!
# Exact subgroups generated by the proposed pair-count fibers

The high binary coordinates in rows 5–8 are closed under multiplication and
inversion, by checked collection in the already realized PC presentation.
Injectivity of the original candidate coordinates gives their orders 4, 4, 2,
and 8. Removing the identity does not change the generated subgroup.
These are unconditional subgroup facts. Identification with rank-count fibers
is a separate premise of `rankSpan_eq_spanSubgroup_of_counts` in `Counts.lean`.
Source context: Aschbacher–Smith A.3.12, printed pp.47–48;
Kleidman–Wilson (1988), pp.484–510.
-/

@[expose] public section

open Janko4 Subgroup Janko4.LocalStructure.SylowNormalEights
open Janko4.LocalStructure.SylowNormalEights.Presentation.Profiles
namespace CFSG.Quasithin.Chapter1.Terminal.LinearFourActions.JankoFourStabilizer.Max1Placement.SylowCover.OutsideKernelOrders.MatrixCertificates.PairCountFibers
attribute [local irreducible] modelGroup matrixA matrixB

def row (r : Fin 4) : Fin 9 := ⟨r.val + 5, by omega⟩
def spanSize (r : Fin 4) : ℕ := ![4,4,2,8] r
def step (r : Fin 4) : ℕ := ![16,32,64,32] r

def spanCoord (r : Fin 4) (n : Fin (spanSize r)) : Fin (candidateOrder (row r)) :=
  ⟨step r * n.val, by
    have h : ∀ r : Fin 4, step r * spanSize r = candidateOrder (row r) := by decide +kernel
    have hp : ∀ r : Fin 4, 0 < step r := by decide +kernel
    rw [← h r]
    exact Nat.mul_lt_mul_of_pos_left n.isLt (hp r)⟩

noncomputable def spanPoint (r : Fin 4) (n : Fin (spanSize r)) : Model :=
  point (row r) (spanCoord r n)

theorem spanSize_pos (r : Fin 4) : 0 < spanSize r :=
  (by decide +kernel : ∀ r : Fin 4, 0 < spanSize r) r

instance (r : Fin 4) : NeZero (spanSize r) := ⟨Nat.ne_of_gt (spanSize_pos r)⟩

theorem spanPoint_zero (r : Fin 4) : spanPoint r 0 = 1 := by
  have h : ∀ r : Fin 4, selectWords (candidateWords (row r)) (spanCoord r 0).val = [] := by decide +kernel
  simp only [spanPoint, point_eq_word, h, List.map_nil, List.prod_nil]

theorem spanPoint_mul (r : Fin 4) (a b : Fin (spanSize r)) :
    spanPoint r a * spanPoint r b =
      spanPoint r (Fin.ofNat (spanSize r) (a.val ^^^ b.val)) := by
  have h : ∀ (r : Fin 4) (a b : Fin (spanSize r)),
      collect 128 (selectWords (candidateWords (row r)) (spanCoord r a).val ++
        selectWords (candidateWords (row r)) (spanCoord r b).val) =
      selectWords (candidateWords (row r))
        (spanCoord r (Fin.ofNat (spanSize r) (a.val ^^^ b.val))).val := by
    intro r
    fin_cases r <;> decide +kernel
  change realization _ * realization _ = realization _
  rw [← map_mul]
  apply congrArg realization
  simpa only [abstractPoint, wordValue_append] using wordValue_eq_of_collect 128 _ _ (h r a b)

theorem spanPoint_inv (r : Fin 4) (a : Fin (spanSize r)) :
    (spanPoint r a)⁻¹ = spanPoint r a := by
  apply inv_eq_of_mul_eq_one_right
  rw [spanPoint_mul]
  have h : Fin.ofNat (spanSize r) (a.val ^^^ a.val) = 0 := by simp
  rw [h, spanPoint_zero]

noncomputable def spanSubgroup (r : Fin 4) : Subgroup Model where
  carrier := Set.range (spanPoint r)
  one_mem' := ⟨0, spanPoint_zero r⟩
  mul_mem' := by
    rintro _ _ ⟨a, rfl⟩ ⟨b, rfl⟩
    exact ⟨_, (spanPoint_mul r a b).symm⟩
  inv_mem' := by
    rintro _ ⟨a, rfl⟩
    exact ⟨a, (spanPoint_inv r a).symm⟩

theorem spanPoint_injective (r : Fin 4) : Function.Injective (spanPoint r) := by
  intro a b hab
  have h := congrArg Fin.val (point_injective (row r) hab)
  change step r * a.val = step r * b.val at h
  have hp : ∀ r : Fin 4, 0 < step r := by decide +kernel
  exact Fin.ext (Nat.eq_of_mul_eq_mul_left (hp r) h)

theorem spanSubgroup_card (r : Fin 4) : Nat.card (spanSubgroup r) = spanSize r := by
  let e : Fin (spanSize r) ≃ spanSubgroup r :=
    Equiv.ofBijective (fun n => ⟨spanPoint r n, ⟨n, rfl⟩⟩) (by
      constructor
      · intro a b h
        exact spanPoint_injective r (congrArg (fun x : spanSubgroup r => (x : Model)) h)
      · rintro ⟨x, n, rfl⟩
        exact ⟨n, rfl⟩)
  rw [← Nat.card_congr e, Nat.card_fin]

def fiberCoords (r : Fin 4) : Set (Fin (candidateOrder (row r))) :=
  {n | ∃ a : Fin (spanSize r), a ≠ 0 ∧ spanCoord r a = n}

theorem fiber_closure (r : Fin 4) :
    Subgroup.closure (point (row r) '' fiberCoords r) = spanSubgroup r := by
  apply le_antisymm
  · apply (Subgroup.closure_le _).mpr
    rintro x ⟨n, ⟨a, ha, rfl⟩, rfl⟩
    exact ⟨a, rfl⟩
  · rintro x ⟨a, rfl⟩
    by_cases ha : a = 0
    · rw [ha, spanPoint_zero]
      exact Subgroup.one_mem _
    · exact Subgroup.subset_closure ⟨spanCoord r a, ⟨a, ha, rfl⟩, rfl⟩

theorem fiber_closure_card (r : Fin 4) :
    Nat.card (Subgroup.closure (point (row r) '' fiberCoords r)) =
      candidateSpanOrder (row r) := by
  rw [fiber_closure, spanSubgroup_card]
  exact (by decide +kernel : ∀ r : Fin 4, spanSize r = candidateSpanOrder (row r)) r

end CFSG.Quasithin.Chapter1.Terminal.LinearFourActions.JankoFourStabilizer.Max1Placement.SylowCover.OutsideKernelOrders.MatrixCertificates.PairCountFibers
