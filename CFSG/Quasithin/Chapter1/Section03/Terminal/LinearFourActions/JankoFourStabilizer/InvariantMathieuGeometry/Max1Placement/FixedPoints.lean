module

public import CFSG.Quasithin.Chapter1.Section03.Terminal.LinearFourActions.JankoFourStabilizer.InvariantMathieuGeometry.Max1Placement.Candidates
public import Mathlib.GroupTheory.PGroup

/-!
# A sufficient fixed-point criterion for local max1 overgroups

The cyclic group generated by a two-power-order automorphism acts on the
candidate family whenever the automorphism preserves A. The orbit congruence
for two-groups supplies a fixed candidate if the family has odd cardinality.
The action transports the entire Sylow-local condition, as well as the actual
isomorphism with the certified max1 subgroup.

This proves only the finite-action step. No assertion that the J₄ candidate
family has odd cardinality or a unique member is made. Such a calculation
would be an additional geometric proof obligation in the Sylow-overgroup
argument of Aschbacher–Smith A.3.12(17), printed pp.47–48, used in 1.3.9,
printed p.514.
-/

public section

open Subgroup
open scoped Pointwise
namespace CFSG.Quasithin.Chapter1.Terminal.LinearFourActions.JankoFourStabilizer
universe u
variable {G : Type u} [Group G] [Finite G]

namespace Max1Placement

/-- A two-power-order automorphism has a fixed candidate whenever the candidate
family has odd cardinality. No parity assertion about the J₄ geometry is made. -/
theorem exists_fixed_candidate_of_odd {A : Subgroup G} (α : MulAut G)
    (htwo : ∃ n : ℕ, α ^ (2 ^ n) = 1) (hA : A.map α.toMonoidHom = A)
    (hodd : Odd (Nat.card (candidates A))) :
    ∃ H ∈ candidates A, H.map α.toMonoidHom = H := by
  have hstab : zpowers α ≤ MulAction.stabilizer (MulAut G) A :=
    zpowers_le.mpr (show α • A = A from hA)
  let : MulAction (zpowers α) (candidates A) := {
    smul := fun β H => ⟨(β : MulAut G) • H.val,
      map_mem_candidates_of_invariant H.property β.val (hstab β.property)⟩
    one_smul := fun H => Subtype.ext (one_smul (MulAut G) H.val)
    mul_smul := fun β γ H => Subtype.ext (mul_smul β.val γ.val H.val) }
  obtain ⟨n, hn⟩ := htwo
  have hp : IsPGroup 2 (zpowers α) := IsPGroup.of_card_dvd_pow (n := n) (by
    rw [Nat.card_zpowers]
    exact orderOf_dvd_of_pow_eq_one hn)
  obtain ⟨H, hH⟩ := hp.nonempty_fixed_point_of_prime_not_dvd_card
    (candidates A) hodd.not_two_dvd_nat
  exact ⟨H.val, H.property,
    congrArg Subtype.val (hH ⟨α, Subgroup.mem_zpowers α⟩)⟩

end Max1Placement
end CFSG.Quasithin.Chapter1.Terminal.LinearFourActions.JankoFourStabilizer
