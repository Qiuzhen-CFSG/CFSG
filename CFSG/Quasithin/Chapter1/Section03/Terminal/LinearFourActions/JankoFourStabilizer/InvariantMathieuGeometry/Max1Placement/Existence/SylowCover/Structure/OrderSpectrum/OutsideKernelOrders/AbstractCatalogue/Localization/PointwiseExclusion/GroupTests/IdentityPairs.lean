/-- Actual pairwise commutation forces the six identity-versus-conjugate tests. -/
theorem identityPairTests (hcard : Nat.card Carrier = 2^21)
    (hconj : CollectedConjugates) : ConjugateTestsBetween 12 18 := by
  intro b hc i hlo hhi
  have hi : i = 12 ∨ i = 13 ∨ i = 14 ∨ i = 15 ∨ i = 16 ∨ i = 17 := by omega
