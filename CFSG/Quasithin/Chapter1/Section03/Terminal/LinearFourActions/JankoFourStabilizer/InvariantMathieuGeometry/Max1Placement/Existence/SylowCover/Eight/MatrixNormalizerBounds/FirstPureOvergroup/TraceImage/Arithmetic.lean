private theorem packed_step {a b : Vector ℕ 112} (n : Fin 11)
    (h : ∀ i : Fin 112, fastPackedRow (a.get i) n = b.get i) :
    decodeRows b = decodeRows a * decodeRows (basisRows n) := by
  rw [← decode_packedMul]
  apply congrArg decodeRows
  symm
  apply packedMul_eq_of_rows
  intro i
  rw [← fastPackedRow_eq]
  exact h i

-- Each complete 112-row certificate has its own checking budget. Serialize these
-- measured kernel checks to avoid retaining several large reductions at once.
set_option Elab.async false

private theorem step0 : decodeRows p1 = decodeRows p0 * decodeRows (basisRows 2) :=
  packed_step 2 (by decide +kernel)

private theorem step1 : decodeRows p2 = decodeRows p1 * decodeRows (basisRows 6) :=
  packed_step 6 (by decide +kernel)

private theorem step2 : decodeRows p3 = decodeRows p2 * decodeRows (basisRows 7) :=
  packed_step 7 (by decide +kernel)

private theorem step3 : decodeRows q1 = decodeRows q0 * decodeRows (basisRows 3) :=
  packed_step 3 (by
    simp only [q0, plusRows, packedOne, get_ofFn]
    decide +kernel)

private theorem step4 : decodeRows q2 = decodeRows q1 * decodeRows (basisRows 4) :=
  packed_step 4 (by decide +kernel)

private theorem step5 : decodeRows q3 = decodeRows q2 * decodeRows (basisRows 7) :=
  packed_step 7 (by decide +kernel)

private theorem step6 : decodeRows q4 = decodeRows q3 * decodeRows (basisRows 9) :=
  packed_step 9 (by decide +kernel)

private theorem step7 : decodeRows q5 = decodeRows q4 * decodeRows (basisRows 10) :=
  packed_step 10 (by decide +kernel)

private theorem step8 : decodeRows r1 = decodeRows r0 * decodeRows (basisRows 0) :=
  packed_step 0 (by
    simp only [r0, q0, plusRows, packedOne, get_ofFn]
    decide +kernel)

private theorem step9 : decodeRows r2 = decodeRows r1 * decodeRows (basisRows 2) :=
  packed_step 2 (by decide +kernel)

private theorem step10 : decodeRows r3 = decodeRows r2 * decodeRows (basisRows 4) :=
  packed_step 4 (by decide +kernel)

private theorem step11 : decodeRows r4 = decodeRows r3 * decodeRows (basisRows 5) :=
  packed_step 5 (by decide +kernel)

private theorem step12 : decodeRows r5 = decodeRows r4 * decodeRows (basisRows 8) :=
  packed_step 8 (by decide +kernel)

private theorem step13 : decodeRows r6 = decodeRows r5 * decodeRows (basisRows 9) :=
  packed_step 9 (by decide +kernel)

/-- The checked plane-vector index of each of the 112 trace rows. -/
def rowIndex (i : Fin 112) : Fin 4 :=
  ![0,1,1,2,1,2,0,1,2,1,2,2,1,2,0,1,0,3,1,1,2,1,2,3,1,0,1,1,3,1,3,1,3,1,0,3,2,2,2,1,3,2,3,3,2,3,1,2,3,3,0,0,1,0,3,0,1,3,2,3,2,0,3,2,3,2,2,2,2,2,1,0,0,0,0,0,1,1,0,3,1,3,3,1,3,2,3,0,2,2,1,2,1,1,0,3,1,1,0,0,3,3,1,3,0,1,0,1,0,1,0,1] i
/-- The four literal packed vectors, with addition represented by XOR. -/
def planePacked (i : Fin 4) : ℕ :=
  ![0,1383886125678978288045195946262397,3683754961113342797877254413953002,
    1383886125678978288045195946262397 ^^^ 3683754961113342797877254413953002] i
private theorem final_rows : ∀ i : Fin 112,
    (plusRows r0 r6).get i = planePacked (rowIndex i) := by
  simp only [r0, q0, plusRows, packedOne, get_ofFn]
  decide +kernel

private theorem p_eval : decodeRows p3 =
    ((decodeRows (basisRows 1) * decodeRows (basisRows 2)) *
      decodeRows (basisRows 6)) * decodeRows (basisRows 7) := by
  rw [step2, step1, step0]
  rfl

private theorem q_eval : decodeRows q5 = decodeRows q0 *
    ((((decodeRows (basisRows 3) * decodeRows (basisRows 4)) * decodeRows (basisRows 7)) *
      decodeRows (basisRows 9)) * decodeRows (basisRows 10)) := by
  rw [step7, step6, step5, step4, step3]
  simp only [mul_assoc]

private theorem r_eval : decodeRows r6 = decodeRows r0 *
    (((((decodeRows (basisRows 0) * decodeRows (basisRows 2)) * decodeRows (basisRows 4)) *
      decodeRows (basisRows 5)) * decodeRows (basisRows 8)) * decodeRows (basisRows 9)) := by
  rw [step13, step12, step11, step10, step9, step8]
  simp only [mul_assoc]

/-- Complete matrix evaluation of the three displacement factors. -/
theorem factor_rows :
    (1 + ((decodeRows (basisRows 1) * decodeRows (basisRows 2)) *
      decodeRows (basisRows 6)) * decodeRows (basisRows 7)) *
    (1 + (((decodeRows (basisRows 3) * decodeRows (basisRows 4)) * decodeRows (basisRows 7)) *
      decodeRows (basisRows 9)) * decodeRows (basisRows 10)) *
    (1 + ((((decodeRows (basisRows 0) * decodeRows (basisRows 2)) * decodeRows (basisRows 4)) *
      decodeRows (basisRows 5)) * decodeRows (basisRows 8)) * decodeRows (basisRows 9)) =
    (fun i j => bit (planePacked (rowIndex i)) j.val : BinaryMatrix) := by
  have hp : decodeRows q0 = 1 + ((decodeRows (basisRows 1) * decodeRows (basisRows 2)) *
      decodeRows (basisRows 6)) * decodeRows (basisRows 7) := by
    rw [q0, decode_plus, decode_packedOne, p_eval]
  have hq : decodeRows r0 = decodeRows q0 *
      (1 + (((decodeRows (basisRows 3) * decodeRows (basisRows 4)) * decodeRows (basisRows 7)) *
        decodeRows (basisRows 9)) * decodeRows (basisRows 10)) := by
    rw [r0, decode_plus, q_eval, mul_add, mul_one]
  have hr : decodeRows (plusRows r0 r6) = decodeRows r0 *
      (1 + ((((decodeRows (basisRows 0) * decodeRows (basisRows 2)) * decodeRows (basisRows 4)) *
        decodeRows (basisRows 5)) * decodeRows (basisRows 8)) * decodeRows (basisRows 9)) := by
    rw [decode_plus, r_eval, mul_add, mul_one]
  rw [← hp, ← hq, ← hr]
  funext i j
  exact congrArg (fun n => bit n j.val) (final_rows i)
