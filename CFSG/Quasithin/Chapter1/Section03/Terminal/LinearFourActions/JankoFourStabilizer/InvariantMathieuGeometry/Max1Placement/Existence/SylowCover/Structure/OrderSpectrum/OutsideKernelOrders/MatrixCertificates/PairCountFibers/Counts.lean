/-- This is an arithmetic statement about the witness table only. -/
theorem expectedCount_fiber (r : Fin 4) (n : Fin (candidateOrder (row r))) :
    expectedCount r n = selectedCount r ↔ n ∈ fiberCoords r := by
  have h : ∀ (r : Fin 4) (n : Fin (candidateOrder (row r))),
      expectedCount r n = selectedCount r ↔ n ∈ fiberCoords r := by
    intro r
    fin_cases r <;> dsimp only [fiberCoords, Set.mem_ofPred_eq] <;> decide +kernel
  exact h r n

theorem candidateTest_row (r : Fin 4) :
    candidateTest (row r) = .pairCount 16 (selectedCount r) := by
  fin_cases r <;> rfl

/-- This premise counts every partner in the actual subgroup, including one. -/
def CountsCorrect : Prop := ∀ (r : Fin 4) (n : Fin (candidateOrder (row r))),
  pairRankCount (matrixFamily (row r)) (point (row r) n) 16 = expectedCount r n

/-- A complete count table identifies the actual generated subgroup. -/
theorem rankSpan_eq_spanSubgroup_of_counts (h : CountsCorrect) (r : Fin 4) :
    rankSpan (matrixFamily (row r)) (candidateTest (row r)) = spanSubgroup r := by
  have ht (n : Fin (candidateOrder (row r))) :
      (candidateTest (row r)).Holds (matrixFamily (row r)) (point (row r) n) ↔
        n ∈ fiberCoords r := by
    rw [candidateTest_row]
    change pairRankCount (matrixFamily (row r)) (point (row r) n) 16 = _ ↔ _
    rw [h r n, expectedCount_fiber]
  have hs : {x : Model | x ∈ matrixFamily (row r) ∧
      (candidateTest (row r)).Holds (matrixFamily (row r)) x} =
        point (row r) '' fiberCoords r := by
    ext x
    constructor
    · rintro ⟨hx, hc⟩
      obtain ⟨n, rfl⟩ := point_surjective (row r) x hx
      exact ⟨n, (ht n).mp hc, rfl⟩
    · rintro ⟨n, hn, rfl⟩
      exact ⟨point_mem (row r) n, (ht n).mpr hn⟩
  change Subgroup.closure _ = _
  rw [hs, fiber_closure]

/-- The remaining count premise yields the required order for each of rows 5–8. -/
theorem pairCount_span_orders_of_counts (h : CountsCorrect)
    (i : Fin 9) (hi : 5 ≤ i.val) :
    Nat.card (rankSpan (matrixFamily i) (candidateTest i)) = candidateSpanOrder i := by
  let r : Fin 4 := ⟨i.val - 5, by omega⟩
  have he : row r = i := by apply Fin.ext; dsimp [row, r]; omega
  rw [← he, rankSpan_eq_spanSubgroup_of_counts h, spanSubgroup_card]
  exact (by decide +kernel : ∀ r : Fin 4, spanSize r = candidateSpanOrder (row r)) r

