module
public import CFSG.Quasithin.Chapter1.Section03.Terminal.LinearFourActions.JankoFourStabilizer.InvariantMathieuGeometry.Max1Placement.Existence.SylowCover.Structure.OrderSpectrum.OutsideKernelOrders.MatrixCertificates.DisplacementFibers.OrbitTable
import Mathlib.Tactic.FinCases

/-!
# Exact subgroups generated by the selected displacement fibers

All selected coordinates are supported on the displayed PC generators.
Conversely, checked products of selected fiber coordinates give every one
of those generators. Unique PC normal forms and binary collection compute
the order of the resulting entire subgroup.
Source context: Aschbacher–Smith A.3.12, pp.47–48; Kleidman–Wilson (1988),
pp.484–510. The rank table is discharged in the enclosing DisplacementFibers.
-/

@[expose] public section
open Janko4 Subgroup Janko4.LocalStructure.SylowNormalEights
open Janko4.LocalStructure.SylowNormalEights.Presentation.Profiles
open Theory.GroupTheory.BinaryCollection
namespace CFSG.Quasithin.Chapter1.Terminal.LinearFourActions.JankoFourStabilizer.Max1Placement.SylowCover.OutsideKernelOrders.MatrixCertificates.DisplacementFibers
attribute [local irreducible] modelGroup matrixA matrixB

def spanGenerators : Fin 5 → List (Fin 21) :=
  ![[18, 19, 20], [16, 18, 19, 20], [16, 17, 18, 19, 20],
    [14, 16, 17, 18, 19, 20], [16, 17, 18, 19, 20]]

def selectedRank : Fin 5 → ℕ := ![50, 56, 50, 50, 50]

private theorem candidateTest_row (i : Fin 5) :
    candidateTest (row i) = .displacement (selectedRank i) := by
  fin_cases i <;> rfl

def abstractSpan (i : Fin 5) : Subgroup Presentation.Carrier :=
  closure {x | x ∈ (spanGenerators i).map Presentation.generator}

private theorem triangular_of_involutions {G : Type*} [Group G] (l : List G)
    (hs : ∀ a ∈ l, a * a = 1)
    (hc : ∀ a ∈ l, ∀ b ∈ l, a * b = b * a) : triangular l := by
  induction l with
  | nil => trivial
  | cons a l ih =>
    refine ⟨?_, ?_, ?_⟩
    · rw [hs a List.mem_cons_self]
      exact (Subgroup.closure _).one_mem
    · intro b hb
      have he : a⁻¹ * b * a = b := by
        rw [mul_assoc, ← hc a List.mem_cons_self b (List.mem_cons_of_mem a hb),
          inv_mul_cancel_left]
      rw [he]
      exact Subgroup.subset_closure hb
    · exact ih (fun b hb => hs b (List.mem_cons_of_mem a hb))
        (fun b hb c hc' => hc b (List.mem_cons_of_mem a hb) c (List.mem_cons_of_mem a hc'))

private theorem span_triangular (i : Fin 5) :
    triangular ((spanGenerators i).map Presentation.generator) := by
  have hs : ∀ (i : Fin 5) (a : Fin 21), a ∈ spanGenerators i →
      collect 64 [a, a] = [] := by decide +kernel
  have hc : ∀ (i : Fin 5) (a b : Fin 21), a ∈ spanGenerators i → b ∈ spanGenerators i →
      collect 64 [a, b] = collect 64 [b, a] := by decide +kernel
  apply triangular_of_involutions
  · intro x hx
    obtain ⟨a, ha, rfl⟩ := List.mem_map.mp hx
    simpa only [wordValue_cons, wordValue_nil, mul_one] using
      wordValue_eq_of_collect 64 _ _ (hs i a ha)
  · intro x hx y hy
    obtain ⟨a, ha, rfl⟩ := List.mem_map.mp hx
    obtain ⟨b, hb, rfl⟩ := List.mem_map.mp hy
    have he := (collect_sound 64 [a, b]).symm.trans
      ((congrArg wordValue (hc i a b ha hb)).trans (collect_sound 64 [b, a]))
    simpa only [wordValue_cons, wordValue_nil, mul_one] using he

theorem abstractSpan_card (i : Fin 5) :
    Nat.card (abstractSpan i) = candidateSpanOrder (row i) := by
  have hs : (spanGenerators i).Sublist (List.finRange 21) :=
    (by decide +kernel : ∀ i : Fin 5, (spanGenerators i).Sublist (List.finRange 21)) i
  have h := card_closure_of_sublist (hs.map Presentation.generator) (span_triangular i)
    (Presentation.normalForm_bijective_of_card presentation_card).injective
  change Nat.card (abstractSpan i) = _ at h
  rw [h]
  simpa only [List.length_map] using
    (by decide +kernel : ∀ i : Fin 5,
      2^(spanGenerators i).length = candidateSpanOrder (row i)) i

private theorem wordValue_mem_abstractSpan (i : Fin 5) (w : List (Fin 21))
    (hw : ∀ j ∈ w, j ∈ spanGenerators i) : wordValue w ∈ abstractSpan i := by
  apply Subgroup.list_prod_mem
  intro x hx
  obtain ⟨j, hj, rfl⟩ := List.mem_map.mp hx
  exact Subgroup.subset_closure (List.mem_map.mpr ⟨j, hw j hj, rfl⟩)

private theorem fiber_supported (i : Fin 5) (n : Fin (candidateOrder (row i)))
    (h : rankLabel i n.val = selectedRank i) :
    ∀ j ∈ selectWords (candidateWords (row i)) n.val, j ∈ spanGenerators i := by
  have hc : ∀ (i : Fin 5) (n : Fin (candidateOrder (row i))),
      rankLabel i n.val = selectedRank i →
      ∀ j ∈ selectWords (candidateWords (row i)) n.val, j ∈ spanGenerators i := by
    intro i
    fin_cases i <;> decide +kernel
  exact hc i n h

private instance rowOrder_neZero (i : Fin 5) : NeZero (candidateOrder (row i)) :=
  ⟨by have h := candidateSpanOrder_bounds (row i); omega⟩

private def factorIndices (i : Fin 5) (j : Fin 21) : List ℕ :=
  match i.val, j.val with
  | 0, 18 => [4]
  | 0, 19 => [8]
  | 0, 20 => [16]
  | 1, 16 => [2]
  | 1, 18 => [2, 6]
  | 1, 19 => [2, 10]
  | 1, 20 => [2, 18]
  | 2, 16 => [12, 14]
  | 2, 17 => [8, 12]
  | 2, 18 => [8]
  | 2, 19 => [16]
  | 2, 20 => [32]
  | 3, 14 => [12, 14]
  | 3, 16 => [18, 22]
  | 3, 17 => [6, 14]
  | 3, 18 => [16]
  | 3, 19 => [32]
  | 3, 20 => [64]
  | 4, 16 => [24, 28]
  | 4, 17 => [16, 24]
  | 4, 18 => [16]
  | 4, 19 => [32]
  | 4, 20 => [64]
  | _, _ => []

private def factors (i : Fin 5) (j : Fin 21) : List (Fin (candidateOrder (row i))) :=
  (factorIndices i j).map (Fin.ofNat _)


private theorem factors_check (i : Fin 5) (j : Fin 21) (hj : j ∈ spanGenerators i) :
    (∀ n ∈ factors i j, rankLabel i n.val = selectedRank i) ∧
    collect 128 ((factors i j).flatMap
      (fun n => selectWords (candidateWords (row i)) n.val)) = [j] := by
  have hc : ∀ (i : Fin 5) (j : Fin 21), j ∈ spanGenerators i →
      (∀ n ∈ factors i j, rankLabel i n.val = selectedRank i) ∧
      collect 128 ((factors i j).flatMap
        (fun n => selectWords (candidateWords (row i)) n.val)) = [j] := by
    intro i
    fin_cases i <;> decide +kernel
  exact hc i j hj

/-- The complete fiber generates exactly the indicated literal PC subgroup. -/
theorem rankSpan_eq_of_table
    (hr : ∀ (i : Fin 5) (n : Fin (candidateOrder (row i))),
      displacementRank (point (row i) n) = rankLabel i n.val) (i : Fin 5) :
    rankSpan (matrixFamily (row i)) (candidateTest (row i)) =
      (abstractSpan i).map realization := by
  rw [candidateTest_row]
  apply le_antisymm
  · apply (Subgroup.closure_le _).mpr
    rintro x ⟨hx, ht⟩
    obtain ⟨n, rfl⟩ := point_surjective (row i) x hx
    change displacementRank (point (row i) n) = selectedRank i at ht
    rw [hr] at ht
    exact Subgroup.mem_map_of_mem realization
      (wordValue_mem_abstractSpan i _ (fiber_supported i n ht))
  · apply Subgroup.map_le_iff_le_comap.mpr
    apply (Subgroup.closure_le _).mpr
    intro x hx
    obtain ⟨j, hj, rfl⟩ := List.mem_map.mp hx
    change realization (Presentation.generator j) ∈
      rankSpan (matrixFamily (row i)) (.displacement (selectedRank i))
    obtain ⟨hf, he⟩ := factors_check i j hj
    have hm : ∀ l : List (Fin (candidateOrder (row i))),
        (∀ n ∈ l, rankLabel i n.val = selectedRank i) →
        realization (wordValue (l.flatMap
          (fun n => selectWords (candidateWords (row i)) n.val))) ∈
          rankSpan (matrixFamily (row i)) (.displacement (selectedRank i)) := by
      intro l
      induction l with
      | nil =>
        intro _
        simpa only [List.flatMap_nil, wordValue_nil, map_one] using
          (rankSpan (matrixFamily (row i)) (.displacement (selectedRank i))).one_mem
      | cons n l ih =>
        intro hl
        rw [List.flatMap_cons, wordValue_append, map_mul]
        apply Subgroup.mul_mem
        · apply Subgroup.subset_closure
          exact ⟨point_mem (row i) n, (hr i n).trans (hl n List.mem_cons_self)⟩
        · exact ih (fun m hm => hl m (List.mem_cons_of_mem n hm))
    have hp := hm (factors i j) hf
    have he' := wordValue_eq_of_collect 128 _ _ he
    simpa only [he', wordValue_cons, wordValue_nil, mul_one] using hp

/-- Cardinality of the subgroup generated by each entire selected displacement fiber. -/
theorem span_order_of_table
    (hr : ∀ (i : Fin 5) (n : Fin (candidateOrder (row i))),
      displacementRank (point (row i) n) = rankLabel i n.val) (i : Fin 5) :
    Nat.card (rankSpan (matrixFamily (row i)) (candidateTest (row i))) =
      candidateSpanOrder (row i) := by
  rw [rankSpan_eq_of_table hr, Subgroup.card_map_of_injective realization_injective,
    abstractSpan_card]

end CFSG.Quasithin.Chapter1.Terminal.LinearFourActions.JankoFourStabilizer.Max1Placement.SylowCover.OutsideKernelOrders.MatrixCertificates.DisplacementFibers
