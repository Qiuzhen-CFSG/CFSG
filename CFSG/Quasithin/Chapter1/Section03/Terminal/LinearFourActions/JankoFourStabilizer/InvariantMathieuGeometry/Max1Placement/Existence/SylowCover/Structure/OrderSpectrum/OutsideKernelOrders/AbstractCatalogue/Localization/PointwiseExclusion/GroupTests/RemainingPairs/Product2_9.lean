/-- Collection preserves the value of the two specified conjugate normal forms. -/
theorem collected_value (v : Monomial) :
    value (coordinates polynomials) v =
      value (coordinates (conjugatePolynomials 2) ++
        coordinates (conjugatePolynomials 9)) v := by
  calc
    _ = value (clean (coordinates polynomials)) v := (value_clean _ v).symm
    _ = value state85 v := congrArg (fun w => value w v) output_eq
    _ = value state0 v := value85 v
    _ = _ := congrArg (fun w => value w v) input_eq

/-- The inputs are the literal inverse conjugates supplied by the common producer. -/
theorem product_value (hconj : CollectedConjugates) (b : Boolean.Bits) :
    value (coordinates polynomials) (valuation b) =
      conjugateTest (boolValue b) (some 2) *
        conjugateTest (boolValue b) (some 9) := by
  rw [collected_value, value_append,
    value_selectedConjugate hconj 2 (by unfold selectedConjugate; decide) b,
    value_selectedConjugate hconj 9 (by unfold selectedConjugate; decide) b]

