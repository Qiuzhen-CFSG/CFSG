module

public import Theory.SpecificGroups.Janko4.Model.LocalStructure.SylowNormalEights.MatrixRealization.Arithmetic
public import Theory.SpecificGroups.Janko4.Model.Cardinality.LocalInvolutionCensus.FiberCensus.RepresentativeMatrices.Certificate

/-!
# Small rectangular certificates for the pair ranks

The upper bound uses sixteen spanning rows. The lower bound uses seventeen
row combinations with an identity pivot minor. The pair-product rows are
obtained from three group matrices and the identity by XOR.

Generated by source/generate.py. The literal ATLAS max1 kernel matrices
and bit convention come from KernelCount.Tables and Janko4.Model.Data.
All numerical witnesses are checked by Lean; Python is not trusted.
-/

@[expose] public section
namespace CFSG.Quasithin.Chapter1.Terminal.LinearFourActions.JankoFourStabilizer.Max1Placement.SylowCover.KernelOrders.PureNormalizers.PairRanks
open Janko4 Janko4.GeneratorCertificates
open Janko4.LocalStructure.SylowNormalEights.MatrixRealization
open Janko4.Cardinality.LocalInvolutionCensus.FiberCensus.RepresentativeMatrices

def pairRows (a b c : ℕ → ℕ) (i : ℕ) : ℕ :=
  c i ^^^ a i ^^^ b i ^^^ 2 ^ i

lemma pairRows_eq (a b c : ℕ → ℕ) :
    rowsMatrix (pairRows a b c) = rowsMatrix c - rowsMatrix a - rowsMatrix b + 1 := by
  funext i j
  change bit (c i.val ^^^ a i.val ^^^ b i.val ^^^ 2 ^ i.val) j.val = _
  simp only [bit_xor]
  have hn : ∀ x : ZMod 2, -x = x := by decide +kernel
  have he : bit (2 ^ i.val) j.val = (1 : BinaryMatrix) i j := by
    simpa only [packedOne, decodeRows, get_ofFn] using
      congrFun (congrFun decode_packedOne i) j
  simp only [he, sub_eq_add_neg, Matrix.add_apply, Matrix.neg_apply, hn, rowsMatrix]

lemma upper_certificate (rows basis coefficients : ℕ → ℕ)
    (h : ∀ i : Fin 112, scan (coefficients i.val) basis 16 0 = rows i.val) :
    (rowsMatrix rows).rank ≤ 16 := by
  have he : rowsMatrix rows =
      (decode (fun i : Fin 112 => coefficients i.val) : Matrix (Fin 112) (Fin 16) (ZMod 2)) *
      decode (fun i : Fin 16 => basis i.val) := by
    rw [← decode_combine]
    funext i j
    change bit (rows i.val) j.val = bit _ j.val
    congr 1
    simpa only [combine, scan_eq, Nat.zero_add] using (h i).symm
  rw [he]
  exact (Matrix.rank_mul_le_right _ _).trans
    (by simpa using (Matrix.rank_le_card_height
      (decode (fun i : Fin 16 => basis i.val) : Matrix (Fin 16) (Fin 112) (ZMod 2))))

lemma lower_certificate (rows basis coefficients : ℕ → ℕ) (pivots : Fin 17 → Fin 112)
    (h : ∀ i : Fin 17, scan (coefficients i.val) rows 112 0 = basis i.val)
    (hp : ∀ i j : Fin 17, bit (basis i.val) (pivots j).val = if i = j then 1 else 0) :
    17 ≤ (rowsMatrix rows).rank := by
  let E : Matrix (Fin 17) (Fin 112) (ZMod 2) := decode (fun i => basis i.val)
  have he : E =
      (decode (fun i : Fin 17 => coefficients i.val) : Matrix (Fin 17) (Fin 112) (ZMod 2)) *
      rowsMatrix rows := by
    change decode (fun i : Fin 17 => basis i.val) =
      decode (fun i : Fin 17 => coefficients i.val) * decode (fun i : Fin 112 => rows i.val)
    rw [← decode_combine]
    funext i j
    change bit (basis i.val) j.val = bit _ j.val
    congr 1
    simpa only [combine, scan_eq, Nat.zero_add] using (h i).symm
  have hp' : E.submatrix id pivots = 1 := by
    funext i j
    exact (hp i j).trans (Matrix.one_apply (i := i) (j := j)).symm
  calc
    17 = (1 : Matrix (Fin 17) (Fin 17) (ZMod 2)).rank := by simp
    _ = (E.submatrix id pivots).rank := by rw [hp']
    _ ≤ E.rank := Matrix.rank_submatrix_le _ _ _
    _ ≤ (rowsMatrix rows).rank := by rw [he]; exact Matrix.rank_mul_le_right _ _


end CFSG.Quasithin.Chapter1.Terminal.LinearFourActions.JankoFourStabilizer.Max1Placement.SylowCover.KernelOrders.PureNormalizers.PairRanks
