private def pivots : Fin 50 → Fin 112 := ![61,62,63,64,65,66,67,68,69,70,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111]

private theorem rows_rank : (rowsMatrix r364 - 1).rank = 50 := by
  have hd : rowsMatrix r364 - 1 =
      decodeRows (Vector.ofFn (fun i : Fin 112 => displacementRows i.val)) := by
    rw [← decode_ofFn, ← decode_displacement]
    apply congrArg decodeRows
    apply Vector.ext
    intro i hi
    change (displacement (Vector.ofFn (fun j : Fin 112 => r364 j.val))).get ⟨i, hi⟩ =
      (Vector.ofFn (fun j : Fin 112 => displacementRows j.val)).get ⟨i, hi⟩
    simpa only [displacement, get_ofFn] using
      (by decide +kernel : ∀ i : Fin 112,
        r364 i.val ^^^ 2^i.val = displacementRows i.val) ⟨i, hi⟩
  rw [hd]
  apply rank_certificate _ (fun i : Fin 50 => basis i.val)
    (fun i => fromRows i.val) (fun i => fromBasis i.val) pivots
  · have h : ∀ i : Fin 50, scan (fromRows i.val)
        displacementRows 112 0 = basis i.val := by decide +kernel
    simpa only [combine, displacement, get_ofFn, scan_eq, Nat.zero_add] using h
  · have h : ∀ i : Fin 112, scan (fromBasis i.val) basis 50 0 =
        displacementRows i.val := by decide +kernel
    simpa only [combine, displacement, get_ofFn, scan_eq, Nat.zero_add] using h
  · decide +kernel

/-- Rank attached to the exact word in the faithful ambient realization. -/
theorem rank_word_14_16 :
    displacementRank (realization (wordValue [14, 16])) = 50 := by
  simp only [wordValue_cons, wordValue_nil, map_mul,
    realization_generator, mul_one]
  unfold displacementRank
  rw [map_mul]
  change (matrixRepresentation (MatrixWords.pcGenerator 14) * matrixRepresentation (MatrixWords.pcGenerator 16) - 1).rank = 50
  rw [pc14_eval, pc16_eval, product428]
  exact rows_rank

