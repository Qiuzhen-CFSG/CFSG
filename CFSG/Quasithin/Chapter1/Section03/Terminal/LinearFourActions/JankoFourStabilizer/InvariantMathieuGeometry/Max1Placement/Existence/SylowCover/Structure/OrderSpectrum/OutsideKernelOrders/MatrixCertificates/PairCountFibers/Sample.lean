private def pivots : Fin 16 → Fin 112 := ![94,96,97,99,100,101,102,103,104,105,106,107,108,109,110,111]

private theorem rows_displacement (a b : ℕ → ℕ)
    (h : ∀ i : Fin 112, a i.val ^^^ 2^i.val = b i.val) :
    rowsMatrix a - 1 = rowsMatrix b := by
  rw [← decode_ofFn a, ← decode_ofFn b, ← decode_displacement]
  apply congrArg decodeRows
  apply Vector.ext
  intro i hi
  change (displacement (Vector.ofFn (fun j : Fin 112 => a j.val))).get ⟨i, hi⟩ =
    (Vector.ofFn (fun j : Fin 112 => b j.val)).get ⟨i, hi⟩
  simpa only [displacement, get_ofFn] using h ⟨i, hi⟩

private theorem left_displacement : rowsMatrix r220 - 1 = rowsMatrix leftRows :=
  rows_displacement _ _ (by decide +kernel)
private theorem right_displacement : rowsMatrix r197 - 1 = rowsMatrix rightRows :=
  rows_displacement _ _ (by decide +kernel)

private theorem pair_product :
    rowsMatrix leftRows * rowsMatrix rightRows = rowsMatrix pairRows :=
  matrix_product _ _ _ (by decide +kernel)

private theorem pair_rows_rank : (rowsMatrix pairRows).rank = 16 := by
  rw [← decode_ofFn]
  apply rank_certificate _ (fun i : Fin 16 => basis i.val)
    (fun i => fromRows i.val) (fun i => fromBasis i.val) pivots
  · have h : ∀ i : Fin 16, scan (fromRows i.val) pairRows 112 0 = basis i.val := by decide +kernel
    simpa only [combine, get_ofFn, scan_eq, Nat.zero_add] using h
  · have h : ∀ i : Fin 112, scan (fromBasis i.val) basis 16 0 = pairRows i.val := by decide +kernel
    simpa only [combine, get_ofFn, scan_eq, Nat.zero_add] using h
  · decide +kernel

theorem pairRank_pc13_pc19 :
    pairRank (MatrixWords.pcGenerator 13 : Model) (MatrixWords.pcGenerator 19 : Model) = 16 := by
  change ((matrixRepresentation (MatrixWords.pcGenerator 13) - 1) *
    (matrixRepresentation (MatrixWords.pcGenerator 19) - 1)).rank = 16
  rw [pc13_eval, pc19_eval, left_displacement, right_displacement, pair_product]
  exact pair_rows_rank

theorem pairRank_row6_1_32 :
    pairRank (point (6 : Fin 9) ⟨1, by decide +kernel⟩)
      (point (6 : Fin 9) ⟨32, by decide +kernel⟩) = 16 := by
  have ha : point (6 : Fin 9) ⟨1, by decide +kernel⟩ = (MatrixWords.pcGenerator 13 : Model) := by
    rw [point_eq_word]
    exact mul_one _
  have hb : point (6 : Fin 9) ⟨32, by decide +kernel⟩ = (MatrixWords.pcGenerator 19 : Model) := by
    rw [point_eq_word]
    exact mul_one _
  rw [ha, hb]
  exact pairRank_pc13_pc19
