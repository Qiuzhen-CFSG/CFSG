      (point (8 : Fin 9) ⟨128, by decide +kernel⟩) = 20 := by
  change ((toMatrix (point (8 : Fin 9) ⟨20, by decide +kernel⟩) - 1) *
    (toMatrix (point (8 : Fin 9) ⟨128, by decide +kernel⟩) - 1)).rank = 20
  rw [displacement20, displacement128, pair_product]
  exact pair_rows_rank

