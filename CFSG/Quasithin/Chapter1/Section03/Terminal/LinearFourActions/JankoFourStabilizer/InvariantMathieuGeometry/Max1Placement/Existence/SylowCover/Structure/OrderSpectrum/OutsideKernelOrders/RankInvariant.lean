module

public import Theory.SpecificGroups.Janko4.Model
public import Mathlib.LinearAlgebra.Matrix.Rank
public import Mathlib.Algebra.Group.Subgroup.Basic

/-!
# Conjugation invariants detecting reducibility of elementary matrix subgroups

Both the rank of `x - 1` and the number of `y` in a subgroup for which
`(x - 1)(y - 1)` has a prescribed rank are invariant under its full ambient
normalizer. The subgroup generated by any fiber of these invariants is
therefore invariant. A nontrivial proper fiber span obstructs irreducibility.

This is the representation-theoretic reduction for the outside-kernel branch
of the J₄ Sylow-overgroup analysis in Aschbacher–Smith A.3.12, pp.47–48.
The finite rank certificates and exhaustive subgroup catalogue are separate
obligations; this module assumes neither their values nor their completeness.
-/

@[expose] public section

namespace CFSG.Quasithin.Chapter1.Terminal.LinearFourActions.JankoFourStabilizer.Max1Placement.SylowCover.OutsideKernelOrders
open Janko4 Subgroup
attribute [local irreducible] modelGroup matrixA matrixB

/-- Rank of the displacement in the literal 112-dimensional representation. -/
noncomputable def displacementRank (x : Model) : ℕ := (toMatrix x - 1).rank

/-- Rank of the product of two displacements, with the original matrix convention. -/
noncomputable def pairRank (x y : Model) : ℕ :=
  ((toMatrix x - 1) * (toMatrix y - 1)).rank

private theorem rank_conjugate (g : Model) (X : BinaryMatrix) :
    (toMatrix g * X * toMatrix g⁻¹).rank = X.rank := by
  have hle : ∀ (h : Model) (Y : BinaryMatrix),
      (toMatrix h * Y * toMatrix h⁻¹).rank ≤ Y.rank := by
    intro h Y
    exact (Matrix.rank_mul_le_left _ _).trans (Matrix.rank_mul_le_right _ _)
  apply le_antisymm (hle g X)
  have h := hle g⁻¹ (toMatrix g * X * toMatrix g⁻¹)
  have hi : toMatrix g⁻¹ * toMatrix g = 1 := by
    rw [← map_mul, inv_mul_cancel, map_one]
  have he : toMatrix g⁻¹ * (toMatrix g * X * toMatrix g⁻¹) * toMatrix (g⁻¹)⁻¹ = X := by
    rw [inv_inv, ← mul_assoc, ← mul_assoc, hi, one_mul, mul_assoc, hi, mul_one]
  rwa [he] at h

private theorem displacement_conjugate (g x : Model) :
    toMatrix (g * x * g⁻¹) - 1 =
      toMatrix g * (toMatrix x - 1) * toMatrix g⁻¹ := by
  rw [map_mul, map_mul, mul_sub, mul_one, sub_mul,
    ← map_mul toMatrix g g⁻¹, mul_inv_cancel, map_one]

/-- The one-element rank is invariant under actual ambient conjugation. -/
theorem displacementRank_conjugate (g x : Model) :
    displacementRank (g * x * g⁻¹) = displacementRank x := by
  unfold displacementRank
  rw [displacement_conjugate, rank_conjugate]

/-- Simultaneous conjugation preserves the rank of a product of displacements. -/
theorem pairRank_conjugate (g x y : Model) :
    pairRank (g * x * g⁻¹) (g * y * g⁻¹) = pairRank x y := by
  unfold pairRank
  rw [displacement_conjugate, displacement_conjugate]
  have hi : toMatrix g⁻¹ * toMatrix g = 1 := by
    rw [← map_mul, inv_mul_cancel, map_one]
  have he : (toMatrix g * (toMatrix x - 1) * toMatrix g⁻¹) *
      (toMatrix g * (toMatrix y - 1) * toMatrix g⁻¹) =
      toMatrix g * ((toMatrix x - 1) * (toMatrix y - 1)) * toMatrix g⁻¹ := by
    simp only [mul_assoc, ← mul_assoc (toMatrix g⁻¹) (toMatrix g), hi, one_mul]
  rw [he, rank_conjugate]

/-- Count inside the whole actual subgroup, including its identity. -/
noncomputable def pairRankCount (A : Subgroup Model) (x : Model) (r : ℕ) : ℕ :=
  Nat.card {y : A // pairRank x y = r}

private def conjugationEquiv (A : Subgroup Model) (g : Model)
    (hg : g ∈ normalizer (A : Set Model)) : A ≃ A where
  toFun x := ⟨g * x * g⁻¹, (mem_normalizer_iff.mp hg x).mp x.property⟩
  invFun x := ⟨g⁻¹ * x * g, by
    simpa using (mem_normalizer_iff.mp ((normalizer (A : Set Model)).inv_mem hg) x).mp
      x.property⟩
  left_inv x := by apply Subtype.ext; simp [mul_assoc]
  right_inv x := by apply Subtype.ext; simp [mul_assoc]

/-- The normalizer permutes the set being counted, rather than merely preserving its size by assumption. -/
theorem pairRankCount_conjugate (A : Subgroup Model) (g : Model)
    (hg : g ∈ normalizer (A : Set Model)) (x : Model) (r : ℕ) :
    pairRankCount A (g * x * g⁻¹) r = pairRankCount A x r := by
  unfold pairRankCount
  symm
  apply Nat.card_congr
  refine Equiv.subtypeEquiv (conjugationEquiv A g hg) ?_
  intro y
  change pairRank x y = r ↔ pairRank (g * x * g⁻¹) (g * y * g⁻¹) = r
  rw [pairRank_conjugate]

/-- Two kinds of finite tests, with every matrix operation fixed. -/
inductive RankTest where
  | displacement (rank : ℕ)
  | pairCount (rank count : ℕ)

/-- Membership in a fiber of the selected conjugation invariant. -/
def RankTest.Holds (t : RankTest) (A : Subgroup Model) (x : Model) : Prop :=
  match t with
  | .displacement r => displacementRank x = r
  | .pairCount r c => pairRankCount A x r = c

/-- Conjugation preserves the test for every normalizer element. -/
theorem RankTest.holds_conjugate (t : RankTest) (A : Subgroup Model) (g : Model)
    (hg : g ∈ normalizer (A : Set Model)) (x : Model) :
    t.Holds A (g * x * g⁻¹) ↔ t.Holds A x := by
  cases t with
  | displacement r => exact congrArg (· = r) (displacementRank_conjugate g x) |>.to_iff
  | pairCount r c => exact congrArg (· = c) (pairRankCount_conjugate A g hg x r) |>.to_iff

/-- The subgroup generated by the fiber inside A. -/
noncomputable def rankSpan (A : Subgroup Model) (t : RankTest) : Subgroup Model :=
  closure {x | x ∈ A ∧ t.Holds A x}

theorem rankSpan_le (A : Subgroup Model) (t : RankTest) : rankSpan A t ≤ A :=
  (closure_le _).mpr (fun _ hx => hx.1)

/-- Every ambient normalizer element preserves the actual fiber span. -/
theorem normalizer_le_rankSpan_normalizer (A : Subgroup Model) (t : RankTest) :
    normalizer (A : Set Model) ≤ normalizer (rankSpan A t : Set Model) := by
  intro g hg
  apply normalizer_le_normalizer_closure {x | x ∈ A ∧ t.Holds A x}
  apply mem_set_normalizer_iff.mpr
  intro x
  exact and_congr (mem_normalizer_iff.mp hg x)
    (t.holds_conjugate A g hg x).symm

end CFSG.Quasithin.Chapter1.Terminal.LinearFourActions.JankoFourStabilizer.Max1Placement.SylowCover.OutsideKernelOrders
