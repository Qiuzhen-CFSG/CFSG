private lemma pairRows_swap (a b c : ℕ → ℕ) : pairRows a b c = pairRows b a c := by
  funext i
  unfold pairRows
  rw [Nat.xor_assoc (c i) (a i) (b i), Nat.xor_comm (a i) (b i),
    ← Nat.xor_assoc (c i) (b i) (a i)]

private lemma pairRows_rotate (a b c : ℕ → ℕ) : pairRows a b c = pairRows b c a := by
  funext i
  unfold pairRows
  rw [Nat.xor_comm (c i) (a i), Nat.xor_assoc (a i) (c i) (b i),
    Nat.xor_comm (c i) (b i), ← Nat.xor_assoc (a i) (b i) (c i)]

