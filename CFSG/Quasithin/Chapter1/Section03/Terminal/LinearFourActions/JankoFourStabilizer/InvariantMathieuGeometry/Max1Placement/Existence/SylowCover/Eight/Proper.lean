/-!
# Properness in the J₄ normal-eight recognition argument

A normal subgroup N of order eight lies in every ambient Sylow two-subgroup.
Choose the certified Sylow whose embedded center is generated by the first
ATLAS generator a. The nontrivial normal subgroup N meets that center, so
it contains a. The relations b^4 = 1 and (ab)^37 = 1 imply that a normally
generates the entire model. This contradicts the element ab of order 37
in N. Thus every ambient eight-subgroup has a proper normalizer.

The independently certified normal eight inside literal max4 then proves
max4 proper. No ambient simplicity, full group order, max4 quotient, or
classification of Sylow overgroups is used.

Source context: the order-eight branch of the Sylow-overgroup analysis cited
in Aschbacher–Smith A.3.12, printed pp.47–48. The normal-generation argument
and literal ATLAS generator provenance are in `Simplicity.Reduction` and
`GeneratorCertificates`; the concrete Sylow center is proved in
`OddIndex.CentralizerSylow`. The normal eight retains its word attribution
in the imported `Max4.NormalEight` module.
-/

public section

open Subgroup
namespace CFSG.Quasithin.Chapter1.Terminal.LinearFourActions.JankoFourStabilizer.Max1Placement.SylowCover
open Janko4 Janko4.LocalStructure.SymmetricLinear Janko4.OuterReduction.OddIndex
attribute [local irreducible] Janko4.modelGroup matrixA matrixB

/-- The actual ambient model has no normal subgroup of order eight. -/
theorem ambient_normal_card_ne_eight (N : Subgroup Model) [N.Normal] :
    Nat.card N ≠ 8 := by
  classical
  intro hN
  have hp : IsPGroup 2 N := IsPGroup.of_card (n := 3) (by simpa using hN)
  let P : Sylow 2 (centralizer ({Janko4.a} : Set Model)) := default
  obtain ⟨T, hT⟩ := centralizer_sylow_is_ambient P
  have hcenter : (center T).map T.toSubgroup.subtype = zpowers Janko4.a := by
    rw [hT]
    exact centralizer_sylow_center P
  have hNT : N ≤ T.toSubgroup := hp.le_sylow_of_normal T
  let A : Subgroup T := N.subgroupOf T.toSubgroup
  have hmap : A.map T.toSubgroup.subtype = N := map_subgroupOf_eq_of_le hNT
  have hA : A ≠ ⊥ := by
    intro heq
    have hbot : N = ⊥ := by rw [← hmap, heq, Subgroup.map_bot]
    simp [hbot] at hN
  have hmeet := center_inf_ne_bot_of_normal T.isPGroup' A hA
  obtain ⟨⟨t, ht⟩, htne⟩ := ne_bot_iff_exists_ne_one.mp hmeet
  have htZ : (t : Model) ∈ zpowers Janko4.a :=
    hcenter ▸ mem_map_of_mem T.toSubgroup.subtype ht.1
  have haN : Janko4.a ∈ N := by
    rw [mem_zpowers_iff_mem_range_orderOf, orderOf_a] at htZ
    obtain ⟨n, hn, he⟩ := Finset.mem_image.mp htZ
    have hn' : n < 2 := Finset.mem_range.mp hn
    interval_cases n
    · have he' : (t : Model) = 1 := by simpa using he.symm
      exact (htne (Subtype.ext (Subtype.ext he'))).elim
    · have he' : (t : Model) = Janko4.a := by simpa using he.symm
      exact he' ▸ ht.2
  have hgen : normalClosure ({Janko4.a} : Set Model) = ⊤ :=
    Janko4.Simplicity.normalClosure_a_eq_top toMatrix_a toMatrix_b b_pow_four (by
      simpa only [orderOf_a_mul_b] using pow_orderOf_eq_one (Janko4.a * Janko4.b))
  have htop : N = ⊤ := by
    apply top_unique
    rw [← hgen]
    exact normalClosure_le_normal (by simpa using haN)
  have hab : Janko4.a * Janko4.b ∈ N := htop ▸ mem_top _
  have hd := orderOf_dvd_natCard (⟨Janko4.a * Janko4.b, hab⟩ : N)
  rw [← orderOf_coe, orderOf_a_mul_b, hN] at hd
  norm_num at hd

/-- The full ambient normalizer of any subgroup of order eight is proper. -/
theorem eight_ambient_normalizer_ne_top (U : Subgroup Model) (hU : Nat.card U = 8) :
    normalizer (U : Set Model) ≠ ⊤ := by
  intro h
  let : U.Normal := normalizer_eq_top_iff.mp h
  exact ambient_normal_card_ne_eight U hU

/-- The certified normal eight makes the literal max4 word subgroup proper. -/
theorem literal_max4_ne_top : max4Subgroup ≠ (⊤ : Subgroup Model) := by
  let E := NormalEight.eight
  let : E.Normal := NormalEight.normal_eight
  have hN : max4Subgroup ≤ normalizer (E.map max4Subgroup.subtype : Set Model) := by
    simpa only [normalizer_eq_top, ← MonoidHom.range_eq_map, range_subtype] using
      E.le_normalizer_map max4Subgroup.subtype
  have hcard : Nat.card (E.map max4Subgroup.subtype) = 8 :=
    (card_map_of_injective max4Subgroup.subtype_injective).trans NormalEight.card_eight
  intro h
  exact eight_ambient_normalizer_ne_top _ hcard (top_unique (h ▸ hN))

end CFSG.Quasithin.Chapter1.Terminal.LinearFourActions.JankoFourStabilizer.Max1Placement.SylowCover
