private theorem pair_product :
    rowsMatrix disp16 * rowsMatrix disp32 = rowsMatrix pairRows :=
  matrix_product _ _ _ (by decide +kernel)

private theorem pair_rows_rank : (rowsMatrix pairRows).rank = 20 := by
  rw [← decode_ofFn]
  apply rank_certificate _ (fun i : Fin 20 => basis i.val)
    (fun i => fromRows i.val) (fun i => fromBasis i.val) pivots
  · have h : ∀ i : Fin 20, scan (fromRows i.val) pairRows 112 0 = basis i.val := by decide +kernel
    simpa only [combine, get_ofFn, scan_eq, Nat.zero_add] using h
  · have h : ∀ i : Fin 112, scan (fromBasis i.val) basis 20 0 = pairRows i.val := by decide +kernel
    simpa only [combine, get_ofFn, scan_eq, Nat.zero_add] using h
  · decide +kernel

