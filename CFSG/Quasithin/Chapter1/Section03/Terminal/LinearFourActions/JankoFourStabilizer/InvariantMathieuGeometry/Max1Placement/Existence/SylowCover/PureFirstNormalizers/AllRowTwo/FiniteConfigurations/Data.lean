/-- The subgroup generated by the literal words of the indicated row.
The finite membership and cardinality certificates are proved separately. -/
@[expose] def row (i : Fin 26) : Subgroup Model :=
  closure (nativeWord '' (rowMasks i : Set (Fin 8192)))

/-- Indices of the sixteen candidates, in the same order as `row`. -/
@[expose] def sixteenIndex (i : Fin 10) : Fin 26 := ⟨16 + i.val, by omega⟩

/-- Indices of the eight candidates. -/
@[expose] def eightIndex (i : Fin 16) : Fin 26 := ⟨i.val, by omega⟩

/-- The finite list of sixteen candidates containing an eight, read literally
from the mask sets. Equality with the ambient `sixteenOvergroups` family is a
separate mathematical obligation. -/
@[expose] def listedSixteenOvergroups (i : Fin 16) : Finset (Fin 10) :=
  Finset.univ.filter fun j => rowMasks (eightIndex i) ⊆ rowMasks (sixteenIndex j)

end Janko4.LocalStructure.PureFirstNormalizers.AllRowTwo.FiniteConfigurations
