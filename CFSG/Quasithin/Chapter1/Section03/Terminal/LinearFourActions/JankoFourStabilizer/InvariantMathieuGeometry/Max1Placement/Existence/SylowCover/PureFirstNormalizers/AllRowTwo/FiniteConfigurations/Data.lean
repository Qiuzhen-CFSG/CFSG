  {0,1,1578,1579,2978,2979,3464,3465,4716,4717,5190,5191,6606,6607,8164,8165},
  {0,1,564,565,3464,3465,4028,4029,5190,5191,5746,5747,6606,6607,7162,7163},
  {0,1,1246,1247,2980,2981,3962,3963,4714,4715,5812,5813,6606,6607,7440,7441},
  {0,1,198,199,2390,2391,2448,2449,4190,4191,4248,4249,6408,6409,6606,6607},
  {0,1,564,565,2448,2449,2980,2981,4190,4191,4714,4715,6606,6607,7162,7163},
