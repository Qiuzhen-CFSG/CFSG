private def pivots46 : Fin 16 → Fin 112 := ![95,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111]

private theorem pair_product46 :
    rowsMatrix displacement16 * rowsMatrix displacement32 = rowsMatrix pairRows46 :=
  matrix_product _ _ _ (by decide +kernel)

private theorem pair_rows_rank46 : (rowsMatrix pairRows46).rank = 16 := by
  rw [← decode_ofFn]
  apply rank_certificate _ (fun i : Fin 16 => basis46 i.val)
    (fun i => fromRows46 i.val) (fun i => fromBasis46 i.val) pivots46
  · have h : ∀ i : Fin 16, scan (fromRows46 i.val) pairRows46 112 0 = basis46 i.val := by decide +kernel
    simpa only [combine, get_ofFn, scan_eq, Nat.zero_add] using h
  · have h : ∀ i : Fin 112, scan (fromBasis46 i.val) basis46 16 0 = pairRows46 i.val := by decide +kernel
    simpa only [combine, get_ofFn, scan_eq, Nat.zero_add] using h
  · decide +kernel

/-- Representative entry 46, using the literal row-six coordinates. -/
theorem rank46 :
    pairRank (point (6 : Fin 9) ⟨16, by decide +kernel⟩)
      (point (6 : Fin 9) ⟨32, by decide +kernel⟩) = 16 := by
  unfold pairRank
  rw [coordinate16_displacement, coordinate32_displacement, pair_product46]
  exact pair_rows_rank46

