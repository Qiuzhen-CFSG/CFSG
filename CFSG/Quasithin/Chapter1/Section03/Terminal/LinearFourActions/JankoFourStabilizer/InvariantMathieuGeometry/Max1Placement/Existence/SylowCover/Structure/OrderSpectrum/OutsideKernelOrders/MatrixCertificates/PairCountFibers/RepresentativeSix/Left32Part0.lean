private def pivots50 : Fin 16 → Fin 112 := ![93,95,97,99,100,101,102,103,104,105,106,107,108,109,110,111]

private theorem pair_product50 :
    rowsMatrix displacement32 * rowsMatrix displacement64 = rowsMatrix pairRows50 :=
  matrix_product _ _ _ (by decide +kernel)

private theorem pair_rows_rank50 : (rowsMatrix pairRows50).rank = 16 := by
  rw [← decode_ofFn]
  apply rank_certificate _ (fun i : Fin 16 => basis50 i.val)
    (fun i => fromRows50 i.val) (fun i => fromBasis50 i.val) pivots50
  · have h : ∀ i : Fin 16, scan (fromRows50 i.val) pairRows50 112 0 = basis50 i.val := by decide +kernel
    simpa only [combine, get_ofFn, scan_eq, Nat.zero_add] using h
  · have h : ∀ i : Fin 112, scan (fromBasis50 i.val) basis50 16 0 = pairRows50 i.val := by decide +kernel
    simpa only [combine, get_ofFn, scan_eq, Nat.zero_add] using h
  · decide +kernel

