module

public import CFSG.Quasithin.Chapter1.Section03.Terminal.LinearFourActions.JankoFourStabilizer.InvariantMathieuGeometry.Max1Placement.Existence.SylowCover.Structure.OrderSpectrum.Reduction

/-!
# Literal kernel subgroups for the small central-closure order calculation

The six rows below specify actual matrix subgroups by evaluation in the
existing binary coordinates of the literal max1 kernel. They are the proposed
Sylow-invariant subspaces containing no element ambient-conjugate to the 2B
seed. Exhaustiveness and orders remain separate obligations. The two proposed
orders four and sixteen require full ambient-normalizer analysis.

Source context: Aschbacher--Smith A.3.12, printed pp.47--48, referring to
Aschbacher (1986), no.343; Kleidman--Wilson (1988), pp.484--510.
The coordinates and left-conjugation convention are those of the checked
ATLAS max1 kernel and `SylowCore.Transport.Coordinates`.
-/

@[expose] public section
namespace CFSG.Quasithin.Chapter1.Terminal.LinearFourActions.JankoFourStabilizer.Max1Placement.SylowCover.KernelOrders
open Subgroup Janko4 Janko4.Cardinality
open Janko4.Cardinality.QuotientCount.Image

attribute [local irreducible] modelGroup matrixA matrixB max1Subgroup localKernel

/-- Evaluation of a binary mask in the literal embedded kernel. -/
def maskElement (m : ℕ) : Model :=
  ((coordinates matrixA_mul_self matrixB_pow_four (fun i => m.testBit i.val) :
    max1Subgroup matrixA_mul_self matrixB_pow_four) : Model)

theorem maskElement_mem (m : ℕ) : maskElement m ∈ orderSpectrumKernel :=
  mem_map.mpr ⟨_, (coordinates matrixA_mul_self matrixB_pow_four
    (fun i => m.testBit i.val)).property, rfl⟩

/-- Proposed bases for the six invariant subspaces with no 2B element. -/
def candidateRows : Fin 6 → List ℕ :=
  ![[], [198], [1387, 198], [1387, 571, 198], [1387, 821, 198],
    [1049, 583, 370, 198]]

/-- Each candidate is generated by specified elements of the original matrix group. -/
def candidate (i : Fin 6) : Subgroup Model :=
  closure (maskElement '' {m | m ∈ candidateRows i})

theorem candidate_le_kernel (i : Fin 6) : candidate i ≤ orderSpectrumKernel := by
  apply (closure_le _).mpr
  rintro _ ⟨m, _, rfl⟩
  exact maskElement_mem m

@[simp] theorem candidate_zero : candidate 0 = ⊥ := by
  simp [candidate, candidateRows]

/-- The proposed order-four and order-sixteen candidates. -/
def exceptionalIndex : Fin 2 → Fin 6 := ![2, 5]

/-- The literal 276-orbit seed, as an element of the ambient matrix model. -/
def classSeed : Model :=
  (localKernelSeed matrixA_mul_self matrixB_pow_four : Model)

/-- Exhaustiveness and orders under an actual ambient-fusion exclusion. Still a proof obligation. -/
def PureKernelCatalogue : Prop :=
  (∀ A : Subgroup Model, A ≤ orderSpectrumKernel →
    Janko4.OuterReduction.OddIndex.twoSubgroup ≤ normalizer (A : Set Model) →
    (∀ u ∈ A, ¬ IsConj u classSeed) → ∃ i : Fin 6, A = candidate i) ∧
  ∀ i : Fin 6, Nat.card (candidate i) = 2 ^ (candidateRows i).length

/-- Concrete witnesses excluding the two exceptional full normalizers.
Either their normalizer has a strict proper overgroup, or its action preserves
a proper nonzero subgroup. Neither alternative is assumed to hold. -/
def ExceptionalNormalizerObstructions : Prop :=
  ∀ j : Fin 2,
    (∃ H : Subgroup Model,
      normalizer (candidate (exceptionalIndex j) : Set Model) < H ∧ H < ⊤) ∨
    (∃ B : Subgroup Model, B < candidate (exceptionalIndex j) ∧ B ≠ ⊥ ∧
      normalizer (candidate (exceptionalIndex j) : Set Model) ≤ normalizer (B : Set Model))

end CFSG.Quasithin.Chapter1.Terminal.LinearFourActions.JankoFourStabilizer.Max1Placement.SylowCover.KernelOrders
