/-- The common producer must prove these nine identities in the actual group. -/
def CollectedConjugates : Prop :=
  ∀ i : Fin 21, selectedConjugate i → ∀ v : Monomial,
    value (coordinates (conjugatePolynomials i)) v = value (conjugateInput (some i)) v

theorem value_selectedConjugate (hc : CollectedConjugates)
    (i : Fin 21) (hi : selectedConjugate i) (b : Boolean.Bits) :
    value (coordinates (conjugatePolynomials i)) (valuation b) =
      conjugateTest (boolValue b) (some i) :=
  (hc i hi (valuation b)).trans (value_conjugateInput b (some i))

