module

public import CFSG.Quasithin.Chapter1.Section03.Terminal.LinearFourActions.JankoFourStabilizer.MathieuOvergroup
public import CFSG.Quasithin.Chapter1.Section02.LocalComponents.Quotients
public import Theory.SpecificGroups.Janko4.Model.LocalStructure.Mathieu
public import Theory.SpecificGroups.Janko4.Model.GeneratorCertificates

/-!
# Reduction of invariant J₄ geometry to two concrete local assertions

The literal ATLAS max1 subgroup already has a certified elementary kernel
and an actual M₂₄ quotient. Identifying that kernel with its full two-core
provides the quotient map needed here. An invariant placement of A in a
subgroup isomorphic to max1 then carries its local C-component condition to
M₂₄: quotient maps with solvable kernel preserve C-components, and surjective
maps carry Sylow subgroups to Sylow subgroups. The intrinsic section of A is
preserved even when the image has nontrivial two-core.

The final reduction transports placement from the fixed matrix J₄ carrier
to every isomorphic group, in any universe. It retains two unproved premises:
invariant local placement in max1 and the E₁₆ extension description of a
local L₄(2) section in M₂₄. In particular, neither a listed quotient type nor
the existence of one concrete max1 subgroup discharges the placement premise.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004, A.3.12(14),(17)
and its proof via Sylow overgroups, printed pp.47–48; proof of 1.3.9, p.514.
The concrete subgroup and its certificates are documented in
`Theory.SpecificGroups.Janko4.Model.LocalStructure.Mathieu`.
-/

public section

open Subgroup
namespace CFSG.Quasithin.Chapter1.Terminal.LinearFourActions.JankoFourStabilizer
open Section02.LocalModels
universe u v
variable {G : Type u} [Group G] {G' : Type v} [Group G']

/-- The fixed subgroup generated by the certified ATLAS max1 words. -/
@[expose] def certifiedMathieuSubgroup : Subgroup Janko4.Model :=
  Janko4.Cardinality.max1Subgroup Janko4.matrixA_mul_self Janko4.matrixB_pow_four

/-- Identify the quotient by the full two-core, using the certified kernel equality. -/
noncomputable def certifiedMathieuQuotientEquiv :
    XiQuotient certifiedMathieuSubgroup ≃* Sporadic.Mathieu.M24 :=
  (QuotientGroup.quotientMulEquivOfEq
    (Janko4.LocalStructure.localKernel_eq_twoCore
      Janko4.matrixA_mul_self Janko4.matrixB_pow_four).symm).trans
    (Janko4.LocalStructure.localQuotientEquivM24
      Janko4.matrixA_mul_self Janko4.matrixB_pow_four)

/-- An actual invariant overgroup, its max1 model, and the retained local embedding.
No quotient-image extension is assumed in this placement data. -/
structure LocalMax1Placement (A : Subgroup G) (α : MulAut G) where
  overgroup : Subgroup G
  le_overgroup : A ≤ overgroup
  invariant : overgroup.map α.toMonoidHom = overgroup
  modelEquiv : overgroup ≃* certifiedMathieuSubgroup
  sylow : Sylow 2 overgroup
  source_local : A.subgroupOf overgroup ∈ ChapterA.Section03.localCComponents sylow

/-- Outstanding J₄ placement obligation on the fixed matrix carrier.
The Sylow in the resulting overgroup need not be the originally supplied Sylow. -/
@[expose] def ConcreteInvariantMax1PlacementTheorem : Prop :=
  ∀ (A : Subgroup Janko4.Model) (S : Sylow 2 Janko4.Model),
    ClassicalGroup.IsPSL (XiQuotient A) 4 2 →
    A ∈ ChapterA.Section03.localCComponents S →
    ∀ α : MulAut Janko4.Model, (∃ n : ℕ, α ^ (2 ^ n) = 1) →
      A.map α.toMonoidHom = A → Nonempty (LocalMax1Placement A α)

/-- Outstanding specialized A.3.12(14) recognition obligation.
This describes the actual embedded subgroup, not just its two-core quotient. -/
@[expose] def MathieuLocalFourExtensionTheorem : Prop :=
  ∀ (B : Subgroup Sporadic.Mathieu.M24) (S : Sylow 2 Sporadic.Mathieu.M24),
    ClassicalGroup.IsPSL (XiQuotient B) 4 2 →
    B ∈ ChapterA.Section03.localCComponents S →
    HasExtension B (ElementaryModel 2 4) (fun Z _ => ClassicalGroup.IsPSL Z 4 2)

private theorem map_subgroupOf_equiv (A H : Subgroup G) (e : G ≃* G') :
    (A.subgroupOf H).map (e.subgroupMap H).toMonoidHom =
      (A.map e.toMonoidHom).subgroupOf (H.map e.toMonoidHom) := by
  ext x
  constructor
  · rintro ⟨a, ha, rfl⟩
    exact ⟨a, ha, rfl⟩
  · rintro ⟨a, ha, hax⟩
    have haH : a ∈ H := by
      obtain ⟨b, hb, heb⟩ := x.property
      change b ∈ H at hb
      have hab : a = b := e.injective (hax.trans heb.symm)
      exact hab.symm ▸ hb
    exact ⟨⟨a, haH⟩, ha, Subtype.ext hax⟩

private theorem local_map_equiv [Finite G] {A S : Subgroup G}
    (hA : A ∈ ChapterA.Section03.localCComponents S) (e : G ≃* G') :
    A.map e.toMonoidHom ∈ ChapterA.Section03.localCComponents (S.map e.toMonoidHom) := by
  let : Group.IsSolvable e.toMonoidHom.ker := by
    rw [e.toMonoidHom.ker_eq_bot e.injective]
    infer_instance
  exact Section02.localCComponents_map_of_solvable_ker hA e.toMonoidHom

private theorem section_isPSL_map (A : Subgroup G) (e : G ≃* G')
    (hA : ClassicalGroup.IsPSL (XiQuotient A) 4 2) :
    ClassicalGroup.IsPSL (XiQuotient (A.map e.toMonoidHom)) 4 2 := by
  let f := e.subgroupMap A
  exact hA.of_mulEquiv (QuotientGroup.congr _ _ f (pCore_map_iso 2 f)).symm

/-- Pull an invariant local placement back through an ambient isomorphism.
The automorphism and the Sylow subgroup are transported with the embedding. -/
noncomputable def LocalMax1Placement.of_map [Finite G'] {A : Subgroup G}
    (e : G ≃* G') (α : MulAut G)
    (D : LocalMax1Placement (A.map e.toMonoidHom) (MulAut.congr e α)) :
    LocalMax1Placement A α := by
  let f := e.symm.subgroupMap D.overgroup
  have hback : (A.map e.toMonoidHom).map e.symm.toMonoidHom = A := by
    have hi : e.symm.toMonoidHom.comp e.toMonoidHom = MonoidHom.id G := by
      ext x
      exact e.symm_apply_apply x
    rw [map_map, hi, map_id]
  have hc : α.toMonoidHom.comp e.symm.toMonoidHom =
      e.symm.toMonoidHom.comp (MulAut.congr e α).toMonoidHom := by
    ext x
    simp
  refine {
    overgroup := D.overgroup.map e.symm.toMonoidHom
    le_overgroup := ?_
    invariant := ?_
    modelEquiv := f.symm.trans D.modelEquiv
    sylow := D.sylow.mapSurjective (f := f.toMonoidHom) f.surjective
    source_local := ?_ }
  · exact hback.symm.le.trans (map_mono D.le_overgroup)
  · rw [map_map, hc, ← map_map, D.invariant]
  · have h := local_map_equiv D.source_local f
    rw [map_subgroupOf_equiv, hback] at h
    exact h

/-- The specified max1 comparison induces the actual Mathieu quotient isomorphism. -/
noncomputable def LocalMax1Placement.quotientEquiv {A : Subgroup G} {α : MulAut G}
    (D : LocalMax1Placement A α) : XiQuotient D.overgroup ≃* Sporadic.Mathieu.M24 := by
  let f : XiQuotient D.overgroup ≃* XiQuotient certifiedMathieuSubgroup :=
    QuotientGroup.congr (pCore 2 D.overgroup) (pCore 2 certifiedMathieuSubgroup)
      D.modelEquiv (by
        change (pCore 2 D.overgroup).map D.modelEquiv.toMonoidHom =
          pCore 2 certifiedMathieuSubgroup
        exact @pCore_map_iso D.overgroup certifiedMathieuSubgroup
          D.overgroup.toGroup certifiedMathieuSubgroup.toGroup 2 D.modelEquiv)
  exact f.trans certifiedMathieuQuotientEquiv

/-- The image of the local Sylow under the two-core projection and Mathieu comparison. -/
noncomputable def LocalMax1Placement.imageSylow [Finite G] {A : Subgroup G} {α : MulAut G}
    (D : LocalMax1Placement A α) : Sylow 2 Sporadic.Mathieu.M24 :=
  (D.sylow.mapSurjective (QuotientGroup.mk'_surjective (pCore 2 D.overgroup))).mapSurjective
    (f := D.quotientEquiv.toMonoidHom) D.quotientEquiv.surjective

/-- Solvability of the projection kernel preserves the source local-component condition. -/
theorem LocalMax1Placement.image_local [Finite G] {A : Subgroup G} {α : MulAut G}
    (D : LocalMax1Placement A α) :
    (twoQuotientImage A D.overgroup).map D.quotientEquiv.toMonoidHom ∈
      ChapterA.Section03.localCComponents (D.imageSylow : Subgroup Sporadic.Mathieu.M24) := by
  let q := QuotientGroup.mk' (pCore 2 D.overgroup)
  let := pCore_isNilpotent (p := 2) (G := D.overgroup)
  let : Group.IsSolvable q.ker := by
    dsimp [q]
    rw [QuotientGroup.ker_mk']
    infer_instance
  have h := Section02.localCComponents_map_of_solvable_ker D.source_local q
  exact local_map_equiv h D.quotientEquiv

/-- Compare the intrinsic sections through the actual projection, retaining the image core. -/
theorem LocalMax1Placement.image_isPSL [Finite G] {A : Subgroup G} {α : MulAut G}
    (D : LocalMax1Placement A α)
    (hA : ClassicalGroup.IsPSL (XiQuotient A) 4 2) :
    ClassicalGroup.IsPSL
      (XiQuotient ((twoQuotientImage A D.overgroup).map D.quotientEquiv.toMonoidHom)) 4 2 := by
  apply section_isPSL_map
  exact hA.of_mulEquiv (imageSectionEquiv D.le_overgroup).symm

/-- Assemble all required overgroup fields from placement and local M₂₄ recognition. -/
noncomputable def LocalMax1Placement.toInvariantMathieuOvergroup [Finite G]
    (hsections : MathieuLocalFourExtensionTheorem) {A : Subgroup G} {α : MulAut G}
    (D : LocalMax1Placement A α) (hA : ClassicalGroup.IsPSL (XiQuotient A) 4 2) :
    InvariantMathieuOvergroup A α where
  overgroup := D.overgroup
  le_overgroup := D.le_overgroup
  invariant := D.invariant
  quotientEquiv := D.quotientEquiv
  image_extension := hsections _ D.imageSylow (D.image_isPSL hA) D.image_local
  sylow := D.imageSylow
  image_local := D.image_local

/-- Conditional assembly of the exact universe-polymorphic contract. Both concrete
geometric premises still require proofs before the J₄ theorem is established. -/
theorem invariantMathieuTheorem_of_placement_and_local_sections
    (hplacement : ConcreteInvariantMax1PlacementTheorem)
    (hsections : MathieuLocalFourExtensionTheorem) : JankoFourInvariantMathieuTheorem.{u} := by
  intro Q _ _ e A S hA hlocal α htwo hfix
  let β := MulAut.congr e α
  have hc : β.toMonoidHom.comp e.toMonoidHom = e.toMonoidHom.comp α.toMonoidHom := by
    ext x
    simp [β]
  have hβ : (A.map e.toMonoidHom).map β.toMonoidHom = A.map e.toMonoidHom := by
    rw [map_map, hc, ← map_map, hfix]
  have hβtwo : ∃ n : ℕ, β ^ (2 ^ n) = 1 := by
    obtain ⟨n, hn⟩ := htwo
    refine ⟨n, ?_⟩
    change (MulAut.congr e) α ^ (2 ^ n) = 1
    rw [← map_pow, hn, map_one]
  obtain ⟨D⟩ := hplacement (A.map e.toMonoidHom) (S.mapSurjective (f := e.toMonoidHom) e.surjective)
    (section_isPSL_map A e hA) (local_map_equiv hlocal e) β hβtwo hβ
  exact ⟨(D.of_map e α).toInvariantMathieuOvergroup hsections hA⟩

end CFSG.Quasithin.Chapter1.Terminal.LinearFourActions.JankoFourStabilizer
