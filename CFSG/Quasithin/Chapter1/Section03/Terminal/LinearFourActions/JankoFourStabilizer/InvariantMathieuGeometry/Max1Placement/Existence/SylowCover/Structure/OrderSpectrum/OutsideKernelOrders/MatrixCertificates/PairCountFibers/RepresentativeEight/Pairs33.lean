  have hl : representativeLeft8 66 = (6 : Fin 256) := by decide +kernel
  have hr : representativeRight8 66 = (64 : Fin 256) := by decide +kernel
  have hv : representativeRank8 66 = 24 := by decide +kernel
  exact (congrArg₂ (fun a b : Fin 256 => pairRank (point (8 : Fin 9) a)
    (point (8 : Fin 9) b)) hl hr).trans (literal_rank.trans hv.symm)

