private theorem pair_product :
    rowsMatrix disp64 * rowsMatrix disp128 = rowsMatrix pairRows :=
  matrix_product _ _ _ (by decide +kernel)

private theorem pair_rows_rank : (rowsMatrix pairRows).rank = 16 := by
  rw [← decode_ofFn]
  apply rank_certificate _ (fun i : Fin 16 => basis i.val)
    (fun i => fromRows i.val) (fun i => fromBasis i.val) pivots
  · have h : ∀ i : Fin 16, scan (fromRows i.val) pairRows 112 0 = basis i.val := by decide +kernel
    simpa only [combine, get_ofFn, scan_eq, Nat.zero_add] using h
  · have h : ∀ i : Fin 112, scan (fromBasis i.val) basis 16 0 = pairRows i.val := by decide +kernel
    simpa only [combine, get_ofFn, scan_eq, Nat.zero_add] using h
  · decide +kernel

