private theorem pair_product :
    rowsMatrix disp48 * rowsMatrix disp128 = rowsMatrix pairRows :=
  matrix_product _ _ _ (by decide +kernel)

private theorem pair_rows_rank : (rowsMatrix pairRows).rank = 16 := by
  rw [← decode_ofFn]
  apply rank_certificate _ (fun i : Fin 16 => basis i.val)
    (fun i => fromRows i.val) (fun i => fromBasis i.val) pivots
  · have h : ∀ i : Fin 16, scan (fromRows i.val) pairRows 112 0 = basis i.val := by decide +kernel
    simpa only [combine, get_ofFn, scan_eq, Nat.zero_add] using h
  · have h : ∀ i : Fin 112, scan (fromBasis i.val) basis 16 0 = pairRows i.val := by decide +kernel
    simpa only [combine, get_ofFn, scan_eq, Nat.zero_add] using h
  · decide +kernel

private theorem literal_rank :
    pairRank (point (8 : Fin 9) ⟨48, by decide +kernel⟩)
      (point (8 : Fin 9) ⟨128, by decide +kernel⟩) = 16 := by
  change ((toMatrix (point (8 : Fin 9) ⟨48, by decide +kernel⟩) - 1) *
    (toMatrix (point (8 : Fin 9) ⟨128, by decide +kernel⟩) - 1)).rank = 16
  rw [displacement48, displacement128, pair_product]
  exact pair_rows_rank

/-- Entry 116: coordinates 48 and 128, evaluated in the original matrix basis. -/
theorem rank :
    pairRank (point (8 : Fin 9) (representativeLeft8 116))
      (point (8 : Fin 9) (representativeRight8 116)) = representativeRank8 116 := by
  have hl : representativeLeft8 116 = (48 : Fin 256) := by decide +kernel
  have hr : representativeRight8 116 = (128 : Fin 256) := by decide +kernel
  have hv : representativeRank8 116 = 16 := by decide +kernel
  exact (congrArg₂ (fun a b : Fin 256 => pairRank (point (8 : Fin 9) a)
    (point (8 : Fin 9) b)) hl hr).trans (literal_rank.trans hv.symm)

