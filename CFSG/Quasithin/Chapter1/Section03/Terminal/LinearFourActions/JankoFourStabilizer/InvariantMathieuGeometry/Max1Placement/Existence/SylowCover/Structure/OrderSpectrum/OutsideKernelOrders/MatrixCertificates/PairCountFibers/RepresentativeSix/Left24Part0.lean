private theorem pair_product48 :
    rowsMatrix displacement24 * rowsMatrix displacement32 = rowsMatrix pairRows48 :=
  matrix_product _ _ _ (by decide +kernel)

private theorem pair_rows_rank48 : (rowsMatrix pairRows48).rank = 16 := by
  rw [← decode_ofFn]
  apply rank_certificate _ (fun i : Fin 16 => basis48 i.val)
    (fun i => fromRows48 i.val) (fun i => fromBasis48 i.val) pivots48
  · have h : ∀ i : Fin 16, scan (fromRows48 i.val) pairRows48 112 0 = basis48 i.val := by decide +kernel
    simpa only [combine, get_ofFn, scan_eq, Nat.zero_add] using h
  · have h : ∀ i : Fin 112, scan (fromBasis48 i.val) basis48 16 0 = pairRows48 i.val := by decide +kernel
    simpa only [combine, get_ofFn, scan_eq, Nat.zero_add] using h
  · decide +kernel

