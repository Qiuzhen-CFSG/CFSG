public import CFSG.Quasithin.Chapter1.Section03.Terminal.LinearFourActions.JankoFourStabilizer.InvariantMathieuGeometry.Max1Placement.Existence.SylowCover.Structure.OrderSpectrum.OutsideKernelOrders.AbstractCatalogue.Localization.PointwiseExclusion.GroupTests.ZeroPairs.Pair10Part10
public import CFSG.Quasithin.Chapter1.Section03.Terminal.LinearFourActions.JankoFourStabilizer.InvariantMathieuGeometry.Max1Placement.Existence.SylowCover.Structure.OrderSpectrum.OutsideKernelOrders.AbstractCatalogue.Localization.PointwiseExclusion.GroupTests.Contracts

/-!
# The actual product of conjugates 1 and 0

Bounded collection with the original SylowNormalEights relations.
The candidate lists are generated by ZeroPairs/source/generate.py;
each collection identity is checked by the Lean kernel.
Source: Aschbacher–Smith A.3.12, pp.47–48; see source/README.md.
-/

@[expose] public section
namespace CFSG.Quasithin.Chapter1.Terminal.LinearFourActions.JankoFourStabilizer.Max1Placement.SylowCover.OutsideKernelOrders.AbstractCatalogue.Localization.GroupTests.ZeroPairs
open PointwiseCalculation Symbolic

private theorem pair10_input :
    pair10State0 = coordinates (conjugatePolynomials 1) ++
      coordinates (conjugatePolynomials 0) := by
  decide +kernel

private theorem pair10_output :
    clean (coordinates pair10Polynomials) = pair10State85 := by
  decide +kernel

/-- Collection of the two candidate coordinate words, in this order. -/
theorem pair10_value (v : Monomial) :
    value (coordinates pair10Polynomials) v =
      value (coordinates (conjugatePolynomials 1) ++
        coordinates (conjugatePolynomials 0)) v := by
  calc
    _ = value (clean (coordinates pair10Polynomials)) v := (value_clean _ v).symm
    _ = value pair10State85 v := congrArg (fun w => value w v) pair10_output
    _ = value pair10State0 v := pair10Value85 v
    _ = _ := congrArg (fun w => value w v) pair10_input

/-- Under the common conjugate contract, these are literal inverse conjugates. -/
theorem pair10_actual (hconj : CollectedConjugates) (b : Boolean.Bits) :
    value (coordinates pair10Polynomials) (valuation b) =
      conjugateTest (boolValue b) (some 1) * conjugateTest (boolValue b) (some 0) := by
  rw [pair10_value, value_append,
    value_selectedConjugate hconj 1 (by unfold selectedConjugate; decide),
    value_selectedConjugate hconj 0 (by unfold selectedConjugate; decide)]

end CFSG.Quasithin.Chapter1.Terminal.LinearFourActions.JankoFourStabilizer.Max1Placement.SylowCover.OutsideKernelOrders.AbstractCatalogue.Localization.GroupTests.ZeroPairs
