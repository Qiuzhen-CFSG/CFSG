open PointwiseCalculation Symbolic

open Janko4.LocalStructure.SylowNormalEights Presentation

private theorem difference23 :
    mergeAdd (pair03Polynomials 18) (pair30Polynomials 18) = equationPolynomial23 := by
  decide +kernel

/-- Coordinate 18 of the equality between the two literal product orders. -/
theorem test23 (hcard : Nat.card Carrier = 2^21) (hconj : CollectedConjugates)
    (b : Boolean.Bits) (hc : PairwiseConjugateCommutation (boolValue b)) :
    Boolean.equations b 23 = false := by
  rw [← equation_value23, ← difference23, polyValue_mergeAdd, ← polyValue_add]
  exact pair_difference hcard pair03Polynomials pair30Polynomials (some 0) (some 3) b
    (pair03_actual hconj b) (pair30_actual hconj b) hc 18


