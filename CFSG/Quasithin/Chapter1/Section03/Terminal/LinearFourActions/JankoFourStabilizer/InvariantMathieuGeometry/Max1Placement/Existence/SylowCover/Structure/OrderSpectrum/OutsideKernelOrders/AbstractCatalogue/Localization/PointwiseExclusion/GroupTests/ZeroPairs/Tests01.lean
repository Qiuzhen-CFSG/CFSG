/-!
# Equations from commuting conjugates 0 and 1

Bounded collection with the original SylowNormalEights relations.
The candidate lists are generated by ZeroPairs/source/generate.py;
each collection identity is checked by the Lean kernel.
Source: Aschbacher–Smith A.3.12, pp.47–48; see source/README.md.
-/

@[expose] public section
namespace CFSG.Quasithin.Chapter1.Terminal.LinearFourActions.JankoFourStabilizer.Max1Placement.SylowCover.OutsideKernelOrders.AbstractCatalogue.Localization.GroupTests.ZeroPairs
open PointwiseCalculation Symbolic

open Janko4.LocalStructure.SylowNormalEights Presentation

private theorem difference18 :
    mergeAdd (pair01Polynomials 17) (pair10Polynomials 17) = equationPolynomial18 := by
  decide +kernel

/-- Coordinate 17 of the equality between the two literal product orders. -/
theorem test18 (hcard : Nat.card Carrier = 2^21) (hconj : CollectedConjugates)
    (b : Boolean.Bits) (hc : PairwiseConjugateCommutation (boolValue b)) :
    Boolean.equations b 18 = false := by
  rw [← equation_value18, ← difference18, polyValue_mergeAdd, ← polyValue_add]
  exact pair_difference hcard pair01Polynomials pair10Polynomials (some 0) (some 1) b
    (pair01_actual hconj b) (pair10_actual hconj b) hc 17

private theorem difference19 :
    mergeAdd (pair01Polynomials 20) (pair10Polynomials 20) = equationPolynomial19 := by
  decide +kernel

/-- Coordinate 20 of the equality between the two literal product orders. -/
theorem test19 (hcard : Nat.card Carrier = 2^21) (hconj : CollectedConjugates)
    (b : Boolean.Bits) (hc : PairwiseConjugateCommutation (boolValue b)) :
    Boolean.equations b 19 = false := by
  rw [← equation_value19, ← difference19, polyValue_mergeAdd, ← polyValue_add]
  exact pair_difference hcard pair01Polynomials pair10Polynomials (some 0) (some 1) b
    (pair01_actual hconj b) (pair10_actual hconj b) hc 20


