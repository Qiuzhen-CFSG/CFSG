@[expose] public section
namespace CFSG.Quasithin.Chapter1.Terminal.LinearFourActions.JankoFourStabilizer.Max1Placement.SylowCover.OutsideKernelOrders.AbstractCatalogue.Localization.GroupTests.ZeroPairs
open PointwiseCalculation Symbolic

open Janko4.LocalStructure.SylowNormalEights Presentation

private theorem difference24 :
    mergeAdd (pair07Polynomials 20) (pair70Polynomials 20) = equationPolynomial24 := by
  decide +kernel

/-- Coordinate 20 of the equality between the two literal product orders. -/
theorem test24 (hcard : Nat.card Carrier = 2^21) (hconj : CollectedConjugates)
    (b : Boolean.Bits) (hc : PairwiseConjugateCommutation (boolValue b)) :
    Boolean.equations b 24 = false := by
  rw [← equation_value24, ← difference24, polyValue_mergeAdd, ← polyValue_add]
  exact pair_difference hcard pair07Polynomials pair70Polynomials (some 0) (some 7) b
    (pair07_actual hconj b) (pair70_actual hconj b) hc 20


