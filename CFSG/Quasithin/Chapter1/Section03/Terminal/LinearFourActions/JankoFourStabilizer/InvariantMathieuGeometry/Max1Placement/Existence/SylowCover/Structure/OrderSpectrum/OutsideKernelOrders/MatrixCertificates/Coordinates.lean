module
public import CFSG.Quasithin.Chapter1.Section03.Terminal.LinearFourActions.JankoFourStabilizer.InvariantMathieuGeometry.Max1Placement.Existence.SylowCover.Structure.OrderSpectrum.OutsideKernelOrders.Candidates
public import Theory.SpecificGroups.Janko4.Model.LocalStructure.SylowNormalEights.MatrixRealization
public import Theory.SpecificGroups.Janko4.Model.LocalStructure.SylowNormalEights.Profiles.Collection
public import Theory.GroupTheory.BinaryCollection.Subsequence
import Mathlib.Tactic.FinCases

/-!
# Complete coordinates for the nine literal matrix subgroups

Each candidate is generated by commuting involutions. Binary collection
therefore covers its generated subgroup. The selected ascending PC masks
are distinct, and the proved matrix realization gives uniqueness of the full
PC normal forms. Consequently these coordinates are bijections onto the actual
matrix subgroups and certify all nine orders.

The final two adapters count a pair-rank fiber over the whole subgroup and
identify the generated rank span with the closure of its coordinate fiber.
They retain rank values as explicit inputs; no discovery rank is assumed.
Source context: Aschbacher–Smith A.3.12, printed pp.47–48; Kleidman–Wilson
(1988), pp.484–510. The marked words are those of the adjacent Candidates module.
-/

@[expose] public section

open Janko4 Subgroup Janko4.LocalStructure.SylowNormalEights
open Theory.GroupTheory.BinaryCollection
open Janko4.LocalStructure.SylowNormalEights.Presentation.Profiles
namespace CFSG.Quasithin.Chapter1.Terminal.LinearFourActions.JankoFourStabilizer.Max1Placement.SylowCover.OutsideKernelOrders.MatrixCertificates
attribute [local irreducible] modelGroup matrixA matrixB

/-- Concatenate the selected generator words, in their published order. -/
def selectWords : List (List (Fin 21)) → ℕ → List (Fin 21)
  | [], _ => []
  | w :: ws, n => (if n % 2 = 0 then [] else w) ++ selectWords ws (n / 2)

def wordMask (w : List (Fin 21)) : ℕ := (w.map (fun i => 2^i.val)).sum

def encodeMask : List (List (Fin 21)) → ℕ → ℕ
  | [], _ => 0
  | w :: ws, n => (if n % 2 = 0 then 0 else wordMask w) + encodeMask ws (n / 2)

def decodeMask : List (List (Fin 21)) → ℕ → ℕ
  | [], _ => 0
  | w :: ws, n => (n / 2^(w.head!.val) % 2) + 2 * decodeMask ws n

def candidateMask (i : Fin 9) (n : Fin (candidateOrder i)) : Fin (2^21) :=
  Fin.ofNat _ (encodeMask (candidateWords i) n.val)

def abstractPoint (i : Fin 9) (n : Fin (candidateOrder i)) : Presentation.Carrier :=
  wordValue (selectWords (candidateWords i) n.val)

noncomputable def realization : Presentation.Carrier →* Model :=
  ambientRealization MatrixWords.pcGenerator_relations MatrixWords.pcGenerator_closure

theorem realization_injective : Function.Injective realization :=
  ambientRealization_injective _ _

@[simp] theorem realization_generator (j : Fin 21) :
    realization (Presentation.generator j) = (MatrixWords.pcGenerator j : Model) :=
  ambientRealization_generator _ _ j

noncomputable def point (i : Fin 9) (n : Fin (candidateOrder i)) : Model :=
  realization (abstractPoint i n)

theorem point_eq_word (i : Fin 9) (n : Fin (candidateOrder i)) :
    point i n = ((selectWords (candidateWords i) n.val).map
      (fun j => (MatrixWords.pcGenerator j : Model))).prod := by
  simp only [point, abstractPoint, wordValue, map_list_prod, List.map_map,
    Function.comp_def, realization_generator]

theorem presentation_card : Nat.card Presentation.Carrier = 2^21 :=
  presentation_card_of_equiv (matrixEquivOfWords MatrixWords.pcGenerator_relations
    MatrixWords.pcGenerator_closure)

theorem abstractPoint_eq_normalForm (i : Fin 9) (n : Fin (candidateOrder i)) :
    abstractPoint i n = Presentation.normalForm (candidateMask i n) := by
  have h : ∀ (i : Fin 9) (n : Fin (candidateOrder i)),
      collect 64 (selectWords (candidateWords i) n.val) = maskWord (candidateMask i n) := by
    intro i
    fin_cases i <;> decide +kernel
  exact (wordValue_eq_of_collect 64 _ _ (h i n)).trans (wordValue_maskWord _)

theorem candidateMask_injective (i : Fin 9) : Function.Injective (candidateMask i) := by
  have h : ∀ (i : Fin 9) (n : Fin (candidateOrder i)),
      decodeMask (candidateWords i) (candidateMask i n).val = n.val := by
    intro i
    fin_cases i <;> decide +kernel
  intro a b hab
  apply Fin.ext
  rw [← h i a, ← h i b, hab]

theorem abstractPoint_injective (i : Fin 9) : Function.Injective (abstractPoint i) := by
  intro a b hab
  apply candidateMask_injective i
  apply (Presentation.normalForm_bijective_of_card presentation_card).injective
  simpa only [← abstractPoint_eq_normalForm] using hab

theorem point_injective (i : Fin 9) : Function.Injective (point i) :=
  realization_injective.comp (abstractPoint_injective i)

private theorem wordValue_selectWords (ws : List (List (Fin 21))) (n : ℕ) :
    wordValue (selectWords ws n) = product (ws.map wordValue) n := by
  induction ws generalizing n with
  | nil => rfl
  | cons w ws ih =>
    simp only [selectWords, List.map_cons, product]
    split_ifs with h
    · simp only [List.nil_append, h, pow_zero, one_mul, ih]
    · have hn : n % 2 = 1 := by omega
      simp only [wordValue_append, hn, pow_one, ih]

private theorem triangular_of_involutions {G : Type*} [Group G] (l : List G)
    (hs : ∀ a ∈ l, a * a = 1)
    (hc : ∀ a ∈ l, ∀ b ∈ l, a * b = b * a) : triangular l := by
  induction l with
  | nil => trivial
  | cons a l ih =>
    refine ⟨?_, ?_, ?_⟩
    · rw [hs a List.mem_cons_self]
      exact (Subgroup.closure _).one_mem
    · intro b hb
      have he : a⁻¹ * b * a = b := by
        rw [mul_assoc, ← hc a List.mem_cons_self b (List.mem_cons_of_mem a hb),
          inv_mul_cancel_left]
      rw [he]
      exact Subgroup.subset_closure hb
    · exact ih (fun b hb => hs b (List.mem_cons_of_mem a hb))
        (fun b hb c hc' => hc b (List.mem_cons_of_mem a hb) c (List.mem_cons_of_mem a hc'))

theorem candidate_triangular (i : Fin 9) :
    triangular ((candidateWords i).map wordValue) := by
  have hs : ∀ (i : Fin 9) (a : Fin (candidateWords i).length),
      collect 128 ((candidateWords i)[a.val] ++ (candidateWords i)[a.val]) = [] := by
    intro i
    fin_cases i <;> decide +kernel
  have hc : ∀ (i : Fin 9) (a b : Fin (candidateWords i).length),
      collect 128 ((candidateWords i)[a.val] ++ (candidateWords i)[b.val]) =
        collect 128 ((candidateWords i)[b.val] ++ (candidateWords i)[a.val]) := by
    intro i
    fin_cases i <;> decide +kernel
  apply triangular_of_involutions
  · intro x hx
    obtain ⟨w, hw, rfl⟩ := List.mem_map.mp hx
    obtain ⟨a, rfl⟩ := List.mem_iff_get.mp hw
    rw [← wordValue_append]
    exact wordValue_eq_of_collect 128 _ [] (hs i a)
  · intro x hx y hy
    obtain ⟨w, hw, rfl⟩ := List.mem_map.mp hx
    obtain ⟨v, hv, rfl⟩ := List.mem_map.mp hy
    obtain ⟨a, rfl⟩ := List.mem_iff_get.mp hw
    obtain ⟨b, rfl⟩ := List.mem_iff_get.mp hv
    rw [← wordValue_append, ← wordValue_append]
    exact (collect_sound 128 _).symm.trans ((congrArg wordValue (hc i a b)).trans
      (collect_sound 128 _))

private theorem abstractFamily_eq_closure (i : Fin 9) :
    abstractFamily i = Subgroup.closure {x | x ∈ (candidateWords i).map wordValue} := by
  change Subgroup.closure _ = Subgroup.closure _
  apply congrArg Subgroup.closure
  ext x
  simp only [Set.mem_range, List.mem_map]
  constructor
  · rintro ⟨⟨w, hw⟩, rfl⟩
    exact ⟨w, hw, rfl⟩
  · rintro ⟨w, hw, rfl⟩
    exact ⟨⟨w, hw⟩, rfl⟩

theorem candidateOrder_eq (i : Fin 9) :
    candidateOrder i = 2^((candidateWords i).map wordValue).length := by
  simpa only [List.length_map] using
    (by decide +kernel : ∀ i : Fin 9, candidateOrder i = 2^(candidateWords i).length) i

private theorem product_mem {G : Type*} [Group G] (H : Subgroup G)
    (l : List G) (hl : ∀ x ∈ l, x ∈ H) (n : ℕ) : product l n ∈ H := by
  induction l generalizing n with
  | nil => exact H.one_mem
  | cons a l ih =>
    exact H.mul_mem (H.pow_mem (hl a List.mem_cons_self) _)
      (ih (fun b hb => hl b (List.mem_cons_of_mem a hb)) _)

theorem abstractPoint_mem (i : Fin 9) (n : Fin (candidateOrder i)) :
    abstractPoint i n ∈ abstractFamily i := by
  rw [abstractFamily_eq_closure]
  unfold abstractPoint
  rw [wordValue_selectWords]
  exact product_mem _ _ (fun x hx => Subgroup.subset_closure hx) _

theorem abstractPoint_surjective (i : Fin 9) :
    ∀ x ∈ abstractFamily i, ∃ n, abstractPoint i n = x := by
  intro x hx
  rw [abstractFamily_eq_closure] at hx
  obtain ⟨n, hn, he⟩ := cover _ (candidate_triangular i) x hx
  refine ⟨⟨n, (candidateOrder_eq i).symm ▸ hn⟩, ?_⟩
  exact (wordValue_selectWords _ _).trans he

theorem point_mem (i : Fin 9) (n : Fin (candidateOrder i)) : point i n ∈ matrixFamily i := by
  rw [← map_abstractFamily MatrixWords.pcGenerator_relations MatrixWords.pcGenerator_closure]
  exact Subgroup.mem_map_of_mem realization (abstractPoint_mem i n)

theorem point_surjective (i : Fin 9) :
    ∀ x ∈ matrixFamily i, ∃ n, point i n = x := by
  intro x hx
  rw [← map_abstractFamily MatrixWords.pcGenerator_relations MatrixWords.pcGenerator_closure] at hx
  obtain ⟨y, hy, rfl⟩ := hx
  obtain ⟨n, rfl⟩ := abstractPoint_surjective i y hy
  exact ⟨n, rfl⟩

noncomputable def pointEquiv (i : Fin 9) : Fin (candidateOrder i) ≃ matrixFamily i :=
  Equiv.ofBijective (fun n => ⟨point i n, point_mem i n⟩) (by
    constructor
    · intro a b h
      exact point_injective i (congrArg (fun x : matrixFamily i => (x : Model)) h)
    · intro x
      obtain ⟨n, hn⟩ := point_surjective i x.val x.property
      exact ⟨n, Subtype.ext hn⟩)

theorem matrixFamily_card (i : Fin 9) : Nat.card (matrixFamily i) = candidateOrder i := by
  rw [← Nat.card_congr (pointEquiv i), Nat.card_fin]

@[simp] theorem pointEquiv_coe (i : Fin 9) (n : Fin (candidateOrder i)) :
    (pointEquiv i n : Model) = point i n := rfl

/-- A complete coordinate rank table counts the entire subgroup fiber. -/
theorem pairRankCount_eq_filter (i : Fin 9)
    (ranks : Fin (candidateOrder i) → Fin (candidateOrder i) → ℕ)
    (hr : ∀ n m, pairRank (point i n) (point i m) = ranks n m)
    (n : Fin (candidateOrder i)) (r : ℕ) :
    pairRankCount (matrixFamily i) (point i n) r =
      (Finset.univ.filter (fun m => ranks n m = r)).card := by
  let e : {m : Fin (candidateOrder i) // ranks n m = r} ≃
      {y : matrixFamily i // pairRank (point i n) y = r} :=
    Equiv.subtypeEquiv (pointEquiv i) (by
      intro m
      simp only [pointEquiv_coe, hr])
  change Nat.card {y : matrixFamily i // pairRank (point i n) y = r} = _
  rw [← Nat.card_congr e, Nat.card_eq_fintype_card, Fintype.card_subtype]

/-- The enumerated fiber generates precisely the original ambient rank span. -/
theorem rankSpan_eq_closure_points (i : Fin 9) (t : RankTest) :
    rankSpan (matrixFamily i) t = Subgroup.closure (Set.range
      (fun n : {n : Fin (candidateOrder i) // t.Holds (matrixFamily i) (point i n)} =>
        point i n.val)) := by
  apply congrArg Subgroup.closure
  ext x
  constructor
  · rintro ⟨hx, ht⟩
    obtain ⟨n, rfl⟩ := point_surjective i x hx
    exact ⟨⟨n, ht⟩, rfl⟩
  · rintro ⟨⟨n, hn⟩, rfl⟩
    exact ⟨point_mem i n, hn⟩

end CFSG.Quasithin.Chapter1.Terminal.LinearFourActions.JankoFourStabilizer.Max1Placement.SylowCover.OutsideKernelOrders.MatrixCertificates
