private theorem pc15_rows_rank : (rowsMatrix r201 - 1).rank = 50 := by
  have hd : rowsMatrix r201 - 1 = decodeRows (Vector.ofFn (fun i : Fin 112 => displacementRows i.val)) := by
    rw [← decode_ofFn, ← decode_displacement]
    apply congrArg decodeRows
    apply Vector.ext
    intro i hi
    change (displacement (Vector.ofFn (fun j : Fin 112 => r201 j.val))).get ⟨i, hi⟩ =
      (Vector.ofFn (fun j : Fin 112 => displacementRows j.val)).get ⟨i, hi⟩
    simpa only [displacement, get_ofFn] using
      (by decide +kernel : ∀ i : Fin 112, r201 i.val ^^^ 2^i.val = displacementRows i.val) ⟨i, hi⟩
  rw [hd]
  apply rank_certificate _ (fun i : Fin 50 => basis i.val)
    (fun i => fromRows i.val) (fun i => fromBasis i.val) pivots
  · have h : ∀ i : Fin 50, scan (fromRows i.val)
        displacementRows 112 0 = basis i.val := by decide +kernel
    simpa only [combine, displacement, get_ofFn, scan_eq, Nat.zero_add] using h
  · have h : ∀ i : Fin 112, scan (fromBasis i.val) basis 50 0 =
        displacementRows i.val := by decide +kernel
    simpa only [combine, displacement, get_ofFn, scan_eq, Nat.zero_add] using h
  · decide +kernel

/-- The displacement rank of the existing literal PC word. -/
theorem displacementRank_pc15 : displacementRank (MatrixWords.pcGenerator 15 : Model) = 50 := by
  change (matrixRepresentation (MatrixWords.pcGenerator 15) - 1).rank = 50
  rw [pc15_eval]
  exact pc15_rows_rank
/-- The rank certificate is attached to the actual candidate enumeration. -/
theorem displacementRank_point_one_one : displacementRank (point (1 : Fin 9) ⟨1, by decide +kernel⟩) = 50 := by
  have h : point (1 : Fin 9) ⟨1, by decide +kernel⟩ = (MatrixWords.pcGenerator 15 : Model) := by
    rw [point_eq_word]
    change (MatrixWords.pcGenerator 15 : Model) * 1 = _
    exact mul_one _
  rw [h]
  exact displacementRank_pc15

