module

public import CFSG.Quasithin.Chapter1.Section03.Terminal.LinearFourActions.JankoFourStabilizer.InvariantMathieuGeometry.Max1Placement.Existence.SylowCover.Eight.MatrixNormalizerBounds.MathieuControl

/-!
# Three finite word equalities suffice for the mixed Sylow eight

The existing kernel mask coordinates identify a subgroup with at most eight
members, generated by masks 456, 1387 and 198. A checked path in the two
actual max1 generator actions connects mask 456 to the 2B seed. Thus three
literal word equalities imply the full ambient normalizer alternative for
row one, with strictness proved by `MathieuControl`.

The mask equalities are retained as explicit hypotheses. Their discovery
comes from `SylowNormalEights/source/matrix-witness.json`; that JSON is not
a proof. The matrix-realization producer owns the shared word evaluations.
The XOR and conjugation identities used here are already proved for the
actual kernel in `Max1Fusion.KernelOrbits.Coordinates`, with ATLAS attribution.
-/

@[expose] public section
namespace CFSG.Quasithin.Chapter1.Terminal.LinearFourActions.JankoFourStabilizer.Max1Placement.SylowCover.MatrixNormalizerBounds
open Subgroup Janko4 Janko4.Cardinality Janko4.Max1AmalgamRigidity
open Janko4.Simplicity.Max1Fusion.KernelOrbits
open Janko4.Cardinality.KernelCount Janko4.Cardinality.QuotientCount.Image
open Janko4.LocalStructure.SylowNormalEights.MatrixWords
attribute [local irreducible] modelGroup matrixA matrixB max1Subgroup localKernel localKernelSeed

/-- An integer mask evaluated in the actual max1 kernel and then in J₄. -/
def kernelMask (m : ℕ) : Model :=
  M.subtype (K.subtype (maskValue matrixA_mul_self matrixB_pow_four m))

private theorem kernelMask_mem (m : ℕ) : kernelMask m ∈ E :=
  mem_map_of_mem M.subtype (maskValue matrixA_mul_self matrixB_pow_four m).property

private theorem kernelMask_zero : kernelMask 0 = 1 := by
  simp only [kernelMask, maskValue_zero, map_one]

private theorem kernelMask_xor (m n : ℕ) :
    kernelMask (Nat.xor m n) = kernelMask m * kernelMask n := by
  simp only [kernelMask, maskValue_xor, map_mul]

private theorem kernelMask_conj_x (m n : ℕ) (h : maskImage xMasks m = n) :
    IsConj (kernelMask m) (kernelMask n) := by
  apply M.subtype.map_isConj
  exact isConj_iff.mpr ⟨(localX matrixA_mul_self matrixB_pow_four)⁻¹, by
    simpa only [Subgroup.subtype_apply, inv_inv, h] using right_conj_mask_x matrixA_mul_self matrixB_pow_four m⟩

private theorem kernelMask_conj_y (m n : ℕ) (h : maskImage yMasks m = n) :
    IsConj (kernelMask m) (kernelMask n) := by
  apply M.subtype.map_isConj
  exact isConj_iff.mpr ⟨(localY matrixA_mul_self matrixB_pow_four)⁻¹, by
    simpa only [Subgroup.subtype_apply, inv_inv, h] using right_conj_mask_y matrixA_mul_self matrixB_pow_four m⟩

/-- A checked path of local conjugations places mask 456 in the seed class. -/
theorem kernelMask_456_isConj_seed :
    IsConj (localKernelSeed matrixA_mul_self matrixB_pow_four : Model) (kernelMask 456) := by
  have h : IsConj (kernelMask 1) (kernelMask 456) := by
    apply (kernelMask_conj_y 1 4 (by decide +kernel)).trans
    apply (kernelMask_conj_x 4 8 (by decide +kernel)).trans
    apply (kernelMask_conj_y 8 16 (by decide +kernel)).trans
    apply (kernelMask_conj_y 16 32 (by decide +kernel)).trans
    apply (kernelMask_conj_x 32 64 (by decide +kernel)).trans
    apply (kernelMask_conj_y 64 128 (by decide +kernel)).trans
    apply (kernelMask_conj_y 128 256 (by decide +kernel)).trans
    apply (kernelMask_conj_x 256 512 (by decide +kernel)).trans
    apply (kernelMask_conj_y 512 1024 (by decide +kernel)).trans
    apply (kernelMask_conj_x 1024 1952 (by decide +kernel)).trans
    apply (kernelMask_conj_y 1952 655 (by decide +kernel)).trans
    apply (kernelMask_conj_y 655 1303 (by decide +kernel)).trans
    apply (kernelMask_conj_x 1303 1467 (by decide +kernel)).trans
    apply (kernelMask_conj_y 1467 1722 (by decide +kernel)).trans
    apply (kernelMask_conj_x 1722 1557 (by decide +kernel)).trans
    apply (kernelMask_conj_y 1557 993 (by decide +kernel)).trans
    apply (kernelMask_conj_x 993 898 (by decide +kernel)).trans
    apply (kernelMask_conj_y 898 1345 (by decide +kernel)).trans
    apply (kernelMask_conj_x 1345 1410 (by decide +kernel)).trans
    apply (kernelMask_conj_y 1410 1670 (by decide +kernel)).trans
    apply (kernelMask_conj_y 1670 708 (by decide +kernel)).trans
    exact kernelMask_conj_x 708 456 (by decide +kernel)
  simpa only [kernelMask, Subgroup.subtype_apply, maskValue_one] using h

private def eightMask (i : Fin 8) : ℕ := ![0, 456, 1387, 1187, 198, 270, 1453, 1125] i
private def xorIndex (i j : Fin 8) : Fin 8 := ⟨(i.val ^^^ j.val) % 8, Nat.mod_lt _ (by decide)⟩

private theorem eightMask_xor : ∀ i j, eightMask (xorIndex i j) =
    Nat.xor (eightMask i) (eightMask j) := by decide +kernel

private def maskEight : Subgroup Model where
  carrier := Set.range (fun i : Fin 8 => kernelMask (eightMask i))
  one_mem' := ⟨0, kernelMask_zero⟩
  mul_mem' := by
    rintro _ _ ⟨i, rfl⟩ ⟨j, rfl⟩
    exact ⟨xorIndex i j, by
      change kernelMask (eightMask (xorIndex i j)) = _
      rw [eightMask_xor, kernelMask_xor]⟩
  inv_mem' := by
    rintro _ ⟨i, rfl⟩
    refine ⟨i, ?_⟩
    apply eq_inv_of_mul_eq_one_left
    rw [← kernelMask_xor]
    change kernelMask (eightMask i ^^^ eightMask i) = 1
    rw [Nat.xor_self, kernelMask_zero]

private theorem maskEight_le_E : maskEight ≤ E := by
  rintro _ ⟨i, rfl⟩
  exact kernelMask_mem _

private theorem maskEight_card_le : Nat.card maskEight ≤ 8 := by
  let f : Fin 8 → maskEight := fun i => ⟨kernelMask (eightMask i), ⟨i, rfl⟩⟩
  have hf : Function.Surjective f := by
    rintro ⟨v, ⟨i, rfl⟩⟩
    exact ⟨i, rfl⟩
  exact (Nat.card_le_card_of_surjective f hf).trans_eq (Nat.card_fin 8)

/-- Row one's ambient normalizer lies strictly in proper max1 as soon as
these three concrete matrix-word evaluations are certified. -/
theorem row_one_of_word_equalities
    (h17 : (pcGenerator 17 : Model) = kernelMask 456)
    (h19 : (pcGenerator 19 : Model) = kernelMask 1387)
    (h20 : (pcGenerator 20 : Model) = kernelMask 198) :
    EightNormalizerAlternative (U 1) := by
  have hsmall : U 1 ≤ maskEight := by
    rw [U, map_le_iff_le_comap, F_one, closure_le]
    intro u hu
    rcases hu with rfl | rfl | rfl
    · exact ⟨1, h17.symm⟩
    · exact ⟨2, h19.symm⟩
    · exact ⟨4, h20.symm⟩
  have hseed : ∃ u ∈ U 1,
      IsConj (localKernelSeed matrixA_mul_self matrixB_pow_four : Model) u := by
    refine ⟨(pcGenerator 17 : Model), ?_, h17.symm ▸ kernelMask_456_isConj_seed⟩
    change OuterReduction.OddIndex.twoSubgroup.subtype (pcGenerator 17) ∈
      (F 1).map OuterReduction.OddIndex.twoSubgroup.subtype
    apply mem_map_of_mem
    rw [F_one]
    exact subset_closure (Set.mem_insert _ _)
  have hcard : Nat.card (U 1) < 2048 :=
    (card_le_of_le hsmall).trans_lt (maskEight_card_le.trans_lt (by decide))
  exact Or.inr ⟨M, normalizer_lt_max1_of_kernel_seed (U 1)
    (hsmall.trans maskEight_le_E) hseed hcard, literal_max1_ne_top⟩

end CFSG.Quasithin.Chapter1.Terminal.LinearFourActions.JankoFourStabilizer.Max1Placement.SylowCover.MatrixNormalizerBounds
