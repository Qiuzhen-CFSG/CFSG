private theorem pair_product12 :
    rowsMatrix displacement1 * rowsMatrix displacement28 = rowsMatrix pairRows12 :=
  matrix_product _ _ _ (by decide +kernel)

private theorem pair_rows_rank12 : (rowsMatrix pairRows12).rank = 16 := by
  rw [← decode_ofFn]
  apply rank_certificate _ (fun i : Fin 16 => basis12 i.val)
    (fun i => fromRows12 i.val) (fun i => fromBasis12 i.val) pivots12
  · have h : ∀ i : Fin 16, scan (fromRows12 i.val) pairRows12 112 0 = basis12 i.val := by decide +kernel
    simpa only [combine, get_ofFn, scan_eq, Nat.zero_add] using h
  · have h : ∀ i : Fin 112, scan (fromBasis12 i.val) basis12 16 0 = pairRows12 i.val := by decide +kernel
    simpa only [combine, get_ofFn, scan_eq, Nat.zero_add] using h
  · decide +kernel

