module
public import CFSG.Quasithin.Chapter1.Section03.Terminal.LinearFourActions.JankoFourStabilizer.InvariantMathieuGeometry.Max1Placement.Existence.SylowCover.PureFirstNormalizers.AllRowTwo.FiniteConfigurations.PureMasks
public import CFSG.Quasithin.Chapter1.Section03.Terminal.LinearFourActions.JankoFourStabilizer.InvariantMathieuGeometry.Max1Placement.Existence.SylowCover.PureFirstNormalizers.AllRowTwo.FiniteConfigurations.HullData
/-!
# Kernel-checked literal hull lists

The literal mask sets are closed under multiplication, lie in the marked
intersection, and are generated by the eight and its listed sixteen overgroups.
These finite statements feed the unrestricted canonical-hull identification.
Source: Kleidman--Wilson (1988), Section 2.1, pp.488--489.
-/
public noncomputable section
namespace Janko4.LocalStructure.PureFirstNormalizers.AllRowTwo.FiniteConfigurations.HullCertificates
open MarkedIntersection
attribute [local instance 2000] Finset.decidableDforallFinset
attribute [local instance 2000] Finset.decidableExistsAndFinset
set_option Elab.async false
theorem hull_zero : ∀ i, (0 : Fin 8192) ∈ hullMasks i := by decide +kernel

theorem hull_coordinates : ∀ i, ∀ m ∈ hullMasks i,
    ∃ j : Fin 128, coordinate j = m := by decide +kernel

set_option maxRecDepth 10000 in
theorem hull_mul : ∀ i, ∀ m ∈ hullMasks i, ∀ n ∈ hullMasks i,
    maskMul m n ∈ hullMasks i := by decide +kernel

@[expose] def partners : Fin 16 → Fin 10 × Fin 10 :=
  ![(0,6),(3,5),(2,4),(0,7),(8,9),(0,0),(3,4),(2,6),
    (5,6),(1,8),(1,4),(3,7),(2,9),(0,1),(5,8),(7,9)]

set_option maxRecDepth 10000 in
theorem hull_generation : ∀ i : Fin 16, ∀ m ∈ hullMasks i,
    m ∈ rowMasks (eightIndex i) ∨
      (partners i).1 ∈ listedSixteenOvergroups i ∧
      (partners i).2 ∈ listedSixteenOvergroups i ∧
      ∃ n ∈ rowMasks (sixteenIndex (partners i).1),
        ∃ p ∈ rowMasks (sixteenIndex (partners i).2), maskMul n p = m := by
  decide +kernel

theorem rows_in_hull : ∀ i : Fin 16,
    rowMasks (eightIndex i) ⊆ hullMasks i ∧
    ∀ j ∈ listedSixteenOvergroups i, rowMasks (sixteenIndex j) ⊆ hullMasks i := by
  decide +kernel

end Janko4.LocalStructure.PureFirstNormalizers.AllRowTwo.FiniteConfigurations.HullCertificates
