def sixteenMask (i : Fin 16) : ℕ :=
  ![0, 1049, 583, 1630, 370, 1387, 821, 1836,
    198, 1247, 641, 1688, 436, 1453, 1011, 2026] i

def xorIndex (i j : Fin 16) : Fin 16 :=
  ⟨(i.val ^^^ j.val) % 16, Nat.mod_lt _ (by decide)⟩

lemma sixteenMask_xor : ∀ i j, sixteenMask (xorIndex i j) =
    Nat.xor (sixteenMask i) (sixteenMask j) := by decide +kernel

def sixteenRange : Subgroup Model where
  carrier := Set.range (fun i : Fin 16 => maskElement (sixteenMask i))
  one_mem' := ⟨0, maskElement_zero⟩
  mul_mem' := by
    rintro _ _ ⟨i, rfl⟩ ⟨j, rfl⟩
    exact ⟨xorIndex i j, by
      change maskElement (sixteenMask (xorIndex i j)) = _
      rw [sixteenMask_xor, maskElement_xor]⟩
  inv_mem' := by
    rintro _ ⟨i, rfl⟩
    refine ⟨i, eq_inv_of_mul_eq_one_left ?_⟩
    rw [← maskElement_xor]
    change maskElement (sixteenMask i ^^^ sixteenMask i) = 1
    rw [Nat.xor_self, maskElement_zero]

