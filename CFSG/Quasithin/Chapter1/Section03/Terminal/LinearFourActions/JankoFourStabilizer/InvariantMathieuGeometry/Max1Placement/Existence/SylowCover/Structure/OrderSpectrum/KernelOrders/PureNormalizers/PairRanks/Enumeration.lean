lemma matrix_basis (i : Fin 11) :
    toMatrix (maskElement (2 ^ i.val)) = decodeRows (basisRows i) := by
  change representation matrixA_mul_self matrixB_pow_four
    (maskValue matrixA_mul_self matrixB_pow_four (2 ^ i.val)) = _
  rw [maskValue_basis]
  exact representation_basis matrixA_mul_self matrixB_pow_four i

lemma matrix_xor (m n : ℕ) :
    toMatrix (maskElement (Nat.xor m n)) =
      toMatrix (maskElement m) * toMatrix (maskElement n) := by
  rw [maskElement_xor, map_mul]

lemma displacement_product (m n : ℕ) :
    (toMatrix (maskElement m) - 1) * (toMatrix (maskElement n) - 1) =
      toMatrix (maskElement (Nat.xor m n)) - toMatrix (maskElement m) -
        toMatrix (maskElement n) + 1 := by
  rw [matrix_xor, sub_mul, mul_sub, one_mul, mul_one]
  abel

lemma pairRank_eq (m n : ℕ) (a b c : ℕ → ℕ)
    (ha : toMatrix (maskElement m) = rowsMatrix a)
    (hb : toMatrix (maskElement n) = rowsMatrix b)
    (hc : toMatrix (maskElement (Nat.xor m n)) = rowsMatrix c) :
    pairRank (maskElement m) (maskElement n) = (rowsMatrix (pairRows a b c)).rank := by
  unfold pairRank
  rw [displacement_product, ha, hb, hc, ← pairRows_eq]

lemma pairRank_zero_left (m : ℕ) : pairRank (maskElement 0) (maskElement m) = 0 := by
  simp [pairRank, maskElement_zero]

lemma pairRank_zero_right (m : ℕ) : pairRank (maskElement m) (maskElement 0) = 0 := by
  simp [pairRank, maskElement_zero]

lemma pairRank_self (m : ℕ) : pairRank (maskElement m) (maskElement m) = 0 := by
  unfold pairRank
  rw [displacement_product]
  change (toMatrix (maskElement (m ^^^ m)) - toMatrix (maskElement m) -
    toMatrix (maskElement m) + 1).rank = 0
  rw [Nat.xor_self, maskElement_zero, map_one]
  have h : ∀ x y : ZMod 2, x - y - y + x = 0 := by decide +kernel
  have he : (1 : BinaryMatrix) - toMatrix (maskElement m) -
      toMatrix (maskElement m) + 1 = 0 := by
    ext i j
    exact h _ _
  rw [he, Matrix.rank_zero]


