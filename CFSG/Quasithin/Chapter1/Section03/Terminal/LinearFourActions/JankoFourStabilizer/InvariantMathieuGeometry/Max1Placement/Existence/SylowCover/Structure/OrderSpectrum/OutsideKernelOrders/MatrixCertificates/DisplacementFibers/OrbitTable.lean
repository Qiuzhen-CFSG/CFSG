private instance rowOrder_neZero (i : Fin 5) : NeZero (candidateOrder (row i)) :=
  ⟨by have h := candidateSpanOrder_bounds (row i); omega⟩

private def parent (i : Fin 5) (n : Fin (candidateOrder (row i))) :
    Fin (candidateOrder (row i)) := Fin.ofNat _ (parentIndex i n.val)
private def conjugator (i : Fin 5) (n : Fin (candidateOrder (row i))) : Fin 21 :=
  Fin.ofNat _ (conjugatorIndex i n.val)
private def root (i : Fin 5) (n : Fin (candidateOrder (row i))) : Fin 16 :=
  Fin.ofNat _ (rootIndex i n.val)

private theorem root_check (i : Fin 5) (n : Fin (candidateOrder (row i)))
    (h : depth i n.val = 0) :
    selectWords (candidateWords (row i)) n.val = representativeWords (root i n) ∧
      representativeRank (root i n) = rankLabel i n.val := by
  have hc : ∀ (i : Fin 5) (n : Fin (candidateOrder (row i))), depth i n.val = 0 →
      selectWords (candidateWords (row i)) n.val = representativeWords (root i n) ∧
        representativeRank (root i n) = rankLabel i n.val := by
    intro i
    fin_cases i <;> decide +kernel
  exact hc i n h

private theorem edge_check (i : Fin 5) (n : Fin (candidateOrder (row i)))
    (h : depth i n.val ≠ 0) :
    depth i (parent i n).val < depth i n.val ∧
      rankLabel i (parent i n).val = rankLabel i n.val ∧
      collect 128 (inverseGeneratorWord (conjugator i n) ++
        selectWords (candidateWords (row i)) (parent i n).val ++ [conjugator i n]) =
        collect 64 (selectWords (candidateWords (row i)) n.val) := by
  have hc : ∀ (i : Fin 5) (n : Fin (candidateOrder (row i))), depth i n.val ≠ 0 →
      depth i (parent i n).val < depth i n.val ∧
        rankLabel i (parent i n).val = rankLabel i n.val ∧
        collect 128 (inverseGeneratorWord (conjugator i n) ++
          selectWords (candidateWords (row i)) (parent i n).val ++ [conjugator i n]) =
          collect 64 (selectWords (candidateWords (row i)) n.val) := by
    intro i
    fin_cases i <;> decide +kernel
  exact hc i n h

private theorem edge_rank (i : Fin 5) (n : Fin (candidateOrder (row i)))
    (h : depth i n.val ≠ 0) :
    displacementRank (point (row i) n) = displacementRank (point (row i) (parent i n)) := by
  have hc := (edge_check i n h).2.2
  have he := (collect_sound 128 _).symm.trans
    ((congrArg wordValue hc).trans (collect_sound 64 _))
  have hm := congrArg realization he
  simp only [wordValue_append, wordValue_inverseGeneratorWord, wordValue_cons,
    wordValue_nil, mul_one, map_mul, map_inv, realization_generator] at hm
  change (MatrixWords.pcGenerator (conjugator i n) : Model)⁻¹ *
    point (row i) (parent i n) * (MatrixWords.pcGenerator (conjugator i n) : Model) =
    point (row i) n at hm
  rw [← hm]
  simpa only [inv_inv] using
    displacementRank_conjugate (MatrixWords.pcGenerator (conjugator i n) : Model)⁻¹
      (point (row i) (parent i n))

/-- Complete rank transport, with only the sixteen explicit representative ranks as input. -/
theorem displacementRank_point_of_representatives
    (hr : ∀ r, displacementRank (realization (wordValue (representativeWords r))) =
      representativeRank r) (i : Fin 5) (n : Fin (candidateOrder (row i))) :
    displacementRank (point (row i) n) = rankLabel i n.val := by
  suffices hs : ∀ d, ∀ n : Fin (candidateOrder (row i)), depth i n.val = d →
      displacementRank (point (row i) n) = rankLabel i n.val from hs _ n rfl
  intro d
  induction d using Nat.strong_induction_on with
  | h d ih =>
    intro n hd
    by_cases hz : depth i n.val = 0
    · obtain ⟨hw, hv⟩ := root_check i n hz
      change displacementRank (realization (wordValue _)) = _
      rw [hw, hr, hv]
    · obtain ⟨hlt, hv, _⟩ := edge_check i n hz
      exact (edge_rank i n hz).trans ((ih _ (hd ▸ hlt) _ rfl).trans hv)

