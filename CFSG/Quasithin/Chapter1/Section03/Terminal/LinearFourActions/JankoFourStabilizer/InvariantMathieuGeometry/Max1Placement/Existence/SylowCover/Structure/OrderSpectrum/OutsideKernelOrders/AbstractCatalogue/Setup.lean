module

public import CFSG.Quasithin.Chapter1.Section03.Terminal.LinearFourActions.JankoFourStabilizer.InvariantMathieuGeometry.Max1Placement.Existence.SylowCover.Structure.OrderSpectrum.OutsideKernelOrders.Candidates
public import CFSG.Quasithin.Chapter1.Section03.Terminal.LinearFourActions.JankoFourStabilizer.InvariantMathieuGeometry.Max1Placement.Existence.SylowCover.Structure.OrderSpectrum.OutsideKernelOrders.AbstractCatalogue.Coordinates
public import Theory.SpecificGroups.Janko4.Model.LocalStructure.SylowNormalEights.Profiles.Collection

/-!
# The literal subgroup interval for the outside-kernel catalogue

The lower endpoint is `<g16,g18,g19,g20>`. The upper endpoint uses precisely
`g9,g11,g13,g14,g15,g16,g17,g18,g19,g20`. The six selected words retain the
original ascending convention. Each candidate is generated by the lower
endpoint and exactly the indicated coordinate basis; this is proved by
permuting the literal generating lists, without identifying groups by order.

`WordCalculus` records word identities and normal-form coverage needed to
apply the finite coordinate theorem. It does not assert any subgroup catalogue.
Its producer may use the authorized order hypothesis for normal-form uniqueness.
The independent localization argument must put arbitrary normal elementary
subgroups outside the marked kernel in this interval.

Source context: Aschbacher–Smith A.3.12, pp.47–48, and the presentation data
and discovery provenance cited in `OutsideKernelOrders/source/README.md`.
-/

@[expose] public section
namespace CFSG.Quasithin.Chapter1.Terminal.LinearFourActions.JankoFourStabilizer.Max1Placement.SylowCover.OutsideKernelOrders.AbstractCatalogue
open Janko4.LocalStructure.SylowNormalEights Presentation

/-- The common four-generator subgroup, without an assumed order. -/
def coreWords : List (List (Fin 21)) := [[16], [18], [19], [20]]

def core : Subgroup Carrier := wordSubgroup generator coreWords

/-- The ten-generator interval endpoint, without an assumed order or normality. -/
def envelopeWords : List (List (Fin 21)) :=
  [[9], [11], [13], [14], [15], [16], [17], [18], [19], [20]]

def envelope : Subgroup Carrier := wordSubgroup generator envelopeWords

/-- The original ascending words for the six prospective quotient coordinates. -/
def sliceWord (n : Code) : List (Fin 21) :=
  Profiles.selectWord [9, 11, 13, 14, 15, 17] n.val

def sliceValue (n : Code) : Carrier := (sliceWord n |>.map generator).prod

def conjugatorIndex : Fin 5 → Fin 21 := ![0, 1, 2, 4, 5]

/-- A generated subgroup is contained in another iff every displayed word is. -/
theorem wordSubgroup_le_iff {G : Type*} [Group G] (g : Fin 21 → G)
    (ws : List (List (Fin 21))) (A : Subgroup G) :
    wordSubgroup g ws ≤ A ↔ ∀ w ∈ ws, (w.map g).prod ∈ A := by
  rw [wordSubgroup, Subgroup.closure_le]
  constructor
  · intro h w hw
    exact h ⟨⟨w, hw⟩, rfl⟩
  · rintro h _ ⟨⟨w, hw⟩, rfl⟩
    exact h w hw

/-- Literal comparison of the marked candidate bases with the six coordinates. -/
theorem candidateWords_perm (i : Fin 9) :
    (candidateWords i).Perm (coreWords ++ (candidateBasis i).map sliceWord) := by
  exact (by decide +kernel : ∀ i : Fin 9,
    (candidateWords i).Perm (coreWords ++ (candidateBasis i).map sliceWord)) i

/-- The six-coordinate basis is attached to the actual generated subgroup. -/
theorem abstractFamily_le_iff (i : Fin 9) (A : Subgroup Carrier) :
    abstractFamily i ≤ A ↔ core ≤ A ∧ ∀ n ∈ candidateBasis i, sliceValue n ∈ A := by
  rw [abstractFamily, wordSubgroup_le_iff]
  constructor
  · intro h
    have hh : ∀ w ∈ coreWords ++ (candidateBasis i).map sliceWord,
        (w.map generator).prod ∈ A :=
      fun w hw => h w ((candidateWords_perm i).mem_iff.mpr hw)
    refine ⟨(wordSubgroup_le_iff generator coreWords A).mpr ?_, ?_⟩
    · intro w hw
      exact hh w (List.mem_append_left _ hw)
    · intro n hn
      exact hh (sliceWord n) (List.mem_append_right _ (List.mem_map.mpr ⟨n, hn, rfl⟩))
  · rintro ⟨hcore, hb⟩ w hw
    have hh := (candidateWords_perm i).mem_iff.mp hw
    rcases List.mem_append.mp hh with hh | hh
    · exact (wordSubgroup_le_iff generator coreWords A).mp hcore w hh
    · obtain ⟨n, hn, rfl⟩ := List.mem_map.mp hh
      exact hb n hn

/-- Every literal candidate contains the proposed common core. -/
theorem core_le_abstractFamily (i : Fin 9) : core ≤ abstractFamily i :=
  ((abstractFamily_le_iff i (abstractFamily i)).mp le_rfl).1

/-- Membership of a displayed coordinate basis vector in the literal candidate. -/
theorem sliceValue_mem_abstractFamily (i : Fin 9) (n : Code)
    (hn : n ∈ candidateBasis i) : sliceValue n ∈ abstractFamily i :=
  ((abstractFamily_le_iff i (abstractFamily i)).mp le_rfl).2 n hn

/-- Presentation-specific word calculations, independent of the classification.
All differences are actual products in `Presentation.Carrier`. -/
structure WordCalculus : Prop where
  core_kernel : core ≤ abstractKernel
  cover : ∀ x ∈ envelope, ∃ n : Code, x * (sliceValue n)⁻¹ ∈ core
  mul : ∀ a b : Code,
    sliceValue a * sliceValue b * (sliceValue (codeXor a b))⁻¹ ∈ core
  conjugate : ∀ (j : Fin 5) (n : Code),
    (generator (conjugatorIndex j))⁻¹ * sliceValue n * generator (conjugatorIndex j) *
      (sliceValue n)⁻¹ * (sliceValue (displacement j n))⁻¹ ∈ core
  square : ∀ n : Code, sliceValue n ^ 2 = 1 → squareZero n
  kernel : ∀ n : Code, kernelCode n → sliceValue n ∈ abstractKernel

/-- The independent localization contract. It does not assert candidate coverage. -/
def IntervalLocalization : Prop :=
  ∀ A : Subgroup Carrier, A.Normal → IsElementaryAbelian 2 A →
    ¬ A ≤ abstractKernel → core ≤ A ∧ A ≤ envelope

end CFSG.Quasithin.Chapter1.Terminal.LinearFourActions.JankoFourStabilizer.Max1Placement.SylowCover.OutsideKernelOrders.AbstractCatalogue
