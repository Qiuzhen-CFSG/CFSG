private theorem pair_rows_rank37 : (rowsMatrix pairRows37).rank = 20 := by
  rw [← decode_ofFn]
  apply rank_certificate _ (fun i : Fin 20 => basis37 i.val)
    (fun i => fromRows37 i.val) (fun i => fromBasis37 i.val) pivots37
  · have h : ∀ i : Fin 20, scan (fromRows37 i.val) pairRows37 112 0 = basis37 i.val := by decide +kernel
    simpa only [combine, get_ofFn, scan_eq, Nat.zero_add] using h
