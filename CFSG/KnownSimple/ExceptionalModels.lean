module

public import Theory.AtlasPort.LinearGroups.ReeG2.Generators
public import Theory.SpecificGroups.LieType.ExceptionalSplitModels
public import Theory.SpecificGroups.LieType.TwistedE6Model
public import Mathlib.FieldTheory.Finite.GaloisField

/-!
# Concrete exceptional Lie-family model interfaces

The small Ree family is the subgroup of `GL₇(F)` generated by the explicit
Tits-twisted root, torus and Weyl matrices. Its simple parameter range is
`|F| = 3^(2m+1)` with `m ≥ 1`; the nonsimple group at `q = 3` is excluded.
The isomorphism predicate uses this independently constructed carrier, and
transport is composition of actual multiplicative equivalences.
Canonical Galois fields supply a model for every parameter in this range.

Sources: GLS3, Theorem 2.2.7 (`refs/KGroup/GLS3/chapter2.tex`), and
Aschbacher–Smith, *The Classification of Quasithin Groups*, §A.2. The matrix
construction is ported with attribution in the imported ATLAS modules.

The split F₄/E₆/E₇/E₈ carriers use integral Chevalley root matrices and the
central quotient of their generated subgroup. Twisted ²E₆ uses the actual
pinned graph–field fixed points over GF(q²), their characteristic-prime
generated subgroup, and its central quotient. All five families admit every
prime-power q, including 2 and 3. The predicates below record actual model
isomorphisms, with existence proved for exactly these parameter ranges.

`IsExceptionalExtensionModel` assembles these six families for the known-simple
catalogue. G₂, ³D₄ and ²F₄ have separate owners. This module does not assert
simplicity or define the complete known-simple class.
-/

@[expose] public section

universe u v

namespace ExceptionalGroup

/-- An actual small Ree matrix model in its simple parameter range. -/
def IsReeG2 (G : Type u) [Group G] (q : ℕ) : Prop :=
  ∃ (m : ℕ) (F : Type) (_ : Field F) (_ : Finite F) (_ : CharP F 3),
    Atlas.ReeG2.Parameters F m ∧ q = 3 ^ (2 * m + 1) ∧
      Nonempty (G ≃* Atlas.ReeG2.Model F m)

/-- The constructed model supplies its own isomorphism witness. -/
theorem isReeG2_model (F : Type) [Field F] [Finite F] [CharP F 3]
    (m : ℕ) (h : Atlas.ReeG2.Parameters F m) :
    IsReeG2 (Atlas.ReeG2.Model F m) (3 ^ (2 * m + 1)) :=
  ⟨m, F, inferInstance, inferInstance, inferInstance, h, rfl, ⟨MulEquiv.refl _⟩⟩

/-- A concrete model exists over the canonical field for every allowed exponent. -/
theorem isReeG2_galoisField (m : ℕ) (hm : 1 ≤ m) :
    IsReeG2 (Atlas.ReeG2.Model (GaloisField 3 (2 * m + 1)) m)
      (3 ^ (2 * m + 1)) := by
  apply isReeG2_model
  exact ⟨hm, GaloisField.card 3 (2 * m + 1) (by omega)⟩

/-- The membership predicate has a model exactly in the small Ree parameter range. -/
theorem exists_isReeG2_iff (q : ℕ) :
    (∃ (G : Type) (_ : Group G), IsReeG2 G q) ↔
      ∃ m : ℕ, 1 ≤ m ∧ q = 3 ^ (2 * m + 1) := by
  constructor
  · rintro ⟨G, hG, m, F, hF, hfin, hchar, hp, hq, _⟩
    exact ⟨m, hp.positive, hq⟩
  · rintro ⟨m, hm, rfl⟩
    exact ⟨Atlas.ReeG2.Model (GaloisField 3 (2 * m + 1)) m,
      inferInstance, isReeG2_galoisField m hm⟩

variable {G : Type u} {H : Type v} [Group G] [Group H] {q : ℕ}

/-- Transport the model and its field without changing the parameters. -/
theorem IsReeG2.of_mulEquiv (h : IsReeG2 G q) (e : H ≃* G) : IsReeG2 H q := by
  rcases h with ⟨m, F, hF, hfin, hchar, hp, hq, ⟨f⟩⟩
  exact ⟨m, F, hF, hfin, hchar, hp, hq, ⟨e.trans f⟩⟩

theorem isReeG2_mulEquiv_iff (e : G ≃* H) : IsReeG2 G q ↔ IsReeG2 H q :=
  ⟨fun h => h.of_mulEquiv e.symm, fun h => h.of_mulEquiv e⟩

/-- Finiteness follows from the actual finite matrix carrier. -/
theorem IsReeG2.finite (h : IsReeG2 G q) : Finite G := by
  rcases h with ⟨m, F, hF, hfin, hchar, _, _, ⟨f⟩⟩
  exact Finite.of_equiv (Atlas.ReeG2.Model F m) f.symm.toEquiv

/-- The family starts at `q = 27`. -/
theorem IsReeG2.parameter_ge_27 (h : IsReeG2 G q) : 27 ≤ q := by
  rcases h with ⟨m, F, hF, hfin, hchar, hp, hq, _⟩
  rw [hq, ← hp.cardinality]
  exact Atlas.ReeG2.card_ge_27 hp


private theorem field_card_isPrimePow (F : Type) [Field F] [Finite F] :
    IsPrimePow (Nat.card F) := by
  let := Fintype.ofFinite F
  rw [Nat.card_eq_fintype_card]
  exact FiniteField.isPrimePow_card F

private theorem exists_coefficientField (q : ℕ) (hq : IsPrimePow q) :
    ∃ (F : Type) (_ : Field F) (_ : Finite F), Nat.card F = q := by
  obtain ⟨p, e, hp, he, hq⟩ := (isPrimePow_nat_iff q).mp hq
  let : Fact p.Prime := ⟨hp⟩
  exact ⟨GaloisField p e, inferInstance, inferInstance,
    (GaloisField.card p e (Nat.ne_of_gt he)).trans hq⟩

/-- Isomorphism to the root-generated central-quotient model of split F4. -/
def IsF4 (G : Type u) [Group G] (q : ℕ) : Prop :=
  ∃ (F : Type) (_ : Field F) (_ : Finite F),
    Nat.card F = q ∧ Nonempty (G ≃* ExceptionalSplit.F4 F)

/-- The concrete carrier realizes the field's parameter. -/
theorem isF4_model (F : Type) [Field F] [Finite F] :
    IsF4 (ExceptionalSplit.F4 F) (Nat.card F) :=
  ⟨F, inferInstance, inferInstance, rfl, ⟨MulEquiv.refl _⟩⟩

theorem IsF4.of_mulEquiv (h : IsF4 G q) (e : H ≃* G) : IsF4 H q := by
  obtain ⟨F, hF, hfin, hq, ⟨f⟩⟩ := h
  exact ⟨F, hF, hfin, hq, ⟨e.trans f⟩⟩

theorem isF4_mulEquiv_iff (e : G ≃* H) : IsF4 G q ↔ IsF4 H q :=
  ⟨fun h => h.of_mulEquiv e.symm, fun h => h.of_mulEquiv e⟩

theorem IsF4.finite (h : IsF4 G q) : Finite G := by
  obtain ⟨F, hF, hfin, _, ⟨f⟩⟩ := h
  exact Finite.of_injective f f.injective

theorem IsF4.parameter_isPrimePow (h : IsF4 G q) : IsPrimePow q := by
  obtain ⟨F, hF, hfin, rfl, _⟩ := h
  exact field_card_isPrimePow F

/-- Every prime power, with no small-field exclusion, supplies a finite model. -/
theorem IsF4.exists_model (q : ℕ) (hq : IsPrimePow q) :
    ∃ (G : Type) (_ : Group G), Finite G ∧ IsF4 G q := by
  obtain ⟨F, hF, hfin, rfl⟩ := exists_coefficientField q hq
  exact ⟨ExceptionalSplit.F4 F, inferInstance, inferInstance, isF4_model F⟩

theorem exists_isF4_iff (q : ℕ) :
    (∃ (G : Type) (_ : Group G), IsF4 G q) ↔ IsPrimePow q := by
  constructor
  · rintro ⟨G, hG, h⟩
    exact h.parameter_isPrimePow
  · intro hq
    obtain ⟨G, hG, _, h⟩ := IsF4.exists_model q hq
    exact ⟨G, hG, h⟩

