/-- Isomorphism to the pinned twisted E₆ model. The parameter is q, whereas
its matrix coefficient field has q² elements. -/
def IsTwistedE6 (G : Type u) [Group G] (q : ℕ) : Prop :=
  ∃ (p m : ℕ) (_ : Fact p.Prime),
    TwistedE6.parameter p m = q ∧ Nonempty (G ≃* TwistedE6.Model p m)

theorem isTwistedE6_model (p m : ℕ) [Fact p.Prime] :
    IsTwistedE6 (TwistedE6.Model p m) (TwistedE6.parameter p m) :=
  ⟨p, m, inferInstance, rfl, ⟨MulEquiv.refl _⟩⟩

theorem IsTwistedE6.of_mulEquiv (h : IsTwistedE6 G q) (e : H ≃* G) :
    IsTwistedE6 H q := by
  obtain ⟨p, m, hp, hq, ⟨f⟩⟩ := h
  exact ⟨p, m, hp, hq, ⟨e.trans f⟩⟩

theorem isTwistedE6_mulEquiv_iff (e : G ≃* H) :
    IsTwistedE6 G q ↔ IsTwistedE6 H q :=
  ⟨fun h => h.of_mulEquiv e.symm, fun h => h.of_mulEquiv e⟩

theorem IsTwistedE6.finite (h : IsTwistedE6 G q) : Finite G := by
  obtain ⟨p, m, hp, _, ⟨f⟩⟩ := h
  exact Finite.of_injective f f.injective

theorem IsTwistedE6.parameter_isPrimePow (h : IsTwistedE6 G q) : IsPrimePow q := by
  obtain ⟨p, m, hp, rfl, _⟩ := h
  exact TwistedE6.parameter_isPrimePow p m

/-- The pinned construction supplies every prime power, including q = 2. -/
theorem IsTwistedE6.exists_model (q : ℕ) (hq : IsPrimePow q) :
    ∃ (G : Type) (_ : Group G), Finite G ∧ IsTwistedE6 G q := by
  obtain ⟨p, m, hp, rfl⟩ := TwistedE6.exists_parameter q hq
  let : Fact p.Prime := ⟨hp⟩
  exact ⟨TwistedE6.Model p m, inferInstance, inferInstance, isTwistedE6_model p m⟩

theorem exists_isTwistedE6_iff (q : ℕ) :
    (∃ (G : Type) (_ : Group G), IsTwistedE6 G q) ↔ IsPrimePow q := by
  constructor
  · rintro ⟨G, hG, h⟩
    exact h.parameter_isPrimePow
  · intro hq
    obtain ⟨G, hG, _, h⟩ := IsTwistedE6.exists_model q hq
    exact ⟨G, hG, h⟩

end ExceptionalGroup

namespace CFSG.KnownSimple

/-- The six exceptional families supplied here to the full carrier catalogue.
Each branch contains an actual model isomorphism in its simple parameter range. -/
inductive IsExceptionalExtensionModel (G : Type u) [Group G] : Prop
  | f4 (q : ℕ) (model : ExceptionalGroup.IsF4 G q)
  | e6 (q : ℕ) (model : ExceptionalGroup.IsE6 G q)
  | e7 (q : ℕ) (model : ExceptionalGroup.IsE7 G q)
  | e8 (q : ℕ) (model : ExceptionalGroup.IsE8 G q)
  | twistedE6 (q : ℕ) (model : ExceptionalGroup.IsTwistedE6 G q)
  | reeG2 (q : ℕ) (model : ExceptionalGroup.IsReeG2 G q)

variable {G : Type u} {H : Type v} [Group G] [Group H]

/-- Model witnesses transport across universes by composing isomorphisms. -/
theorem IsExceptionalExtensionModel.of_mulEquiv
    (h : IsExceptionalExtensionModel G) (e : H ≃* G) :
    IsExceptionalExtensionModel H := by
  cases h with
  | f4 q h => exact .f4 q (h.of_mulEquiv e)
  | e6 q h => exact .e6 q (h.of_mulEquiv e)
  | e7 q h => exact .e7 q (h.of_mulEquiv e)
  | e8 q h => exact .e8 q (h.of_mulEquiv e)
  | twistedE6 q h => exact .twistedE6 q (h.of_mulEquiv e)
  | reeG2 q h => exact .reeG2 q (h.of_mulEquiv e)

/-- Finiteness follows from the constructed carriers. -/
theorem IsExceptionalExtensionModel.finite (h : IsExceptionalExtensionModel G) :
    Finite G := by
  cases h with
  | f4 _ h => exact h.finite
  | e6 _ h => exact h.finite
  | e7 _ h => exact h.finite
  | e8 _ h => exact h.finite
  | twistedE6 _ h => exact h.finite
  | reeG2 _ h => exact h.finite

theorem isExceptionalExtensionModel_mulEquiv_iff (e : G ≃* H) :
    IsExceptionalExtensionModel G ↔ IsExceptionalExtensionModel H :=
  ⟨fun h => h.of_mulEquiv e.symm, fun h => h.of_mulEquiv e⟩

end CFSG.KnownSimple
