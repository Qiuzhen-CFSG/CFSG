module

public import Theory.SpecificGroups.Fischer.AtlasCarriers.Fi22
public import Theory.SpecificGroups.Fischer.AtlasCarriers.Fi23
public import Theory.SpecificGroups.Fischer.AtlasCarriers.Fi24Prime

/-!
# The three Fischer carriers for the known-simple catalogue

These entries are Fi₂₂, Fi₂₃ and Fi₂₄′, as listed in GLS3, Theorem 2.2.7
and Definition 2.2.8 (`refs/KGroup/GLS3/chapter2.tex`). We use the ATLAS
permutation representations `F22G1-p3510B0`, `F23G1-p31671B0` and
`F24G1-p306936B0`. Each carrier is the subgroup generated by the exact
published permutations. The retained source tables, provenance, and
reproducible transcription are under
`Theory/SpecificGroups/Fischer/AtlasCarriers/source/`.

In particular the third representation is Fi₂₄′ itself, not the full
Fi₂₄ = Fi₂₄′:2 group or the triple cover. These are alternate sourced
representations to the algebra-derived residue quotients and parity kernel
in the separate Atlas Lean port. No isomorphism with that port is asserted.

Membership is actual multiplicative equivalence to one of these fixed
carriers. The transport proof composes equivalences. No order or simplicity
certificate is needed to define this contribution. Full catalogue assembly
is owned by `CarrierCatalogue`; this module does not alter its interfaces.
-/

@[expose] public section

namespace CFSG.KnownSimple

universe u v

/-- The three simple Fischer entries; the third is explicitly Fi₂₄′. -/
inductive FischerSporadicName
  | fi22
  | fi23
  | fi24Prime

/-- The fixed sourced permutation carrier for each Fischer entry. -/
def FischerSporadicName.Carrier : FischerSporadicName → Type
  | .fi22 => Sporadic.Fischer.Fi22.Carrier
  | .fi23 => Sporadic.Fischer.Fi23.Carrier
  | .fi24Prime => Sporadic.Fischer.Fi24Prime.Carrier

instance FischerSporadicName.carrierGroup (name : FischerSporadicName) :
    Group name.Carrier := by
  cases name <;> unfold FischerSporadicName.Carrier <;> infer_instance

instance FischerSporadicName.carrierFinite (name : FischerSporadicName) :
    Finite name.Carrier := by
  cases name <;> unfold FischerSporadicName.Carrier <;> infer_instance

/-- Isomorphism to one of the three concrete sourced Fischer carriers. -/
def IsFischerSporadicCarrier (G : Type u) [Group G] : Prop :=
  ∃ name : FischerSporadicName, Nonempty (G ≃* name.Carrier)

theorem isFischerSporadicCarrier_carrier (name : FischerSporadicName) :
    IsFischerSporadicCarrier name.Carrier := ⟨name, ⟨MulEquiv.refl _⟩⟩

variable {G : Type u} {H : Type v} [Group G] [Group H]

theorem IsFischerSporadicCarrier.of_mulEquiv
    (h : IsFischerSporadicCarrier G) (e : H ≃* G) :
    IsFischerSporadicCarrier H := by
  obtain ⟨name, ⟨f⟩⟩ := h
  exact ⟨name, ⟨e.trans f⟩⟩

theorem isFischerSporadicCarrier_mulEquiv_iff (e : G ≃* H) :
    IsFischerSporadicCarrier G ↔ IsFischerSporadicCarrier H :=
  ⟨fun h => h.of_mulEquiv e.symm, fun h => h.of_mulEquiv e⟩

end CFSG.KnownSimple
