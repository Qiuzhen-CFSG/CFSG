/-!
# The currently available sporadic carriers

This is explicitly a partial catalogue: fifteen of the twenty-six sporadics.
It does not include J₂, HS, Co₁, Co₂, Co₃, McL, Suz, Fi₂₂, Fi₂₃, Fi₂₄′ or M.
In particular no unspecified carrier stands for any of these missing groups.

The imported Mathieu groups use their concrete permutation constructions.
J₁, J₄, HN, Ly and Th use the published ATLAS matrices; J₃, He and Ru use
the published ATLAS permutations. O'N is the projective image of the ATLAS
45-dimensional representation of **3.O'N**, not that central cover.
The HN and Th carriers are units of the monoids generated by the source
matrices; their generator inverse certificates are in their respective
`Generators` and `Model.GeneratorCertificates` extensions. The Baby Monster
uses the eleven-generator Y₄₃₃ presentation, including both ninth-power
relations that remove the central extension (Breuer–Magaard–Wilson, §3.1).
Each imported construction records its exact source data and action convention.

Membership means an actual multiplicative equivalence to one of these fixed
carriers. Transport is composition of equivalences. No order or simplicity
certificate is required to define this partial list; no such certificate is
asserted here. The full catalogue owner must add the eleven missing carriers,
using Fi₂₄′ rather than the nonsimple full Fischer group Fi₂₄.
-/

@[expose] public section

namespace CFSG.KnownSimple

universe u v

/-- Names of the fifteen sporadic carriers currently available to this catalogue.
This enumeration is not the full list of sporadic simple groups. -/
inductive ConstructedSporadicName
  | m11
  | m12
  | m22
  | m23
  | m24
  | j1
  | j3
  | j4
  | he
  | ru
  | hn
  | ly
  | th
  | onan
  | babyMonster

/-- The fixed sourced construction corresponding to each available name. -/
def ConstructedSporadicName.Carrier : ConstructedSporadicName → Type
  | .m11 => Sporadic.Mathieu.M11
  | .m12 => Sporadic.Mathieu.M12
  | .m22 => Sporadic.Mathieu.M22
  | .m23 => Sporadic.Mathieu.M23
  | .m24 => Sporadic.Mathieu.M24
  | .j1 => Janko1.Model
  | .j3 => Sporadic.Janko3.Model
  | .j4 => Janko4.Model
  | .he => Held.He
  | .ru => Rudvalis.Model
  | .hn => HaradaNorton.HN
  | .ly => Lyons.LyonsGroup
  | .th => Thompson.Model
  | .onan => ONan.Model
  | .babyMonster => BabyMonster.Carrier

noncomputable instance ConstructedSporadicName.carrierGroup (name : ConstructedSporadicName) :
    Group name.Carrier := by
  cases name <;> unfold ConstructedSporadicName.Carrier <;> infer_instance

/-- Isomorphism to one of the available fixed sporadic carriers. -/
def IsConstructedSporadicCarrier (G : Type u) [Group G] : Prop :=
  ∃ name : ConstructedSporadicName, Nonempty (G ≃* name.Carrier)

theorem isConstructedSporadicCarrier_carrier (name : ConstructedSporadicName) :
    IsConstructedSporadicCarrier name.Carrier := ⟨name, ⟨MulEquiv.refl _⟩⟩

variable {G : Type u} {H : Type v} [Group G] [Group H]

theorem IsConstructedSporadicCarrier.of_mulEquiv
    (h : IsConstructedSporadicCarrier G) (e : H ≃* G) :
    IsConstructedSporadicCarrier H := by
  obtain ⟨name, ⟨f⟩⟩ := h
  exact ⟨name, ⟨e.trans f⟩⟩

theorem isConstructedSporadicCarrier_mulEquiv_iff (e : G ≃* H) :
    IsConstructedSporadicCarrier G ↔ IsConstructedSporadicCarrier H :=
  ⟨fun h => h.of_mulEquiv e.symm, fun h => h.of_mulEquiv e⟩

end CFSG.KnownSimple
