module

public import BenderSuzuki.PFAppendixII.proposition_1
public import Theory.Quasithin.Rank
public import Theory.GroupTheory.PGroup.UniqueInvolution

/-!
# Involution generation in rank one

A finite group without an elementary four has a unique involution in each
nontrivial Sylow two-subgroup. Sylow conjugacy therefore conjugates any two
involutions. The odd-core/centralizer factorization makes their images central
modulo the odd core, so all these images coincide. If involutions generate the
group, the quotient is generated by the image of any one of them.

The numerical rank bridge is independent of generation: every abelian
two-subgroup is cyclic, while an involution supplies a subgroup of rank one.

Source: Aschbacher--Smith, *The Classification of Quasithin Groups*, Theorem
I.8.2, printed p. 429 (PDF p. 440), rank-one paragraph; GLS, *The Classification
of the Finite Simple Groups*, Number 4, Chapter 2, paragraph following Theorem
ZD. The Brauer--Suzuki input is the proved odd-core/centralizer factorization
in Peterfalvi Appendix II, Proposition 1.
-/

namespace BenderSuzuki.ZD

open PFchapter1section1 PFAppendixII PFAppendixIII
open scoped Pointwise IsMulCommutative

private theorem twoRankAtLeastTwo_of_subgroup
    {G : Type*} [Group G] [Finite G] (P : Subgroup G)
    (hP : TwoRankAtLeastTwo P) : TwoRankAtLeastTwo G := by
  rcases hP with ⟨E, hEcard, hEsq⟩
  refine ⟨E.map P.subtype, ?_, ?_⟩
  · rw [Subgroup.card_map_of_injective P.subtype_injective]
    exact hEcard
  · rintro ⟨x, hx⟩
    rcases hx with ⟨y, hy, rfl⟩
    apply Subtype.ext
    exact congrArg (fun z : E => ((z : P) : G)) (hEsq ⟨y, hy⟩)

private theorem involutions_eq_of_not_twoRank
    {P : Type*} [Group P] [Finite P]
    (hp : IsPGroup 2 P) (hr : ¬ TwoRankAtLeastTwo P)
    {x y : P} (hx : IsInvolution x) (hy : IsInvolution y) : x = y := by
  let : Nontrivial P := ⟨⟨x, 1, hx.ne_one⟩⟩
  obtain ⟨U, _, hU⟩ := unique_order_two_subgroup_of_not_twoRank hp hr
  have hxcard : Nat.card (Subgroup.zpowers x) = 2 := by
    rw [Nat.card_zpowers, orderOf_eq_prime hx.2 hx.1]
  have hycard : Nat.card (Subgroup.zpowers y) = 2 := by
    rw [Nat.card_zpowers, orderOf_eq_prime hy.2 hy.1]
  have hxy : Subgroup.zpowers x = Subgroup.zpowers y := (hU _ hxcard).trans (hU _ hycard).symm
  have hym : y ∈ Subgroup.zpowers x := hxy ▸ Subgroup.mem_zpowers y
  obtain ⟨z, _, hz⟩ := (Nat.card_eq_two_iff' (1 : Subgroup.zpowers x)).mp hxcard
  have hx1 : (⟨x, Subgroup.mem_zpowers x⟩ : Subgroup.zpowers x) ≠ 1 :=
    fun h => hx.1 (congrArg Subtype.val h)
  have hy1 : (⟨y, hym⟩ : Subgroup.zpowers x) ≠ 1 :=
    fun h => hy.1 (congrArg Subtype.val h)
  exact congrArg Subtype.val ((hz _ hx1).trans (hz _ hy1).symm)

private theorem isPGroup_zpowers {G : Type*} [Group G] [Finite G]
    {x : G} (hx : IsInvolution x) : IsPGroup 2 (Subgroup.zpowers x) := by
  apply IsPGroup.of_card (n := 1)
  rw [Nat.card_zpowers, orderOf_eq_prime hx.2 hx.1]
  rfl

/-- Without an elementary four, all involutions are conjugate, by Sylow conjugacy. -/
public theorem involutions_conjugate_of_not_twoRank
    {G : Type*} [Group G] [Finite G]
    (hr : ¬ TwoRankAtLeastTwo G) {x y : G}
    (hx : IsInvolution x) (hy : IsInvolution y) :
    ∃ g : G, g * x * g⁻¹ = y := by
  obtain ⟨P, hP⟩ := (isPGroup_zpowers hx).exists_le_sylow
  obtain ⟨Q, hQ⟩ := (isPGroup_zpowers hy).exists_le_sylow
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq G P Q
  have hxP := hP (Subgroup.mem_zpowers x)
  have hyQ := hQ (Subgroup.mem_zpowers y)
  have hxQ : g * x * g⁻¹ ∈ (Q : Subgroup G) := by
    rw [← hg, Sylow.coe_subgroup_smul]
    exact Set.mem_smul_set.mpr ⟨x, hxP, rfl⟩
  have hxg : IsInvolution (g * x * g⁻¹) := by
    simpa [rightConjugateElem] using isInvolution_rightConjugateElem (g := g⁻¹) hx
  have hxx : IsInvolution (⟨g * x * g⁻¹, hxQ⟩ : Q) := by
    refine ⟨fun h => hxg.1 (congrArg Subtype.val h), ?_⟩
    exact Subtype.ext hxg.2
  have hyy : IsInvolution (⟨y, hyQ⟩ : Q) :=
    ⟨fun h => hy.1 (congrArg Subtype.val h), Subtype.ext hy.2⟩
  exact ⟨g, congrArg Subtype.val (involutions_eq_of_not_twoRank Q.isPGroup'
    (fun h => hr (twoRankAtLeastTwo_of_subgroup Q h)) hxx hyy)⟩

/-- Absence of an elementary four bounds the numerical two-rank by one. -/
public theorem primeRank_two_le_one_of_not_twoRank
    {G : Type*} [Group G] [Finite G] (hr : ¬ TwoRankAtLeastTwo G) :
    primeRank 2 G ≤ 1 := by
  classical
  apply (primeRank_le_iff 2 1).2
  intro A hp hc
  let : IsMulCommutative A := hc
  have hcyc : IsCyclic A := by
    by_cases hA : A = ⊥
    · subst A; infer_instance
    have huniq : ∀ x y : A, orderOf x = 2 → orderOf y = 2 → x = y := by
      intro x y hx hy
      apply involutions_eq_of_not_twoRank hp
        (fun h => hr (twoRankAtLeastTwo_of_subgroup A h))
      · exact (orderOf_eq_prime_iff).mp hx |>.symm
      · exact (orderOf_eq_prime_iff).mp hy |>.symm
    exact hp.isCyclic_of_unique_involution_of_isMulCommutative
      (by
        obtain ⟨a, ha, hane⟩ := A.bot_or_exists_ne_one.resolve_left hA
        let : Nontrivial A := ⟨⟨⟨a, ha⟩, 1, fun h => hane (congrArg Subtype.val h)⟩⟩
        have hdiv : 2 ∣ Nat.card A := hp.card_eq_or_dvd.resolve_left
          (Nat.ne_of_gt (Finite.one_lt_card))
        obtain ⟨z, hz⟩ := exists_prime_orderOf_dvd_card' (G := A) 2 hdiv
        exact ⟨z, hz, fun x hx => huniq x z hx hz⟩)
  obtain ⟨a, ha⟩ := (isCyclic_iff_exists_zpowers_eq_top (α := A)).mp hcyc
  have h : Subgroup.closure (({a} : Finset A) : Set A) = ⊤ := by
    simpa only [Finset.coe_singleton, ← Subgroup.zpowers_eq_closure] using ha
  simpa only [Finset.card_singleton] using Group.rank_le h

/-- Absence of an elementary four and existence of an involution give exact two-rank one. -/
public theorem primeRank_two_eq_one_of_not_twoRank
    {G : Type*} [Group G] [Finite G] (hr : ¬ TwoRankAtLeastTwo G)
    {z : G} (hz : IsInvolution z) : primeRank 2 G = 1 := by
  apply le_antisymm (primeRank_two_le_one_of_not_twoRank hr)
  let A := Subgroup.zpowers z
  let : Nontrivial A := ⟨⟨⟨z, Subgroup.mem_zpowers z⟩, 1,
    fun h => hz.ne_one (congrArg Subtype.val h)⟩⟩
  exact (Group.rank_pos (G := A)).trans_le
    (le_csSup (primeRank_bddAbove 2 G) ⟨A, isPGroup_zpowers hz,
      inferInstance, inferInstance, le_rfl⟩)

/-- Every involution is central modulo the odd core when there is no elementary four. -/
public theorem involution_image_mem_center_of_not_twoRank
    {G : Type*} [Group G] [Finite G] (hr : ¬ TwoRankAtLeastTwo G)
    {z : G} (hz : IsInvolution z) :
    QuotientGroup.mk' (pPrimeCore 2 G) z ∈ Subgroup.center (G ⧸ pPrimeCore 2 G) := by
  let N : Subgroup G := pPrimeCore 2 G
  let q : G →* G ⧸ N := QuotientGroup.mk' N
  have hfactor : N ⊔ Subgroup.centralizer ({z} : Set G) = ⊤ :=
    pPrimeCore_sup_centralizer_eq_top_of_not_twoRank hr hz
  change q z ∈ Subgroup.center (G ⧸ N)
  rw [Subgroup.mem_center_iff]
  intro y
  obtain ⟨g, rfl⟩ := QuotientGroup.mk'_surjective N y
  have hgSup : g ∈ N ⊔ Subgroup.centralizer ({z} : Set G) := by
    rw [hfactor]
    exact Subgroup.mem_top g
  rcases Subgroup.mem_sup_of_normal_left.mp hgSup with ⟨n, hn, c, hc, hnc⟩
  have hcomm : c * z = z * c := Subgroup.mem_centralizer_singleton_iff.mp hc
  have hqn : q n = 1 := (QuotientGroup.eq_one_iff n).2 hn
  have hqg : q g = q c := by
    calc
      q g = q (n * c) := by rw [hnc]
      _ = q n * q c := map_mul q n c
      _ = q c := by rw [hqn, one_mul]
  rw [hqg]
  simpa using congrArg q hcomm

/-- Any two involutions have the same image modulo the odd core in rank one. -/
public theorem involution_images_eq_of_not_twoRank
    {G : Type*} [Group G] [Finite G] (hr : ¬ TwoRankAtLeastTwo G)
    {x z : G} (hx : IsInvolution x) (hz : IsInvolution z) :
    QuotientGroup.mk' (pPrimeCore 2 G) x = QuotientGroup.mk' (pPrimeCore 2 G) z := by
  let q : G →* G ⧸ pPrimeCore 2 G := QuotientGroup.mk' (pPrimeCore 2 G)
  obtain ⟨g, hg⟩ := involutions_conjugate_of_not_twoRank hr hz hx
  have hc : q g * q z = q z * q g :=
    Subgroup.mem_center_iff.mp (involution_image_mem_center_of_not_twoRank hr hz) (q g)
  change q x = q z
  rw [← hg, map_mul, map_mul, map_inv, hc]
  group

/-- A rank-one group generated by involutions is the product of its odd core
and the cyclic subgroup of any involution. -/
public theorem pPrimeCore_sup_zpowers_eq_top_of_involution_generated
    {G : Type*} [Group G] [Finite G] (hr : ¬ TwoRankAtLeastTwo G)
    (Z : Set G) (hZ : ∀ x ∈ Z, IsInvolution x) (hgen : Subgroup.closure Z = ⊤)
    {z : G} (hz : IsInvolution z) :
    pPrimeCore 2 G ⊔ Subgroup.zpowers z = ⊤ := by
  let N : Subgroup G := pPrimeCore 2 G
  let q : G →* G ⧸ N := QuotientGroup.mk' N
  have hle : Subgroup.closure Z ≤ (Subgroup.zpowers (q z)).comap q := by
    rw [Subgroup.closure_le]
    intro x hx
    change q x ∈ Subgroup.zpowers (q z)
    rw [show q x = q z from involution_images_eq_of_not_twoRank hr (hZ x hx) hz]
    exact Subgroup.mem_zpowers _
  have hK : (Subgroup.zpowers (q z)).comap q = ⊤ := top_unique (hgen ▸ hle)
  rw [← q.map_zpowers, QuotientGroup.comap_map_mk'] at hK
  exact hK

/-- The complete rank-one branch for a nonempty generating set of involutions:
numerical two-rank one and the odd-core factorization for every generator. -/
public theorem rank_one_involution_generated
    {G : Type*} [Group G] [Finite G] (hr : ¬ TwoRankAtLeastTwo G)
    (Z : Set G) (hZ : ∀ x ∈ Z, IsInvolution x) (hne : Z.Nonempty)
    (hgen : Subgroup.closure Z = ⊤) :
    primeRank 2 G = 1 ∧ ∀ z ∈ Z, pPrimeCore 2 G ⊔ Subgroup.zpowers z = ⊤ := by
  obtain ⟨z, hz⟩ := hne
  exact ⟨primeRank_two_eq_one_of_not_twoRank hr (hZ z hz),
    fun x hx => pPrimeCore_sup_zpowers_eq_top_of_involution_generated hr Z hZ hgen (hZ x hx)⟩

end BenderSuzuki.ZD
