module

public import Theory.GroupTheory.ProductDisconnected
public import BenderSuzuki.SE.Basic

/-!
# Elementary reductions for product disconnection

Product disconnection restricts to a subgroup meeting the distinguished set
and not contained in the distinguished subgroup. In particular it restricts
to the subgroup generated by that set. Commuting involutions cannot cross
the distinguished subgroup's boundary.

Source: GLS, Volume 4, Chapter 2, (1D), (1E), and the basic setup in Section 3.
The properness condition in (1D) is `H ≰ M`, as used in (4B)–(4C).
-/

namespace BenderSuzuki.ZD

open Theory.GroupTheory PFAppendixIII

variable {G : Type*} [Group G] {Z : Set G} {M : Subgroup G}

/-- Restriction of Definition ZD to a subgroup. -/
public theorem productDisconnected_subgroup
    (h : IsProductDisconnected Z M) (H : Subgroup G)
    (hHM : ¬ H ≤ M) (hne : ∃ z ∈ Z, z ∈ H ∧ z ∈ M) :
    IsProductDisconnected (H.subtype ⁻¹' Z) (M.comap H.subtype) := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro z hz
    exact BenderSuzuki.IsInvolution.subtype (h.involutions z hz) z.property
  · intro g z hz
    exact h.invariant g z hz
  · intro heq
    apply hHM
    intro x hx
    have : (⟨x, hx⟩ : H) ∈ M.comap H.subtype := by
      rw [heq]
      exact Subgroup.mem_top _
    exact this
  · obtain ⟨z, hz, hzH, hzM⟩ := hne
    exact ⟨⟨z, hzH⟩, hz, hzM⟩
  · intro z hz hzM g
    exact h.conjugate_mem_iff z hz hzM g
  · intro x hx z hz hinv hM g hg
    apply h.product_centralizer x hx z hz
      (BenderSuzuki.IsInvolution.map_of_injective hinv H.subtype
        Subtype.val_injective) hM
    apply Subgroup.mem_centralizer_singleton_iff.mpr
    exact congrArg H.subtype (Subgroup.mem_centralizer_singleton_iff.mp hg)

/-- The generated subgroup inherits product disconnection. -/
public theorem productDisconnected_closure (h : IsProductDisconnected Z M) :
    IsProductDisconnected ((Subgroup.closure Z).subtype ⁻¹' Z)
      (M.comap (Subgroup.closure Z).subtype) := by
  apply productDisconnected_subgroup h _ h.closure_not_le
  obtain ⟨z, hz, hzM⟩ := h.nonempty
  exact ⟨z, hz, Subgroup.subset_closure hz, hzM⟩

/-- An element commuting with a distinguished involution in `M` lies in `M`. -/
public theorem mem_of_commute (h : IsProductDisconnected Z M)
    {z x : G} (hz : z ∈ Z) (hzM : z ∈ M) (hc : Commute z x) : x ∈ M := by
  apply h.centralizer_le hz hzM
  exact Subgroup.mem_centralizer_singleton_iff.mpr hc.eq.symm

/-- The two parts of the commuting graph have no edges between them. -/
public theorem not_commute_of_not_mem (h : IsProductDisconnected Z M)
    {z x : G} (hz : z ∈ Z) (hzM : z ∈ M) (hxM : x ∉ M) : ¬ Commute z x := by
  intro hc
  exact hxM (mem_of_commute h hz hzM hc)

/-- Both parts of the disconnected commuting graph are nonempty. -/
public theorem exists_not_mem (h : IsProductDisconnected Z M) :
    ∃ z ∈ Z, z ∉ M := by
  classical
  by_contra hnone
  apply h.closure_not_le
  apply (Subgroup.closure_le M).mpr
  intro z hz
  by_contra hzM
  exact hnone ⟨z, hz, hzM⟩

/-- Every subgroup of `M` containing a distinguished involution has its
ambient normalizer in `M` (the normalizer part of GLS Lemma 3.1). -/
public theorem normalizer_le (h : IsProductDisconnected Z M)
    {H : Subgroup G} (hHM : H ≤ M) (hne : (Z ∩ (H : Set G)).Nonempty) :
    Subgroup.normalizer (H : Set G) ≤ M := by
  obtain ⟨z, hz, hzH⟩ := hne
  intro g hg
  apply (h.conjugate_mem_iff z hz (hHM hzH) g).mp
  exact hHM ((Subgroup.mem_normalizer_iff.mp hg z).mp hzH)

/-- The distinguished subgroup is self-normalizing. -/
public theorem normalizer_eq (h : IsProductDisconnected Z M) :
    Subgroup.normalizer (M : Set G) = M :=
  le_antisymm (normalizer_le h le_rfl h.nonempty) M.le_normalizer

/-- In a simple ambient group the distinguished involutions generate the
whole group. This uses only nonemptiness and invariance, not recognition. -/
public theorem closure_eq_top_of_simple (h : IsProductDisconnected Z M)
    (hsimple : IsSimpleGroup G) : Subgroup.closure Z = ⊤ := by
  rcases hsimple.eq_bot_or_eq_top_of_normal (Subgroup.closure Z)
      h.closure_normal with hbot | htop
  · exact False.elim (h.closure_not_le (hbot ▸ bot_le))
  · exact htop

end BenderSuzuki.ZD
