module

public import BenderSuzuki.ZD.Recognition.MinimalReduction.LocalBasic
public import BenderSuzuki.SE.StrongEmbeddingConjugacy

/-!
# Local structure for GLS Lemma 4.10

For the centralizer H of the involution u, the distinguished local closure
L is normal in H and is not contained in M. Strong embedding makes the
involutions of L conjugate. Since z lies outside the ambient normal subgroup
N, every involution of L lies outside N, and the intrinsic intersection of
L with N has odd order. This also proves the local conjugacy step directly,
without importing an assertion of source Lemma 4.6.

The cover of L by the odd core of H and the subgroup generated by z gives
clause (b). Establishing that cover and quotient centrality, and constructing
the weakly closed Sylow configuration for clause (c), remain separate steps.
All normality and intersection statements here are relative to H or L;
only the final odd-core containment statement maps back to the ambient group.

Source: GLS, Volume 4, Chapter 2, Lemma 4.10,
`refs/KGroup/GLS4/Chapter2.tex`, lines 692–708.
-/

namespace BenderSuzuki.ZD.Centralizers
open PFAppendixIII PFchapter1section1 Theory.GroupTheory
variable {G : Type*} [Group G] [Finite G] {Z : Set G} {M : Subgroup G}

omit [Finite G] in
/-- An involution centralizer is proper when every solvable normal subgroup is trivial. -/
public theorem centralizer_ne_top_of_no_solvable_normal (hsol : ∀ A : Subgroup G, A.Normal → Group.IsSolvable A → A = ⊥)
    {u : G} (hu : IsInvolution u) : Subgroup.centralizer ({u} : Set G) ≠ ⊤ := by
  intro htop
  have huZ : u ∈ Subgroup.center G := by
    rw [Subgroup.mem_center_iff]
    intro g
    apply Subgroup.mem_centralizer_singleton_iff.mp
    rw [htop]
    trivial
  rw [hsol (Subgroup.center G) inferInstance (Group.isSolvable_of_comm (fun x y => mul_comm' x y))] at huZ
  exact hu.ne_one huZ

private theorem odd_normal_of_stronglyEmbedded (P K : Subgroup G) (hP : IsStronglyEmbedded P) [K.Normal]
    {z : G} (hz : IsInvolution z) (hzK : z ∉ K) : Odd (Nat.card K) := by
  apply Nat.not_even_iff_odd.mp
  intro heven
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨x, hx⟩ := exists_prime_orderOf_dvd_card' (G := K) 2 heven.two_dvd
  have hxI : IsInvolution (x : G) := by
    have hord : orderOf (x : G) = 2 := by rw [Subgroup.orderOf_coe, hx]
    exact ⟨(orderOf_eq_prime_iff.mp hord).2, (orderOf_eq_prime_iff.mp hord).1⟩
  obtain ⟨g, hg⟩ := hP.involutions_conjugate hxI hz
  apply hzK
  rw [← hg]
  simpa only [rightConjugateElem, inv_inv] using
    (inferInstance : K.Normal).conj_mem x x.property g⁻¹

omit [Finite G] in
/-- The local distinguished closure is normal in the local overgroup, not necessarily in G. -/
public theorem local_closure_normal (h : IsProductDisconnected Z M) (H : Subgroup G)
    (hHM : ¬ H ≤ M) (hne : ∃ z ∈ Z, z ∈ H ∧ z ∈ M) :
    (Subgroup.closure (H.subtype ⁻¹' Z)).Normal :=
  (productDisconnected_subgroup h H hHM hne).closure_normal

/-- The intrinsic intersection with an ambient normal subgroup omitting z has odd order. -/
public theorem local_closure_odd_intersection
    (H N : Subgroup G) [N.Normal] {z : G} (hz : z ∈ Z)
    (hzH : z ∈ H) (hzN : z ∉ N)
    (hI : ∀ x ∈ Z, IsInvolution x)
    (hSE : IsStronglyEmbedded
      ((M.comap H.subtype).comap (Subgroup.closure (H.subtype ⁻¹' Z)).subtype)) :
    Odd (Nat.card ((N.comap H.subtype).comap
      (Subgroup.closure (H.subtype ⁻¹' Z)).subtype)) := by
  let L := Subgroup.closure (H.subtype ⁻¹' Z)
  let zH : H := ⟨z, hzH⟩
  have hzL : zH ∈ L := Subgroup.subset_closure hz
  exact odd_normal_of_stronglyEmbedded _ _ hSE
    (BenderSuzuki.IsInvolution.subtype
      (BenderSuzuki.IsInvolution.subtype (hI z hz) hzH) hzL) hzN

/-- Every distinguished element of H is conjugate to z by an element of the local closure. -/
public theorem local_closure_conjugacy
    (h : IsProductDisconnected Z M) (H : Subgroup G)
    {z : G} (hz : z ∈ Z) (hzH : z ∈ H)
    (hSE : IsStronglyEmbedded
      ((M.comap H.subtype).comap (Subgroup.closure (H.subtype ⁻¹' Z)).subtype)) :
    ∀ x : H, (x : G) ∈ Z →
      ∃ g : Subgroup.closure (H.subtype ⁻¹' Z),
        rightConjugateElem (⟨z, hzH⟩ : H) (g : H) = x := by
  intro x hx
  let L := Subgroup.closure (H.subtype ⁻¹' Z)
  have hzL : (⟨z, hzH⟩ : H) ∈ L := Subgroup.subset_closure hz
  have hxL : x ∈ L := Subgroup.subset_closure hx
  obtain ⟨g, hg⟩ := hSE.involutions_conjugate
    (BenderSuzuki.IsInvolution.subtype
      (BenderSuzuki.IsInvolution.subtype (h.involutions z hz) hzH) hzL)
    (BenderSuzuki.IsInvolution.subtype
      (BenderSuzuki.IsInvolution.subtype (h.involutions x hx) x.property) hxL)
  exact ⟨g, congrArg L.subtype hg⟩

/-- The local input for Lemma 4.10, derived from product disconnection and local strong embedding. -/
public theorem centralizer_local_structure
    (h : IsProductDisconnected Z M)
    (hsol : ∀ A : Subgroup G, A.Normal → Group.IsSolvable A → A = ⊥)
    (hlocal : ∀ H : Subgroup G, H ≠ ⊤ → ¬ H ≤ M →
      (∃ z ∈ Z, z ∈ H ∧ z ∈ M) →
      IsStronglyEmbedded
        ((M.comap H.subtype).comap (Subgroup.closure (H.subtype ⁻¹' Z)).subtype))
    (N : Subgroup G) [N.Normal] {z : G} (hz : z ∈ Z)
    (hzM : z ∈ M) (hzN : z ∉ N) {u : G} (hu : IsInvolution u)
    (huz : Commute u z) (huM : ¬ Subgroup.centralizer ({u} : Set G) ≤ M) :
    let H := Subgroup.centralizer ({u} : Set G)
    let L := Subgroup.closure (H.subtype ⁻¹' Z)
    H ≠ ⊤ ∧ L.Normal ∧ ¬ L ≤ M.comap H.subtype ∧
      Odd (Nat.card ((N.comap H.subtype).comap L.subtype)) := by
  let H := Subgroup.centralizer ({u} : Set G)
  have hH : H ≠ ⊤ := centralizer_ne_top_of_no_solvable_normal hsol hu
  have hzH : z ∈ H := Subgroup.mem_centralizer_singleton_iff.mpr huz.symm.eq
  have hne : ∃ z ∈ Z, z ∈ H ∧ z ∈ M := ⟨z, hz, hzH, hzM⟩
  exact ⟨hH, local_closure_normal h H huM hne,
    local_closure_not_le h H huM hne,
    local_closure_odd_intersection H N hz hzH hzN h.involutions
      (hlocal H hH huM hne)⟩

omit [Finite G] in
/-- The odd-core cover of the local closure implies clause (b), with the core mapped into G. -/
public theorem oddCore_not_le_of_local_cover
    (h : IsProductDisconnected Z M) (H : Subgroup G)
    (hHM : ¬ H ≤ M) {z : G} (hz : z ∈ Z) (hzH : z ∈ H) (hzM : z ∈ M)
    (hcover : Subgroup.closure (H.subtype ⁻¹' Z) ≤
      pPrimeCore 2 H ⊔ Subgroup.zpowers (⟨z, hzH⟩ : H)) :
    ¬ (pPrimeCore 2 H).map H.subtype ≤ M := by
  intro hcore
  apply local_closure_not_le h H hHM ⟨z, hz, hzH, hzM⟩
  apply hcover.trans
  exact sup_le (Subgroup.map_le_iff_le_comap.mp hcore) (Subgroup.zpowers_le.mpr hzM)

end BenderSuzuki.ZD.Centralizers
