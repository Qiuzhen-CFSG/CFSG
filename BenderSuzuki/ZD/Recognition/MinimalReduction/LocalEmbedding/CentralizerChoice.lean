module

public import BenderSuzuki.ZD.Recognition.MinimalReduction.LocalEmbedding.FourObstruction
public import BenderSuzuki.ZD.Recognition.MinimalReduction.LocalEmbedding.CentralizerChoice.Seed
public import Theory.GroupTheory.InvolutionCentralizerLifting
public import Theory.GroupTheory.InvolutionOddProduct
public import Theory.GroupTheory.ZStar.CommutingConjugate

/-!
# Replacing a local ZD counterexample by an involution centralizer

In a group generated by the distinguished involutions, assume an involution
is central modulo the odd core and the odd core lies in the distinguished
subgroup. Coprime centralizer covering and involution lifting produce
commuting distinguished generators covering the quotient. Their closure
contains the original involution. The resulting ambient centralizer is
eligible for local induction; its central involution prevents strong embedding.
Z-star then supplies a distinct commuting conjugate without assuming simplicity.

Source: GLS, Volume 4, Chapter 2, Lemma 4.7(a) and equation (4F).
The final theorem extracts the nonidentity seed from local induction and
failure of strong embedding, and discharges the conditional construction.
Generation, the single-class condition, Sylow centrality and fusion control
are not needed for this step beyond the stated minimal-counterexample inputs.
-/

namespace BenderSuzuki.ZD
open Theory.GroupTheory PFAppendixIII PFchapter1section1

/-- Every distinguished generator has a commuting lift in its odd-core coset. -/
public theorem distinguished_centralizer_lift
    {G : Type*} [Group G] [Finite G] {Z : Set G} {M : Subgroup G}
    (h : IsProductDisconnected Z M) {u : G} (hu : PFAppendixIII.IsInvolution u)
    (hc : QuotientGroup.mk' (pPrimeCore 2 G) u ∈
      Subgroup.center (G ⧸ pPrimeCore 2 G))
    (hOM : pPrimeCore 2 G ≤ M) {z : G} (hz : z ∈ Z) :
    ∃ w ∈ Z, Commute w u ∧
      QuotientGroup.mk' (pPrimeCore 2 G) w = QuotientGroup.mk' (pPrimeCore 2 G) z ∧
      (z ∈ M → w ∈ M) := by
  let O := pPrimeCore 2 G
  let q := QuotientGroup.mk' O
  have hodd : Odd (Nat.card O) := Nat.coprime_two_left.mp pPrimeCore_coprime_card
  have hzq : q z ≠ 1 := by
    intro he
    have hzO : z ∈ O := (QuotientGroup.eq_one_iff _).mp he
    have hzI := BenderSuzuki.IsInvolution.subtype (h.involutions z hz) hzO
    exact hodd.not_two_dvd_nat
      ((orderOf_eq_prime hzI.sq_eq_one hzI.ne_one) ▸ orderOf_dvd_natCard (⟨z, hzO⟩ : O))
  have hcover := oddCore_sup_involution_centralizer hu hc
  have hzsup : z ∈ O ⊔ Subgroup.centralizer ({u} : Set G) := by
    rw [hcover]; trivial
  obtain ⟨n, hn, a, ha, hna⟩ := Subgroup.mem_sup_of_normal_left.mp hzsup
  have hnq : q n = 1 := (QuotientGroup.eq_one_iff _).mpr hn
  have hqa : q a = q z := by
    rw [← hna, map_mul, hnq, one_mul]
  obtain ⟨w, hwC, hwI, hwq⟩ := involution_lift_in_subgroup O
    (Subgroup.centralizer ({u} : Set G)) hodd (h.involutions z hz) hzq ⟨a, ha, hqa⟩
  have hwz : w * z ∈ O := by
    apply (QuotientGroup.eq_one_iff _).mp
    change q (w * z) = 1
    rw [map_mul, hwq, ← map_mul, ← pow_two, (h.involutions z hz).sq_eq_one, map_one]
  have hwo : Odd (orderOf (w * z)) := by
    rw [Subgroup.orderOf_coe (⟨w * z, hwz⟩ : O)]
    exact hodd.of_dvd_nat (orderOf_dvd_natCard (⟨w * z, hwz⟩ : O))
  have hwZ : w ∈ Z := by
    obtain ⟨g, hg⟩ := isConj_iff.mp
      (isConj_of_involutions_odd_product w z hwI.sq_eq_one (h.involutions z hz).sq_eq_one hwo).symm
    simpa only [MulAut.conj_apply, hg] using h.invariant g z hz
  refine ⟨w, hwZ, Subgroup.mem_centralizer_singleton_iff.mp hwC, hwq, ?_⟩
  intro hzM
  have hh := M.mul_mem (hOM hwz) hzM
  simpa only [mul_assoc, ← pow_two, (h.involutions z hz).sq_eq_one, mul_one] using hh

/-- The commuting distinguished generators cover the entire quotient. -/
public theorem centralizerClosure_map_oddCore_eq_top
    {G : Type*} [Group G] [Finite G] {Z : Set G} {M : Subgroup G}
    (h : IsProductDisconnected Z M) (hgen : Subgroup.closure Z = ⊤)
    {u : G} (hu : PFAppendixIII.IsInvolution u)
    (hc : QuotientGroup.mk' (pPrimeCore 2 G) u ∈
      Subgroup.center (G ⧸ pPrimeCore 2 G)) (hOM : pPrimeCore 2 G ≤ M) :
    (centralizerClosure Z u).map (QuotientGroup.mk' (pPrimeCore 2 G)) = ⊤ := by
  let q := QuotientGroup.mk' (pPrimeCore 2 G)
  have hle : Subgroup.closure Z ≤ ((centralizerClosure Z u).map q).comap q := by
    apply (Subgroup.closure_le _).mpr
    intro z hz
    obtain ⟨w, hw, hwc, hwq, _⟩ := distinguished_centralizer_lift h hu hc hOM hz
    exact ⟨w, mem_centralizerClosure hw hwc, hwq⟩
  apply top_unique
  intro x _
  obtain ⟨z, rfl⟩ := QuotientGroup.mk'_surjective (pPrimeCore 2 G) x
  exact hle (hgen ▸ Subgroup.mem_top z)

/-- This is the replacement construction inside the local generated group. -/
public theorem centralizer_choice_of_oddCore_central_involution
    {G : Type*} [Group G] [Finite G] {Z : Set G} {M : Subgroup G}
    (h : IsProductDisconnected Z M) (hgen : Subgroup.closure Z = ⊤)
    {u : G} (hu : PFAppendixIII.IsInvolution u)
    (hc : QuotientGroup.mk' (pPrimeCore 2 G) u ∈
      Subgroup.center (G ⧸ pPrimeCore 2 G)) (hOM : pPrimeCore 2 G ≤ M) :
    u ∈ centralizerClosure Z u ∧
      ¬ Subgroup.centralizer ({u} : Set G) ≤ M ∧
      ∃ z ∈ Z, Commute z u ∧ z ∈ M := by
  have hmap := centralizerClosure_map_oddCore_eq_top h hgen hu hc hOM
  refine ⟨?_, ?_, ?_⟩
  · apply involution_mem_of_odd_quotient_image (pPrimeCore 2 G) (centralizerClosure Z u)
      (Nat.coprime_two_left.mp pPrimeCore_coprime_card) hu
      (fun a ha => (Subgroup.mem_centralizer_singleton_iff.mp
        (centralizerClosure_le Z u ha)).symm)
    rw [hmap]; trivial
  · intro hC
    have hh := oddCore_sup_involution_centralizer hu hc
    exact h.proper (top_unique (hh ▸ sup_le hOM hC))
  · obtain ⟨z, hz, hzM⟩ := h.nonempty
    obtain ⟨w, hw, hwc, _, hwM⟩ := distinguished_centralizer_lift h hu hc hOM hz
    exact ⟨w, hw, hwc, hwM hzM⟩

/-- A central involution in the distinguished subgroup forbids strong embedding. -/
public theorem not_stronglyEmbedded_of_central_involution
    {G : Type*} [Group G] [Finite G] {M : Subgroup G} {u : G}
    (hu : PFAppendixIII.IsInvolution u) (huM : u ∈ M)
    (hc : ∀ g : G, Commute g u) : ¬ BenderSuzuki.IsStronglyEmbedded M := by
  intro hs
  apply hs.1
  apply top_unique
  intro g _
  exact hs.centralizer_le huM hu (Subgroup.mem_centralizer_singleton_iff.mpr (hc g).eq)

/-- The exact nested relative closure used by local_structure is retained. -/
public theorem centralizerClosure_not_stronglyEmbedded
    {G : Type*} [Group G] [Finite G] {Z : Set G} {M : Subgroup G} {u : G}
    (hu : PFAppendixIII.IsInvolution u) (huM : u ∈ M)
    (huL : u ∈ centralizerClosure Z u) :
    ¬ BenderSuzuki.IsStronglyEmbedded
      ((M.comap (Subgroup.centralizer ({u} : Set G)).subtype).comap
        (Subgroup.closure ((Subgroup.centralizer ({u} : Set G)).subtype ⁻¹' Z)).subtype) := by
  rw [centralizerClosure_eq_map] at huL
  obtain ⟨uC, huC, he⟩ := huL
  let L := Subgroup.closure ((Subgroup.centralizer ({u} : Set G)).subtype ⁻¹' Z)
  let t : L := ⟨uC, huC⟩
  let f : L →* G := (Subgroup.centralizer ({u} : Set G)).subtype.comp L.subtype
  have hf : Function.Injective f := Subtype.val_injective.comp Subtype.val_injective
  have ht : f t = u := he
  apply not_stronglyEmbedded_of_central_involution (u := t)
  · refine ⟨fun hh => hu.ne_one ?_, hf ?_⟩
    · simpa only [hh, map_one] using ht.symm
    · rw [map_pow, ht, hu.sq_eq_one, map_one]
  · change f t ∈ M
    rwa [ht]
  · intro x
    apply hf
    change f (x * t) = f (t * x)
    rw [map_mul, map_mul, ht]
    exact Subgroup.mem_centralizer_singleton_iff.mp (x : Subgroup.centralizer ({u} : Set G)).property

/-- Conditional final assembly: the remaining seed must be obtained from the
local structural alternative, not assumed in the final source theorem. -/
public theorem MinimalCounterexample.centralizer_choice_of_local_seed
    {G : Type*} [Group G] [Finite G] {Z : Set G} {M : Subgroup G}
    (h : MinimalCounterexample Z M) (H : Subgroup G)
    (hHM : ¬ H ≤ M) (hne : ∃ z ∈ Z, z ∈ H ∧ z ∈ M)
    (hsol : ∀ N : Subgroup G, N.Normal → Group.IsSolvable N → N = ⊥)
    (hseed : let L := Subgroup.closure (H.subtype ⁻¹' Z)
      ∃ u : L, PFAppendixIII.IsInvolution u ∧ ((u : H) : G) ∈ M ∧
        QuotientGroup.mk' (pPrimeCore 2 L) u ∈ Subgroup.center (L ⧸ pPrimeCore 2 L) ∧
        pPrimeCore 2 L ≤ (M.comap H.subtype).comap L.subtype) :
    ∃ u v : G, PFAppendixIII.IsInvolution u ∧ u ∈ M ∧ u ≠ v ∧
      IsConj u v ∧ Commute u v ∧
      Subgroup.centralizer ({u} : Set G) ≠ ⊤ ∧
      ¬ Subgroup.centralizer ({u} : Set G) ≤ M ∧
      (∃ z ∈ Z, z ∈ Subgroup.centralizer ({u} : Set G) ∧ z ∈ M) ∧
      u ∈ centralizerClosure Z u ∧
      StructureConclusion ((Subgroup.centralizer ({u} : Set G)).subtype ⁻¹' Z)
        (M.comap (Subgroup.centralizer ({u} : Set G)).subtype) := by
  let L := Subgroup.closure (H.subtype ⁻¹' Z)
  let e : L →* G := H.subtype.comp L.subtype
  have he : Function.Injective e := H.subtype_injective.comp L.subtype_injective
  obtain ⟨u, hu, huM, huq, hOM⟩ := hseed
  have hlocal : IsProductDisconnected (e ⁻¹' Z) (M.comap e) :=
    productDisconnected_closure (productDisconnected_subgroup h.disconnected H hHM hne)
  have hgen : Subgroup.closure (e ⁻¹' Z) = ⊤ :=
    Subgroup.closure_preimage_eq_top (H.subtype ⁻¹' Z)
  obtain ⟨huL, hC, z, hz, hzu, hzM⟩ :=
    centralizer_choice_of_oddCore_central_involution hlocal hgen hu huq hOM
  have huG : PFAppendixIII.IsInvolution (e u) := BenderSuzuki.IsInvolution.map_of_injective hu e he
  have huGM : e u ∈ M := huM
  have hCG : ¬ Subgroup.centralizer ({e u} : Set G) ≤ M := by
    intro hh
    apply hC
    intro a ha
    exact hh (Subgroup.mem_centralizer_singleton_iff.mpr
      ((show Commute a u from Subgroup.mem_centralizer_singleton_iff.mp ha).map e).eq)
  have hneG : ∃ z ∈ Z, z ∈ Subgroup.centralizer ({e u} : Set G) ∧ z ∈ M :=
    ⟨e z, hz, Subgroup.mem_centralizer_singleton_iff.mpr (hzu.map e).eq, hzM⟩
  have huLG : e u ∈ centralizerClosure Z (e u) := by
    have hle : centralizerClosure (e ⁻¹' Z) u ≤ (centralizerClosure Z (e u)).comap e := by
      apply (Subgroup.closure_le _).mpr
      intro a ha
      exact mem_centralizerClosure ha.1
        ((show Commute a u from Subgroup.mem_centralizer_singleton_iff.mp ha.2).map e)
    exact hle huL
  have hproper := centralizer_ne_top_of_no_solvable_normal huG hsol
  have hnot := centralizerClosure_not_stronglyEmbedded huG huGM huLG
  have hs := h.local_structure_of_not_stronglyEmbedded
    (Subgroup.centralizer ({e u} : Set G)) hproper hCG hneG hnot
  obtain ⟨v, hvne, hvconj, hvcomm⟩ :=
    exists_distinct_commuting_conjugate_of_no_solvable_normal huG hsol
  exact ⟨e u, v, huG, huGM, hvne, hvconj, hvcomm, hproper, hCG, hneG, huLG, hs⟩

/-- An eligible local failure can be replaced by an involution centralizer,
and that involution has a distinct commuting conjugate. This proves the
centralizer selection and exclusion in GLS Lemma 4.7(a), together with (4F).
The last clause retains the exact relative local failure for subsequent use. -/
public theorem MinimalCounterexample.centralizer_choice
    {G : Type*} [Group G] [Finite G] {Z : Set G} {M : Subgroup G}
    (h : MinimalCounterexample Z M) (H : Subgroup G) (hH : H ≠ ⊤)
    (hHM : ¬ H ≤ M) (hne : ∃ z ∈ Z, z ∈ H ∧ z ∈ M)
    (hnot : ¬ BenderSuzuki.IsStronglyEmbedded
      ((M.comap H.subtype).comap
        (Subgroup.closure (H.subtype ⁻¹' Z)).subtype))
    (hsol : ∀ N : Subgroup G, N.Normal → Group.IsSolvable N → N = ⊥) :
    ∃ u v : G, PFAppendixIII.IsInvolution u ∧ u ∈ M ∧ u ≠ v ∧
      IsConj u v ∧ Commute u v ∧
      Subgroup.centralizer ({u} : Set G) ≠ ⊤ ∧
      ¬ Subgroup.centralizer ({u} : Set G) ≤ M ∧
      (∃ z ∈ Z, z ∈ Subgroup.centralizer ({u} : Set G) ∧ z ∈ M) ∧
      u ∈ centralizerClosure Z u ∧
      StructureConclusion ((Subgroup.centralizer ({u} : Set G)).subtype ⁻¹' Z)
        (M.comap (Subgroup.centralizer ({u} : Set G)).subtype) ∧
      u ∉ Z ∧ (¬ ∃ a ∈ Z, ∃ b ∈ Z, u = a * b) ∧
      ¬ BenderSuzuki.IsStronglyEmbedded
        ((M.comap (Subgroup.centralizer ({u} : Set G)).subtype).comap
          (Subgroup.closure ((Subgroup.centralizer ({u} : Set G)).subtype ⁻¹' Z)).subtype) := by
  have hs := h.local_structure_of_not_stronglyEmbedded H hH hHM hne hnot
  have hseed := local_structure_central_involution_seed
    (productDisconnected_subgroup h.disconnected H hHM hne) hs hnot
  obtain ⟨u, v, hu, huM, huv, hconj, hcomm, hC, hCM, hmeet, huL, hstruct⟩ :=
    h.centralizer_choice_of_local_seed H hHM hne hsol hseed
  obtain ⟨huZ, huP⟩ :=
    not_mem_or_product_of_centralizer_not_le h.disconnected hu huM hCM
  exact ⟨u, v, hu, huM, huv, hconj, hcomm, hC, hCM, hmeet, huL, hstruct,
    huZ, huP, centralizerClosure_not_stronglyEmbedded hu huM huL⟩

end BenderSuzuki.ZD
