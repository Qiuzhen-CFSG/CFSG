module

public import BenderSuzuki.ZD.Recognition.MinimalReduction.LocalBasic

/-!
# The four-group obstruction in the local ZD argument

For a central involution `u` and a four-group with nonidentity elements
`a`, `b`, `ab`, the three elements `ua`, `ub`, `uab` multiply to `u`.
If they are distinguished involutions centralizing `v`, this puts `u` in
`C_G(v)°`. The involution partition of that generated centralizer then
forces `u = v`, since `u` is neither distinguished nor a product of two
distinguished involutions.

This proves the algebraic implication in GLS, Volume 4, Chapter 2,
Lemma 4.8. Its involution-coset premises are explicit: the centralizer
choice and Lemma 4.7 still have to supply them. The ambient closure is
identified with the image of the relative closure used by `SimpleReduction`.
-/

namespace BenderSuzuki.ZD
open Theory.GroupTheory PFAppendixIII PFchapter1section1

/-- The subgroup generated by the distinguished involutions centralizing `u`. -/
@[expose] public def centralizerClosure {G : Type*} [Group G] (Z : Set G) (u : G) : Subgroup G :=
  Subgroup.closure (Z ∩ (Subgroup.centralizer ({u} : Set G) : Set G))

/-- Generators and hence the entire local closure centralize `u`. -/
public theorem centralizerClosure_le {G : Type*} [Group G] (Z : Set G) (u : G) :
    centralizerClosure Z u ≤ Subgroup.centralizer ({u} : Set G) :=
  (Subgroup.closure_le _).mpr (fun _ hx => hx.2)

/-- A distinguished involution centralizing `u` belongs to its local closure. -/
public theorem mem_centralizerClosure {G : Type*} [Group G] {Z : Set G} {u z : G}
    (hz : z ∈ Z) (hc : Commute z u) : z ∈ centralizerClosure Z u :=
  Subgroup.subset_closure ⟨hz, Subgroup.mem_centralizer_singleton_iff.mpr hc.eq⟩

/-- Ambient and relative conventions for the centralizer closure agree. -/
public theorem centralizerClosure_eq_map {G : Type*} [Group G] (Z : Set G) (u : G) :
    centralizerClosure Z u =
      (Subgroup.closure ((Subgroup.centralizer ({u} : Set G)).subtype ⁻¹' Z)).map
        (Subgroup.centralizer ({u} : Set G)).subtype := by
  rw [MonoidHom.map_closure]
  unfold centralizerClosure
  congr 1
  ext x
  constructor
  · rintro ⟨hxZ, hxC⟩
    exact ⟨⟨x, hxC⟩, hxZ, rfl⟩
  · rintro ⟨x, hxZ, rfl⟩
    exact ⟨hxZ, x.property⟩

/-- A nonidentity involution has proper centralizer when the solvable radical is trivial. -/
public theorem centralizer_ne_top_of_no_solvable_normal
    {G : Type*} [Group G] {u : G} (hu : IsInvolution u)
    (hsol : ∀ N : Subgroup G, N.Normal → Group.IsSolvable N → N = ⊥) :
    Subgroup.centralizer ({u} : Set G) ≠ ⊤ := by
  intro heq
  have hsolC : Group.IsSolvable (Subgroup.center G) :=
    Group.isSolvable_of_comm (fun a b =>
      Subtype.ext (Subgroup.mem_center_iff.mp b.property a))
  have hcenter : Subgroup.center G = ⊥ := hsol _ inferInstance hsolC
  have huC : u ∈ Subgroup.center G :=
    (Subgroup.centralizer_eq_top_iff_subset.mp heq) (Set.mem_singleton u)
  rw [hcenter] at huC
  exact hu.ne_one (Subgroup.mem_bot.mp huC)

/-- The exclusion in GLS Lemma 4.7(a) follows once the centralizer is chosen. -/
public theorem not_mem_or_product_of_centralizer_not_le
    {G : Type*} [Group G] {Z : Set G} {M : Subgroup G} {u : G}
    (h : IsProductDisconnected Z M) (hu : IsInvolution u) (huM : u ∈ M)
    (hC : ¬ Subgroup.centralizer ({u} : Set G) ≤ M) :
    u ∉ Z ∧ ¬ ∃ a ∈ Z, ∃ b ∈ Z, u = a * b := by
  constructor
  · intro huZ
    exact hC (h.centralizer_le huZ huM)
  · rintro ⟨a, ha, b, hb, rfl⟩
    exact hC (h.product_centralizer a ha b hb hu huM)

/-- The elementary three-involution calculation in GLS Lemma 4.8. -/
private theorem involution_eq_of_coset_partition
    {G : Type*} [Group G] {Z : Set G} {D K : Subgroup G} {u v : G}
    (hu : IsInvolution u) (huv : u ≠ v) (huZ : u ∉ Z)
    (huP : ¬ ∃ a ∈ Z, ∃ b ∈ Z, u = a * b)
    (huc : ∀ a ∈ D, Commute u a) (hvc : Commute u v)
    (hcoset : ∀ a ∈ D, IsInvolution a → u * a ∈ Z)
    (hgen : ∀ z ∈ Z, Commute z v → z ∈ K)
    (hpart : ∀ x ∈ K, IsInvolution x →
      x = v ∨ x ∈ Z ∨ ∃ a ∈ Z, ∃ b ∈ Z, x = a * b)
    {a b : G} (haD : a ∈ D) (hbD : b ∈ D)
    (ha : IsInvolution a) (hb : IsInvolution b)
    (hab : Commute a b) (hav : Commute a v) (hbv : Commute b v) : a = b := by
  by_contra hne
  have habinv : IsInvolution (a * b) := by
    refine ⟨?_, ?_⟩
    · intro heq
      apply hne
      have heq' := congrArg (fun x => x * b) heq
      simpa only [mul_assoc, ← pow_two, hb.2, mul_one, one_mul] using heq'
    · rw [hab.mul_pow, ha.2, hb.2, one_mul]
  have haZ := hcoset a haD ha
  have hbZ := hcoset b hbD hb
  have habZ := hcoset (a * b) (D.mul_mem haD hbD) habinv
  have haK := hgen _ haZ (hvc.mul_left hav)
  have hbK := hgen _ hbZ (hvc.mul_left hbv)
  have habK := hgen _ habZ (hvc.mul_left (hav.mul_left hbv))
  have hprod : (u * a) * (u * b) = a * b := by
    calc
      (u * a) * (u * b) = (u * u) * (a * b) := by
        rw [mul_assoc, ← mul_assoc a, (huc a haD).eq.symm]
        group
      _ = a * b := by rw [← pow_two, hu.2, one_mul]
  have huK : u ∈ K := by
    have hh := K.mul_mem habK (K.mul_mem haK hbK)
    rwa [hprod, mul_assoc, ← pow_two, habinv.2, mul_one] at hh
  rcases hpart u huK hu with h | h | h
  · exact huv h
  · exact huZ h
  · exact huP h

open scoped IsMulCommutative

/-- The conclusion of GLS Lemma 4.8, conditional on its involution-coset inputs. -/
private theorem not_twoRank_centralizer_of_coset_partition
    {G : Type*} [Group G] [Finite G] {Z : Set G} {D K : Subgroup G} {u v : G}
    (hu : IsInvolution u) (huv : u ≠ v) (huZ : u ∉ Z)
    (huP : ¬ ∃ a ∈ Z, ∃ b ∈ Z, u = a * b)
    (huc : ∀ a ∈ D, Commute u a) (hvc : Commute u v)
    (hcoset : ∀ a ∈ D, IsInvolution a → u * a ∈ Z)
    (hgen : ∀ z ∈ Z, Commute z v → z ∈ K)
    (hpart : ∀ x ∈ K, IsInvolution x →
      x = v ∨ x ∈ Z ∨ ∃ a ∈ Z, ∃ b ∈ Z, x = a * b) :
    ¬ TwoRankAtLeastTwo ↥(D ⊓ Subgroup.centralizer ({v} : Set G)) := by
  rintro ⟨E, hcard, hsq⟩
  let C := D ⊓ Subgroup.centralizer ({v} : Set G)
  let f : E →* G := C.subtype.comp E.subtype
  have hf : Function.Injective f := C.subtype_injective.comp E.subtype_injective
  let : Nontrivial E := Finite.one_lt_card_iff_nontrivial.mp (by omega)
  let : IsMulCommutative E := isMulCommutative_of_forall_sq_one hsq
  obtain ⟨a, ha⟩ := exists_ne (1 : E)
  have htwo : Nat.card E = 2 := by
    apply (Nat.card_eq_two_iff' (1 : E)).mpr
    refine ⟨a, ha, ?_⟩
    intro b hb
    apply hf
    apply involution_eq_of_coset_partition hu huv huZ huP huc hvc hcoset hgen hpart
      (show f b ∈ D from (b : C).property.1)
      (show f a ∈ D from (a : C).property.1)
      (IsInvolution.map_of_injective ⟨hb, hsq b⟩ f hf)
      (IsInvolution.map_of_injective ⟨ha, hsq a⟩ f hf)
    · change f b * f a = f a * f b
      simpa only [map_mul] using congrArg f (mul_comm b a)
    · exact Subgroup.mem_centralizer_singleton_iff.mp (b : C).property.2
    · exact Subgroup.mem_centralizer_singleton_iff.mp (a : C).property.2
  omega

/-- The centralizer-closure version used in the local embedding argument. -/
public theorem local_centralizer_not_twoRank
    {G : Type*} [Group G] [Finite G] {Z : Set G} {M D : Subgroup G} {u v : G}
    (h : IsProductDisconnected Z M) (hu : IsInvolution u) (huM : u ∈ M)
    (hC : ¬ Subgroup.centralizer ({u} : Set G) ≤ M)
    (huv : u ≠ v) (hvc : Commute u v)
    (hD : D ≤ Subgroup.centralizer ({u} : Set G))
    (hcoset : ∀ a ∈ D, IsInvolution a → u * a ∈ Z)
    (hpart : ∀ x ∈ centralizerClosure Z v, IsInvolution x →
      x = v ∨ x ∈ Z ∨ ∃ a ∈ Z, ∃ b ∈ Z, x = a * b) :
    ¬ TwoRankAtLeastTwo ↥(D ⊓ Subgroup.centralizer ({v} : Set G)) := by
  obtain ⟨huZ, huP⟩ := not_mem_or_product_of_centralizer_not_le h hu huM hC
  apply not_twoRank_centralizer_of_coset_partition hu huv huZ huP
    (fun a ha => ?_) hvc hcoset (fun _ hz hc => mem_centralizerClosure hz hc) hpart
  exact (Subgroup.mem_centralizer_singleton_iff.mp (hD ha)).symm

end BenderSuzuki.ZD
