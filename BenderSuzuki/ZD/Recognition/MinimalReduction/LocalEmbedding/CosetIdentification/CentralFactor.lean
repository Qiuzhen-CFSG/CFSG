module

public import BenderSuzuki.ZD.Recognition.MinimalReduction.LocalEmbedding.FourObstruction
public import BenderSuzuki.ZD.Recognition.Interfaces

/-!
# Identifying the central factor in a local centralizer closure

Let `L` be generated by the distinguished involutions in `C_G(u)`, with
`u` a central involution of `L`. The structural conclusion of Theorem ZD
inside `C_G(u)` identifies `L / O₂′(L)` as the product of its simple Bender
derived factor and a cyclic factor of order at most two. The simple factor
has trivial center, so the nonidentity image of `u` is the specified cyclic
factor's generator. The odd core lies in the derived subgroup, allowing
us to lift the distinguished generators' derived-coset membership.

The relative closure is transported into the ambient group using the
composite of its two subtype maps. Its derived image is computed from the
range of that map; no ambient normality of the local derived subgroup is
assumed.

Source: GLS, Volume 4, Chapter 2, (4E) and Lemma 4.7, lines 599–638 of
`refs/KGroup/GLS4/Chapter2.tex`. This proves the central-factor and coset
placement inputs; the conjugacy and involution-partition arguments belong
to the parent assembly.
-/

namespace BenderSuzuki.ZD.LocalCosetIdentification
open Theory.GroupTheory PFAppendixIII PFchapter1section1

private theorem bender_center_eq_bot {G : Type*} [Group G] [Finite G]
    (h : IsSimpleBenderGroup G) : Subgroup.center G = ⊥ := by
  let : IsSimpleGroup G := h.isSimple
  apply (inferInstance : (Subgroup.center G).Normal).eq_bot_or_eq_top.resolve_right
  intro heq
  apply h.not_commutative
  intro x y
  exact Subgroup.mem_center_iff.mp (heq ▸ Subgroup.mem_top y) x

private theorem mem_zpowers_of_square_one {G : Type*} [Group G] [Finite G]
    {v w : G} (hv : v ^ 2 = 1) (hw : w ∈ Subgroup.zpowers v) :
    w = 1 ∨ w = v := by
  classical
  obtain ⟨n, hn, rfl⟩ := Finset.mem_image.mp (mem_zpowers_iff_mem_range_orderOf.mp hw)
  have hn2 : n < 2 := lt_of_lt_of_le (Finset.mem_range.mp hn)
    (Nat.le_of_dvd (by decide) (orderOf_dvd_of_pow_eq_one hv))
  interval_cases n <;> simp

private theorem central_eq_factor {Q : Type*} [Group Q] [Finite Q]
    (X : Subgroup Q) [X.Normal] {v t : Q}
    (hv : v ^ 2 = 1) (hgen : X ⊔ Subgroup.zpowers v = ⊤)
    (hcomm : ∀ x ∈ X, ∀ w ∈ Subgroup.zpowers v, Commute x w)
    (hcenter : Subgroup.center X = ⊥)
    (ht : t ∈ Subgroup.center Q) (htne : t ≠ 1) : t = v := by
  have hmem : t ∈ X ⊔ Subgroup.zpowers v := hgen ▸ Subgroup.mem_top t
  obtain ⟨x, hx, w, hw, heq⟩ := Subgroup.mem_sup_of_normal_left.mp hmem
  have hxcenter : (⟨x, hx⟩ : X) ∈ Subgroup.center X := by
    apply Subgroup.mem_center_iff.mpr
    intro y
    apply Subtype.ext
    have hyt : Commute (y : Q) t := Subgroup.mem_center_iff.mp ht y
    have hyw := hcomm y y.property w hw
    have hxy := hyt.mul_right hyw.inv_right
    rw [← heq, mul_inv_cancel_right] at hxy
    exact hxy.eq
  have hx1X : (⟨x, hx⟩ : X) = 1 := by
    simpa only [hcenter, Subgroup.mem_bot] using hxcenter
  have hx1 : x = 1 := congrArg (fun y : X => (y : Q)) hx1X
  have htw : t = w := by simpa [hx1] using heq.symm
  rcases mem_zpowers_of_square_one hv hw with hw1 | hwv
  · exact False.elim (htne (htw.trans hw1))
  · exact htw.trans hwv

private theorem central_involution_derived_coset
    {K : Type*} [Group K] [Finite K] {t v : K}
    (ht : IsInvolution t) (htcenter : t ∈ Subgroup.center K)
    (hv : v ^ 2 = 1)
    (hgen : commutator (K ⧸ pPrimeCore 2 K) ⊔
      Subgroup.zpowers (QuotientGroup.mk' (pPrimeCore 2 K) v) = ⊤)
    (hdisj : Disjoint (commutator (K ⧸ pPrimeCore 2 K))
      (Subgroup.zpowers (QuotientGroup.mk' (pPrimeCore 2 K) v)))
    (hcomm : ∀ x ∈ commutator (K ⧸ pPrimeCore 2 K),
      ∀ w ∈ Subgroup.zpowers (QuotientGroup.mk' (pPrimeCore 2 K) v), Commute x w)
    (hmodel : IsSimpleBenderGroup (commutator (K ⧸ pPrimeCore 2 K)))
    (hOD : pPrimeCore 2 K ≤ commutator K) :
    t ∉ commutator K ∧ ∀ z : K,
      (QuotientGroup.mk' (pPrimeCore 2 K) v)⁻¹ *
        QuotientGroup.mk' (pPrimeCore 2 K) z ∈ commutator (K ⧸ pPrimeCore 2 K) →
      t * z ∈ commutator K := by
  let O := pPrimeCore 2 K
  let q := QuotientGroup.mk' O
  let X := commutator (K ⧸ O)
  have htq : q t ≠ 1 := by
    intro he
    have htO : t ∈ O := (QuotientGroup.eq_one_iff _).mp he
    have htI := IsInvolution.subtype ht htO
    have hodd : Odd (Nat.card O) := Nat.coprime_two_left.mp pPrimeCore_coprime_card
    exact hodd.not_two_dvd_nat
      ((orderOf_eq_prime htI.sq_eq_one htI.ne_one) ▸ orderOf_dvd_natCard (⟨t, htO⟩ : O))
  have htqc : q t ∈ Subgroup.center (K ⧸ O) := by
    apply Subgroup.mem_center_iff.mpr
    intro y
    obtain ⟨a, rfl⟩ := QuotientGroup.mk'_surjective O y
    exact congrArg q (Subgroup.mem_center_iff.mp htcenter a)
  have htv : q t = q v := central_eq_factor X
    (by rw [← map_pow, hv, map_one]) hgen hcomm (bender_center_eq_bot hmodel) htqc htq
  have hmap : (commutator K).map q = X := by
    rw [map_commutator_eq, q.range_eq_top_of_surjective (QuotientGroup.mk'_surjective O)]
    rfl
  constructor
  · intro htD
    have htX : q t ∈ X := hmap ▸ Subgroup.mem_map_of_mem q htD
    have htV : q t ∈ Subgroup.zpowers (q v) := htv ▸ Subgroup.mem_zpowers (q v)
    exact htq (Subgroup.disjoint_def.mp hdisj htX htV)
  · intro z hz
    have hqtinv : (q t)⁻¹ = q t := by rw [← map_inv, ht.inv_eq_self]
    rw [← htv, hqtinv, ← map_mul] at hz
    have hpre : X.comap q = commutator K := by
      rw [← hmap]
      apply Subgroup.comap_map_eq_self
      simpa only [q, QuotientGroup.ker_mk'] using hOD
    exact hpre ▸ hz

/-- A central involution in the local closure is the central factor in the
odd-core quotient supplied by Theorem ZD. Consequently it is outside the
local derived subgroup, and every distinguished local generator is in its
nontrivial derived coset. -/
public theorem central_factor_of_structure
    {G : Type*} [Group G] [Finite G] {Z : Set G} {M : Subgroup G} {u : G}
    (hu : IsInvolution u) (huL : u ∈ centralizerClosure Z u)
    (hs : StructureConclusion
      ((Subgroup.centralizer ({u} : Set G)).subtype ⁻¹' Z)
      (M.comap (Subgroup.centralizer ({u} : Set G)).subtype)) :
    u ∉ (commutator (centralizerClosure Z u)).map (centralizerClosure Z u).subtype ∧
      ∀ z ∈ Z, z ∈ Subgroup.centralizer ({u} : Set G) →
        u * z ∈ (commutator (centralizerClosure Z u)).map
          (centralizerClosure Z u).subtype := by
  let C := Subgroup.centralizer ({u} : Set G)
  let K := Subgroup.closure (C.subtype ⁻¹' Z)
  let f : K →* G := C.subtype.comp K.subtype
  have hf : Function.Injective f := C.subtype_injective.comp K.subtype_injective
  have hrange : f.range = centralizerClosure Z u := by
    rw [centralizerClosure_eq_map]
    change (C.subtype.comp K.subtype).range = K.map C.subtype
    rw [MonoidHom.range_comp, K.range_subtype]
  have hD : (commutator K).map f =
      (commutator (centralizerClosure Z u)).map (centralizerClosure Z u).subtype := by
    rw [map_commutator_eq, hrange, Subgroup.map_subtype_commutator]
  obtain ⟨a, ha, hau⟩ := (show u ∈ K.map C.subtype from
    (centralizerClosure_eq_map Z u) ▸ huL)
  let t : K := ⟨a, ha⟩
  have htu : f t = u := hau
  have ht : IsInvolution t := by
    constructor
    · intro he
      apply hu.ne_one
      rw [← htu, he, map_one]
    · apply hf
      rw [map_pow, htu, hu.sq_eq_one, map_one]
  have htc : t ∈ Subgroup.center K := by
    apply Subgroup.mem_center_iff.mpr
    intro x
    apply hf
    simp only [map_mul, htu]
    exact Subgroup.mem_centralizer_singleton_iff.mp x.val.property
  obtain ⟨v, _hvM, hv, _hgenK, hgen, hdisj, hcomm, hmodel, hO, _hB, hZ⟩ := hs
  obtain ⟨htD, hzD⟩ := central_involution_derived_coset ht htc hv hgen hdisj hcomm hmodel
    (fun x hx => (hO hx).2)
  constructor
  · intro huD
    rw [← hD] at huD
    obtain ⟨b, hb, hbu⟩ := huD
    exact htD (hf (hbu.trans htu.symm) ▸ hb)
  · intro z hz hzC
    let zC : C := ⟨z, hzC⟩
    let zK : K := ⟨zC, Subgroup.subset_closure hz⟩
    have hzKD : t * zK ∈ commutator K := hzD zK (hZ zK hz).1
    rw [← hD]
    exact ⟨t * zK, hzKD, by rw [map_mul, htu]; rfl⟩

end BenderSuzuki.ZD.LocalCosetIdentification
