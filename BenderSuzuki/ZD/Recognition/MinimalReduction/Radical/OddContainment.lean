/-!
# Odd-core containment in the minimal ZD reduction

The odd core lies in the distinguished subgroup of a minimal counterexample.
Choose a distinguished involution `z` in `M`. If another distinguished
involution commutes with `z`, the two generate a four-group. Product
disconnection puts the centralizers of all three nonidentity elements in
`M`, and coprime fixed-point generation absorbs every odd subgroup normalized
by this four-group.

Otherwise `z` is weakly closed in a Sylow two-subgroup. Glauberman's Z-star
theorem makes its image central modulo the odd core. Conjugacy and generation
then make this quotient cyclic of order at most two. Its quotient map is
injective on every two-subgroup, contradicting the elementary four supplied
by failure of the rank-one alternative.

Source: GLS, Volume 4, Chapter 2, Lemma 3.13 and the first paragraph of
Lemma 4.5, printed pp. 33–34 (PDF pp. 50–51). This establishes only odd-core
containment; elimination of the odd core requires the separate quotient
lifting argument. Fusion control is not needed for containment.
-/

open Theory.GroupTheory BenderSuzuki.PFAppendixIII BenderSuzuki.PFchapter1section1
open Subgroup

namespace BenderSuzuki.ZD

private theorem odd_le_of_four {G : Type*} [Group G] [Finite G]
    (N V M : Subgroup G) (hn : V ≤ normalizer (N : Set G))
    (ho : Odd (Nat.card N)) (hV : IsKleinFour V)
    (hc : ∀ v ∈ V, v ≠ 1 → centralizer ({v} : Set G) ≤ M) : N ≤ M := by
  let _ : IsKleinFour V := hV
  let _ : IsMulCommutative V := IsKleinFour.isMulCommutative
  let _ : CommGroup V := IsMulCommutative.instCommGroup
  let _ : Fact (IsPGroup 2 V) := ⟨IsPGroup.of_card (n := 2) (by simp)⟩
  let _ : MulDistribMulAction V N := conjMulDistribMulActionOfLeNormalizer V N hn
  have hgen := iSup_fixedPoints_cyclicQuot_eq_top_of_coprime_abelian_pGroup_action
    (G := N) (A := V) 2 ho.coprime_two_left
  have ht : (⊤ : Subgroup N) ≤ M.comap N.subtype := by
    rw [← hgen]
    refine iSup₂_le fun Y hY => ?_
    have hquot : Nat.card (V ⧸ Y) ≤ 2 := by
      apply Nat.le_of_dvd (by decide)
      rw [← hY.exponent_eq_card]
      simpa only [IsKleinFour.exponent_two] using Group.exponent_quotient_dvd Y
    have hprod := card_eq_card_quotient_mul_card_subgroup Y
    rw [IsKleinFour.card_four] at hprod
    let _ : Nontrivial Y := Finite.one_lt_card_iff_nontrivial.mp (by nlinarith)
    obtain ⟨v, hv⟩ := exists_ne (1 : Y)
    have hvG : ((v : V) : G) ≠ 1 := by
      intro he
      apply hv
      exact Subtype.ext (Subtype.ext he)
    intro x hx
    apply hc v (v : V).property hvG
    apply mem_centralizer_singleton_iff.mpr
    have hfix := congrArg Subtype.val (hx v)
    change (v : V).val * (x : G) * (v : V).val⁻¹ = (x : G) at hfix
    exact ((mul_inv_eq_iff_eq_mul).mp hfix).symm
  intro x hx
  exact ht (mem_top (⟨x, hx⟩ : N))

/-- The four generated by two distinct commuting distinguished involutions
absorbs every odd subgroup it normalizes. -/
public theorem odd_le_of_commuting_distinguished {G : Type*} [Group G] [Finite G]
    {Z : Set G} {M : Subgroup G} (h : IsProductDisconnected Z M)
    (N : Subgroup G) (ho : Odd (Nat.card N))
    {z y : G} (hz : z ∈ Z) (hzM : z ∈ M) (hy : y ∈ Z)
    (hne : z ≠ y) (hcomm : Commute z y)
    (hn : closure ({z, y} : Set G) ≤ normalizer (N : Set G)) : N ≤ M := by
  have hzI := h.involutions z hz
  have hyI := h.involutions y hy
  have hz2 : z * z = 1 := by simpa only [pow_two] using hzI.sq_eq_one
  have hy2 : y * y = 1 := by simpa only [pow_two] using hyI.sq_eq_one
  have hyM : y ∈ M := h.centralizer_le hz hzM
    (mem_centralizer_singleton_iff.mpr hcomm.symm.eq)
  have hzyI : BenderSuzuki.PFAppendixIII.IsInvolution (z * y) := by
    refine ⟨?_, by rw [hcomm.mul_pow, hzI.sq_eq_one, hyI.sq_eq_one, one_mul]⟩
    intro he
    apply hne
    have he' := congrArg (fun a => a * y) he
    simpa only [mul_assoc, hy2, mul_one, one_mul] using he'
  apply odd_le_of_four N (closure ({z,y} : Set G)) M
    hn ho
    (isKleinFour_closure_pair z y hz2 hy2 hzI.ne_one hyI.ne_one hne hcomm)
  intro v hv hv1
  rcases (mem_closure_pair_iff z y hz2 hy2 hcomm v).mp hv with rfl | rfl | rfl | rfl
  · exact (hv1 rfl).elim
  · exact h.centralizer_le hz hzM
  · exact h.centralizer_le hy hyM
  · exact h.product_centralizer z hz y hy hzyI (M.mul_mem hzM hyM)


private theorem not_twoRank_of_isolated_distinguished {G : Type*} [Group G] [Finite G]
    {Z : Set G} {M : Subgroup G} (h : IsProductDisconnected Z M)
    (hgen : closure Z = ⊤)
    (hclass : ∀ x ∈ Z, ∀ z ∈ Z, IsConj x z)
    {z : G} (hz : z ∈ Z)
    (S : Sylow 2 G) (hzS : z ∈ S) (hcentral : ∀ s : S, Commute z (s : G))
    (hiso : ∀ y ∈ Z, Commute z y → y = z) : ¬ TwoRankAtLeastTwo G := by
  have hweak : Glauberman.ZStar.IsWeaklyClosedInSylow z (S : Subgroup G) := by
    refine ⟨hzS, ?_⟩
    intro g hg
    exact hiso _ (h.invariant g z hz) (hcentral ⟨_, hg⟩)
  let q := QuotientGroup.mk' (pPrimeCore 2 G)
  have hcz : q z ∈ center (G ⧸ pPrimeCore 2 G) :=
    Glauberman.ZStar.glauberman_zstar_local S z (h.involutions z hz) hzS
      (fun s hs => (hcentral ⟨s, hs⟩).symm.eq) hweak
  have hsame : ∀ x ∈ Z, q x = q z := by
    intro x hx
    obtain ⟨g, hg⟩ := isConj_iff.mp (hclass z hz x hx)
    rw [← hg, map_mul, map_mul, map_inv,
      mem_center_iff.mp hcz (q g), mul_assoc, mul_inv_cancel, mul_one]
  have hqgen : zpowers (q z) = ⊤ := by
    have hle : closure Z ≤ (zpowers (q z)).comap q := by
      apply (closure_le _).mpr
      intro x hx
      change q x ∈ zpowers (q z)
      rw [hsame x hx]
      exact mem_zpowers _
    rw [hgen] at hle
    apply top_unique
    intro x _
    obtain ⟨g, rfl⟩ := QuotientGroup.mk'_surjective (pPrimeCore 2 G) x
    exact hle (mem_top g)
  have hcardQ : Nat.card (G ⧸ pPrimeCore 2 G) ≤ 2 := by
    rw [← orderOf_eq_card_of_zpowers_eq_top hqgen]
    apply Nat.le_of_dvd (by decide)
    apply orderOf_dvd_of_pow_eq_one
    simpa only [← map_pow, map_one] using congrArg q (h.involutions z hz).sq_eq_one
  rintro ⟨E, hEcard, _⟩
  have hp : IsPGroup 2 E := IsPGroup.of_card (n := 2) (by omega)
  have hi := IsPGroup.quotient_pPrimeCore_injective E hp
  have hbound := Nat.card_le_card_of_injective _ hi
  omega

/-- The odd-core containment step of GLS Lemma 4.5, using the explicit
preliminary generation, conjugacy and Sylow-centrality conclusions. -/
public theorem MinimalCounterexample.oddCore_le {G : Type*} [Group G] [Finite G]
    {Z : Set G} {M : Subgroup G} (h : MinimalCounterexample Z M)
    (hgen : closure Z = ⊤)
    (hclass : ∀ x ∈ Z, ∀ z ∈ Z, IsConj x z)
    (hcentral : ∀ z ∈ Z, ∃ S : Sylow 2 G, z ∈ S ∧ ∀ s : S, Commute z (s : G)) :
    pPrimeCore 2 G ≤ M := by
  classical
  obtain ⟨z, hz, hzM⟩ := h.disconnected.nonempty
  by_cases hex : ∃ y ∈ Z, z ≠ y ∧ Commute z y
  · obtain ⟨y, hy, hne, hc⟩ := hex
    exact odd_le_of_commuting_distinguished h.disconnected (pPrimeCore 2 G)
      (Nat.coprime_two_left.mp (pPrimeCore_coprime_card (p := 2))) hz hzM hy hne hc
      (le_normalizer_of_normal (H := pPrimeCore 2 G))
  · obtain ⟨S, hzS, hc⟩ := hcentral z hz
    have hnot := not_twoRank_of_isolated_distinguished h.disconnected hgen hclass hz S hzS hc
      (fun y hy hc => by by_contra hne; exact hex ⟨y, hy, Ne.symm hne, hc⟩)
    exact (h.fails (Or.inl (fun hr => hnot
      (hr.map_of_injective (closure Z).subtype (closure Z).subtype_injective)))).elim

end BenderSuzuki.ZD