module
public import BenderSuzuki.ZD.Recognition.Interfaces
public import BenderSuzuki.SE.Borel
public import Theory.GroupTheory.InvolutionGeneratedOddKernel
public import Theory.GroupTheory.PPrimeCoreSurjection

/-!
# Structural ZD transport through odd kernels

Restrict the homomorphism to the groups generated by the distinguished sets.
Coprime-kernel core transport identifies the two quotients by their odd cores.
Lift the square-one generator, and use the exponent-two abelianization to
remove the odd kernel from its derived-subgroup supplement. Transport the
commuting disjoint factors and the actual Bender model along the quotient
isomorphism; the mapped intersection identifies the Borel subgroup. The same
isomorphism preserves both distinguished-coset assertions.

Source: GLS, Volume 4, Chapter 2, Theorem ZD(a–e) and Lemma 4.5, first
paragraph, printed p. 34 (PDF p. 51); `refs/KGroup/GLS4/Chapter2.tex`.
-/

noncomputable section
namespace BenderSuzuki.ZD
open Theory.GroupTheory PFAppendixIII PFchapter1section1

private theorem oddLifting_map_subgroupOf {A B : Type*} [Group A] [Group B]
    (e : A ≃* B) (K : Subgroup A) (K' : Subgroup B)
    (hK : K.map e.toMonoidHom = K') (T : Subgroup A) :
    (T.subgroupOf K).map
      ((e.subgroupMap K).trans (MulEquiv.subgroupCongr hK)).toMonoidHom =
      (T.map e.toMonoidHom).subgroupOf K' := by
  let eK := (e.subgroupMap K).trans (MulEquiv.subgroupCongr hK)
  have heK (x : K) : (eK x : B) = e x := rfl
  ext x
  constructor
  · rintro ⟨y, hy, rfl⟩
    exact ⟨(y : A), hy, heK y⟩
  · rintro ⟨y, hy, hyx⟩
    refine ⟨eK.symm x, ?_, eK.apply_symm_apply x⟩
    change (eK.symm x : A) ∈ T
    have he : e (eK.symm x : A) = (x : B) := by
      rw [← heK, eK.apply_symm_apply]
    have : (eK.symm x : A) = y := e.injective (he.trans hyx.symm)
    rwa [this]

/-- All structural clauses lift through an odd surjection whose kernel lies
in the distinguished subgroup, when the distinguished elements square to one. -/
public theorem StructureConclusion.of_odd_surjection
    {G H : Type*} [Group G] [Finite G] [Group H] [Finite H]
    {Z : Set G} {M : Subgroup G} (f : G →* H)
    (hker : Nat.Coprime 2 (Nat.card f.ker)) (hkerM : f.ker ≤ M)
    (hsq : ∀ z ∈ Z, z ^ 2 = 1)
    (hs : StructureConclusion (f '' Z) (M.map f)) : StructureConclusion Z M := by
  let L := Subgroup.closure Z
  let K := Subgroup.closure (f '' Z)
  have hLK : L.map f = K := MonoidHom.map_closure f Z
  let F : L →* K := (f.comp L.subtype).codRestrict K
    (fun x => hLK ▸ Subgroup.mem_map_of_mem f x.property)
  have hFsurj : Function.Surjective F := by
    intro x
    have hx : (x : H) ∈ L.map f := by rw [hLK]; exact x.property
    obtain ⟨y, hy, hyx⟩ := hx
    exact ⟨⟨y, hy⟩, Subtype.ext hyx⟩
  let fk : F.ker →* f.ker :=
    { toFun := fun x => ⟨(x : L), congrArg Subtype.val x.property⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl }
  have hfk : Function.Injective fk := by
    intro x y h
    apply Subtype.ext
    apply Subtype.ext
    exact congrArg (fun t : f.ker => (t : G)) h
  have hFker : Nat.Coprime 2 (Nat.card F.ker) :=
    hker.of_dvd_right (Subgroup.card_dvd_of_injective fk hfk)
  have hFM (x : L) : (F x : H) ∈ M.map f ↔ (x : G) ∈ M := by
    change x.val ∈ (M.map f).comap f ↔ _
    rw [Subgroup.comap_map_eq, sup_of_le_left hkerM]
  let O := pPrimeCore 2 L
  let P := pPrimeCore 2 K
  let q : L →* L ⧸ O := QuotientGroup.mk' O
  let r : K →* K ⧸ P := QuotientGroup.mk' P
  have hcore : P.comap F = O := pPrimeCore_comap_eq_of_surjective_coprime 2 F hFsurj hFker
  have hkerRF : (r.comp F).ker = O := by
    rw [← MonoidHom.comap_ker, QuotientGroup.ker_mk', hcore]
  let e : (L ⧸ O) ≃* (K ⧸ P) :=
    (QuotientGroup.quotientMulEquivOfEq hkerRF.symm).trans
      (QuotientGroup.quotientKerEquivOfSurjective (r.comp F)
        ((QuotientGroup.mk'_surjective P).comp hFsurj))
  have he (x : L) : e (q x) = r (F x) := by
    change QuotientGroup.quotientKerEquivOfSurjective (r.comp F)
      ((QuotientGroup.mk'_surjective P).comp hFsurj)
      (QuotientGroup.quotientMulEquivOfEq hkerRF.symm (QuotientGroup.mk x)) = _
    rw [QuotientGroup.quotientMulEquivOfEq_mk]
    rfl
  have hcomp : e.toMonoidHom.comp q = r.comp F := by ext x; exact he x
  let X := commutator (L ⧸ O)
  let Y := commutator (K ⧸ P)
  have hXY : X.map e.toMonoidHom = Y := by
    simp only [X, Y, commutator_def, Subgroup.map_commutator,
      Subgroup.map_top_of_surjective e.toMonoidHom e.surjective]
  let eX : X ≃* Y := (e.subgroupMap X).trans (MulEquiv.subgroupCongr hXY)
  have hC : (commutator L).map F = commutator K := by
    simp only [commutator_def, Subgroup.map_commutator,
      Subgroup.map_top_of_surjective F hFsurj]
  let D := M.comap L.subtype ⊓ commutator L
  let E := (M.map f).comap K.subtype ⊓ commutator K
  have hD : D.map F = E := by
    ext x
    constructor
    · rintro ⟨y, hy, rfl⟩
      exact ⟨(hFM y).mpr hy.1, hC ▸ Subgroup.mem_map_of_mem F hy.2⟩
    · intro hx
      obtain ⟨y, hy, hyx⟩ := hC.symm ▸ hx.2
      refine ⟨y, ⟨(hFM y).mp ?_, hy⟩, hyx⟩
      rw [hyx]
      exact hx.1
  have hB : (D.map q).map e.toMonoidHom = E.map r := by
    rw [Subgroup.map_map, hcomp, ← Subgroup.map_map, hD]
  have hOL : O ≤ commutator L :=
    Subgroup.le_commutator_of_odd_of_involution_generated
      (Subgroup.closure_preimage_eq_top Z)
      (fun z hz => Subtype.ext (hsq z hz)) O
      (Nat.coprime_two_left.mp (pPrimeCore_coprime_card (p := 2) (G := L)))
  change ∃ v : K, (v : H) ∈ M.map f ∧ v ^ 2 = 1 ∧
    commutator K ⊔ Subgroup.zpowers v = ⊤ ∧
    Y ⊔ Subgroup.zpowers (r v) = ⊤ ∧
    Disjoint Y (Subgroup.zpowers (r v)) ∧
    (∀ x ∈ Y, ∀ w ∈ Subgroup.zpowers (r v), Commute x w) ∧
    IsSimpleBenderGroup Y ∧ P ≤ E ∧
    IsBorelSubgroup ((E.map r).subgroupOf Y) ∧
    (∀ z : K, (z : H) ∈ f '' Z → (r v)⁻¹ * r z ∈ Y ∧ r z ≠ r v) at hs
  obtain ⟨v, hvM, hv2, hvgen, hqgen, hdisj, hcomm, hmodel, hPE, hborel, hZ⟩ := hs
  obtain ⟨u, hu2, huv⟩ := Subgroup.exists_sq_eq_one_lift_of_coprime_ker F hFsurj hFker v hv2
  have heuv : e (q u) = r v := (he u).trans (congrArg r huv)
  have hp : (Subgroup.zpowers (q u)).map e.toMonoidHom = Subgroup.zpowers (r v) := by
    rw [MonoidHom.map_zpowers, MulEquiv.coe_toMonoidHom, heuv]
  change ∃ u : L, _
  refine ⟨u, (hFM u).mp (by rw [huv]; exact hvM), hu2, ?_, ?_, ?_, ?_,
    hmodel.map_mulEquiv eX.symm, ?_, ?_, ?_⟩
  · apply Subgroup.commutator_sup_zpowers_eq_top_of_surjective F hFsurj
      ((Subgroup.ker_le_comap F P).trans (hcore.le.trans hOL)) u
    rwa [huv]
  · apply Subgroup.map_injective (f := e.toMonoidHom) e.injective
    rw [Subgroup.map_sup, hXY, hp,
      Subgroup.map_top_of_surjective e.toMonoidHom e.surjective]
    exact hqgen
  · apply disjoint_iff.mpr
    apply Subgroup.map_injective (f := e.toMonoidHom) e.injective
    rw [Subgroup.map_inf _ _ _ e.injective, hXY, hp, Subgroup.map_bot]
    exact disjoint_iff.mp hdisj
  · intro x hx w hw
    apply e.injective
    simpa only [map_mul] using (hcomm _ (hXY ▸ Subgroup.mem_map_of_mem e.toMonoidHom hx)
      _ (hp ▸ Subgroup.mem_map_of_mem e.toMonoidHom hw)).eq
  · intro x hx
    exact ⟨(hFM x).mp (hPE (show F x ∈ P from hcore.ge hx)).1, hOL hx⟩
  · have hBB := oddLifting_map_subgroupOf e X Y hXY (D.map q)
    rw [hB] at hBB
    have hb := hborel.map_mulEquiv eX.symm
    rw [← hBB, Subgroup.map_map] at hb
    have hid : eX.symm.toMonoidHom.comp eX.toMonoidHom = MonoidHom.id X := by
      apply MonoidHom.ext
      intro x
      exact eX.symm_apply_apply x
    change IsBorelSubgroup ((D.map q).subgroupOf X)
    change IsBorelSubgroup (((D.map q).subgroupOf X).map
      (eX.symm.toMonoidHom.comp eX.toMonoidHom)) at hb
    simpa only [hid, Subgroup.map_id] using hb
  · intro z hz
    obtain ⟨hzmem, hzne⟩ := hZ (F z) ⟨z, hz, rfl⟩
    constructor
    · have hmem : e ((q u)⁻¹ * q z) ∈ Y := by
        simpa only [map_mul, map_inv, heuv, he] using hzmem
      rw [← hXY, Subgroup.mem_map_equiv] at hmem
      simpa only [e.symm_apply_apply] using hmem
    · intro heq
      apply hzne
      change q z = q u at heq
      simpa only [he, huv] using congrArg e heq
end BenderSuzuki.ZD

namespace BenderSuzuki.PFchapter1section1
/-- A homomorphism with odd kernel preserves elementary four-subgroups. -/
public theorem TwoRankAtLeastTwo.map_of_coprime_ker
    {G H : Type*} [Group G] [Finite G] [Group H]
    (h : TwoRankAtLeastTwo G) (f : G →* H)
    (hker : Nat.Coprime 2 (Nat.card f.ker)) : TwoRankAtLeastTwo H := by
  obtain ⟨E, hcard, hsq⟩ := h
  have hE : IsPGroup 2 E := IsPGroup.of_card (n := 2) hcard
  have hinj := Subgroup.injective_comp_subtype_of_coprime_ker f hker E hE
  let e : E ≃* E.map f := MulEquiv.ofBijective (f.subgroupMap E)
    ⟨fun x y h => hinj (congrArg Subtype.val h), f.subgroupMap_surjective E⟩
  refine ⟨E.map f, (Nat.card_congr e.toEquiv).symm.trans hcard, ?_⟩
  intro x
  obtain ⟨y, rfl⟩ := e.surjective x
  rw [← map_pow, hsq, map_one]
end BenderSuzuki.PFchapter1section1
