module

public import BenderSuzuki.ZD.Recognition.MinimalReduction.LocalBasic
public import BenderSuzuki.SE.Borel
public import BenderSuzuki.SE.InvolutionCore

/-!
# Generation in a minimal counterexample to Theorem ZD

Restricting product disconnection to `L = ⟨Z⟩` permits induction when `L` is
proper. The generated subgroup of the restricted distinguished set is
canonically isomorphic to `L`. Transport along this equivalence preserves
all clauses of ZD: the odd core, both derived subgroups, the quotient,
the two generation assertions, the commuting disjoint factors, the actual
Bender model equivalences, the Borel subgroup, and the distinguished elements.
The rank-one alternative also transports. Thus a proper `L` contradicts
failure of the original conclusion.

Source: GLS, Volume 4, Chapter 2, Theorem ZD(a–e) and (3B), printed p.27;
`refs/KGroup/GLS4/Chapter2.tex`.
-/

noncomputable section
namespace BenderSuzuki.ZD
open Theory.GroupTheory PFAppendixIII PFchapter1section1

private theorem generation_map_commutator {A B : Type*} [Group A] [Group B]
    (e : A ≃* B) : (commutator A).map e.toMonoidHom = commutator B := by
  simp only [commutator_def, Subgroup.map_commutator,
    Subgroup.map_top_of_surjective e.toMonoidHom e.surjective]

private theorem generation_map_subgroupOf {A B : Type*} [Group A] [Group B]
    (e : A ≃* B) (K : Subgroup A) (K' : Subgroup B)
    (hK : K.map e.toMonoidHom = K') (T : Subgroup A) :
    (T.subgroupOf K).map
      ((e.subgroupMap K).trans (MulEquiv.subgroupCongr hK)).toMonoidHom =
      (T.map e.toMonoidHom).subgroupOf K' := by
  let eK := (e.subgroupMap K).trans (MulEquiv.subgroupCongr hK)
  have heK (x : K) : (eK x : B) = e x := rfl
  ext x
  constructor
  · rintro ⟨y, hy, rfl⟩
    exact ⟨(y : A), hy, heK y⟩
  · intro hx
    obtain ⟨y, hy, hyx⟩ := hx
    refine ⟨eK.symm x, ?_, eK.apply_symm_apply x⟩
    change (eK.symm x : A) ∈ T
    have he : e (eK.symm x : A) = (x : B) := by
      rw [← heK, eK.apply_symm_apply]
    have : (eK.symm x : A) = y := e.injective (he.trans hyx.symm)
    rwa [this]

/-- Transport every structural ZD clause through an equivalence of the
subgroups generated by the distinguished sets, respecting the distinguished
subgroup and set. -/
public theorem StructureConclusion.of_closureEquiv
    {G H : Type*} [Group G] [Finite G] [Group H] [Finite H]
    {Z : Set G} {M : Subgroup G} {W : Set H} {N : Subgroup H}
    (e : Subgroup.closure W ≃* Subgroup.closure Z)
    (heM : ∀ x : Subgroup.closure W, (e x : G) ∈ M ↔ (x : H) ∈ N)
    (heZ : ∀ x : Subgroup.closure W, (e x : G) ∈ Z ↔ (x : H) ∈ W)
    (hs : StructureConclusion W N) : StructureConclusion Z M := by
  let L₀ := Subgroup.closure W
  let L₁ := Subgroup.closure Z
  let O₀ := pPrimeCore 2 L₀
  let O₁ := pPrimeCore 2 L₁
  let Q₀ := L₀ ⧸ O₀
  let Q₁ := L₁ ⧸ O₁
  let q₀ : L₀ →* Q₀ := QuotientGroup.mk' O₀
  let q₁ : L₁ →* Q₁ := QuotientGroup.mk' O₁
  have hO : O₀.map e.toMonoidHom = O₁ := pPrimeCore_map_iso 2 e
  let : (O₀.map e.toMonoidHom).Normal :=
    Subgroup.Normal.map (inferInstance : O₀.Normal) e.toMonoidHom e.surjective
  let qe : Q₀ ≃* Q₁ := (quotientMulEquivOfMulEquiv e O₀).trans
    (QuotientGroup.quotientMulEquivOfEq hO)
  have hqe (x : L₀) : qe (q₀ x) = q₁ (e x) := by
    change QuotientGroup.quotientMulEquivOfEq hO
      (quotientMulEquivOfMulEquiv e O₀ (QuotientGroup.mk x)) = _
    rw [quotientMulEquivOfMulEquiv_mk, QuotientGroup.quotientMulEquivOfEq_mk]
    rfl
  have hqcomp : qe.toMonoidHom.comp q₀ = q₁.comp e.toMonoidHom := by
    ext x
    exact hqe x
  let X₀ := commutator Q₀
  let X₁ := commutator Q₁
  have hX : X₀.map qe.toMonoidHom = X₁ := generation_map_commutator qe
  let eX : X₀ ≃* X₁ := (qe.subgroupMap X₀).trans (MulEquiv.subgroupCongr hX)
  have hC : (commutator L₀).map e.toMonoidHom = commutator L₁ :=
    generation_map_commutator e
  have hM : (N.comap L₀.subtype).map e.toMonoidHom = M.comap L₁.subtype := by
    ext x
    rw [Subgroup.mem_map_equiv]
    exact (heM (e.symm x)).symm.trans (by rw [e.apply_symm_apply]; rfl)
  let D₀ := N.comap L₀.subtype ⊓ commutator L₀
  let D₁ := M.comap L₁.subtype ⊓ commutator L₁
  have hD : D₀.map e.toMonoidHom = D₁ := by
    change ((N.comap L₀.subtype) ⊓ commutator L₀).map e.toMonoidHom =
      M.comap L₁.subtype ⊓ commutator L₁
    rw [Subgroup.map_inf _ _ _ e.injective, hM, hC]
  have hB : (D₀.map q₀).map qe.toMonoidHom = D₁.map q₁ := by
    rw [Subgroup.map_map, hqcomp, ← Subgroup.map_map, hD]
  change ∃ u : L₀, (u : H) ∈ N ∧ u ^ 2 = 1 ∧
    commutator L₀ ⊔ Subgroup.zpowers u = ⊤ ∧
    X₀ ⊔ Subgroup.zpowers (q₀ u) = ⊤ ∧
    Disjoint X₀ (Subgroup.zpowers (q₀ u)) ∧
    (∀ x ∈ X₀, ∀ v ∈ Subgroup.zpowers (q₀ u), Commute x v) ∧
    IsSimpleBenderGroup X₀ ∧ O₀ ≤ D₀ ∧
    IsBorelSubgroup ((D₀.map q₀).subgroupOf X₀) ∧
    (∀ z : L₀, (z : H) ∈ W → (q₀ u)⁻¹ * q₀ z ∈ X₀ ∧ q₀ z ≠ q₀ u) at hs
  obtain ⟨u, huM, hu2, hgen, hqgen, hdisj, hcomm, hmodel, hcore, hborel, hZ⟩ := hs
  change ∃ u : L₁, (u : G) ∈ M ∧ u ^ 2 = 1 ∧
    commutator L₁ ⊔ Subgroup.zpowers u = ⊤ ∧
    X₁ ⊔ Subgroup.zpowers (q₁ u) = ⊤ ∧
    Disjoint X₁ (Subgroup.zpowers (q₁ u)) ∧
    (∀ x ∈ X₁, ∀ v ∈ Subgroup.zpowers (q₁ u), Commute x v) ∧
    IsSimpleBenderGroup X₁ ∧ O₁ ≤ D₁ ∧
    IsBorelSubgroup ((D₁.map q₁).subgroupOf X₁) ∧
    (∀ z : L₁, (z : G) ∈ Z → (q₁ u)⁻¹ * q₁ z ∈ X₁ ∧ q₁ z ≠ q₁ u)
  refine ⟨e u, (heM u).mpr huM, ?_, ?_, ?_, ?_, ?_,
    hmodel.map_mulEquiv eX, ?_, ?_, ?_⟩
  · simpa only [map_pow, map_one] using congrArg e hu2
  · have hm := congrArg (Subgroup.map e.toMonoidHom) hgen
    simpa only [Subgroup.map_sup, hC, MonoidHom.map_zpowers, MulEquiv.coe_toMonoidHom,
      Subgroup.map_top_of_surjective e.toMonoidHom e.surjective] using hm
  · have hm := congrArg (Subgroup.map qe.toMonoidHom) hqgen
    simpa only [Subgroup.map_sup, hX, MonoidHom.map_zpowers, MulEquiv.coe_toMonoidHom, hqe,
      Subgroup.map_top_of_surjective qe.toMonoidHom qe.surjective] using hm
  · have hm := congrArg (Subgroup.map qe.toMonoidHom) (disjoint_iff.mp hdisj)
    apply disjoint_iff.mpr
    simpa only [Subgroup.map_inf _ _ qe.toMonoidHom qe.injective, hX,
      MonoidHom.map_zpowers, MulEquiv.coe_toMonoidHom, hqe, Subgroup.map_bot] using hm
  · intro x hx v hv
    have hx₀ : qe.symm x ∈ X₀ := Subgroup.mem_map_equiv.mp (hX.symm ▸ hx)
    have hp : (Subgroup.zpowers (q₀ u)).map qe.toMonoidHom =
        Subgroup.zpowers (q₁ (e u)) := by
      rw [MonoidHom.map_zpowers, MulEquiv.coe_toMonoidHom, hqe]
    have hv₀ : qe.symm v ∈ Subgroup.zpowers (q₀ u) :=
      Subgroup.mem_map_equiv.mp (hp.symm ▸ hv)
    simpa only [MulEquiv.coe_toMonoidHom, qe.apply_symm_apply] using
      (hcomm _ hx₀ _ hv₀).map qe.toMonoidHom
  · rw [← hO, ← hD]
    exact Subgroup.map_mono hcore
  · have hm := hborel.map_mulEquiv eX
    have heB := generation_map_subgroupOf qe X₀ X₁ hX (D₀.map q₀)
    rw [hB] at heB
    exact heB ▸ hm
  · intro z hz
    have hz₀ : (e.symm z : H) ∈ W := (heZ (e.symm z)).mp (by simpa using hz)
    obtain ⟨hmem, hne⟩ := hZ (e.symm z) hz₀
    constructor
    · have hm := Subgroup.mem_map_of_mem qe.toMonoidHom hmem
      rw [hX] at hm
      simpa only [map_mul, map_inv, MulEquiv.coe_toMonoidHom, hqe, e.apply_symm_apply] using hm
    · intro heq
      apply hne
      apply qe.injective
      simpa only [hqe, e.apply_symm_apply] using heq

/-- The ZD conclusion is unchanged by restricting the ambient group to the
subgroup generated by the distinguished set. -/
public theorem conclusion_of_closure
    {G : Type*} [Group G] [Finite G] {Z : Set G} {M : Subgroup G}
    (h : Conclusion ((Subgroup.closure Z).subtype ⁻¹' Z)
      (M.comap (Subgroup.closure Z).subtype)) : Conclusion Z M := by
  let L := Subgroup.closure Z
  let W := L.subtype ⁻¹' Z
  let e : Subgroup.closure W ≃* L :=
    (MulEquiv.subgroupCongr (Subgroup.closure_preimage_eq_top Z)).trans
      Subgroup.topEquiv
  rcases h with hr | hs
  · left
    intro htwo
    exact hr (htwo.map_of_injective e.symm.toMonoidHom e.symm.injective)
  · right
    exact hs.of_closureEquiv e (fun _ => Iff.rfl) (fun _ => Iff.rfl)

/-- GLS Chapter 2, (3B): a minimal counterexample to ZD is generated by its
distinguished involutions. -/
public theorem MinimalCounterexample.closure_eq_top
    {G : Type*} [Group G] [Finite G] {Z : Set G} {M : Subgroup G}
    (h : MinimalCounterexample Z M) : Subgroup.closure Z = ⊤ := by
  by_contra hL
  apply h.fails
  apply conclusion_of_closure
  apply h.conclusion_subgroup _ hL h.disconnected.closure_not_le
  obtain ⟨z, hz, hzM⟩ := h.disconnected.nonempty
  exact ⟨z, hz, Subgroup.subset_closure hz, hzM⟩

end BenderSuzuki.ZD
