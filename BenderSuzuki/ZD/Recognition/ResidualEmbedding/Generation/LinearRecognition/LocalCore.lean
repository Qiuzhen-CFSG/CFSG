module

public import BenderSuzuki.ZD.Recognition.ResidualEmbedding.Generation.Basic

/-!
# The involution core of the proper residual subgroup

The concrete subgroup `L = ⟨z, t, [O₂'(D), t]⟩` is generated by its
involutions. Its ambient centralizer lies in `D`. If its odd core lies in
`M`, the odd-normalizer clause of the residual action makes that core
central: normality gives two fixed cosets, excluding the unique-fixed-point
alternative, and internal involution conjugacy propagates centralization.

This is the centralization step in the local use of GLS, Volume 4,
Chapter 2, Corollary 7.13 and Lemma 12.2. The odd-core containment and the
model recognition are separate obligations; no ambient strong embedding
is assumed here.
-/

noncomputable section
namespace BenderSuzuki.ZD
open Theory.GroupTheory PFAppendixIII PFchapter1section1
universe u
variable {G : Type u} [Group G] [Finite G] {Z : Set G} {M : Subgroup G}

omit [Finite G] in
/-- Distinguished generation implies full involution generation inside `L`. -/
public theorem involutionCore_residualGenerated_eq_top
    (h : IsProductDisconnected Z M) {z t : G} (hz : z ∈ Z) (ht : t ∈ Z) :
    involutionCore (residualGenerated M z t) = ⊤ := by
  apply top_unique
  rw [← residualGenerated_localClosure_eq_top h hz ht, involutionCore_eq_closure]
  apply Subgroup.closure_mono
  intro x hx
  exact IsInvolution.subtype (h.involutions x hx) x.property

omit [Finite G] in
/-- The centralizer inclusion in Lemma 12.2(d) needs only the generators. -/
public theorem centralizer_residualGenerated_le_pairStabilizer
    (h : IsProductDisconnected Z M) {z t : G} (hz : z ∈ Z) (hzM : z ∈ M) :
    Subgroup.centralizer (residualGenerated M z t : Set G) ≤
      residualPairStabilizer M t := by
  have hzL : z ∈ residualGenerated M z t :=
    (show Subgroup.zpowers z ≤ residualGenerated M z t from
      le_sup_left.trans le_sup_left) (Subgroup.mem_zpowers z)
  have htL : t ∈ residualGenerated M z t :=
    (show Subgroup.zpowers t ≤ residualGenerated M z t from
      le_sup_right.trans le_sup_left) (Subgroup.mem_zpowers t)
  intro x hx
  have hxz : x ∈ Subgroup.centralizer ({z} : Set G) :=
    Subgroup.centralizer_le (Set.singleton_subset_iff.mpr hzL) hx
  have hxt : x * t = t * x :=
    Subgroup.mem_centralizer_singleton_iff.mp
      (Subgroup.centralizer_le (Set.singleton_subset_iff.mpr htL) hx)
  have hxM := h.centralizer_le hz hzM hxz
  refine ⟨hxM, ?_⟩
  change x ∈ rightConjugate M t
  rw [rightConjugate, Subgroup.conjBy, Subgroup.mem_map]
  refine ⟨x, hxM, ?_⟩
  simp only [MulEquiv.toMonoidHom_eq_coe, MonoidHom.coe_coe,
    MulAut.conj_apply, inv_inv]
  rw [mul_assoc, hxt, ← mul_assoc, inv_mul_cancel, one_mul]

/-- The action's odd-normalizer alternative centralizes the local odd core
once its ambient image is contained in `M`. Normality is inside `L`. -/
public theorem residualGenerated_oddCore_le_centralizer
    (ha : ResidualAction Z M) {z t : G} (hz : z ∈ Z) (hzM : z ∈ M)
    (htM : t ∉ M)
    (hcoreM : (twoPrimeCore (residualGenerated M z t)).map
      (residualGenerated M z t).subtype ≤ M) :
    (twoPrimeCore (residualGenerated M z t)).map
      (residualGenerated M z t).subtype ≤ Subgroup.centralizer ({z} : Set G) := by
  let L := residualGenerated M z t
  let K := twoPrimeCore L
  let W := K.map L.subtype
  have hzL : z ∈ L :=
    (show Subgroup.zpowers z ≤ L from le_sup_left.trans le_sup_left)
      (Subgroup.mem_zpowers z)
  have htL : t ∈ L :=
    (show Subgroup.zpowers t ≤ L from le_sup_right.trans le_sup_left)
      (Subgroup.mem_zpowers t)
  have hWL : W ≤ L := by
    rintro x ⟨k, _, rfl⟩
    exact k.property
  have hWsub : W.subgroupOf L = K :=
    Subgroup.comap_map_eq_self_of_injective Subtype.val_injective K
  have hWnormal : (W.subgroupOf L).Normal := by
    rw [hWsub]
    infer_instance
  have hnorm : L ≤ Subgroup.normalizer (W : Set G) :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hWL).mp hWnormal
  have hodd : Odd (Nat.card W) := by
    rw [show Nat.card W = Nat.card K from
      Subgroup.card_map_of_injective Subtype.val_injective]
    exact Nat.coprime_two_left.mp (pPrimeCore_coprime_card (p := 2) (G := L))
  rcases ha.odd_normalizer z hz hzM W hodd hcoreM (hnorm hzL) with hc | hfix
  · exact hc
  · exfalso
    have hbeta : W ≤ MulAction.stabilizer G (QuotientGroup.mk t : G ⧸ M) := by
      rw [conjugateCoset_stabilizer]
      intro w hw
      rw [rightConjugate, Subgroup.conjBy, Subgroup.mem_map]
      have htinv : t⁻¹ ∈ Subgroup.normalizer (W : Set G) :=
        (Subgroup.normalizer (W : Set G)).inv_mem (hnorm htL)
      have hw' : t⁻¹ * w * t ∈ W := by
        simpa only [inv_inv] using (Subgroup.mem_normalizer_iff.mp htinv w).mp hw
      refine ⟨t⁻¹ * w * t, hcoreM hw', ?_⟩
      simp [mul_assoc]
    have heq := (hfix (QuotientGroup.mk t) hbeta).symm
    apply htM
    simpa using QuotientGroup.eq.mp heq

/-- Local strong embedding and generation propagate the preceding
centralization from `z` to all of `L`. -/
public theorem residualGenerated_oddCore_le_center
    (h : IsProductDisconnected Z M) (r : SimpleReduction Z M)
    (ha : ResidualAction Z M) {z t : G}
    (hz : z ∈ Z) (hzM : z ∈ M) (ht : t ∈ Z) (htM : t ∉ M)
    (hL : residualGenerated M z t ≠ ⊤)
    (hcoreM : (twoPrimeCore (residualGenerated M z t)).map
      (residualGenerated M z t).subtype ≤ M) :
    twoPrimeCore (residualGenerated M z t) ≤
      Subgroup.center (residualGenerated M z t) := by
  have hzL : z ∈ residualGenerated M z t :=
    (show Subgroup.zpowers z ≤ residualGenerated M z t from
      le_sup_left.trans le_sup_left) (Subgroup.mem_zpowers z)
  have hs := stronglyEmbedded_in_proper_residualGenerated h r hz hzM ht htM hL
  apply hs.twoPrimeCore_le_center_of_involutionCore_eq_top
    (IsInvolution.subtype (h.involutions z hz) hzL)
    ?_ (involutionCore_residualGenerated_eq_top h hz ht)
  intro x hx
  apply Subgroup.mem_centralizer_singleton_iff.mpr
  apply Subtype.ext
  exact Subgroup.mem_centralizer_singleton_iff.mp
    (residualGenerated_oddCore_le_centralizer ha hz hzM htM hcoreM
      (Subgroup.mem_map_of_mem _ hx))

end BenderSuzuki.ZD
