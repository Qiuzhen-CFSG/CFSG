module

public import BenderSuzuki.ZD.Recognition.ResidualEmbedding.LocalResidual.NormalComplements.RankOne.ModelGeometry.UnitaryGeometry.TwoPointRoots.RootTransport

/-!
# The fixed unitary torus centralizes the root-generated subgroup

A diagonal special-unitary matrix commuting with the Weyl involution has
norm-one parameter. Its equal outer diagonal entries commute with every
central root, and hence with the subgroup generated by those roots and the
Weyl involution. In PSU₃, the middle matrix entry forces the projective
commutation scalar to be one, so the same calculation applies upstairs.

The genuine pair-normalization conjugators transport the calculation to
every Sylow subgroup and outside involution. Transport through arbitrary
model isomorphisms preserves both special and projective covers and the
separate matrix-field and fixed-field cardinalities.

Source: GLS4, Chapter 4, Lemmas 3.2(h), 3.5(d), and the first step of
3.6(d); used in Chapter 2 before Lemma 13.2. The equality for the whole
torus centralizer requires the additional upper bound, not proved here.
-/

open Subgroup Matrix BenderSuzuki.External
namespace BenderSuzuki.ZD.RankOneModelGeometry.UnitaryTorusCentralization
open BenderSuzuki.MatrixGroups HermitianForm BorelTorus BorelTorus.EvenCenterAction
open UnitaryStandardRoots
variable {E : Type*} [Field E] [CharP E 2] (J : HermitianForm 3 E)
  (hJ : J.form = !![0,0,1;0,1,0;1,0,0])

omit [CharP E 2] in
private theorem norm_one_of_special_commutes (k : Eˣ)
    (hc : hermitianWeylSU J hJ * hermitianTorusSU J hJ k =
      hermitianTorusSU J hJ k * hermitianWeylSU J hJ) :
    J.conj (k : E) = (k : E)⁻¹ := by
  have he := congrArg (fun x : J.specialSubgroup => x.val.val 0 2) hc
  change (hermitianWeylMatrix * hermitianTorusMatrix J k : Matrix (Fin 3) (Fin 3) E) 0 2 =
    (hermitianTorusMatrix J k * hermitianWeylMatrix : Matrix (Fin 3) (Fin 3) E) 0 2 at he
  have hh : (k : E) = (J.conj (k : E))⁻¹ := by
    simpa [hermitianWeylMatrix, hermitianTorusMatrix, Matrix.mul_apply,
      Fin.sum_univ_three] using he
  exact (inv_eq_iff_eq_inv).mp hh.symm

private theorem special_central_commutes (k : Eˣ) (hk : J.conj (k : E) = (k : E)⁻¹)
    (b : Multiplicative (fixedField J)) :
    specialCentral J hJ b * hermitianTorusSU J hJ k =
      hermitianTorusSU J hJ k * specialCentral J hJ b := by
  apply Subtype.ext
  apply Units.ext
  simp only [Subgroup.coe_mul, Units.val_mul]
  rw [central_val]
  change (!![1,0,(b.toAdd:E);0,1,0;0,0,1] * hermitianTorusMatrix J k) =
    (hermitianTorusMatrix J k * !![1,0,(b.toAdd:E);0,1,0;0,0,1])
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [hermitianTorusMatrix, hk, Matrix.mul_apply, Fin.sum_univ_three, mul_comm]

public theorem special_standard :
    specialTorus J hJ ⊓ centralizer ({hermitianWeylSU J hJ} : Set J.specialSubgroup) ≤
      centralizer (rootGenerated (specialRoot J hJ) (hermitianWeylSU J hJ) : Set _) := by
  rintro x ⟨⟨k, rfl⟩, hc⟩
  have hcomm := (mem_centralizer_singleton_iff.mp hc).symm
  have hk := norm_one_of_special_commutes J hJ k hcomm
  have hR : rootGenerated (specialRoot J hJ) (hermitianWeylSU J hJ) ≤
      centralizer ({hermitianTorusSU J hJ k} : Set _) := by
    apply sup_le
    · rw [special_omega]
      rintro _ ⟨b, rfl⟩
      exact mem_centralizer_singleton_iff.mpr (special_central_commutes J hJ k hk b)
    · exact zpowers_le.mpr (mem_centralizer_singleton_iff.mpr hcomm)
  intro y hy
  exact mem_centralizer_singleton_iff.mp (hR hy)

private theorem projective_commutes_lifts (k : Eˣ)
    (hc : hermitianWeylPSU J hJ * hermitianTorusPSU J hJ k =
      hermitianTorusPSU J hJ k * hermitianWeylPSU J hJ) :
    hermitianWeylSU J hJ * hermitianTorusSU J hJ k =
      hermitianTorusSU J hJ k * hermitianWeylSU J hJ := by
  have hp := congrArg Subtype.val hc
  change ProjGenLinGroup.mk hermitianWeylGL *
    ProjGenLinGroup.mk (hermitianTorusGL J k) =
      ProjGenLinGroup.mk (hermitianTorusGL J k) *
        ProjGenLinGroup.mk hermitianWeylGL at hp
  rw [← map_mul, ← map_mul] at hp
  obtain ⟨a, ha⟩ := ProjGenLinGroup.mk_eq_mk_iff.mp hp
  have hm := congrArg (fun g : GL (Fin 3) E => g.val 1 1) ha
  have hkn : J.conj (k : E) / (k : E) ≠ 0 :=
    div_ne_zero ((map_ne_zero J.conj).mpr k.ne_zero) k.ne_zero
  have ha1 : (a : E) = 1 := by
    have he : J.conj (k : E) / (k : E) = (J.conj (k : E) / (k : E)) * (a : E) := by
      simpa [hermitianWeylGL, hermitianWeylMatrix, hermitianTorusGL,
        hermitianTorusMatrix, GeneralLinearGroup.coe_scalar, Matrix.mul_apply,
        Fin.sum_univ_three, Matrix.scalar, CharTwo.neg_eq, div_eq_mul_inv] using hm
    exact (mul_left_cancel₀ hkn (by simpa using he :
      (J.conj (k : E) / (k : E)) * 1 = (J.conj (k : E) / (k : E)) * (a : E))).symm
  have haone : a = 1 := Units.ext ha1
  rw [haone, map_one, mul_one] at ha
  exact Subtype.ext ha

public theorem projective_standard :
    projectiveTorus J hJ ⊓ centralizer ({hermitianWeylPSU J hJ} : Set _) ≤
      centralizer (rootGenerated (projectiveRoot J hJ) (hermitianWeylPSU J hJ) : Set _) := by
  rintro x ⟨⟨k, rfl⟩, hc⟩
  have hcomm := projective_commutes_lifts J hJ k (mem_centralizer_singleton_iff.mp hc).symm
  have hC := special_standard J hJ
    (show hermitianTorusSU J hJ k ∈ specialTorus J hJ ⊓ centralizer ({hermitianWeylSU J hJ} : Set _) from
      ⟨⟨k,rfl⟩, mem_centralizer_singleton_iff.mpr hcomm.symm⟩)
  intro y hy
  rw [← projection_rootGenerated] at hy
  obtain ⟨y, hy, rfl⟩ := hy
  have hh := congrArg J.specialToProjective (hC y hy)
  have he : J.specialToProjective (hermitianTorusSU J hJ k) = hermitianTorusPSU J hJ k := by
    apply Subtype.ext
    rw [specialToProjective_apply_val, hermitianTorusPSU_val]
    rfl
  simpa only [map_mul, he] using hh

end BenderSuzuki.ZD.RankOneModelGeometry.UnitaryTorusCentralization

namespace BenderSuzuki.ZD.RankOneModelGeometry.UnitaryTorusCentralization
open BenderSuzuki.PFchapter1section1 BenderSuzuki.PFAppendixIII
open BenderSuzuki.MatrixGroups
section Transport
variable {G H : Type*} [Group G] [Group H]

public theorem twoPoint_map (e : G ≃* H) (B : Subgroup G) (t : G) :
    (twoPoint B t).map e.toMonoidHom = twoPoint (B.map e.toMonoidHom) (e t) := by
  rw [twoPoint, twoPoint, Subgroup.map_inf _ _ _ e.injective]
  congr 1
  simp only [rightConjugate, Subgroup.conjBy, Subgroup.map_map]
  congr 1
  ext x
  simp

public theorem root_map (e : G ≃* H) (P : Subgroup G) (t : G) :
    (rootGenerated P t).map e.toMonoidHom = rootGenerated (P.map e.toMonoidHom) (e t) := by
  rw [rootGenerated, rootGenerated, Subgroup.map_sup,
    map_omegaOneAmbient_injective e.toMonoidHom e.injective, MonoidHom.map_zpowers]
  rfl

public theorem centralizer_map (e : G ≃* H) (s : Set G) :
    (centralizer s).map e.toMonoidHom = centralizer (e '' s) := by
  apply le_antisymm (map_centralizer_le_centralizer_image _ _)
  intro x hx
  refine ⟨e.symm x, ?_, e.apply_symm_apply x⟩
  intro y hy
  apply e.injective
  simpa only [map_mul, e.apply_symm_apply] using hx (e y) ⟨y, hy, rfl⟩

public theorem fixed_map (e : G ≃* H) (D : Subgroup G) (t : G) :
    (D ⊓ centralizer ({t} : Set G)).map e.toMonoidHom =
      D.map e.toMonoidHom ⊓ centralizer ({e t} : Set H) := by
  rw [map_inf _ _ _ e.injective, centralizer_map, Set.image_singleton]

private theorem centralizes_of_map (e : G ≃* H) (D R : Subgroup G)
    (S T : Subgroup H) (hD : D.map e.toMonoidHom = S) (hR : R.map e.toMonoidHom = T)
    (hc : S ≤ centralizer (T : Set H)) : D ≤ centralizer (R : Set G) := by
  intro d hd x hx
  apply e.injective
  simpa only [map_mul] using
    hc (hD ▸ mem_map_of_mem e.toMonoidHom hd) (e x) (hR ▸ mem_map_of_mem e.toMonoidHom hx)

private theorem pair_centralizes_of_equiv [Finite G] (e : G ≃* H)
    (P : Sylow 2 G) (t : G)
    (hc : let Q := P.mapSurjective (f := e.toMonoidHom) e.surjective
      twoPoint (normalizer (Q : Set H)) (e t) ⊓ centralizer ({e t} : Set H) ≤
        centralizer (rootGenerated (Q : Subgroup H) (e t) : Set H)) :
    twoPoint (normalizer (P : Set G)) t ⊓ centralizer ({t} : Set G) ≤
      centralizer (rootGenerated (P : Subgroup G) t : Set G) := by
  apply centralizes_of_map e _ _ _ _ ?_ (root_map e (P : Subgroup G) t) hc
  rw [fixed_map, twoPoint_map]
  exact congrArg (fun B => twoPoint B (e t) ⊓ centralizer ({e t} : Set H))
    (map_equiv_normalizer_eq (P : Subgroup G) e)
end Transport

variable {E : Type*} [Field E] [Finite E] (J : HermitianForm 3 E)
  (hJ : J.form = !![0,0,1;0,1,0;1,0,0]) {n : ℕ} (hn : 2 ≤ n)
  (hcard : Nat.card E = (2 ^ n) ^ 2)
  (hfixed : Nat.card {x : E // J.conj x = x} = 2 ^ n)

include hcard in
private theorem charTwo_of_card : CharP E 2 := by
  let := Fintype.ofFinite E
  apply charP_of_card_eq_prime_pow (p := 2) (f := n * 2)
  simpa [Nat.card_eq_fintype_card, pow_mul] using hcard

include hJ hn hcard hfixed in
public theorem special_pair (P : Sylow 2 J.specialSubgroup) (t : J.specialSubgroup)
    (ht : BenderSuzuki.PFAppendixIII.IsInvolution t) (htB : t ∉ normalizer (P : Set J.specialSubgroup)) :
    twoPoint (normalizer (P : Set J.specialSubgroup)) t ⊓ centralizer ({t} : Set _) ≤
      centralizer (rootGenerated (P : Subgroup J.specialSubgroup) t : Set _) := by
  let : CharP E 2 := charTwo_of_card hcard
  obtain ⟨g, hP, ht', hD⟩ := PairNormalization.special_pair J hJ hn hcard hfixed P t ht htB
  let c := MulAut.conj g
  apply centralizes_of_map c _ _ _ _ ?_ ?_ (special_standard J hJ)
  · rw [fixed_map, hD, ht']
  · rw [root_map, hP, ht']

include hJ hn hcard hfixed in
public theorem projective_pair (P : Sylow 2 (ProjectiveSpecialUnitaryMatrixGroup J))
    (t : ProjectiveSpecialUnitaryMatrixGroup J) (ht : BenderSuzuki.PFAppendixIII.IsInvolution t)
    (htB : t ∉ normalizer (P : Set (ProjectiveSpecialUnitaryMatrixGroup J))) :
    twoPoint (normalizer (P : Set (ProjectiveSpecialUnitaryMatrixGroup J))) t ⊓
      centralizer ({t} : Set _) ≤
        centralizer (rootGenerated (P : Subgroup (ProjectiveSpecialUnitaryMatrixGroup J)) t : Set _) := by
  let : CharP E 2 := charTwo_of_card hcard
  obtain ⟨g, hP, ht', hD⟩ := PairNormalization.projective_pair J hJ hn hcard hfixed P t ht htB
  let c := MulAut.conj g
  apply centralizes_of_map c _ _ _ _ ?_ ?_ (projective_standard J hJ)
  · rw [fixed_map, hD, ht']
  · rw [root_map, hP, ht']

variable {G : Type*} [Group G] [Finite G]

include hJ hn hcard hfixed in
public theorem special_of_equiv (e : G ≃* J.specialSubgroup) (P : Sylow 2 G)
    (t : G) (ht : BenderSuzuki.PFAppendixIII.IsInvolution t) (htB : t ∉ normalizer (P : Set G)) :
    twoPoint (normalizer (P : Set G)) t ⊓ centralizer ({t} : Set G) ≤
      centralizer (rootGenerated (P : Subgroup G) t : Set G) := by
  apply pair_centralizes_of_equiv e P t
  apply special_pair J hJ hn hcard hfixed
  · exact BenderSuzuki.IsInvolution.map_of_injective ht e.toMonoidHom e.injective
  · intro hh
    change e t ∈ normalizer ((P : Subgroup G).map e.toMonoidHom : Set _) at hh
    rw [← map_equiv_normalizer_eq] at hh
    obtain ⟨x, hx, he⟩ := hh
    exact htB (e.injective he ▸ hx)

include hJ hn hcard hfixed in
public theorem projective_of_equiv (e : G ≃* ProjectiveSpecialUnitaryMatrixGroup J)
    (P : Sylow 2 G) (t : G) (ht : BenderSuzuki.PFAppendixIII.IsInvolution t) (htB : t ∉ normalizer (P : Set G)) :
    twoPoint (normalizer (P : Set G)) t ⊓ centralizer ({t} : Set G) ≤
      centralizer (rootGenerated (P : Subgroup G) t : Set G) := by
  apply pair_centralizes_of_equiv e P t
  apply projective_pair J hJ hn hcard hfixed
  · exact BenderSuzuki.IsInvolution.map_of_injective ht e.toMonoidHom e.injective
  · intro hh
    change e t ∈ normalizer ((P : Subgroup G).map e.toMonoidHom : Set _) at hh
    rw [← map_equiv_normalizer_eq] at hh
    obtain ⟨x, hx, he⟩ := hh
    exact htB (e.injective he ▸ hx)

end BenderSuzuki.ZD.RankOneModelGeometry.UnitaryTorusCentralization
