module
public import BenderSuzuki.ZD.Recognition.ResidualEmbedding.Generation.LinearRecognition.Centralizers.UnitaryExclusion.LocalTwoStructure.Definitions
public import BenderSuzuki.ZD.Recognition.ResidualEmbedding.Generation.LinearRecognition.Centralizers.UnitaryExclusion.LocalTwoStructure.Source
public import BenderSuzuki.ZD.Recognition.ResidualEmbedding.Generation.LinearRecognition.Centralizers.UnitaryExclusion.SecondCentralizer.BorelRecognition
public import Theory.GroupTheory.SylowNormalizerCentralizerCore
public import Theory.SpecificGroups.SL2.TwoSubgroupExponent

/-!
# Source placement before the unitary coordinate and torus calculations

Local strong embedding and the actual unitary Borel recognition identify the
literal two-core images T and V as Sylow subgroups. Earlier distinguished
involution results identify their square-one layers and place A inside U.
The intersection T ∩ U lies in the specified PSL₂ subgroup, hence has exponent
two and equals A. None of these steps requires a homocyclic construction.

Conjugation also proves that U normalizes O₂([B,C_G(A⟨u⟩)]), retaining the
subgroup join and relative characteristicity. The final two records specify
the remaining independent coordinate construction and torus calculations;
they are proof obligations, not source assumptions or established results.

Source: GLS, Volume 4, Chapter 2, Lemmas 13.2–13.4 and the subsequent
construction; Chapter 4, Lemmas 3.4(d4–5) and 3.5(c).
-/

noncomputable section
namespace BenderSuzuki.ZD.UnitaryExclusion.SourcePlacement
open Subgroup Theory.GroupTheory PFchapter1section1 PFAppendixIII
universe v
variable {G : Type v} [Group G] [Finite G]
variable {Z : Set G} {M : Subgroup G} {z t u : G} {n : ℕ}

private theorem stronglyEmbedded_of_top {H : Type*} [Group H] [Finite H]
    (N : Subgroup H) (hs : IsStronglyEmbedded (N.comap (⊤ : Subgroup H).subtype)) :
    IsStronglyEmbedded N := by
  change IsStronglyEmbedded ((N.comap (⊤ : Subgroup H).subtype).comap
    (Subgroup.topEquiv.symm : H ≃* (⊤ : Subgroup H)).toMonoidHom)
  apply hs.comap_of_injective _ Subgroup.topEquiv.symm.injective
  · change N ≠ ⊤
    intro hn
    exact hs.ne_top (by rw [hn, comap_top])
  · obtain ⟨x, hx, hi⟩ := hs.exists_involution
    exact ⟨x, hx, IsInvolution.map_of_injective hi
      (⊤ : Subgroup H).subtype Subtype.val_injective⟩

omit [Finite G] in
/-- The second distinguished centralizer is generated by its own distinguished elements. -/
public theorem second_local_generation (B : Subgroup G) :
    closure ((distinguishedCentralizer Z B).subtype ⁻¹' Z) = ⊤ := by
  let F := distinguishedCentralizer Z B
  have hF : F ≤ (closure (F.subtype ⁻¹' Z)).map F.subtype := by
    apply (closure_le _).mpr
    intro x hx
    exact ⟨⟨x, subset_closure hx⟩, subset_closure hx.1, rfl⟩
  apply top_unique
  intro x _
  obtain ⟨y, hy, he⟩ := hF x.property
  exact (Subtype.ext he : y = x) ▸ hy

/-- The explicit second-centralizer data supplies properness, and local embedding
therefore applies in the actual cover, before any graph-action alignment. -/
public theorem second_stronglyEmbedded
    (r : SimpleReduction Z M) (hz : z ∈ Z) (hzM : z ∈ M) (htM : t ∉ M)
    (d : SecondCentralizerData Z M z t u n) :
    IsStronglyEmbedded (M.comap (distinguishedCentralizer Z d.torus).subtype) := by
  let F := distinguishedCentralizer Z d.torus
  have hLF : residualGenerated M z t ≤ F := d.intersection ▸ inf_le_left
  have hzF : z ∈ F := hLF ((show zpowers z ≤ residualGenerated M z t from le_sup_left.trans le_sup_left) (mem_zpowers z))
  have htF : t ∈ F := hLF ((show zpowers t ≤ residualGenerated M z t from le_sup_right.trans le_sup_left) (mem_zpowers t))
  have hF : F ≠ ⊤ := by
    intro he
    have huF : u ∈ F := by rw [he]; exact mem_top _
    exact d.noninner ⟨u, huF, fun _ _ => rfl⟩
  have hs := r.local_embedding F hF (fun hFM => htM (hFM htF)) ⟨z, hz, hzF, hzM⟩
  rw [second_local_generation] at hs
  exact stronglyEmbedded_of_top _ hs

private theorem core_sylow_of_borel (H : Subgroup G)
    (hb : IsBorelSubgroup (M.comap H.subtype)) :
    ∃ S : Sylow 2 H, (S : Subgroup H).map H.subtype = localTwoCore M H := by
  obtain ⟨_, S, hS⟩ := hb
  refine ⟨S, sylow_map_eq_pCoreIn_of_normalizer_map_eq S H.subtype H.subtype_injective
    (M ⊓ H) ?_⟩
  change (normalizer ((S : Subgroup H) : Set H)).map H.subtype = _
  rw [← hS, map_comap_eq, range_subtype, inf_comm]

/-- T is the image of an actual Sylow subgroup of Lᵤ. -/
public theorem sylow_T
    (h : IsProductDisconnected Z M) (r : SimpleReduction Z M)
    (htM : t ∉ M) (huD : u ∈ residualPairStabilizer M t)
    (hu : PFAppendixIII.IsInvolution u) (hn : 2 ≤ n)
    (hunitary : ResidualUnitaryCentralizers Z M z t n) :
    ∃ S : Sylow 2 (centralizerClosure Z u),
      (S : Subgroup (centralizerClosure Z u)).map (centralizerClosure Z u).subtype =
        localT Z M u :=
  core_sylow_of_borel _ (pair_involution_unitary_borel h r htM huD hu hn
    (hunitary u huD hu).2)

/-- V is the image of an actual Sylow subgroup of L_B. -/
public theorem sylow_V
    (r : SimpleReduction Z M) (hz : z ∈ Z) (hzM : z ∈ M) (htM : t ∉ M)
    (hn : 2 ≤ n) (d : SecondCentralizerData Z M z t u n) :
    ∃ S : Sylow 2 (distinguishedCentralizer Z d.torus),
      (S : Subgroup (distinguishedCentralizer Z d.torus)).map
        (distinguishedCentralizer Z d.torus).subtype = localV Z M d.torus :=
  core_sylow_of_borel _ (borel_of_unitaryCentralizerCover hn d.second_cover _
    (second_stronglyEmbedded r hz hzM htM d))

/-- The subgroup T₁ in the source's relative-normality argument. -/
@[expose] public def commutatorCore (Z : Set G) (M B : Subgroup G) (u : G) : Subgroup G :=
  (⁅B, centralizer ((closure (Z ∩ (M : Set G)) ⊔ zpowers u : Subgroup G) : Set G)⁆).pCoreIn 2

omit [Finite G] in
/-- U centralizes B and normalizes A⟨u⟩, hence preserves the source's T₁. -/
public theorem sourceLocalU_normalizes_commutatorCore (B : Subgroup G) :
    sourceLocalU Z M B u ≤ normalizer (commutatorCore Z M B u : Set G) := by
  apply le_trans _ (centralizer_inf_normalizer_le_normalizer_commutator_core B
    (closure (Z ∩ (M : Set G)) ⊔ zpowers u) 2)
  apply le_inf ?_ inf_le_right
  apply (sourceLocalU_le B).trans (inf_le_right.trans ?_)
  exact (closure_le _).mpr (fun _ hx => hx.2)

/-- Every involution in the actual second centralizer is distinguished. -/
public theorem second_involutions_distinguished
    (h : IsProductDisconnected Z M) (r : SimpleReduction Z M)
    (hz : z ∈ Z) (hzM : z ∈ M) (htM : t ∉ M)
    (d : SecondCentralizerData Z M z t u n)
    {x : G} (hx : x ∈ distinguishedCentralizer Z d.torus)
    (hi : PFAppendixIII.IsInvolution x) : x ∈ Z := by
  have hLF : residualGenerated M z t ≤ distinguishedCentralizer Z d.torus :=
    d.intersection ▸ inf_le_left
  have hzF := hLF ((show zpowers z ≤ residualGenerated M z t from le_sup_left.trans le_sup_left) (mem_zpowers z))
  have hs := second_stronglyEmbedded r hz hzM htM d
  obtain ⟨g, hg⟩ := hs.involutions_conjugate
    (IsInvolution.subtype (h.involutions z hz) hzF) (IsInvolution.subtype hi hx)
  have hg' : MulAut.conj ((g : G)⁻¹) z = x := by
    simpa only [rightConjugateElem, MulAut.conj_apply, inv_inv,
      Subgroup.coe_mul, Subgroup.coe_inv] using congrArg Subtype.val hg
  exact hg' ▸ h.invariant _ _ hz

omit [Finite G] in
private theorem square_iff_distinguishedClosure
    (h : IsProductDisconnected Z M)
    (hZ : Z ∩ (M : Set G) = (closure (Z ∩ (M : Set G)) : Set G) \ {1})
    {x : G} (hxM : x ∈ M) (hi : PFAppendixIII.IsInvolution x → x ∈ Z) :
    x ∈ closure (Z ∩ (M : Set G)) ↔ x ^ 2 = 1 := by
  constructor
  · intro hx
    by_cases he : x = 1
    · simp [he]
    · exact (h.involutions x ((hZ.symm ▸ ⟨hx, he⟩ : x ∈ Z ∩ (M : Set G)).1)).sq_eq_one
  · intro hx
    by_cases he : x = 1
    · simp [he]
    · exact subset_closure ⟨hi ⟨he, hx⟩, hxM⟩

/-- Source consequences needed to place and identify the common involutions.
They come from the earlier proper-residual theorem, independently of unitary coordinates. -/
public theorem distinguishedClosure_data
    (h : MinimalCounterexample Z M) (r : SimpleReduction Z M)
    (ha : ResidualAction Z M) (hz : z ∈ Z) (hzM : z ∈ M)
    (ht : t ∈ Z) (htM : t ∉ M) (hL : residualGenerated M z t ≠ ⊤)
    (heven : Even (Nat.card (residualPairStabilizer M t))) :
    closure (Z ∩ (M : Set G)) ≤ residualGenerated M z t ∧
      M ≤ normalizer (closure (Z ∩ (M : Set G)) : Set G) ∧
      IsPGroup 2 (closure (Z ∩ (M : Set G))) ∧
      Z ∩ (M : Set G) = (closure (Z ∩ (M : Set G)) : Set G) \ {1} := by
  obtain ⟨k, hk, hm, hAL, hDN, hlocal, hcore, hnormal, hA, hcard, hZ, hrest⟩ :=
    proper_residualGenerated_structure h r ha hz hzM ht htM hL heven
  have hAM : closure (Z ∩ (M : Set G)) ≤ M := (closure_le _).mpr fun _ hx => hx.2
  exact ⟨hAL, (normal_subgroupOf_iff_le_normalizer hAM).mp hnormal, hA.isPGroup, hZ⟩

omit [Finite G] in
/-- Normality in M places A in V, and A itself normalizes A⟨u⟩. -/
public theorem distinguishedClosure_le_sourceLocalU
    (hAL : closure (Z ∩ (M : Set G)) ≤ residualGenerated M z t)
    (hMA : M ≤ normalizer (closure (Z ∩ (M : Set G)) : Set G))
    (hA : IsPGroup 2 (closure (Z ∩ (M : Set G))))
    (d : SecondCentralizerData Z M z t u n) :
    closure (Z ∩ (M : Set G)) ≤ sourceLocalU Z M d.torus u := by
  have hAM : closure (Z ∩ (M : Set G)) ≤ M := (closure_le _).mpr fun _ hx => hx.2
  have hLF : residualGenerated M z t ≤ distinguishedCentralizer Z d.torus :=
    d.intersection ▸ inf_le_left
  refine le_inf (le_pCoreIn_of_normalizes hA (le_inf hAM (hAL.trans hLF))
    (inf_le_left.trans hMA)) ?_
  exact le_sup_left.trans (closure (Z ∩ (M : Set G)) ⊔ zpowers u : Subgroup G).le_normalizer

/-- Square-one elements of T are precisely its elements in A. -/
public theorem localT_involutions
    (h : IsProductDisconnected Z M) (r : SimpleReduction Z M)
    (htM : t ∉ M) (huD : u ∈ residualPairStabilizer M t)
    (hu : PFAppendixIII.IsInvolution u)
    (hZ : Z ∩ (M : Set G) = (closure (Z ∩ (M : Set G)) : Set G) \ {1})
    (x : localT Z M u) : (x : G) ∈ closure (Z ∩ (M : Set G)) ↔ x ^ 2 = 1 := by
  have hx := localTwoCore_le M (centralizerClosure Z u) x.property
  rw [← Subtype.coe_inj]
  exact square_iff_distinguishedClosure h hZ hx.1
    (fun hi => (pair_involution_centralizerClosure_involutions h r htM huD hu hx.2).mp hi)

/-- Square-one elements of the corrected U are precisely its elements in A. -/
public theorem sourceLocalU_involutions
    (h : IsProductDisconnected Z M) (r : SimpleReduction Z M)
    (hz : z ∈ Z) (hzM : z ∈ M) (htM : t ∉ M)
    (d : SecondCentralizerData Z M z t u n)
    (hZ : Z ∩ (M : Set G) = (closure (Z ∩ (M : Set G)) : Set G) \ {1})
    (x : sourceLocalU Z M d.torus u) :
    (x : G) ∈ closure (Z ∩ (M : Set G)) ↔ x ^ 2 = 1 := by
  have hx := sourceLocalU_le d.torus x.property
  rw [← Subtype.coe_inj]
  exact square_iff_distinguishedClosure h hZ hx.1
    (second_involutions_distinguished h r hz hzM htM d hx.2)

end BenderSuzuki.ZD.UnitaryExclusion.SourcePlacement

namespace BenderSuzuki.ZD.UnitaryExclusion.SourcePlacement
open Subgroup Theory.GroupTheory PFchapter1section1 PFAppendixIII
universe v
variable {G : Type v} [Group G] [Finite G]
variable {Z : Set G} {M : Subgroup G} {z t u : G} {n : ℕ}

omit [Finite G] in
private theorem twoSubgroup_in_residual_pow_two
    (e : residualGenerated M z t ≃* MatrixGroups.PSL2BinaryMatrixGroup n)
    (K : Subgroup G) (hK : IsPGroup 2 K) (hKL : K ≤ residualGenerated M z t)
    (x : K) : x ^ 2 = 1 := by
  let L := residualGenerated M z t
  let q : Converse.SL2 (PFAppendixIII.BinaryGaloisField n) ≃*
      MatrixGroups.PSL2MatrixGroup (PFAppendixIII.BinaryGaloisField n) :=
    MulEquiv.ofBijective (Converse.pi _) ⟨Converse.pi_injective, Converse.pi_surjective⟩
  let f := e.trans q.symm
  let P := K.subgroupOf L
  let Q := P.map f.toMonoidHom
  have hQ : IsPGroup 2 Q := hK.comap_subtype.map f.toMonoidHom
  let y : L := ⟨x, hKL x.property⟩
  let yQ : Q := ⟨f y, ⟨y, x.property, rfl⟩⟩
  have hs := Matrix.SpecialLinearGroup.twoSubgroup_pow_two Q hQ yQ
  have he : f (y ^ 2) = f 1 := by
    simpa only [map_pow, map_one, coe_pow, coe_one] using
      congrArg (fun a : Q => (a : Converse.SL2 (PFAppendixIII.BinaryGaloisField n))) hs
  exact Subtype.ext (congrArg (fun a : L => (a : G)) (f.injective he))

/-- The full intersection T ∩ U is already A, without constructing T₀.
It lies in the literal PSL₂ subgroup L, so has exponent two; distinguished
involutions give one containment, and normality of A in M gives the other. -/
public theorem localT_inf_sourceLocalU
    (h : MinimalCounterexample Z M) (r : SimpleReduction Z M)
    (ha : ResidualAction Z M) (hz : z ∈ Z) (hzM : z ∈ M)
    (ht : t ∈ Z) (htM : t ∉ M) (hL : residualGenerated M z t ≠ ⊤)
    (heven : Even (Nat.card (residualPairStabilizer M t)))
    (huD : u ∈ residualPairStabilizer M t) (hu : PFAppendixIII.IsInvolution u)
    (d : SecondCentralizerData Z M z t u n)
    (e : residualGenerated M z t ≃* MatrixGroups.PSL2BinaryMatrixGroup n) :
    localT Z M u ⊓ sourceLocalU Z M d.torus u = closure (Z ∩ (M : Set G)) := by
  obtain ⟨hAL, hMA, hA, hZ⟩ := distinguishedClosure_data h r ha hz hzM ht htM hL heven
  have hAU := distinguishedClosure_le_sourceLocalU hAL hMA hA d
  have hAT : closure (Z ∩ (M : Set G)) ≤ localT Z M u := by
    have hAM : closure (Z ∩ (M : Set G)) ≤ M := (closure_le _).mpr fun _ hx => hx.2
    have hLH : residualGenerated M z t ≤ centralizerClosure Z u :=
      d.intersection ▸ inf_le_right
    exact le_pCoreIn_of_normalizes hA (le_inf hAM (hAL.trans hLH)) (inf_le_left.trans hMA)
  apply le_antisymm ?_ (le_inf hAT hAU)
  have hKL : localT Z M u ⊓ sourceLocalU Z M d.torus u ≤ residualGenerated M z t := by
    rw [← d.intersection]
    exact le_inf (inf_le_right.trans ((sourceLocalU_le _).trans inf_le_right))
      (inf_le_left.trans ((localTwoCore_le _ _).trans inf_le_right))
  have hK : IsPGroup 2 (localT Z M u ⊓ sourceLocalU Z M d.torus u : Subgroup G) :=
    (sourceLocalU_isPGroup _).to_le inf_le_right
  intro x hx
  have hs := congrArg Subtype.val (twoSubgroup_in_residual_pow_two e _ hK hKL ⟨x, hx⟩)
  exact (localT_involutions h.disconnected r htM huD hu hZ ⟨x, hx.1⟩).mpr (Subtype.ext hs)

/-- The remaining coordinate construction, with the distinguished subgroup marked.
The involution layers and factor intersection are proved separately in the source application. -/
public structure HomocyclicFactors
    (Z : Set G) (M : Subgroup G) (z t u : G) (n : ℕ)
    (d : SecondCentralizerData Z M z t u n) where
  U_homocyclic : Nonempty (sourceLocalU Z M d.torus u ≃* StandardHomocyclicCover (Fin n) 4)
  T₀ : Subgroup G
  T₀_le : T₀ ≤ localT Z M u
  T₀_homocyclic : Nonempty (T₀ ≃* StandardHomocyclicCover (Fin n) 4)
  A_le_T₀ : closure (Z ∩ (M : Set G)) ≤ T₀

/-- The intrinsic torus and source placement calculations still to be supplied.
The core equality retains the source's relative normality; it implies U-invariance
by the already proved normalizer calculation, rather than assuming that conclusion. -/
public structure TorusActionData
    (Z : Set G) (M : Subgroup G) (z t u : G) (n : ℕ)
    (d : SecondCentralizerData Z M z t u n) : Prop where
  core_eq : commutatorCore Z M d.torus u = localT Z M u
  torus_moves_T : ⁅localT Z M u, d.torus⁆ ≠ ⊥
  torus_fixes_frattini : (frattini (localT Z M u)).map (localT Z M u).subtype ≤
    centralizer (d.torus : Set G)
  pair_normalizes_U : residualPairStabilizer M t ⊓ centralizerClosure Z u ≤
    normalizer (sourceLocalU Z M d.torus u : Set G)
  irreducible : ∀ W : Subgroup G, W ≤ localT Z M u →
    residualPairStabilizer M t ⊓ centralizerClosure Z u ≤ normalizer (W : Set G) →
    W ≤ (frattini (localT Z M u)).map (localT Z M u).subtype ∨
      W ⊔ (frattini (localT Z M u)).map (localT Z M u).subtype = localT Z M u

end BenderSuzuki.ZD.UnitaryExclusion.SourcePlacement
