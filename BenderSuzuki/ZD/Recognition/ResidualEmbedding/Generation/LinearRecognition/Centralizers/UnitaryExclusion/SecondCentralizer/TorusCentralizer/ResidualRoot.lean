module

public import BenderSuzuki.ZD.Recognition.ResidualEmbedding.Generation.LinearRecognition.Centralizers.UnitaryExclusion.SecondCentralizer.AmbientTorus
public import BenderSuzuki.ZD.Recognition.ResidualEmbedding.Generation.LinearRecognition.ProperModels.OrbitControl

/-!
# Identifying the residual subgroup in a unitary centralizer

In the local unitary Borel, the distinguished involution z belongs to the
Sylow two-subgroup. The subgroup generated by z, the outside involution t,
and the local two-point commutator is the model root-generated PSL₂.
Its image lies in the ambient residual subgroup because the literal
commutator [O₂′(D),t] equals [D,t]. Both subgroups are isomorphic to PSL₂
with the same fixed-field order, so finite cardinality gives equality.

This identifies the actual embedded subgroup, not merely its isomorphism
type. Both SU₃ and PSU₃ covers retain matrix-field order (2ⁿ)² and fixed-field
order 2ⁿ. No torus centralization or centralizer calculation is used.

Source: GLS4, Chapter 2, the paragraph before Lemma 13.2; Chapter 4,
Lemma 3.2(h), with the source residual convention from Chapter 2, Section 3.
-/

open Subgroup Theory.GroupTheory BenderSuzuki.PFAppendixIII BenderSuzuki.PFchapter1section1
open BenderSuzuki.MatrixGroups
namespace BenderSuzuki.ZD.UnitaryExclusion
open RankOneModelGeometry
variable {G : Type*} [Group G] [Finite G] {Z : Set G} {M : Subgroup G}
  {z t u : G} {n : ℕ}

omit [Finite G] in
private theorem mem_sylow_of_involution_mem_normalizer (P : Sylow 2 G)
    {x : G} (hx : PFAppendixIII.IsInvolution x) (hn : x ∈ normalizer (P : Set G)) :
    x ∈ (P : Subgroup G) := by
  have hp : IsPGroup 2 (zpowers x) := IsPGroup.of_card (by
    simpa only [Nat.card_zpowers, pow_one] using
      (orderOf_eq_prime_iff).2 ⟨hx.sq_eq_one, hx.ne_one⟩ : Nat.card (zpowers x) = 2 ^ 1)
  have hm : x ∈ zpowers x ⊓ normalizer (P : Set G) := ⟨mem_zpowers x, hn⟩
  rw [hp.inf_normalizer_sylow P] at hm
  exact hm.2

omit [Finite G] in
private theorem mem_right_conjugate (B : Subgroup G) (t x : G) :
    x ∈ rightConjugate B t ↔ t * x * t⁻¹ ∈ B := by
  rw [rightConjugate, Subgroup.conjBy, mem_map_equiv]
  simp [MulAut.conj_apply]

omit [Finite G] in
private theorem local_twoPoint_le (F : Subgroup G) (htF : t ∈ F) :
    (twoPoint (M.comap F.subtype) (⟨t, htF⟩ : F)).map F.subtype ≤
      residualPairStabilizer M t := by
  rintro _ ⟨x, hx, rfl⟩
  refine ⟨hx.1, ?_⟩
  apply (mem_right_conjugate M t x).mpr
  exact (mem_right_conjugate (M.comap F.subtype) ⟨t, htF⟩ x).mp hx.2

private theorem unitaryCover_marked_root
    (hc : IsUnitaryCentralizerCoverAt n G) (hn : 2 ≤ n)
    (P : Sylow 2 G) (z t : G) (hzP : z ∈ P) (hz : PFAppendixIII.IsInvolution z)
    (ht : PFAppendixIII.IsInvolution t) (htB : t ∉ normalizer (P : Set G)) :
    (zpowers z ⊔ zpowers t ⊔ ⁅twoPoint (normalizer (P : Set G)) t, zpowers t⁆ =
      rootGenerated (P : Subgroup G) t) ∧
    Nonempty (rootGenerated (P : Subgroup G) t ≃* PSL2BinaryMatrixGroup n) := by
  obtain ⟨E, _, _, J, hJ, hcard, hfixed, he | he⟩ := hc
  · obtain ⟨e⟩ := he
    exact ⟨(unitary_projective_marked_pair_of_equiv J hn hJ hcard hfixed e P z t
      hzP hz ht htB).1,
      ⟨unitary_projective_rootGenerated_equiv_of_equiv J hn hJ hcard hfixed e P t ht htB⟩⟩
  · obtain ⟨e⟩ := he
    exact ⟨(unitary_special_marked_pair_of_equiv J hn hJ hcard hfixed e P z t
      hzP hz ht htB).1,
      ⟨unitary_special_rootGenerated_equiv_of_equiv J hn hJ hcard hfixed e P t ht htB⟩⟩

/-- The actual residual subgroup is the image of the unitary root-generated
subgroup under the literal inclusion of its distinguished centralizer. -/
public theorem residualGenerated_eq_unitary_root_map
    (h : IsProductDisconnected Z M) (hz : z ∈ Z) (hzM : z ∈ M)
    (ht : t ∈ Z) (htM : t ∉ M) (hn : 2 ≤ n)
    (eL : residualGenerated M z t ≃* PSL2BinaryMatrixGroup n)
    (hLF : residualGenerated M z t ≤ centralizerClosure Z u)
    (hc : IsUnitaryCentralizerCoverAt n (centralizerClosure Z u))
    (P : Sylow 2 (centralizerClosure Z u))
    (hP : M.comap (centralizerClosure Z u).subtype = normalizer (P : Set _)) :
    residualGenerated M z t =
      (rootGenerated (P : Subgroup (centralizerClosure Z u))
        (⟨t, hLF (mem_sup_left (mem_sup_right (mem_zpowers t)))⟩ : centralizerClosure Z u)).map
          (centralizerClosure Z u).subtype := by
  let F := centralizerClosure Z u
  have hzF : z ∈ F := hLF (mem_sup_left (mem_sup_left (mem_zpowers z)))
  have htF : t ∈ F := hLF (mem_sup_left (mem_sup_right (mem_zpowers t)))
  let zF : F := ⟨z, hzF⟩
  let tF : F := ⟨t, htF⟩
  have hzP : zF ∈ P := mem_sylow_of_involution_mem_normalizer P
    (BenderSuzuki.IsInvolution.subtype (h.involutions z hz) hzF) (hP ▸ hzM)
  have htB : tF ∉ normalizer (P : Set F) := by
    rw [← hP]
    exact htM
  obtain ⟨hgen, ⟨eR⟩⟩ := unitaryCover_marked_root hc hn P zF tF hzP
    (BenderSuzuki.IsInvolution.subtype (h.involutions z hz) hzF)
    (BenderSuzuki.IsInvolution.subtype (h.involutions t ht) htF) htB
  let R := rootGenerated (P : Subgroup F) tF
  have hRL : R.map F.subtype ≤ residualGenerated M z t := by
    dsimp only [R]
    rw [← hgen, Subgroup.map_sup, Subgroup.map_sup, Subgroup.map_commutator, MonoidHom.map_zpowers,
      MonoidHom.map_zpowers, ← hP]
    apply sup_le le_sup_left
    apply le_trans (commutator_mono (local_twoPoint_le F htF) le_rfl)
    change ⁅residualPairStabilizer M t, zpowers t⁆ ≤ residualGenerated M z t
    rw [← residualCommutator_eq_pair_commutator h ht htM]
    exact le_sup_right
  have hcard : Nat.card (residualGenerated M z t) ≤ Nat.card (R.map F.subtype) := by
    rw [← Nat.card_congr (R.equivMapOfInjective F.subtype Subtype.val_injective).toEquiv]
    exact le_of_eq ((Nat.card_congr eL.toEquiv).trans (Nat.card_congr eR.toEquiv).symm)
  exact (Subgroup.eq_of_le_of_card_ge hRL hcard).symm
end BenderSuzuki.ZD.UnitaryExclusion
