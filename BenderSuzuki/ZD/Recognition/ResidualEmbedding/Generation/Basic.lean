module

public import BenderSuzuki.ZD.Recognition.ResidualEmbedding.LocalResidual.Pair
public import BenderSuzuki.Converse.Lift
public import BenderSuzuki.SE.StrongEmbeddingConjugacy
public import BenderSuzuki.PFchapter1section1.proposition_2_a

/-!
# Preliminary reductions for residual generation

In the canonical doubly transitive coset action, all two-point stabilizers
have the same order. If one has odd order, product disconnection supplies
the other two clauses of strong embedding. Thus failure of strong embedding
forces the even-order hypothesis at the start of GLS, Volume 4, Chapter 2,
Section 12.

For the actual group `L = ⟨z, t, [O_{2'}(D), t]⟩`, each conjugate `a t a⁻¹`
with `a ∈ O_{2'}(D)` belongs to `L ∩ Z`: it is `[a,t] t`. This proves that
`L` is generated by its distinguished involutions. The local embedding clause
of the simple reduction therefore gives strong embedding inside proper `L`.
Only after this proof do we identify all involutions of `L` with `L ∩ Z`.

These are preliminary reductions for Theorem 12.1, not its classification
argument. The proper-group analysis of Sections 12–15 remains separate.
Source: `refs/KGroup/GLS4/Chapter2.tex`, (12A), Theorem 12.1, and Lemma 12.2.
-/

noncomputable section
namespace BenderSuzuki.ZD
open Theory.GroupTheory PFAppendixIII PFchapter1section1
open scoped commutatorElement
universe u
variable {G : Type u} [Group G] [Finite G] {Z : Set G} {M : Subgroup G}

/-- Failure of strong embedding forces every nonbase two-point stabilizer
to have even order. No involution hypothesis on the translating element is needed. -/
public theorem residualPairStabilizer_even
    (h : IsProductDisconnected Z M)
    (ha : MulAction.IsMultiplyPretransitive G (G ⧸ M) 2)
    (hnot : ¬ IsStronglyEmbedded M) {t : G} (ht : t ∉ M) :
    Even (Nat.card (residualPairStabilizer M t)) := by
  apply Nat.not_odd_iff_even.mp
  intro hodd
  let alpha : G ⧸ M := QuotientGroup.mk 1
  have hmem : ∀ g : G, g ∈ M ↔ g • alpha = alpha := by
    intro g
    simpa only [show MulAction.stabilizer G alpha = M from baseCoset_stabilizer M] using
      (MulAction.mem_stabilizer_iff :
        g ∈ MulAction.stabilizer G alpha ↔ g • alpha = alpha)
  have hmove : ∀ g : G, g ∉ M → g⁻¹ • alpha ≠ alpha := by
    intro g hg heq
    exact hg ((hmem g).mpr (inv_smul_eq_iff.mp heq).symm)
  have hpos : 0 < Nat.card (G ⧸ M) - 1 := by
    have hne : Nat.card (G ⧸ M) ≠ 1 := by
      intro hc
      obtain ⟨hs, _⟩ := Nat.card_eq_one_iff_unique.mp hc
      exact hmove t ht (hs.allEq _ _)
    have : 0 < Nat.card (G ⧸ M) := Nat.card_pos
    omega
  have hcard : ∀ g : G, g ∉ M →
      Nat.card (M ⊓ rightConjugate M g : Subgroup G) =
        Nat.card (residualPairStabilizer M t) := by
    intro g hg
    have h1 := Converse.card_stabilizer_eq_twoPoint_mul ha (hmove g hg)
    have h2 := Converse.card_stabilizer_eq_twoPoint_mul ha (hmove t ht)
    have hstab : MulAction.stabilizer G alpha = M := baseCoset_stabilizer M
    rw [← rightConjugate_stabilizer, hstab] at h1 h2
    exact Nat.eq_of_mul_eq_mul_right hpos (h1.symm.trans h2)
  apply hnot
  refine ⟨h.proper, ?_, ?_⟩
  · obtain ⟨z, hz, hzM⟩ := h.nonempty
    exact ⟨z, hzM, h.involutions z hz⟩
  · intro g hg x hxM hxg
    exact not_isInvolution_of_mem_odd_subgroup (M ⊓ rightConjugate M g)
      ((hcard g hg).symm ▸ hodd) ⟨hxM, hxg⟩

omit [Finite G] in
/-- The concrete residual subgroup is generated by the distinguished
elements that it contains; no full involution-core replacement is assumed. -/
public theorem closure_Z_inter_residualGenerated (h : IsProductDisconnected Z M) {z t : G}
    (hz : z ∈ Z) (ht : t ∈ Z) :
    Subgroup.closure (Z ∩ (residualGenerated M z t : Set G)) =
      residualGenerated M z t := by
  let L := residualGenerated M z t
  let C := Subgroup.closure (Z ∩ (L : Set G))
  have hzL : z ∈ L :=
    (show Subgroup.zpowers z ≤ L from le_sup_left.trans le_sup_left) (Subgroup.mem_zpowers z)
  have htL : t ∈ L :=
    (show Subgroup.zpowers t ≤ L from le_sup_right.trans le_sup_left) (Subgroup.mem_zpowers t)
  have hzC : z ∈ C := Subgroup.subset_closure ⟨hz, hzL⟩
  have htC : t ∈ C := Subgroup.subset_closure ⟨ht, htL⟩
  apply le_antisymm ((Subgroup.closure_le L).mpr fun _ hx => hx.2)
  change L ≤ C
  apply sup_le (sup_le (Subgroup.zpowers_le.mpr hzC) (Subgroup.zpowers_le.mpr htC))
  apply Subgroup.commutator_le.mpr
  intro a ha b hb
  have hatL : MulAut.conj a t ∈ L := by
    have hc : ⁅a, t⁆ ∈ L := (show residualCommutator M t ≤ L from le_sup_right)
      (Subgroup.commutator_mem_commutator ha (Subgroup.mem_zpowers t))
    have heq : MulAut.conj a t = ⁅a, t⁆ * t := conj_eq_commutatorElement_mul
    rw [heq]
    exact L.mul_mem hc htL
  have hatC : MulAut.conj a t ∈ C := Subgroup.subset_closure ⟨h.invariant a t ht, hatL⟩
  obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.mp hb
  have hc : MulAut.conj a (t ^ n) ∈ C := by
    simpa only [map_zpow] using C.zpow_mem hatC n
  exact C.mul_mem hc (C.inv_mem (C.zpow_mem htC n))

omit [Finite G] in
/-- The internal form of distinguished generation, for the subgroup
occurring in the local embedding clause of `SimpleReduction`. -/
public theorem residualGenerated_localClosure_eq_top (h : IsProductDisconnected Z M) {z t : G}
    (hz : z ∈ Z) (ht : t ∈ Z) :
    Subgroup.closure ((residualGenerated M z t).subtype ⁻¹' Z) = ⊤ := by
  let L := residualGenerated M z t
  let C := Subgroup.closure (L.subtype ⁻¹' Z)
  have hle : L ≤ C.map L.subtype := by
    apply (closure_Z_inter_residualGenerated h hz ht).ge.trans
    apply (Subgroup.closure_le _).mpr
    intro x hx
    exact ⟨⟨x, hx.2⟩, Subgroup.subset_closure hx.1, rfl⟩
  apply top_unique
  intro x _
  obtain ⟨y, hy, heq⟩ := hle x.property
  exact (Subtype.ext heq : y = x) ▸ hy

private theorem stronglyEmbedded_of_top_comap {H : Type*} [Group H] [Finite H]
    (N : Subgroup H)
    (hs : IsStronglyEmbedded (N.comap (⊤ : Subgroup H).subtype)) :
    IsStronglyEmbedded N := by
  refine ⟨?_, ?_, ?_⟩
  · intro hn
    exact hs.1 (by rw [hn, Subgroup.comap_top])
  · obtain ⟨x, hx, hxi⟩ := hs.2.1
    exact ⟨x, hx, IsInvolution.map_of_injective hxi
      (⊤ : Subgroup H).subtype Subtype.val_injective⟩
  · intro g hg x hx hxg hxi
    let g' : (⊤ : Subgroup H) := ⟨g, Subgroup.mem_top _⟩
    let x' : (⊤ : Subgroup H) := ⟨x, Subgroup.mem_top _⟩
    have hxg' : x' ∈ rightConjugate (N.comap (⊤ : Subgroup H).subtype) g' := by
      rw [rightConjugate, Subgroup.conjBy, Subgroup.mem_map] at hxg ⊢
      obtain ⟨y, hy, heq⟩ := hxg
      exact ⟨⟨y, Subgroup.mem_top _⟩, hy, Subtype.ext heq⟩
    exact hs.2.2 (g := g') hg (x := x') hx hxg' (IsInvolution.subtype hxi _)

/-- The distinguished subgroup is strongly embedded in proper `L`.
The proof first establishes that the local distinguished closure is all of `L`. -/
public theorem stronglyEmbedded_in_proper_residualGenerated
    (h : IsProductDisconnected Z M) (r : SimpleReduction Z M)
    {z t : G} (hz : z ∈ Z) (hzM : z ∈ M) (ht : t ∈ Z) (htM : t ∉ M)
    (hL : residualGenerated M z t ≠ ⊤) :
    IsStronglyEmbedded (M.comap (residualGenerated M z t).subtype) := by
  have hzL : z ∈ residualGenerated M z t :=
    (show Subgroup.zpowers z ≤ residualGenerated M z t from
      le_sup_left.trans le_sup_left) (Subgroup.mem_zpowers z)
  have htL : t ∈ residualGenerated M z t :=
    (show Subgroup.zpowers t ≤ residualGenerated M z t from
      le_sup_right.trans le_sup_left) (Subgroup.mem_zpowers t)
  have hs := r.local_embedding (residualGenerated M z t) hL
    (fun hle => htM (hle htL)) ⟨z, hz, hzL, hzM⟩
  rw [residualGenerated_localClosure_eq_top h hz ht] at hs
  exact stronglyEmbedded_of_top_comap _ hs

/-- Inside proper `L`, all involutions belong to `Z`, by local strong
embedding and involution conjugacy. This assertion concerns `L`, not ambient `G`. -/
public theorem isInvolution_iff_mem_Z_in_proper_residualGenerated
    (h : IsProductDisconnected Z M) (r : SimpleReduction Z M)
    {z t : G} (hz : z ∈ Z) (hzM : z ∈ M) (ht : t ∈ Z) (htM : t ∉ M)
    (hL : residualGenerated M z t ≠ ⊤) {x : G}
    (hxL : x ∈ residualGenerated M z t) : IsInvolution x ↔ x ∈ Z := by
  constructor
  · intro hxi
    have hzL : z ∈ residualGenerated M z t :=
      (show Subgroup.zpowers z ≤ residualGenerated M z t from
        le_sup_left.trans le_sup_left) (Subgroup.mem_zpowers z)
    have hs := stronglyEmbedded_in_proper_residualGenerated h r hz hzM ht htM hL
    obtain ⟨g, hg⟩ := hs.involutions_conjugate
      (IsInvolution.subtype (h.involutions z hz) hzL) (IsInvolution.subtype hxi hxL)
    have hg' : MulAut.conj ((g : G)⁻¹) z = x := by
      simpa only [rightConjugateElem, MulAut.conj_apply, inv_inv,
        Subgroup.coe_mul, Subgroup.coe_inv] using congrArg Subtype.val hg
    exact hg' ▸ h.invariant ((g : G)⁻¹) z hz
  · exact h.involutions x

end BenderSuzuki.ZD
