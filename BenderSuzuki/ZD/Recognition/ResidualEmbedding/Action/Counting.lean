module

public import BenderSuzuki.ZD.Recognition.ResidualEmbedding.Action.Counting.Contracts
public import BenderSuzuki.ZD.Recognition.ResidualEmbedding.Action.Counting.Parameters
public import BenderSuzuki.ZD.Recognition.ResidualEmbedding.Action.Counting.Saturation
public import BenderSuzuki.ZD.Recognition.ResidualEmbedding.Action.Counting.SectionThree
public import BenderSuzuki.ZD.Recognition.ResidualEmbedding.Action.Counting.SectionFive

/-!
# Assembly of the distinguished action counts

The odd prime share is proved from the simple reduction. A second fixed point
allows Proposition 3.8(b) to bound a (6A) configuration. Conversely, Corollary
5.7 seeds yield (6A) configurations with the same involution and prime by taking
the subgroup generated by inverted elements.

Section 3 is proved from product disconnection, and Section 5 from the
minimal-counterexample and simple-reduction hypotheses. The final theorem
assembles these inputs and supplies the complete counting contract.

Source: GLS, Volume 4, Chapter 2, Proposition 3.8 and (6A)--(6B).
-/

namespace BenderSuzuki.ZD

open Theory.GroupTheory PFAppendixIII PFchapter1section1

universe u
variable {G : Type u} [Group G] [Finite G] {Z : Set G} {M : Subgroup G}

/-- Assemble the action counts from the explicit Section 3 and Section 5
source obligations. These premises must be discharged by final assembly. -/
public theorem actionCounting_of_sectionThree_and_sectionFive
    (h : IsProductDisconnected Z M) (hs : SimpleReduction Z M)
    (hthree : ActionSectionThree Z M) (htwo : ActionTheoremTwo Z M)
    (hseeds : ActionSaturationSeeds Z M) : ActionCounting Z M := by
  refine ⟨htwo, action_exists_odd_prime_share h hs, ?_, ?_, hthree.invariant_sylow⟩
  · intro d
    obtain ⟨beta, hbeta, hne⟩ := d.toTheorem4bSixA.exists_nonbase_fixedPoint
    have hWbeta : d.W ≤ MulAction.stabilizer G beta := by
      intro w hw
      exact MulAction.mem_stabilizer_iff.mpr (hbeta w hw)
    exact (hthree.base_bound d.z d.hzZ d.hzM d.p d.hp d.hpOdd beta hne
      d.W d.hWp (le_inf d.hWM hWbeta) d.hzNorm).1
  · intro z hzZ hzM p hp hpOdd hshare hnot
    obtain ⟨P, hPp, hPM, _hzNorm, hcard, heq⟩ := hseeds z hzZ hzM p hp hpOdd hnot
    have hsecond : ∃ beta : G ⧸ M,
        beta ∈ fixedPointsOfSubgroup G (G ⧸ M) P ∧ beta ≠ QuotientGroup.mk 1 := by
      classical
      by_contra hn
      push Not at hn
      have hone : Nat.card (theorem4bFixedPoints M P) = 1 := by
        apply Nat.card_eq_one_iff_exists.mpr
        refine ⟨⟨QuotientGroup.mk 1, theorem4b_baseCoset_mem_fixedPoints hPM⟩, ?_⟩
        intro beta
        exact Subtype.ext (hn beta.1 beta.2)
      omega
    obtain ⟨beta, hbeta, hne⟩ := hsecond
    have hPbeta : P ≤ MulAction.stabilizer G beta := by
      intro x hx
      exact MulAction.mem_stabilizer_iff.mpr (hbeta x hx)
    obtain ⟨d, hdz, hdp, _, hdcard⟩ := exists_actionCounterexample_of_pSubgroup
      h hzZ hzM hp hpOdd hPp (le_inf hPM hPbeta) hne (heq ▸ hshare)
    exact ⟨d, hdz, hdp, hdcard.trans heq⟩

/-- The distinguished counts with the Section 3 premises discharged. The
independent Section 5 Theorem 2 and seed inputs remain explicit. -/
public theorem actionCounting_of_sectionFive
    (h : IsProductDisconnected Z M) (hs : SimpleReduction Z M)
    (htwo : ActionTheoremTwo Z M) (hseeds : ActionSaturationSeeds Z M) :
    ActionCounting Z M :=
  actionCounting_of_sectionThree_and_sectionFive h hs
    (actionSectionThree_of_productDisconnected h) htwo hseeds

/-- The full distinguished counting input from the original minimality and
simple-reduction hypotheses, with Sections 3 and 5 discharged. -/
public theorem actionCounting_of_minimalCounterexample
    (h : MinimalCounterexample Z M) (r : SimpleReduction Z M) :
    ActionCounting Z M := by
  have h3 := actionSectionThree_of_minimalCounterexample h r
  obtain ⟨h2, hseeds⟩ := actionSectionFive_of_sectionThree h r h3
  exact actionCounting_of_sectionThree_and_sectionFive h.disconnected r h3 h2 hseeds

end BenderSuzuki.ZD
