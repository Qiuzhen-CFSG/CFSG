module

public import BenderSuzuki.ZD.Recognition.ResidualEmbedding.Action.Counting.SectionThree.Inputs
public import Glauberman.ZStar
public import Theory.GroupTheory.ZStar.OddCore

/-!
# The local odd-core consequence of point swapping

A distinguished involution interchanging two points is isolated in every
subgroup `W⟨t⟩`, where `W` fixes both points and is normalized by `t`.
Indeed a distinct commuting conjugate would have an involutory product
fixing a point. Product disconnection puts the centralizer of that product
in the point stabilizer, contradicting that `t` interchanges the points.
Glauberman's Z-star theorem then gives centrality modulo the odd core of
`W⟨t⟩`. Pulling that normal odd-order subgroup back to `W` puts the
commutator subgroup in the relative odd core of `W`.

No odd-order assumption on `W` or its two-point overgroup is used. The
invariant-Sylow assertions of Proposition 3.7(a,b), needed to construct
`SectionThreeLocal`, are separate remaining obligations.

Source: GLS, Volume 4, Chapter 2, Proposition 3.5 and the first paragraph of
the proof of Proposition 3.7, printed pp.29–30.
-/

namespace BenderSuzuki.ZD
open Theory.GroupTheory PFAppendixIII
open scoped Pointwise commutatorElement
variable {G : Type*} [Group G] [Finite G] {Z : Set G} {M : Subgroup G}

omit [Finite G] in
private theorem fixes_mk_iff (x b : G) :
    x • (QuotientGroup.mk b : G ⧸ M) = QuotientGroup.mk b ↔ b⁻¹ * x * b ∈ M := by
  rw [MulAction.Quotient.smul_mk, smul_eq_mul, QuotientGroup.eq]
  constructor
  · intro h
    simpa only [mul_inv_rev, inv_inv, mul_assoc] using M.inv_mem h
  · intro h
    simpa only [mul_inv_rev, inv_inv, mul_assoc] using M.inv_mem h

omit [Finite G] in
private theorem product_centralizer_fixes (h : IsProductDisconnected Z M)
    {s t : G} (hs : s ∈ Z) (ht : t ∈ Z) (hi : PFAppendixIII.IsInvolution (s * t))
    (beta : G ⧸ M) (hf : (s * t) • beta = beta) :
    Subgroup.centralizer ({s * t} : Set G) ≤ MulAction.stabilizer G beta := by
  induction beta using Quotient.inductionOn with
  | h b =>
    let e := MulAut.conj b⁻¹
    have him : PFAppendixIII.IsInvolution (e s * e t) := by
      rw [← map_mul]
      exact ⟨fun he => hi.ne_one (e.injective (he.trans e.map_one.symm)), by rw [← map_pow, hi.sq_eq_one, map_one]⟩
    have hm : e s * e t ∈ M := by
      rw [← map_mul]
      simpa [e, MulAut.conj_apply] using (fixes_mk_iff (s * t) b).mp hf
    intro x hx
    apply MulAction.mem_stabilizer_iff.mpr
    apply (fixes_mk_iff x b).mpr
    apply h.product_centralizer (e s) (h.invariant _ _ hs) (e t)
      (h.invariant _ _ ht) him hm
    apply Subgroup.mem_centralizer_singleton_iff.mpr
    simpa only [map_mul, e, MulAut.conj_apply, inv_inv] using congrArg e (Subgroup.mem_centralizer_singleton_iff.mp hx)

omit [Finite G] in
private theorem swapping_commuting_eq (h : IsProductDisconnected Z M)
    {s t : G} (hs : s ∈ Z) (ht : t ∈ Z) (hc : Commute s t)
    (beta : G ⧸ M) (hne : t • beta ≠ beta) (hf : (s * t) • beta = beta) : s = t := by
  by_contra he
  have hi : PFAppendixIII.IsInvolution (s * t) := by
    refine ⟨?_, ?_⟩
    · intro hh
      exact he (by simpa only [(h.involutions t ht).inv_eq_self] using eq_inv_of_mul_eq_one_left hh)
    · rw [hc.mul_pow, (h.involutions s hs).sq_eq_one, (h.involutions t ht).sq_eq_one, one_mul]
  apply hne
  apply MulAction.mem_stabilizer_iff.mp
  apply product_centralizer_fixes h hs ht hi beta hf
  exact Subgroup.mem_centralizer_singleton_iff.mpr (hc.symm.mul_right (Commute.refl t)).eq

/-- Z-star centrality for the subgroup generated by an invariant two-point
subgroup and the distinguished involution interchanging the points. -/
public theorem sectionThree_swapping_quotient_central (h : IsProductDisconnected Z M)
    {t : G} (ht : t ∈ Z) (beta : G ⧸ M) (hne : t • beta ≠ beta)
    (W : Subgroup G)
    (hW : W ≤ MulAction.stabilizer G beta ⊓ MulAction.stabilizer G (t • beta))
    (hn : t ∈ Subgroup.normalizer (W : Set G)) :
    let H := W ⊔ Subgroup.zpowers t
    let tH : H := ⟨t, (show Subgroup.zpowers t ≤ W ⊔ Subgroup.zpowers t from le_sup_right) (Subgroup.mem_zpowers t)⟩
    QuotientGroup.mk' (pPrimeCore 2 H) tH ∈ Subgroup.center (H ⧸ pPrimeCore 2 H) := by
  let H := W ⊔ Subgroup.zpowers t
  let tH : H := ⟨t, (show Subgroup.zpowers t ≤ W ⊔ Subgroup.zpowers t from le_sup_right) (Subgroup.mem_zpowers t)⟩
  have hi : PFAppendixIII.IsInvolution tH := ⟨fun he => (h.involutions t ht).ne_one (congrArg Subtype.val he),
    Subtype.ext (h.involutions t ht).sq_eq_one⟩
  have hiso : ∀ g : H, Commute (g * tH * g⁻¹) tH → g * tH * g⁻¹ = tH := by
    intro g hg
    have hprod : (g : G) ∈ (W : Set G) * (Subgroup.zpowers t : Set G) := by
      rw [← Subgroup.coe_mul_of_right_le_normalizer_left W (Subgroup.zpowers t)
        (Subgroup.zpowers_le.mpr hn)]
      exact g.property
    obtain ⟨w, hw, c, hc, hgc⟩ := hprod
    obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hc
    have he : (g : G) * t * (g : G)⁻¹ = w * t * w⁻¹ := by
      rw [← hgc, mul_inv_rev]
      calc
        _ = w * (t ^ k * t) * ((t ^ k)⁻¹ * w⁻¹) := by group
        _ = w * (t * t ^ k) * ((t ^ k)⁻¹ * w⁻¹) := by rw [((Commute.refl t).zpow_left k).eq]
        _ = _ := by group
    apply Subtype.ext
    change (g : G) * t * (g : G)⁻¹ = t
    apply swapping_commuting_eq h (h.invariant _ _ ht) ht
      (show Commute ((g : G) * t * (g : G)⁻¹) t from congrArg Subtype.val hg.eq) beta hne
    change (((g : G) * t * (g : G)⁻¹) * t) • beta = beta
    rw [he, mul_smul, mul_smul, mul_smul]
    have hwf := MulAction.mem_stabilizer_iff.mp (hW hw).1
    have hwf' := MulAction.mem_stabilizer_iff.mp (hW (W.inv_mem hw)).2
    rw [hwf', ← mul_smul t t, show t * t = 1 by simpa [pow_two] using (h.involutions t ht).sq_eq_one,
      one_smul, hwf]
  obtain ⟨S, htS, hc, hw⟩ := Glauberman.ZStar.isolated_involution_local_data tH
    (by simpa [pow_two] using hi.sq_eq_one) hi.ne_one (fun g hg => hiso g hg)
  exact Glauberman.ZStar.glauberman_zstar_local S tH hi htS hc hw

/-- The relative odd-core conclusion of GLS Proposition 3.5 used in 3.7. -/
public theorem sectionThree_swapping_core (h : IsProductDisconnected Z M)
    {t : G} (ht : t ∈ Z) (beta : G ⧸ M) (hne : t • beta ≠ beta)
    (W : Subgroup G)
    (hW : W ≤ MulAction.stabilizer G beta ⊓ MulAction.stabilizer G (t • beta))
    (hn : t ∈ Subgroup.normalizer (W : Set G)) :
    ⁅W, Subgroup.zpowers t⁆ ≤ (pPrimeCore 2 W).map W.subtype := by
  let H := W ⊔ Subgroup.zpowers t
  let i : W →* H := Subgroup.inclusion (show W ≤ H from le_sup_left)
  let N := pPrimeCore 2 H
  let K := N.comap i
  have hi : Function.Injective i := fun a b he => Subtype.ext (congrArg (fun x : H => (x : G)) he)
  have hK : K ≤ pPrimeCore 2 W := by
    apply le_sSup
    exact ⟨inferInstance, (pPrimeCore_coprime_card (p := 2) (G := H)).of_dvd_right
      (N.card_comap_dvd_of_injective i hi)⟩
  let tH : H := ⟨t, (show Subgroup.zpowers t ≤ H from le_sup_right) (Subgroup.mem_zpowers t)⟩
  have htC : QuotientGroup.mk' N tH ∈ Subgroup.center (H ⧸ N) :=
    sectionThree_swapping_quotient_central h ht beta hne W hW hn
  apply Subgroup.commutator_le.mpr
  intro w hw v hv
  have hnV : v ∈ Subgroup.normalizer (W : Set G) := (Subgroup.zpowers_le.mpr hn) hv
  have hcW : ⁅w, v⁆ ∈ W := by
    have hc := (Subgroup.mem_normalizer_iff.mp hnV w⁻¹).mp (W.inv_mem hw)
    simpa only [commutatorElement_def, mul_assoc] using W.mul_mem hw hc
  refine Subgroup.mem_map.mpr ⟨⟨⁅w, v⁆, hcW⟩, hK ?_, rfl⟩
  change i ⟨⁅w, v⁆, hcW⟩ ∈ N
  obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hv
  have he : i ⟨⁅w, t ^ k⁆, hcW⟩ = ⁅i ⟨w, hw⟩, tH ^ k⁆ := by
    apply Subtype.ext
    rfl
  rw [he]
  apply (QuotientGroup.eq_one_iff _).mp
  change QuotientGroup.mk' N ⁅i ⟨w, hw⟩, tH ^ k⁆ = 1
  rw [map_commutatorElement]
  apply commutatorElement_eq_one_iff_commute.mpr
  rw [map_zpow]
  exact (Subgroup.mem_center_iff.mp ((Subgroup.center (H ⧸ N)).zpow_mem htC k)
    (QuotientGroup.mk' N (i ⟨w, hw⟩)))
end BenderSuzuki.ZD
