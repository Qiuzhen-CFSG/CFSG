module

public import BenderSuzuki.ZD.Recognition.ResidualEmbedding.Action.Exclusion.ThetaChain.Gamma.Local
public import BenderSuzuki.SE.StrongEmbeddingConjugacy

/-!
# Local odd-core factorization for the centralizer extension

Put H = C_G(K)⟨z⟩ and L = H° = ⟨H ∩ Z⟩. Local strong embedding gives
one conjugacy class of involutions in L. Since C_G(K) is normal in H and
does not contain z, its intersection with L has odd order. Consequently
L = O_{2'}(L)⟨z⟩. Normality of L transports its odd core into O_{2'}(H),
and conjugacy in L gives H = C_H(z)L. Together these prove the operational
Z-star factorization H = O_{2'}(H)C_H(z).

Strong embedding is used only inside L; no rank restriction on H is needed.

Source: GLS, Volume 4, Chapter 2, Proposition 7.4, second centralizer branch.
-/

namespace BenderSuzuki.ZD
open Theory.GroupTheory PFAppendixIII PFchapter1section1

/-- A normal subgroup with one involution class supplies the factorization
when the ambient group is generated by a normal subgroup missing z and z. -/
private theorem factor_of_local_conjugacy
    {H : Type*} [Group H] [Finite H]
    (C L : Subgroup H) [C.Normal] [L.Normal]
    {z : H} (hz : IsInvolution z) (hzC : z ∉ C) (hzL : z ∈ L)
    (hgen : C ⊔ Subgroup.zpowers z = ⊤)
    (P : Subgroup L) (hP : IsStronglyEmbedded P) :
    pPrimeCore 2 H ⊔ Subgroup.centralizer ({z} : Set H) = ⊤ := by
  let zL : L := ⟨z, hzL⟩
  have hzLI : IsInvolution zL := IsInvolution.subtype hz hzL
  let D := C.comap L.subtype
  -- Every involution of L is conjugate to z, so none lies in the normal D.
  have hDodd : Odd (Nat.card D) := by
    apply Nat.not_even_iff_odd.mp
    intro heven
    let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
    obtain ⟨x, hx⟩ := exists_prime_orderOf_dvd_card' (G := D) 2 heven.two_dvd
    have hxI : IsInvolution (x : L) := by
      have hord : orderOf (x : L) = 2 := by rw [Subgroup.orderOf_coe, hx]
      exact ⟨(orderOf_eq_prime_iff.mp hord).2, (orderOf_eq_prime_iff.mp hord).1⟩
    obtain ⟨g, hg⟩ := hP.involutions_conjugate hxI hzLI
    have hzD : zL ∈ D := by
      rw [← hg]
      simpa only [rightConjugateElem, inv_inv] using
        (inferInstance : D.Normal).conj_mem x x.property g⁻¹
    exact hzC hzD
  have hDO : D ≤ pPrimeCore 2 L :=
    le_sSup ⟨inferInstance, Nat.coprime_two_left.mpr hDodd⟩
  -- Intersect H = C⟨z⟩ with L and absorb its odd normal factor into the core.
  have hLgen : pPrimeCore 2 L ⊔ Subgroup.zpowers zL = ⊤ := by
    apply top_unique
    intro x _
    have hx : (x : H) ∈ C ⊔ Subgroup.zpowers z := by rw [hgen]; trivial
    obtain ⟨c, hc, t, ht, hct⟩ := Subgroup.mem_sup_of_normal_left.mp hx
    have htL : t ∈ L := (Subgroup.zpowers_le.mpr hzL) ht
    have hcL : c ∈ L := by
      have heq : c = (x : H) * t⁻¹ := by rw [← hct]; group
      rw [heq]
      exact L.mul_mem x.property (L.inv_mem htL)
    have hcO : (⟨c, hcL⟩ : L) ∈ pPrimeCore 2 L := hDO hc
    have htZ : (⟨t, htL⟩ : L) ∈ Subgroup.zpowers zL := by
      obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp ht
      exact Subgroup.mem_zpowers_iff.mpr ⟨n, Subtype.ext hn⟩
    have hmul := (pPrimeCore 2 L ⊔ Subgroup.zpowers zL).mul_mem
      (Subgroup.mem_sup_left hcO) (Subgroup.mem_sup_right htZ)
    exact (show (⟨c, hcL⟩ : L) * ⟨t, htL⟩ = x from Subtype.ext hct) ▸ hmul
  let S := pPrimeCore 2 H ⊔ Subgroup.centralizer ({z} : Set H)
  have hLS : L ≤ S := by
    have hmap : (pPrimeCore 2 L ⊔ Subgroup.zpowers zL).map L.subtype ≤ S := by
      rw [Subgroup.map_sup, MonoidHom.map_zpowers]
      apply sup_le
      · exact (pPrimeCore_map_subtype_le_pPrimeCore_of_normal 2 L).trans le_sup_left
      · apply le_trans _ le_sup_right
        apply Subgroup.zpowers_le.mpr
        exact Subgroup.mem_centralizer_singleton_iff.mpr rfl
    simpa only [hLgen, ← MonoidHom.range_eq_map, Subgroup.range_subtype] using hmap
  -- Normality and involution conjugacy give the Frattini argument H = C_H(z)L.
  apply top_unique
  intro g _
  have hzgL : rightConjugateElem z g ∈ L := by
    simpa only [rightConjugateElem, inv_inv] using
      (inferInstance : L.Normal).conj_mem z hzL g⁻¹
  have hzgi : IsInvolution (⟨rightConjugateElem z g, hzgL⟩ : L) :=
    IsInvolution.subtype (isInvolution_rightConjugateElem hz) hzgL
  obtain ⟨l, hl⟩ := hP.involutions_conjugate hzLI hzgi
  have heq : (l : H)⁻¹ * z * (l : H) = g⁻¹ * z * g := congrArg Subtype.val hl
  have hc : g * (l : H)⁻¹ ∈ Subgroup.centralizer ({z} : Set H) := by
    apply Subgroup.mem_centralizer_singleton_iff.mpr
    calc
      (g * (l : H)⁻¹) * z = g * ((l : H)⁻¹ * z * (l : H)) * (l : H)⁻¹ := by group
      _ = g * (g⁻¹ * z * g) * (l : H)⁻¹ := by rw [heq]
      _ = z * (g * (l : H)⁻¹) := by group
  have hm := S.mul_mem (Subgroup.mem_sup_right hc) (hLS l.property)
  simpa only [inv_mul_cancel_right] using hm

/-- The operational local Z-star factorization in the second branch of
Proposition 7.4, using relative strong embedding in the distinguished closure. -/
public theorem actionGamma_local_factorization
    {G : Type*} [Group G] [Finite G] {Z : Set G} {M : Subgroup G}
    (h : MinimalCounterexample Z M) (r : SimpleReduction Z M)
    (d : ActionCounterexample Z M)
    (hCnot : ¬ Subgroup.centralizer d.toTheorem4bSixA.invertedSet ≤ M) :
    let H := Subgroup.centralizer d.toTheorem4bSixA.invertedSet ⊔ Subgroup.zpowers d.z
    let zH : H := ⟨d.z, (show Subgroup.zpowers d.z ≤ H from le_sup_right)
      (Subgroup.mem_zpowers d.z)⟩
    pPrimeCore 2 H ⊔ Subgroup.centralizer ({zH} : Set H) = ⊤ := by
  let C := Subgroup.centralizer d.toTheorem4bSixA.invertedSet
  let H := C ⊔ Subgroup.zpowers d.z
  have hzH : d.z ∈ H :=
    (show Subgroup.zpowers d.z ≤ H from le_sup_right) (Subgroup.mem_zpowers d.z)
  let zH : H := ⟨d.z, hzH⟩
  let CH := C.subgroupOf H
  let L := Subgroup.closure (H.subtype ⁻¹' Z)
  have hCeq : C = Subgroup.centralizer (d.W : Set G) := by
    rw [← d.toTheorem4bSixA.closure_invertedSet_eq, Subgroup.centralizer_closure]
  have hHN : H ≤ Subgroup.normalizer (d.W : Set G) := by
    apply sup_le
    · rw [hCeq]
      exact Subgroup.centralizer_le_normalizer _
    · exact Subgroup.zpowers_le.mpr d.hzNorm
  have hCN : (C.subgroupOf (Subgroup.normalizer (d.W : Set G))).Normal := by
    rw [hCeq]
    infer_instance
  let : CH.Normal := hCN.comap (Subgroup.inclusion hHN)
  have hHM : ¬ H ≤ M := fun hHM => hCnot (le_sup_left.trans hHM)
  let : L.Normal := (productDisconnected_subgroup h.disconnected H hHM
    ⟨d.z, d.hzZ, hzH, d.hzM⟩).closure_normal
  have hzL : zH ∈ L := Subgroup.subset_closure d.hzZ
  have hzC : zH ∉ CH := by
    intro hzC
    have hzCentW : d.z ∈ Subgroup.centralizer (d.W : Set G) := hCeq ▸ hzC
    have hWleCent : d.W ≤ Subgroup.centralizer (Subgroup.zpowers d.z : Set G) := by
      rw [Subgroup.zpowers_eq_closure, Subgroup.centralizer_closure]
      intro w hw
      exact Subgroup.mem_centralizer_singleton_iff.mpr
        (Subgroup.mem_centralizer_iff.mp hzCentW w hw)
    have hbot : ⁅d.W, Subgroup.zpowers d.z⁆ = ⊥ :=
      Subgroup.commutator_eq_bot_iff_le_centralizer.mpr hWleCent
    exact d.hWne (d.hcomm.symm.trans hbot)
  have hgen : CH ⊔ Subgroup.zpowers zH = ⊤ := by
    apply Subgroup.map_injective H.subtype_injective
    rw [Subgroup.map_sup, Subgroup.map_subgroupOf_eq_of_le
      (show C ≤ H from le_sup_left), MonoidHom.map_zpowers,
      ← MonoidHom.range_eq_map, Subgroup.range_subtype]
    rfl
  exact factor_of_local_conjugacy CH L (IsInvolution.subtype d.hz hzH) hzC hzL hgen
    ((M.comap H.subtype).comap L.subtype)
    (actionGamma_centralizer_extension_local_embedding h.disconnected r d hCnot)

end BenderSuzuki.ZD
