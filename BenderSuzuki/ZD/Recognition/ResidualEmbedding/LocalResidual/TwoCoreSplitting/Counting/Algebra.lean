module

public import BenderSuzuki.ZD.Recognition.ResidualEmbedding.LocalResidual.TwoCoreSplitting.Reduction
public import BenderSuzuki.Converse.Lift
public import BenderSuzuki.ZD.Recognition.MinimalReduction.LocalEmbedding.FourObstruction

/-!
# Algebraic consequences of the Section 17 local configuration

The internal index of the two-point stabilizer is the coset degree minus one,
by double transitivity. For the inverter consequence of GLS, Volume 4,
Chapter 2, Lemma 17.2(c,d), choose an element y of the odd subgroup D₀
which does not commute with t. Its displacement t y t⁻¹ y⁻¹ is nonidentity
and inverted by t. Since D₀ centralizes tu, it is also inverted by u.

`TwoCoreLocalData` records the remaining geometric existence obligation.
Its subgroup D₀ is the actual intersection D ∩ C_G(tu)°, with the circle
generated by distinguished involutions. No model or counting conclusion
is built into this interface, and its existence is not asserted here.
-/

noncomputable section

namespace BenderSuzuki.ZD
open Theory.GroupTheory PFAppendixIII PFchapter1section1
variable {G : Type*} [Group G] [Finite G] {Z : Set G} {M : Subgroup G}

/-- The index inside M, not the ambient index of D in G. -/
public theorem residualPairIn_index_eq_degree_sub_one (ha : ResidualAction Z M) {t : G} (ht : t ∉ M) :
    (residualPairIn M t).index = Nat.card (G ⧸ M) - 1 := by
  let a : G ⧸ M := QuotientGroup.mk 1
  have hM : MulAction.stabilizer G a = M := MulAction.stabilizer_quotient M
  have hne : t⁻¹ • a ≠ a := by
    intro heq
    apply ht
    rw [← hM]
    exact (inv_smul_eq_iff.mp heq).symm
  have hc := Converse.card_stabilizer_eq_twoPoint_mul ha.two_transitive hne
  rw [← rightConjugate_stabilizer, hM] at hc
  have hD : Nat.card (residualPairIn M t) =
      Nat.card (residualPairStabilizer M t) :=
    Nat.card_congr (residualPairInEquiv M t).toEquiv
  apply Nat.eq_of_mul_eq_mul_left (Nat.card_pos (α := residualPairIn M t))
  calc
    Nat.card (residualPairIn M t) * (residualPairIn M t).index = Nat.card M :=
      (residualPairIn M t).card_mul_index
    _ = Nat.card (residualPairIn M t) * (Nat.card (G ⧸ M) - 1) := by
      rw [hD]
      exact hc

omit [Finite G] in
/-- The explicit odd-order inverter extracted from a noncentral odd subgroup
of C_G(tu) normalized by t. Only t needs to be an involution for this step. -/
public theorem exists_odd_inverted_of_twisted_centralizer {t u : G} (ht : IsInvolution t)
    (D₀ : Subgroup G) (hM : D₀ ≤ M) (hodd : Odd (Nat.card D₀))
    (hnorm : t ∈ Subgroup.normalizer (D₀ : Set G))
    (hcent : D₀ ≤ Subgroup.centralizer ({t * u} : Set G))
    (hnoncent : ¬ D₀ ≤ Subgroup.centralizer ({t} : Set G)) :
    ∃ x : M, Odd (orderOf x) ∧ x ≠ 1 ∧ u * (x : G) * u⁻¹ = (x : G)⁻¹ := by
  classical
  obtain ⟨y, hy, hyt⟩ := SetLike.not_le_iff_exists.mp hnoncent
  let x := t * y * t⁻¹ * y⁻¹
  have hx : x ∈ D₀ := D₀.mul_mem ((Subgroup.mem_normalizer_iff.mp hnorm y).mp hy)
    (D₀.inv_mem hy)
  have hxi : t * x * t⁻¹ = x⁻¹ := by
    dsimp [x]
    rw [ht.inv_eq_self]
    have htt : t * t = 1 := by simpa [pow_two] using ht.sq_eq_one
    simp only [mul_inv_rev, ht.inv_eq_self]
    calc
      t * (t * y * t * y⁻¹) * t = (t * t) * y * t * y⁻¹ * t := by group
      _ = y⁻¹⁻¹ * (t * (y⁻¹ * t)) := by rw [htt]; group
  have hxne : x ≠ 1 := by
    intro he
    apply hyt
    apply Subgroup.mem_centralizer_singleton_iff.mpr
    have hconj : t * y * t⁻¹ = y := mul_inv_eq_one.mp he
    exact (mul_inv_eq_iff_eq_mul.mp hconj).symm
  have hxu : u * x * u⁻¹ = x⁻¹ := by
    have hcomm : (t * u) * x = x * (t * u) :=
      (Subgroup.mem_centralizer_singleton_iff.mp (hcent hx)).symm
    have hconj : (t * u) * x * (t * u)⁻¹ = x := by rw [hcomm]; group
    have he : u * x * u⁻¹ = t⁻¹ * x * t := by
      calc
        u * x * u⁻¹ = t⁻¹ * ((t * u) * x * (t * u)⁻¹) * t := by group
        _ = t⁻¹ * x * t := by rw [hconj]
    simpa only [ht.inv_eq_self] using he.trans (by simpa only [ht.inv_eq_self] using hxi)
  refine ⟨⟨x, hM hx⟩, ?_, ?_, hxu⟩
  · have ho : Odd (orderOf (⟨x, hx⟩ : D₀)) :=
      Odd.of_dvd_nat hodd (orderOf_dvd_natCard _)
    simpa only [Subgroup.orderOf_mk] using ho
  · intro he
    exact hxne (congrArg Subtype.val he)
/-- The geometric input from Section 16 and Lemma 17.2(c,d). Existence must
be established from the original residual hypotheses. -/
public structure TwoCoreLocalData (Z : Set G) (M : Subgroup G) where
  t : G
  t_mem : t ∈ Z
  t_not_mem : t ∉ M
  u : residualPairIn M t
  u_order : orderOf u = 2
  commutes_t : Commute ((u : M) : G) t
  z : M
  z_mem : (z : G) ∈ Z
  commutes_z : Commute ((u : M) : G) (z : G)
  odd_twisted_pair : Odd (Nat.card (residualPairStabilizer M t ⊓
    centralizerClosure Z (t * ((u : M) : G)) : Subgroup G))
  normalizes_twisted_pair : t ∈ Subgroup.normalizer
    ((residualPairStabilizer M t ⊓
      centralizerClosure Z (t * ((u : M) : G)) : Subgroup G) : Set G)
  noncentral_twisted_pair : ¬ (residualPairStabilizer M t ⊓
    centralizerClosure Z (t * ((u : M) : G)) : Subgroup G) ≤
      Subgroup.centralizer ({t} : Set G)

omit [Finite G] in
/-- The final inverter required by Proposition 17.6, from the local geometry.
The element is constructed in D₀ and then regarded as an element of M. -/
public theorem TwoCoreLocalData.exists_odd_inverted
    (h : IsProductDisconnected Z M) (d : TwoCoreLocalData Z M) :
    ∃ x : M, Odd (orderOf x) ∧ x ≠ 1 ∧
      (d.u : M) * x * (d.u : M)⁻¹ = x⁻¹ := by
  obtain ⟨x, hodd, hne, hinv⟩ := exists_odd_inverted_of_twisted_centralizer
    (h.involutions d.t d.t_mem)
    (residualPairStabilizer M d.t ⊓
      centralizerClosure Z (d.t * ((d.u : M) : G)))
    (inf_le_left.trans inf_le_left) d.odd_twisted_pair d.normalizes_twisted_pair
    (inf_le_right.trans (centralizerClosure_le _ _)) d.noncentral_twisted_pair
  exact ⟨x, hodd, hne, Subtype.ext hinv⟩

end BenderSuzuki.ZD
