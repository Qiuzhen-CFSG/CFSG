module

public import BenderSuzuki.ZD.Recognition.ResidualEmbedding.LocalResidual.NormalComplements.NativeSourceRankOne
public import BenderSuzuki.ZD.Recognition.ResidualEmbedding.LocalResidual.NormalComplements.RankOne.CoprimeGeneration

/-!
# Literal marked roots in the Section 16 centralizers

The model two-point subgroup is transported through the actual local-circle
inclusion. Its commutator with the distinguished swapping involution lies
in the subgroup generated by the distinguished trace in M and that involution.
This is the containment from Lemma 16.2 used by the four-centralizer generation
argument in Lemma 16.4 and Proposition 16.5.

Source: GLS IV, Chapter 2, Lemmas 16.2 and 16.4(a).
-/

noncomputable section
namespace BenderSuzuki.ZD
open Theory.GroupTheory PFAppendixIII PFchapter1section1 Subgroup
open RankOneModelGeometry
open scoped Pointwise
variable {G : Type*} [Group G] [Finite G] {Z : Set G} {M : Subgroup G}

omit [Finite G] in
private theorem twoPoint_comap {C : Type*} [Group C] (f : C →* G)
    (M : Subgroup G) (t : C) :
    twoPoint (M.comap f) t = (residualPairStabilizer M (f t)).comap f := by
  ext x
  simp only [twoPoint, residualPairStabilizer, mem_inf, mem_comap]
  apply and_congr_right
  intro _
  change x ∈ (M.comap f).map (MulAut.conj t⁻¹).toMonoidHom ↔
    f x ∈ M.map (MulAut.conj (f t)⁻¹).toMonoidHom
  rw [map_equiv_eq_comap_symm', map_equiv_eq_comap_symm']
  change f ((MulAut.conj t⁻¹).symm x) ∈ M ↔
    (MulAut.conj (f t)⁻¹).symm (f x) ∈ M
  rw [MulAut.conj_symm_apply, MulAut.conj_symm_apply, inv_inv, inv_inv,
    map_mul, map_mul, map_inv]

omit [Finite G] in
private theorem localCircleHom_range (Z : Set G) (F : Subgroup G) :
    (localCircleHom Z F).range = localCircleIn Z F := by
  rw [localCircleHom, MonoidHom.range_comp, (localCircle Z F).range_subtype]
  rfl

/-- The literal intersection D∩F° is cyclic, and its t-commutator belongs
to the root generated by the original distinguished trace. Nonsolvability
is the preceding Lemma 16.3 input. -/
public theorem source16_localCircle_pair_commutator_le_root
    (h : MinimalCounterexample Z M) (r : SimpleReduction Z M) (ha : ResidualAction Z M)
    (F : Subgroup G) (hF : F ≠ ⊤) {z t : G}
    (hz : z ∈ Z) (hzF : z ∈ F) (hzM : z ∈ M)
    (ht : t ∈ Z) (htF : t ∈ F) (htM : t ∉ M)
    (hns : ¬ Group.IsSolvable (localCircle Z F)) :
    IsCyclic (residualPairStabilizer M t ⊓ localCircleIn Z F : Subgroup G) ∧
      ⁅residualPairStabilizer M t ⊓ localCircleIn Z F, zpowers t⁆ ≤
        localCircleIn Z (F ⊓ M) ⊔ zpowers t := by
  let C := localCircle Z F
  let f := localCircleHom Z F
  have hFM : ¬ F ≤ M := fun hh => htM (hh htF)
  have hne : ∃ z ∈ Z, z ∈ F ∧ z ∈ M := ⟨z,hz,hzF,hzM⟩
  obtain ⟨hc,hperfect,hm,_⟩ := localCircle_nonsolvable_structure h r ha F hF hFM hne hns
  obtain ⟨n,hn,hmodel⟩ := hm.exists_exponent
  have hodd : Odd (Nat.card (center C)) := by
    rw [← hc]
    exact Nat.coprime_two_left.mp (pPrimeCore_coprime_card (p := 2))
  obtain ⟨P,hP,hmark⟩ := localCircle_exists_marked_sylow h r ha F hF hFM hne hns
  let zC : C := ⟨⟨z,hzF⟩,subset_closure hz⟩
  let tC : C := ⟨⟨t,htF⟩,subset_closure ht⟩
  have hzC : PFAppendixIII.IsInvolution zC :=
    IsInvolution.subtype (IsInvolution.subtype (h.disconnected.involutions z hz) hzF) _
  have htC : PFAppendixIII.IsInvolution tC :=
    IsInvolution.subtype (IsInvolution.subtype (h.disconnected.involutions t ht) htF) _
  have htB : tC ∉ normalizer (P : Set C) := by
    rw [← hP]
    exact htM
  have hgeom := oddCentralCover_pair_geometry hn hperfect hodd hmodel P zC tC
    (hmark zC hz hzM) hzC htC htB
  let D := twoPoint (normalizer (P : Set C)) tC
  have hmap : D.map f = residualPairStabilizer M t ⊓ localCircleIn Z F := by
    dsimp only [D]
    rw [← hP, twoPoint_comap, map_comap_eq, localCircleHom_range]
    exact inf_comm _ _
  have hroot := localCircle_rootGenerated_map_eq h r F hF hFM hne P hP hmark ht htF
  refine ⟨?_, ?_⟩
  · let : IsCyclic D := hgeom.1
    rw [← hmap]
    exact isCyclic_of_surjective (f.subgroupMap D) (f.subgroupMap_surjective D)
  · have hh := Subgroup.map_mono (f := f) hgeom.2.2.2.2.2.2
    rw [Subgroup.map_commutator, MonoidHom.map_zpowers, hmap, hroot] at hh
    exact hh

omit [Finite G] in
/-- The local trace is literally the defining set for the marked root in M. -/
public theorem source16_local_trace_circle {u : G} :
    localCircleIn Z (centralizer ({u} : Set G) ⊓ M) =
      closure (residualCentralizerTrace Z M u) := by
  rw [localCircleIn_eq_closure]
  congr 1
  ext x
  simp only [Set.mem_inter_iff, SetLike.mem_coe, mem_inf,
    mem_centralizer_singleton_iff, residualCentralizerTrace, Set.mem_ofPred_eq]
  constructor
  · rintro ⟨hxZ,hxu,hxM⟩
    exact ⟨hxZ,hxM,hxu⟩
  · rintro ⟨hxZ,hxM,hxu⟩
    exact ⟨hxZ,hxu,hxM⟩

omit [Finite G] in
/-- Distinguished circles are normalized by their actual local overgroup. -/
public theorem source16_localCircleIn_normalizer (h : IsProductDisconnected Z M)
    (F : Subgroup G) : F ≤ normalizer (localCircleIn Z F : Set G) := by
  rw [localCircleIn_eq_closure]
  apply le_normalizer_closure_iff.mpr
  intro g hg x hx
  exact subset_closure ⟨h.invariant g x hx.1,
    F.mul_mem (F.mul_mem hg hx.2) (F.inv_mem hg)⟩

/-- Each fixed-centralizer commutator in 16.1 belongs to the literal root
of the corresponding nonsolvable circle. Both the first containment in the
circle and the repeated commutator identity are derived here. -/
public theorem source16_fixed_commutator_le_trace_root
    (h : MinimalCounterexample Z M) (r : SimpleReduction Z M) (ha : ResidualAction Z M)
    {z t w : G} (hz : z ∈ Z) (hzM : z ∈ M)
    (ht : t ∈ Z) (htM : t ∉ M) (hw : PFAppendixIII.IsInvolution w)
    (hzw : Commute z w) (htw : Commute t w)
    (hns : ¬ Group.IsSolvable (localCircle Z (centralizer ({w} : Set G)))) :
    ⁅residualCommutator M t ⊓ centralizer ({w} : Set G), zpowers t⁆ ≤
      closure (residualCentralizerTrace Z M w) ⊔ zpowers t := by
  let F := centralizer ({w} : Set G)
  let L := localCircleIn Z F
  let A := residualCommutator M t ⊓ F
  have htF : t ∈ F := mem_centralizer_singleton_iff.mpr htw.eq
  have htL : t ∈ L := by
    change t ∈ localCircleIn Z F
    rw [localCircleIn_eq_closure]
    exact subset_closure ⟨ht,htF⟩
  have hAL : A ≤ normalizer (L : Set G) :=
    inf_le_right.trans (source16_localCircleIn_normalizer h.disconnected F)
  have hcommL : ⁅A,zpowers t⁆ ≤ L :=
    (commutator_mono le_rfl (zpowers_le.mpr htL)).trans
      (le_normalizer_iff_commutator_le_right.mp hAL)
  have hcommD : ⁅A,zpowers t⁆ ≤ residualPairStabilizer M t := by
    apply le_trans (commutator_mono (inf_le_left.trans
      ((residualCommutator_le_oddCore (h.disconnected.involutions t ht)).trans
        residualOddCore_le_pair)) le_rfl)
    exact le_normalizer_iff_commutator_le_left.mp
      (zpowers_le.mpr (involution_mem_normalizer_residualPairStabilizer
        (h.disconnected.involutions t ht)))
  have hh := (source16_localCircle_pair_commutator_le_root h r ha F
    (r.involution_centralizer_ne_top h.disconnected hw) hz
    (mem_centralizer_singleton_iff.mpr hzw.eq) hzM ht htF htM hns).2
  rw [source16_local_trace_circle] at hh
  rw [← residualFixedCommutator_idempotent (h.disconnected.involutions t ht) htw.symm]
  exact (commutator_mono (le_inf hcommD hcommL) le_rfl).trans hh

end BenderSuzuki.ZD
