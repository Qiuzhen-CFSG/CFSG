module

public import BenderSuzuki.ZD.Recognition.ResidualEmbedding.LocalResidual.NormalComplements.NativeSourceRankOne.Models
public import Theory.GroupTheory.SylowNormalizerCentralQuotient

/-!
# The source Borel inside the distinguished circle

The Borel recognized in the central quotient lifts to the normalizer of an
actual Sylow subgroup of the original distinguished circle. Its odd central
kernel lies in the source intersection with M. This identifies that literal
intersection with the Sylow normalizer and puts every marked distinguished
involution in the chosen Sylow subgroup.

Source: GLS4, Chapter 2, proof of Lemma 16.2, using Corollary 7.13 and
Chapter 4, Lemma 3.2(h).
-/

noncomputable section
namespace BenderSuzuki.ZD
open Theory.GroupTheory PFAppendixIII PFchapter1section1 Subgroup
open RankOneModelGeometry
variable {G : Type*} [Group G] [Finite G] {Z : Set G} {M : Subgroup G}

/-- The source intersection M∩F° is the actual Sylow normalizer in F°,
not just a Borel image after quotienting by the center. -/
public theorem localCircle_exists_marked_sylow
    (h : MinimalCounterexample Z M) (r : SimpleReduction Z M) (ha : ResidualAction Z M)
    (F : Subgroup G) (hF : F ≠ ⊤) (hFM : ¬ F ≤ M)
    (hne : ∃ z ∈ Z, z ∈ F ∧ z ∈ M)
    (hns : ¬ Group.IsSolvable (localCircle Z F)) :
    ∃ P : Sylow 2 (localCircle Z F),
      M.comap (localCircleHom Z F) = normalizer (P : Set (localCircle Z F)) ∧
      ∀ z : localCircle Z F, localCircleHom Z F z ∈ Z →
        localCircleHom Z F z ∈ M → z ∈ P := by
  let C := localCircle Z F
  let Y := M.comap (localCircleHom Z F)
  let q := QuotientGroup.mk' (center C)
  obtain ⟨hc,_,_,hb⟩ := localCircle_nonsolvable_structure h r ha F hF hFM hne hns
  obtain ⟨_,S,hS⟩ := hb
  obtain ⟨P,hP⟩ := Sylow.mapSurjective_surjective (QuotientGroup.mk'_surjective (center C)) 2 S
  have hcent : center C ≤ Y := hc ▸ localCircle_oddCore_le h.disconnected r F hF hFM hne hns
  have hY : Y = normalizer (P : Set C) := by
    calc
      Y = (Y.map q).comap q := (comap_map_eq_self (by simpa only [q, QuotientGroup.ker_mk'] using hcent)).symm
      _ = (normalizer (S : Set (C ⧸ center C))).comap q := congrArg (comap q) hS
      _ = normalizer (P : Set C) := by
        rw [← hP]
        exact P.normalizer_comap_quotient_center
  refine ⟨P,hY,?_⟩
  intro z hz hzM
  have hzi : PFAppendixIII.IsInvolution z := by
    refine ⟨?_,?_⟩
    · intro he
      exact (h.disconnected.involutions _ hz).ne_one (by rw [he,map_one])
    · apply localCircleHom_injective Z F
      rw [map_pow,(h.disconnected.involutions _ hz).sq_eq_one,map_one]
  have hzN : z ∈ normalizer (P : Set C) := hY ▸ hzM
  have hp : IsPGroup 2 (zpowers z) := isPGroup_zpowers_of_involution hzi
  have hzint : z ∈ zpowers z ⊓ normalizer (P : Set C) := ⟨mem_zpowers z,hzN⟩
  rw [hp.inf_normalizer_sylow P] at hzint
  exact hzint.2


/-- The omega subgroup of the selected Sylow is exactly the original
marked distinguished circle of F∩M, through the literal circle map. -/
public theorem localCircle_omega_map_eq
    (h : MinimalCounterexample Z M) (r : SimpleReduction Z M)
    (F : Subgroup G) (hF : F ≠ ⊤) (hFM : ¬ F ≤ M)
    (hne : ∃ z ∈ Z, z ∈ F ∧ z ∈ M)
    (P : Sylow 2 (localCircle Z F))
    (hP : M.comap (localCircleHom Z F) = normalizer (P : Set (localCircle Z F)))
    (hmark : ∀ z : localCircle Z F, localCircleHom Z F z ∈ Z →
      localCircleHom Z F z ∈ M → z ∈ P) :
    (omegaOneAmbient (P : Subgroup (localCircle Z F))).map (localCircleHom Z F) =
      localCircleIn Z (F ⊓ M) := by
  apply le_antisymm
  · rw [map_le_iff_le_comap]
    apply (omegaOneAmbient_le_iff _ _).mpr
    intro x hx hx2
    by_cases hx1 : x = 1
    · rw [hx1]
      exact one_mem _
    have hxZ := localCircle_involution_mem h.disconnected r F hF hFM hne ⟨hx1,hx2⟩
    have hxM : localCircleHom Z F x ∈ M := by
      change x ∈ M.comap (localCircleHom Z F)
      rw [hP]
      exact (P : Subgroup (localCircle Z F)).le_normalizer hx
    rw [localCircleIn_eq_closure]
    exact subset_closure ⟨hxZ,(x : F).property,hxM⟩
  · rw [localCircleIn_eq_closure]
    apply (closure_le _).mpr
    rintro z ⟨hz,hzF,hzM⟩
    let zC : localCircle Z F := ⟨⟨z,hzF⟩,subset_closure hz⟩
    have hzP : zC ∈ P := hmark zC hz hzM
    refine ⟨zC,?_,rfl⟩
    apply (omegaOneAmbient_le_iff _ _).mp le_rfl zC hzP
    apply Subtype.ext
    apply Subtype.ext
    exact (h.disconnected.involutions z hz).sq_eq_one

/-- The source subgroup generated by (F∩M)° and t is the image of the
literal model root-generated subgroup of F°. -/
public theorem localCircle_rootGenerated_map_eq
    (h : MinimalCounterexample Z M) (r : SimpleReduction Z M)
    (F : Subgroup G) (hF : F ≠ ⊤) (hFM : ¬ F ≤ M)
    (hne : ∃ z ∈ Z, z ∈ F ∧ z ∈ M)
    (P : Sylow 2 (localCircle Z F))
    (hP : M.comap (localCircleHom Z F) = normalizer (P : Set (localCircle Z F)))
    (hmark : ∀ z : localCircle Z F, localCircleHom Z F z ∈ Z →
      localCircleHom Z F z ∈ M → z ∈ P)
    {t : G} (ht : t ∈ Z) (htF : t ∈ F) :
    let tC : localCircle Z F := ⟨⟨t,htF⟩,subset_closure ht⟩
    (rootGenerated (P : Subgroup (localCircle Z F)) tC).map (localCircleHom Z F) =
      localCircleIn Z (F ⊓ M) ⊔ zpowers t := by
  dsimp only
  rw [rootGenerated,Subgroup.map_sup,MonoidHom.map_zpowers,
    localCircle_omega_map_eq h r F hF hFM hne P hP hmark]
  rfl

end BenderSuzuki.ZD
