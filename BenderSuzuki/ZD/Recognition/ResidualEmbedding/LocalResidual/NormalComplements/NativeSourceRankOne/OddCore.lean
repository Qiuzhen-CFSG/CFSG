module

public import BenderSuzuki.ZD.Recognition.ResidualEmbedding.LocalResidual.NormalComplements.NativeSourceRankOne.Sylow
public import Theory.GroupTheory.InvolutionCentralizerLifting
public import Glauberman.ZStar

/-!
# The odd-core supplement in a solvable centralizer-circle branch

A solvable distinguished circle has a singleton trace. Its distinguished
involution is therefore weakly closed in the actual Sylow subgroup of the
whole centralizer. Z-star makes it central modulo the centralizer's odd
core. Coprime lifting supplies the odd-core supplement of C_M(u), as needed
in the rank-one branch of Lemma 16.3.

Source: GLS4, Chapter 2, Lemma 16.3, first two paragraphs.
-/

noncomputable section
namespace BenderSuzuki.ZD
open Theory.GroupTheory PFAppendixIII PFchapter1section1 Subgroup
variable {G : Type*} [Group G] [Finite G] {Z : Set G} {M : Subgroup G}

/-- In the solvable circle branch the full centralizer is generated by its
actual odd core and its intersection with M. -/
public theorem involutionCentralizer_le_oddCore_sup_intersection
    (h : IsProductDisconnected Z M) (r : SimpleReduction Z M) (ha : ResidualAction Z M)
    {u : G} (hu : PFAppendixIII.IsInvolution u) (huM : u ∈ M)
    (hC : ¬ centralizer ({u} : Set G) ≤ M)
    (hsol : Group.IsSolvable (localCircle Z (centralizer ({u} : Set G)))) :
    let B := centralizer ({u} : Set G)
    B ≤ (pPrimeCore 2 B).map B.subtype ⊔ (B ⊓ M) := by
  let B := centralizer ({u} : Set G)
  change B ≤ (pPrimeCore 2 B).map B.subtype ⊔ (B ⊓ M)
  let H := B ⊓ M
  let S : Sylow 2 H := default
  let T := (S : Subgroup H).map H.subtype
  obtain ⟨_,z,hz,hzT,hTc,Q,hQ⟩ := involutionCentralizer_sylow_and_marked_center h r hu huM S
  have hTH : T ≤ H := map_subtype_le _
  have hzB : z ∈ B := (hTH hzT).1
  have hzM : z ∈ M := (hTH hzT).2
  let zB : B := ⟨z,hzB⟩
  have hzQ : zB ∈ Q := by
    obtain ⟨y,hy,he⟩ := hQ.symm ▸ hzT
    have he' : y = zB := Subtype.ext he
    exact he' ▸ hy
  have hzI : PFAppendixIII.IsInvolution zB := _root_.BenderSuzuki.IsInvolution.subtype (h.involutions z hz) hzB
  have htrace := residualCentralizerTrace_ncard_eq_one_of_solvable h r ha hu huM hC hsol
  obtain ⟨z₀,hz₀⟩ := Set.ncard_eq_one.mp htrace
  have hzz : z = z₀ := by
    have hm : z ∈ residualCentralizerTrace Z M u :=
      ⟨hz,hzM,mem_centralizer_singleton_iff.mp hzB⟩
    simpa only [hz₀,Set.mem_singleton_iff] using hm
  have hzstar : QuotientGroup.mk' (pPrimeCore 2 B) zB ∈ center (B ⧸ pPrimeCore 2 B) := by
    apply Glauberman.ZStar.glauberman_zstar_local Q zB hzI hzQ
    · intro x hx
      apply Subtype.ext
      exact mem_centralizer_singleton_iff.mp (hTc (hQ ▸ mem_map_of_mem B.subtype hx))
    · refine ⟨hzQ,?_⟩
      intro g hg
      apply Subtype.ext
      have hm := hTH (hQ ▸ mem_map_of_mem B.subtype hg)
      have hzin : (g : G) * z * (g : G)⁻¹ ∈ residualCentralizerTrace Z M u :=
        ⟨h.invariant _ _ hz,hm.2,mem_centralizer_singleton_iff.mp hm.1⟩
      have he : (g : G) * z * (g : G)⁻¹ = z₀ := by
        simpa only [hz₀,Set.mem_singleton_iff] using hzin
      exact he.trans hzz.symm
  have hfactor := oddCore_sup_involution_centralizer hzI hzstar
  intro x hx
  have hxjoin : (⟨x,hx⟩ : B) ∈ pPrimeCore 2 B ⊔ centralizer ({zB} : Set B) :=
    hfactor.symm ▸ mem_top _
  have hle : (pPrimeCore 2 B ⊔ centralizer ({zB} : Set B)).map B.subtype ≤
      (pPrimeCore 2 B).map B.subtype ⊔ H := by
    rw [Subgroup.map_sup]
    refine sup_le le_sup_left (le_trans ?_ le_sup_right)
    rintro y ⟨w,hw,rfl⟩
    refine ⟨w.property, h.centralizer_le hz hzM (mem_centralizer_singleton_iff.mpr ?_)⟩
    exact congrArg Subtype.val (mem_centralizer_singleton_iff.mp hw)
  exact hle (mem_map_of_mem B.subtype hxjoin)

end BenderSuzuki.ZD
