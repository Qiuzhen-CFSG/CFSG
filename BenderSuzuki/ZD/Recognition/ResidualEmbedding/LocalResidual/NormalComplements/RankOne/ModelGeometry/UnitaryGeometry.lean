module

public import BenderSuzuki.ZD.Recognition.ResidualEmbedding.LocalResidual.NormalComplements.RankOne.ModelGeometry.Basic
public import Theory.SpecificGroups.SU3.SylowOmega
public import BenderSuzuki.SE.InvolutionCore
public import BenderSuzuki.ZD.Recognition.ResidualEmbedding.LocalResidual.NormalComplements.RankOne.ModelGeometry.UnitaryGeometry.ModelTransport

/-!
# Root geometry in the actual unitary models

For every Sylow two-subgroup of PSU₃ or SU₃, the ambient first omega subgroup
is its embedded center, is elementary abelian of order q, and equals the
embedded involution core of its normalizer. The two-point subgroup, its
commutator with an outside involution, and its fixed torus are cyclic with
their exact orders, retaining SU₃'s possible scalar center.

The root subgroup generated by Ω₁(P) and an outside involution is actually
isomorphic to PSL₂(q). Any nonidentity involution in P, that outside
involution, and the commutator torus generate it; the marked pair has odd
common centralizer. Arbitrary automorphisms of square one fixing an
involution in P fix Ω₁(P) pointwise, and also fix the root-generated subgroup
when they fix the outside involution.

The descendants prove the matrix, pair-normalization and automorphism
calculations and transport them through genuine model isomorphisms. Here
we identify the normalizer's involution core and assemble the unitary inputs
to Section 16. Both field cardinalities and the actual SU₃ carrier
`J.specialSubgroup` are retained throughout.

Source: GLS, Volume 4, Chapter 4, Lemmas 3.2(b–e,h) and 3.4(f), used in
Chapter 2, Lemma 16.2(b3), Lemma 16.4 and Proposition 16.5.
-/

namespace BenderSuzuki.ZD.RankOneModelGeometry
open Subgroup _root_.BenderSuzuki.MatrixGroups PFAppendixIII

variable {G : Type*} [Group G] [Finite G]

/-- In a Sylow normalizer, the ambient involution core is the Sylow omega subgroup. -/
public theorem normalizer_involutionCore_eq_omega (P : Sylow 2 G) :
    (involutionCore (normalizer (P : Set G))).map (normalizer (P : Set G)).subtype =
      omegaOneAmbient (P : Subgroup G) := by
  let B := normalizer (P : Set G)
  let S : Sylow 2 B := P.subtype (P : Subgroup G).le_normalizer
  let : (S : Subgroup B).Normal := (P : Subgroup G).normal_in_normalizer
  apply le_antisymm
  · rw [map_le_iff_le_comap, involutionCore_eq_closure, closure_le]
    intro x hx
    have hxp := isPGroup_zpowers_of_involution hx
    have hxs : x ∈ (S : Subgroup B) := by
      have he := S.is_maximal' (S.isPGroup'.to_sup_of_normal_left hxp) le_sup_left
      exact (sup_le_iff.mp he.le).2 (mem_zpowers x)
    exact (omegaOneAmbient_le_iff (P : Subgroup G) _).mp le_rfl x.val hxs
      (congrArg Subtype.val hx.2)
  · apply (omegaOneAmbient_le_iff _ _).mpr
    intro x hx hs
    by_cases he : x = 1
    · exact he ▸ one_mem _
    · let xB : B := ⟨x, (P : Subgroup G).le_normalizer hx⟩
      have hi : IsInvolution xB :=
        ⟨fun h => he (congrArg Subtype.val h), Subtype.ext hs⟩
      exact ⟨xB, involutionCore_eq_closure B ▸ subset_closure hi, rfl⟩

variable {E : Type*} [Field E] [Finite E] (J : HermitianForm 3 E)
    {n : ℕ} (hn : 2 ≤ n)
    (hJ : J.form = !![0,0,1;0,1,0;1,0,0])
    (hcard : Nat.card E = (2 ^ n) ^ 2)
    (hfixed : Nat.card {x : E // J.conj x = x} = 2 ^ n)

include hn hJ hcard hfixed in
/-- GLS 3.2(b)'s subgroup equalities and order in every actual PSU₃ model. -/
public theorem unitary_projective_omega_geometry
    (e : G ≃* ProjectiveSpecialUnitaryMatrixGroup J) (P : Sylow 2 G) :
    omegaOneAmbient (P : Subgroup G) = (center P).map (P : Subgroup G).subtype ∧
      IsElementaryAbelian 2 (omegaOneAmbient (P : Subgroup G)) ∧
      Nat.card (omegaOneAmbient (P : Subgroup G)) = 2 ^ n ∧
      omegaOneAmbient (P : Subgroup G) =
        (involutionCore (normalizer (P : Set G))).map
          (normalizer (P : Set G)).subtype := by
  obtain ⟨hc, he, hn⟩ :=
    HermitianForm.SylowOmega.omega_of_projective_equiv J hn hcard hfixed hJ e P
  exact ⟨hc, he, hn, (normalizer_involutionCore_eq_omega P).symm⟩

include hn hJ hcard hfixed in
/-- The same source geometry for SU₃ itself, retaining its possible scalar center. -/
public theorem unitary_special_omega_geometry (e : G ≃* J.specialSubgroup) (P : Sylow 2 G) :
    omegaOneAmbient (P : Subgroup G) = (center P).map (P : Subgroup G).subtype ∧
      IsElementaryAbelian 2 (omegaOneAmbient (P : Subgroup G)) ∧
      Nat.card (omegaOneAmbient (P : Subgroup G)) = 2 ^ n ∧
      omegaOneAmbient (P : Subgroup G) =
        (involutionCore (normalizer (P : Set G))).map
          (normalizer (P : Set G)).subtype := by
  obtain ⟨hc, he, hn⟩ :=
    HermitianForm.SylowOmega.omega_of_special_equiv J hn hcard hfixed hJ e P
  exact ⟨hc, he, hn, (normalizer_involutionCore_eq_omega P).symm⟩

include hn hJ hcard hfixed in
/-- The unitary model input to GLS 16.2(b): the root subgroup is PSL₂,
contains the two-point commutator, and is fixed by a square-one automorphism
fixing the marked pair. The odd centralizer is also the input to 16.5. -/
public theorem unitary_projective_section16
    (e : G ≃* ProjectiveSpecialUnitaryMatrixGroup J) (P : Sylow 2 G)
    (z t : G) (hzP : z ∈ P) (hz : IsInvolution z)
    (ht : IsInvolution t) (htB : t ∉ normalizer (P : Set G))
    (a : MulAut G) (ha : a ^ 2 = 1) (haz : a z = z) (hat : a t = t) :
    Nonempty (rootGenerated (P : Subgroup G) t ≃* PSL2BinaryMatrixGroup n) ∧
      ⁅twoPoint (normalizer (P : Set G)) t, zpowers t⁆ ≤ rootGenerated (P : Subgroup G) t ∧
      Odd (Nat.card (centralizer ({z,t} : Set G))) ∧
      rootGenerated (P : Subgroup G) t ≤ a.fixedSubgroup := by
  obtain ⟨hgen, hodd⟩ :=
    unitary_projective_marked_pair_of_equiv J hn hJ hcard hfixed e P z t hzP hz ht htB
  refine ⟨⟨unitary_projective_rootGenerated_equiv_of_equiv J hn hJ hcard hfixed e P t ht htB⟩,
    ?_, hodd, unitary_projective_rootGenerated_fixed J hn hJ hcard hfixed
      e P z hzP hz.1 hz.2 a ha haz t hat⟩
  rw [← hgen]
  exact le_sup_right

include hn hJ hcard hfixed in
/-- The same Section 16 application on SU₃ itself, including its possible odd center. -/
public theorem unitary_special_section16
    (e : G ≃* J.specialSubgroup) (P : Sylow 2 G)
    (z t : G) (hzP : z ∈ P) (hz : IsInvolution z)
    (ht : IsInvolution t) (htB : t ∉ normalizer (P : Set G))
    (a : MulAut G) (ha : a ^ 2 = 1) (haz : a z = z) (hat : a t = t) :
    Nonempty (rootGenerated (P : Subgroup G) t ≃* PSL2BinaryMatrixGroup n) ∧
      ⁅twoPoint (normalizer (P : Set G)) t, zpowers t⁆ ≤ rootGenerated (P : Subgroup G) t ∧
      Odd (Nat.card (centralizer ({z,t} : Set G))) ∧
      rootGenerated (P : Subgroup G) t ≤ a.fixedSubgroup := by
  obtain ⟨hgen, hodd⟩ :=
    unitary_special_marked_pair_of_equiv J hn hJ hcard hfixed e P z t hzP hz ht htB
  refine ⟨⟨unitary_special_rootGenerated_equiv_of_equiv J hn hJ hcard hfixed e P t ht htB⟩,
    ?_, hodd, unitary_special_rootGenerated_fixed J hn hJ hcard hfixed
      e P z hzP hz.1 hz.2 a ha haz t hat⟩
  rw [← hgen]
  exact le_sup_right

end BenderSuzuki.ZD.RankOneModelGeometry
