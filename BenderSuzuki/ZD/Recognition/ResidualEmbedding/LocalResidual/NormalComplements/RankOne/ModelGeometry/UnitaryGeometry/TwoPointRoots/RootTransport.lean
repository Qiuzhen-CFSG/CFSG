module

public import BenderSuzuki.ZD.Recognition.ResidualEmbedding.LocalResidual.NormalComplements.RankOne.ModelGeometry.Basic
public import BenderSuzuki.ZD.Recognition.ResidualEmbedding.LocalResidual.NormalComplements.RankOne.ModelGeometry.UnitaryGeometry.TwoPointRoots.PairNormalization
public import BenderSuzuki.ZD.Recognition.ResidualEmbedding.LocalResidual.NormalComplements.RankOne.ModelGeometry.UnitaryGeometry.TwoPointRoots.StandardRoots
public import Theory.Frattini.OmegaProducts

/-!
# Root generation for arbitrary unitary Sylow–involution pairs

A genuine inner conjugator carries each Sylow subgroup, outside involution,
and literal two-point subgroup to the standard root, Weyl element, and full
unitary torus. Injective homomorphisms preserve the ambient first omega
subgroup, so this same conjugator transports the standard fixed-field PSL₂
identification and the single-involution generation identity.

Both equivalences have the original model subgroup as their domain. In
particular the special-unitary result retains SU₃ itself; it does not replace
the carrier by its central quotient. No normalization or generation premise
remains in the four exports.

Source: GLS4, Chapter 4, Lemma 3.2(d),(h),(i), used in Chapter 2,
16.2(b3) and 16.4–16.5. The two-point convention is B ∩ t⁻¹Bt.
-/

open Subgroup BenderSuzuki BenderSuzuki.PFAppendixIII
namespace BenderSuzuki.ZD.RankOneModelGeometry
open _root_.BenderSuzuki.MatrixGroups HermitianForm External

private theorem rootGenerated_map_injective {G H : Type*} [Group G] [Group H]
    (f : G →* H) (hf : Function.Injective f) (P : Subgroup G) (t : G) :
    (rootGenerated P t).map f = rootGenerated (P.map f) (f t) := by
  rw [rootGenerated, rootGenerated, Subgroup.map_sup,
    map_omegaOneAmbient_injective f hf, MonoidHom.map_zpowers]

variable {E : Type*} [Field E] [Finite E] (J : HermitianForm 3 E)
  {n : ℕ} (hn : 2 ≤ n) (hcard : Nat.card E = (2 ^ n) ^ 2)
  (hfixed : Nat.card {x : E // J.conj x = x} = 2 ^ n)
  (hJ : J.form = !![0,0,1;0,1,0;1,0,0])

/-- The actual SU₃ subgroup generated by Ω₁(P) and any outside involution
is multiplicatively equivalent to PSL₂ over GF(2ⁿ). -/
public noncomputable def unitary_special_rootGenerated_equiv
    (P : Sylow 2 J.specialSubgroup) (t : J.specialSubgroup) (ht : IsInvolution t)
    (htB : t ∉ normalizer (P : Set J.specialSubgroup)) :
    rootGenerated (P : Subgroup J.specialSubgroup) t ≃* PSL2BinaryMatrixGroup n := by
  let h := PairNormalization.special_pair J hJ hn hcard hfixed P t ht htB
  let g := Classical.choose h
  obtain ⟨hP, ht', _⟩ := Classical.choose_spec h
  let c := MulAut.conj g
  have hm : (rootGenerated (P : Subgroup J.specialSubgroup) t).map c.toMonoidHom =
      rootGenerated (BorelTorus.specialRoot J hJ) (hermitianWeylSU J hJ) := by
    rw [rootGenerated_map_injective c.toMonoidHom c.injective, hP]
    exact congrArg (rootGenerated _) ht'
  exact ((rootGenerated (P : Subgroup J.specialSubgroup) t).equivMapOfInjective
    c.toMonoidHom c.injective).trans ((MulEquiv.subgroupCongr hm).trans
      (UnitaryStandardRoots.specialEquivPSL2 J hJ hn hcard hfixed))

/-- The same concrete PSL₂ identification for an arbitrary PSU₃ pair. -/
public noncomputable def unitary_projective_rootGenerated_equiv
    (P : Sylow 2 (ProjectiveSpecialUnitaryMatrixGroup J))
    (t : ProjectiveSpecialUnitaryMatrixGroup J) (ht : IsInvolution t)
    (htB : t ∉ normalizer (P : Set (ProjectiveSpecialUnitaryMatrixGroup J))) :
    rootGenerated (P : Subgroup (ProjectiveSpecialUnitaryMatrixGroup J)) t ≃*
      PSL2BinaryMatrixGroup n := by
  let h := PairNormalization.projective_pair J hJ hn hcard hfixed P t ht htB
  let g := Classical.choose h
  obtain ⟨hP, ht', _⟩ := Classical.choose_spec h
  let c := MulAut.conj g
  have hm : (rootGenerated (P : Subgroup (ProjectiveSpecialUnitaryMatrixGroup J)) t).map
      c.toMonoidHom =
        rootGenerated (BorelTorus.projectiveRoot J hJ) (hermitianWeylPSU J hJ) := by
    rw [rootGenerated_map_injective c.toMonoidHom c.injective, hP]
    exact congrArg (rootGenerated _) ht'
  exact ((rootGenerated (P : Subgroup (ProjectiveSpecialUnitaryMatrixGroup J)) t).equivMapOfInjective
    c.toMonoidHom c.injective).trans ((MulEquiv.subgroupCongr hm).trans
      (UnitaryStandardRoots.projectiveEquivPSL2 J hJ hn hcard hfixed))

include hn hcard hfixed hJ in
/-- Any nonidentity Sylow involution, the outside involution, and their
literal two-point commutator torus generate ⟨Ω₁(P),t⟩ in SU₃. -/
public theorem unitary_special_marked_generation
    (P : Sylow 2 J.specialSubgroup) (t : J.specialSubgroup) (ht : IsInvolution t)
    (htB : t ∉ normalizer (P : Set J.specialSubgroup))
    (z : J.specialSubgroup) (hz : z ∈ P) (hz1 : z ≠ 1) (hz2 : z ^ 2 = 1) :
    zpowers z ⊔ zpowers t ⊔
      ⁅twoPoint (normalizer (P : Set J.specialSubgroup)) t, zpowers t⁆ =
        rootGenerated (P : Subgroup J.specialSubgroup) t := by
  obtain ⟨g, hP, ht', hD⟩ := PairNormalization.special_pair J hJ hn hcard hfixed P t ht htB
  let c := MulAut.conj g
  have hzR : c z ∈ BorelTorus.specialRoot J hJ := hP ▸ mem_map_of_mem c.toMonoidHom hz
  have hz1' : c z ≠ 1 := fun he => hz1 (c.injective (he.trans (map_one c).symm))
  have hz2' : (c z) ^ 2 = 1 := by rw [← map_pow, hz2, map_one]
  apply Subgroup.map_injective (f := c.toMonoidHom) c.injective
  simpa only [Subgroup.map_sup, Subgroup.map_commutator, MonoidHom.map_zpowers,
    rootGenerated_map_injective c.toMonoidHom c.injective,
    MulEquiv.coe_toMonoidHom, c, hP, ht', hD] using
      UnitaryStandardRoots.special_generation J hJ hn hcard hfixed (c z) hzR hz1' hz2'

include hn hcard hfixed hJ in
/-- The source single-involution generation identity for every PSU₃ pair. -/
public theorem unitary_projective_marked_generation
    (P : Sylow 2 (ProjectiveSpecialUnitaryMatrixGroup J))
    (t : ProjectiveSpecialUnitaryMatrixGroup J) (ht : IsInvolution t)
    (htB : t ∉ normalizer (P : Set (ProjectiveSpecialUnitaryMatrixGroup J)))
    (z : ProjectiveSpecialUnitaryMatrixGroup J) (hz : z ∈ P) (hz1 : z ≠ 1)
    (hz2 : z ^ 2 = 1) :
    zpowers z ⊔ zpowers t ⊔
      ⁅twoPoint (normalizer (P : Set (ProjectiveSpecialUnitaryMatrixGroup J))) t, zpowers t⁆ =
        rootGenerated (P : Subgroup (ProjectiveSpecialUnitaryMatrixGroup J)) t := by
  obtain ⟨g, hP, ht', hD⟩ := PairNormalization.projective_pair J hJ hn hcard hfixed P t ht htB
  let c := MulAut.conj g
  have hzR : c z ∈ BorelTorus.projectiveRoot J hJ := hP ▸ mem_map_of_mem c.toMonoidHom hz
  have hz1' : c z ≠ 1 := fun he => hz1 (c.injective (he.trans (map_one c).symm))
  have hz2' : (c z) ^ 2 = 1 := by rw [← map_pow, hz2, map_one]
  apply Subgroup.map_injective (f := c.toMonoidHom) c.injective
  simpa only [Subgroup.map_sup, Subgroup.map_commutator, MonoidHom.map_zpowers,
    rootGenerated_map_injective c.toMonoidHom c.injective,
    MulEquiv.coe_toMonoidHom, c, hP, ht', hD] using
      UnitaryStandardRoots.projective_generation J hJ hn hcard hfixed (c z) hzR hz1' hz2'

end BenderSuzuki.ZD.RankOneModelGeometry
