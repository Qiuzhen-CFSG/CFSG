module

public import BenderSuzuki.ZD.Recognition.ResidualEmbedding.Setup
public import BenderSuzuki.ZD.Recognition.MinimalReduction.LocalEmbedding.FourObstruction
public import BenderSuzuki.SE.Corollary713
public import BenderSuzuki.SE.Lemma312

/-!
# Distinguished local circles in the residual ZD argument

The local circle is generated by the distinguished involutions in a proper
subgroup. Local strong embedding makes every involution of this circle
distinguished. Restricting the odd-normalizer action theorem then supplies
the fixed-point hypothesis of Lemma 3.12 and proves the solvable alternative.
Normality is relative to the local overgroup throughout.

Source: GLS, Volume 4, Chapter 2, Corollary 7.13, proof of alternative (a).
-/

noncomputable section
namespace BenderSuzuki.ZD
open Theory.GroupTheory PFAppendixIII PFchapter1section1
open scoped Pointwise
universe u v
variable {G : Type u} [Group G] {Z : Set G} {M : Subgroup G}

/-- The internal distinguished circle `F°`. -/
@[expose] public def localCircle (Z : Set G) (F : Subgroup G) : Subgroup F :=
  Subgroup.closure (F.subtype ⁻¹' Z)

/-- The ambient realization of the same distinguished circle. -/
@[expose] public def localCircleIn (Z : Set G) (F : Subgroup G) : Subgroup G :=
  (localCircle Z F).map F.subtype

/-- The canonical injective map from the internal circle to the ambient group. -/
@[expose] public def localCircleHom (Z : Set G) (F : Subgroup G) : localCircle Z F →* G :=
  F.subtype.comp (localCircle Z F).subtype

public theorem localCircleHom_injective (Z : Set G) (F : Subgroup G) :
    Function.Injective (localCircleHom Z F) :=
  F.subtype_injective.comp (localCircle Z F).subtype_injective

public theorem localCircleIn_le (Z : Set G) (F : Subgroup G) : localCircleIn Z F ≤ F := by
  rintro x ⟨y, _, rfl⟩
  exact y.property

/-- This equality retains the ambient and internal conventions explicitly. -/
public theorem localCircleIn_eq_closure (Z : Set G) (F : Subgroup G) :
    localCircleIn Z F = Subgroup.closure (Z ∩ (F : Set G)) := by
  rw [localCircleIn, localCircle, MonoidHom.map_closure]
  congr 1
  ext x
  constructor
  · rintro ⟨y, hy, rfl⟩
    exact ⟨hy, y.property⟩
  · rintro ⟨hz, hf⟩
    exact ⟨⟨x, hf⟩, hz, rfl⟩

public theorem localCircleIn_not_le
    (h : IsProductDisconnected Z M) (F : Subgroup G)
    (hFM : ¬ F ≤ M) (hne : ∃ z ∈ Z, z ∈ F ∧ z ∈ M) :
    ¬ localCircleIn Z F ≤ M := by
  rw [localCircleIn, Subgroup.map_le_iff_le_comap]
  exact local_closure_not_le h F hFM hne

public theorem localCircle_normal
    (h : IsProductDisconnected Z M) (F : Subgroup G)
    (hFM : ¬ F ≤ M) (hne : ∃ z ∈ Z, z ∈ F ∧ z ∈ M) :
    (localCircle Z F).Normal :=
  (productDisconnected_subgroup h F hFM hne).closure_normal

variable [Finite G]

/-- Local strong embedding identifies all involutions of the circle with
members of the distinguished set; it does not identify the circle with the
full involution core of `F`. -/
public theorem localCircle_involution_mem
    (h : IsProductDisconnected Z M) (r : SimpleReduction Z M)
    (F : Subgroup G) (hF : F ≠ ⊤) (hFM : ¬ F ≤ M)
    (hne : ∃ z ∈ Z, z ∈ F ∧ z ∈ M)
    {x : localCircle Z F} (hx : IsInvolution x) : localCircleHom Z F x ∈ Z := by
  have hs := r.local_embedding F hF hFM hne
  obtain ⟨z, hz, hzF, _⟩ := hne
  let zF : F := ⟨z, hzF⟩
  have hzC : zF ∈ localCircle Z F := Subgroup.subset_closure hz
  let zC : localCircle Z F := ⟨zF, hzC⟩
  obtain ⟨g, hg⟩ := hs.involutions_conjugate
    (IsInvolution.subtype (IsInvolution.subtype (h.involutions z hz) hzF) hzC) hx
  have heq := congrArg (localCircleHom Z F) hg
  change (localCircleHom Z F g)⁻¹ * z * localCircleHom Z F g = localCircleHom Z F x at heq
  have hh := h.invariant (localCircleHom Z F g)⁻¹ z hz
  simpa only [MulAut.conj_apply, inv_inv, heq] using hh

omit [Finite G] in
/-- Restrict the residual odd-normalizer theorem along an injective map.
Only involutions in its image need be distinguished. -/
public theorem ResidualAction.theorem4b_comap
    (ha : ResidualAction Z M) {H : Type v} [Group H] [Finite H]
    (f : H →* G) (hf : Function.Injective f)
    (hZ : ∀ z : H, IsInvolution z → f z ∈ Z) :
    Theorem4bAtBase (M.comap f) := by
  classical
  by_contra hnot
  obtain ⟨⟨z, W, hz, hzM, hodd, hWM, hnorm, hnotC, hfixed⟩⟩ :=
    not_Theorem4bAtBase_iff_nonempty_counterexample.mp hnot
  have hmapM : W.map f ≤ M := (Subgroup.map_le_iff_le_comap).mpr hWM
  have hmapodd : Odd (Nat.card (W.map f)) := by
    rwa [Subgroup.card_map_of_injective hf]
  have hmapnorm : f z ∈ Subgroup.normalizer (W.map f : Set G) := by
    apply Subgroup.mem_normalizer_iff.mpr
    intro x
    constructor
    · rintro ⟨w, hw, rfl⟩
      exact ⟨z * w * z⁻¹, (Subgroup.mem_normalizer_iff.mp hnorm w).mp hw, by simp⟩
    · intro hx
      have hninv := (Subgroup.normalizer (W : Set H)).inv_mem hnorm
      obtain ⟨w, hw, heq⟩ := hx
      refine ⟨z⁻¹ * w * z, ?_, ?_⟩
      · change z⁻¹ * w * z ∈ W
        simpa only [inv_inv] using (Subgroup.mem_normalizer_iff.mp hninv w).mp hw
      · simp only [map_mul, map_inv, heq]
        group
  rcases ha.odd_normalizer (f z) (hZ z hz) hzM (W.map f)
      hmapodd hmapM hmapnorm with hc | hfix
  · apply hnotC
    intro w hw
    apply Subgroup.mem_centralizer_singleton_iff.mpr
    apply hf
    simpa only [map_mul] using Subgroup.mem_centralizer_singleton_iff.mp
      (hc (Subgroup.mem_map_of_mem f hw))
  · suffices hc : Nat.card (theorem4bFixedPoints (M.comap f) W) = 1 by omega
    apply Nat.card_eq_one_iff_exists.mpr
    refine ⟨⟨QuotientGroup.mk 1, theorem4b_baseCoset_mem_fixedPoints hWM⟩, ?_⟩
    rintro ⟨omega, homega⟩
    apply Subtype.ext
    obtain ⟨g, rfl⟩ := QuotientGroup.mk_surjective omega
    have hamb : W.map f ≤ MulAction.stabilizer G (QuotientGroup.mk (f g) : G ⧸ M) := by
      rintro x ⟨w, hw, rfl⟩
      apply MulAction.mem_stabilizer_iff.mpr
      have heq := homega w hw
      change (QuotientGroup.mk (w * g) : H ⧸ M.comap f) = QuotientGroup.mk g at heq
      change (QuotientGroup.mk (f w * f g) : G ⧸ M) = QuotientGroup.mk (f g)
      apply QuotientGroup.eq.mpr
      have hh : f ((w * g)⁻¹ * g) ∈ M := QuotientGroup.eq.mp heq
      simpa only [map_mul, map_inv] using hh
    have heq := hfix (QuotientGroup.mk (f g)) hamb
    apply QuotientGroup.eq.mpr
    change f (g⁻¹ * 1) ∈ M
    simpa only [map_mul, map_inv, map_one] using QuotientGroup.eq.mp heq

/-- The fixed-point condition of Lemma 3.12 is derived from the supplied
action theorem, inside the actual distinguished circle. -/
public theorem localCircle_fixedPointCondition
    (h : IsProductDisconnected Z M) (r : SimpleReduction Z M)
    (ha : ResidualAction Z M) (F : Subgroup G) (hF : F ≠ ⊤) (hFM : ¬ F ≤ M)
    (hne : ∃ z ∈ Z, z ∈ F ∧ z ∈ M)
    {z : localCircle Z F} (hzM : localCircleHom Z F z ∈ M) (hz : IsInvolution z) :
    Lemma312FixedPointCondition (M.comap (localCircleHom Z F)) z := by
  let Y := M.comap (localCircleHom Z F)
  have hs : IsStronglyEmbedded Y := r.local_embedding F hF hFM hne
  have h4 := ha.theorem4b_comap (localCircleHom Z F) (localCircleHom_injective Z F)
    (fun _ hx => localCircle_involution_mem h r F hF hFM hne hx)
  -- The public comap lemma is applied to the top subgroup and transported back.
  intro y hy hyne hinv
  let T : Subgroup (localCircle Z F) := ⊤
  let zT : T := ⟨z, Subgroup.mem_top z⟩
  have hzT : IsInvolution zT := IsInvolution.subtype hz (Subgroup.mem_top z)
  have hp := lemma312_fixedPointCondition_of_theorem4b_comap Y T hs h4 hzM hzT
  let yT : T := ⟨y, Subgroup.mem_top y⟩
  have hyT : yT ≠ 1 := fun he => hyne (congrArg Subtype.val he)
  have hiT : zT * yT * zT⁻¹ = yT⁻¹ := Subtype.ext hinv
  obtain ⟨omega, homega, hunique⟩ := hp yT hy hyT hiT
  -- Prove uniqueness at the base by representing a coset by an element.
  refine ⟨QuotientGroup.mk 1, ?_, ?_⟩
  · apply MulAction.mem_stabilizer_iff.mp
    rw [baseCoset_stabilizer]
    exact hy
  · intro eta heta
    obtain ⟨g, rfl⟩ := QuotientGroup.mk_surjective eta
    let gT : T := ⟨g, Subgroup.mem_top g⟩
    have hgt : (QuotientGroup.mk (yT * gT) : T ⧸ Y.comap T.subtype) = QuotientGroup.mk gT := by
      apply QuotientGroup.eq.mpr
      change (y * g)⁻¹ * g ∈ Y
      exact QuotientGroup.eq.mp heta
    have hbase : (QuotientGroup.mk (yT * 1) : T ⧸ Y.comap T.subtype) = QuotientGroup.mk 1 := by
      apply QuotientGroup.eq.mpr
      change (y * 1)⁻¹ * 1 ∈ Y
      simpa only [mul_one] using Y.inv_mem hy
    apply QuotientGroup.eq.mpr
    have hh := QuotientGroup.eq.mp ((hunique (QuotientGroup.mk gT) hgt).trans
      (hunique (QuotientGroup.mk 1) hbase).symm)
    exact hh

/-- The solvable alternative of Corollary 7.13, for the distinguished
circle and without ambient strong embedding. -/
public theorem localCircle_solvable_alternative
    (h : IsProductDisconnected Z M) (r : SimpleReduction Z M)
    (ha : ResidualAction Z M) (F : Subgroup G) (hF : F ≠ ⊤) (hFM : ¬ F ≤ M)
    (hne : ∃ z ∈ Z, z ∈ F ∧ z ∈ M) (hsol : Group.IsSolvable (localCircle Z F)) :
    ∃ z ∈ Z, z ∈ F ∧ z ∈ M ∧
      (∀ w ∈ Z, w ∈ F → w ∈ M → w = z) ∧
      F ⊓ M = F ⊓ Subgroup.centralizer ({z} : Set G) := by
  have hs := r.local_embedding F hF hFM hne
  obtain ⟨z, hz, hzF, hzM⟩ := hne
  let zF : F := ⟨z, hzF⟩
  have hzC : zF ∈ localCircle Z F := Subgroup.subset_closure hz
  let zC : localCircle Z F := ⟨zF, hzC⟩
  have hzi : IsInvolution zC :=
    IsInvolution.subtype (IsInvolution.subtype (h.involutions z hz) hzF) hzC
  have heven : Even (Nat.card (localCircle Z F)) := by
    apply even_iff_two_dvd.mpr
    rw [← orderOf_eq_prime hzi.sq_eq_one hzi.ne_one]
    exact orderOf_dvd_natCard zC
  have hfixed := localCircle_fixedPointCondition h r ha F hF hFM
    ⟨z, hz, hzF, hzM⟩ (z := zC) hzM hzi
  obtain ⟨_, hu⟩ := lemma_3_12 (M.comap (localCircleHom Z F)) hsol heven hs hzM hzi hfixed
  have hunique : ∀ w ∈ Z, w ∈ F → w ∈ M → w = z := by
    intro w hw hwF hwM
    let wF : F := ⟨w, hwF⟩
    have hwC : wF ∈ localCircle Z F := Subgroup.subset_closure hw
    exact congrArg (localCircleHom Z F) (hu ⟨wF, hwC⟩ hwM
      (IsInvolution.subtype (IsInvolution.subtype (h.involutions w hw) hwF) hwC))
  refine ⟨z, hz, hzF, hzM, hunique, le_antisymm ?_ ?_⟩
  · intro x hx
    refine ⟨hx.1, Subgroup.mem_centralizer_singleton_iff.mpr ?_⟩
    have heq := hunique (MulAut.conj x z) (h.invariant x z hz)
      (F.mul_mem (F.mul_mem hx.1 hzF) (F.inv_mem hx.1))
      (M.mul_mem (M.mul_mem hx.2 hzM) (M.inv_mem hx.2))
    exact mul_inv_eq_iff_eq_mul.mp heq
  · intro x hx
    exact ⟨hx.1, h.centralizer_le hz hzM hx.2⟩

/-- Frattini's argument for the distinguished circle. The normalizer of
a Sylow subgroup stays in `F ∩ M` because it contains a distinguished
involution. This does not require recognition of a Bender model. -/
public theorem localCircle_frattini_factorization
    (h : IsProductDisconnected Z M) (r : SimpleReduction Z M)
    (F : Subgroup G) (hF : F ≠ ⊤) (hFM : ¬ F ≤ M)
    (hne : ∃ z ∈ Z, z ∈ F ∧ z ∈ M) :
    (F : Set G) = (localCircleIn Z F : Set G) * (F ⊓ M : Subgroup G) := by
  let C := localCircle Z F
  let Y := (M.comap F.subtype).comap C.subtype
  have hs : IsStronglyEmbedded Y := r.local_embedding F hF hFM hne
  let : C.Normal := localCircle_normal h F hFM hne
  obtain ⟨P, hP⟩ := hs.containsSylowTwo
  let Q : Subgroup F := (P : Subgroup C).map C.subtype
  have hQY : Q ≤ M.comap F.subtype := (Subgroup.map_le_iff_le_comap).mpr hP
  have hCtwo : 2 ∣ Nat.card C := hs.card_even.two_dvd.trans (Subgroup.card_subgroup_dvd_card Y)
  obtain ⟨x, hx⟩ := exists_prime_orderOf_dvd_card' (G := (P : Subgroup C)) 2
    (P.dvd_card_of_dvd_card hCtwo)
  have hxi : IsInvolution x := ⟨(orderOf_eq_prime_iff.mp hx).2, (orderOf_eq_prime_iff.mp hx).1⟩
  have hxC : IsInvolution (x : C) := IsInvolution.map_of_injective hxi
    (P : Subgroup C).subtype Subtype.val_injective
  have hxZ := localCircle_involution_mem h r F hF hFM hne hxC
  have hn : Subgroup.normalizer (Q : Set F) ≤ M.comap F.subtype := by
    apply normalizer_le (productDisconnected_subgroup h F hFM hne) hQY
    exact ⟨((x : C) : F), hxZ, Subgroup.mem_map_of_mem C.subtype x.property⟩
  have hsup : C ⊔ M.comap F.subtype = ⊤ := by
    apply top_unique
    rw [← Sylow.normalizer_sup_eq_top P]
    exact sup_le (hn.trans le_sup_right) le_sup_left
  have hmul : (C : Set F) * (M.comap F.subtype : Set F) = Set.univ := by
    rw [← Subgroup.normal_mul, hsup]
    rfl
  apply Set.Subset.antisymm
  · intro x hx
    have hh : (⟨x, hx⟩ : F) ∈ (C : Set F) * (M.comap F.subtype : Set F) := by
      rw [hmul]
      trivial
    obtain ⟨a, ha, b, hb, heq⟩ := hh
    exact ⟨a, Subgroup.mem_map_of_mem F.subtype ha, b, ⟨b.property, hb⟩,
      congrArg F.subtype heq⟩
  · rintro x ⟨a, ha, b, hb, rfl⟩
    exact F.mul_mem (localCircleIn_le Z F ha) hb.1

/-- The orbit equality in the proof of Corollary 7.13 already follows
from local embedding and Frattini's argument. -/
public theorem localCircle_orbit_iff
    (h : IsProductDisconnected Z M) (r : SimpleReduction Z M)
    (F : Subgroup G) (hF : F ≠ ⊤) (hFM : ¬ F ≤ M)
    (hne : ∃ z ∈ Z, z ∈ F ∧ z ∈ M) (beta : G ⧸ M) :
    InOrbit F (QuotientGroup.mk 1) beta ↔
      InOrbit (localCircleIn Z F) (QuotientGroup.mk 1) beta := by
  apply inOrbit_iff_of_eq_mul_pointStabilizer F (localCircleIn Z F)
    (QuotientGroup.mk 1) beta (localCircleIn_le Z F)
  simpa only [baseCoset_stabilizer] using localCircle_frattini_factorization h r F hF hFM hne

end BenderSuzuki.ZD
