module

public import BenderSuzuki.ZD.Recognition.ResidualEmbedding.LocalResidual.NormalComplements.RankOne.LocalRecognition.Source.Basic
public import BenderSuzuki.SE.RankOne
public import BenderSuzuki.SE.StrongEmbeddingOddCore

/-!
# The odd core of a nonsolvable distinguished circle

The local circle is generated by involutions. Nonsolvability and local
strong embedding therefore supply a four-group in its intersection with
`M`; coprime action puts the odd core in that intersection. Normality gives
more than one fixed coset, so the residual action centralizes the odd core.
The reverse inclusion follows because the center of a strongly embedded
group has odd order. No Bender recognition is assumed in this argument.

Source: GLS, Volume 4, Chapter 2, Corollary 7.13(b), odd-core calculation.
-/

noncomputable section
namespace BenderSuzuki.ZD
open Theory.GroupTheory PFAppendixIII PFchapter1section1
variable {G : Type*} [Group G] {Z : Set G} {M : Subgroup G}

/-- Distinguished generation implies involution generation inside the
circle, without replacing the circle by the involution core of `F`. -/
public theorem localCircle_involutionCore_eq_top
    (h : IsProductDisconnected Z M) (F : Subgroup G) :
    involutionCore (localCircle Z F) = ⊤ := by
  apply top_unique
  change (⊤ : Subgroup (Subgroup.closure (F.subtype ⁻¹' Z))) ≤ _
  rw [← Subgroup.closure_preimage_eq_top (F.subtype ⁻¹' Z), involutionCore_eq_closure]
  apply Subgroup.closure_mono
  intro x hx
  exact IsInvolution.subtype (IsInvolution.subtype (h.involutions x hx) (x : F).property) x.property

variable [Finite G]

/-- A four-group controls the odd core of a strongly embedded group. -/
private theorem oddCore_le_of_twoRank {H : Type*} [Group H] [Finite H]
    {Y : Subgroup H} (hs : IsStronglyEmbedded Y) (hrank : TwoRankAtLeastTwo Y) :
    pPrimeCore 2 H ≤ Y := by
  obtain ⟨E, hEcard, hEsq⟩ := TwoRankAtLeastTwo.exists_subgroup hrank
  let U := E.map Y.subtype
  have hUY : U ≤ Y := Subgroup.map_subtype_le E
  have hUcard : Nat.card U = 4 := by
    rw [Subgroup.card_map_of_injective Y.subtype_injective]
    exact hEcard
  have hUsq : ∀ u : U, u ^ 2 = 1 := by
    intro u
    obtain ⟨e, he, heq⟩ := u.property
    apply Subtype.ext
    change (u : H) ^ 2 = 1
    rw [← heq]
    exact congrArg Y.subtype (congrArg E.subtype (hEsq ⟨e, he⟩))
  apply fourGroup_odd_subgroup_le_stronglyEmbedded hs hUY hUcard hUsq
  · rw [Subgroup.normalizer_eq_top]
    exact le_top
  · exact Nat.coprime_two_left.mp pPrimeCore_coprime_card

/-- The nonsolvable circle's odd core lies in the relative intersection
with `M`, derived before model recognition. -/
public theorem localCircle_oddCore_le
    (h : IsProductDisconnected Z M) (r : SimpleReduction Z M)
    (F : Subgroup G) (hF : F ≠ ⊤) (hFM : ¬ F ≤ M)
    (hne : ∃ z ∈ Z, z ∈ F ∧ z ∈ M)
    (hns : ¬ Group.IsSolvable (localCircle Z F)) :
    pPrimeCore 2 (localCircle Z F) ≤ M.comap (localCircleHom Z F) := by
  have hs := r.local_embedding F hF hFM hne
  exact oddCore_le_of_twoRank hs
    (hs.twoRankAtLeastTwo_of_not_solvable_of_involutionCore_eq_top
      (localCircle_involutionCore_eq_top h F) hns)

private theorem oddCore_le_center_of_action {H : Type*} [Group H] [Finite H]
    {Y : Subgroup H} (hs : IsStronglyEmbedded Y) (ha : Theorem4bAtBase Y)
    (hgen : involutionCore H = ⊤) (hNY : pPrimeCore 2 H ≤ Y) :
    pPrimeCore 2 H ≤ Subgroup.center H := by
  obtain ⟨z, hzY, hz⟩ := hs.exists_involution
  apply hs.twoPrimeCore_le_center_of_involutionCore_eq_top hz ?_ hgen
  have hzN : z ∈ Subgroup.normalizer (pPrimeCore 2 H : Set H) := by
    rw [Subgroup.normalizer_eq_top]
    trivial
  rcases ha.centralizes_or_existsUnique_fixedPoint hz hzY
      (Nat.coprime_two_left.mp pPrimeCore_coprime_card) hNY hzN with hc | hf
  · exact hc
  · exfalso
    obtain ⟨omega, _, hu⟩ := hf
    have hb := theorem4b_baseCoset_mem_fixedPoints hNY
    apply hs.ne_top
    apply top_unique
    intro g _
    have hfix : QuotientGroup.mk g ∈ fixedPointsOfSubgroup H (H ⧸ Y) (pPrimeCore 2 H) := by
      have hn : g ∈ Subgroup.normalizer (pPrimeCore 2 H : Set H) := by
        rw [Subgroup.normalizer_eq_top]
        trivial
      have hb' : pPrimeCore 2 H ≤ MulAction.stabilizer H (QuotientGroup.mk 1 : H ⧸ Y) := by
        simpa only [baseCoset_stabilizer] using hNY
      have hh := theorem4b_le_stabilizer_smul_of_le_stabilizer_of_mem_normalizer hn hb'
      intro w hw
      simpa using MulAction.mem_stabilizer_iff.mp (hh hw)
    have heq := (hu (QuotientGroup.mk 1) hb).trans (hu (QuotientGroup.mk g) hfix).symm
    simpa using QuotientGroup.eq.mp heq

/-- The equality `O₂'(F°) = Z(F°)` in Corollary 7.13(b), without any
unproved quotient-recognition premise. -/
public theorem localCircle_oddCore_eq_center
    (h : IsProductDisconnected Z M) (r : SimpleReduction Z M)
    (ha : ResidualAction Z M) (F : Subgroup G) (hF : F ≠ ⊤) (hFM : ¬ F ≤ M)
    (hne : ∃ z ∈ Z, z ∈ F ∧ z ∈ M)
    (hns : ¬ Group.IsSolvable (localCircle Z F)) :
    pPrimeCore 2 (localCircle Z F) = Subgroup.center (localCircle Z F) := by
  let C := localCircle Z F
  let Y := M.comap (localCircleHom Z F)
  have hs : IsStronglyEmbedded Y := r.local_embedding F hF hFM hne
  have h4 := ha.theorem4b_comap (localCircleHom Z F) (localCircleHom_injective Z F)
    (fun _ hx => localCircle_involution_mem h r F hF hFM hne hx)
  apply le_antisymm
  · exact oddCore_le_center_of_action hs h4 (localCircle_involutionCore_eq_top h F)
      (localCircle_oddCore_le h r F hF hFM hne hns)
  · obtain ⟨z, hzY, hz⟩ := hs.exists_involution
    have hcY : Subgroup.center C ≤ Y := by
      intro x hx
      apply hs.centralizer_le hzY hz
      exact Subgroup.mem_centralizer_singleton_iff.mpr (Subgroup.mem_center_iff.mp hx z).symm
    exact le_sSup ⟨inferInstance, Nat.coprime_two_left.mpr (hs.normal_le_card_odd hcY)⟩

end BenderSuzuki.ZD
