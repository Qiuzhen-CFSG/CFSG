module

public import BenderSuzuki.External.Huppert.XI.theorem_3_3
public import Theory.GroupTheory.SolvableOrderTwenty

/-!
# The degenerate Suzuki matrix group

The model `Sz(2)` has a cyclic root subgroup of order four and total order
twenty. The upper bound comes from the Bruhat decomposition with trivial torus;
the explicit root generator and a root--Weyl product give divisibility by four
and five. These are the concrete calculations used in Section 11, Lemma 11.4.

Source: Huppert--Blackburn, Volume III, XI.3.3 (Bruhat decomposition), specialized
to the binary field. The model facts live here so they are available without
any strong-embedding or subgroup-recognition results. Its order twenty then
gives solvability by the elementary Sylow argument in `SolvableOrderTwenty`.
-/

noncomputable section

namespace BenderSuzuki.MatrixGroups

open BenderSuzuki.PFAppendixIII BenderSuzuki.External

private theorem binaryGaloisFieldOne_eq_zero_or_one
    (x : BinaryGaloisField 1) : x = 0 ∨ x = 1 := by
  apply eq_zero_or_one_of_sq_eq_self
  have hcard : Nat.card (BinaryGaloisField 1) = 2 := by
    simpa [BinaryGaloisField] using GaloisField.card 2 1 (by norm_num)
  let : Fintype (BinaryGaloisField 1) := Fintype.ofFinite _
  have hx := FiniteField.pow_card x
  rw [Fintype.card_eq_nat_card, hcard] at hx
  simpa [pow_two] using hx

private theorem binaryGaloisFieldOne_one_add_one :
    (1 + 1 : BinaryGaloisField 1) = 0 :=
  CharTwo.add_self_eq_zero 1

/-- The root element with parameters `(1, 0)` in `Sz(2)`. -/
public noncomputable def suzukiZeroRootGenerator :
    SuzukiMatrixGroup 0 :=
  ⟨SuzukiRootGL 0 1 0,
    Subgroup.subset_closure (Or.inl ⟨1, 0, rfl⟩)⟩

set_option maxHeartbeats 1200000 in
/-- The distinguished root element generates a cyclic group of order four. -/
public theorem suzukiZeroRootGenerator_order :
    orderOf suzukiZeroRootGenerator = 4 := by
  rw [orderOf_eq_iff (by norm_num : 0 < 4)]
  constructor
  · apply Subtype.ext
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [suzukiZeroRootGenerator, SuzukiRootGL,
        SuzukiRootMatrix, Matrix.mul_apply, Fin.sum_univ_four, pow_succ,
        binaryGaloisFieldOne_one_add_one]
  · intro m hm4 hm0
    have hm : m = 1 ∨ m = 2 ∨ m = 3 := by omega
    rcases hm with rfl | rfl | rfl
    · intro h
      have h01 := congrArg
        (fun A : SuzukiMatrixGroup 0 =>
          (((A : GL (Fin 4) (BinaryGaloisField 1)) :
            Matrix (Fin 4) (Fin 4) (BinaryGaloisField 1)) 0 1)) h
      simp [suzukiZeroRootGenerator, SuzukiRootGL,
        SuzukiRootMatrix] at h01
    · intro h
      have h02 := congrArg
        (fun A : SuzukiMatrixGroup 0 =>
          (((A : GL (Fin 4) (BinaryGaloisField 1)) :
            Matrix (Fin 4) (Fin 4) (BinaryGaloisField 1)) 0 2)) h
      simp [suzukiZeroRootGenerator, SuzukiRootGL,
        SuzukiRootMatrix, Matrix.mul_apply, Fin.sum_univ_four, pow_two] at h02
    · intro h
      have h01 := congrArg
        (fun A : SuzukiMatrixGroup 0 =>
          (((A : GL (Fin 4) (BinaryGaloisField 1)) :
            Matrix (Fin 4) (Fin 4) (BinaryGaloisField 1)) 0 1)) h
      simp [suzukiZeroRootGenerator, SuzukiRootGL,
        SuzukiRootMatrix, Matrix.mul_apply, Fin.sum_univ_four, pow_succ,
        binaryGaloisFieldOne_one_add_one] at h01

/-- The root subgroup of the concrete degenerate Suzuki group. -/
public noncomputable def suzukiZeroRootSubgroup :
    Subgroup (SuzukiMatrixGroup 0) :=
  (Subgroup.closure
    {A | ∃ a b : BinaryGaloisField 1, A = SuzukiRootGL 0 a b}).comap
      (SuzukiMatrixGroup 0).subtype

/-- The root subgroup is generated by its distinguished root element. -/
public theorem suzukiZeroRootSubgroup_eq_zpowers :
    suzukiZeroRootSubgroup =
      Subgroup.zpowers suzukiZeroRootGenerator := by
  let K := BinaryGaloisField 1
  let pi : K ≃+* K := iterateFrobeniusEquiv K 2 1
  have hpi : ∀ x : K, pi x = x ^ 2 := by
    intro x
    simpa [pi] using iterateFrobeniusEquiv_def K 2 1 x
  have hpiSq : ∀ x : K, pi (pi x) = x ^ 2 := by
    exact binaryGaloisField_tits_formula_sq 0 pi (by
      intro x
      simpa using hpi x)
  have hzle : Subgroup.zpowers suzukiZeroRootGenerator ≤
      suzukiZeroRootSubgroup := by
    apply Subgroup.zpowers_le.mpr
    change SuzukiRootGL 0 1 0 ∈ Subgroup.closure
      {A | ∃ a b : BinaryGaloisField 1, A = SuzukiRootGL 0 a b}
    exact Subgroup.subset_closure ⟨1, 0, rfl⟩
  let toF : K × K → suzukiZeroRootSubgroup := fun z =>
    ⟨⟨SuzukiRootGL 0 z.1 z.2,
      Subgroup.subset_closure (Or.inl ⟨z.1, z.2, rfl⟩)⟩,
      Subgroup.subset_closure ⟨z.1, z.2, rfl⟩⟩
  have htoF : Function.Surjective toF := by
    intro x
    have hx : (x : GL (Fin 4) K) ∈ Subgroup.closure
        {A | ∃ a b : K, A = SuzukiRootGL 0 a b} := x.property
    rcases (suzukiRootGL_mem_closure_iff 0 pi hpiSq hpi
      (x : GL (Fin 4) K)).mp hx with ⟨a, b, hab⟩
    refine ⟨(a, b), ?_⟩
    apply Subtype.ext
    apply Subtype.ext
    exact hab.symm
  have hKcard : Nat.card K = 2 := by
    simpa [K, BinaryGaloisField] using GaloisField.card 2 1 (by norm_num)
  have hFcard : Nat.card suzukiZeroRootSubgroup ≤ 4 := by
    calc
      Nat.card suzukiZeroRootSubgroup ≤ Nat.card (K × K) :=
        Nat.card_le_card_of_surjective toF htoF
      _ = 4 := by simp [Nat.card_prod, hKcard]
  have hzcard :
      Nat.card (Subgroup.zpowers suzukiZeroRootGenerator) = 4 := by
    rw [Nat.card_zpowers, suzukiZeroRootGenerator_order]
  exact (Subgroup.eq_of_le_of_card_ge hzle
    (by simpa [hzcard] using hFcard)).symm

/-- The root subgroup of `Sz(2)` has order four. -/
public theorem suzukiZeroRootSubgroup_card :
    Nat.card suzukiZeroRootSubgroup = 4 := by
  rw [suzukiZeroRootSubgroup_eq_zpowers, Nat.card_zpowers,
    suzukiZeroRootGenerator_order]

private noncomputable def suzukiZeroCentralInvolution :
    SuzukiMatrixGroup 0 :=
  ⟨SuzukiRootGL 0 0 1,
    Subgroup.subset_closure (Or.inl ⟨0, 1, rfl⟩)⟩

private noncomputable def suzukiZeroWeyl :
    SuzukiMatrixGroup 0 :=
  ⟨SuzukiWeylGL 0,
    Subgroup.subset_closure (Or.inr (Or.inr rfl))⟩

set_option maxHeartbeats 1200000 in
private theorem suzukiZero_standard_pair_order :
    orderOf
      (suzukiZeroCentralInvolution * suzukiZeroWeyl) = 5 := by
  have : Fact (Nat.Prime 5) := ⟨by decide⟩
  apply orderOf_eq_prime_iff.mpr
  constructor
  · apply Subtype.ext
    change
      (SuzukiRootGL 0 0 1 * SuzukiWeylGL 0) ^ 5 =
        (1 : GL (Fin 4) (BinaryGaloisField 1))
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [SuzukiRootGL, SuzukiRootMatrix, SuzukiWeylGL,
        SuzukiWeylMatrix, Matrix.mul_apply, Fin.sum_univ_four, pow_succ,
        binaryGaloisFieldOne_one_add_one]
  · intro hpair
    have hGL :
        SuzukiRootGL 0 0 1 * SuzukiWeylGL 0 =
          (1 : GL (Fin 4) (BinaryGaloisField 1)) := by
      simpa [suzukiZeroCentralInvolution,
        suzukiZeroWeyl] using congrArg Subtype.val hpair
    have h03 := congrArg
      (fun A : GL (Fin 4) (BinaryGaloisField 1) =>
        ((A : Matrix (Fin 4) (Fin 4) (BinaryGaloisField 1)) 0 3)) hGL
    have h10 : (1 : BinaryGaloisField 1) = 0 := by
      simp [SuzukiRootGL, SuzukiRootMatrix, SuzukiWeylGL,
        SuzukiWeylMatrix, Matrix.mul_apply, Fin.sum_univ_four] at h03
    exact one_ne_zero h10

/-- The degenerate concrete Suzuki group over `GF(2)` has order twenty. -/
public theorem suzukiZero_card :
    Nat.card (SuzukiMatrixGroup 0) = 20 := by
  let K := BinaryGaloisField 1
  let pi : K ≃+* K := iterateFrobeniusEquiv K 2 1
  have hpi : ∀ x : K, pi x = x ^ 2 := by
    intro x
    simpa [pi] using iterateFrobeniusEquiv_def K 2 1 x
  have hpiSq : ∀ x : K, pi (pi x) = x ^ 2 := by
    exact binaryGaloisField_tits_formula_sq 0 pi (by
      intro x
      simpa using hpi x)
  let F : Subgroup (GL (Fin 4) K) :=
    Subgroup.closure {A | ∃ a b : K, A = SuzukiRootGL 0 a b}
  let H : Subgroup (GL (Fin 4) K) :=
    Subgroup.closure {A | ∃ u : Kˣ, A = SuzukiTorusGL 0 u}
  let B : Subgroup (GL (Fin 4) K) := F ⊔ H
  have hFleG : F ≤ SuzukiMatrixGroup 0 := by
    dsimp only [F]
    rw [Subgroup.closure_le]
    intro A hA
    exact Subgroup.subset_closure (Or.inl hA)
  have hHbot : H = ⊥ := by
    apply bot_unique
    intro A hA
    rw [Subgroup.mem_bot]
    rcases (suzukiTorusGL_mem_closure_iff 0 A).mp hA with ⟨u, hu⟩
    have huOne : u = 1 := by
      apply Units.ext
      rcases binaryGaloisFieldOne_eq_zero_or_one (u : K) with
        hu0 | hu1
      · exact (u.ne_zero hu0).elim
      · simpa using hu1
    calc
      A = SuzukiTorusGL 0 u := hu
      _ = SuzukiTorusGL 0 1 := by rw [huOne]
      _ = 1 := suzukiTorusGL_one 0
  have hB : B = F := by
    dsimp only [B]
    rw [hHbot, sup_bot_eq]
  let toG : Sum suzukiZeroRootSubgroup
      (suzukiZeroRootSubgroup ×
        suzukiZeroRootSubgroup) → SuzukiMatrixGroup 0
    | Sum.inl r => r
    | Sum.inr z =>
        (z.1 : SuzukiMatrixGroup 0) * suzukiZeroWeyl * z.2
  have htoG : Function.Surjective toG := by
    intro g
    rcases suzukiMatrixGroup_bruhat_decomposition 0 pi hpiSq hpi
        (g : GL (Fin 4) K) g.property with
      hgB | ⟨b, f, hbB, hfF, hgbf⟩
    · have hgF : (g : GL (Fin 4) K) ∈ F := by
        rw [← hB]
        exact hgB
      let r : suzukiZeroRootSubgroup := ⟨g, hgF⟩
      exact ⟨Sum.inl r, rfl⟩
    · have hbF : b ∈ F := by
        rw [← hB]
        exact hbB
      let rb : suzukiZeroRootSubgroup :=
        ⟨⟨b, hFleG hbF⟩, hbF⟩
      let rf : suzukiZeroRootSubgroup :=
        ⟨⟨f, hFleG hfF⟩, hfF⟩
      refine ⟨Sum.inr (rb, rf), ?_⟩
      apply Subtype.ext
      simpa [toG, rb, rf, suzukiZeroWeyl, K] using hgbf.symm
  have hupper : Nat.card (SuzukiMatrixGroup 0) ≤ 20 := by
    calc
      Nat.card (SuzukiMatrixGroup 0) ≤
          Nat.card (Sum suzukiZeroRootSubgroup
            (suzukiZeroRootSubgroup ×
              suzukiZeroRootSubgroup)) :=
        Nat.card_le_card_of_surjective toG htoG
      _ = 20 := by simp [Nat.card_sum, Nat.card_prod,
        suzukiZeroRootSubgroup_card]
  have hfour : 4 ∣ Nat.card (SuzukiMatrixGroup 0) := by
    simpa [suzukiZeroRootGenerator_order] using
      orderOf_dvd_natCard suzukiZeroRootGenerator
  have hfive : 5 ∣ Nat.card (SuzukiMatrixGroup 0) := by
    simpa [suzukiZero_standard_pair_order] using
      orderOf_dvd_natCard
        (suzukiZeroCentralInvolution * suzukiZeroWeyl)
  have htwenty : 20 ∣ Nat.card (SuzukiMatrixGroup 0) := by
    simpa using
      (by norm_num : Nat.Coprime 4 5).mul_dvd_of_dvd_of_dvd hfour hfive
  have hlower : 20 ≤ Nat.card (SuzukiMatrixGroup 0) :=
    Nat.le_of_dvd Nat.card_pos htwenty
  omega

/-- The degenerate Suzuki matrix group `Sz(2)` is solvable. -/
public theorem suzukiZero_isSolvable : Group.IsSolvable (SuzukiMatrixGroup 0) :=
  Group.isSolvable_of_card_twenty suzukiZero_card

/-- A nonsolvable group cannot be isomorphic to `Sz(2)`. -/
public theorem not_nonempty_mulEquiv_suzukiZero
    {G : Type*} [Group G] (hG : ¬ Group.IsSolvable G) :
    ¬ Nonempty (G ≃* SuzukiMatrixGroup 0) := by
  rintro ⟨e⟩
  let : Group.IsSolvable (SuzukiMatrixGroup 0) := suzukiZero_isSolvable
  exact hG (Group.isSolvable_of_isSolvable_injective
    (f := e.toMonoidHom) e.injective)

end BenderSuzuki.MatrixGroups
