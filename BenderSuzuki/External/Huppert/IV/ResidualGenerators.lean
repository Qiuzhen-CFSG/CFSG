module

public import BenderSuzuki.External.Huppert.IV.Residual
public import BenderSuzuki.External.Hall.Basic

/-!
# Coprime-order generators of the p-residual

For a finite group and a prime `p`, the intersection-defined residual `O^p(G)`
is generated by the elements of order coprime to `p`. This identifies the
Huppert IV residual with Hall's subgroup `u_p(G)` from Hall, §14.4, and supplies
the generator description used in residual commutator arguments.

The proof uses the two universal properties already proved in the Hall API:
the Hall residual has a `p`-group quotient, while every map to a `p`-group
kills its generators. Apply the latter to the quotient by the Huppert residual.
-/

namespace BenderSuzuki.External

/-- In a finite group, the `p`-residual is generated by elements of order
coprime to `p`. -/
public theorem hktPResidual_eq_closure_coprime_orderOf
    {G : Type*} [Group G] [Finite G] {p : ℕ} [Fact p.Prime] :
    hktPResidual p G = Subgroup.closure {x : G | Nat.Coprime p (orderOf x)} := by
  change hktPResidual p G = hallPResidual p G
  apply le_antisymm
  · exact hktPResidual_le (hallPResidual p G) (hallPResidual_normal p G)
      (hallPResidual_quotient_isPGroup p)
  · let : (hktPResidual p G).Normal := hktPResidual_normal
    have h := hallPResidual_le_ker_of_isPGroup
      (QuotientGroup.mk' (hktPResidual p G))
      (hktPResidual_quotient_isPGroup (Q := G) (q := p))
    simpa only [QuotientGroup.ker_mk'] using h

end BenderSuzuki.External
