module

public import BenderSuzuki.External.Huppert.IV.ResidualGenerators
public import Theory.GroupTheory.PResidualCommutator

/-!
# Idempotence of residual commutator actions

For a finite p-subgroup `M` normalized by a subgroup `P`, the image of `O^p(P)`
acts idempotently on its commutator with `M`. In particular a normal p-subgroup
satisfies `[[M,O^p(G)],O^p(G)] = [M,O^p(G)]`.

The residual is generated by the elements of order coprime to p. Its generator
description and the generic coprime-generated action theorem give the result,
without assuming `M ≤ P`. These standard residual facts supply the algebraic
step in Stellmacher (1997), (9.1), relation (3).
-/

open Subgroup
open scoped commutatorElement

namespace BenderSuzuki.External

public theorem commutator_map_pResidual_idempotent_of_isPGroup
    {G : Type*} [Group G] [Finite G] (p : ℕ) [Fact p.Prime]
    (M P : Subgroup G) (hM : IsPGroup p M) (hPM : P ≤ normalizer M) :
    let R := (hktPResidual p P).map P.subtype
    ⁅⁅M,R⁆,R⁆ = ⁅M,R⁆ := by
  rw [hktPResidual_eq_closure_coprime_orderOf]
  exact commutator_coprime_order_generators_idempotent p M P hM hPM

public theorem commutator_pResidual_idempotent_of_normal_isPGroup
    {G : Type*} [Group G] [Finite G] (p : ℕ) [Fact p.Prime]
    (M : Subgroup G) [M.Normal] (hM : IsPGroup p M) :
    ⁅⁅M,hktPResidual p G⁆,hktPResidual p G⁆ = ⁅M,hktPResidual p G⁆ := by
  rw [hktPResidual_eq_closure_coprime_orderOf]
  apply commutator_closure_coprime_idempotent M
  · exact le_normalizer_of_normal
  · intro a ha
    obtain ⟨n, hn⟩ := (IsPGroup.iff_card (p := p)).mp hM
    rw [hn]
    exact ha.symm.pow_right n

end BenderSuzuki.External
