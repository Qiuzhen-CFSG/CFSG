public import Theory.SpecificGroups.Suzuki.OddSubgroups
public import Theory.SpecificGroups.Suzuki.NormalSubgroups
public import BenderSuzuki.SE.Final

/-!
# Strong embedding in nonsolvable Suzuki subgroups

Unique fixed points of involutions make the stabilizer of an involution
point strongly embedded. The root/torus partition excludes nontrivial
solvable normal subgroups. The subgroup generated by the involutions is
therefore simple. The proved strong-embedding theorem supplies double
transitivity on its involution points, which are also those of the original
subgroup.

This is an independent route to the orbit step behind Huppert--Blackburn,
*Finite Groups III*, XI.3.12(e), using the Bender--Suzuki strong-embedding
theory rather than a classification of subgroups of the ambient Suzuki group.
-/

namespace BenderSuzuki.External

open BenderSuzuki.MatrixGroups PFAppendixIII PFchapter1section1

/-- The stabilizer of a subgroup involution point is strongly embedded. -/
public theorem suzukiInvolutionSubaction_stabilizer_stronglyEmbedded
    {m : ℕ} (hm : 0 < m) (H : Subgroup (SuzukiMatrixGroup m))
    (hH : ¬ Group.IsSolvable H) (a : suzukiInvolutionSubaction H) :
    IsStronglyEmbedded (MulAction.stabilizer H a) := by
  let X := suzukiInvolutionSubaction H
  let M := MulAction.stabilizer H a
  have hproper : M ≠ ⊤ := by
    intro htop
    let := suzukiSubaction_stabilizer_isSolvable hm H X a
    let f : H →* M :=
      { toFun := fun g => ⟨g, by rw [htop]; trivial⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl }
    exact hH (Group.isSolvable_of_isSolvable_injective
      (f := f) (fun _ _ heq => congrArg Subtype.val heq))
  obtain ⟨t, ht, hta⟩ := a.property
  have htinv : IsInvolution t := by
    have h := (orderOf_eq_prime_iff (x := t) (p := 2)).mp ht
    exact ⟨h.2, h.1⟩
  refine ⟨hproper, ⟨t, Subtype.ext hta, htinv⟩, ?_⟩
  intro g hg x hxa hxg hxi
  have hxorder : orderOf (x : SuzukiMatrixGroup m) = 2 := by
    rw [Subgroup.orderOf_coe]
    exact orderOf_eq_prime hxi.sq_eq_one hxi.ne_one
  obtain ⟨c, _, hc⟩ := suzukiOvoid_involution_unique_fixed m hm x.val hxorder
  have hfixa : x.val • a.val = a.val := congrArg Subtype.val hxa
  have hfixg : x.val • (g.val⁻¹ • a.val) = g.val⁻¹ • a.val := by
    obtain ⟨y, hy, heq⟩ := hxg
    have hya : y.val • a.val = a.val := congrArg Subtype.val hy
    change g⁻¹ * y * g = x at heq
    rw [← heq]
    change (g.val⁻¹ * y.val * g.val) • (g.val⁻¹ • a.val) = g.val⁻¹ • a.val
    simp only [mul_smul, smul_inv_smul, hya]
  have hga : g.val⁻¹ • a.val = a.val := (hc _ hfixg).trans (hc _ hfixa).symm
  apply hg
  exact Subtype.ext (inv_smul_eq_iff.mp hga).symm

/-- The odd core of a nonsolvable Suzuki subgroup is trivial. -/
public theorem suzukiSubgroup_twoPrimeCore_eq_bot
    {m : ℕ} (hm : 0 < m) (H : Subgroup (SuzukiMatrixGroup m))
    (hH : ¬ Group.IsSolvable H) : twoPrimeCore H = ⊥ := by
  let O := twoPrimeCore H
  let U := O.map H.subtype
  have hodd : Odd (Nat.card U) := by
    rw [Subgroup.card_map_of_injective H.subtype_injective]
    exact Nat.coprime_two_left.mp (pPrimeCore_coprime_card (G := H) (p := 2))
  let := suzukiSubgroup_isSolvable_of_odd hm U hodd
  let e : O ≃* U := Subgroup.equivMapOfInjective O H.subtype H.subtype_injective
  let : Group.IsSolvable O :=
    Group.isSolvable_of_isSolvable_injective (f := e.toMonoidHom) e.injective
  exact suzukiSubgroup_solvable_normal_eq_bot hm H hH O

/-- A nonsolvable Suzuki subgroup generated by its involutions is simple. -/
public theorem suzukiSubgroup_isSimple_of_involutionCore_eq_top
    {m : ℕ} (hm : 0 < m) (H : Subgroup (SuzukiMatrixGroup m))
    (hH : ¬ Group.IsSolvable H) (hcore : involutionCore H = ⊤) :
    IsSimpleGroup H := by
  obtain ⟨t, ht⟩ := suzukiSubgroup_exists_involution hm H hH
  obtain ⟨a⟩ := suzukiInvolutionSubaction_nonempty hm H t ht
  have hM := suzukiInvolutionSubaction_stabilizer_stronglyEmbedded hm H hH a
  have hsimple := hM.isSimpleGroup_quotient_twoPrimeCore hcore
  let e : (H ⧸ twoPrimeCore H) ≃* H :=
    (QuotientGroup.quotientMulEquivOfEq (suzukiSubgroup_twoPrimeCore_eq_bot hm H hH)).trans
      (QuotientGroup.quotientBot (G := H))
  exact e.isSimpleGroup_congr.mp hsimple

private theorem two_pretransitive_of_simple_stabilizer_stronglyEmbedded
    {G Y : Type*} [Group G] [Finite G] [MulAction G Y]
    [MulAction.IsPretransitive G Y] (a : Y)
    (hG : IsSimpleGroup G) (hM : IsStronglyEmbedded (MulAction.stabilizer G a)) :
    MulAction.IsMultiplyPretransitive G Y 2 := by
  let M := MulAction.stabilizer G a
  have hcore := hM.involutionCore_eq_top_of_isSimple hG
  let e : involutionCore G ≃* G :=
    (MulEquiv.subgroupCongr hcore).trans Subgroup.topEquiv
  have hrank : TwoRankAtLeastTwo (involutionCore G) :=
    (simpleStronglyEmbeddedRankTwo M hG hM).map_of_injective
      e.symm.toMonoidHom e.symm.injective
  have htwo := hM.theorem4a_twoTransitive_of_section7 hG
    (rank_involutionCore_of_ambient_rank hM hrank)
    hM.theorem4bProposition63Theorem2
    (fun _K _ N hN => theorem_SE N hN)
  let f := MulAction.ofQuotientStabilizer G a
  have hsur : Function.Surjective f := by
    intro x
    obtain ⟨g, hg⟩ := MulAction.exists_smul_eq G a x
    exact ⟨QuotientGroup.mk g, hg⟩
  apply MulAction.is_two_pretransitive_iff.mpr
  intro x y z w hxy hzw
  obtain ⟨x', rfl⟩ := hsur x
  obtain ⟨y', rfl⟩ := hsur y
  obtain ⟨z', rfl⟩ := hsur z
  obtain ⟨w', rfl⟩ := hsur w
  obtain ⟨g, hgx, hgy⟩ := MulAction.is_two_pretransitive_iff.mp htwo
    (fun h => hxy (congrArg f h)) (fun h => hzw (congrArg f h))
  refine ⟨g, ?_, ?_⟩
  · exact (MulAction.ofQuotientStabilizer_smul G a g x').symm.trans (congrArg f hgx)
  · exact (MulAction.ofQuotientStabilizer_smul G a g y').symm.trans (congrArg f hgy)

/-- Double transitivity for a nonsolvable involution-generated Suzuki subgroup. -/
public theorem suzukiInvolutionSubaction_two_pretransitive_of_involutionCore_eq_top
    {m : ℕ} (hm : 0 < m) (H : Subgroup (SuzukiMatrixGroup m))
    (hH : ¬ Group.IsSolvable H) (hcore : involutionCore H = ⊤) :
    MulAction.IsMultiplyPretransitive H (suzukiInvolutionSubaction H) 2 := by
  obtain ⟨t, ht⟩ := suzukiSubgroup_exists_involution hm H hH
  obtain ⟨a⟩ := suzukiInvolutionSubaction_nonempty hm H t ht
  let := suzukiInvolutionSubaction_isPretransitive hm H
  exact two_pretransitive_of_simple_stabilizer_stronglyEmbedded a
    (suzukiSubgroup_isSimple_of_involutionCore_eq_top hm H hH hcore)
    (suzukiInvolutionSubaction_stabilizer_stronglyEmbedded hm H hH a)

/-- The involution points of every nonsolvable Suzuki subgroup form a
doubly transitive action. The simple involution-generated core already
acts doubly transitively on the same set of points. -/
public theorem suzukiInvolutionSubaction_two_pretransitive
    {m : ℕ} (hm : 0 < m) (H : Subgroup (SuzukiMatrixGroup m))
    (hH : ¬ Group.IsSolvable H) :
    MulAction.IsMultiplyPretransitive H (suzukiInvolutionSubaction H) 2 := by
  let : MulAction H (suzukiInvolutionSubaction H) :=
    SubMulAction.mulAction (suzukiInvolutionSubaction H)
  let C := involutionCore H
  let K := C.map H.subtype
  let : MulAction K (suzukiInvolutionSubaction K) :=
    SubMulAction.mulAction (suzukiInvolutionSubaction K)
  have hKH : K ≤ H := by
    rintro _ ⟨x, _, rfl⟩
    exact x.property
  have hinv (t : H) (ht : orderOf t = 2) : t ∈ C := by
    apply Subgroup.subset_closure
    have h := (orderOf_eq_prime_iff (x := t) (p := 2)).mp ht
    exact ⟨h.2, h.1⟩
  have hCne : C ≠ ⊥ := by
    obtain ⟨t, ht⟩ := suzukiSubgroup_exists_involution hm H hH
    intro hbot
    have hmem := hinv t ht
    rw [hbot, Subgroup.mem_bot] at hmem
    simp [hmem] at ht
  have hK : ¬ Group.IsSolvable K := by
    intro hsolv
    let : Group.IsSolvable K := hsolv
    let e : C ≃* K := Subgroup.equivMapOfInjective C H.subtype H.subtype_injective
    let : Group.IsSolvable C :=
      Group.isSolvable_of_isSolvable_injective (f := e.toMonoidHom) e.injective
    exact hH (suzukiSubgroup_isSolvable_of_solvable_normal hm H C hCne)
  have htwo := suzukiInvolutionSubaction_two_pretransitive_of_involutionCore_eq_top
    hm K hK (involutionCore_map_subtype_eq_top H)
  let f : suzukiInvolutionSubaction H → suzukiInvolutionSubaction K := fun a =>
    ⟨a.val, by
      obtain ⟨t, ht, hta⟩ := a.property
      let u : K := ⟨t.val, ⟨t, hinv t ht, rfl⟩⟩
      refine ⟨u, ?_, hta⟩
      exact (Subgroup.orderOf_coe u).symm.trans ((Subgroup.orderOf_coe t).trans ht)⟩
  have hfinj : Function.Injective f := by
    intro x y h
    exact Subtype.ext (congrArg (fun z : suzukiInvolutionSubaction K => z.val) h)
  apply MulAction.is_two_pretransitive_iff.mpr
  intro a b c d hab hcd
  obtain ⟨g, hga, hgb⟩ := MulAction.is_two_pretransitive_iff.mp htwo
    (fun h => hab (hfinj h)) (fun h => hcd (hfinj h))
  exact ⟨⟨g.val, hKH g.property⟩,
    Subtype.ext (congrArg (fun z : suzukiInvolutionSubaction K => z.val) hga),
    Subtype.ext (congrArg (fun z : suzukiInvolutionSubaction K => z.val) hgb)⟩

end BenderSuzuki.External
