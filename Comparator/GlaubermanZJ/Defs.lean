module

public import Mathlib.GroupTheory.Sylow
public import Mathlib.GroupTheory.Solvable

namespace ZJ

variable {G : Type*} [Group G]

/-- The Thompson subgroup `J(P)`: the subgroup generated by the abelian subgroups
of `P` of maximal order. -/
@[expose] public def thompsonSubgroup (P : Subgroup G) : Subgroup G :=
  sSup {A : Subgroup G | A ≤ P ∧ IsMulCommutative A ∧
    ∀ B : Subgroup G, B ≤ P → IsMulCommutative B → Nat.card B ≤ Nat.card A}

/-- The `p'`-core `O_{p'}(G)`: the supremum of the normal subgroups of order
coprime to `p`. -/
@[expose] public def pPrimeCore (p : ℕ) (G : Type*) [Group G] : Subgroup G :=
  sSup {K : Subgroup G | K.Normal ∧ Nat.Coprime p (Nat.card K)}

end ZJ
