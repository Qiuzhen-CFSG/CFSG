module
public import GorensteinWalter.CentralIndexTwoComparison
public import Theory.GroupTheory.CentralTwoSquareAlignment

/-!
# PGL2 central extensions from actual exterior-square generators

Consider two central two-covers of the same odd-field PGL2, and a
projectively compatible equivalence of their actual inverse-image PSL2
layers. If chosen exterior elements are both involutions, or their squares
generate the corresponding nontrivial kernels, the equivalence extends to
the full groups. The source layer is generated by its kernel and a subgroup
without a normal subgroup of index two. Every odd field, including three
and nine, is retained.

Projective compatibility identifies the kernels under the given layer
equivalence. In the cyclic-kernel case, the image of the source square
therefore generates the target kernel. The odd-power square-alignment
theorem replaces the target exterior element by one with precisely that
square. The established PGL2 comparison then aligns its projective
conjugation action and constructs the ambient equivalence. In the
involution case the squares already agree.

This assembles the exterior comparison in Alperin--Brauer--Gorenstein
II.3 Proposition 3, article pp26–27. Neither matched exterior squares nor
matching conjugation actions are hypotheses of this endpoint.
-/

namespace GorensteinWalter

public theorem exists_mulEquiv_cyclic_square_extensions
    {G H K : Type*} [Group G] [Finite G] [Group H] [Finite H] [Field K] [Finite K]
    (hK : IsOddPrimePower (Nat.card K))
    (f : G →* PGL2 K) (g : H →* PGL2 K)
    (hf : Function.Surjective f) (hg : Function.Surjective g)
    (hfcentral : f.ker ≤ Subgroup.center G) (hfprime : IsPGroup 2 f.ker)
    (hgcentral : g.ker ≤ Subgroup.center H) (hgprime : IsPGroup 2 g.ker)
    (N : Subgroup G) (N' : Subgroup H) [N.Normal] [N'.Normal]
    (hN : N = (Matrix.ProjectiveSpecialLinearGroup.toPGL (n := Fin 2) (R := K)).range.comap f)
    (hN' : N' = (Matrix.ProjectiveSpecialLinearGroup.toPGL (n := Fin 2) (R := K)).range.comap g)
    (eN : N ≃* N') (heN : ∀ n : N, g (eN n) = f n)
    (L0 : Subgroup G) (hno : ∀ M : Subgroup L0, M.Normal → M.index ≠ 2)
    (hjoin : f.ker ⊔ L0 = N)
    (a : G) (b : H) (ha : a ∉ N) (hb : b ∉ N')
    (hsquares : (a ^ 2 = 1 ∧ b ^ 2 = 1) ∨
      (g.ker ≠ ⊥ ∧ Subgroup.zpowers (a ^ 2) = f.ker ∧
        Subgroup.zpowers (b ^ 2) = g.ker)) :
    ∃ e : G ≃* H, ∀ n : N, e n = (eN n : H) := by
  have hkernel : (f.ker.subgroupOf N).map eN.toMonoidHom = g.ker.subgroupOf N' := by
    ext x
    constructor
    · rintro ⟨y, hy, rfl⟩
      change g (eN y) = 1
      rw [heN]
      exact hy
    · intro hx
      refine ⟨eN.symm x, ?_, eN.apply_symm_apply x⟩
      change f (eN.symm x) = 1
      rw [← heN, eN.apply_symm_apply]
      exact hx
  have hkerN : f.ker ≤ N := by rw [← hjoin]; exact le_sup_left
  have hkerN' : g.ker ≤ N' := by
    rw [hN']
    intro x hx
    change g x ∈ (Matrix.ProjectiveSpecialLinearGroup.toPGL (n := Fin 2) (R := K)).range
    rw [show g x = 1 from hx]
    exact Subgroup.one_mem _
  rcases hsquares with ⟨hasq, hbsq⟩ | ⟨hne, hasq, hbsq⟩
  · exact exists_mulEquiv_central_index_two_extensions hK f g hf hg hfcentral hfprime
      hgcentral hgprime N N' hN hN' eN heN L0 hno hjoin a b ha hb
      (hasq ▸ f.ker.one_mem) (hbsq ▸ g.ker.one_mem) (by
        have he : (⟨a ^ 2, hkerN (hasq ▸ f.ker.one_mem)⟩ : N) = 1 := Subtype.ext hasq
        rw [he, map_one, hbsq]
        rfl)
  · have haC : a ^ 2 ∈ f.ker := hasq ▸ Subgroup.mem_zpowers _
    let a2 : N := ⟨a ^ 2, hkerN haC⟩
    let c : H := eN a2
    have hc : Subgroup.zpowers c = g.ker := by
      have hsrc : Subgroup.zpowers a2 = f.ker.subgroupOf N := by
        apply Subgroup.map_injective N.subtype_injective
        rw [MonoidHom.map_zpowers, Subgroup.map_subgroupOf_eq_of_le hkerN]
        exact hasq
      have he : (Subgroup.zpowers a2).map (N'.subtype.comp eN.toMonoidHom) = g.ker := by
        rw [← Subgroup.map_map, hsrc, hkernel, Subgroup.map_subgroupOf_eq_of_le hkerN']
      rw [MonoidHom.map_zpowers] at he
      exact he
    obtain ⟨k, _hkodd, hbk, hsq⟩ := Subgroup.exists_exterior_pow_square_eq_generator
      N' g.ker hkerN' hne hgprime b c hb hbsq hc
    have hcC : c ∈ g.ker := hc ▸ Subgroup.mem_zpowers _
    exact exists_mulEquiv_central_index_two_extensions hK f g hf hg hfcentral hfprime
      hgcentral hgprime N N' hN hN' eN heN L0 hno hjoin a (b ^ k) ha hbk
      haC (hsq ▸ hcC) hsq.symm

end GorensteinWalter

