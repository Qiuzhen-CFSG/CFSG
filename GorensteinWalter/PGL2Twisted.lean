module
public import GorensteinWalter.PGammaL2OuterProduct
public import Theory.GroupTheory.PGroup.CyclicInvolution

/-!
# The mixed projective semilinear index-two model

Over a finite odd-prime-power field K, the actual outer quotient of PGammaL2
is the product of PGL2/PSL2 with the coefficient automorphism group. For a
nonidentity linear outer class z and a coefficient automorphism σ of order
two, define PGL*(2,K) as the inverse image of the subgroup generated by
(z, σ). `PGL2Twisted K z σ` is the carrier of that actual subgroup, with its
inherited group structure and finiteness. The inverse-image construction is
defined for any pair; the PGL* specifications require the stated nonidentity
and order-two conditions.

The outer map is surjective with kernel the canonical PSL2 range. Its
restriction to this inverse image therefore has image exactly the mixed
involution subgroup, whose order is two. The kernel/image cardinality formula
gives the relative index two. The canonical PSL2 subgroup is contained and
normal, and membership is characterized by the two possible outer images.
The linear quotient has order two and the coefficient automorphism group is
cyclic, so their specified involutions are unique; the model subgroup is
independent of both choices.

Source: Alperin--Brauer--Gorenstein II.2, article p20 / PDF21, defines PGL*
as the third subgroup above PSL2 of relative index two; II.3 Proposition 4,
article p29 / PDF30, uses this mixed outer subgroup after excluding the pure
linear and pure field alternatives. No semidihedral Sylow conclusion, field
square conclusion, or classification of all such subgroups is assumed here.
Those remain separate mathematical steps using this exact model.
-/

namespace GorensteinWalter
universe u
variable (K : Type u) [Field K] [Finite K] [Fact (IsOddPrimePower (Nat.card K))]

/-- The inverse image of the subgroup generated by the supplied outer pair. -/
@[expose] public def pgl2TwistedSubgroup
    (z : PGL2 K ⧸ (Matrix.ProjectiveSpecialLinearGroup.toPGL (n := Fin 2) (R := K)).range)
    (σ : K ≃+* K) : Subgroup (PGammaL2 K) :=
  (Subgroup.zpowers (z, σ)).comap (pGammaL2OuterProduct K)

/-- The actual group carrier of the mixed inverse-image subgroup. -/
public abbrev PGL2Twisted
    (z : PGL2 K ⧸ (Matrix.ProjectiveSpecialLinearGroup.toPGL (n := Fin 2) (R := K)).range)
    (σ : K ≃+* K) := ↥(pgl2TwistedSubgroup K z σ)

variable {K}
variable (z : PGL2 K ⧸ (Matrix.ProjectiveSpecialLinearGroup.toPGL (n := Fin 2) (R := K)).range)
    (σ : K ≃+* K)

public instance pgl2Twisted_finite : Finite (PGL2Twisted K z σ) := by
  let : Fintype K := Fintype.ofFinite K
  let : Finite (PGL2 K) := Finite.of_surjective Matrix.ProjGenLinGroup.mk
    Matrix.ProjGenLinGroup.mk_surjective
  let : Finite (K ≃+* K) := Finite.of_injective
    (fun e : K ≃+* K => (e : K → K)) (by
      intro e f h
      ext x
      exact congrFun h x)
  exact Finite.of_injective
    (fun x : PGL2Twisted K z σ => (x.val.left, x.val.right)) (by
      intro x y h
      exact Subtype.ext (SemidirectProduct.ext (congrArg Prod.fst h) (congrArg Prod.snd h)))

private theorem diagonal_order_two (hz : z ≠ 1) : orderOf z = 2 := by
  have hc : Nat.card (PGL2 K ⧸
      (Matrix.ProjectiveSpecialLinearGroup.toPGL (n := Fin 2) (R := K)).range) = 2 :=
    pgl2_psl2Range_index_eq_two K Fact.out
  have hd : orderOf z ∣ 2 := by
    simpa only [hc] using (orderOf_dvd_natCard (x := z))
  exact ((Nat.dvd_prime Nat.prime_two).mp hd).resolve_left
    (fun ho => hz (orderOf_eq_one_iff.mp ho))

private theorem mixed_order_two (hz : z ≠ 1) (hσ : orderOf σ = 2) :
    orderOf (z, σ) = 2 := by
  rw [Prod.orderOf_mk, diagonal_order_two z hz, hσ, Nat.lcm_self]

public theorem pgl2Twisted_psl_le : pGammaL2PSLRange K ≤ pgl2TwistedSubgroup K z σ := by
  rw [← pGammaL2OuterProduct_ker K]
  intro x hx
  change pGammaL2OuterProduct K x ∈ Subgroup.zpowers (z, σ)
  rw [MonoidHom.mem_ker.mp hx]
  exact (Subgroup.zpowers (z, σ)).one_mem

public theorem pgl2Twisted_outer_image :
    (pgl2TwistedSubgroup K z σ).map (pGammaL2OuterProduct K) = Subgroup.zpowers (z, σ) :=
  Subgroup.map_comap_eq_self_of_surjective (pGammaL2OuterProduct_surjective K) _

/-- The mixed outer involution extends the canonical PSL2 layer by index two. -/
public theorem pgl2Twisted_psl_relIndex (hz : z ≠ 1) (hσ : orderOf σ = 2) :
    (pGammaL2PSLRange K).relIndex (pgl2TwistedSubgroup K z σ) = 2 := by
  rw [← pGammaL2OuterProduct_ker K, Subgroup.relIndex_ker,
    pgl2Twisted_outer_image, Nat.card_zpowers, mixed_order_two z σ hz hσ]

public instance pgl2Twisted_psl_normal :
    ((pGammaL2PSLRange K).subgroupOf (pgl2TwistedSubgroup K z σ)).Normal := by
  rw [← pGammaL2OuterProduct_ker K]
  exact Subgroup.normal_comap _

public theorem mem_pgl2TwistedSubgroup_iff (hz : z ≠ 1) (hσ : orderOf σ = 2)
    (g : PGammaL2 K) :
    g ∈ pgl2TwistedSubgroup K z σ ↔
      pGammaL2OuterProduct K g = 1 ∨ pGammaL2OuterProduct K g = (z, σ) := by
  classical
  change pGammaL2OuterProduct K g ∈ Subgroup.zpowers (z, σ) ↔ _
  have ho := mixed_order_two z σ hz hσ
  have hfin : IsOfFinOrder (z, σ) := orderOf_pos_iff.mp (by rw [ho]; decide)
  rw [hfin.mem_zpowers_iff_mem_range_orderOf, ho]
  simp only [Finset.mem_image, Finset.mem_range]
  constructor
  · rintro ⟨n, hn, he⟩
    rcases (show n = 0 ∨ n = 1 by omega) with rfl | rfl
    · exact Or.inl (by simpa using he.symm)
    · exact Or.inr (by simpa using he.symm)
  · rintro (he | he)
    · exact ⟨0, by decide, by simpa using he.symm⟩
    · exact ⟨1, by decide, by simpa using he.symm⟩

public theorem pgl2TwistedSubgroup_eq_of_choices
    {z' : PGL2 K ⧸ (Matrix.ProjectiveSpecialLinearGroup.toPGL (n := Fin 2) (R := K)).range}
    {σ' : K ≃+* K} (hz : z ≠ 1) (hz' : z' ≠ 1)
    (hσ : orderOf σ = 2) (hσ' : orderOf σ' = 2) :
    pgl2TwistedSubgroup K z σ = pgl2TwistedSubgroup K z' σ' := by
  let : Finite (K ≃+* K) := Finite.of_injective
    (fun e : K ≃+* K => (e : K → K)) (by
      intro e f h
      ext x
      exact congrFun h x)
  let : IsCyclic (K ≃+* K) := finiteField_ringAut_isCyclic_of_oddPrimePower K Fact.out
  have heσ : σ = σ' := IsCyclic.eq_of_orderOf_eq_two hσ hσ'
  have hc : Nat.card (PGL2 K ⧸
      (Matrix.ProjectiveSpecialLinearGroup.toPGL (n := Fin 2) (R := K)).range) = 2 :=
    pgl2_psl2Range_index_eq_two K Fact.out
  let : Finite (PGL2 K ⧸
      (Matrix.ProjectiveSpecialLinearGroup.toPGL (n := Fin 2) (R := K)).range) :=
    Nat.finite_of_card_ne_zero (by rw [hc]; decide)
  let : IsCyclic (PGL2 K ⧸
      (Matrix.ProjectiveSpecialLinearGroup.toPGL (n := Fin 2) (R := K)).range) :=
    isCyclic_of_prime_card hc
  have hez : z = z' := IsCyclic.eq_of_orderOf_eq_two
    (diagonal_order_two z hz) (diagonal_order_two z' hz')
  rw [hez, heσ]

end GorensteinWalter
