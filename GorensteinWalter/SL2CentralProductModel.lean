module
public import Theory.SpecificGroups.GL2.TwoPowerScalar
public import Theory.SpecificGroups.GL2.DeterminantTwoPowerCentralProduct
public import Theory.GroupTheory.CyclicCentralProductEquivalence
public import GorensteinWalter.SL2ProjectiveCover

/-!
# The determinant model of a cyclic central extension of SL2

A finite group generated by a central cyclic subgroup of order 2^(m+1) and
an odd-field SL2 subgroup, meeting in order two, is isomorphic to the actual
determinant level m whenever 2^(m+1) divides the field order minus one.
The resulting equivalence preserves the specified SL2 map as the canonical
determinant-one matrix inclusion. Fields of order three and nine are included.

The concrete model is generated by its scalar roots of unity and determinant
kernel. Their orders, centrality and two-element intersection are already
proved. Restrict these actual subgroups to the determinant level; identify
the kernel with SL2 and match the cyclic factors by cardinality. The cyclic
central-product equivalence then supplies an isomorphism extending both maps.

This is the linear central-product recognition in ABG II.3 Proposition 3,
article p.26, using II.2 Lemma 1(v). Generic gluing and matrix decomposition
live in Theory; this consumer uses the established Gorenstein--Walter
canonical SL2 center calculation.
-/

namespace Matrix.SpecialLinearGroup
open Matrix.GeneralLinearGroup

public theorem exists_mulEquiv_determinantTwoPower_of_central_product
    {H : Type*} [Group H] [Finite H]
    (F : Type*) [Field F] [Finite F] (hodd : Odd (Nat.card F))
    (m : ℕ) (hd : 2 ^ (m + 1) ∣ Nat.card F - 1)
    (Z L : Subgroup H) [IsCyclic Z]
    (hZ : Z ≤ Subgroup.center H) (hgen : Z ⊔ L = ⊤)
    (hZcard : Nat.card Z = 2 ^ (m + 1))
    (hi : Nat.card (Z ⊓ L : Subgroup H) = 2)
    (eL : L ≃* Matrix.SpecialLinearGroup (Fin 2) F) :
    ∃ e : H ≃* determinantTwoPower F m,
      ∀ l : L, (e l).val = Matrix.SpecialLinearGroup.toGL (eL l) := by
  let D := determinantTwoPower F m
  let C := (rootsOfUnity (2 ^ (m + 1)) F).map (GeneralLinearGroup.scalar (Fin 2))
  let K := (GeneralLinearGroup.det : GL (Fin 2) F →* Fˣ).ker
  have hsup : C ⊔ K = D :=
    (determinantTwoPower_eq_scalar_sup_kernel F hodd m hd).symm
  have hCD : C ≤ D := hsup ▸ le_sup_left
  have hKD : K ≤ D := hsup ▸ le_sup_right
  let C' := C.subgroupOf D
  let K' := K.subgroupOf D
  let eC : C' ≃* C := Subgroup.subgroupOfEquivOfLe hCD
  let eK : K' ≃* K := Subgroup.subgroupOfEquivOfLe hKD
  obtain ⟨hcyc, hc, hcent, hI⟩ := twoPowerScalar_structure F hodd m hd
  let : IsCyclic C := hcyc
  let : IsCyclic C' := eC.isCyclic.mpr hcyc
  let eZ : Z ≃* C' := mulEquivOfCyclicCardEq
    (hZcard.trans (((Nat.card_congr eC.toEquiv).trans hc).symm))
  let eKSL : K' ≃* Matrix.SpecialLinearGroup (Fin 2) F :=
    eK.trans ((MulEquiv.subgroupCongr (determinantTwoPower_zero F).symm).trans
      (determinantTwoPowerZeroEquivSL F))
  let eL' : L ≃* K' := eL.trans eKSL.symm
  have hCcent : C' ≤ Subgroup.center D := by
    intro c hc'
    apply Subgroup.mem_center_iff.mpr
    intro d
    exact Subtype.ext (Subgroup.mem_center_iff.mp (hcent hc') d)
  have hgen' : C' ⊔ K' = ⊤ := by
    apply Subgroup.map_injective D.subtype_injective
    rw [Subgroup.map_sup, Subgroup.map_subgroupOf_eq_of_le hCD,
      Subgroup.map_subgroupOf_eq_of_le hKD, ← MonoidHom.range_eq_map, D.range_subtype]
    exact hsup
  have hIc : Nat.card (C' ⊓ K' : Subgroup D) = 2 := by
    rw [← Subgroup.card_map_of_injective (K := C' ⊓ K') D.subtype_injective,
      Subgroup.map_inf _ _ _ D.subtype_injective,
      Subgroup.map_subgroupOf_eq_of_le hCD, Subgroup.map_subgroupOf_eq_of_le hKD]
    exact hI
  have hLc : Nat.card (Subgroup.center L) = 2 := by
    rw [Nat.card_congr (Subgroup.centerCongr eL).toEquiv,
      ← GorensteinWalter.sl2ProjectiveProjection_ker F]
    exact GorensteinWalter.sl2ProjectiveProjection_ker_card F hodd
  obtain ⟨e, _heZ, heL⟩ :=
    Subgroup.exists_mulEquiv_of_cyclic_central_products Z L C' K'
      hZ hCcent hgen hgen' hLc hi hIc eZ eL'
  refine ⟨e, ?_⟩
  intro l
  have hval := congrArg Subtype.val (heL l)
  let k0 : determinantTwoPower F 0 :=
    MulEquiv.subgroupCongr (determinantTwoPower_zero F).symm (eK (eL' l))
  have hE : determinantTwoPowerZeroEquivSL F k0 = eL l :=
    eKSL.apply_symm_apply (eL l)
  have hmatrix := determinantTwoPowerZeroEquivSL_toGL F k0
  rw [hE] at hmatrix
  exact hval.trans hmatrix.symm

end Matrix.SpecialLinearGroup

