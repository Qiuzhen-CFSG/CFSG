module

public import GorensteinWalter.ASevenOddClosureDefs
import Mathlib.Tactic

/-!
# First-round odd-closure coverage in A₇

Every element passing `a7OddClosureTest 1` belongs to the unchanged explicit
71-element candidate list. This is the coverage half of the finite calculation
for ABG II.5 Lemma9(i), article p49 (PDF page50); the subgroup-family notation
is on article p7. The separate elimination module handles the second round.
No subgroup classification or stronger four-subgroup assertion is assumed.

First, odd cycle lengths on seven letters imply that each point is fixed by
one of the third, fifth, and seventh powers: a nontrivial odd cycle has length
3, 5, or 7. Apply this necessary pointwise condition to the original element
and to each product appearing in its first-round test.

Mathlib's `permsOfList` exhausts the existing permutation type. Splitting its
first two recursive steps gives 42 slices of 120 permutations. Each slice has
a base-256 packed certificate, consumed least-significant byte first. A byte
below 71 selects an equality with that entry of the production candidate list.
Otherwise, subtracting 71 encodes a point modulo 7 and an operation: operation
zero is the original permutation; the remaining sixteen operations are the
two tested products for each of the eight production Sylow actors. The selected
point is not fixed by any of the third, fifth, or seventh powers of that word,
contradicting the necessary condition. The verifier's soundness is proved by
list induction, and each slice is checked by kernel reduction.

The certificate bytes were proposed by a finite Python experiment, preserved
in the task's scratch directory. Neither the experiment nor its enumeration
is trusted: the proof checks every claim against the production definitions,
and Mathlib supplies exhaustiveness. All helper predicates concern the
original permutations; the `A7` model, actors, test, and candidate list are
not redefined or changed.
-/

namespace GorensteinWalter

private def pointTest (perm : Equiv.Perm (Fin 7)) : Prop :=
  ∀ point : Fin 7, (perm ^ 3) point = point ∨
    (perm ^ 5) point = point ∨ (perm ^ 7) point = point

private instance (perm : Equiv.Perm (Fin 7)) : Decidable (pointTest perm) :=
  inferInstanceAs (Decidable (∀ point : Fin 7, (perm ^ 3) point = point ∨
    (perm ^ 5) point = point ∨ (perm ^ 7) point = point))

private theorem pointTest_of_odd (perm : Equiv.Perm (Fin 7))
    (hodd : ∀ length ∈ perm.cycleType, Odd length) : pointTest perm := by
  intro point
  by_cases hfix : perm point = point
  · left
    simp [pow_succ, Equiv.Perm.mul_apply, hfix]
  · have hcycle := Equiv.Perm.isCycle_cycleOf perm hfix
    have hmem : (perm.cycleOf point).support.card ∈ perm.cycleType := by
      rw [Equiv.Perm.cycleType_def]
      refine Multiset.mem_map.mpr ⟨perm.cycleOf point, ?_, rfl⟩
      exact (Equiv.Perm.cycleOf_mem_cycleFactorsFinset_iff).mpr
        (Equiv.Perm.mem_support.mpr hfix)
    have hbound : (perm.cycleOf point).support.card ≤ 7 := by
      simpa using Finset.card_le_univ (perm.cycleOf point).support
    have hlower := Equiv.Perm.two_le_of_mem_cycleType hmem
    have hlength := hodd _ hmem
    have hcases : (perm.cycleOf point).support.card = 3 ∨
        (perm.cycleOf point).support.card = 5 ∨
        (perm.cycleOf point).support.card = 7 := by
      obtain ⟨half, hhalf⟩ := hlength
      omega
    have hpow : (perm ^ (perm.cycleOf point).support.card) point = point := by
      rw [← hcycle.orderOf, ← Equiv.Perm.cycleOf_pow_apply_self]
      simp
    rcases hcases with hthree | hfive | hseven
    · exact Or.inl (by simpa only [hthree] using hpow)
    · exact Or.inr (Or.inl (by simpa only [hfive] using hpow))
    · exact Or.inr (Or.inr (by simpa only [hseven] using hpow))

private def roundTest (perm : Equiv.Perm (Fin 7)) : Prop :=
  pointTest perm ∧ ∀ index : Fin 8,
    pointTest (perm * ((a7OddClosureActors index : Equiv.Perm (Fin 7)) * perm *
      (a7OddClosureActors index : Equiv.Perm (Fin 7))⁻¹)) ∧
    pointTest (perm * ((a7OddClosureActors index : Equiv.Perm (Fin 7)) * perm⁻¹ *
      (a7OddClosureActors index : Equiv.Perm (Fin 7))⁻¹))

private instance (perm : Equiv.Perm (Fin 7)) : Decidable (roundTest perm) := by
  unfold roundTest
  infer_instance

private theorem roundTest_of_test (element : A7) (htest : a7OddClosureTest 1 element) :
    roundTest (element : Equiv.Perm (Fin 7)) := by
  refine ⟨pointTest_of_odd _ htest.1, fun index => ⟨?_, ?_⟩⟩
  · exact pointTest_of_odd _ (htest.2 index).1
  · exact pointTest_of_odd _ (htest.2 index).2

private theorem candidate_of_coe_mem (element : A7)
    (hmem : (element : Equiv.Perm (Fin 7)) ∈ a7OddClosureCandidates.map Subtype.val) :
    element ∈ a7OddClosureCandidates := by
  obtain ⟨candidate, hcandidate, heq⟩ := List.mem_map.mp hmem
  exact Subtype.ext heq ▸ hcandidate

private def witnessWord (perm : Equiv.Perm (Fin 7)) (operation : Fin 17) :
    Equiv.Perm (Fin 7) :=
  if operation = 0 then perm else
    let actor := (a7OddClosureActors (Fin.ofNat 8 ((operation.val - 1) / 2)) :
      Equiv.Perm (Fin 7))
    if operation.val % 2 = 1 then perm * (actor * perm * actor⁻¹)
    else perm * (actor * perm⁻¹ * actor⁻¹)

private theorem witnessWord_good (perm : Equiv.Perm (Fin 7))
    (htest : roundTest perm) (operation : Fin 17) : pointTest (witnessWord perm operation) := by
  unfold witnessWord
  split
  · exact htest.1
  · split
    · exact (htest.2 _).1
    · exact (htest.2 _).2

private instance : Inhabited A7 := ⟨1⟩

private def certificateClaim (perm : Equiv.Perm (Fin 7)) (code : ℕ) : Prop :=
  if code < 71 then perm = (a7OddClosureCandidates[code]! : A7).val else
    let word := witnessWord perm (Fin.ofNat 17 ((code - 71) / 7))
    let point := Fin.ofNat 7 (code - 71)
    ¬ ((word ^ 3) point = point ∨ (word ^ 5) point = point ∨ (word ^ 7) point = point)

private instance (perm : Equiv.Perm (Fin 7)) (code : ℕ) : Decidable (certificateClaim perm code) := by
  unfold certificateClaim
  infer_instance

private theorem certificateClaim_sound (perm : Equiv.Perm (Fin 7)) (code : ℕ)
    (hclaim : certificateClaim perm code) (htest : roundTest perm) :
    perm ∈ a7OddClosureCandidates.map Subtype.val := by
  unfold certificateClaim at hclaim
  split at hclaim
  next hbound =>
    have hlen : a7OddClosureCandidates.length = 71 := by rfl
    have hindex : code < a7OddClosureCandidates.length := by omega
    rw [getElem!_pos a7OddClosureCandidates code hindex] at hclaim
    exact List.mem_map.mpr ⟨_, List.getElem_mem hindex, hclaim.symm⟩
  next => exact False.elim (hclaim (witnessWord_good perm htest _ _))

private def verify (transform : Equiv.Perm (Fin 7) → Equiv.Perm (Fin 7)) :
    List (Equiv.Perm (Fin 7)) → ℕ → Bool
  | [], _ => true
  | perm :: perms, codes => decide (certificateClaim (transform perm) (codes % 256)) &&
      verify transform perms (codes / 256)

private theorem verify_sound (transform : Equiv.Perm (Fin 7) → Equiv.Perm (Fin 7))
    (perms : List (Equiv.Perm (Fin 7))) (codes : ℕ)
    (hverify : verify transform perms codes = true) :
    ∀ perm ∈ perms, roundTest (transform perm) →
      transform perm ∈ a7OddClosureCandidates.map Subtype.val := by
  induction perms generalizing codes with
  | nil => simp
  | cons first rest ih =>
    obtain ⟨hfirst, hrest⟩ := Bool.and_eq_true_iff.mp hverify
    intro perm hmem htest
    rcases List.mem_cons.mp hmem with rfl | hmem
    · exact certificateClaim_sound _ _ (of_decide_eq_true hfirst) htest
    · exact ih _ hrest perm hmem htest

