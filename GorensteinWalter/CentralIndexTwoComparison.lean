module
public import GorensteinWalter.PGL2CanonicalOuterInvolutionFusion
public import Theory.GroupTheory.CentralKernelConjugation
public import Theory.GroupTheory.IndexTwoExtensionEquivalence

/-!
# Comparing central index-two extensions over PGL2

Consider two finite groups surjecting onto the same PGL2 over an odd finite
field, with central two-group kernels. An equivalence between the actual
inverse images of the canonical PSL2 subgroup extends to the ambient groups
when it preserves their projective maps and matches the central squares of
chosen exterior elements. The source inverse image must be generated by its
kernel and a subgroup with no normal subgroup of index two. The extended
equivalence preserves the given subgroup map; the target exterior element
may be replaced by a conjugate.

The projective exterior elements are involutions outside the canonical PSL2
image. The proved all-field fusion theorem makes them conjugate, including
field orders three and nine. Lift the projective conjugator to the target
group; its conjugation preserves the exterior square by centrality. The
generic central-kernel action-comparison theorem then aligns the conjugation
actions on the inverse-image subgroups. Their indices are two, so the proved
index-two extension theorem supplies the required ambient equivalence.

This is the model-comparison step in ABG II.3 Proposition 3, article pages
26–27. The projective compatibility, actual generating subgroup, and matched
square are explicit inputs; no agreement of the exterior actions or desired
ambient equivalence is assumed.
-/

namespace GorensteinWalter

public theorem exists_mulEquiv_central_index_two_extensions
    {G H K : Type*} [Group G] [Finite G] [Group H] [Finite H] [Field K] [Finite K]
    (hK : IsOddPrimePower (Nat.card K))
    (f : G →* PGL2 K) (g : H →* PGL2 K)
    (hf : Function.Surjective f) (hg : Function.Surjective g)
    (hfcentral : f.ker ≤ Subgroup.center G) (_hfprime : IsPGroup 2 f.ker)
    (hgcentral : g.ker ≤ Subgroup.center H) (hgprime : IsPGroup 2 g.ker)
    (N : Subgroup G) (N' : Subgroup H) [N.Normal] [N'.Normal]
    (hN : N = (Matrix.ProjectiveSpecialLinearGroup.toPGL (n := Fin 2) (R := K)).range.comap f)
    (hN' : N' = (Matrix.ProjectiveSpecialLinearGroup.toPGL (n := Fin 2) (R := K)).range.comap g)
    (eN : N ≃* N') (heN : ∀ n : N, g (eN n) = f n)
    (L0 : Subgroup G) (hno : ∀ M : Subgroup L0, M.Normal → M.index ≠ 2)
    (hjoin : f.ker ⊔ L0 = N)
    (a : G) (a' : H) (ha : a ∉ N) (ha' : a' ∉ N')
    (hasq : a ^ 2 ∈ f.ker) (ha'sq : a' ^ 2 ∈ g.ker)
    (hsq : (eN ⟨a ^ 2, by
      rw [← hjoin]
      exact (show f.ker ≤ f.ker ⊔ L0 from le_sup_left) hasq⟩ : H) = a' ^ 2) :
    ∃ e : G ≃* H, ∀ n : N, e n = (eN n : H) := by
  let J := (Matrix.ProjectiveSpecialLinearGroup.toPGL (n := Fin 2) (R := K)).range
  have hi : N.index = 2 := by
    rw [hN]
    exact (J.index_comap_of_surjective hf).trans (pgl2_psl2Range_index_eq_two K hK)
  have hi' : N'.index = 2 := by
    rw [hN']
    exact (J.index_comap_of_surjective hg).trans (pgl2_psl2Range_index_eq_two K hK)
  have hfa : f a ∉ J := by simpa only [hN, Subgroup.mem_comap] using ha
  have hga' : g a' ∉ J := by simpa only [hN', Subgroup.mem_comap] using ha'
  have hfaI : IsInvolution (f a) := by
    refine ⟨fun he => hfa (he ▸ J.one_mem), ?_⟩
    rw [← map_pow]
    exact hasq
  have hga'I : IsInvolution (g a') := by
    refine ⟨fun he => hga' (he ▸ J.one_mem), ?_⟩
    rw [← map_pow]
    exact ha'sq
  obtain ⟨x, hx⟩ := isConj_iff.mp
    (pgl2_outer_involutions_conjugate_of_odd_prime_power K hK hga'I hfaI hga' hfa)
  obtain ⟨y, hy⟩ := hg x
  let b := y * a' * y⁻¹
  have hfb : f a = g b := by
    simp only [b, map_mul, map_inv, hy]
    exact hx.symm
  have hb : b ∉ N' := by
    intro hbN
    apply hfa
    rw [hfb]
    rw [hN'] at hbN
    exact hbN
  have hbsq : b ^ 2 = a' ^ 2 := by
    change (y * a' * y⁻¹) ^ 2 = a' ^ 2
    rw [conj_pow, Subgroup.mem_center_iff.mp (hgcentral ha'sq) y,
      mul_inv_cancel_right]
  have haction := MonoidHom.conjugation_eq_of_central_pgroup_kernel f g
    hfcentral hgcentral hgprime N N' eN heN L0 hno hjoin a b hfb
  obtain ⟨e, he, _⟩ := Subgroup.exists_mulEquiv_of_index_two_extensions
    N N' hi hi' a b ha hb eN (by rw [hbsq]; exact hsq) haction
  exact ⟨e, he⟩

end GorensteinWalter
