module
public import ABG.ChapterII.Section3.QProjectiveLinearComplement
public import Theory.GroupTheory.SylowCentralJoinIndex

/-!
# The actual Sylow subgroup in the prescribed linear constituent

Strengthen the projective linear/field decomposition of a core-free finite
Q-group at its supplied Sylow two-subgroup S. The normal linear constituent
L contains S and is generated by S and the original normal SL2 subgroup L0.
The index of Z(S)L0 in L equals the index of Z(S)(S intersection L0) in S.
All original projective maps, complementary subgroup images, and the element
equation through the supplied SL2 identification are retained.

The odd complement makes the index of L odd. The image of S in H/L is both
a two-group and odd, hence trivial. Apply the general Sylow central-join
index theorem inside L to obtain generation, using the projective index
bound. Normality distributes the central join through the intersection
with S, and the normal-subgroup relative-index identity gives the exact
local/global index equality.

Source: Alperin--Brauer--Gorenstein II.3 Proposition 3, article pp25--26.
This connects the actual exterior generators from the Sylow geometry to
the same normal constituent whose concrete matrix model is to be recognized.
No full Sylow shape or matching matrix action is assumed; q=3 is retained.
-/

namespace ABG
open GorensteinWalter
universe u

public theorem qGroup_projective_linear_complement_with_sylow
    {H : Type u} [Group H] [Finite H] (hH : IsQGroup H)
    (hcore : pPrimeCore 2 H = ⊥) (S : Sylow 2 H)
    (Z : Subgroup H) [Z.Normal] (hZ : Z = subgroupCenter (S : Subgroup H))
    (L0 : Subgroup H) [L0.Normal]
    (K : Type u) [Field K] [Finite K] (hK : IsOddPrimePower (Nat.card K))
    (eL0 : L0 ≃* Matrix.SpecialLinearGroup (Fin 2) K) :
    Z ≤ Subgroup.center H ∧ IsCyclic Z ∧ Z ≠ ⊥ ∧ IsPGroup 2 Z ∧
      ∃ (f : H →* PGammaL2 K) (L E : Subgroup H),
        f.ker = Z ∧ L.Normal ∧ L0 ≤ L ∧ L.IsComplement' E ∧
        IsCyclic E ∧ Odd (Nat.card E) ∧
        L.map f = f.range ⊓ pGammaL2PGLRange K ∧
        L0.map f = pGammaL2PSLRange K ∧
        E.map f = (pGammaL2FieldProjection K f.range).range.map
          (SemidirectProduct.inr : (K ≃+* K) →* PGammaL2 K) ∧
        (Z ⊔ L0).relIndex L ∣ 2 ∧ commutator H ≤ Z ⊔ L0 ∧
        (S : Subgroup H) ≤ L ∧ L = (S : Subgroup H) ⊔ L0 ∧
        (Z ⊔ L0).relIndex L =
          (L0.comap (S : Subgroup H).subtype ⊔ Subgroup.center S).index ∧
        ∀ l : L0, f l.val = SemidirectProduct.inl
          (Matrix.ProjectiveSpecialLinearGroup.toPGL (sl2ProjectiveProjection K (eL0 l))) := by
  obtain ⟨hZc, hZcyc, hZne, hZtwo, f, L, E, hfker, hLN, hL0,
      hcomp, hEcyc, hEodd, hLmap, hL0map, hEmap, hidx, hcomm, hfcore⟩ :=
    qGroup_projective_linear_complement_with_core_map hH hcore S Z hZ L0 K hK eL0
  let : L.Normal := hLN
  have hLi : Odd L.index := hcomp.symm.index_eq_card ▸ hEodd
  let q := QuotientGroup.mk' L
  have hSmap : (S : Subgroup H).map q = ⊥ := by
    have hp := S.isPGroup'.map q
    have ho : Odd (Nat.card ((S : Subgroup H).map q)) :=
      hLi.of_dvd_nat ((S : Subgroup H).map q).card_subgroup_dvd_card
    rcases hp.card_eq_or_dvd with hc | hc
    · exact Subgroup.eq_bot_of_card_eq _ hc
    · exact (ho.not_two_dvd_nat hc).elim
  have hSL : (S : Subgroup H) ≤ L := by
    rw [Subgroup.map_eq_bot_iff, QuotientGroup.ker_mk'] at hSmap
    exact hSmap
  have hZS : Z ≤ (S : Subgroup H) := by
    rw [hZ]
    exact Subgroup.map_subtype_le _
  let T := S.subtype hSL
  let CL := Z.subgroupOf L
  let NL := L0.subgroupOf L
  have hZL : Z ≤ L := hZS.trans hSL
  have hi : (CL ⊔ NL).index ∣ 2 := by
    change (Z.subgroupOf L ⊔ L0.subgroupOf L).index ∣ 2
    rw [← Subgroup.subgroupOf_sup hZL hL0]
    exact hidx
  have hCT : CL ≤ (T : Subgroup L) := fun x hx => hZS hx
  obtain ⟨hgen, _⟩ := T.sup_normal_eq_top_and_join_index CL NL hCT hi
  have hLsup : L = (S : Subgroup H) ⊔ L0 := by
    have hm := congrArg (Subgroup.map L.subtype) hgen
    change ((S : Subgroup H).subgroupOf L ⊔ L0.subgroupOf L).map L.subtype =
      (⊤ : Subgroup L).map L.subtype at hm
    rw [Subgroup.map_sup, Subgroup.map_subgroupOf_eq_of_le hSL,
      Subgroup.map_subgroupOf_eq_of_le hL0, ← MonoidHom.range_eq_map, L.range_subtype] at hm
    exact hm.symm
  have hlocal : L0.comap (S : Subgroup H).subtype ⊔ Subgroup.center S =
      (Z ⊔ L0).comap (S : Subgroup H).subtype := by
    have hCZ : Z.comap (S : Subgroup H).subtype = Subgroup.center S := by
      rw [hZ]
      change ((Subgroup.center S).map (S : Subgroup H).subtype).comap
        (S : Subgroup H).subtype = _
      rw [Subgroup.comap_map_eq, MonoidHom.ker_eq_bot _ (S : Subgroup H).subtype_injective,
        sup_bot_eq]
    rw [← hCZ]
    apply le_antisymm ?_ ?_
    · exact sup_le (Subgroup.comap_mono le_sup_right) (Subgroup.comap_mono le_sup_left)
    · intro x hx
      obtain ⟨z, hz, l, hl, he⟩ := Subgroup.mem_sup_of_normal_left.mp hx
      change z * l = (x : H) at he
      have hlS : l ∈ (S : Subgroup H) := by
        have h := (S : Subgroup H).mul_mem ((S : Subgroup H).inv_mem (hZS hz)) x.property
        simpa only [← he, inv_mul_cancel_left] using h
      have he' : (⟨z, hZS hz⟩ : S) * ⟨l, hlS⟩ = x := Subtype.ext he
      rw [← he']
      exact (L0.comap (S : Subgroup H).subtype ⊔ Z.comap (S : Subgroup H).subtype).mul_mem
        ((show Z.comap (S : Subgroup H).subtype ≤ _ from le_sup_right) hz)
        ((show L0.comap (S : Subgroup H).subtype ≤ _ from le_sup_left) hl)
  have hidxeq : (Z ⊔ L0).relIndex L =
      (L0.comap (S : Subgroup H).subtype ⊔ Subgroup.center S).index := by
    rw [hlocal]
    change (Z ⊔ L0).relIndex L = (Z ⊔ L0).relIndex (S : Subgroup H)
    have hjoin : (S : Subgroup H) ⊔ (Z ⊔ L0) = L := by
      rw [← sup_assoc, sup_eq_left.mpr hZS, ← hLsup]
    rw [← hjoin, Subgroup.relIndex_sup_right]
  exact ⟨hZc, hZcyc, hZne, hZtwo, f, L, E, hfker, hLN, hL0,
    hcomp, hEcyc, hEodd, hLmap, hL0map, hEmap, hidx, hcomm, hSL, hLsup, hidxeq, hfcore⟩

end ABG
