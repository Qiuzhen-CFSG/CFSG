module
public import ABG.ChapterII.Section1.QuaternionSubgroups
public import Theory.GroupTheory.SubgroupConjugacy

/-!
# Every order-four class meets a chosen quaternion subgroup

In a quasi-dihedral group, every element of order four is conjugate to an
element of any specified quaternion subgroup of order eight. No ambient
Sylow or finiteness assumption is needed beyond the actual semidihedral
presentation.

The cyclic and outer order-four calculations put each element into a
conjugate of the canonical quaternion subgroup generated by the quarter-order
rotation and the first outer element. Lemma II.1.1(ii) then conjugates this
canonical subgroup to the specified one. This supplies the subgroup bridge
for the order-four fusion counts in ABG Chapter II §1 Proposition 1,
article pp.10–11 of `refs/latex/alperin-brauer-gorenstein.tex`.
-/

namespace ABG.QuasiDihedral
variable {G : Type*} [Group G]

/-- Every element of order four has a conjugate in a specified quaternion subgroup. -/
public theorem order_four_conjugate_into_quaternion
    (hG : Stellmacher.IsSemidihedralGroup G) (Q : Subgroup G)
    (hQ : Nonempty (Q ≃* QuaternionGroup 2)) (x : G) (hx : orderOf x = 4) :
    ∃ y : Q, IsConj x (y : G) := by
  obtain ⟨n, a, b, hn, hcard, ha, hb, hab, hgen, hnf⟩ := exists_normal_form hG
  let U := Subgroup.closure ({a^(2^(n-3)), a*b} : Set G)
  have hU : Nonempty (U ≃* QuaternionGroup 2) :=
    (quaternion_representative_local hn a b hcard ha hb hab hgen).1
  have hxU : ∃ z : U, IsConj x (z : G) := by
    obtain ⟨i, hi, rfl | rfl⟩ := hnf x
    · have he : 2^(n-1) = 4*2^(n-3) := by
        rw [show n-1 = n-3+2 by omega, pow_add]
        ring
      have hc : a^(2^(n-3)) ∈ U := Subgroup.subset_closure (by simp)
      rcases cyclic_order_four_eq_or_inv a (2^(n-3)) i (by positivity)
        (ha.trans he) (he ▸ hi) hx with ht | ht
      · exact ⟨⟨a^(2^(n-3)), hc⟩, by simpa only [ht] using (IsConj.refl (a^i))⟩
      · exact ⟨⟨(a^(2^(n-3)))⁻¹, U.inv_mem hc⟩, by simpa only [ht] using (IsConj.refl (a^i))⟩
    · refine ⟨⟨a*b, Subgroup.subset_closure (by simp)⟩, ?_⟩
      exact outer_order_four_isConj a b (2^(n-2)) i
        (by rw [ha, show n-1=n-2+1 by omega, pow_succ, Nat.mul_comm])
        (outer_square hn a b hb hab) (outer_even_shift_isConj hn a b ha hab) hx
  obtain ⟨R, _, hclass, _, _⟩ := quaternion_subgroups hG
  obtain ⟨g, hg⟩ := Subgroup.conjugate_of_same_class R Q U (hclass Q hQ) (hclass U hU)
  obtain ⟨z, hz⟩ := hxU
  have hzQ : (MulAut.conj g) (z : G) ∈ Q := by
    rw [← hg]
    exact Subgroup.mem_map.mpr ⟨z, z.property, rfl⟩
  exact ⟨⟨(MulAut.conj g) (z : G), hzQ⟩, hz.trans (isConj_iff.mpr ⟨g, rfl⟩)⟩
end ABG.QuasiDihedral
