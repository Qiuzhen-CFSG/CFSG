module
public import ABG.ChapterII.Section1.Center
public import Theory.GroupTheory.NormalizingInvolutionCard

/-!
# Semidihedral subgroups generated by a rotation and an involution

Let a have order 2^(n+1), with n≥2, and let w be an involution outside
the cyclic subgroup generated by a. If w conjugates a to a^(2^n−1), their
actual generated subgroup has order 2^(n+2), is semidihedral, and has
ambient center image generated by a^(2^n).

The conjugation relation and w²=1 make w normalize the cyclic subgroup.
Adjoining that external involution doubles its order. Restrict the actual
generators to their join to obtain the semidihedral presentation; the
existing explicit-generator center theorem identifies the center, and
mapping its cyclic subgroup back gives the stated ambient equality.
No finiteness assumption on the ambient group is needed.

This is the shared group-theoretic presentation calculation for the linear
and unitary models in ABG II.2 Lemma1(i),(ii), article p17 (PDF page18).
Here n parametrizes the rotation order, not the source's Sylow height.
-/

namespace ABG

public theorem semidihedral_generated_subgroup_data {G : Type*} [Group G]
    {n : ℕ} (hn : 2 ≤ n) (a w : G) (ha : orderOf a = 2 ^ (n + 1))
    (hw : w ^ 2 = 1) (hout : w ∉ Subgroup.zpowers a)
    (hconj : w * a * w⁻¹ = a ^ (2 ^ n - 1)) :
    let T := Subgroup.zpowers a ⊔ Subgroup.zpowers w
    Nat.card T = 2 ^ (n + 2) ∧ Stellmacher.IsSemidihedralGroup T ∧
      (Subgroup.center T).map T.subtype = Subgroup.zpowers (a ^ (2 ^ n)) := by
  let T := Subgroup.zpowers a ⊔ Subgroup.zpowers w
  change Nat.card T = _ ∧ _ ∧ _
  have hwi : w⁻¹ = w := inv_eq_of_mul_eq_one_right (by simpa only [pow_two] using hw)
  have hforward : ∀ x ∈ Subgroup.zpowers a, w * x * w⁻¹ ∈ Subgroup.zpowers a := by
    intro x hx
    have hm : (Subgroup.zpowers a).map (MulAut.conj w).toMonoidHom ≤ Subgroup.zpowers a := by
      rw [MonoidHom.map_zpowers]
      apply Subgroup.zpowers_le.mpr
      change w * a * w⁻¹ ∈ Subgroup.zpowers a
      rw [hconj]
      exact Subgroup.pow_mem _ (Subgroup.mem_zpowers a) _
    exact hm (Subgroup.mem_map_of_mem _ hx)
  have hnorm : w ∈ Subgroup.normalizer (Subgroup.zpowers a : Set G) := by
    apply Subgroup.mem_normalizer_iff.mpr
    intro x
    refine ⟨hforward x, fun hx => ?_⟩
    have h := hforward _ hx
    have he : w * (w * x * w⁻¹) * w⁻¹ = x := by
      rw [hwi]
      calc
        w * (w * x * w) * w = (w * w) * x * (w * w) := by group
        _ = x := by rw [← pow_two, hw]; simp
    rwa [he] at h
  have hcard : Nat.card T = 2 ^ (n + 2) := by
    rw [Subgroup.card_sup_zpowers_of_normalizing_involution _ _ hw hout hnorm,
      Nat.card_zpowers, ha]
    simp only [show n + 2 = (n + 1) + 1 by omega, pow_succ, Nat.mul_comm]
  let aT : T := ⟨a, (show Subgroup.zpowers a ≤ T from le_sup_left) (Subgroup.mem_zpowers a)⟩
  let wT : T := ⟨w, (show Subgroup.zpowers w ≤ T from le_sup_right) (Subgroup.mem_zpowers w)⟩
  have haT : orderOf aT = 2 ^ ((n + 2) - 1) := by
    rw [← orderOf_injective T.subtype T.subtype_injective]
    simpa [aT] using ha
  have hwT : orderOf wT = 2 := by
    apply orderOf_eq_prime
    · exact Subtype.ext hw
    · intro he
      have he' : w = 1 := congrArg Subtype.val he
      exact hout (he'.symm ▸ (Subgroup.one_mem (Subgroup.zpowers a)))
  have hcT : wT * aT * wT⁻¹ = aT ^ (2 ^ ((n + 2) - 2) - 1) := by
    apply Subtype.ext
    simpa [aT, wT] using hconj
  have hgen : Subgroup.closure ({aT, wT} : Set T) = ⊤ := by
    apply (Subgroup.map_injective T.subtype_injective)
    rw [MonoidHom.map_closure, ← MonoidHom.range_eq_map, T.range_subtype,
      Set.image_insert_eq, Set.image_singleton]
    change Subgroup.closure ({a, w} : Set G) = T
    simp only [T, Subgroup.zpowers_eq_closure, ← Subgroup.closure_union,
      Set.singleton_union]
  refine ⟨hcard, ⟨n + 2, by omega, hcard, aT, wT, haT, hwT, hcT, hgen⟩, ?_⟩
  rw [QuasiDihedral.center_eq (by omega : 4 ≤ n + 2) aT wT haT hwT hcT hgen,
    MonoidHom.map_zpowers]
  rfl

end ABG
