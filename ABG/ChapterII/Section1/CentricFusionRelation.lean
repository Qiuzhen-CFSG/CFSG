module

public import BenderSuzuki.External.Huppert.X.ConjugationFamily
public import BenderSuzuki.PFchapter1section1.Basic
public import Theory.GroupTheory.CentricCharacterFusion

/-!
# Relations preserved by centric fusion

ABG Chapter II §1 uses Alperin fusion to determine which conjugacy classes of
a Sylow subgroup merge in the ambient group (article pp.10–11). This module
transfers any reflexive transitive relation on the chosen Sylow subgroup from
centric extremal normalizer steps to all ambient conjugacies. Such a relation
can describe permitted class mergers, so the result applies even when ambient
fusion is larger than conjugacy inside the Sylow subgroup. Symmetry of the
relation is not needed.

The generic proof lives in `Theory.GroupTheory.CentricCharacterFusion`;
this adapter retains the original extremality interface and public name.

Apply Huppert X.4.7's centric conjugation decomposition to the cyclic subgroup
generated by the first element. Induct through its exact product of right
conjugators: local centric steps preserve the relation by hypothesis, whereas
centralizer steps fix the current element. Reflexivity handles fixed elements
and transitivity joins consecutive steps. Finiteness and the prime Sylow
hypotheses are those required by the imported Huppert decomposition.
-/

noncomputable section

namespace ABG

open BenderSuzuki BenderSuzuki.External PFchapter1section1 PFAppendixIII

universe u

/-- A reflexive transitive relation preserved by every centric extremal
normalizer step contains every ambient conjugacy between Sylow elements. -/
public theorem centric_fusion_relation
    {G : Type u} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]
    (P : Sylow p G) (R : P → P → Prop)
    (hrefl : ∀ x, R x x)
    (htrans : ∀ {x y z}, R x y → R y z → R x z)
    (hlocal : ∀ (U : Subgroup G), HuppertExtremal P U →
      subgroupCentralizerIn (P : Subgroup G) U ≤ U →
      ∀ g : G, g ∈ Subgroup.normalizer (U : Set G) →
      ∀ x y : P, (x : G) ∈ U → g⁻¹ * (x : G) * g = (y : G) → R x y)
    {x y : P} (hxy : IsConj (x : G) (y : G)) : R x y := by
  apply P.centric_fusion_relation R hrefl htrans ?_ hxy
  intro U hUP hfac hcent
  exact hlocal U ⟨hUP, hfac⟩ hcent

end ABG
