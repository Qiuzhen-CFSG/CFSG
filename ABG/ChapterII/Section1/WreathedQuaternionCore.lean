module
public import ABG.ChapterII.Section1.WreathedExceptionalDefs
public import ABG.ChapterII.Section1.WreathedMaximalQuaternion
public import ABG.ChapterII.Section1.WreathedInvolutions
public import ABG.ChapterII.Section1.WreathedCenter
public import ABG.ChapterII.Section1.WreathedNonabelianCenter
public import Theory.GroupTheory.QuaternionGenerated

/-!
# The quaternion factor in the exceptional wreathed central product

For a wreathed presentation of height n ≥ 2, the subgroup generated by
r^(2^(n-2)) and d is quaternion of order eight. It meets the ambient center
in precisely the order-two subgroup generated by x. This is the chosen
quaternion factor for the exceptional central product in
Alperin–Brauer–Gorenstein, Chapter II §1 Lemma 3, article p.10.

The exact order of r makes its quarter-power have order four. Its square
is x = d² and d inverts it, so QuaternionGenerated identifies the subgroup.
The center of Q8 has order two; WreathedNonabelianCenter places that center
in the ambient center, giving equality with the intersection. Since x is
already in both factors, equal cardinalities identify the intersection
with its cyclic subgroup. The generator relations are public for the
central-product and normalizer calculations using this same subgroup.
-/

namespace ABG.Wreathed.Presentation
variable {S : Type*} [Group S] {n : ℕ} (P : Presentation S n)
include P in
private theorem quarter_double : 2 ^ (n - 2) * 2 = 2 ^ (n - 1) := by
  have hn := P.height
  rw [← pow_succ]
  congr 1
  omega
include P in
private theorem quarter_quadruple : 2 ^ (n - 2) * 4 = 2 ^ n := by
  have hn := P.height
  calc
    _ = 2 ^ (n - 2) * 2 ^ 2 := by norm_num
    _ = 2 ^ (n - 2 + 2) := (pow_add _ _ _).symm
    _ = _ := by congr 1; omega
public theorem quaternion_rotation_order : orderOf (P.r ^ (2 ^ (n - 2))) = 4 := by
  rw [orderOf_pow_of_dvd (by positivity) (by rw [P.r_order, ← P.quarter_quadruple]; exact dvd_mul_right _ _)]
  rw [P.r_order, ← P.quarter_quadruple, Nat.mul_div_cancel_left _ (by positivity)]
public theorem quaternion_rotation_sq : (P.r ^ (2 ^ (n - 2))) ^ 2 = P.x := by
  rw [← pow_mul, P.quarter_double, P.r_half]
public theorem d_conj_quaternion_rotation :
    P.d * (P.r ^ (2 ^ (n - 2))) * P.d⁻¹ = (P.r ^ (2 ^ (n - 2)))⁻¹ := by
  change (MulAut.conj P.d) (P.r ^ _) = _
  rw [map_pow]
  change (P.d * P.r * P.d⁻¹) ^ _ = _
  rw [P.d_conj_r, inv_pow]
end ABG.Wreathed.Presentation

namespace ABG.Wreathed.Presentation
variable {S : Type*} [Group S] {n : ℕ} (P : Presentation S n)
public theorem quaternion_core_model : ABG.IsQuaternionGroup P.quaternionCore ∧
    Nat.card P.quaternionCore = 8 := by
  obtain ⟨hc,he⟩ := QuaternionGroup.closure_equiv_of_relations (m := 2) (by omega)
    (P.r ^ (2 ^ (n - 2))) P.d (by simpa using P.quaternion_rotation_order)
    (by rw [P.quaternion_rotation_sq, P.d_sq, P.r_half])
    P.d_conj_quaternion_rotation (fun h => P.d_not_mem_zpowers_r
      ((Subgroup.zpowers_le.mpr (Subgroup.pow_mem _ (Subgroup.mem_zpowers _) _)) h))
  exact ⟨he, hc⟩
private theorem quaternion_center_card : Nat.card (Subgroup.center (QuaternionGroup 2)) = 2 := by
  let C : QuaternionGroup 2 → Prop := fun x => ∀ y, y * x = x * y
  have hC : ∀ x : QuaternionGroup 2, x ∈ Subgroup.center (QuaternionGroup 2) ↔ C x :=
    fun _ => Subgroup.mem_center_iff
  have hc : Fintype.card {x : QuaternionGroup 2 // C x} = 2 := by decide
  rw [Nat.card_congr (Equiv.subtypeEquivRight hC), Nat.card_eq_fintype_card, hc]
public theorem quaternion_core_noncommutative : ¬ IsMulCommutative P.quaternionCore := by
  obtain ⟨⟨e⟩, _⟩ := P.quaternion_core_model
  intro h
  have hcomm : (QuaternionGroup.a 1 : QuaternionGroup 2) * QuaternionGroup.xa 0 =
      QuaternionGroup.xa 0 * QuaternionGroup.a 1 := by
    simpa using congrArg e (h.is_comm.comm (e.symm (QuaternionGroup.a 1))
      (e.symm (QuaternionGroup.xa 0)))
  have hne : (QuaternionGroup.a 1 : QuaternionGroup 2) * QuaternionGroup.xa 0 ≠
      QuaternionGroup.xa 0 * QuaternionGroup.a 1 := by decide
  exact hne hcomm
public theorem quaternion_core_center_map :
    (Subgroup.center P.quaternionCore).map P.quaternionCore.subtype =
      P.quaternionCore ⊓ Subgroup.center S := by
  apply le_antisymm
  · exact le_inf (by rintro _ ⟨a,ha,rfl⟩; exact a.property)
      (P.nonabelian_center_le P.quaternionCore P.quaternion_core_noncommutative)
  · intro a ha
    refine ⟨⟨a,ha.1⟩, ?_, rfl⟩
    apply Subgroup.mem_center_iff.mpr
    intro b
    exact Subtype.ext (Subgroup.mem_center_iff.mp ha.2 b)
public theorem quaternion_core_structure :
    ABG.IsQuaternionGroup P.quaternionCore ∧ Nat.card P.quaternionCore = 8 ∧
      Nat.card (P.quaternionCore ⊓ Subgroup.center S : Subgroup S) = 2 := by
  obtain ⟨he,hc⟩ := P.quaternion_core_model
  refine ⟨he,hc,?_⟩
  obtain ⟨e⟩ := he
  rw [← P.quaternion_core_center_map,
    Subgroup.card_map_of_injective P.quaternionCore.subtype_injective,
    Nat.card_congr (Subgroup.centerCongr e).toEquiv, quaternion_center_card]
/-- The shared quaternion involution belongs to the core. -/
public theorem x_mem_quaternionCore : P.x ∈ P.quaternionCore := by
  rw [← P.quaternion_rotation_sq]
  exact P.quaternionCore.pow_mem (Subgroup.subset_closure (by simp)) _

/-- The quaternion factor meets the ambient center in its involution line. -/
public theorem quaternion_core_inf_center :
    P.quaternionCore ⊓ Subgroup.center S = Subgroup.zpowers P.x := by
  let : Finite S := Nat.finite_of_card_ne_zero (by rw [P.card]; positivity)
  apply Eq.symm
  apply Subgroup.eq_of_le_of_card_ge
  · exact Subgroup.zpowers_le.mpr ⟨P.x_mem_quaternionCore, P.x_mem_center⟩
  · rw [P.quaternion_core_structure.2.2, Nat.card_zpowers, P.x_orderOf]

end ABG.Wreathed.Presentation
