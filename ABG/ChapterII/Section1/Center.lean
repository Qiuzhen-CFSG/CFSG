module
public import Theory.GroupTheory.SemidihedralCenter
public import ABG.ChapterII.Section1.NormalForm
public import ABG.ChapterII.Section1.GeneratorNoncommutative

/-!
# The center of a quasi-dihedral group

For the actual generators `a, b` of the quasi-dihedral presentation with
`|a| = 2^(n-1)` and `n ≥ 4`, the center is generated by
`a^(2^(n-2))` and has order two. The explicit-generator statements retain the
same presentation witnesses used by the normal-form and fusion calculations.
The center equality and its divisibility lemma forward to the reusable
proof in `Theory.GroupTheory.SemidihedralCenter`; the involution and
cardinality consequences remain here.

For the forward containment, a central element has one of the two normal
forms. The form `a^i*b` would force the generators to commute. In the other
form, commutation with `b` implies that `2^(n-1)` divides
`(2^(n-2)-2)*i`. Canceling a factor of two and the remaining odd factor shows
that `2^(n-2)` divides `i`. Conversely, the half-order power commutes with both
normal forms. Its order and the center cardinality follow from the order of
`a` and the cardinality formula for a cyclic subgroup.

This proves the center assertion in Chapter II, §1, Lemma 1(v), article p. 9,
of `refs/latex/alperin-brauer-gorenstein.tex`, from the presentation on article
p. 2. The quotient-dihedral assertion of that clause is a separate result.
-/

namespace ABG.QuasiDihedral
variable {G : Type*} [Group G]

/-- The conjugation exponent fixes a cyclic power only when its exponent is
  divisible by the half-order. This cancels a factor of two and an odd factor. -/
public theorem half_order_dvd {n i : ℕ} (hn : 4 ≤ n)
    (h : 2 ^ (n - 1) ∣ (2 ^ (n - 2) - 2) * i) : 2 ^ (n - 2) ∣ i :=
  Semidihedral.half_order_dvd hn h

/-- The center is the subgroup generated by the half-order power of the cyclic generator. -/
public theorem center_eq {n : ℕ} (hn : 4 ≤ n) (a b : G)
    (ha : orderOf a = 2 ^ (n - 1)) (hb : orderOf b = 2)
    (hconj : b * a * b⁻¹ = a ^ (2 ^ (n - 2) - 1))
    (hgen : Subgroup.closure ({a, b} : Set G) = ⊤) :
    Subgroup.center G = Subgroup.zpowers (a ^ (2 ^ (n - 2))) :=
  Semidihedral.center_eq hn a b ha hb hconj hgen

/-- The half-order power of the cyclic generator is an involution. -/
public theorem half_order_pow_orderOf {n : ℕ} (hn : 4 ≤ n) {a : G}
    (ha : orderOf a = 2 ^ (n - 1)) : orderOf (a ^ (2 ^ (n - 2))) = 2 := by
  have he : n - 1 = (n - 2) + 1 := by omega
  have hd : 2 ^ (n - 2) ∣ orderOf a := by
    rw [ha, he, pow_succ]
    exact dvd_mul_right _ _
  rw [orderOf_pow_of_dvd (by positivity) hd, ha, he, pow_succ]
  exact Nat.mul_div_cancel_left _ (by positivity)

/-- The distinguished involution of the cyclic subgroup is central. -/
public theorem half_order_pow_mem_center {n : ℕ} (hn : 4 ≤ n) (a b : G)
    (ha : orderOf a = 2 ^ (n - 1)) (hb : orderOf b = 2)
    (hconj : b * a * b⁻¹ = a ^ (2 ^ (n - 2) - 1))
    (hgen : Subgroup.closure ({a, b} : Set G) = ⊤) : a ^ (2 ^ (n - 2)) ∈ Subgroup.center G := by
  rw [center_eq hn a b ha hb hconj hgen]
  exact Subgroup.mem_zpowers _

/-- The center of a quasi-dihedral group has order two (ABG II.1.1(v)). -/
public theorem card_center (hG : Stellmacher.IsSemidihedralGroup G) :
    Nat.card (Subgroup.center G) = 2 := by
  obtain ⟨n, hn, _, a, b, ha, hb, hconj, hgen⟩ := hG
  rw [center_eq hn a b ha hb hconj hgen, Nat.card_zpowers]
  exact half_order_pow_orderOf hn ha
end ABG.QuasiDihedral
