module
public import ABG.ChapterII.Section1.RepresentativeFusionRelation
public import FeitThompson.BGsection1.theorem_1_17
/-!
# Focal generators from the two exceptional normalizers

For the chosen four subgroup and quaternion subgroup of order eight in a
quasi-dihedral Sylow two-subgroup, the focal subgroup is generated by the
Sylow commutator subgroup and the differences arising from the two ambient
normalizer actions. These are the actual differences between elements of
the Sylow subgroup, not assumed fusion classes.

Define the local generated subgroup once for any ambient subgroup and
normalizer. Local differences remain in the acted-on subgroup, and a
surjective normalizer action realizes every automorphism difference.
Each local difference is a focal generator, giving one
inclusion. For the reverse inclusion, membership of x⁻¹y in the proposed
generated subgroup is a reflexive transitive relation containing Sylow
conjugacy. Both chosen normalizers preserve it by construction. The proved
representative fusion theorem therefore puts every ambient fusion difference
in that subgroup.

This is the focal reduction for Alperin–Brauer–Gorenstein Chapter II §1,
Proposition 1 (article pp.10–11). The existing Feit–Thompson focal API then
identifies this subgroup with the Sylow intersection of the ambient derived
subgroup, enabling the source's normal-subgroup alternatives after the local
actions are computed. No normal-subgroup alternative is assumed here.
-/

namespace ABG
open scoped commutatorElement
/-- The subgroup of `P` generated by differences from ambient normalizer steps at `U`. -/
@[expose] public def normalizerFusionSubgroup
    {G : Type*} [Group G] (P U : Subgroup G) : Subgroup P :=
  Subgroup.closure {z : P | ∃ (x y : P) (g : G),
    g ∈ Subgroup.normalizer (U : Set G) ∧ (x : G) ∈ U ∧
      g⁻¹ * (x : G) * g = (y : G) ∧ z = x⁻¹ * y}

/-- A local normalizer fusion difference remains in the acted-on subgroup. -/
public theorem normalizerFusionSubgroup_le
    {G : Type*} [Group G] (P U : Subgroup G) :
    normalizerFusionSubgroup P U ≤ U.subgroupOf P := by
  rw [normalizerFusionSubgroup, Subgroup.closure_le]
  rintro z ⟨x, y, g, hg, hx, hxy, rfl⟩
  have hy := (Subgroup.mem_normalizer_iff''.mp hg (x : G)).mp hx
  rw [hxy] at hy
  exact U.mul_mem (U.inv_mem hx) hy
/-- Surjectivity of the normalizer action realizes every automorphism difference as a generator. -/
public theorem normalizerFusionSubgroup_mem_of_automorphism
    {G : Type*} [Group G] (P U : Subgroup G) (hUP : U ≤ P)
    (hsurj : Function.Surjective U.normalizerMonoidHom)
    (e : MulAut U) (x : U) :
    Subgroup.inclusion hUP (x⁻¹ * e x) ∈ normalizerFusionSubgroup P U := by
  obtain ⟨g, hg⟩ := hsurj e
  apply Subgroup.subset_closure
  refine ⟨Subgroup.inclusion hUP x, Subgroup.inclusion hUP (e x),
    (g.val)⁻¹, (Subgroup.normalizer (U : Set G)).inv_mem g.property, x.property, ?_, ?_⟩
  · have hh := congrArg (fun a : MulAut U => ((a x) : G)) hg
    change (g : G) * (x : G) * (g : G)⁻¹ = (e x : G) at hh
    simpa only [inv_inv, Subgroup.coe_inclusion] using hh
  · simp only [map_mul, map_inv]

/-- Every normalizer fusion difference is a focal generator. -/
public theorem normalizerFusionSubgroup_le_focalSubgroupOf
    {G : Type*} [Group G] (P U : Subgroup G) :
    normalizerFusionSubgroup P U ≤ P.focalSubgroupOf := by
  rw [normalizerFusionSubgroup, Subgroup.closure_le]
  rintro z ⟨x, y, g, _, _, hxy, rfl⟩
  change (x : G)⁻¹ * (y : G) ∈ P.focalSubgroup
  apply Subgroup.subset_closure
  refine ⟨x, x.property, y, y.property, ?_, rfl⟩
  exact isConj_iff.mpr ⟨g⁻¹, by simpa using hxy⟩

/-- The focal subgroup is generated by Sylow commutators and the two exceptional normalizers. -/
public theorem quasiDihedral_focalSubgroupOf_eq
    {G : Type*} [Group G] [Finite G]
    (P : Sylow 2 G) (T Q : Subgroup G) (hframe : QuasiDihedralFusionFrame P T Q) :
    (P : Subgroup G).focalSubgroupOf =
      commutator P ⊔ normalizerFusionSubgroup (P : Subgroup G) T ⊔
        normalizerFusionSubgroup (P : Subgroup G) Q := by
  let H : Subgroup P := commutator P ⊔ normalizerFusionSubgroup (P : Subgroup G) T ⊔
    normalizerFusionSubgroup (P : Subgroup G) Q
  apply le_antisymm
  · have hrel : ∀ {x y : P}, IsConj (x : G) (y : G) → x⁻¹ * y ∈ H := by
      apply quasiDihedral_representative_fusion_relation P T Q hframe
        (fun x y : P => x⁻¹ * y ∈ H)
      · intro x
        simp
      · intro x y z hxy hyz
        simpa [mul_assoc] using H.mul_mem hxy hyz
      · intro x y hxy
        obtain ⟨g, rfl⟩ := isConj_iff.mp hxy
        apply (le_sup_left.trans le_sup_left : commutator P ≤ H)
        have h := Subgroup.commutator_mem_commutator (Subgroup.mem_top x⁻¹) (Subgroup.mem_top g)
        simpa only [commutator_def, commutatorElement_def, inv_inv, mul_assoc] using h
      · intro g hg x y hx hxy
        apply (le_sup_right.trans le_sup_left : normalizerFusionSubgroup (P : Subgroup G) T ≤ H)
        exact Subgroup.subset_closure ⟨x, y, g, hg, hx, hxy, rfl⟩
      · intro g hg x y hx hxy
        apply (le_sup_right : normalizerFusionSubgroup (P : Subgroup G) Q ≤ H)
        exact Subgroup.subset_closure ⟨x, y, g, hg, hx, hxy, rfl⟩
    have hmap : (P : Subgroup G).focalSubgroup ≤ H.map (P : Subgroup G).subtype := by
      rw [Subgroup.focalSubgroup_def, Subgroup.closure_le]
      rintro z ⟨x, hx, y, hy, hxy, rfl⟩
      exact Subgroup.mem_map.mpr ⟨(⟨x, hx⟩ : P)⁻¹ * ⟨y, hy⟩, hrel hxy, rfl⟩
    intro z hz
    obtain ⟨w, hw, heq⟩ := hmap hz
    have : w = z := Subtype.ext heq
    rw [this] at hw
    exact hw
  · exact sup_le (sup_le (Subgroup.commutator_le_focalSubgroupOf _)
      (normalizerFusionSubgroup_le_focalSubgroupOf _ _))
      (normalizerFusionSubgroup_le_focalSubgroupOf _ _)
end ABG
