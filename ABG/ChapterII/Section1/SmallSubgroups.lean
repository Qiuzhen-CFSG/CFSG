module
public import ABG.ChapterII.Section1.FourSubgroups
public import ABG.ChapterII.Section1.QuaternionSubgroups
public import Theory.GroupTheory.SubgroupLocalStructureTransport

/-!
# Four and quaternion subgroups of a quasi-dihedral group

A quasi-dihedral group has one conjugacy class of Klein four subgroups and
one conjugacy class of quaternion subgroups of order eight. Every subgroup
of either type has ambient centralizer equal to its own center, embedded
through its subtype map, and has index two in its normalizer. The existential
representatives ensure that both conjugacy classes are nonempty.

This is the complete assertion of Chapter II, §1, Lemma 1(ii), article p. 9,
of `refs/latex/alperin-brauer-gorenstein.tex`. The four-subgroup leaf identifies
the canonical subgroup generated by the central involution and `b`; the
quaternion leaf identifies the subgroup generated by the quarter-order
rotation and `a*b`. Each leaf proves conjugacy to its representative and
calculates the representative's local structure from the presentation.

The assembly transfers centralizer containment and normalizer index along
the conjugating automorphism. A subgroup containing its ambient centralizer
has that centralizer equal to its embedded center, giving the exact source
statement for every subgroup rather than only the representatives.
-/

namespace ABG.QuasiDihedral
variable {G : Type*} [Group G]

/-- ABG II.1.1(ii): the four and quaternion subgroup classes and their full local structure. -/
public theorem four_quaternion_subgroups
    (hG : Stellmacher.IsSemidihedralGroup G) :
    ∃ U V : Subgroup G, IsKleinFour U ∧ Nonempty (V ≃* QuaternionGroup 2) ∧
      (∀ T : Subgroup G, IsKleinFour T →
        ∃ g : G, U.map (MulAut.conj g).toMonoidHom = T) ∧
      (∀ T : Subgroup G, Nonempty (T ≃* QuaternionGroup 2) →
        ∃ g : G, V.map (MulAut.conj g).toMonoidHom = T) ∧
      ∀ T : Subgroup G, IsKleinFour T ∨ Nonempty (T ≃* QuaternionGroup 2) →
        Subgroup.centralizer (T : Set G) = (Subgroup.center T).map T.subtype ∧
        T.relIndex (Subgroup.normalizer (T : Set G)) = 2 := by
  obtain ⟨U, hU, hcU, hCU, hNU⟩ := four_subgroups hG
  obtain ⟨V, hV, hcV, hCV, hNV⟩ := quaternion_subgroups hG
  refine ⟨U, V, hU, hV, hcU, hcV, ?_⟩
  intro T hT
  rcases hT with hT | hT
  · obtain ⟨g, rfl⟩ := hcU T hT
    have hlocal := Subgroup.local_structure_map U (MulAut.conj g) hCU hNU
    exact ⟨Subgroup.centralizer_eq_mapped_center_of_le _ hlocal.1, hlocal.2⟩
  · obtain ⟨g, rfl⟩ := hcV T hT
    have hlocal := Subgroup.local_structure_map V (MulAut.conj g) hCV hNV
    exact ⟨Subgroup.centralizer_eq_mapped_center_of_le _ hlocal.1, hlocal.2⟩
end ABG.QuasiDihedral
