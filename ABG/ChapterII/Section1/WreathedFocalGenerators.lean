module
public import ABG.ChapterII.Section1.WreathedFrameFusion
public import ABG.ChapterII.Section1.FocalGenerators

/-!
# Focal generators for a wreathed fusion frame

The focal subgroup of a wreathed Sylow two-subgroup is generated by its
commutator subgroup and the differences arising from normalizer actions at
the two actual subgroups of its fusion frame. This is the focal reduction
used in all four cases of ABG Chapter II Section 1 Proposition 2, article
pp.12--13, `refs/latex/alperin-brauer-gorenstein-pages/page-013.tex` and
`page-014.tex`. No assumption on either automizer index is needed.

Use the existing `normalizerFusionSubgroup` definition and its containment
in the focal subgroup to prove one inclusion. For the other, membership of
`x⁻¹ * y` in the proposed join is a reflexive transitive relation containing
Sylow conjugacy. Both specified normalizer actions preserve this relation
by construction, so the wreathed frame fusion theorem puts every ambient
fusion difference in the join. The result retains the subgroup of the
actual Sylow type required by the existing focal intersection API.
-/

namespace ABG
open scoped commutatorElement

/-- Sylow commutators and the two frame normalizers generate the wreathed focal subgroup. -/
public theorem wreathed_focalSubgroupOf_eq
    {G : Type*} [Group G] [Finite G]
    (S : Sylow 2 G) (n : ℕ) (U V : Subgroup G) (hframe : WreathedFusionFrame S n U V) :
    (S : Subgroup G).focalSubgroupOf =
      commutator S ⊔ normalizerFusionSubgroup (S : Subgroup G) U ⊔
        normalizerFusionSubgroup (S : Subgroup G) V := by
  let H : Subgroup S := commutator S ⊔ normalizerFusionSubgroup (S : Subgroup G) U ⊔
    normalizerFusionSubgroup (S : Subgroup G) V
  apply le_antisymm
  · have hrel : ∀ {x y : S}, IsConj (x : G) (y : G) → x⁻¹ * y ∈ H := by
      apply wreathed_representative_fusion_relation S n U V hframe
        (fun x y : S => x⁻¹ * y ∈ H)
      · intro x
        simp
      · intro x y z hxy hyz
        simpa [mul_assoc] using H.mul_mem hxy hyz
      · intro x y hxy
        obtain ⟨g, rfl⟩ := isConj_iff.mp hxy
        apply (le_sup_left.trans le_sup_left : commutator S ≤ H)
        have h := Subgroup.commutator_mem_commutator (Subgroup.mem_top x⁻¹) (Subgroup.mem_top g)
        simpa only [commutator_def, commutatorElement_def, inv_inv, mul_assoc] using h
      · intro g hg x y hx hxy
        apply (le_sup_right.trans le_sup_left : normalizerFusionSubgroup (S : Subgroup G) U ≤ H)
        exact Subgroup.subset_closure ⟨x, y, g, hg, hx, hxy, rfl⟩
      · intro g hg x y hx hxy
        apply (le_sup_right : normalizerFusionSubgroup (S : Subgroup G) V ≤ H)
        exact Subgroup.subset_closure ⟨x, y, g, hg, hx, hxy, rfl⟩
    have hmap : (S : Subgroup G).focalSubgroup ≤ H.map (S : Subgroup G).subtype := by
      rw [Subgroup.focalSubgroup_def, Subgroup.closure_le]
      rintro z ⟨x, hx, y, hy, hxy, rfl⟩
      exact Subgroup.mem_map.mpr ⟨(⟨x, hx⟩ : S)⁻¹ * ⟨y, hy⟩, hrel hxy, rfl⟩
    intro z hz
    obtain ⟨w, hw, heq⟩ := hmap hz
    have : w = z := Subtype.ext heq
    rw [this] at hw
    exact hw
  · exact sup_le (sup_le (Subgroup.commutator_le_focalSubgroupOf _)
      (normalizerFusionSubgroup_le_focalSubgroupOf _ _))
      (normalizerFusionSubgroup_le_focalSubgroupOf _ _)

end ABG
