module
public import ABG.ChapterII.Section1.WreathedBaseProduct
public import ABG.ChapterII.Section1.WreathedInvolutions
public import ABG.ChapterII.Section1.WreathedBaseConjugation
public import Theory.GroupTheory.PGroup.CyclicInvolution
public import Mathlib.GroupTheory.IndexNormal

/-!
# The central involution in noncyclic wreathed subgroups

Every noncyclic subgroup of the chosen wreathed presentation contains x. For
a subgroup of the abelian base the stronger conclusion is that it contains
T, the group generated by all three base involutions. These are the central
reductions in ABG Chapter II §1 Lemma 2(xiii), article p.10.

A base subgroup omitting x₂ is disjoint from the cyclic first factor, so its
second coordinate projection is injective and it is cyclic. The symmetric
argument gives x₃, hence T, in every noncyclic base subgroup. For a subgroup
outside the base, its map to the quotient of order two cannot be injective
if it is noncyclic. A nonidentity kernel element has a power of order two.
The base involution classification and conjugation by an outer subgroup
element then force x into the subgroup.
-/

namespace ABG.Wreathed.Presentation
variable {S : Type*} [Group S] {n : ℕ} (P : Presentation S n)

private theorem x₃_orderOf' : orderOf P.x₃ = 2 := by
  rw [← P.outer_conj_x₂ P.z_not_mem_U]
  exact (orderOf_injective (MulAut.conj P.z).toMonoidHom (MulAut.conj P.z).injective P.x₂).trans P.x₂_orderOf

private theorem isCyclic_of_base_not_x₂ (X : Subgroup S) (hX : X ≤ P.U)
    (hx : P.x₂ ∉ X) : IsCyclic X := by
  let : Finite S := Nat.finite_of_card_ne_zero (by rw [P.card]; positivity)
  have hp : IsPGroup 2 S := IsPGroup.of_card P.card
  have hd : Disjoint (Subgroup.zpowers P.s) X :=
    hp.disjoint_of_involution_not_mem _ _ (Subgroup.pow_mem _ (Subgroup.mem_zpowers P.s) _)
      P.x₂_orderOf hx
  let f : X →* Multiplicative (ZMod (2 ^ n)) :=
    (MonoidHom.snd _ _).comp (P.baseEquiv.toMonoidHom.comp (Subgroup.inclusion hX))
  apply isCyclic_of_injective f
  apply (injective_iff_map_eq_one f).mpr
  intro a ha
  apply Subtype.ext
  apply Subgroup.disjoint_def.mp hd ((P.baseEquiv_snd_eq_one_iff ⟨a, hX a.property⟩).mp ha)
    a.property

private theorem isCyclic_of_base_not_x₃ (X : Subgroup S) (hX : X ≤ P.U)
    (hx : P.x₃ ∉ X) : IsCyclic X := by
  let : Finite S := Nat.finite_of_card_ne_zero (by rw [P.card]; positivity)
  have hp : IsPGroup 2 S := IsPGroup.of_card P.card
  have hd : Disjoint (Subgroup.zpowers P.t) X :=
    hp.disjoint_of_involution_not_mem _ _ (Subgroup.pow_mem _ (Subgroup.mem_zpowers P.t) _)
      P.x₃_orderOf' hx
  let f : X →* Multiplicative (ZMod (2 ^ n)) :=
    (MonoidHom.fst _ _).comp (P.baseEquiv.toMonoidHom.comp (Subgroup.inclusion hX))
  apply isCyclic_of_injective f
  apply (injective_iff_map_eq_one f).mpr
  intro a ha
  apply Subtype.ext
  apply Subgroup.disjoint_def.mp hd ((P.baseEquiv_fst_eq_one_iff ⟨a, hX a.property⟩).mp ha)
    a.property

public theorem noncyclic_base_contains_T (X : Subgroup S) (hX : X ≤ P.U)
    (hcyc : ¬ IsCyclic X) : P.T ≤ X := by
  have hx₂ : P.x₂ ∈ X := by
    by_contra h
    exact hcyc (P.isCyclic_of_base_not_x₂ X hX h)
  have hx₃ : P.x₃ ∈ X := by
    by_contra h
    exact hcyc (P.isCyclic_of_base_not_x₃ X hX h)
  have hx : P.x ∈ X := P.x_eq_x₂_mul_x₃ ▸ X.mul_mem hx₂ hx₃
  apply (Subgroup.closure_le X).mpr
  intro a ha
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at ha
  rcases ha with rfl | rfl | rfl
  · exact hx
  · exact hx₂
  · exact hx₃

private theorem kernel_involution {G H : Type*} [Group G] [Group H]
    (hG : IsPGroup 2 G) [IsCyclic H] (f : G →* H)
    (hcyc : ¬ IsCyclic G) : ∃ g : G, orderOf g = 2 ∧ f g = 1 := by
  classical
  have hni : ¬ Function.Injective f := fun hi => hcyc (isCyclic_of_injective f hi)
  rw [injective_iff_map_eq_one] at hni
  push Not at hni
  obtain ⟨a, ha, hane⟩ := hni
  obtain ⟨k, hk⟩ := hG.exists_orderOf_eq_pow a
  refine ⟨a ^ (orderOf a / 2), ?_, by simp [ha]⟩
  exact orderOf_pow_orderOf_div (by rw [hk]; positivity) (hG.dvd_orderOf hane)

public theorem noncyclic_contains_x (X : Subgroup S) (hcyc : ¬ IsCyclic X) : P.x ∈ X := by
  by_cases hX : X ≤ P.U
  · exact P.noncyclic_base_contains_T X hX hcyc (Subgroup.subset_closure (by simp))
  obtain ⟨g, hgX, hgU⟩ := SetLike.not_le_iff_exists.mp hX
  let : Finite S := Nat.finite_of_card_ne_zero (by rw [P.card]; positivity)
  let : P.U.Normal := P.U.normal_of_index_eq_two P.index_U
  let : IsCyclic (S ⧸ P.U) := isCyclic_of_prime_card (p := 2) P.index_U
  let f := (QuotientGroup.mk' P.U).comp X.subtype
  obtain ⟨a, ha, haf⟩ := kernel_involution ((IsPGroup.of_card P.card).to_subgroup X) f hcyc
  have haU : (a : S) ∈ P.U := (QuotientGroup.eq_one_iff _).mp haf
  have ha2 : (a : S) ^ 2 = 1 := by
    have he := pow_orderOf_eq_one a
    rw [ha] at he
    exact congrArg Subtype.val he
  have hane : (a : S) ≠ 1 := by
    intro he
    have : a = 1 := Subtype.ext he
    simp [this] at ha
  rcases P.base_involution_cases haU ha2 with h | h | h | h
  · exact (hane h).elim
  · exact h ▸ a.property
  · have h₂ : P.x₂ ∈ X := h ▸ a.property
    have h₃ : P.x₃ ∈ X := P.outer_conj_x₂ hgU ▸ X.mul_mem (X.mul_mem hgX h₂) (X.inv_mem hgX)
    exact P.x_eq_x₂_mul_x₃ ▸ X.mul_mem h₂ h₃
  · have h₃ : P.x₃ ∈ X := h ▸ a.property
    have h₂ : P.x₂ ∈ X := P.outer_conj_x₃ hgU ▸ X.mul_mem (X.mul_mem hgX h₃) (X.inv_mem hgX)
    exact P.x_eq_x₂_mul_x₃ ▸ X.mul_mem h₂ h₃
end ABG.Wreathed.Presentation
