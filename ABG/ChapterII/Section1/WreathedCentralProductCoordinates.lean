module
public import ABG.ChapterII.Section1.WreathedExceptionalDefs
public import ABG.ChapterII.Section1.WreathedCenter
public import ABG.ChapterII.Section1.WreathedBase

/-!
# Coordinates of the canonical quaternion central product

For the chosen wreathed presentation, the subgroup `V` from the exceptional
model of ABG Chapter II §1 Lemma 3 (article p.10) is generated by `x₂`, `z`,
and the ambient center. In the normal form `s^i*t^j*z^k`, its elements are
exactly those for which `2^(n-1)` divides `i-j`.

Multiplying the quarter-power of `r` by the matching power of the central
element `u` recovers `x₂`, and the generator `d` then recovers `z`. The
subgroup generated by `x₂` and the center is normal: the base centralizes
it, while `z` replaces `x₂` by `x₃ = x₂⁻¹*x`. Consequently elements of `V`
can be collected as `x₂^a*u^b*z^c`. Comparing this expression with the unique
wreathed normal form gives the divisibility criterion, and the converse
reconstructs that expression. The height bound and exact normal coordinates
are those of the original presentation; the subgroup is never replaced by
an abstract isomorphic model.
-/

namespace ABG.Wreathed.Presentation
variable {S : Type*} [Group S] {n : ℕ} (P : Presentation S n)

private theorem quarter_identity : P.u ^ (2 ^ (n - 2)) * P.r ^ (2 ^ (n - 2)) = P.x₂ := by
  have hc : Commute P.u P.r := ((Subgroup.mem_center_iff.mp P.u_mem_center) P.r).symm
  rw [← hc.mul_pow, P.u_mul_r, ← pow_mul]
  congr 1
  have hn : n - 1 = (n - 2) + 1 := by have := P.height; omega
  rw [hn, pow_succ, Nat.mul_comm]

public theorem V_eq_generators_center :
    P.V = Subgroup.closure ({P.x₂, P.z} : Set S) ⊔ Subgroup.center S := by
  let W := Subgroup.closure ({P.x₂, P.z} : Set S) ⊔ Subgroup.center S
  have hxW : P.x₂ ∈ W := (show Subgroup.closure ({P.x₂, P.z} : Set S) ≤ W from le_sup_left)
    (Subgroup.subset_closure (by simp))
  have hzW : P.z ∈ W := (show Subgroup.closure ({P.x₂, P.z} : Set S) ≤ W from le_sup_left)
    (Subgroup.subset_closure (by simp))
  have huW : P.u ∈ W := (show Subgroup.center S ≤ W from le_sup_right) P.u_mem_center
  have hcV : P.r ^ (2 ^ (n - 2)) ∈ P.V :=
    (show P.quaternionCore ≤ P.V from le_sup_left) (Subgroup.subset_closure (by simp))
  have hdV : P.d ∈ P.V :=
    (show P.quaternionCore ≤ P.V from le_sup_left) (Subgroup.subset_closure (by simp))
  have huV : P.u ∈ P.V := (show Subgroup.center S ≤ P.V from le_sup_right) P.u_mem_center
  have hxV : P.x₂ ∈ P.V := P.quarter_identity ▸ P.V.mul_mem (P.V.pow_mem huV _) hcV
  have hzV : P.z ∈ P.V := by
    have hh := P.V.mul_mem (P.V.inv_mem hxV) hdV
    simpa [d] using hh
  apply le_antisymm
  · apply sup_le _ le_sup_right
    apply (Subgroup.closure_le _).mpr
    intro a ha
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at ha
    rcases ha with rfl | rfl
    · have hh := W.mul_mem (W.inv_mem (W.pow_mem huW (2 ^ (n - 2)))) hxW
      change P.r ^ (2 ^ (n - 2)) ∈ W
      simpa only [← P.quarter_identity, inv_mul_cancel_left] using hh
    · exact W.mul_mem hxW hzW
  · apply sup_le _ le_sup_right
    apply (Subgroup.closure_le _).mpr
    intro a ha
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at ha
    rcases ha with rfl | rfl
    · exact hxV
    · exact hzV

private def diagonalBase : Subgroup S := Subgroup.zpowers P.x₂ ⊔ Subgroup.center S

private theorem diagonalBase_le_U : P.diagonalBase ≤ P.U := by
  apply sup_le
  · exact Subgroup.zpowers_le.mpr (P.U.pow_mem (Subgroup.subset_closure (by simp)) _)
  · rw [P.center_eq_zpowers]
    exact Subgroup.zpowers_le.mpr (P.U.mul_mem
      (Subgroup.subset_closure (by simp)) (Subgroup.subset_closure (by simp)))

private theorem diagonalBase_normal : P.diagonalBase.Normal := by
  let : Finite S := Nat.finite_of_card_ne_zero (by rw [P.card]; positivity)
  apply Subgroup.normalizer_eq_top_iff.mp
  apply top_unique
  rw [← P.generate]
  apply (Subgroup.closure_le _).mpr
  have hu : P.U ≤ Subgroup.normalizer (P.diagonalBase : Set S) := by
    apply Subgroup.le_normalizer_iff.mpr
    intro a ha b hb
    have hc := P.commute_of_mem_U ha (P.diagonalBase_le_U hb)
    simpa [hc.eq] using hb
  intro a ha
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at ha
  rcases ha with rfl | rfl | rfl
  · exact hu (Subgroup.subset_closure (by simp))
  · exact hu (Subgroup.subset_closure (by simp))
  · apply Subgroup.mem_normalizer_iff_map_conj_eq.mpr
    apply Subgroup.eq_of_le_of_card_ge
    · rw [diagonalBase, Subgroup.map_sup, MonoidHom.map_zpowers,
        Subgroup.Normal.map_conj_eq (Subgroup.center S) P.z]
      apply sup_le _ le_sup_right
      apply Subgroup.zpowers_le.mpr
      have hx : P.x ∈ P.diagonalBase := (show Subgroup.center S ≤ P.diagonalBase from le_sup_right) P.x_mem_center
      have hx2 : P.x₂ ∈ P.diagonalBase :=
        (show Subgroup.zpowers P.x₂ ≤ P.diagonalBase from le_sup_left) (Subgroup.mem_zpowers _)
      have hx3 : P.x₃ ∈ P.diagonalBase := by
        have hh := P.diagonalBase.mul_mem (P.diagonalBase.inv_mem hx2) hx
        simpa only [P.x_eq_x₂_mul_x₃, inv_mul_cancel_left] using hh
      simpa [MulAut.conj_apply, x₂, x₃, P.z_mul_s_pow, mul_assoc, diagonalBase] using hx3
    · rw [Subgroup.card_map_of_injective (MulAut.conj P.z).injective]

private theorem V_eq_diagonalBase_sup : P.V = P.diagonalBase ⊔ Subgroup.zpowers P.z := by
  rw [P.V_eq_generators_center, diagonalBase]
  calc
    _ = (Subgroup.zpowers P.x₂ ⊔ Subgroup.zpowers P.z) ⊔ Subgroup.center S := by
      rw [Subgroup.zpowers_eq_closure, Subgroup.zpowers_eq_closure, ← Subgroup.closure_union]
      simp only [Set.singleton_union]
    _ = _ := by ac_rfl

private theorem exists_V_form {g : S} (hg : g ∈ P.V) :
    ∃ a b c : ℤ, P.x₂ ^ a * P.u ^ b * P.z ^ c = g := by
  let := P.diagonalBase_normal
  rw [P.V_eq_diagonalBase_sup] at hg
  obtain ⟨v,hv,z,hz,rfl⟩ := Subgroup.mem_sup_of_normal_left.mp hg
  obtain ⟨c,rfl⟩ := Subgroup.mem_zpowers_iff.mp hz
  change v ∈ Subgroup.zpowers P.x₂ ⊔ Subgroup.center S at hv
  obtain ⟨w,hw,u,hu,rfl⟩ := Subgroup.mem_sup_of_normal_right.mp hv
  obtain ⟨a,rfl⟩ := Subgroup.mem_zpowers_iff.mp hw
  rw [P.center_eq_zpowers] at hu
  obtain ⟨b,rfl⟩ := Subgroup.mem_zpowers_iff.mp hu
  exact ⟨a,b,c,rfl⟩

private theorem V_form_eq (a b c : ℤ) :
    P.x₂ ^ a * P.u ^ b * P.z ^ c =
      P.s ^ (((2^(n-1) : ℕ) : ℤ)*a+b) * P.t ^ b * P.z ^ c := by
  have hc : Commute P.s P.t := P.commute
  rw [x₂, ← zpow_natCast, ← zpow_mul, u, hc.mul_zpow]
  rw [← mul_assoc, ← zpow_add]

public theorem normal_form_zpow_mem_V_iff (i j k : ℤ) :
    P.s ^ i * P.t ^ j * P.z ^ k ∈ P.V ↔ ((2^(n-1) : ℕ) : ℤ) ∣ i-j := by
  let H : ℤ := ((2^(n-1) : ℕ) : ℤ)
  change P.s ^ i * P.t ^ j * P.z ^ k ∈ P.V ↔ H ∣ i-j
  have hHN : H ∣ ((2^n : ℕ) : ℤ) := by
    apply Int.natCast_dvd_natCast.mpr
    exact pow_dvd_pow _ (by omega)
  constructor
  · intro hg
    obtain ⟨a,b,c,he⟩ := P.exists_V_form hg
    have hcoords := (P.normal_form_zpow_eq_iff i j k (H*a+b) b c).mp
      (he.symm.trans (P.V_form_eq a b c))
    have hi : H ∣ (H*a+b)-i := hHN.trans (Int.ModEq.dvd hcoords.1)
    have hj : H ∣ b-j := hHN.trans (Int.ModEq.dvd hcoords.2.1)
    have hd := dvd_sub (dvd_mul_right H a) (dvd_sub hi hj)
    have heq : H*a - ((H*a+b-i)-(b-j)) = i-j := by ring
    rw [heq] at hd
    exact hd
  · rintro ⟨a,ha⟩
    have he : i = H*a+j := by omega
    rw [he, ← P.V_form_eq a j k]
    have hx₂ : P.x₂ ∈ P.V := by
      rw [P.V_eq_generators_center]
      exact (show Subgroup.closure ({P.x₂,P.z} : Set S) ≤ _ from le_sup_left)
        (Subgroup.subset_closure (by simp))
    have hz : P.z ∈ P.V := by
      rw [P.V_eq_generators_center]
      exact (show Subgroup.closure ({P.x₂,P.z} : Set S) ≤ _ from le_sup_left)
        (Subgroup.subset_closure (by simp))
    have hu : P.u ∈ P.V := (show Subgroup.center S ≤ P.V from le_sup_right) P.u_mem_center
    exact P.V.mul_mem (P.V.mul_mem (P.V.zpow_mem hx₂ a) (P.V.zpow_mem hu j))
      (P.V.zpow_mem hz k)

end ABG.Wreathed.Presentation
