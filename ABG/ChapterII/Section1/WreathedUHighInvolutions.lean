module
public import ABG.ChapterII.Section1.WreathedUFrattiniAction
public import ABG.ChapterII.Section1.WreathedFrameTransport
public import ABG.ChapterII.Section1.WreathedBaseFour

/-!
# Fusion of the wreathed base involutions

In a finite group with a wreathed fusion frame, an automizer of order six
fuses all three involutions of the actual abelian base subgroup. This is
the involution-fusion assertion in Alperin--Brauer--Gorenstein, Chapter II,
Section 1, Proposition 2, article p.12, second proof paragraph in
`refs/latex/alperin-brauer-gorenstein-pages/page-013.tex`.

The normalizer induces the full automorphism group of the Klein four
Frattini quotient by the faithful action theorem and the order-six
hypothesis. The base has exponent `2^n`, so its `2^(n-1)` power map kills
its Frattini subgroup: the base is abelian, and its Frattini subgroup is
generated by squares. The classification of its four square-one elements
gives a root of each involution under that power map. Both root classes
in the Frattini quotient are nonidentity. A Klein four automorphism taking
one class to the other lifts to the normalizer; taking powers yields the
required ambient conjugacy. The argument transports the presentation base
through its actual Sylow inclusion to the frame subgroup.
-/

open scoped IsMulCommutative

private theorem power_kills_frattini
    {A : Type*} [Group A] [Finite A] [IsMulCommutative A]
    (hA : IsPGroup 2 A) (k : ℕ) (hk : ∀ a : A, a ^ (2*k) = 1) :
    frattini A ≤ (powMonoidHom k : A →* A).ker := by
  let : Fact (IsPGroup 2 A) := ⟨hA⟩
  rw [frattini_eq_closure_commutator_union_powers (p := 2)]
  apply (Subgroup.closure_le _).mpr
  rintro a (ha | ⟨b, rfl⟩)
  · have hc : _root_.commutator A = ⊥ := by
      rw [commutator_eq_bot_iff_center_eq_top]
      exact Subgroup.center_eq_top
    rw [hc] at ha
    have ha' : a = 1 := ha
    simp [ha']
  · change (b ^ 2) ^ k = 1
    rw [← pow_mul]
    exact hk b

private theorem quotient_action_conj
    {G : Type*} [Group G] [Finite G] (U : Subgroup G)
    [IsMulCommutative U] [IsKleinFour (U ⧸ frattini U)]
    (hU : IsPGroup 2 U) (k : ℕ) (hk : ∀ a : U, a ^ (2*k) = 1)
    (hfull : Function.Surjective
      ((Subgroup.quotientAut (frattini U)).comp U.normalizerMonoidHom))
    (x y a b : U) (hx : x ≠ 1) (hy : y ≠ 1)
    (ha : a ^ k = x) (hb : b ^ k = y) : IsConj (x : G) (y : G) := by
  classical
  let f := QuotientGroup.lift (frattini U) (powMonoidHom k : U →* U)
    (power_kills_frattini hU k hk)
  let qa := QuotientGroup.mk' (frattini U) a
  let qb := QuotientGroup.mk' (frattini U) b
  have hfa : f qa = x := ha
  have hfb : f qb = y := hb
  have hqa : qa ≠ 1 := by
    intro h
    apply hx
    rw [← hfa, h, map_one]
  have hqb : qb ≠ 1 := by
    intro h
    apply hy
    rw [← hfb, h, map_one]
  let alpha : MulAut (U ⧸ frattini U) :=
    IsKleinFour.mulEquiv (Equiv.swap qa qb)
      (Equiv.swap_apply_of_ne_of_ne hqa.symm hqb.symm)
  have halpha : alpha qa = qb := Equiv.swap_apply_left qa qb
  obtain ⟨g, hg⟩ := hfull alpha
  have hq : QuotientGroup.mk' (frattini U) (U.normalizerMonoidHom g a) = qb := by
    have h := DFunLike.congr_fun hg qa
    change (Subgroup.quotientAut (frattini U) (U.normalizerMonoidHom g))
      (QuotientGroup.mk' (frattini U) a) = alpha qa at h
    simpa only [Subgroup.quotientAut_apply_mk, halpha] using h
  have hp := congrArg f hq
  have hxy : U.normalizerMonoidHom g x = y := by
    change (U.normalizerMonoidHom g a) ^ k = f qb at hp
    rw [← map_pow, ha, hfb] at hp
    exact hp
  apply isConj_iff.mpr
  exact ⟨g, congrArg Subtype.val hxy⟩

namespace ABG.Wreathed.Presentation
variable {A : Type*} [Group A] {n : ℕ} (P : Presentation A n)

private theorem base_period (a : P.U) : a ^ (2 ^ n) = 1 := by
  apply P.baseEquiv.injective
  rw [map_pow, map_one]
  apply Prod.ext
  · simpa using (pow_card_eq_one' (x := (P.baseEquiv a).1))
  · simpa using (pow_card_eq_one' (x := (P.baseEquiv a).2))

private theorem base_involution_root (x : P.U) (hx : x ^ 2 = 1) :
    ∃ a : P.U, a ^ (2 ^ (n-1)) = x := by
  have hx' : (x : A) ^ 2 = 1 := congrArg Subtype.val hx
  rcases P.base_involution_cases x.property hx' with h | h | h | h
  · refine ⟨1, ?_⟩
    apply Subtype.ext
    simpa using h.symm
  · refine ⟨⟨P.u, ?_⟩, ?_⟩
    · exact P.U.mul_mem (Subgroup.subset_closure (by simp)) (Subgroup.subset_closure (by simp))
    · exact Subtype.ext h.symm
  · refine ⟨⟨P.s, Subgroup.subset_closure (by simp)⟩, ?_⟩
    exact Subtype.ext h.symm
  · refine ⟨⟨P.t, Subgroup.subset_closure (by simp)⟩, ?_⟩
    exact Subtype.ext h.symm

end ABG.Wreathed.Presentation

namespace ABG.Wreathed

/-- An automizer of order six fuses all involutions of the wreathed base. -/
public theorem u_involutions_isConj
    {G : Type*} [Group G] [Finite G]
    (S : Sylow 2 G) (n : ℕ) (U V : Subgroup G)
    (hf : WreathedFusionFrame S n U V)
    (hindex : automizerIndex U = 6)
    (x y : U) (hx : orderOf x = 2) (hy : orderOf y = 2) :
    IsConj (x : G) (y : G) := by
  let := (u_frattini_action S n U V hf).1
  have hfull := u_frattini_action_surjective S n U V hf hindex
  obtain ⟨P⟩ := nonempty_presentation hf.1
  have hUP := (hf.presentation_representatives P).1
  let e : P.U ≃* U :=
    (P.U.equivMapOfInjective (S : Subgroup G).subtype
      (S : Subgroup G).subtype_injective).trans (MulEquiv.subgroupCongr hUP.symm)
  let : IsMulCommutative U := hf.2.2.1
  have hU : IsPGroup 2 U := IsPGroup.of_card (n := 2*n) (by
    rw [← Nat.card_congr e.toEquiv]
    exact P.card_U)
  have hk : ∀ a : U, a ^ (2 * 2 ^ (n-1)) = 1 := by
    intro a
    apply e.symm.injective
    rw [map_pow, map_one]
    have he : 2 * 2 ^ (n-1) = 2 ^ n := by
      rw [Nat.mul_comm, ← pow_succ]
      congr 1
      have := P.height
      omega
    rw [he]
    exact P.base_period _
  obtain ⟨a, ha⟩ := P.base_involution_root (e.symm x) (by
    rw [← map_pow]
    have h := pow_orderOf_eq_one x
    rw [hx] at h
    simp [h])
  obtain ⟨b, hb⟩ := P.base_involution_root (e.symm y) (by
    rw [← map_pow]
    have h := pow_orderOf_eq_one y
    rw [hy] at h
    simp [h])
  exact quotient_action_conj U hU (2^(n-1)) hk hfull x y (e a) (e b)
    (by intro h; simp [h] at hx) (by intro h; simp [h] at hy)
    (by rw [← map_pow, ha, e.apply_symm_apply])
    (by rw [← map_pow, hb, e.apply_symm_apply])

end ABG.Wreathed
