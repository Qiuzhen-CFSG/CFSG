module
public import ABG.ChapterII.Section1.WreathedDiagonalOrder
public import ABG.ChapterII.Section1.WreathedRelations

/-!
# The center of a wreathed group

For the chosen wreathed presentation of height `n ≥ 2`, the center is the
cyclic diagonal subgroup generated by `u = s*t`, of order `2^n`. This proves
the center assertion in ABG Chapter II §1 Lemma 2(vii), article p.10; the
quotient assertion is handled separately.

Unique normal coordinates force a central element to have zero involution
coordinate: an element in the other coset would interchange the distinct
base generators. Commuting with the swapping involution then forces the two
base coordinates to agree. Conversely, the diagonal generator commutes with
all three generators. Its exact order is imported from `WreathedDiagonalOrder`.
-/

namespace ABG.Wreathed.Presentation
variable {S : Type*} [Group S] {n : ℕ} (P : Presentation S n)

include P in
private theorem pow_bound : 1 < 2 ^ n := by
  have := P.height
  exact Nat.one_lt_pow (by omega) (by omega)

private theorem s_ne_t : P.s ≠ P.t := by
  intro h
  have he : P.normalForm (⟨1, P.pow_bound⟩, ⟨0, by positivity⟩, 0) =
      P.normalForm (⟨0, by positivity⟩, ⟨1, P.pow_bound⟩, 0) := by
    simpa [normalForm] using h
  have := congrArg (fun v => v.1.val) (P.normal_form_injective he)
  simp at this

public theorem u_mem_center : P.u ∈ Subgroup.center S := by
  have hc : Commute P.s P.t := P.commute
  have hs : Commute P.s P.u := (Commute.refl _).mul_right hc
  have ht : Commute P.t P.u := hc.symm.mul_right (Commute.refl _)
  have hz : Commute P.z P.u := by
    change P.z * (P.s * P.t) = (P.s * P.t) * P.z
    rw [← mul_assoc, P.z_mul_s, mul_assoc, P.z_mul_t, ← mul_assoc, ← P.commute]
  rw [Subgroup.mem_center_iff]
  intro g
  rcases P.exists_normal_form g with ⟨i,j,b,rfl⟩
  exact ((hs.pow_left i.val).mul_left (ht.pow_left j.val)).mul_left
    (hz.pow_left b.val)

public theorem center_eq_zpowers : Subgroup.center S = Subgroup.zpowers P.u := by
  apply le_antisymm
  · intro g hg
    have hs := (Subgroup.mem_center_iff.mp hg) P.s
    have hz := (Subgroup.mem_center_iff.mp hg) P.z
    rcases P.exists_normal_form g with ⟨i,j,b,rfl⟩
    have hc : Commute P.s P.t := P.commute
    have hbs : Commute P.s (P.s ^ i.val * P.t ^ j.val) :=
      (Commute.self_pow _ _).mul_right (hc.pow_right _)
    have hb : b.val = 0 := by
      have bb : b.val = 0 ∨ b.val = 1 := by omega
      rcases bb with hh | hh
      · exact hh
      exfalso
      simp only [hh, pow_one] at hs
      have he : P.s * P.z = P.t * P.z := by
        apply mul_left_cancel (a := P.s ^ i.val * P.t ^ j.val)
        calc
          _ = P.s * (P.s ^ i.val * P.t ^ j.val * P.z) := by rw [← mul_assoc, ← hbs.eq, mul_assoc]
          _ = _ := by rw [hs, mul_assoc, P.z_mul_s]
      exact P.s_ne_t (mul_right_cancel he)
    simp only [hb, pow_zero, mul_one] at hz ⊢
    have he : P.normalForm (j,i,0) = P.normalForm (i,j,0) := by
      simp only [normalForm, Fin.val_zero, pow_zero, mul_one]
      apply mul_right_cancel (b := P.z)
      calc
        P.s ^ j.val * P.t ^ i.val * P.z = P.z * (P.s ^ i.val * P.t ^ j.val) := by
          symm
          calc
            _ = P.t ^ i.val * (P.z * P.t ^ j.val) := by rw [← mul_assoc, P.z_mul_s_pow, mul_assoc]
            _ = _ := by rw [P.z_mul_t_pow, ← mul_assoc, (hc.pow_pow j.val i.val).eq]
        _ = _ := hz
    have hij : j = i := congrArg Prod.fst (P.normal_form_injective he)
    rw [hij, ← hc.mul_pow]
    exact Subgroup.pow_mem _ (Subgroup.mem_zpowers _) _
  · exact Subgroup.zpowers_le.mpr P.u_mem_center

include P in
public theorem center_cyclic : IsCyclic (Subgroup.center S) := by
  rw [P.center_eq_zpowers]
  infer_instance

include P in
public theorem card_center : Nat.card (Subgroup.center S) = 2 ^ n := by
  rw [P.center_eq_zpowers, Nat.card_zpowers, P.orderOf_u]
public theorem x_mem_center : P.x ∈ Subgroup.center S :=
  (Subgroup.center S).pow_mem P.u_mem_center _

public theorem center_structure :
    Subgroup.center S = Subgroup.zpowers P.u ∧
    IsCyclic (Subgroup.center S) ∧ Nat.card (Subgroup.center S) = 2 ^ n :=
  ⟨P.center_eq_zpowers, P.center_cyclic, P.card_center⟩
end ABG.Wreathed.Presentation
