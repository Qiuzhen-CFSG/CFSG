module
public import ABG.ChapterII.Section1.WreathedDefs
public import Mathlib.GroupTheory.SpecificGroups.Cyclic.Basic

/-!
# Killing involutions gives a cyclic image

A homomorphism from a semidihedral or wreathed group which kills every
square-one element has cyclic image. The target group is arbitrary; the source
has exactly the hypotheses of the existing structural predicates.

For the semidihedral generators a,b, killing the involution b leaves the image
generated by f(a). For the wreathed generators s,t,z, killing the involution z
in the relation z^-1*s*z=t identifies f(s) and f(t), so f(s) generates the
image. In each case, the generating-set closure lies in the preimage of the
designated cyclic subgroup.

This is the cyclic-image consequence of ABG Chapter II Section 1 Lemmas 1(vi)
and 2(viii), used in Section 2 Proposition 2, article p.15 of
`refs/latex/alperin-brauer-gorenstein.tex`. The proof makes the relevant
presentation reduction explicit, without requiring a separate omega quotient.
-/

namespace ABG
variable {S H : Type*} [Group S] [Group H]

/-- Killing every involution of a semidihedral or wreathed group leaves a
cyclic image. -/
public theorem cyclic_range_of_involutions_killed
    (hS : Stellmacher.IsSemidihedralGroup S ∨ IsWreathedGroup S)
    (f : S →* H) (hkill : ∀ x : S, x^2=1 → f x=1) : IsCyclic f.range := by
  rcases hS with hsemi | hwreath
  · obtain ⟨n, hn, hcard, a, b, ha, hb, hconj, hgen⟩ := hsemi
    have hfb : f b = 1 := hkill b (by rw [← hb]; exact pow_orderOf_eq_one b)
    apply Subgroup.isCyclic_of_le (H' := Subgroup.zpowers (f a))
    rw [f.range_eq_map, Subgroup.map_le_iff_le_comap, ← hgen]
    apply (Subgroup.closure_le _).mpr
    intro x hx
    rcases Set.mem_insert_iff.mp hx with hx | hx
    · subst x
      exact Subgroup.mem_zpowers (f a)
    · have : x = b := Set.mem_singleton_iff.mp hx
      subst x
      change f b ∈ Subgroup.zpowers (f a)
      rw [hfb]
      exact (Subgroup.zpowers (f a)).one_mem
  · obtain ⟨n, hn, hcard, s, t, z, hs, ht, hz, hzs, hzt, hst, hgen⟩ := hwreath
    have hfz := hkill z hz
    have hfs : f s = f t := by
      have hh := congrArg f hzs
      simpa only [map_mul, map_inv, hfz, inv_one, one_mul, mul_one] using hh
    apply Subgroup.isCyclic_of_le (H' := Subgroup.zpowers (f s))
    rw [f.range_eq_map, Subgroup.map_le_iff_le_comap, ← hgen]
    apply (Subgroup.closure_le _).mpr
    intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with hx | hx | hx
    · subst x
      exact Subgroup.mem_zpowers (f s)
    · subst x
      change f t ∈ Subgroup.zpowers (f s)
      rw [← hfs]
      exact Subgroup.mem_zpowers (f s)
    · subst x
      change f z ∈ Subgroup.zpowers (f s)
      rw [hfz]
      exact (Subgroup.zpowers (f s)).one_mem
end ABG
