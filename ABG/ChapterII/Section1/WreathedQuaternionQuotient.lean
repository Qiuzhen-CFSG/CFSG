module
public import ABG.ChapterII.Section1.WreathedMaximalQuaternion
public import Mathlib.GroupTheory.QuotientGroup.Basic
public import Mathlib.GroupTheory.SpecificGroups.Cyclic.Basic

/-!
# The cyclic quaternion quotient of a wreathed group

For the canonical normal generalized quaternion subgroup Y of a wreathed
presentation of height n, the quotient is cyclic of order 2^n. This supplies
the cyclic focal quotient needed for the normal subgroup in ABG Chapter II,
Section 1, Proposition 2(ii), article pp.12--13.

Lemma 2(x), article p.10, generates the whole group by Y and sz, so the
quotient is generated by the image of sz. The established orders of Y and
the whole group then give the index by Lagrange's theorem. The statement
uses precisely the normality instance supplied by the quaternion theorem.
-/

namespace ABG.Wreathed.Presentation
variable {S : Type*} [Group S] {n : ℕ} (P : Presentation S n)

/-- The canonical quaternion subgroup has cyclic quotient of the prescribed index. -/
public theorem quaternion_quotient :
    letI : P.Y.Normal := P.quaternion_subgroup.2.2
    IsCyclic (S ⧸ P.Y) ∧ P.Y.index = 2 ^ n := by
  let : P.Y.Normal := P.quaternion_subgroup.2.2
  constructor
  · let q := QuotientGroup.mk' P.Y
    apply isCyclic_iff_exists_zpowers_eq_top.mpr
    refine ⟨q (P.s * P.z), ?_⟩
    have hmap : P.Y.map q = ⊥ := by
      apply (Subgroup.map_eq_bot_iff _).mpr
      simp only [q, QuotientGroup.ker_mk', le_refl]
    have hh := congrArg (Subgroup.map q) P.generator_change.2
    rw [Subgroup.map_sup, hmap, bot_sup_eq, MonoidHom.map_zpowers,
      Subgroup.map_top_of_surjective q (QuotientGroup.mk'_surjective _)] at hh
    exact hh
  · have hcard := P.Y.card_mul_index
    rw [P.quaternion_subgroup.2.1, P.card] at hcard
    apply Nat.eq_of_mul_eq_mul_left (show 0 < 2 ^ (n+1) by positivity)
    rw [hcard, ← pow_add]
    congr 1
    omega

end ABG.Wreathed.Presentation
