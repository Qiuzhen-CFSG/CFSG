module
public import ABG.ChapterII.Section1.WreathedFusionFrame
public import ABG.ChapterII.Section1.WreathedFocalGenerators
public import ABG.ChapterII.Section1.WreathedLowNormalizerFusion
public import ABG.ChapterII.Section1.WreathedUHighFocal
public import ABG.ChapterII.Section1.WreathedVHighFocal
public import ABG.ChapterII.Section1.WreathedDerived

/-!
# The four wreathed focal subgroups

For a chosen presentation of a wreathed Sylow two-subgroup, the ordinary
automizer index of its canonical base U and the outer automizer index of
its canonical central product V determine the focal subgroup. The pairs
(2,2), (2,6), (6,2), and (6,6) give the derived subgroup, Y, U, and the
whole Sylow subgroup, respectively. Both indices use the actual ambient
images, and the outer denominator retains the product with the centralizer.

The canonical fusion frame and focal-generator theorem express the focal
subgroup as the join of the Sylow derived subgroup and the two local
normalizer contributions. Low actions contribute only commutators; high
actions contribute U and the quaternion core, respectively. The derived
subgroup is generated by r, so its join with the core is Y = <r,d>.
The base together with d generates the Sylow subgroup since d = x₂*z.
These generator calculations and lattice absorption finish all four cases.

This is the focal calculation in Alperin--Brauer--Gorenstein Chapter II,
Section 1, Proposition 2, article pp.12--13, in
`refs/latex/alperin-brauer-gorenstein-pages/page-013.tex` and `page-014.tex`.
Normal-subgroup and involution-class consequences are assembled separately.
-/

namespace ABG.Wreathed.Presentation
variable {S : Type*} [Group S] {n : ℕ} (P : Presentation S n)

private theorem derived_le_U : commutator S ≤ P.U := by
  rw [P.derived_structure.1, Subgroup.zpowers_le]
  exact P.U.mul_mem (Subgroup.subset_closure (by simp))
    (P.U.inv_mem (Subgroup.subset_closure (by simp)))

private theorem derived_sup_quaternionCore : commutator S ⊔ P.quaternionCore = P.Y := by
  have hr : P.r ∈ P.Y := Subgroup.subset_closure (by simp)
  have hd : P.d ∈ P.Y := Subgroup.subset_closure (by simp)
  rw [P.derived_structure.1]
  apply le_antisymm
  · refine sup_le (Subgroup.zpowers_le.mpr hr) ?_
    rw [quaternionCore, Subgroup.closure_le]
    intro x hx
    rcases hx with rfl | rfl
    · exact P.Y.pow_mem hr _
    · exact hd
  · rw [Y, Subgroup.closure_le]
    intro x hx
    rcases hx with rfl | rfl
    · exact (le_sup_left : Subgroup.zpowers P.r ≤ _ ⊔ P.quaternionCore)
        (Subgroup.mem_zpowers _)
    · exact (le_sup_right : P.quaternionCore ≤ Subgroup.zpowers P.r ⊔ _)
        (Subgroup.subset_closure (by simp))

private theorem U_sup_quaternionCore : P.U ⊔ P.quaternionCore = ⊤ := by
  have hs : P.s ∈ P.U ⊔ P.quaternionCore :=
    (le_sup_left : P.U ≤ P.U ⊔ P.quaternionCore) (Subgroup.subset_closure (by simp))
  have ht : P.t ∈ P.U ⊔ P.quaternionCore :=
    (le_sup_left : P.U ≤ P.U ⊔ P.quaternionCore) (Subgroup.subset_closure (by simp))
  have hd : P.d ∈ P.U ⊔ P.quaternionCore :=
    (le_sup_right : P.quaternionCore ≤ P.U ⊔ P.quaternionCore)
      (Subgroup.subset_closure (by simp))
  have hz : P.z ∈ P.U ⊔ P.quaternionCore := by
    have hx := (P.U ⊔ P.quaternionCore).pow_mem hs (2 ^ (n - 1))
    have hh := (P.U ⊔ P.quaternionCore).mul_mem
      ((P.U ⊔ P.quaternionCore).inv_mem hx) hd
    simpa only [d, x₂, inv_mul_cancel_left] using hh
  apply top_unique
  rw [← P.generate, Subgroup.closure_le]
  intro x hx
  rcases hx with rfl | rfl | rfl
  · exact hs
  · exact ht
  · exact hz
end ABG.Wreathed.Presentation

namespace ABG.Wreathed

/-- All four exact focal subgroup values for a chosen wreathed presentation. -/
public theorem focal_subgroup_cases
    {G : Type*} [Group G] [Finite G]
    (S : Sylow 2 G) {n : ℕ} (P : Presentation S n) :
    (automizerIndex (P.U.map (S : Subgroup G).subtype) = 2 →
      outerAutomizerIndex (P.V.map (S : Subgroup G).subtype) = 2 →
      (S : Subgroup G).focalSubgroupOf = commutator S) ∧
    (automizerIndex (P.U.map (S : Subgroup G).subtype) = 2 →
      outerAutomizerIndex (P.V.map (S : Subgroup G).subtype) = 6 →
      (S : Subgroup G).focalSubgroupOf = P.Y) ∧
    (automizerIndex (P.U.map (S : Subgroup G).subtype) = 6 →
      outerAutomizerIndex (P.V.map (S : Subgroup G).subtype) = 2 →
      (S : Subgroup G).focalSubgroupOf = P.U) ∧
    (automizerIndex (P.U.map (S : Subgroup G).subtype) = 6 →
      outerAutomizerIndex (P.V.map (S : Subgroup G).subtype) = 6 →
      (S : Subgroup G).focalSubgroupOf = ⊤) := by
  let U := P.U.map (S : Subgroup G).subtype
  let V := P.V.map (S : Subgroup G).subtype
  have hf := P.fusionFrame S
  have hF := wreathed_focalSubgroupOf_eq S n U V hf
  let : IsMulCommutative U := hf.2.2.1
  have hUout : outerAutomizerIndex U = automizerIndex U := by
    unfold outerAutomizerIndex automizerIndex
    rw [sup_eq_right.mpr (Subgroup.le_centralizer (H := U))]
  have hUlow (h : automizerIndex U = 2) :
      normalizerFusionSubgroup (S : Subgroup G) U ≤ commutator S :=
    low_normalizerFusionSubgroup_le_commutator S n U V U hf (Or.inl rfl) (hUout.trans h)
  have hVlow (h : outerAutomizerIndex V = 2) :
      normalizerFusionSubgroup (S : Subgroup G) V ≤ commutator S :=
    low_normalizerFusionSubgroup_le_commutator S n U V V hf (Or.inr rfl) h
  have hUhigh (h : automizerIndex U = 6) :
      normalizerFusionSubgroup (S : Subgroup G) U = P.U := by
    rw [u_normalizerFusionSubgroup_eq S n U V hf h]
    exact Subgroup.comap_map_eq_self_of_injective (S : Subgroup G).subtype_injective P.U
  have hVhigh := v_normalizerFusionSubgroup_eq S P
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro hU hV
    rw [hF, sup_eq_left.mpr (hUlow hU), sup_eq_left.mpr (hVlow hV)]
  · intro hU hV
    rw [hF, sup_eq_left.mpr (hUlow hU), hVhigh hV, P.derived_sup_quaternionCore]
  · intro hU hV
    rw [hF, hUhigh hU, sup_eq_right.mpr P.derived_le_U,
      sup_eq_left.mpr ((hVlow hV).trans P.derived_le_U)]
  · intro hU hV
    rw [hF, hUhigh hU, sup_eq_right.mpr P.derived_le_U, hVhigh hV,
      P.U_sup_quaternionCore]
end ABG.Wreathed
