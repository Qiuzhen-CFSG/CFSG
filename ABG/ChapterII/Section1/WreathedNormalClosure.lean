module
public import ABG.ChapterII.Section1.WreathedMaximalQuaternion

/-!
# The normal closure of the quaternion generator

In a wreathed presentation, Y is the normal closure of the cyclic subgroup
of d, as asserted by Alperin–Brauer–Gorenstein, Chapter II §1 Lemma 2(ix),
article p.10. Normality of Y gives one inclusion. Conversely, the normal
closure contains d and its conjugate s*d*s⁻¹ = r*d, hence contains r; these
two elements generate Y. The normality input is the established quaternion
subgroup theorem, and the conjugation formula uses the same chosen generators.
-/

namespace ABG.Wreathed.Presentation
variable {S : Type*} [Group S] {n : ℕ} (P : Presentation S n)

/-- ABG II.1.2(ix): Y is the normal closure of the cyclic subgroup generated by d. -/
public theorem normal_closure_d :
    Subgroup.normalClosure (Subgroup.zpowers P.d : Set S) = P.Y := by
  let : P.Y.Normal := P.quaternion_subgroup.2.2
  apply le_antisymm
  · apply Subgroup.normalClosure_le_normal
    exact Subgroup.zpowers_le.mpr (Subgroup.subset_closure (by simp))
  · let N := Subgroup.normalClosure (Subgroup.zpowers P.d : Set S)
    have hd : P.d ∈ N := Subgroup.subset_normalClosure (Subgroup.mem_zpowers P.d)
    have hrd : P.r * P.d ∈ N := by
      rw [← P.s_conj_d]
      exact Subgroup.Normal.conj_mem inferInstance P.d hd P.s
    have hr : P.r ∈ N := by
      simpa only [mul_inv_cancel_right] using N.mul_mem hrd (N.inv_mem hd)
    apply (Subgroup.closure_le N).mpr
    intro g hg
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hg
    rcases hg with rfl | rfl
    · exact hr
    · exact hd

end ABG.Wreathed.Presentation
