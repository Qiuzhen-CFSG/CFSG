module
public import ABG.ChapterII.Section1.PresentationCalculus

/-!
# Identifying the first omega subgroup of a quasi-dihedral group

For the actual semidihedral presentation, the production subgroup
`omega₁ (G := G) (p := 2)` equals `⟨a²,b⟩`. This identification needs
only the generator orders, conjugation relation, and generation hypothesis;
it does not assume a separate cardinality formula or finiteness instance.

The first omega subgroup is generated by elements whose square is one.
Normal forms and the outer square formula show that each such element has
an even cyclic exponent. In the other direction, `b` and `a²b` have square
one, and their product is `a²`; hence they generate `⟨a²,b⟩` inside omega.

This is the subgroup-identification step of ABG Chapter II, §1, Lemma 1(vi),
article page 9 of `refs/latex/alperin-brauer-gorenstein.tex`. The companion
`Omega` module supplies the dihedral model and cardinality.
-/

namespace ABG.QuasiDihedral
variable {G : Type*} [Group G]
private theorem cyclic_square_one_even {n : ℕ} (hn : 4 ≤ n) {a : G}
    (ha : orderOf a = 2 ^ (n - 1)) {i : ℕ} (hi : (a ^ i) ^ 2 = 1) : 2 ∣ i := by
  have hd : 2 ^ (n - 1) ∣ i * 2 := by
    rw [← ha, orderOf_dvd_iff_pow_eq_one, pow_mul]
    exact hi
  have h4 : 4 ∣ 2 ^ (n - 1) := by
    exact pow_dvd_pow 2 (show 2 ≤ n - 1 by omega)
  exact (Nat.mul_dvd_mul_iff_right (by norm_num : 0 < 2)).mp (h4.trans hd)

private theorem outer_square_one_even {n : ℕ} (hn : 4 ≤ n) (a b : G)
    (ha : orderOf a = 2 ^ (n - 1)) (hb : orderOf b = 2)
    (hconj : b * a * b⁻¹ = a ^ (2 ^ (n - 2) - 1)) {i : ℕ}
    (hi : (a ^ i * b) ^ 2 = 1) : 2 ∣ i := by
  have hd : 2 ^ (n - 1) ∣ 2 ^ (n - 2) * i := by
    rw [← ha, orderOf_dvd_iff_pow_eq_one, ← outer_square hn a b hb hconj]
    exact hi
  have hm : 2 ^ (n - 1) = 2 ^ (n - 2) * 2 := by
    rw [show n - 1 = (n - 2) + 1 by omega, pow_succ]
  rw [hm] at hd
  exact (Nat.mul_dvd_mul_iff_left (by positivity)).mp hd

/-- The subgroup generated by involutions consists of the even-rotation dihedral subgroup. -/
public theorem omega_one_eq {n : ℕ} (hn : 4 ≤ n) (a b : G)
    (ha : orderOf a = 2 ^ (n - 1)) (hb : orderOf b = 2)
    (hconj : b * a * b⁻¹ = a ^ (2 ^ (n - 2) - 1))
    (hgen : Subgroup.closure ({a, b} : Set G) = ⊤) :
    omega₁ (G := G) (p := 2) = Subgroup.closure ({a ^ 2, b} : Set G) := by
  have hb2 : b ^ 2 = 1 := by rw [← hb]; exact pow_orderOf_eq_one _
  apply le_antisymm
  · rw [omega₁, omega, pow_one]
    apply (Subgroup.closure_le _).mpr
    intro x hx
    change x ^ 2 = 1 at hx
    obtain ⟨i, _, rfl | rfl⟩ := normal_form a b _ _ (by positivity) ha hb2 hconj hgen x
    · obtain ⟨j, rfl⟩ := cyclic_square_one_even hn ha hx
      rw [pow_mul]
      exact Subgroup.pow_mem _ (Subgroup.subset_closure (by simp)) _
    · obtain ⟨j, rfl⟩ := outer_square_one_even hn a b ha hb hconj hx
      rw [pow_mul]
      exact Subgroup.mul_mem _ (Subgroup.pow_mem _ (Subgroup.subset_closure (by simp)) _)
        (Subgroup.subset_closure (by simp))
  · have hmem {x : G} (hx : x ^ 2 = 1) : x ∈ omega₁ (G := G) (p := 2) := by
      apply Subgroup.subset_closure
      simpa only [Set.mem_ofPred_eq, pow_one] using hx
    have hab : (a ^ 2 * b) ^ 2 = 1 := by
      rw [outer_square hn a b hb hconj]
      rw [← pow_succ, show n - 2 + 1 = n - 1 by omega, ← ha, pow_orderOf_eq_one]
    have ha2 : a ^ 2 ∈ omega₁ (G := G) (p := 2) := by
      have hh := (omega₁ (G := G) (p := 2)).mul_mem (hmem hab) (hmem hb2)
      simpa only [mul_assoc, ← pow_two, hb2, mul_one] using hh
    apply (Subgroup.closure_le _).mpr
    intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl
    · exact ha2
    · exact hmem hb2

end ABG.QuasiDihedral
