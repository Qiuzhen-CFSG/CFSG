module

public import ABG.ChapterII.Section1.MaximalSubgroups
public import ABG.ChapterII.Section1.PresentationCalculus

/-!
# Proper normal subgroups of a quasi-dihedral group

Every proper normal subgroup of a quasi-dihedral group is maximal, or is
cyclic and contained in the derived subgroup. This is ABG Chapter II,
Section 1, Lemma 1(vii), article page 9 of
`refs/latex/alperin-brauer-gorenstein.tex`.

The derived subgroup is the cyclic subgroup generated by a². If a subgroup
contains a cyclic normal form outside this subgroup, its exponent is odd,
so that element generates the maximal cyclic subgroup. If a normal subgroup
contains an outer element a^i*b, conjugacy of outer exponents differing by
two gives a^(i+2)*b in the same subgroup. Cancellation puts a² in it, and
removing the even part of i gives b or ab. The subgroup therefore contains
one of the three previously classified maximal subgroups, so properness
makes it maximal. In the remaining case, cyclicity follows by inclusion
in the derived subgroup. Normal forms, even-shift conjugacy, the derived
subgroup calculation, and the three maximal subgroups are imported results.
-/

namespace ABG.QuasiDihedral
variable {G : Type*} [Group G]

private theorem square_mem_of_outer_mem {n : ℕ} (hn : 4 ≤ n) (a b : G)
    (ha : orderOf a = 2 ^ (n - 1))
    (hab : b * a * b⁻¹ = a ^ (2 ^ (n - 2) - 1))
    (H : Subgroup G) [H.Normal] (i : ℕ) (hi : a ^ i * b ∈ H) : a ^ 2 ∈ H := by
  obtain ⟨g, hg⟩ := isConj_iff.mp (outer_even_shift_isConj hn a b ha hab i 1)
  have hshift : a ^ (i + 2) * b ∈ H := by
    have ht := (inferInstance : H.Normal).conj_mem (a ^ i * b) hi g
    simpa only [hg, Nat.mul_one] using ht
  have hmem := H.mul_mem hshift (H.inv_mem hi)
  have heq : (a ^ (i + 2) * b) * (a ^ i * b)⁻¹ = a ^ 2 := by
    rw [add_comm i 2, pow_add]
    group
  rwa [heq] at hmem

/-- A proper normal subgroup of a quasi-dihedral group is maximal or cyclic
and contained in the derived subgroup. -/
public theorem normal_subgroup_maximal_or_cyclic (hG : Stellmacher.IsSemidihedralGroup G)
    (H : Subgroup G) [H.Normal] (hH : H ≠ ⊤) :
    IsCoatom H ∨ (IsCyclic H ∧ H ≤ commutator G) := by
  obtain ⟨n, a, b, hn, hcard, ha, hb, hab, hgen, hnf⟩ := exists_normal_form hG
  obtain ⟨hcf, hfk, hcyc, _⟩ := derived_eq_frattini hn hcard a b ha hb hab hgen
  have hck : commutator G = Subgroup.zpowers (a ^ 2) := hcf.trans hfk
  by_cases hle : H ≤ commutator G
  · right
    let := hcyc
    exact ⟨Subgroup.isCyclic_of_le hle, hle⟩
  left
  have hm := maximal_subgroups hn a b hcard ha hb hab hgen
  dsimp only at hm
  have hmax := hm.2.2.2.1
  have hC : IsCoatom (Subgroup.zpowers a) := (hmax _).mpr (Or.inl rfl)
  have hD : IsCoatom (Subgroup.closure ({a ^ 2, b} : Set G)) :=
    (hmax _).mpr (Or.inr (Or.inl rfl))
  have hQ : IsCoatom (Subgroup.closure ({a ^ 2, a * b} : Set G)) :=
    (hmax _).mpr (Or.inr (Or.inr rfl))
  have hcoatom (K : Subgroup G) (hK : IsCoatom K) (hKH : K ≤ H) : IsCoatom H := by
    have he : H = K := le_antisymm ((isCoatom_iff_ge_of_le.mp hK).2 H hH hKH) hKH
    rwa [he]
  have hx : ∃ x : G, x ∈ H ∧ x ∉ Subgroup.zpowers (a ^ 2) := by
    rw [hck] at hle
    exact Set.not_subset.mp hle
  obtain ⟨x, hxH, hxK⟩ := hx
  obtain ⟨i, _, rfl | rfl⟩ := hnf x
  · have hi : i % 2 = 1 := by
      have hmod : i % 2 = 0 ∨ i % 2 = 1 := by omega
      rcases hmod with hi | hi
      · exfalso
        apply hxK
        rw [← Nat.div_add_mod i 2, hi, pow_add, pow_zero, mul_one, pow_mul]
        exact Subgroup.pow_mem _ (Subgroup.mem_zpowers _) _
      · exact hi
    have hcop : i.Coprime (orderOf a) := by
      rw [ha]
      exact (Nat.odd_iff.mpr hi).coprime_two_right.pow_right _
    have haH : a ∈ H :=
      (Subgroup.zpowers_le.mpr hxH) (mem_zpowers_pow_iff.mpr hcop.gcd_eq_one)
    exact hcoatom _ hC (Subgroup.zpowers_le.mpr haH)
  · have hsq : a ^ 2 ∈ H := square_mem_of_outer_mem hn a b ha hab H i hxH
    have hr : a ^ (i % 2) * b ∈ H := by
      have ht := H.mul_mem (H.inv_mem (H.pow_mem hsq (i / 2))) hxH
      conv at ht in a ^ i => rw [← Nat.div_add_mod i 2, pow_add, pow_mul]
      simpa only [mul_assoc, inv_mul_cancel_left] using ht
    have hi : i % 2 = 0 ∨ i % 2 = 1 := by omega
    rcases hi with hi | hi
    · apply hcoatom _ hD
      rw [Subgroup.closure_le]
      intro y hy
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hy
      rcases hy with rfl | rfl
      · exact hsq
      · simpa [hi] using hr
    · apply hcoatom _ hQ
      rw [Subgroup.closure_le]
      intro y hy
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hy
      rcases hy with rfl | rfl
      · exact hsq
      · simpa [hi] using hr
end ABG.QuasiDihedral
