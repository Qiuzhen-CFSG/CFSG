module
public import ABG.ChapterII.Section1.InvolutionClasses
public import ABG.ChapterII.Section1.SmallSubgroups

/-!
# Involution representatives in a chosen four-subgroup

Every Klein four-subgroup `T` contained in a quasi-dihedral subgroup `P`
contains representatives of both conjugacy classes of involutions of `P`.
The representatives and conjugacy relation live in `P`, while their membership
in the chosen `T` is stated in the ambient group. No ambient finiteness or
Sylow hypothesis is needed.

The local centralizer formula from Lemma II.1.1(ii) implies that the central
involution of `P` belongs to `T`. Since `T` is not cyclic, it contains an
involution outside the cyclic subgroup generated by this central involution.
These two elements are not conjugate, because a central element has a singleton
conjugacy class. The two-class assertion of Lemma II.1.1(i) then gives coverage.
We perform this argument internally and transport the Klein four property
along the canonical equivalence from `T.subgroupOf P` to `T`.

This is the chosen-subgroup consequence of Alperin–Brauer–Gorenstein,
Chapter II, §1, Lemma 1(i),(ii), article p.9 of
`refs/latex/alperin-brauer-gorenstein.tex`, used for the high four-subgroup
automizer case of Proposition 1.
-/

namespace ABG.QuasiDihedral
variable {G : Type*} [Group G]

private theorem replace_representatives (z t : G)
    (hz : orderOf z = 2) (ht : orderOf t = 2) (hzt : ¬ IsConj z t)
    (hclasses : ∃ u v : G, orderOf u = 2 ∧ orderOf v = 2 ∧ ¬ IsConj u v ∧
      ∀ x : G, orderOf x = 2 → IsConj x u ∨ IsConj x v) :
    ∀ x : G, orderOf x = 2 → IsConj x z ∨ IsConj x t := by
  obtain ⟨u, v, _, _, _, hall⟩ := hclasses
  rcases hall z hz with hzu | hzv <;> rcases hall t ht with htu | htv
  · exact False.elim (hzt (hzu.trans htu.symm))
  · intro x hx
    exact (hall x hx).imp (fun h => h.trans hzu.symm) (fun h => h.trans htv.symm)
  · intro x hx
    exact (hall x hx).symm.imp (fun h => h.trans hzv.symm) (fun h => h.trans htu.symm)
  · exact False.elim (hzt (hzv.trans htv.symm))

private theorem internal_representatives (hG : Stellmacher.IsSemidihedralGroup G)
    (T : Subgroup G) (hT : IsKleinFour T) :
    ∃ z t : G, z ∈ T ∧ t ∈ T ∧ orderOf z = 2 ∧ orderOf t = 2 ∧
      ¬ IsConj z t ∧ ∀ x : G, orderOf x = 2 → IsConj x z ∨ IsConj x t := by
  let := hT
  obtain ⟨_, _, _, _, _, _, hlocal⟩ := four_quaternion_subgroups hG
  have hcent : Subgroup.center G ≤ T := by
    apply (Subgroup.center_le_centralizer (T : Set G)).trans
    rw [(hlocal T (Or.inl hT)).1]
    rintro x ⟨y, _, rfl⟩
    exact y.property
  have hclasses := involution_conjugacy_classes hG
  obtain ⟨n, hn, _, a, b, ha, hb, hconj, hgen⟩ := hG
  let z := a ^ (2 ^ (n - 2))
  have hz : orderOf z = 2 := half_order_pow_orderOf hn ha
  have hzcent : z ∈ Subgroup.center G := half_order_pow_mem_center hn a b ha hb hconj hgen
  have hnot : ¬ T ≤ Subgroup.zpowers z := by
    intro hle
    exact IsKleinFour.not_isCyclic (Subgroup.isCyclic_of_le hle)
  obtain ⟨t, htT, htz⟩ := Set.not_subset.mp hnot
  have ht : orderOf t = 2 := by
    apply orderOf_eq_prime
    · simpa [pow_two] using congrArg (fun y : T => (y : G))
        (IsKleinFour.mul_self (⟨t, htT⟩ : T))
    · intro he
      exact htz (he ▸ (Subgroup.zpowers z).one_mem)
  have hzt : ¬ IsConj z t := by
    intro hc
    obtain ⟨g, hg⟩ := isConj_iff.mp hc
    have he : z = t := by
      simpa only [Subgroup.mem_center_iff.mp hzcent g, mul_assoc,
        mul_inv_cancel, mul_one] using hg
    exact htz (he ▸ Subgroup.mem_zpowers z)
  exact ⟨z, t, hcent hzcent, htT, hz, ht, hzt,
    replace_representatives z t hz ht hzt hclasses⟩

/-- Every chosen four-subgroup contains both quasi-dihedral involution classes. -/
public theorem four_involution_representatives (P : Subgroup G)
    (hP : Stellmacher.IsSemidihedralGroup P) (T : Subgroup G)
    (hTP : T ≤ P) (hT : IsKleinFour T) :
    ∃ z t : P, (z : G) ∈ T ∧ (t : G) ∈ T ∧ orderOf z = 2 ∧ orderOf t = 2 ∧
      ¬ IsConj z t ∧ ∀ x : P, orderOf x = 2 → IsConj x z ∨ IsConj x t := by
  let e := Subgroup.subgroupOfEquivOfLe hTP
  have hU : IsKleinFour (T.subgroupOf P) := {
    card_four := (Nat.card_congr e.toEquiv).trans hT.card_four
    exponent_two := (Monoid.exponent_eq_of_mulEquiv e).trans hT.exponent_two }
  exact internal_representatives hP (T.subgroupOf P) hU
end ABG.QuasiDihedral
