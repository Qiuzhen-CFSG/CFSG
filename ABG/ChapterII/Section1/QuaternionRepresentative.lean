module
public import Theory.GroupTheory.QuaternionPresentation
public import ABG.ChapterII.Section1.PresentationCalculus
public import ABG.ChapterII.Section1.Center
public import ABG.ChapterII.Section1.QuaternionRepresentativeNormalizer

/-!
# The canonical quaternion subgroup of a quasi-dihedral group

For the actual semidihedral presentation, let `c = a^(2^(n-3))` and
`d = a*b`. The subgroup `U = ⟨c,d⟩` is a quaternion group of order eight,
contains its centralizer, and has index two in its normalizer.

The rotation `c` has order four, `d² = c²`, and `d` inverts `c`.
The two-form closure theorem shows that `⟨c⟩` has index two in `U`;
the quaternion presentation recognizer identifies the group. An element
centralizing `U` cannot have an outer normal form, because all outer
elements invert `c`. Its rotational normal form commutes with `a`, and
commutation with `d` then forces commutation with `b`. Thus it lies in
the known center, generated by `c²`, which is contained in `U`.
The separate normalizer calculation uses divisibility of rotation exponents
and a representative for the second coset.

This is the explicit-representative calculation for Alperin–Brauer–Gorenstein,
Chapter II, §1, Lemma 1(ii), article p.9 of
`refs/latex/alperin-brauer-gorenstein.tex`. Classification of all quaternion
subgroups by conjugacy is assembled separately. The parameter `n ≥ 4`
is Stellmacher's group-order parameter, one larger than the article's.
-/


namespace ABG.QuasiDihedral
variable {G : Type*} [Group G]

private theorem canonical_relations {n : ℕ} (hn : 4 ≤ n) (a b : G)
    (ha : orderOf a = 2^(n-1)) (hb : orderOf b = 2)
    (hconj : b*a*b⁻¹=a^(2^(n-2)-1)) :
    orderOf (a^(2^(n-3))) = 4 ∧
    (a*b)^2=(a^(2^(n-3)))^2 ∧
    (a*b)*(a^(2^(n-3)))*(a*b)⁻¹=(a^(2^(n-3)))⁻¹ ∧
    a*b ∉ Subgroup.zpowers (a^(2^(n-3))) := by
  let q := 2^(n-3)
  have hq : 0 < q := by dsimp [q]; positivity
  have hm : 2^(n-1)=4*q := by
    dsimp [q]; rw [show n-1=n-3+2 by omega,pow_add]; ring
  have hh : 2^(n-2)=2*q := by
    dsimp [q]; rw [show n-2=n-3+1 by omega,pow_succ]; ring
  have hqe : 2 ∣ q := by
    dsimp [q]; rw [show n-3=n-4+1 by omega,pow_succ]; exact dvd_mul_left _ _
  have hc : orderOf (a^q)=4 := by
    rw [orderOf_pow_of_dvd (by omega) (by rw [ha,hm]; exact dvd_mul_left _ _),ha,hm]
    exact Nat.mul_div_cancel _ hq
  have hbc : b*a^q*b⁻¹=(a^q)⁻¹ := by
    apply eq_inv_of_mul_eq_one_left
    have ht := congrArg (fun x : G => x^q) hconj
    rw [← MulAut.conj_apply, ← map_pow, MulAut.conj_apply, ← pow_mul] at ht
    rw [ht,←pow_add]
    apply orderOf_dvd_iff_pow_eq_one.mp
    rw [ha,hm,hh]
    have he : (2*q-1)*q+q=2*q*q := by
      have : 2*q-1+1=2*q := by omega
      nlinarith
    rw [he]
    obtain ⟨r,hr⟩ := hqe
    refine ⟨r,?_⟩
    nlinarith [hr]
  refine ⟨hc,?_,?_,?_⟩
  · have hs := outer_square hn a b hb hconj 1
    rw [pow_one,mul_one] at hs
    rw [hs,←pow_mul,hh]
    change a^(2*q)=a^(q*2)
    rw [Nat.mul_comm]
  · change (a*b)*a^q*(a*b)⁻¹=(a^q)⁻¹
    calc
      _ = a*(b*a^q*b⁻¹)*a⁻¹ := by group
      _ = a*(a^q)⁻¹*a⁻¹ := by rw [hbc]
      _ = (a^q)⁻¹ := by rw [(Commute.self_pow a q).inv_right.eq]; group
  · intro hd
    have hl : Subgroup.zpowers (a^q) ≤ Subgroup.zpowers a :=
      Subgroup.zpowers_le.mpr (Subgroup.pow_mem _ (Subgroup.mem_zpowers _) _)
    have hbmem : b ∈ Subgroup.zpowers a := by
      have ht := (Subgroup.zpowers a).mul_mem ((Subgroup.zpowers a).inv_mem (Subgroup.mem_zpowers a)) (hl hd)
      simpa only [←mul_assoc,inv_mul_cancel,one_mul] using ht
    obtain ⟨i,hi⟩ := hbmem
    exact generators_not_commute hn ha hconj (hi ▸ Commute.self_zpow a i)

private theorem model_of_relations (c d : G) (hc : orderOf c=4)
    (hsq : d^2=c^2) (hinv : d*c*d⁻¹=c⁻¹)
    (hout : d ∉ Subgroup.zpowers c) :
    Nonempty ((Subgroup.closure ({c,d}:Set G)) ≃* QuaternionGroup 2) := by
  let U := Subgroup.closure ({c,d}:Set G)
  let c' : U := ⟨c,Subgroup.subset_closure (by simp)⟩
  let d' : U := ⟨d,Subgroup.subset_closure (by simp)⟩
  have hc' : orderOf c'=4 := by
    rw [← orderOf_injective U.subtype U.subtype_injective]
    exact hc
  have hsq' : d'^2=c'^2 := by apply Subtype.ext; exact hsq
  have hinv' : d'*c'*d'⁻¹=c'⁻¹ := by apply Subtype.ext; exact hinv
  have hgen : Subgroup.closure ({c',d'}:Set U)=⊤ := generated_subtype c d
  have hout' : d' ∉ Subgroup.zpowers c' := by
    rintro ⟨i,hi⟩
    apply hout
    exact ⟨i,congrArg (fun x : U => (x:G)) hi⟩
  have hc3 : c'⁻¹=c'^3 := by
    symm
    apply eq_inv_of_mul_eq_one_left
    rw [←pow_succ]
    change c'^4=1
    rw [←hc',pow_orderOf_eq_one]
  have hidx : (Subgroup.zpowers c').index=2 := by
    apply Subgroup.index_eq_two_iff_exists_notMem_and.mpr
    refine ⟨d',hout',?_⟩
    intro x
    have hx : x ∈ Subgroup.closure ({c',d'}:Set U) := by rw [hgen]; trivial
    obtain ⟨i,rfl|rfl⟩ := square_normal_form_int c' d' 3 2
      (by simpa only [zpow_ofNat] using hsq') (hinv'.trans hc3) x hx
    · right; exact Subgroup.zpow_mem _ (Subgroup.mem_zpowers _) _
    · left
      have hdd : d'*d'=c'^2 := by simpa [pow_two] using hsq'
      rw [mul_assoc,hdd]
      exact Subgroup.mul_mem _ (Subgroup.zpow_mem _ (Subgroup.mem_zpowers _) _)
        (Subgroup.pow_mem _ (Subgroup.mem_zpowers _) _)
  have hcard : Nat.card U=4*2 := by
    have ht := (Subgroup.zpowers c').card_mul_index
    rw [Nat.card_zpowers,hc',hidx] at ht
    exact ht.symm
  exact QuaternionGroup.quaternionGroup_equiv_of_presentation (by decide)
    c' d' hc' hsq' hinv' hgen hcard

private theorem canonical_centralizer {n : ℕ} (hn : 4 ≤ n) (a b : G)
    (ha : orderOf a = 2^(n-1)) (hb : orderOf b = 2)
    (hconj : b*a*b⁻¹=a^(2^(n-2)-1))
    (hgen : Subgroup.closure ({a,b}:Set G)=⊤) :
    Subgroup.centralizer (Subgroup.closure ({a^(2^(n-3)),a*b}:Set G) : Set G) ≤
      Subgroup.closure ({a^(2^(n-3)),a*b}:Set G) := by
  let c := a^(2^(n-3))
  let U := Subgroup.closure ({c,a*b}:Set G)
  obtain ⟨hc, _, hdc, _⟩ := canonical_relations hn a b ha hb hconj
  have hbc : b*c*b⁻¹=c⁻¹ := by
    have he : a*(b*c*b⁻¹)*a⁻¹=c⁻¹ := by
      calc
        _ = (a*b)*c*(a*b)⁻¹ := by group
        _ = c⁻¹ := hdc
    have hac : Commute a c := Commute.self_pow a _
    calc
      _ = a⁻¹*(a*(b*c*b⁻¹)*a⁻¹)*a := by group
      _ = a⁻¹*c⁻¹*a := by rw [he]
      _ = c⁻¹ := by rw [hac.inv_left.inv_right.eq]; group
  intro x hx
  have hx' : ∀ y ∈ U, y*x=x*y := Subgroup.mem_centralizer_iff.mp hx
  have hxc := hx' c (Subgroup.subset_closure (by simp))
  have hxd := hx' (a*b) (Subgroup.subset_closure (by simp))
  have hb2 : b^2=1 := by rw [←hb]; exact pow_orderOf_eq_one _
  obtain ⟨i, _, rfl | rfl⟩ := normal_form a b _ _ (by positivity) ha hb2 hconj hgen x
  · have hxb : b*a^i=a^i*b := by
      apply mul_left_cancel (a := a)
      calc
        a*(b*a^i) = (a*b)*a^i := by group
        _ = a^i*(a*b) := hxd
        _ = a*(a^i*b) := by rw [←mul_assoc,(Commute.self_pow a i).symm.eq,mul_assoc]
    have hz : a^i ∈ Subgroup.center G := by
      apply Subgroup.mem_center_iff.mpr
      intro y
      obtain ⟨j,_,rfl|rfl⟩ := normal_form a b _ _ (by positivity) ha hb2 hconj hgen y
      · exact (Commute.pow_pow_self a j i).eq
      · rw [mul_assoc,hxb,←mul_assoc,(Commute.pow_pow_self a j i).eq,mul_assoc]
    rw [center_eq hn a b ha hb hconj hgen] at hz
    have hhalf : a^(2^(n-2))=c^2 := by
      dsimp [c]
      rw [←pow_mul,show n-2=n-3+1 by omega,pow_succ]
    apply (Subgroup.zpowers_le.mpr (show a^(2^(n-2)) ∈ U from ?_)) hz
    rw [hhalf]
    exact U.pow_mem (Subgroup.subset_closure (by simp)) _
  · exfalso
    have hcb : c*b=b*c := by
      apply mul_left_cancel (a := a^i)
      calc
        a^i*(c*b) = c*(a^i*b) := by
          rw [←mul_assoc,(Commute.pow_pow_self a i (2^(n-3))).eq,mul_assoc]
        _ = (a^i*b)*c := hxc
        _ = a^i*(b*c) := by group
    have hci : c=c⁻¹ := by
      calc
        c = b*c*b⁻¹ := by rw [←hcb]; group
        _ = c⁻¹ := hbc
    have hs : c^2=1 := by rw [pow_two]; calc
      c*c = c*c⁻¹ := congrArg (c * ·) hci
      _ = 1 := mul_inv_cancel c
    have hd := orderOf_dvd_of_pow_eq_one hs
    rw [hc] at hd
    norm_num at hd

/-- The canonical quaternion subgroup has order eight, contains its centralizer,
and has index two in its normalizer (ABG II.1.1(ii)). -/
public theorem quaternion_representative_local {n : ℕ} (hn : 4 ≤ n) (a b : G)
    (hcard : Nat.card G = 2^n) (ha : orderOf a = 2^(n-1)) (hb : orderOf b = 2)
    (hconj : b*a*b⁻¹ = a^(2^(n-2)-1))
    (hgen : Subgroup.closure ({a,b}:Set G) = ⊤) :
    Nonempty ((Subgroup.closure ({a^(2^(n-3)),a*b}:Set G)) ≃* QuaternionGroup 2) ∧
    Subgroup.centralizer (Subgroup.closure ({a^(2^(n-3)),a*b}:Set G) : Set G) ≤
      Subgroup.closure ({a^(2^(n-3)),a*b}:Set G) ∧
    (Subgroup.closure ({a^(2^(n-3)),a*b}:Set G)).relIndex
      (Subgroup.normalizer (Subgroup.closure ({a^(2^(n-3)),a*b}:Set G) : Set G)) = 2 := by
  obtain ⟨hc,hsq,hinv,hout⟩ := canonical_relations hn a b ha hb hconj
  exact ⟨model_of_relations _ _ hc hsq hinv hout,
    canonical_centralizer hn a b ha hb hconj hgen,
    quaternion_representative_normalizer hn a b hcard ha hb hconj hgen⟩

end ABG.QuasiDihedral
