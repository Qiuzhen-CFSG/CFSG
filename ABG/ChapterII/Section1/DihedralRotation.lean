module

public import ABG.ChapterII.Section1.InvolutionClasses
public import Mathlib.GroupTheory.SpecificGroups.Dihedral

/-!
# Rotations of dihedral subgroups lie in the cyclic maximal subgroup

ABG Chapter II, §1, Lemma 1(viii), article page 9 of
`refs/latex/alperin-brauer-gorenstein.tex`, says that the cyclic rotation
subgroup of a dihedral subgroup of order at least eight lies in the cyclic
maximal subgroup of the quasi-dihedral group. The latter is generated by the
same a as in the existing presentation; the former is the image of the
standard rotation generator under an actual group isomorphism.

A rotation is a product of two reflections and has order greater than two.
A cyclic involution in the quasi-dihedral group is central, so either
reflection lying in the cyclic subgroup would make their product an
involution. Both reflections must therefore lie in the other coset, and
the normal-form multiplication puts their product in the cyclic subgroup.
The first theorem is stated for an injective homomorphism from a dihedral
model; the second uses the actual subgroup and its order-eight bound.
-/

namespace ABG.QuasiDihedral
variable {G : Type*} [Group G]
private theorem involution_product_mem_cyclic {n : ℕ} (hn : 4 ≤ n) (a b : G)
    (ha : orderOf a = 2 ^ (n - 1)) (hb : orderOf b = 2)
    (hab : b * a * b⁻¹ = a ^ (2 ^ (n - 2) - 1))
    (hgen : Subgroup.closure ({a, b} : Set G) = ⊤)
    (x y : G) (hx : orderOf x = 2) (hy : orderOf y = 2)
    (hxy : 2 < orderOf (x * y)) : x * y ∈ Subgroup.zpowers a := by
  have hb2 : b ^ 2 = 1 := by rw [← hb]; exact pow_orderOf_eq_one b
  have hnot : ¬ Commute x y := by
    intro hcomm
    have hsq : (x * y) ^ 2 = 1 := by
      rw [hcomm.mul_pow]
      have hx2 : x ^ 2 = 1 := by rw [← hx]; exact pow_orderOf_eq_one x
      have hy2 : y ^ 2 = 1 := by rw [← hy]; exact pow_orderOf_eq_one y
      rw [hx2, hy2, one_mul]
    have := orderOf_le_of_pow_eq_one (by decide : 0 < 2) hsq
    omega
  have hxout : ∃ i : ℕ, x = a ^ i * b := by
    obtain ⟨i, hi, hi' | hi'⟩ := normal_form a b _ _ (by positivity) ha hb2 hab hgen x
    · have he : i = 2 ^ (n - 2) := cyclic_involution hn ha hi (hi' ▸ hx)
      have hc : x ∈ Subgroup.center G := by
        rw [hi', he]
        exact half_order_pow_mem_center hn a b ha hb hab hgen
      exact (hnot (Subgroup.mem_center_iff.mp hc y).symm).elim
    · exact ⟨i, hi'⟩
  have hyout : ∃ i : ℕ, y = a ^ i * b := by
    obtain ⟨i, hi, hi' | hi'⟩ := normal_form a b _ _ (by positivity) ha hb2 hab hgen y
    · have he : i = 2 ^ (n - 2) := cyclic_involution hn ha hi (hi' ▸ hy)
      have hc : y ∈ Subgroup.center G := by
        rw [hi', he]
        exact half_order_pow_mem_center hn a b ha hb hab hgen
      exact (hnot (Subgroup.mem_center_iff.mp hc x)).elim
    · exact ⟨i, hi'⟩
  obtain ⟨i, rfl⟩ := hxout
  obtain ⟨j, rfl⟩ := hyout
  have hbb : b * b = 1 := by simpa only [pow_two] using hb2
  have heq : (a ^ i * b) * (a ^ j * b) = a ^ (i + (2 ^ (n - 2) - 1) * j) := by
    calc
      _ = a ^ i * (b * a ^ j) * b := by group
      _ = a ^ i * (a ^ ((2 ^ (n - 2) - 1) * j) * b) * b := by rw [move_pow a b _ hab j]
      _ = a ^ (i + (2 ^ (n - 2) - 1) * j) := by
        rw [mul_assoc, mul_assoc, hbb, mul_one, ← pow_add]
  rw [heq]
  exact Subgroup.pow_mem _ (Subgroup.mem_zpowers _) _

/-- An embedded dihedral group with rotation order at least four has its rotations in ⟨a⟩. -/
public theorem dihedral_rotation_le {n : ℕ} (hn : 4 ≤ n) (a b : G)
    (ha : orderOf a = 2 ^ (n - 1)) (hb : orderOf b = 2)
    (hab : b * a * b⁻¹ = a ^ (2 ^ (n - 2) - 1))
    (hgen : Subgroup.closure ({a, b} : Set G) = ⊤)
    {m : ℕ} (hm : 4 ≤ m) (f : DihedralGroup m →* G) (hf : Function.Injective f) :
    (Subgroup.zpowers (DihedralGroup.r 1)).map f ≤ Subgroup.zpowers a := by
  rw [MonoidHom.map_zpowers]
  apply Subgroup.zpowers_le.mpr
  have he : f (DihedralGroup.r 1) = f (DihedralGroup.sr 0) * f (DihedralGroup.sr 1) := by
    rw [← map_mul, DihedralGroup.sr_mul_sr, sub_zero]
  rw [he]
  apply involution_product_mem_cyclic hn a b ha hb hab hgen
  · rw [orderOf_injective f hf, DihedralGroup.orderOf_sr]
  · rw [orderOf_injective f hf, DihedralGroup.orderOf_sr]
  · rw [← he, orderOf_injective f hf, DihedralGroup.orderOf_r_one]
    omega

/-- Source II.1.1(viii), for an actual dihedral subgroup of order at least eight. -/
public theorem dihedral_subgroup_rotation_le {n : ℕ} (hn : 4 ≤ n) (a b : G)
    (ha : orderOf a = 2 ^ (n - 1)) (hb : orderOf b = 2)
    (hab : b * a * b⁻¹ = a ^ (2 ^ (n - 2) - 1))
    (hgen : Subgroup.closure ({a, b} : Set G) = ⊤)
    (D : Subgroup G) {m : ℕ} (e : D ≃* DihedralGroup m) (hD : 8 ≤ Nat.card D) :
    (Subgroup.zpowers (e.symm (DihedralGroup.r 1))).map D.subtype ≤ Subgroup.zpowers a := by
  have hm : 4 ≤ m := by
    have he : Nat.card D = 2 * m := (Nat.card_congr e.toEquiv).trans DihedralGroup.nat_card
    omega
  have hf : Function.Injective (D.subtype.comp e.symm.toMonoidHom) :=
    D.subtype_injective.comp e.symm.injective
  have h := dihedral_rotation_le hn a b ha hb hab hgen hm _ hf
  simpa only [MonoidHom.map_zpowers, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom] using h
end ABG.QuasiDihedral
