module
public import ABG.ChapterII.Section2.UnitaryTwoPowerScalar
public import ABG.ChapterII.Section2.SpecialUnitaryEquivSL2
public import Theory.GroupTheory.CyclicCentralProductEquivalence
public import GorensteinWalter.SL2ProjectiveCover

/-!
# The unitary model of a cyclic central extension of SL2

A finite group generated by a central cyclic subgroup of order 2^(m+1)
and a specified SL2(GF(p^n)) subgroup meeting it in order two is isomorphic
to the actual unitary determinant level m, provided p is odd, n is nonzero,
and 2^(m+1) divides p^n+1. The equivalence preserves the specified SL2
factor through the inverse of the proved special-unitary equivalence and
the actual level-zero inclusion. In particular, q=3 and q=9 are included.

Restrict the actual bounded scalar subgroup and determinant-one subgroup
to the target level. Scalar generation, cyclicity, cardinality and the
two-element intersection supply the concrete central-product data. The
actual SU2--SL2 equivalence identifies the second factor; the canonical
SL2 projective cover gives its two-element center. Generic cyclic
central-product gluing then extends the prescribed factor map.

Source: ABG Chapter II, Section 3, Proposition 3, article page 26, using
Section 2, Lemma 1(v),(vi), article pages 17-18. No abstract unitary
identification or additional recognition hypothesis is assumed.
-/

namespace ABG

public theorem exists_mulEquiv_SU2Level_of_central_product
    {H : Type*} [Group H] [Finite H]
    (p n : ℕ) [Fact p.Prime] (hp : Odd p) (hn : n ≠ 0)
    (m : ℕ) (hd : 2 ^ (m + 1) ∣ p ^ n + 1)
    (Z L : Subgroup H) [IsCyclic Z]
    (hZ : Z ≤ Subgroup.center H) (hgen : Z ⊔ L = ⊤)
    (hZcard : Nat.card Z = 2 ^ (m + 1))
    (hi : Nat.card (Z ⊓ L : Subgroup H) = 2)
    (eL : L ≃* Matrix.SpecialLinearGroup (Fin 2) (GaloisField p n)) :
    ∃ e : H ≃* SU2Level p n hn m, ∀ l : L,
      (e l).val = ((SU2LevelZeroEquivSpecial p n hn).symm
        ((specialUnitaryTwo_equiv_sl2 p n hp hn).symm (eL l))).val := by
  let D := SU2Level p n hn m
  let C := SU2ScalarLevel p n hn m
  let K := SU2Level p n hn 0
  have hsup : C ⊔ K = D := (SU2Level_eq_scalar_sup_zero p n hn hp.pow m hd).symm
  have hCD : C ≤ D := hsup ▸ le_sup_left
  have hKD : K ≤ D := hsup ▸ le_sup_right
  let C' := C.subgroupOf D
  let K' := K.subgroupOf D
  let eC : C' ≃* C := Subgroup.subgroupOfEquivOfLe hCD
  let eK : K' ≃* K := Subgroup.subgroupOfEquivOfLe hKD
  obtain ⟨hcyc, hc, hcent, hI⟩ := SU2ScalarLevel_structure p n hn hp.pow m hd
  let : IsCyclic C := hcyc
  let : IsCyclic C' := eC.isCyclic.mpr hcyc
  let eZ : Z ≃* C' := mulEquivOfCyclicCardEq
    (hZcard.trans (((Nat.card_congr eC.toEquiv).trans hc).symm))
  let eKSL : K' ≃* Matrix.SpecialLinearGroup (Fin 2) (GaloisField p n) :=
    eK.trans ((SU2LevelZeroEquivSpecial p n hn).trans
      (specialUnitaryTwo_equiv_sl2 p n hp hn))
  let eL' : L ≃* K' := eL.trans eKSL.symm
  have hCcent : C' ≤ Subgroup.center D := by
    intro c hc'
    apply Subgroup.mem_center_iff.mpr
    intro d
    exact Subtype.ext (Subgroup.mem_center_iff.mp (hcent hc') d)
  have hgen' : C' ⊔ K' = ⊤ := by
    apply Subgroup.map_injective D.subtype_injective
    rw [Subgroup.map_sup, Subgroup.map_subgroupOf_eq_of_le hCD,
      Subgroup.map_subgroupOf_eq_of_le hKD, ← MonoidHom.range_eq_map, D.range_subtype]
    exact hsup
  have hIc : Nat.card (C' ⊓ K' : Subgroup D) = 2 := by
    rw [← Subgroup.card_map_of_injective (K := C' ⊓ K') D.subtype_injective,
      Subgroup.map_inf _ _ _ D.subtype_injective,
      Subgroup.map_subgroupOf_eq_of_le hCD, Subgroup.map_subgroupOf_eq_of_le hKD]
    exact hI
  have hodd : Odd (Nat.card (GaloisField p n)) := by
    rw [GaloisField.card p n hn]
    exact hp.pow
  have hLc : Nat.card (Subgroup.center L) = 2 := by
    rw [Nat.card_congr (Subgroup.centerCongr eL).toEquiv,
      ← GorensteinWalter.sl2ProjectiveProjection_ker (GaloisField p n)]
    exact GorensteinWalter.sl2ProjectiveProjection_ker_card (GaloisField p n) hodd
  obtain ⟨e, _heZ, heL⟩ :=
    Subgroup.exists_mulEquiv_of_cyclic_central_products Z L C' K'
      hZ hCcent hgen hgen' hLc hi hIc eZ eL'
  refine ⟨e, ?_⟩
  intro l
  have hval := congrArg Subtype.val (heL l)
  change (e l).val = (eK (eL' l)).val at hval
  simpa only [eL', eKSL, MulEquiv.trans_apply, MulEquiv.symm_trans_apply,
    MulEquiv.apply_symm_apply] using hval

end ABG
