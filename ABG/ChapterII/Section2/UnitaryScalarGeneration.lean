module
public import ABG.ChapterII.Section2.UnitaryScalarModels
public import ABG.ChapterII.Section2.UnitaryDeterminantModels
public import Theory.SpecificGroups.GL2.DeterminantTwoPowerCentralProduct

/-!
# Scalar generation of the unitary determinant levels

For odd q and `2^(m+1)` dividing `q+1`, the actual subgroup `SU2Level m`
is generated by the scalar roots of order dividing `2^(m+1)` and its
determinant-one level. This is the generation assertion in ABG Chapter II,
Section 2, Lemma 1(v), article pages 17-18. The scalar factor is defined by
restricting the existing GL2 scalar subgroup to the actual standard GU2.

Apply the proved GL2 scalar decomposition over `GF(q^2)`. Its scalar root
has order dividing `2^(m+1)`, hence q+1, so it is genuinely unitary by the
norm-one scalar criterion. The residual determinant-one factor equals
the scalar inverse times the original unitary matrix and is therefore
unitary as well. Conversely, determinants place both factors in the stated
level. No arbitrary square-root norm assumption, special-unitary/special-
linear identification, or central-product recognition is used.
-/

namespace ABG

open Matrix.GeneralLinearGroup

@[expose] public noncomputable def SU2ScalarLevel
    (p n : ℕ) [Fact p.Prime] (hn : n ≠ 0) (m : ℕ) : Subgroup (GU2 p n hn) :=
  ((rootsOfUnity (2 ^ (m + 1)) (GaloisField p (2 * n))).map
    (scalar (Fin 2))).subgroupOf (unitaryForm 2 p n hn).unitarySubgroup

public theorem SU2Level_eq_scalar_sup_zero
    (p n : ℕ) [Fact p.Prime] (hn : n ≠ 0) (hodd : Odd (p ^ n))
    (m : ℕ) (hdiv : 2 ^ (m + 1) ∣ p ^ n + 1) :
    SU2Level p n hn m = SU2ScalarLevel p n hn m ⊔ SU2Level p n hn 0 := by
  let F := GaloisField p (2 * n)
  have hcard : Nat.card F = (p ^ n) ^ 2 := by
    rw [GaloisField.card p (2 * n) (Nat.mul_ne_zero (by decide) hn),
      ← pow_mul, Nat.mul_comm n 2]
  have hdivq : p ^ n + 1 ∣ Nat.card F - 1 := by
    rw [hcard]
    exact ⟨p ^ n - 1, by simpa only [one_pow] using Nat.sq_sub_sq (p ^ n) 1⟩
  have hoddF : Odd (Nat.card F) := by rw [hcard]; exact hodd.pow
  have hgen := determinantTwoPower_eq_scalar_sup_kernel F hoddF m (hdiv.trans hdivq)
  apply le_antisymm
  · intro A hA
    have hA' : A.val ∈ determinantTwoPower F m := hA
    rw [hgen] at hA'
    obtain ⟨C, ⟨c, hc, rfl⟩, B, hB, hCB⟩ := Subgroup.mem_sup_of_normal_right.mp hA'
    have hcU : scalar (Fin 2) c ∈ (unitaryForm 2 p n hn).unitarySubgroup := by
      apply (scalar_mem_GU2_iff p n hn c).mpr
      exact orderOf_dvd_iff_pow_eq_one.mp
        ((orderOf_dvd_iff_pow_eq_one.mpr hc).trans hdiv)
    have hBU : B ∈ (unitaryForm 2 p n hn).unitarySubgroup := by
      have heq : B = (scalar (Fin 2) c)⁻¹ * A.val := by rw [← hCB, inv_mul_cancel_left]
      rw [heq]
      exact (unitaryForm 2 p n hn).unitarySubgroup.mul_mem
        ((unitaryForm 2 p n hn).unitarySubgroup.inv_mem hcU) A.property
    apply Subgroup.mem_sup_of_normal_right.mpr
    refine ⟨⟨scalar (Fin 2) c, hcU⟩, ?_, ⟨B, hBU⟩, ?_, ?_⟩
    · exact ⟨c, hc, rfl⟩
    · apply (mem_SU2Level_iff p n hn 0 _).mpr
      simpa only [pow_zero, pow_one] using (show det B = 1 from hB)
    · exact Subtype.ext hCB
  · apply sup_le
    · intro A hA
      obtain ⟨c, hc, hca⟩ := hA
      change scalar (Fin 2) c = A.val at hca
      apply (mem_SU2Level_iff p n hn m A).mpr
      rw [← hca, det_scalar, Fintype.card_fin, ← pow_mul, ← pow_succ']
      exact hc
    · exact SU2Level_mono p n hn (Nat.zero_le m)

end ABG
