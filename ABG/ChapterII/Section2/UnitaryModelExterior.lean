module
public import ABG.ChapterII.Section2.UnitaryTopDeterminantCentralLayer
public import ABG.ChapterII.Section2.UnitaryDiagonalSwap
public import Theory.FieldTheory.RootsOfUnityCard
public import Theory.SpecificGroups.GL2.DiagonalSwapExterior

/-!
# Exterior elements of the full unitary determinant model

Let q=p^n with p odd and n nonzero, and suppose 2^m is the exact two-part
of q+1, with m at least one. The actual Hermitian subgroup SU2Level m
contains an element outside level m-1. At m=1 its square is one; at m at
least two the subgroup generated by its square is exactly the full model
center. In particular the smallest unitary wreathed case q=3 is retained.

At level one use the coordinate swap, whose determinant is -1 and whose
square is one. At higher levels choose a unit ζ of exact order 2^m in the
quadratic field and use diag(ζ,1) times the coordinate swap. The divisibility
by q+1 makes ζ norm one, so the existing unitary diagonal-and-swap subgroup
places this matrix in the original Hermitian determinant level. Its
determinant -ζ is outside the predecessor because that predecessor tests
an even power smaller than the order of ζ. Its square is ζI. The top
central-layer theorem and primitive-root generation identify the subgroup
generated by this square with the actual center, using the two faithful
subtype maps through GU2 into GL2.

Source: Alperin--Brauer--Gorenstein II.3 Proposition 3, article page 26,
the exterior element a* used to compare the actual model L* with L; matrix
and central-layer properties come from II.2 Lemma 1, article pages 17-18.
This construction supplies the genuine target exterior for the cyclic-square
extension comparison without any abstract identification of Sylow subgroups.
-/

namespace ABG
open Matrix.GeneralLinearGroup

public theorem exists_unitary_model_exterior
    (p n : ℕ) [Fact p.Prime] (hp : Odd p) (hn : n ≠ 0)
    (m : ℕ) (hm : 1 ≤ m) (hd : 2 ^ m ∣ p ^ n + 1)
    (ho : Odd ((p ^ n + 1) / 2 ^ m)) :
    ∃ a : SU2Level p n hn m,
      a.val ∉ SU2Level p n hn (m - 1) ∧
      ((m = 1 ∧ a ^ 2 = 1) ∨
        (2 ≤ m ∧ Subgroup.zpowers (a ^ 2) = Subgroup.center (SU2Level p n hn m))) := by
  classical
  let F := GaloisField p (2 * n)
  let : Fintype F := Fintype.ofFinite F
  let U := (unitaryForm 2 p n hn).unitarySubgroup
  let D := SU2Level p n hn m
  have hcard : Nat.card F = (p ^ n) ^ 2 := by
    rw [GaloisField.card p (2 * n) (Nat.mul_ne_zero (by decide) hn),
      ← pow_mul, Nat.mul_comm n 2]
  have hdivq : p ^ n + 1 ∣ Nat.card F - 1 := by
    rw [hcard]
    exact ⟨p ^ n - 1, by simpa only [one_pow] using Nat.sq_sub_sq (p ^ n) 1⟩
  by_cases hm1 : m = 1
  · subst m
    have hW := diagonalSwapSubgroup_le_unitaryDeterminant p n hn 1 (by decide) hd 1
      (one_pow _)
    have hs := hW (show coordinateSwap F ∈ diagonalSwapSubgroup F 1 from
      Subgroup.subset_closure (by simp))
    let a : SU2Level p n hn 1 := ⟨⟨coordinateSwap F, hs.1⟩, hs.2⟩
    refine ⟨a, ?_, Or.inl ⟨rfl, ?_⟩⟩
    · intro h
      have hh : (-1 : Fˣ) = 1 := by
        change det (coordinateSwap F) ^ (2 ^ (1 - 1)) = 1 at h
        simpa only [Nat.sub_self, mem_SU2Level_iff, pow_zero, pow_one, coordinateSwap_det]
          using h
      have hchar : ringChar F ≠ 2 := by
        intro hc
        have he := FiniteField.even_card_of_char_two hc
        rw [← Nat.card_eq_fintype_card, hcard] at he
        have hod : Odd ((p ^ n) ^ 2) := hp.pow.pow
        have hh := Nat.odd_iff.mp hod
        omega
      exact Ring.neg_one_ne_one_of_char_ne_two hchar (congrArg Units.val hh)
    · apply Subtype.ext
      apply Subtype.ext
      exact coordinateSwap_sq F
  · have hm2 : 2 ≤ m := by omega
    let R := rootsOfUnity (2 ^ m) F
    obtain ⟨u, hu⟩ := IsCyclic.exists_ofOrder_eq_natCard (α := R)
    let ζ : Fˣ := u.val
    have hord : orderOf ζ = 2 ^ m := by
      rw [show orderOf ζ = orderOf u from Subgroup.orderOf_coe u, hu]
      exact FiniteField.card_rootsOfUnity_of_dvd F _ (hd.trans hdivq)
    have hpow : ζ ^ (2 ^ m) = 1 := by rw [← hord]; exact pow_orderOf_eq_one ζ
    let A := diagonalPair F (ζ, 1) * coordinateSwap F
    have hW := diagonalSwapSubgroup_le_unitaryDeterminant p n hn m (by omega) hd ζ hpow
    have hA := hW (show A ∈ diagonalSwapSubgroup F ζ from
      Subgroup.mul_mem _ (Subgroup.subset_closure (by simp))
        (Subgroup.subset_closure (by simp)))
    let a : D := ⟨⟨A, hA.1⟩, hA.2⟩
    have hdet : det A = -ζ := diagonalPair_coordinateSwap_det F ζ
    refine ⟨a, ?_, Or.inr ⟨hm2, ?_⟩⟩
    · intro hh
      have hpw : ζ ^ (2 ^ (m - 1)) = 1 := by
        have he : Even (2 ^ (m - 1)) := Nat.even_pow.mpr ⟨by decide, by omega⟩
        change det A ^ (2 ^ (m - 1)) = 1 at hh
        simpa only [hdet, he.neg_pow] using hh
      have hhdiv := orderOf_dvd_of_pow_eq_one hpw
      rw [hord] at hhdiv
      have := Nat.le_of_dvd (by positivity : 0 < 2 ^ (m - 1)) hhdiv
      have hlt : 2 ^ (m - 1) < 2 ^ m := Nat.pow_lt_pow_right (by decide) (by omega)
      omega
    · apply Subgroup.map_injective D.subtype_injective
      rw [MonoidHom.map_zpowers]
      rw [(SU2Level_top_central_layer p n hp hn m hm hd ho).1,
        SU2Level_center_map p n hp hn]
      have hpred : m - 1 + 1 = m := Nat.sub_add_cancel hm
      apply Subgroup.map_injective U.subtype_injective
      rw [MonoidHom.map_zpowers]
      change Subgroup.zpowers (A ^ 2) = (SU2ScalarLevel p n hn (m - 1)).map U.subtype
      rw [diagonalPair_coordinateSwap_sq]
      have hCU : (rootsOfUnity (2 ^ m) F).map (scalar (Fin 2)) ≤ U := by
        rintro B ⟨c, hc, rfl⟩
        apply (scalar_mem_GU2_iff p n hn c).mpr
        exact orderOf_dvd_iff_pow_eq_one.mp
          ((orderOf_dvd_iff_pow_eq_one.mpr hc).trans hd)
      change Subgroup.zpowers (scalar (Fin 2) ζ) =
        (((rootsOfUnity (2 ^ (m - 1 + 1)) F).map (scalar (Fin 2))).subgroupOf U).map U.subtype
      rw [hpred, Subgroup.map_subgroupOf_eq_of_le hCU]
      rw [← (IsPrimitiveRoot.iff_orderOf.mpr hord).zpowers_eq, MonoidHom.map_zpowers]

end ABG
