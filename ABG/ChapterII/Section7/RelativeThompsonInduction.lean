module

public import ABG.ChapterII.Section6.Defs
public import Glauberman.Theorem4_2

/-!
# Reduction of the relative intersection theorem to class two

Eligibility puts every normal p-subgroup inside the actual subgroup P: its
image modulo the p-prime core lies in the quotient p-core, and its intersection
with that layer lies in the stipulated Sylow subgroup. No ambient Sylow
assumption on P is used.

The induction on the order of B follows the first two paragraphs of Gorenstein
8.2.10, as invoked in ABG II.7 Theorem 2 (article pp. 61--62, local transcription
`refs/latex/alperin-brauer-gorenstein-pages/page-062.tex`). A minimal counterexample
is generated by the conjugates of its intersection with Z(J(P)). Induction
applied to its derived subgroup makes the intersection there normal. Modulo
that intersection, the generating conjugates centralize B, so the derived
subgroup lies in Z(J(P)). The same normal-closure argument then makes the
derived subgroup central in B. The remaining class-two theorem is an explicit
hypothesis, not a claim that relative stability is ordinary stability.
-/

namespace ABG

open scoped commutatorElement

variable {G : Type*} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]

omit [Finite G] in
public theorem RelativeStabilityEligible.normal_pSubgroup_le
    {P : Subgroup G} (hP : RelativeStabilityEligible p P)
    (B : Subgroup G) [B.Normal] (hB : IsPGroup p B) : B ≤ P := by
  let layer := Op_p'p p G
  let quotient := QuotientGroup.mk' (pPrimeCore p G)
  have himage : B.map quotient ≤ pCore p (G ⧸ pPrimeCore p G) :=
    le_sSup ⟨Subgroup.Normal.map inferInstance quotient
      (QuotientGroup.mk'_surjective _), hB.map quotient⟩
  have hBlayer : B ≤ layer := by
    intro element helement
    exact himage (Subgroup.mem_map_of_mem quotient helement)
  obtain ⟨sylow, hsylow⟩ := hP.2.1
  have hlocal : IsPGroup p (B.subgroupOf layer) :=
    hB.of_equiv (Subgroup.subgroupOfEquivOfLe hBlayer).symm
  have hle := hlocal.le_sylow_of_normal sylow
  rw [hsylow] at hle
  intro element helement
  exact hle (show (⟨element, hBlayer helement⟩ : layer) ∈ B.subgroupOf layer from helement)

private theorem derived_lt (B : Subgroup G) (hB : IsPGroup p B) (hne : B ≠ ⊥) :
    ⁅B, B⁆ < B := by
  have : Nontrivial B := (Subgroup.nontrivial_iff_ne_bot (H := B)).mpr hne
  have : Group.IsNilpotent B := hB.isNilpotent
  have : Group.IsSolvable B := IsNilpotent.to_isSolvable
  have hlt := Group.IsSolvable.commutator_lt_top_of_nontrivial (G := B)
  have hmap := (Subgroup.map_subtype_lt_map_subtype (G' := B)).mpr hlt
  simpa only [Subgroup.map_subtype_commutator, ← MonoidHom.range_eq_map, B.range_subtype]
    using hmap

public theorem relative_thompson_intersection_normal_of_classTwo
    (P : Subgroup G) (hP : RelativeStabilityEligible p P)
    (hclassTwo : ∀ (B : Subgroup G), B.Normal → IsPGroup p B → B ≠ ⊥ →
      Subgroup.normalClosure ((B ⊓ thompsonCenter P : Subgroup G) : Set G) = B →
      ⁅B, B⁆ ≤ thompsonCenter P → ⁅⁅B, B⁆, B⁆ = ⊥ →
      (B ⊓ thompsonCenter P).Normal)
    (B : Subgroup G) [B.Normal] (hB : IsPGroup p B) :
    (B ⊓ thompsonCenter P).Normal := by
  classical
  let Z := thompsonCenter P
  have hZcomm : IsMulCommutative Z := Glauberman.thompsonCenter_isMulCommutative P
  have hPnorm : P ≤ Subgroup.normalizer (Z : Set G) :=
    P.le_normalizer.trans
      ((Glauberman.normalizer_le_normalizer_of_thompsonSubgroup P).trans
        (Glauberman.normalizer_le_normalizer_of_thompsonCenter P))
  have hmain : ∀ order : ℕ, ∀ (B : Subgroup G), B.Normal → IsPGroup p B →
      Nat.card B = order → (B ⊓ Z).Normal := by
    intro order
    induction order using Nat.strong_induction_on with
    | h order inductionHyp =>
      intro B hnormal hBp hcard
      let := hnormal
      by_cases hne : B = ⊥
      · simp [hne]
      let W := B ⊓ Z
      by_cases hWnormal : W.Normal
      · exact hWnormal
      let closure := Subgroup.normalClosure (W : Set G)
      have hWclosure : W ≤ closure := Subgroup.le_normalClosure
      have hclosureB : closure ≤ B := Subgroup.normalClosure_le_normal inf_le_left
      have hclosure : closure = B := by
        by_contra hnot
        have hlt : Nat.card closure < order := by
          rw [← hcard]
          exact natCard_lt_of_subgroup_lt (lt_of_le_of_ne hclosureB hnot)
        have hsmall := inductionHyp _ hlt closure inferInstance (hBp.to_le hclosureB) rfl
        let := hsmall
        have hclosureZ : closure ≤ Z :=
          (Subgroup.normalClosure_le_normal (le_inf hWclosure inf_le_right)).trans inf_le_right
        have heq : W = closure := le_antisymm hWclosure (le_inf hclosureB hclosureZ)
        exact hWnormal (heq ▸ inferInstance)
      let derived := ⁅B, B⁆
      have hderivedB : derived ≤ B := Subgroup.commutator_le_left B B
      have hderivedSmall : Nat.card derived < order := by
        rw [← hcard]
        exact natCard_lt_of_subgroup_lt (derived_lt B hBp hne)
      let N := derived ⊓ Z
      have hN : N.Normal :=
        inductionHyp _ hderivedSmall derived inferInstance (hBp.to_le hderivedB) rfl
      let := hN
      let quotient := QuotientGroup.mk' N
      let image := B.map quotient
      have himageNormal : image.Normal :=
        Subgroup.Normal.map inferInstance quotient (QuotientGroup.mk'_surjective N)
      let := himageNormal
      let centralizer := (Subgroup.centralizer (image : Set (G ⧸ N))).comap quotient
      have hWcentralizer : W ≤ centralizer := by
        intro point hpoint
        change quotient point ∈ Subgroup.centralizer (image : Set (G ⧸ N))
        rw [Subgroup.mem_centralizer_iff_commutator_eq_one]
        rintro _ ⟨element, helement, rfl⟩
        rw [← map_commutatorElement]
        apply (QuotientGroup.eq_one_iff (N := N) (x := ⁅element, point⁆)).mpr
        refine ⟨Subgroup.commutator_mem_commutator helement hpoint.1, ?_⟩
        have hnorm := hPnorm (hP.normal_pSubgroup_le B hBp helement)
        have hconj := (Subgroup.mem_normalizer_iff.mp hnorm point).mp hpoint.2
        exact Z.mul_mem hconj (Z.inv_mem hpoint.2)
      have hBcentralizer : B ≤ centralizer := by
        rw [← hclosure]
        exact Subgroup.normalClosure_le_normal hWcentralizer
      have himageComm : image ≤ Subgroup.centralizer (image : Set (G ⧸ N)) := by
        rintro _ ⟨element, helement, rfl⟩
        exact hBcentralizer helement
      have hderivedMap : derived.map quotient = ⊥ := by
        rw [Subgroup.map_commutator]
        exact Subgroup.commutator_eq_bot_iff_le_centralizer.mpr himageComm
      have hderivedZ : derived ≤ Z := by
        have hle := (Subgroup.map_eq_bot_iff (f := quotient) (H := derived)).mp hderivedMap
        exact (show derived ≤ N by
          simpa only [quotient, QuotientGroup.ker_mk'] using hle).trans inf_le_right
      have hBcent : B ≤ Subgroup.centralizer (derived : Set G) := by
        rw [← hclosure]
        apply Subgroup.normalClosure_le_normal
        intro point hpoint
        change point ∈ Subgroup.centralizer (derived : Set G)
        rw [Subgroup.mem_centralizer_iff]
        intro element helement
        exact setLike_mul_comm (s := Z) (hderivedZ helement) hpoint.2
      have hclass : ⁅derived, B⁆ = ⊥ := by
        rw [Subgroup.commutator_comm]
        exact Subgroup.commutator_eq_bot_iff_le_centralizer.mpr hBcent
      exact hclassTwo B hnormal hBp hne hclosure hderivedZ hclass
  exact hmain (Nat.card B) B inferInstance hB rfl

end ABG
