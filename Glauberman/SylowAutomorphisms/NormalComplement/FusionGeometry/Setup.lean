module

public import Glauberman.SylowAutomorphisms.NormalComplement.Contracts
public import Glauberman.SylowAutomorphisms.NormalComplement.ComplementObstruction
public import Theory.GroupTheory.ZStar.SylowAutomorphismAction
public import Mathlib.GroupTheory.GroupAction.FixingSubgroup

/-!
# The two faithful extensions in the normal-complement argument

For an odd displacement subgroup U and actor x, the larger actor group is
literally B = ⟨U,x⟩. The two extensions are H = G ⋊ U and K = G ⋊ B,
with the canonical inclusion H → K. The displacement data restrict to B.
When the action fixes a Sylow subgroup S pointwise, the subgroup S × U is
Sylow in H. Z-star and the center-containing fusion selection then give a
local witness whose odd mover belongs to the literal base group G.

Source: Glauberman, Math. Z. 93 (1966), Theorem 1(b), p.158,
DOI 10.1007/BF01111033. The elementary proof that S × U is Sylow also
appears in the independent proof of part (a), in SylowAutomorphisms/Abelian.
-/

public section

namespace Glauberman.SylowAutomorphisms.NormalComplement.FusionGeometry

open Subgroup SemidirectProduct
open scoped IsMulCommutative

universe u
variable {G A : Type u} [Group G] [Group A]

/-- The source's actual subgroup generated by U and x. -/
@[expose] def actors (d : OddDisplacement A) : Subgroup A :=
  d.subgroup ⊔ zpowers d.actor

/-- The displacement subgroup inside the generated actor group. -/
@[expose] def restrictedDisplacement (d : OddDisplacement A) :
    OddDisplacement (actors d) where
  actor := ⟨d.actor, mem_sup_right (mem_zpowers d.actor)⟩
  odd_order := by
    rw [← orderOf_injective (actors d).subtype Subtype.val_injective]
    exact d.odd_order
  subgroup := d.subgroup.subgroupOf (actors d)
  nontrivial := by
    intro he
    apply d.nontrivial
    rw [← map_subgroupOf_eq_of_le (show d.subgroup ≤ actors d from le_sup_left), he,
      Subgroup.map_bot]
  elementary := by
    let _ := d.elementary
    exact IsElementaryAbelian.subgroupOf le_sup_left
  normalizes := by
    apply mem_normalizer_iff.mpr
    intro u
    exact mem_normalizer_iff.mp d.normalizes (u : A)
  surjective_displacement := by
    intro u hu
    obtain ⟨v, hv, he⟩ := d.surjective_displacement (u : A) hu
    exact ⟨⟨v, mem_sup_left hv⟩, hv, Subtype.ext he⟩

/-- The action of B through its literal inclusion into the original actors. -/
@[expose] def extensionAction (φ : A →* MulAut G) (d : OddDisplacement A) :
    actors d →* MulAut G := φ.comp (actors d).subtype

/-- The action of U through its literal inclusion. -/
@[expose] def twoAction (φ : A →* MulAut G) (d : OddDisplacement A) :
    d.subgroup →* MulAut G := φ.comp d.subgroup.subtype

abbrev Extension (φ : A →* MulAut G) (d : OddDisplacement A) :=
  G ⋊[extensionAction φ d] actors d

abbrev TwoExtension (φ : A →* MulAut G) (d : OddDisplacement A) :=
  G ⋊[twoAction φ d] d.subgroup

/-- The literal embedding H → K. -/
@[expose] def inclusion (φ : A →* MulAut G) (d : OddDisplacement A) :
    TwoExtension φ d →* Extension φ d :=
  SemidirectProduct.map (MonoidHom.id G)
    (Subgroup.inclusion (show d.subgroup ≤ actors d from le_sup_left)) (fun _ => rfl)

theorem inclusion_injective (φ : A →* MulAut G) (d : OddDisplacement A) :
    Function.Injective (inclusion φ d) := by
  intro a b he
  apply SemidirectProduct.ext
  · exact congrArg (fun k : Extension φ d => k.left) he
  · exact Subtype.ext (congrArg (fun k : Extension φ d => (k.right : A)) he)

@[simp] theorem inclusion_inl (φ : A →* MulAut G) (d : OddDisplacement A) (g : G) :
    inclusion φ d (inl g) = inl g := rfl

@[simp] theorem inclusion_inr (φ : A →* MulAut G) (d : OddDisplacement A)
    (a : d.subgroup) :
    inclusion φ d (inr a) = inr (⟨a, mem_sup_left a.property⟩ : actors d) := rfl

/-- The actual direct product S × A in a pointwise action of a two-group.
Maximality is proved by intersecting an overgroup with the base factor. -/
@[expose] def pointwiseActionSylow (φ : A →* MulAut G) (S : Sylow 2 G)
    (hA : IsPGroup 2 A) (hfix : ∀ a : A, ∀ s ∈ (S : Subgroup G), φ a s = s) :
    Sylow 2 (G ⋊[φ] A) := by
  let T : Subgroup (G ⋊[φ] A) := {
    carrier := {x | x.left ∈ S}
    one_mem' := S.one_mem
    mul_mem' := by
      intro x y hx hy
      change x.left * φ x.right y.left ∈ S
      rw [hfix x.right y.left hy]
      exact S.mul_mem hx hy
    inv_mem' := by
      intro x hx
      change (φ x.right⁻¹) x.left⁻¹ ∈ S
      rw [hfix x.right⁻¹ x.left⁻¹ (S.inv_mem hx)]
      exact S.inv_mem hx }
  have hinr (a : A) : (inr a : G ⋊[φ] A) ∈ T := S.one_mem
  have hp : IsPGroup 2 T := by
    intro x
    obtain ⟨n, hn⟩ := S.isPGroup' ⟨x.val.left, x.property⟩
    obtain ⟨m, hm⟩ := hA x.val.right
    have hn' : x.val.left ^ (2 ^ (n + m)) = 1 := by
      rw [pow_add, pow_mul]
      rw [show x.val.left ^ (2 ^ n) = 1 from congrArg Subtype.val hn, one_pow]
    have hm' : x.val.right ^ (2 ^ (n + m)) = 1 := by
      rw [Nat.add_comm n m, pow_add, pow_mul, hm, one_pow]
    have hc : Commute (inl x.val.left : G ⋊[φ] A) (inr x.val.right) := by
      apply SemidirectProduct.ext
      · simpa using (hfix x.val.right x.val.left x.property).symm
      · simp
    refine ⟨n + m, Subtype.ext ?_⟩
    change x.val ^ (2 ^ (n + m)) = 1
    rw [← inl_left_mul_inr_right x.val, hc.mul_pow, ← map_pow, ← map_pow,
      hn', hm', map_one, map_one, one_mul]
  refine { T with isPGroup' := hp, is_maximal' := ?_ }
  intro U hU hTU
  have heq : U.comap (inl : G →* G ⋊[φ] A) = (S : Subgroup G) := by
    apply S.is_maximal' (hU.comap_of_injective _ inl_injective)
    intro s hs
    exact hTU hs
  apply le_antisymm _ hTU
  intro x hx
  have hi : (inl x.left : G ⋊[φ] A) ∈ U := by
    have h := U.mul_mem hx (U.inv_mem (hTU (hinr x.right)))
    have he : x * (inr x.right)⁻¹ = inl x.left :=
      mul_inv_eq_iff_eq_mul.mpr (inl_left_mul_inr_right x).symm
    rwa [he] at h
  change x.left ∈ (S : Subgroup G)
  rw [← heq]
  exact hi

@[simp] theorem mem_pointwiseActionSylow (φ : A →* MulAut G) (S : Sylow 2 G)
    (hA : IsPGroup 2 A) (hfix : ∀ a : A, ∀ s ∈ (S : Subgroup G), φ a s = s)
    (k : G ⋊[φ] A) : k ∈ pointwiseActionSylow φ S hA hfix ↔ k.left ∈ S := Iff.rfl

/-- The source Sylow subgroup T in H. -/
@[expose] def twoSylow (φ : A →* MulAut G) (d : OddDisplacement A) (S : Sylow 2 G)
    (hfix : ∀ a : A, ∀ s ∈ (S : Subgroup G), φ a s = s) :
    Sylow 2 (TwoExtension φ d) :=
  let _ := d.elementary
  pointwiseActionSylow (twoAction φ d) S (IsElementaryAbelian.isPGroup 2 d.subgroup)
    (fun a s hs => hfix a s hs)

@[simp] theorem mem_twoSylow (φ : A →* MulAut G) (d : OddDisplacement A)
    (S : Sylow 2 G) (hfix : ∀ a : A, ∀ s ∈ (S : Subgroup G), φ a s = s)
    (k : TwoExtension φ d) : k ∈ twoSylow φ d S hfix ↔ k.left ∈ S := Iff.rfl

/-- Every actor in U is central in T = S × U. -/
theorem actor_central_in_twoSylow (φ : A →* MulAut G) (d : OddDisplacement A)
    (S : Sylow 2 G) (hfix : ∀ a : A, ∀ s ∈ (S : Subgroup G), φ a s = s)
    (a : d.subgroup) (k : TwoExtension φ d) (hk : k ∈ twoSylow φ d S hfix) :
    k * inr a = inr a * k := by
  let _ := d.elementary
  apply SemidirectProduct.ext
  · change k.left * (twoAction φ d) k.right 1 = 1 * (twoAction φ d) a k.left
    rw [map_one, mul_one, one_mul]
    exact (hfix a k.left hk).symm
  · exact mul_comm _ _

/-- An odd-order element of H has trivial U coordinate and lies in G. -/
theorem odd_mem_base (φ : A →* MulAut G) (d : OddDisplacement A)
    (k : TwoExtension φ d) (hk : Odd (orderOf k)) :
    k ∈ (inl : G →* TwoExtension φ d).range := by
  let _ := d.elementary
  have hU := IsElementaryAbelian.isPGroup 2 d.subgroup
  rw [range_inl_eq_ker_rightHom]
  apply (hU.powEquiv (Nat.coprime_two_left.mpr hk)).injective
  change k.right ^ orderOf k = 1 ^ orderOf k
  have hm := congrArg (rightHom : TwoExtension φ d →* d.subgroup) (pow_orderOf_eq_one k)
  simpa only [map_pow, map_one, one_pow, rightHom_eq_right] using hm

/-- Construct the center-containing witness in the faithful extension H.
The mover is in the literal base group; the full normalizer Sylow field is
retained in `w` for the later passage from H to K. -/
theorem exists_center_fusion [Finite G] [Finite A]
    (fusion : SylowCentralFusion.CentralInvolutionFusion.{u})
    (φ : A →* MulAut G) (hf : Function.Injective φ)
    (hcore : pPrimeCore 2 G = ⊥) (d : OddDisplacement A) (S : Sylow 2 G)
    (hfix : ∀ a : A, ∀ s ∈ (S : Subgroup G), φ a s = s) :
    ∃ t : d.subgroup, t ≠ 1 ∧
      ∃ w : SylowCentralFusion.Witness (twoSylow φ d S hfix) (inr t),
        (center (twoSylow φ d S hfix)).map
          (twoSylow φ d S hfix : Subgroup (TwoExtension φ d)).subtype ≤ w.subgroup ∧
        w.mover ∈ (inl : G →* TwoExtension φ d).range := by
  let _ := d.elementary
  let _ : Nontrivial d.subgroup := (Subgroup.nontrivial_iff_ne_bot _).mpr d.nontrivial
  obtain ⟨t, ht⟩ := exists_ne (1 : d.subgroup)
  have ht2 : t ^ 2 = 1 := Monoid.exponent_dvd_iff_forall_pow_eq_one.mp
    (IsElementaryAbelian.exponent_dvd_p 2 d.subgroup) t
  obtain ⟨w, hw⟩ := (Glauberman.ZStar.fusion_witnesses_in_faithful_two_action
    fusion (twoAction φ d) (hf.comp Subtype.val_injective) hcore
    (IsElementaryAbelian.isPGroup 2 d.subgroup) (twoSylow φ d S hfix) t
    ⟨ht, ht2⟩ S.one_mem (actor_central_in_twoSylow φ d S hfix t)).1
  exact ⟨t, ht, w, hw, odd_mem_base φ d w.mover w.odd_order⟩

end Glauberman.SylowAutomorphisms.NormalComplement.FusionGeometry
