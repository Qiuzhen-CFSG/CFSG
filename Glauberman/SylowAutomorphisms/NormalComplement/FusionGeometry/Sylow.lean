module

public import Glauberman.SylowAutomorphisms.NormalComplement.FusionGeometry.Configuration

/-!
# The actual Sylow subgroups in the fusion configuration

The displacement subgroup U is normal in B = ⟨U,x⟩ and has odd index,
because B/U is generated by the image of the odd-order actor. Hence
H = G ⋊ U is normal of odd index in K = G ⋊ B, and the image of S × U
is Sylow in K.

The center-fusion witness supplies a Sylow subgroup of N_H(Q) with
image N_T(Q). Its image in N_K(Q) remains Sylow: the image of N_H(Q)
is the intersection with H, whose index divides the odd index of H.
Since N_T(Q) normalizes C_T(Q), this Sylow subgroup lies in
J = N_K(Q) ∩ N_K(C_T(Q)); restricting to J gives the exact image J ∩ T.

Source: Glauberman, Math. Z. 93 (1966), Theorem 1(b), p.158,
DOI 10.1007/BF01111033, using Lemma 1(d).
-/

public section
namespace Glauberman.SylowAutomorphisms.NormalComplement.FusionGeometry
open Subgroup SemidirectProduct
universe u
variable {G A : Type u} [Group G] [Group A]

theorem restricted_sup_zpowers (d : OddDisplacement A) :
    (restrictedDisplacement d).subgroup ⊔ zpowers (restrictedDisplacement d).actor = ⊤ := by
  apply Subgroup.map_injective (actors d).subtype_injective
  rw [Subgroup.map_sup, MonoidHom.map_zpowers]
  change (d.subgroup.subgroupOf (actors d)).map (actors d).subtype ⊔ zpowers d.actor =
    (⊤ : Subgroup (actors d)).map (actors d).subtype
  rw [map_subgroupOf_eq_of_le (show d.subgroup ≤ actors d from le_sup_left),
    ← MonoidHom.range_eq_map, range_subtype]
  rfl

theorem restricted_odd_index (d : OddDisplacement A) :
    ¬ 2 ∣ (restrictedDisplacement d).subgroup.index := by
  let _ := restricted_subgroup_normal d
  have he := relIndex_sup_left (zpowers (restrictedDisplacement d).actor)
    (restrictedDisplacement d).subgroup
  rw [restricted_sup_zpowers, relIndex_top_right] at he
  intro hd
  rw [he] at hd
  have hh := hd.trans (relIndex_dvd_card (H := (restrictedDisplacement d).subgroup)
    (K := zpowers (restrictedDisplacement d).actor))
  rw [Nat.card_zpowers] at hh
  exact (restrictedDisplacement d).odd_order.not_two_dvd_nat hh

theorem inclusion_range (φ : A →* MulAut G) (d : OddDisplacement A) :
    (inclusion φ d).range =
      (restrictedDisplacement d).subgroup.comap (rightHom : Extension φ d →* actors d) := by
  ext k
  constructor
  · rintro ⟨h, rfl⟩
    exact h.right.property
  · intro hk
    refine ⟨⟨k.left, ⟨k.right, hk⟩⟩, ?_⟩
    exact SemidirectProduct.ext rfl (Subtype.ext rfl)

theorem inclusion_range_normal (φ : A →* MulAut G) (d : OddDisplacement A) :
    (inclusion φ d).range.Normal := by
  rw [inclusion_range]
  exact (restricted_subgroup_normal d).comap rightHom

theorem inclusion_odd_index (φ : A →* MulAut G) (d : OddDisplacement A) :
    ¬ 2 ∣ (inclusion φ d).range.index := by
  rw [inclusion_range, (restrictedDisplacement d).subgroup.index_comap_of_surjective
    (f := (rightHom : Extension φ d →* actors d)) rightHom_surjective]
  exact restricted_odd_index d

/-- T = S × U is also Sylow in K, since H has odd index in K. -/
theorem exists_sylow_eq_image [Finite G] [Finite A]
    (φ : A →* MulAut G) (d : OddDisplacement A)
    (S : Sylow 2 G) (hfix : ∀ a : A, ∀ s ∈ (S : Subgroup G), φ a s = s) :
    ∃ T : Sylow 2 (Extension φ d), (T : Subgroup (Extension φ d)) = sylowImage φ d S hfix := by
  let _ : Finite (TwoExtension φ d) := Finite.of_equiv (G × d.subgroup) equivProd.symm
  have hp := (twoSylow φ d S hfix).isPGroup'.map (inclusion φ d)
  have hi : ¬ 2 ∣ (sylowImage φ d S hfix).index := by
    rw [sylowImage, index_map_of_injective _ (inclusion_injective φ d)]
    exact Nat.Prime.not_dvd_mul Nat.prime_two (twoSylow φ d S hfix).not_dvd_index
      (inclusion_odd_index φ d)
  exact ⟨hp.toSylow hi, rfl⟩

private theorem normalizer_comap_inclusion (φ : A →* MulAut G) (d : OddDisplacement A)
    (Q : Subgroup (TwoExtension φ d)) :
    (normalizer (Q.map (inclusion φ d) : Set (Extension φ d))).comap (inclusion φ d) =
      normalizer (Q : Set (TwoExtension φ d)) := by
  rw [comap_normalizer_eq_of_le_range (map_le_range _ _),
    comap_map_eq_self_of_injective (inclusion_injective φ d)]

/-- The witness's normalizer Sylow, promoted across the odd index of H,
restricts to J. Its actual image is precisely J ∩ T. -/
theorem exists_local_sylow [Finite G] [Finite A]
    (φ : A →* MulAut G) (d : OddDisplacement A)
    (S : Sylow 2 G) (hfix : ∀ a : A, ∀ s ∈ (S : Subgroup G), φ a s = s)
    (t : d.subgroup) (w : SylowCentralFusion.Witness (twoSylow φ d S hfix) (inr t)) :
    ∃ P : Sylow 2 (localNormalizer φ d S hfix w.subgroup),
      (P : Subgroup (localNormalizer φ d S hfix w.subgroup)).map
        (localNormalizer φ d S hfix w.subgroup).subtype =
          sylowImage φ d S hfix ⊓ localNormalizer φ d S hfix w.subgroup := by
  let _ : Finite (TwoExtension φ d) := Finite.of_equiv (G × d.subgroup) equivProd.symm
  let _ : Finite (Extension φ d) := Finite.of_equiv (G × actors d) equivProd.symm
  let F := (inclusion φ d).range
  let _ : F.Normal := inclusion_range_normal φ d
  let N₀ := normalizer (w.subgroup : Set (TwoExtension φ d))
  let N := normalizer (w.subgroup.map (inclusion φ d) : Set (Extension φ d))
  let J := localNormalizer φ d S hfix w.subgroup
  let f : N₀ →* N := ((inclusion φ d).comp N₀.subtype).codRestrict N (fun n =>
    w.subgroup.le_normalizer_map (inclusion φ d) ⟨n, n.property, rfl⟩)
  have hf : Function.Injective f := by
    intro a b he
    exact Subtype.ext (inclusion_injective φ d (congrArg Subtype.val he))
  have hfr : f.range = F.subgroupOf N := by
    ext n
    constructor
    · rintro ⟨m, rfl⟩
      exact ⟨m, rfl⟩
    · rintro ⟨h, hh⟩
      have hn : h ∈ N₀ := by
        change h ∈ normalizer (w.subgroup : Set _)
        rw [← normalizer_comap_inclusion φ d w.subgroup]
        change (inclusion φ d) h ∈ N
        rw [hh]
        exact n.property
      exact ⟨⟨h, hn⟩, Subtype.ext hh⟩
  have hfi : ¬ 2 ∣ f.range.index := by
    rw [hfr]
    intro hd
    exact inclusion_odd_index φ d (hd.trans (relIndex_dvd_index_of_normal (H := F) (K := N)))
  obtain ⟨R, hR⟩ := w.normalizer_sylow
  have hi : ¬ 2 ∣ ((R : Subgroup N₀).map f).index := by
    rw [index_map_of_injective _ hf]
    exact Nat.Prime.not_dvd_mul Nat.prime_two R.not_dvd_index hfi
  let RN : Sylow 2 N := (R.isPGroup'.map f).toSylow hi
  have hRN (n : N) : n ∈ RN ↔ (n : Extension φ d) ∈ sylowImage φ d S hfix := by
    change n ∈ (R : Subgroup N₀).map f ↔ _
    constructor
    · rintro ⟨r, hr, rfl⟩
      have hrT : (r : TwoExtension φ d) ∈ twoSylow φ d S hfix := by
        have hh : (r : TwoExtension φ d) ∈ (R : Subgroup N₀).map N₀.subtype := ⟨r, hr, rfl⟩
        rw [hR] at hh
        exact hh.1
      exact ⟨r, hrT, rfl⟩
    · rintro ⟨h, hh, he⟩
      have hn : h ∈ N₀ := by
        change h ∈ normalizer (w.subgroup : Set _)
        rw [← normalizer_comap_inclusion φ d w.subgroup]
        change (inclusion φ d) h ∈ N
        rw [he]
        exact n.property
      have hhR : h ∈ (R : Subgroup N₀).map N₀.subtype := by
        rw [hR]
        exact ⟨hh, hn⟩
      obtain ⟨r, hr, hre⟩ := hhR
      exact ⟨r, hr, Subtype.ext ((congrArg (inclusion φ d) hre).trans he)⟩
  have hRNJ : (RN : Subgroup N) ≤ J.subgroupOf N := by
    intro n hn
    refine ⟨n.property, ?_⟩
    obtain ⟨k, hk, he⟩ := (hRN n).mp hn
    have hkN : k ∈ N₀ := by
      change k ∈ normalizer (w.subgroup : Set _)
      rw [← normalizer_comap_inclusion φ d w.subgroup]
      change (inclusion φ d) k ∈ N
      rw [he]
      exact n.property
    have hNC : N₀ ≤ normalizer (centralizer (w.subgroup : Set (TwoExtension φ d)) : Set _) :=
      (normal_subgroupOf_iff_le_normalizer (Subgroup.centralizer_le_normalizer _)).mp inferInstance
    have hkC : k ∈ normalizer (((twoSylow φ d S hfix : Subgroup (TwoExtension φ d)) ⊓
        centralizer (w.subgroup : Set (TwoExtension φ d))) : Set _) :=
      inf_normalizer_le_normalizer_inf ⟨(twoSylow φ d S hfix : Subgroup (TwoExtension φ d)).le_normalizer hk, hNC hkN⟩
    rw [localCentralizer_eq_map]
    exact ((twoSylow φ d S hfix : Subgroup (TwoExtension φ d)) ⊓
      centralizer (w.subgroup : Set (TwoExtension φ d))).le_normalizer_map (inclusion φ d)
        ⟨k, hkC, he⟩
  let j : J →* N := Subgroup.inclusion (show J ≤ N from inf_le_left)
  let P : Sylow 2 J := RN.comapOfInjective j (Subgroup.inclusion_injective _)
    (by simpa only [j, Subgroup.inclusion_range] using hRNJ)
  refine ⟨P, ?_⟩
  ext k
  constructor
  · rintro ⟨a, ha, rfl⟩
    exact ⟨(hRN (j a)).mp ha, a.property⟩
  · rintro ⟨hT, hJ⟩
    exact ⟨⟨k, hJ⟩, (hRN (j ⟨k, hJ⟩)).mpr hT, rfl⟩

/-- Both actual Sylow subgroups used on p.158, with their common ambient
intersection identified. -/
theorem exists_compatible_sylows [Finite G] [Finite A]
    (φ : A →* MulAut G) (d : OddDisplacement A)
    (S : Sylow 2 G) (hfix : ∀ a : A, ∀ s ∈ (S : Subgroup G), φ a s = s)
    (t : d.subgroup) (w : SylowCentralFusion.Witness (twoSylow φ d S hfix) (inr t)) :
    ∃ T : Sylow 2 (Extension φ d), (T : Subgroup (Extension φ d)) = sylowImage φ d S hfix ∧
      ∃ P : Sylow 2 (localNormalizer φ d S hfix w.subgroup),
        (P : Subgroup (localNormalizer φ d S hfix w.subgroup)).map
          (localNormalizer φ d S hfix w.subgroup).subtype =
            (T : Subgroup (Extension φ d)) ⊓ localNormalizer φ d S hfix w.subgroup := by
  obtain ⟨T, hT⟩ := exists_sylow_eq_image φ d S hfix
  obtain ⟨P, hP⟩ := exists_local_sylow φ d S hfix t w
  exact ⟨T, hT, P, by rwa [hT]⟩

end Glauberman.SylowAutomorphisms.NormalComplement.FusionGeometry
