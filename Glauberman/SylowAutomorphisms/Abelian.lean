module

public import Theory.GroupTheory.ZStar.SylowAutomorphismAction
public import Mathlib.GroupTheory.Commutator.Basic
public import Mathlib.GroupTheory.GroupAction.FixingSubgroup
public import Mathlib.GroupTheory.Subgroup.Centralizer
public import Mathlib.GroupTheory.GroupAction.ConjAct

/-!
# Abelian Sylow subgroups of the pointwise automorphism fixer

A faithful two-group fixing a Sylow two-subgroup pointwise is abelian when
its finite target has trivial odd core, conditional on the elementary
central-involution fusion input. Applying this to each Sylow subgroup of
the literal pointwise automorphism fixer gives Theorem 1(a).

In a nonabelian actor group choose a nontrivial central involutory
commutator. Construct the Sylow subgroup S × A inside G ⋊ A and apply the
proved Z-star step. The fusion witness inside the involution's normal
closure has central actor coordinates, so all actors centralize it.
Its odd mover lies in G and normalizes the local centralizer W. On
C_W(W ∩ G), conjugation by the mover differs from the identity by central
elements, hence fixes the chosen commutator, a contradiction.

Source: G. Glauberman, “On the automorphism group of a finite group having
no non-identity normal subgroups of odd order”, Math. Z. 93 (1966),
Theorem 1(a), pp.157–158, DOI 10.1007/BF01111033. We use the whole actor
two-group in place of the source's subgroup generated by the commutator
pair; the same normal-closure and centralizer argument applies.
-/

open Subgroup SemidirectProduct
open scoped commutatorElement

namespace Glauberman.SylowAutomorphisms

private theorem exists_central_involutory_commutator
    {A : Type*} [Group A] [Finite A] (hA : IsPGroup 2 A)
    (hn : ¬ IsMulCommutative A) :
    ∃ a b : A, ⁅a, b⁆ ∈ center A ∧
      BenderSuzuki.PFAppendixIII.IsInvolution ⁅a, b⁆ := by
  classical
  let Q := A ⧸ center A
  let q : A →* Q := QuotientGroup.mk' (center A)
  have : Nontrivial Q := QuotientGroup.nontrivial_iff.mpr
    (fun h => hn (center_eq_top_iff.mp h))
  have hQ : IsPGroup 2 Q := hA.to_quotient (center A)
  let : Nontrivial (center Q) := hQ.center_nontrivial
  have hdvd : 2 ∣ Nat.card (center Q) :=
    ((hQ.to_subgroup (center Q)).card_eq_or_dvd).resolve_left
      (ne_of_gt Finite.one_lt_card)
  obtain ⟨z, hz⟩ := exists_prime_orderOf_dvd_card' (G := center Q) 2 hdvd
  obtain ⟨a, ha⟩ := QuotientGroup.mk'_surjective (center A) (z : Q)
  have haz : a ∉ center A := by
    intro hac
    have hz1 : z = 1 := Subtype.ext
      (ha.symm.trans ((QuotientGroup.eq_one_iff a).mpr hac))
    simp [hz1] at hz
  have ha2 : a ^ 2 ∈ center A := by
    apply (QuotientGroup.eq_one_iff (a ^ 2)).mp
    change q (a ^ 2) = 1
    rw [map_pow, ha]
    exact congrArg Subtype.val (hz ▸ pow_orderOf_eq_one z)
  have hc (b : A) : ⁅a, b⁆ ∈ center A := by
    apply (QuotientGroup.eq_one_iff ⁅a, b⁆).mp
    change q ⁅a, b⁆ = 1
    rw [map_commutatorElement, ha]
    exact commutatorElement_eq_one_iff_mul_comm.mpr
      (mem_center_iff.mp z.property (q b)).symm
  have hex : ∃ b : A, ⁅a, b⁆ ≠ 1 := by
    by_contra! h
    apply haz
    exact mem_center_iff.mpr (fun b =>
      (commutatorElement_eq_one_iff_mul_comm.mp (h b)).symm)
  obtain ⟨b, hb⟩ := hex
  refine ⟨a, b, hc b, hb, ?_⟩
  have h := commutatorElement_mul_left_eq_conj_mul a a b
  have hh : ⁅a * a, b⁆ = 1 :=
    commutatorElement_eq_one_iff_mul_comm.mpr
      (by simpa only [pow_two] using (mem_center_iff.mp ha2 b).symm)
  rw [hh, (mem_center_iff.mp (hc b) a), mul_assoc ⁅a, b⁆ a a⁻¹,
    mul_inv_cancel, mul_one] at h
  exact (pow_two _).trans h.symm

section Action

variable {G A : Type*} [Group G] [Group A]

private theorem exists_sylow_left_mem (φ : A →* MulAut G) (S : Sylow 2 G)
    (hA : IsPGroup 2 A) (hfix : ∀ a : A, ∀ s ∈ (S : Subgroup G), φ a s = s) :
    ∃ T : Sylow 2 (G ⋊[φ] A), ∀ x : G ⋊[φ] A, x ∈ T ↔ x.left ∈ S := by
  let T : Subgroup (G ⋊[φ] A) := {
    carrier := {x | x.left ∈ S}
    one_mem' := S.one_mem
    mul_mem' := by
      intro x y hx hy
      change x.left * φ x.right y.left ∈ S
      rw [hfix x.right y.left hy]
      exact S.mul_mem hx hy
    inv_mem' := by
      intro x hx
      change (φ x.right⁻¹) x.left⁻¹ ∈ S
      rw [hfix x.right⁻¹ x.left⁻¹ (S.inv_mem hx)]
      exact S.inv_mem hx }
  have hinr (a : A) : (inr a : G ⋊[φ] A) ∈ T := S.one_mem
  have hp : IsPGroup 2 T := by
    intro x
    obtain ⟨n, hn⟩ := S.isPGroup' ⟨x.val.left, x.property⟩
    obtain ⟨m, hm⟩ := hA x.val.right
    have hn' : x.val.left ^ (2 ^ (n + m)) = 1 := by
      rw [pow_add, pow_mul]
      rw [show x.val.left ^ (2 ^ n) = 1 from congrArg Subtype.val hn, one_pow]
    have hm' : x.val.right ^ (2 ^ (n + m)) = 1 := by
      rw [Nat.add_comm n m, pow_add, pow_mul, hm, one_pow]
    have hc : Commute (inl x.val.left : G ⋊[φ] A) (inr x.val.right) := by
      apply SemidirectProduct.ext
      · simpa using (hfix x.val.right x.val.left x.property).symm
      · simp
    refine ⟨n + m, Subtype.ext ?_⟩
    change x.val ^ (2 ^ (n + m)) = 1
    rw [← inl_left_mul_inr_right x.val, hc.mul_pow, ← map_pow, ← map_pow,
      hn', hm', map_one, map_one, one_mul]
  refine ⟨{ T with isPGroup' := hp, is_maximal' := ?_ }, fun _ => Iff.rfl⟩
  intro U hU hTU
  have heq : U.comap (inl : G →* G ⋊[φ] A) = (S : Subgroup G) := by
    apply S.is_maximal' (hU.comap_of_injective _ inl_injective)
    intro s hs
    exact hTU hs
  apply le_antisymm _ hTU
  intro x hx
  have hi : (inl x.left : G ⋊[φ] A) ∈ U := by
    have h := U.mul_mem hx (U.inv_mem (hTU (hinr x.right)))
    have he : x * (inr x.right)⁻¹ = inl x.left := by
      exact mul_inv_eq_iff_eq_mul.mpr (inl_left_mul_inr_right x).symm
    rwa [he] at h
  change x.left ∈ (S : Subgroup G)
  rw [← heq]
  exact hi

private theorem odd_right_eq_one (φ : A →* MulAut G) (hA : IsPGroup 2 A)
    (x : G ⋊[φ] A) (hx : Odd (orderOf x)) : x.right = 1 := by
  apply (hA.powEquiv (Nat.coprime_two_left.mpr hx)).injective
  change x.right ^ orderOf x = 1 ^ orderOf x
  have hm := congrArg (rightHom : G ⋊[φ] A →* A) (pow_orderOf_eq_one x)
  simpa only [map_pow, map_one, one_pow, rightHom_eq_right] using hm

end Action

private theorem commutator_mul_center {H : Type*} [Group H] (x y a b : H)
    (hx : x ∈ center H) (hy : y ∈ center H) : ⁅x * a, y * b⁆ = ⁅a, b⁆ := by
  have cx (z : H) : Commute x z := (mem_center_iff.mp hx z).symm
  have cy (z : H) : Commute y z := (mem_center_iff.mp hy z).symm
  rw [commutatorElement_mul_left_eq_conj_mul, (cx (y * b)).commutator_eq]
  simp only [mul_one]
  rw [(cx ⁅a, y * b⁆).eq, mul_inv_cancel_right]
  rw [commutatorElement_mul_right_eq_mul_conj, (cy a).symm.commutator_eq,
    one_mul, (cy ⁅a, b⁆).eq, mul_inv_cancel_right]

private theorem conj_commutator_eq_of_centralizes_kernel
    {H B : Type*} [Group H] [Group B] (π : H →* B) (W : Subgroup H)
    (h a b : H) (hh : π h = 1) (hn : h ∈ normalizer (W : Set H))
    (ha : a ∈ W) (hb : b ∈ W)
    (hac : a ∈ centralizer ((W ⊓ π.ker : Subgroup H) : Set H))
    (hbc : b ∈ centralizer ((W ⊓ π.ker : Subgroup H) : Set H)) :
    h * ⁅a, b⁆ * h⁻¹ = ⁅a, b⁆ := by
  let V := W ⊓ centralizer ((W ⊓ π.ker : Subgroup H) : Set H)
  have hstable (v : V) : h * (v : H) * h⁻¹ ∈ V := by
    refine ⟨(mem_normalizer_iff.mp hn _).mp v.property.1, ?_⟩
    apply mem_centralizer_iff.mpr
    intro w hw
    have hw' : h⁻¹ * w * h ∈ W ⊓ π.ker := by
      refine ⟨(mem_normalizer_iff''.mp hn w).mp hw.1, ?_⟩
      change π (h⁻¹ * w * h) = 1
      simp only [map_mul, map_inv, hh, inv_one, one_mul, mul_one]
      exact hw.2
    have hc := mem_centralizer_iff.mp v.property.2 _ hw'
    have he := congrArg (fun t : H => h * t * h⁻¹) hc
    simpa only [mul_assoc, mul_inv_cancel, inv_mul_cancel, one_mul,
      mul_one, mul_inv_cancel_left] using he
  let f : V →* V :=
    ((MulAut.conj h).toMonoidHom.comp V.subtype).codRestrict V hstable
  have hd (v : V) : f v * v⁻¹ ∈ center V := by
    have hk : ((f v * v⁻¹ : V) : H) ∈ π.ker := by
      change π ((h * (v : H) * h⁻¹) * (v : H)⁻¹) = 1
      simp [hh]
    apply mem_center_iff.mpr
    intro u
    apply Subtype.ext
    exact (mem_centralizer_iff.mp u.property.2 _
      ⟨(f v * v⁻¹).property.1, hk⟩).symm
  let av : V := ⟨a, ha, hac⟩
  let bv : V := ⟨b, hb, hbc⟩
  have he : ⁅f av, f bv⁆ = ⁅av, bv⁆ := by
    have hs := commutator_mul_center (f av * av⁻¹) (f bv * bv⁻¹)
      av bv (hd av) (hd bv)
    simpa only [inv_mul_cancel_right] using hs
  have he' : f ⁅av, bv⁆ = ⁅av, bv⁆ := (map_commutatorElement f av bv).trans he
  exact congrArg Subtype.val he'

universe u
/-- Glauberman's abelian-actor argument, with only the elementary fusion
input explicit. The action fixes the specified Sylow subgroup pointwise. -/
public theorem faithful_two_action_isMulCommutative
    (fusion : SylowCentralFusion.CentralInvolutionFusion.{u})
    {G A : Type u} [Group G] [Group A] [Finite G] [Finite A]
    (φ : A →* MulAut G) (hf : Function.Injective φ)
    (hG : pPrimeCore 2 G = ⊥) (hA : IsPGroup 2 A) (S : Sylow 2 G)
    (hfix : ∀ a : A, ∀ s ∈ (S : Subgroup G), φ a s = s) :
    IsMulCommutative A := by
  classical
  by_contra hn
  obtain ⟨a, b, hc, hi⟩ := exists_central_involutory_commutator hA hn
  obtain ⟨T, hT⟩ := exists_sylow_left_mem φ S hA hfix
  have hinrT (c : A) : (inr c : G ⋊[φ] A) ∈ (T : Subgroup (G ⋊[φ] A)) :=
    (hT _).mpr S.one_mem
  have hcentral : ∀ t ∈ (T : Subgroup (G ⋊[φ] A)),
      t * inr ⁅a, b⁆ = inr ⁅a, b⁆ * t := by
    intro t ht
    apply SemidirectProduct.ext
    · simpa only [mul_left, left_inr, right_inr, map_one, mul_one, one_mul] using
        (hfix ⁅a, b⁆ t.left ((hT t).mp ht)).symm
    · exact mem_center_iff.mp hc t.right
  obtain ⟨w, hw⟩ := (Glauberman.ZStar.fusion_witnesses_in_faithful_two_action
    fusion φ hf hG hA T ⁅a, b⁆ hi (hinrT _) hcentral).2
  let π : G ⋊[φ] A →* A := rightHom
  have hclosure : normalClosure ({inr ⁅a, b⁆} : Set (G ⋊[φ] A)) ≤
      (center A).comap π := by
    apply normalClosure_le_normal
    intro x hx
    rcases Set.mem_singleton_iff.mp hx with rfl
    exact hc
  let W := (T : Subgroup (G ⋊[φ] A)) ⊓ centralizer (w.subgroup : Set (G ⋊[φ] A))
  have hW (c : A) : (inr c : G ⋊[φ] A) ∈ W := by
    refine ⟨hinrT c, mem_centralizer_iff.mpr ?_⟩
    intro q hq
    have hqS : q.left ∈ S := (hT q).mp (w.le_sylow hq)
    have hqZ : q.right ∈ center A := hclosure (hw hq)
    apply SemidirectProduct.ext
    · simpa using (hfix c q.left hqS).symm
    · exact (mem_center_iff.mp hqZ c).symm
  have hC (c : A) : (inr c : G ⋊[φ] A) ∈
      centralizer ((W ⊓ π.ker : Subgroup (G ⋊[φ] A)) : Set (G ⋊[φ] A)) := by
    apply mem_centralizer_iff.mpr
    intro q hq
    have hqS : q.left ∈ S := (hT q).mp hq.1.1
    have hqone : q.right = 1 := hq.2
    apply SemidirectProduct.ext
    · simpa using (hfix c q.left hqS).symm
    · simp [hqone]
  have he := conj_commutator_eq_of_centralizes_kernel π W w.mover
    (inr a) (inr b) (odd_right_eq_one φ hA w.mover w.odd_order)
    w.normalizes_centralizer (hW a) (hW b) (hC a) (hC b)
  apply w.moves
  simpa only [← map_commutatorElement] using he

/-- Theorem 1(a): every Sylow two-subgroup of the pointwise automorphism
fixer is abelian, conditional only on the elementary fusion input. -/
public theorem fixingSubgroup_sylow_isMulCommutative
    (fusion : SylowCentralFusion.CentralInvolutionFusion.{u})
    {G : Type u} [Group G] [Finite G]
    (hG : pPrimeCore 2 G = ⊥) (S : Sylow 2 G)
    (P : Sylow 2 (fixingSubgroup (MulAut G) (S : Set G))) :
    IsMulCommutative P := by
  let F := fixingSubgroup (MulAut G) (S : Set G)
  let φ : P →* MulAut G := F.subtype.comp (P : Subgroup F).subtype
  apply faithful_two_action_isMulCommutative fusion φ
    (Subtype.val_injective.comp Subtype.val_injective) hG P.isPGroup' S
  intro a s hs
  exact (mem_fixingSubgroup_iff (MulAut G)).mp a.val.property s hs

end Glauberman.SylowAutomorphisms
