module
public import Glauberman.PushingUpFullIntersectionLattice
public import Theory.GroupTheory.SubgroupTransport.IntervalDiagram

/-!
# The original pushing-up interval diagram

The proved depth-3v lattice is reindexed by interval endpoints, retaining
the original twisted conjugacy and one common positive parameter. Its
Sylow groups, two-core and all four centers have the printed interval
markings; short intervals are elementary abelian, overlapping intervals
join to their union, and every interval is generated by its singleton cells.
The shifted-center estimate also yields the singleton commutator bound.

Source: Niles, *Pushing-up in finite groups* (1979), Theorem 4.7(a)–(c) and
the first assertion of (d), pp.47–48. Our natural endpoints equal the
printed endpoints plus one. The nonvanishing and elementwise covering
assertions of (d) remain separate source results.
-/

public section
open Subgroup Theory.GroupTheory Theory.GroupTheory.SubgroupTransport
namespace Glauberman
variable {H F : Type*} [Group H] [Finite H] [Field F] [Finite F]

theorem original_psl2_four_interval_diagram
    (hF : Nat.card F = 4) (S : Sylow 2 H) (α : MulAut S)
    (hu : Order.HasUniqueMaximalOver (S : Subgroup H) ⊤)
    (K : Subgroup H) [K.Normal]
    (e : (H ⧸ K) ≃* Matrix.ProjectiveSpecialLinearGroup (Fin 2) F)
    (hf : generalizedFitting H = pCore 2 H)
    (hno : NoInvariantNormal (S : Subgroup H) α) :
    ∃ g : H, ∃ v : ℕ, 0 < v ∧
      let φ := twistedConjugacy (S : Subgroup H) α g
      let X := intervalDiagram φ (3 * v)
      X 0 (3 * v) = ⊤ ∧
      X 0 (3 * v - 1) = (S : Subgroup H) ∧
      X 1 (3 * v) = (S : Subgroup H).map (MulAut.conj g).toMonoidHom ∧
      X 1 (3 * v - 1) = pCore 2 H ∧
      centerIn (S : Subgroup H) = X v (2 * v - 1) ∧
      centerIn ((S : Subgroup H).map (MulAut.conj g).toMonoidHom) = X (v + 1) (2 * v) ∧
      centerIn (pCore 2 H) = X v (2 * v) ∧
      center H = X (v + 1) (2 * v - 1) ∧
      (∀ i j : ℕ, j ≤ 3 * v → j < i + 2 * v → IsElementaryAbelian 2 (X i j)) ∧
      (∀ i j k l : ℕ, i ≤ k → k ≤ j → j ≤ l → l ≤ 3 * v →
        X i j ⊔ X k l = X i l) ∧
      (∀ i j : ℕ, i ≤ j → j ≤ 3 * v → X i j = ⨆ k ∈ Set.Icc i j, X k k) ∧
      (∀ i j : ℕ, j < 3 * v → image φ (X i j) = X (i + 1) (j + 1)) ∧
      (∀ i : ℕ, i ≤ v → ⁅X i i, X (i + 2 * v) (i + 2 * v)⁆ ≤ X (i + v) (i + v)) := by
  obtain ⟨g, hgen, hinter, v, hv, hE, _, _, hj, hzS, hzT, hzQ, hzH, hcomm⟩ :=
    original_psl2_four_full_intersection_lattice hF S α hu K e hf hno
  let φ := twistedConjugacy (S : Subgroup H) α g
  let _ := hE
  have hjall : ∀ a b : ℕ, a + b < 3 * v →
      intervalCell φ a (b + 1) ⊔ intervalCell φ (a + 1) b = intervalCell φ a b := by
    intro a b hab
    by_cases hz : a + b = 0
    · have ha : a = 0 := by omega
      have hb : b = 0 := by omega
      subst a b
      simpa only [Nat.zero_add, intervalCell_initial_left, intervalCell_initial_right,
        intervalCell_zero_left, forwardChain_zero, forwardChain_one, MulEquiv.symm_symm] using hgen
    · exact hj a b (by omega) hab
  refine ⟨g, v, hv, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · simp only [intervalDiagram, Nat.sub_self, intervalCell_zero_left, forwardChain_zero]
  · simp only [intervalDiagram, show 3 * v - (3 * v - 1) = 1 by omega,
      intervalCell_initial_left]
  · simp only [intervalDiagram, Nat.sub_self, intervalCell_initial_right]
  · simpa only [intervalDiagram, show 3 * v - (3 * v - 1) = 1 by omega,
      intervalCell_intersection] using hinter
  · simpa only [intervalDiagram, show 3 * v - (2 * v - 1) = v + 1 by omega] using hzS
  · simpa only [intervalDiagram, show 3 * v - 2 * v = v by omega] using hzT
  · simpa only [intervalDiagram, show 3 * v - 2 * v = v by omega] using hzQ
  · simpa only [intervalDiagram, show 3 * v - (2 * v - 1) = v + 1 by omega] using hzH
  · exact fun i j hj hlen => intervalDiagram_elementary_of_short φ 2 v hj hlen
  · exact fun i j k l hik hkj hjl hlw => intervalDiagram_sup_of_overlap φ (3 * v) hjall hik hkj hjl hlw
  · exact fun i j hij hjw => intervalDiagram_eq_iSup_points φ (3 * v) hjall hij hjw
  · exact fun i j hj => image_intervalDiagram φ hj
  · exact fun i hi => intervalDiagram_commutator_twice φ v hcomm hi

end Glauberman
