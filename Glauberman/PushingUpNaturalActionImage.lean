module
public import Theory.SpecificGroups.SL2.MainHypothesisPair
public import Theory.GroupTheory.PGroup.OmegaCenterIn
public import Theory.Representation.SL2FourNaturalOrbits.Model
public import Theory.SpecificGroups.SL2.SylowKernelCardinality
/-!
# Original rank-one omega action images

A faithful SL₂(4) marking of the original omega action has Sylow image of
order four. Comparison with the actual quotient S/O₂(H) therefore gives
C_S(Ω₁(Z(O₂(H))))=O₂(H). Outside subgroups have nontrivial action image;
a supplement of O₂(H) has full image. Generating conjugate Sylows turn any
abelian supplement into the literal source actor generated by A and A^g.

The original arbitrary PSL₂(4) quotient kernel is retained. The actual
centralizer quotient marking is an independent recognition output.
Source: Niles, *Pushing-up in finite groups* (1979), Lemmas7.4–7.6, pp.60–62.
-/

public section
open Subgroup Representation
namespace Glauberman
variable {H : Type*} [Group H] [Finite H]

/-- Equality of the original Sylow centralizer with Q follows from the
same two quotient orders; no ambient centralizer equality is presumed. -/
theorem sylow_inf_centralizer_eq_of_marked_action
    (S : Sylow 2 H) (Q V : Subgroup H) (hQS : Q ≤ (S : Subgroup H))
    (hQC : Q ≤ centralizer (V : Set H))
    (hindex : Q.relIndex (S : Subgroup H) = 4)
    (q : H →* SL2FourNatural.SL) (hq : Function.Surjective q)
    (hk : q.ker = centralizer (V : Set H)) :
    (S : Subgroup H) ⊓ centralizer (V : Set H) = Q := by
  let C := centralizer (V : Set H)
  let D := (S : Subgroup H) ⊓ C
  have hQD : Q ≤ D := le_inf hQS hQC
  have hcard : Nat.card ((S : Subgroup H).map q) = 4 := by
    let P := S.mapSurjective hq
    have hh := Nat.card_congr
      (Matrix.SpecialLinearGroup.sylowEquivAdditive SL2FourNatural.F 2 P).symm.toEquiv
    exact hh.trans ((Nat.card_congr (Multiplicative.toAdd : Multiplicative SL2FourNatural.F ≃ SL2FourNatural.F)).trans
      (by rw [Nat.card_eq_fintype_card, SL2FourNatural.card_field]))
  have hi : D.relIndex (S : Subgroup H) = 4 := by
    change ((S : Subgroup H) ⊓ centralizer (V : Set H)).relIndex (S : Subgroup H) = 4
    rw [inf_comm,inf_relIndex_right,← hk,relIndex_ker]
    exact hcard
  have hm := relIndex_mul_relIndex Q D (S : Subgroup H) hQD inf_le_left
  rw [hi,hindex] at hm
  have hone : Q.relIndex D = 1 := by omega
  exact le_antisymm (relIndex_eq_one.mp hone) hQD

omit [Finite H] in
/-- A subgroup of S outside Q has nontrivial actual action image. -/
theorem image_ne_bot_of_outside_sylow_centralizer
    {S Q V A : Subgroup H} (hCQ : S ⊓ centralizer (V : Set H) = Q)
    (q : H →* SL2FourNatural.SL) (hk : q.ker = centralizer (V : Set H))
    (hAS : A ≤ S) (hAQ : ¬ A ≤ Q) : A.map q ≠ ⊥ := by
  intro hh
  have hAC : A ≤ centralizer (V : Set H) := by
    rw [← hk]
    exact (map_eq_bot_iff A).mp hh
  exact hAQ (hCQ ▸ le_inf hAS hAC)

/-- A generating Sylow conjugate gives the source generating pair made from
an actual maximum abelian supplement of Q. -/
theorem exists_conjugate_abelian_supplement_generating
    (S : Sylow 2 H) (hu : Order.HasUniqueMaximalOver (S : Subgroup H) ⊤)
    (hn : ¬ (S : Subgroup H).Normal)
    (Q A : Subgroup H) [Q.Normal] (hAQ : A ⊔ Q = (S : Subgroup H)) :
    ∃ g : H, (A ⊔ A.map (MulAut.conj g).toMonoidHom) ⊔ Q = ⊤ := by
  obtain ⟨g,hg⟩ := Theory.GroupTheory.exists_conjugate_sup_eq_top_of_uniqueMaximal S hu hn
  refine ⟨g,?_⟩
  have hfixed : Q.map (MulAut.conj g).toMonoidHom = Q := (Normal.map_conj_eq Q g)
  rw [← hAQ, Subgroup.map_sup, hfixed] at hg
  simpa only [sup_assoc,sup_left_comm,sup_comm,sup_idem,sup_left_idem] using hg
omit [Finite H] in
/-- A supplement of a subgroup acting trivially has full actual image. -/
theorem image_eq_top_of_centralizing_supplement
    (Q V L : Subgroup H) (hQC : Q ≤ centralizer (V : Set H))
    (q : H →* SL2FourNatural.SL) (hq : Function.Surjective q)
    (hk : q.ker = centralizer (V : Set H)) (hLQ : L ⊔ Q = ⊤) :
    L.map q = ⊤ := by
  have hqQ : Q.map q = ⊥ := (map_eq_bot_iff Q).mpr (hk ▸ hQC)
  have hh := congrArg (Subgroup.map q) hLQ
  rwa [Subgroup.map_sup,hqQ,sup_bot_eq,map_top_of_surjective q hq] at hh

/-- The literal source Sylow centralizer, with arbitrary original PSL2(4)
kernel retained. Only the actual faithful action quotient marking is added. -/
theorem original_omega_sylow_centralizer_eq
    {F : Type*} [Field F] [Finite F]
    (hF : Nat.card F = 4) (S : Sylow 2 H)
    (hu : Order.HasUniqueMaximalOver (S : Subgroup H) ⊤)
    (K : Subgroup H) [K.Normal]
    (e : (H ⧸ K) ≃* Matrix.ProjectiveSpecialLinearGroup (Fin 2) F)
    (q : H →* SL2FourNatural.SL) (hq : Function.Surjective q)
    (hk : q.ker = centralizer (omegaCenterIn (pCore 2 H) : Set H)) :
    (S : Subgroup H) ⊓ centralizer (omegaCenterIn (pCore 2 H) : Set H) = pCore 2 H := by
  have hi : (pCore 2 H).relIndex (S : Subgroup H) = 4 := by
    rw [relIndex,index_eq_card]
    exact (Theory.SpecificGroups.SL2.sylow_twoCore_quotient_elementary_four hF S hu K e).2
  apply sylow_inf_centralizer_eq_of_marked_action S (pCore 2 H)
    (omegaCenterIn (pCore 2 H)) (pCore_isPGroup.le_sylow_of_normal S) _ hi q hq hk
  exact le_centralizer_iff.mp (fun _ hv => ((mem_omegaCenterIn_iff _ _).mp hv).2.1)

/-- The selected abelian supplement has a generating conjugate pair in the
literal original H; Sylow nonnormality follows from its quotient order4. -/
theorem original_exists_conjugate_abelian_supplement_generating
    {F : Type*} [Field F] [Finite F]
    (hF : Nat.card F = 4) (S : Sylow 2 H)
    (hu : Order.HasUniqueMaximalOver (S : Subgroup H) ⊤)
    (K : Subgroup H) [K.Normal]
    (e : (H ⧸ K) ≃* Matrix.ProjectiveSpecialLinearGroup (Fin 2) F)
    (A : Subgroup H) (hAQ : A ⊔ pCore 2 H = (S : Subgroup H)) :
    ∃ g : H, (A ⊔ A.map (MulAut.conj g).toMonoidHom) ⊔ pCore 2 H = ⊤ := by
  have hi : (pCore 2 H).relIndex (S : Subgroup H) = 4 := by
    rw [relIndex,index_eq_card]
    exact (Theory.SpecificGroups.SL2.sylow_twoCore_quotient_elementary_four hF S hu K e).2
  apply exists_conjugate_abelian_supplement_generating S hu _ (pCore 2 H) A hAQ
  intro hn
  have hSQ : (S : Subgroup H) ≤ pCore 2 H := le_sSup ⟨hn,S.isPGroup'⟩
  have hone := relIndex_eq_one.mpr hSQ
  omega

end Glauberman
