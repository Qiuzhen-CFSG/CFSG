module
public import Glauberman.FixedNormalPairGeneration
public import Glauberman.PushingUpFullCenters
public import Theory.GroupTheory.PGroup.CentralInvolutionRoots

/-!
# Generation and the exponent conclusion in the original Main Hypothesis

The numerical intersection descent proves that the original Sylow is
generated by involutions. Separately, its already established elementary
center gives the exact exponent-four implication once the class-two bound
is supplied. Thus exponent four is not inferred from class two alone.

Source: Niles, *Pushing-up in finite groups* (1979), elementary generation
in4.7 and the characteristic-two conclusion, printedpp48,58. The remaining
class bound is the independently assembled Sections5–6 source argument.
-/

public section
open Subgroup Theory.GroupTheory
namespace Glauberman
variable {H F : Type*} [Group H] [Finite H] [Field F] [Finite F]

/-- The actual original Sylow is generated by its involutions, under the
original Main Hypothesis with no class or exponent assumption. -/
theorem original_psl2_four_omega_generated
    (hF : Nat.card F = 4) (S : Sylow 2 H) (α : MulAut S)
    (hu : Order.HasUniqueMaximalOver (S : Subgroup H) ⊤)
    (K : Subgroup H) [K.Normal]
    (e : (H ⧸ K) ≃* Matrix.ProjectiveSpecialLinearGroup (Fin 2) F)
    (hf : generalizedFitting H = pCore 2 H)
    (hno : NoInvariantNormal (S : Subgroup H) α) :
    omegaOneAmbient (S : Subgroup H) = (S : Subgroup H) := by
  obtain ⟨q,hq,hk,_,_,_,E,hE⟩ := original_psl2_four_omegaAction_recognition
    hF S hu K e hf hno.noCharacteristicNormal
  obtain ⟨_,_,_,hpair⟩ := original_numerical_pair_of_natural_quotient
    hF S α hu K e hno q hq hk E hE
  exact hpair.omega_generated.1

/-- Once the class-two branch is proved, the already established elementary
Sylow center forces exponent four. Class two alone is not used to infer it. -/
theorem original_psl2_four_pow_four_of_class_two
    (hF : Nat.card F = 4) (S : Sylow 2 H) (α : MulAut S)
    (hu : Order.HasUniqueMaximalOver (S : Subgroup H) ⊤)
    (K : Subgroup H) [K.Normal]
    (e : (H ⧸ K) ≃* Matrix.ProjectiveSpecialLinearGroup (Fin 2) F)
    (hf : generalizedFitting H = pCore 2 H)
    (hno : NoInvariantNormal (S : Subgroup H) α)
    (hclass : _root_.commutator S ≤ center S) : ∀ s : S, s ^ 4 = 1 := by
  have hz := (original_psl2_four_omegaCenters_eq_centers hF S α hu K e hf hno).1
  apply IsPGroup.exponent_four_of_class_two_of_center_exponent_two hclass
  intro z hzc
  have hzG : (z : H) ∈ centerIn (S : Subgroup H) := by
    rw [centerIn_eq_map_center]
    exact mem_map_of_mem (S : Subgroup H).subtype hzc
  rw [←hz] at hzG
  exact Subtype.ext (((mem_omegaCenterIn_iff _ _).mp hzG).2.2)
end Glauberman
